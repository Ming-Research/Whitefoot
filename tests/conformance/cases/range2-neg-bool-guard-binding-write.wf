fn need_zero(slot: u64) -> result: unit pure contract {
  requires slot == 0_u64;
} {
  return unit;
}

fn inspect(nodes: &[u64], enabled: Bool) -> result: unit reads(nodes) contract {
  requires nodes^.len == 1_u64;
  requires forall observed(k in 0_u64..nodes^.len) when enabled: nodes^[k] == 0_u64;
} {
  set enabled = True();
  if enabled {
    let slot = nodes^[0_u64];
    need_zero(slot: slot);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
