enum Node {
  Open(live: Bool);
  Closed(slot: u64);
}

fn need_zero(value: u64) -> result: unit pure contract {
  requires value == 0_u64;
} {
  return unit;
}

fn inspect(nodes: &Slots<Node, 1>, vals: &Slots<u64, 1>) -> result: unit reads(nodes), reads(vals) contract {
  requires nodes^.len == 1_u64;
  requires vals^.len == 1_u64;
  requires forall held(k in 0_u64..nodes^.len) when nodes^[k].Open.live is True: vals^[k] == 0_u64;
} {
  let selected = nodes^[0_u64];
  match selected {
    Open(live: held_live) => {
    }
    Closed(slot: held_slot) => {
      let value = vals^[0_u64];
      need_zero(value: value);
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
