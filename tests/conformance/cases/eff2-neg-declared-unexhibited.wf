alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn f(cell: &Box<Slots<u64>>, x: i32) -> result: i32 writes(cell) {
  doc "Declares a write of the cell content that the body never performs.";
  return x;
}

fn main() -> status: ExitStatus pure {
  doc "A function declaring a write whose body performs none is rejected as declared-but-unexhibited; allocation and release carry no effect entry at all, so no row can be justified by them.";
  let cell = box_slots_new::<u64>(capacity: 4_u64);
  let a = f(cell: &cell, x: 7_i32);
  return exit_status(code: 0_u8);
}
