alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn touch_after_move(value: Slots<u8, 2>) -> result: u8 pure {
  doc "Accesses rooted only in local storage contribute no enclosing formal-rooted effect, so the row stays pure after the parameter has been moved into a local.";
  let moved = move value;
  let spare = moved.len;
  let nonempty = 0_u64 < spare;
  if nonempty {
    let byte = moved[0_u64];
    set moved[0_u64] = byte;
    return byte;
  } else {
    return 0_u8;
  }
}

fn view_after_move(value: Slots<u8, 2>) -> result: u8 pure {
  doc "A range reference over the moved local names local storage and likewise retains no parameter effect identity.";
  let moved = move value;
  let spare = moved.len;
  let view = &moved[0_u64..spare];
  let nonempty = 0_u64 < spare;
  if nonempty {
    return deref(view)[0_u64];
  } else {
    return 0_u8;
  }
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
