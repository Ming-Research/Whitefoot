alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn choose(x: u64) -> r: u64 pure {
  doc "The preceding false edge decides the chained test.";
  if x < 8_u64 {
    return x;
  } else if x >= 8_u64 {
    return 8_u64;
  } else {
    return 0_u64;
  }
}

fn main() -> status: ExitStatus pure {
  doc "The checker judges every body.";
  return exit_status(code: 0_u8);
}
