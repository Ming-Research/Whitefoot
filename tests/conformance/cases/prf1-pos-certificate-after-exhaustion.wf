alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn scaled_after_loop(limit: u64) -> total: u64 pure {
  let sum = 0_u64;
  for (
    i in 0_u64..limit,
    invariant sum_bound: sum <= i
  ) {
    set sum = sum + 1_u64;
  }
  invariant exact_bound: sum <= limit;
  invariant scaled_bound: 3_u64 * sum <= 3_u64 * limit {
    use 3 times exact_bound;
  }
  return sum;
}

fn main() -> status: ExitStatus pure {
  let total = scaled_after_loop(limit: 5_u64);
  if total == 5_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
