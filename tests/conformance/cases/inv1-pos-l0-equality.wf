fn same(left: u64, right: u64) -> result: unit pure contract {
  requires left == right;
} {
  return unit;
}

fn probe(seed: u64, stop: Bool) -> result: unit pure {
  doc "Both header equality bounds discharge the equality requirement inside the body after continuing kills remove the initial copies.";
  let x = seed;
  let y = seed;
  loop (
    invariant tied: x == y
  ) {
    same(left: x, right: y);
    if stop {
      break;
    }
    set x = 0_u64;
    set y = 0_u64;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
