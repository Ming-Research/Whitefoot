alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn second_of(run: Slots<u8, 4>) -> got: u8 pure contract {
  requires run.len >= 2_u64;
} {
  doc "Reads the element at logical offset one.";
  return run[1_u64];
}

fn main() -> status: ExitStatus pure {
  doc "MSR-2: a write at an element position overlaps the descriptor storage of that element and none of the window's own, so it kills every measure of the element and no measure of the window; the window's length bound survives the store and discharges the callee's requirement. The granularity is stated over storage, and a window is the case where the window itself has measures to lose.";
  let two = slots_new::<u8, 4>();
  place_back(window: &two, value: 1_u8);
  place_back(window: &two, value: 2_u8);
  set two[0_u64] = 7_u8;
  let got = second_of(run: move two);
  if got == 2_u8 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
