alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Color {
  Red();
  Green();
  Blue();
}

fn pick(c: Color) -> result: i32 pure {
  match c {
    Red() => {
      return 1_i32;
    }
    Green() => {
      return 2_i32;
    }
    Blue() => {
      return 3_i32;
    }
  }
}

fn main() -> status: ExitStatus pure {
  doc "An exhaustive match over all declared variants is accepted [ERR-2].";
  let green_atom_0001 = Color::Green();
  let n = pick(c: green_atom_0001);
  if n == 2_i32 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
