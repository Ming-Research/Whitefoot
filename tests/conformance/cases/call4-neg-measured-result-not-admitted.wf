alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn hold(taken: Slots<u8, 4>) -> kept: Slots<u8, 4> pure contract {
  ensures kept.len >= 1_u64;
} {
  doc "A measure of a result is an admitted operand, and this one is unprovable: the parameter arrives with no known length, so the relation it publishes has no premise at the selected return.";
  return move taken;
}

fn main() -> status: ExitStatus pure {
  doc "An ensures names a measure of a result of measured type. MSR-5 makes the clause parse and CALL-4 admits both the measured result and the measure over its bare result place, so what refuses the declaration is the ordinary FN-9 proof. This pins that the refusal is a proof and no longer an admission or a grammar rejection.";
  let run = slots_new::<u8, 4>();
  place_back(window: &run, value: 0_u8);
  place_back(window: &run, value: 0_u8);
  place_back(window: &run, value: 0_u8);
  place_back(window: &run, value: 0_u8);
  let kept = hold(taken: move run);
  return exit_status(code: 0_u8);
}
