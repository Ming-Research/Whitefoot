fn invalid(values: &Segments<u64>) -> result: unit writes(values) contract {
  requires 0_u64 < values^.len;
} {
  doc "A run selector is not a whole-run set target.";
  set values^[0_u64] = 9_u64;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The preceding function is rejected at its invalid run-place use.";
  return std::process::exit_status(code: 0_u8);
}
