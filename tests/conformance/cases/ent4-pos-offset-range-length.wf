fn need_different(value: u64, bytes: &[u8]) -> result: unit reads(bytes.len) contract {
  requires value != bytes^.len;
} {
  return unit;
}

fn probe(cursor: u64) -> result: unit pure {
  doc "The anonymous range's constant length folds through Z just like the literal four; the offset disequality discharges FN-8 without a strict bound on cursor.";
  if cursor == 4_u64 {
    return unit;
  }
  let bytes = box_array_filled::<u8>(count: 4_u64, value: 0_u8);
  need_different(value: cursor, bytes: &bytes.inner[0_u64..4_u64]);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
