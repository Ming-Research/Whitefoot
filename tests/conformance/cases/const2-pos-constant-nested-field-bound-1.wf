alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Limits {
  offset: u64;
}

struct Settings {
  limits: Limits;
}

const settings: Settings = Settings(limits: Limits(offset: 1_u64));

fn main() -> status: ExitStatus pure {
  doc "A scalar field of a nested struct constant retains its concrete value at the subscript: one is inside the two-element array, two is outside.";
  let values = array_filled::<u64, 2>(value: 7_u64);
  let index = settings.limits.offset;
  let successor = index + 1_u64;
  let value = values[index];
  return exit_status(code: 0_u8);
}
