alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Color {
  Red();
  Green();
  Blue();
}

fn pick(x: i32) -> return_value: Color pure {
  return Color::Red();
}

fn main() -> return_value: ExitStatus pure {
  doc "GRAM-2: a program is item* - two fn_decl items and one enum_decl item.";
  let c = pick(x: 1_i32);
  return exit_status(code: 0_u8);
}
