fn halves(total: Shared<u8>) -> (low: u8, high: u8) pure waits {
  let seen = 0_u8;
  atomic value = &total {
    set seen = value^;
  }
  return seen, seen +wrap 1_u8;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let total = shared_new::<u8>(value: 3_u8);
  let (low, high) = spawn halves(total: move total);
  let sum = low +wrap high;
  return std::process::exit_status(code: sum);
}
