alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn clamped_sum(left: i8, right: i8) -> result: i8 pure contract {
  requires left == 100_i8;
  requires right == 100_i8;
  ensures result == -56_i8;
} {
  let clamped = left +sat right;
  return clamped;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
