alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn need(index: u8) -> result: unit pure contract {
  requires index <= 254_u8;
} {
  doc "One requirement the established source fact also discharges.";
  return unit;
}

fn read(values: &Slots<u8, 255>, first: u8, first_limit: u8, second: u8, second_limit: u8, third: u8, third_limit: u8) -> result: u8 reads(values) contract {
  requires deref(values).len >= 255_u64;
  requires first <= first_limit;
  requires second <= second_limit;
  requires third <= third_limit;
  requires first_limit <= 80_u8;
  requires second_limit <= 80_u8;
  requires third_limit <= 93_u8;
} {
  doc "A checked finite three-premise source fact serves several dominated subscripts and a later call requirement.";
  invariant component_sum: first + second + third <= first_limit + second_limit + third_limit + 1_u8 {
    use (first <= first_limit);
    use (second <= second_limit);
    use (third <= third_limit);
  }
  invariant limit_sum: first_limit + second_limit + third_limit <= 253_u8;
  invariant in_range: first + second + third <= 254_u8;
  let first_two = first + second;
  let index = first_two + third;
  let array_index = cvt::<u8, u64>(index);
  let loaded_first = deref(values)[array_index];
  let loaded_second = deref(values)[array_index];
  need(index: index);
  return loaded_second;
}

fn main() -> status: ExitStatus pure {
  doc "Source acceptance only.";
  return exit_status(code: 0_u8);
}
