alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A mutable inline window is filled and folded through target-before-RHS checked indexed writes and ordinary checked reads; counted-loop range facts discharge every indexed access.";
  let values = slots_new::<u64, 8>();
  for @build (
    at in 0_u64..8_u64,
    invariant grown: values.len >= at,
    invariant spare: values.cap - values.len + at >= 8_u64
  ) {
    place_back(window: &values, value: 0_u64);
  }
  let length = values.len;
  for (fill_index in 0_u64..length) {
    set values[fill_index] = fill_index +wrap 1_u64;
  }
  let total = 0_u64;
  for (fold_index in 0_u64..length) {
    let value = values[fold_index];
    set total = total +wrap value;
  }
  if total == 36_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
