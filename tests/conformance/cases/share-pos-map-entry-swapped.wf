const names: Array<u8, 2> =[97_u8, 98_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let store_map = map_new::<Box<u8>>(capacity: 0_u64);
  let store = shared_new::<ConcurrentHashMap<Box<u8>>>(value: move store_map);
  let keys = key_set_new(capacity: 1_u64);
  key_set_insert(keys: &keys, key: &names[0_u64..1_u64]);
  let boxed = box_new::<u8>(value: 3_u8);
  let observed = Some<Box<u8>>(value: move boxed);
  atomic t = &store {
    let entries = &t^[keys];
    if entries^.len > 0_u64 {
      swap(first: &entries^[0_u64], second: &observed);
    }
  }
  match move observed {
    Some(value: left) => {
      let code = left.inner +wrap 20_u8;
      return std::process::exit_status(code: code);
    }
    None() => {
    }
  }
  let found = 0_u8;
  let name = &names[0_u64..1_u64];
  atomic t = &store {
    match t^[name] {
      Some(value: seen) => {
        set found = seen^.inner;
      }
      None() => {
      }
    }
  }
  return std::process::exit_status(code: found);
}
