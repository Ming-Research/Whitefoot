const names: Array<u8, 2> =[97_u8, 98_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let store = shared_map_new::<Box<u8>>(capacity: 0_u64);
  let keys = key_set_new(capacity: 1_u64);
  key_set_insert(keys: &keys, key: &names[0_u64..1_u64]);
  let boxed = box_new::<u8>(value: 3_u8);
  let held = Some<Box<u8>>(value: move boxed);
  atomic entries = &store[keys] {
    if entries^.len > 0_u64 {
      swap(first: &entries^[0_u64], second: &held);
    }
  }
  match move held {
    Some(value: left) => {
      let code = left.inner +wrap 20_u8;
      return std::process::exit_status(code: code);
    }
    None() => {
    }
  }
  let found = 0_u8;
  atomic slot = &store[&names[0_u64..1_u64]] {
    match slot^ {
      Some(value: seen) => {
        set found = seen^.inner;
      }
      None() => {
      }
    }
  }
  return std::process::exit_status(code: found);
}
