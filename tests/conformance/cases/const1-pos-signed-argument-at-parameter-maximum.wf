alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn get<const n: i8>() -> r: i8 pure {
  doc "Reads the const generic at its written type i8.";
  return n;
}

fn main() -> status: ExitStatus pure {
  doc "127 is the upper end of i8's closed range, so the closed argument is admitted and the instance reads exactly 127.";
  let v = get::<127>();
  if v == 127_i8 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
