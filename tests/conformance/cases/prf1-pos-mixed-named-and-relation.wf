alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn mixed_sum(p: u16, p_cap: u16, q: u16, q_cap: u16, r: u16, r_cap: u16) -> result: unit pure contract {
  requires p <= p_cap;
  requires q <= q_cap;
  requires r <= r_cap;
} {
  invariant base_p: p <= p_cap;
  invariant combined: p + q + r <= p_cap + q_cap + r_cap {
    use base_p;
    use (q <= q_cap);
    use (r <= r_cap);
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
