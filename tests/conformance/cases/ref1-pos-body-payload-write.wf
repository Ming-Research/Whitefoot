fn write_selected(cell: &Option<u64>) -> result: unit reads(cell), writes(cell) {
  doc "A current Some fact admits a writable payload target through a reference whose row writes the enum.";
  match &cell^ {
    None() => {
      return unit;
    }
    Some(..) => {
      set cell^.Some.value = 41_u64;
      return unit;
    }
  }
}

fn main() -> status: std::process::ExitStatus pure {
  doc "A fresh match observes the payload field written in the earlier arm.";
  let cell = Some<u64>(value: 7_u64);
  let changed = write_selected(cell: &cell);
  match &cell {
    None() => {
      return std::process::exit_status(code: 1_u8);
    }
    Some(value: observed) => {
      if observed^ == 41_u64 {
        return std::process::exit_status(code: 0_u8);
      }
      return std::process::exit_status(code: 2_u8);
    }
  }
}
