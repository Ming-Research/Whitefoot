alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn headroom(run: Slots<u8, 8>) -> total: u64 pure contract {
  requires 8_u64 <= run.len;
} {
  doc "A header invariant over a measure of the window it scans.";
  let seen = 0_u64;
  for (
    at in 0_u64..4_u64,
    invariant reserved: seen + 4_u64 <= run.len
  ) {
    let byte = run[at];
  }
  return seen;
}

fn main() -> status: ExitStatus pure {
  doc "A header invariant can use a window length as an affine factor alongside the counted range facts. This variant builds its window from a full array rather than from a counted fill.";
  let values = array_filled::<u8, 8>(value: 0_u8);
  let run = slots_from_array::<u8, 8>(values: values);
  let total = headroom(run: move run);
  return exit_status(code: 0_u8);
}
