alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn guarded(left: u32, right: u32) -> result: unit pure contract {
  define same = move left == move right;
  requires same;
} {
  doc "FN-8 names move in its own prohibition list, so a moved operand is rejected even where the operation, the domain, and the clause shape are all legal; the same clause without move is accepted.";
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
