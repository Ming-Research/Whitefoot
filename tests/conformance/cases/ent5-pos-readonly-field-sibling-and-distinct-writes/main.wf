alias Entry = pkg::kinds::Entry;
alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias kinds = pkg::kinds;

fn main() -> status: ExitStatus pure {
  doc "ENT-5, OWN-7: a write to a sibling field of the same element and a replacement of an element at a distinct literal offset overlap no storage of entries[1].width, so the guard's bound survives both and the cell reads discharge.";
  let narrow = kinds::make_entry(width: 3_u64, weight: 1_u64);
  let entries = array_filled::<Entry, 4>(value: narrow);
  let cells = array_filled::<u8, 3>(value: 7_u8);
  let total = 0_u64;
  if entries[1_u64].width <= cells.len {
    set entries[1_u64].weight = 7_u64;
    set entries[2_u64] = kinds::make_entry(width: 8_u64, weight: 1_u64);
    for (c in 0_u64..entries[1_u64].width) {
      let cell = cells[c];
      let widened = cvt::<u8, u64>(cell);
      set total = total +wrap widened;
    }
  }
  if total == 21_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
