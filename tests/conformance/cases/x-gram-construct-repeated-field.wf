alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Pair {
  P(a: i32, b: i32);
}

fn main() -> status: ExitStatus pure {
  doc "GRAM-8: constructing P writing field a twice (a, a) is rejected - the second slot must be b, and a repeat is not a spelling of it.";
  let x = Pair::P(a: 1_i32, a: 2_i32);
  return exit_status(code: 0_u8);
}
