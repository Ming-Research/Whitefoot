fn fill(value: &Frozen<u8>, out: &Array<u8, 1>) -> result: unit writes(out) contract {
  ensures forall filled(k in 0_u64..out^.len): out^[k] == value^.inner;
} {
  set out^[0_u64] = 0_u8;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
