struct Progress {
  n: u64;
}

fn passed(clocks: &Array<std::time::WallClock, 1>, deadline: i64) -> result: Bool reads(clocks) {
  doc "Reports whether the calendar time of the array's only wall clock has reached deadline.";
  let reading = std::time::unix_nanoseconds(clock: &clocks^[0_u64]);
  let reached = reading >= deadline;
  return reached;
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  doc "A guard whose call reads an array whose element is a wall clock reads that clock.";
  let std::process::Inputs(cwd: directory, handles: factory, wall_clock: wall, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let start = std::time::unix_nanoseconds(clock: &wall);
  let deadline = start +sat 1000000_i64;
  let built = slots_new::<std::time::WallClock, 1>();
  place_back(window: &built, value: move wall);
  let clocks = slots_into_array::<std::time::WallClock, 1>(values: move built);
  let initial = Progress(n: 0_u64);
  let state = shared_new::<Progress>(value: initial);
  atomic g = &state when passed(clocks: &clocks, deadline: deadline) {
    set g^.n = 1_u64;
  }
  return std::process::exit_status(code: 0_u8);
}
