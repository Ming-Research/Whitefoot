struct Pair {
  marker: u64;
  value: u64;
}

fn helper(frame: &Pair, other: &Pair) -> result: unit writes(frame.marker), writes(other.value) contract {
  requires frame^.value == 0_u64;
  ensures frame^.value == 0_u64;
} {
  set frame^.marker = 1_u64;
  set other^.value = 1_u64;
  return unit;
}

fn caller(f: &Pair) -> result: unit writes(f) contract {
  requires f^.value == 0_u64;
} {
  doc "EFF-5: the contract reads f^.value through frame, which overlaps other writes(f^.value).";
  helper(frame: f, other: f);
  return unit;
}
