alias ExitStatus = std::process::ExitStatus;
alias HostString = std::text::HostString;
alias exit_status = std::process::exit_status;

const values: Array<u8, 4> =[0_u8, 0_u8, 0_u8, 0_u8];

struct Pair {
  token: HostString;
  left: u64;
  right: u64;
}

fn write_left(pair: &Pair, value: u64) -> result: unit writes(pair.left) {
  doc "Writes exactly the field its declared row names.";
  set deref(pair).left = value;
  return unit;
}

fn preserve_right(pair: Pair) -> result: u8 pure contract {
  define spare = values.len;
  requires pair.right < spare;
} {
  doc "A callee writing one declared struct field preserves a bound supported only by its untouched sibling [ENT-5, EFF-2], so the constant-array subscript still discharges [OP-4].";
  write_left(pair: &pair, value: 0_u64);
  return values[pair.right];
}

fn main() -> status: ExitStatus pure {
  doc "No construction is needed to exercise the sibling survival.";
  return exit_status(code: 0_u8);
}
