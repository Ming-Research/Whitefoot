alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> return_value: ExitStatus pure {
  doc "GRAM-10: named match binders - each field written as field:binder (a fresh IDENT) in declared order.";
  let a = 40_i32;
  let v = match a +checked 2_i32 {
    Ok(value: w) => {
      give w;
    }
    Err(error: e) => {
      return exit_status(code: 1_u8);
    }
  }
  let code = cvt::<i32, u8>(v);
  return exit_status(code: code);
}
