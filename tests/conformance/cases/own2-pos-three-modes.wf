alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Counter {
  value: i32;
}

fn bump(c: &Counter) -> result: unit writes(c.value) {
  doc "Whether a callee may write through a reference parameter is stated by its effect row, not by a marker on the reference.";
  set deref(c).value = 9_i32;
  return unit;
}

fn main() -> return_value: ExitStatus pure {
  doc "A bare parameter type selects value mode and & selects a reference; deref reads the storage it names, while write authority is the callee's declared row.";
  let a = Counter(value: 5_i32);
  let s = &a;
  if deref(s).value == 5_i32 {
  } else {
    return exit_status(code: 1_u8);
  }
  bump(c: &a);
  if a.value == 9_i32 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
