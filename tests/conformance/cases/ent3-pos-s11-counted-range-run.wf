alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const values: Array<u8, 4> =[10_u8, 20_u8, 30_u8, 40_u8];

fn main() -> status: ExitStatus pure {
  doc "S11 proves each counted binder is below the captured upper endpoint, discharging the constant-array subscript; the run also fixes half-open exhaustion, a zero-trip range, and a break naming the counted loop [ENT-3, OP-4, FN-1].";
  let total = 0_u8;
  for @full (i in 0_u64..4_u64) {
    let value = values[i];
    set total = total +wrap value;
  }
  for @empty (i in 4_u64..4_u64) {
    set total = total +wrap 1_u8;
  }
  for @local (i in 0_u64..4_u64) {
    let value = values[i];
    set total = total +wrap value;
    break @local;
  }
  if total == 110_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
