alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Counter {
  value: i32;
}

enum Packet {
  Data(item: Counter);
}

fn main() -> return_value: ExitStatus pure {
  doc "A payload binder derived from matching through a reference names the scrutinee path extended by its payload step, so it writes that storage while the enum stays live and a second match reads the result back.";
  let counter = Counter(value: 4_i32);
  let packet = Packet::Data(item: counter);
  let holder = &packet;
  match deref(holder) {
    Data(item: payload) => {
      set deref(payload).value = 5_i32;
    }
  }
  match deref(holder) {
    Data(item: seen) => {
      if deref(seen).value == 5_i32 {
      } else {
        return exit_status(code: 1_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}
