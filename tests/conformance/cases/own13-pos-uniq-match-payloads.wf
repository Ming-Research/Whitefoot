alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Counter {
  value: i32;
}

enum Packet {
  Data(item: Counter);
}

fn main() -> return_value: ExitStatus pure {
  doc "A payload binder derived from matching through a reference names the scrutinee path extended by its payload step, so it writes that storage while the enum stays live and a second match reads the result back as the exit status 5.";
  let counter = Counter(value: 4_i32);
  let packet = Packet::Data(item: counter);
  let holder = &packet;
  match holder^ {
    Data(item: payload) => {
      set payload^.value = 5_i32;
    }
  }
  let code = 0_u8;
  match holder^ {
    Data(item: seen) => {
      set code = cvt::<i32, u8>(seen^.value);
    }
  }
  return exit_status(code: code);
}
