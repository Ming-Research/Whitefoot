alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn expect_one(length: u64) -> result: unit pure contract {
  requires length == 1_u64;
} {
  doc "Admits only a length its caller has proved equal to one.";
  return unit;
}

fn expect_nonzero(length: u64) -> result: unit pure contract {
  requires length != 0_u64;
} {
  doc "Admits only a length its caller has proved nonzero.";
  return unit;
}

fn preserved_value(rows: &Slots<Slots<u8, 4>, 2>, index: u64) -> result: u8 reads(rows) contract {
  requires index < rows^.len;
} {
  doc "Both signs of an indexed measure goal survive while its named offset is unchanged [ENT-5]: a reread of the measure inside each guarded branch discharges a requirement that restates the guard's sign.";
  if rows^[index].len == 1_u64 {
    let one_length = rows^[index].len;
    let one = expect_one(length: one_length);
  }
  if rows^[index].len == 0_u64 {
  } else {
    let some_length = rows^[index].len;
    let some = expect_nonzero(length: some_length);
  }
  return 0_u8;
}

fn unrelated_write(rows: &Slots<Slots<u8, 4>, 2>, index: u64) -> result: u8 reads(rows) contract {
  requires index < rows^.len;
} {
  doc "Writing another binding changes no support of either indexed measure goal [ENT-5]: after the write, a reread of the measure discharges a requirement that restates the guard's sign.";
  let other = 0_u64;
  if rows^[index].len == 1_u64 {
    set other = 1_u64;
    let one_length = rows^[index].len;
    let one = expect_one(length: one_length);
  }
  if rows^[index].len == 0_u64 {
  } else {
    set other = 1_u64;
    let some_length = rows^[index].len;
    let some = expect_nonzero(length: some_length);
  }
  return 0_u8;
}

fn literal_offset(rows: &Slots<Slots<u8, 4>, 2>, replacement: u64) -> result: u8 reads(rows) contract {
  requires 0_u64 < rows^.len;
} {
  doc "Literal offsets have no binding support [ENT-5, MSR-2]. Replacing the independent index binding preserves both signed measure goals over row zero, so a reread after the replacement discharges a requirement that restates the guard's sign.";
  let index = 0_u64;
  if rows^[0_u64].len == 1_u64 {
    set index = replacement;
    let one_length = rows^[0_u64].len;
    let one = expect_one(length: one_length);
  }
  if rows^[0_u64].len == 0_u64 {
  } else {
    set index = replacement;
    let some_length = rows^[0_u64].len;
    let some = expect_nonzero(length: some_length);
  }
  return 0_u8;
}

fn main() -> status: ExitStatus pure {
  doc "These source controls isolate proof availability without requiring native storage construction.";
  return exit_status(code: 0_u8);
}
