alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "WIN-3: assigning over an owned place releases the old value when it is affine, and the new value occupies the same place.";
  let b = box_new::<u64>(value: 1_u64);
  let c = box_new::<u64>(value: 2_u64);
  set b = move c;
  let seen = b.inner;
  if seen == 2_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
