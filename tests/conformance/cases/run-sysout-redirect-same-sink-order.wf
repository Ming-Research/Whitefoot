alias Args = std::text::Args;
alias DirectoryRead = std::fs::DirectoryRead;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;
alias arg_get = std::text::arg_get;
alias close_directory = std::fs::close_directory;
alias close_read = std::fs::close_read;
alias exit_status = std::process::exit_status;
alias open_read = std::fs::open_read;
alias read_at = std::fs::read_at;
alias relative_path = std::fs::relative_path;
alias write_once = std::io::write_once;

fn factory_refusal(error: &IoError) -> result: Bool reads(error) {
  match deref(error) {
    NotFound(code: native_code, origin: native_origin) => {
      return False();
    }
    PermissionDenied(code: native_code, origin: native_origin) => {
      return False();
    }
    AlreadyExists(code: native_code, origin: native_origin) => {
      return False();
    }
    NotDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    IsDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    DirectoryNotEmpty(code: native_code, origin: native_origin) => {
      return False();
    }
    ReadOnly(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceBusy(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidInput(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidPath(code: native_code, origin: native_origin) => {
      return False();
    }
    Unsupported(code: native_code, origin: native_origin) => {
      return False();
    }
    TimedOut(code: native_code, origin: native_origin) => {
      return False();
    }
    BrokenPipe(code: native_code, origin: native_origin) => {
      return False();
    }
    WriteZero(code: native_code, origin: native_origin) => {
      return False();
    }
    UnexpectedEnd(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionRefused(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionReset(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionAborted(code: native_code, origin: native_origin) => {
      return False();
    }
    NotConnected(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressInUse(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressUnavailable(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceExhausted(code: native_code, origin: native_origin) => {
      return deref(native_origin) == 0_u8;
    }
    FileTooLarge(code: native_code, origin: native_origin) => {
      return False();
    }
    NoSpace(code: native_code, origin: native_origin) => {
      return False();
    }
    QuotaExceeded(code: native_code, origin: native_origin) => {
      return False();
    }
    CrossDevice(code: native_code, origin: native_origin) => {
      return False();
    }
    DeviceFailure(code: native_code, origin: native_origin) => {
      return False();
    }
    Other(code: native_code, origin: native_origin) => {
      return False();
    }
  }
}

fn exercise(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> status: ExitStatus reads(args), reads(cwd), writes(out), writes(err), writes(files) {
  doc "Output calls and the later file read explicitly borrow the same HandleFactory state. Ordinary EFF-2/PAR-1 interference preserves the arranged shared sink order, including independently named aliased output streams; the readback observes the combined bytes.";
  let first = slots_new::<u8, 2>();
  place_back(window: &first, value: 65_u8);
  place_back(window: &first, value: 65_u8);
  let second = slots_new::<u8, 2>();
  place_back(window: &second, value: 66_u8);
  place_back(window: &second, value: 66_u8);
  let page = slots_new::<u8, 8>();
  for @scratch (
    at in 0_u64..8_u64,
    invariant grown: page.len >= at,
    invariant vacancy: page.cap - page.len + at >= 8_u64
  ) {
    place_back(window: &page, value: 0_u8);
  }
  let head = &first[0_u64..2_u64];
  match write_once(factory: files, output: out, source: head, start: 0_u64, end: 2_u64) {
    Ok(value: written) => {
    }
    Err(error: problem) => {
      return exit_status(code: 10_u8);
    }
  }
  let tail = &second[0_u64..2_u64];
  match write_once(factory: files, output: err, source: tail, start: 0_u64, end: 2_u64) {
    Ok(value: written) => {
    }
    Err(error: problem) => {
      return exit_status(code: 11_u8);
    }
  }
  match arg_get(args: args, position: 1_u64) {
    Ok(value: text) => {
      match relative_path(value: move text) {
        Ok(value: path) => {
          match open_read(factory: files, root: cwd, path: &path) {
            Ok(value: file) => {
              let window = &page[0_u64..8_u64];
              match read_at(factory: files, file: &file, destination: window, file_offset: 0_u64, start: 0_u64, end: 8_u64) {
                Ok(value: n) => {
                  let combined = n == 4_u64;
                  if combined {
                  } else {
                    close_read(factory: files, file: move file);
                    return exit_status(code: 12_u8);
                  }
                }
                Err(error: read_stop_32) => {
                  match read_stop_32 {
                    ReadEnd() => {
                      close_read(factory: files, file: move file);
                      return exit_status(code: 13_u8);
                    }
                    ReadFailed(error: problem) => {
                      close_read(factory: files, file: move file);
                      return exit_status(code: 14_u8);
                    }
                  }
                }
              }
              let byte0 = page[0_u64];
              let byte1 = page[1_u64];
              let byte2 = page[2_u64];
              let byte3 = page[3_u64];
              let head0 = byte0 == 65_u8;
              if head0 {
              } else {
                close_read(factory: files, file: move file);
                return exit_status(code: 15_u8);
              }
              let head1 = byte1 == 65_u8;
              if head1 {
              } else {
                close_read(factory: files, file: move file);
                return exit_status(code: 16_u8);
              }
              let tail0 = byte2 == 66_u8;
              if tail0 {
              } else {
                close_read(factory: files, file: move file);
                return exit_status(code: 17_u8);
              }
              let tail1 = byte3 == 66_u8;
              if tail1 {
                close_read(factory: files, file: move file);
                return exit_status(code: 0_u8);
              } else {
                close_read(factory: files, file: move file);
                return exit_status(code: 18_u8);
              }
            }
            Err(error: problem) => {
              if factory_refusal(error: &problem) {
                return exit_status(code: 22_u8);
              }
              return exit_status(code: 19_u8);
            }
          }
        }
        Err(error: rejected) => {
          return exit_status(code: 20_u8);
        }
      }
    }
    Err(error: absent) => {
      return exit_status(code: 21_u8);
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "PRE-2 ordinary Inputs are destructured once; the borrowed operation chain returns before the initial directory is explicitly closed on every exit.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: files, stdin: unused_stdin) = move inputs;
  let outcome = exercise(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return move outcome;
}
