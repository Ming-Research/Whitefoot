alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn window_last<const n: u64>(buf: Slots<u8, n>, start: u64, end: u64) -> value: u8 pure contract {
  define spare = buf.len;
  requires start < end;
  requires end <= spare;
} {
  let last_index = end - 1_u64;
  let value = buf[last_index];
  return value;
}

fn ring_slot<const n: u64>(buf: Slots<u8, n>, front: u64, used: u64) -> value: u8 pure contract {
  define capacity = buf.len;
  requires capacity > 0_u64;
} {
  let modulus = buf.len;
  let raw = front +wrap used;
  let slot = raw % modulus;
  let value = buf[slot];
  return value;
}

fn ring_slot_sub<const n: u64>(buf: Slots<u8, n>, front: u64, used: u64) -> value: u8 pure contract {
  define capacity = buf.len;
  requires front < capacity;
  requires used < capacity;
  requires capacity <= 4294967296_u64;
} {
  let modulus = buf.len;
  let raw = front + used;
  let too_big = raw >= modulus;
  let value = if too_big {
    let wrapped = raw - modulus;
    invariant wrapped_ok: wrapped < modulus;
    let byte = buf[wrapped];
    give byte;
  } else {
    invariant raw_ok: raw < modulus;
    let byte = buf[raw];
    give byte;
  }
  return value;
}

fn sum_chunks<const n: u64>(buf: Slots<u8, n>, chunk_size: u64) -> total: u64 pure contract {
  define spare = buf.len;
  requires chunk_size > 0_u64;
  requires chunk_size <= 2147483648_u64;
  requires spare <= 2147483648_u64;
} {
  let room = buf.len;
  let cursor = 0_u64;
  let total = 0_u64;
  loop (
    invariant cursor_in_range: cursor <= room
  ) {
    let chunk_end = cursor + chunk_size;
    let has_full_chunk = chunk_end <= room;
    if has_full_chunk {
      let first = buf[cursor];
      let widened = cvt::<u8, u64>(first);
      set total = total +wrap widened;
      set cursor = chunk_end;
    } else {
      break;
    }
  }
  return total;
}

fn shifted_read<const n: u64>(buf: Slots<u8, n>, base: u64, delta: u64) -> value: u8 pure contract {
  define spare = buf.len;
  requires spare <= 4294967296_u64;
  requires base < spare;
  requires delta < spare;
} {
  let room = buf.len;
  let offset = base + delta;
  invariant offset_double_bounded: offset < 2_u64 * room;
  let too_far = offset >= room;
  if too_far {
    return buf[0_u64];
  } else {
    let value = buf[offset];
    return value;
  }
}

fn block_checksum<const n: u64>(data: Slots<u8, n>, block_size: u64) -> total: u32 pure contract {
  requires block_size > 0_u64;
} {
  let capacity = data.len;
  let pos = 0_u64;
  let sum = 0_u32;
  loop @blocks (
    invariant progress: pos <= capacity
  ) {
    let has_more = pos < capacity;
    if has_more {
    } else {
      break @blocks;
    }
    match pos +checked block_size {
      Ok(value: would_be) => {
        let fits = would_be <= capacity;
        if fits {
          let stop = would_be;
          for (i in pos..stop) {
            let byte = data[i];
            let wide = cvt::<u8, u32>(byte);
            set sum = sum +wrap wide;
          }
          set pos = stop;
        } else {
          for (i in pos..capacity) {
            let byte = data[i];
            let wide = cvt::<u8, u32>(byte);
            set sum = sum +wrap wide;
          }
          set pos = capacity;
        }
      }
      Err(error: overflow) => {
        for (i in pos..capacity) {
          let byte = data[i];
          let wide = cvt::<u8, u32>(byte);
          set sum = sum +wrap wide;
        }
        set pos = capacity;
      }
    }
  }
  return sum;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
