struct Stack {
  slots: Slots<u64, 8>;
  invariant nonempty(stack): stack.slots.len >= 1_u64;
}

fn replace_last(stack: &Stack, value: u64) -> result: unit writes(stack.slots.last), writes(stack.slots.next), writes(stack.slots.len) {
  let old = take_back(window: &stack^.slots);
  place_back(window: &stack^.slots, value: value);
  return unit;
}

fn first_slot(window: &Slots<u64, 8>) -> result: u64 reads(window) contract {
  requires window^.len > 0_u64;
} {
  let got = window^[0_u64];
  return got;
}

fn requirement_after(stack: &Stack) -> result: u64 writes(stack) {
  replace_last(stack: stack, value: 7_u64);
  let got = first_slot(window: &stack^.slots);
  return got;
}

fn index_after(stack: &Stack) -> result: u64 writes(stack) {
  replace_last(stack: stack, value: 9_u64);
  let got = stack^.slots[0_u64];
  return got;
}
