alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const earlier_one: u32 = 1_u32;

fn require_bound(value: u32, operand: u32) -> result: unit pure contract {
  requires value <= operand;
} {
  return unit;
}

fn require_nonzero(value: u32) -> result: unit pure contract {
  requires value != 0_u32;
} {
  return unit;
}

fn sources(left: u32, right: u32, count: u32) -> result: unit pure {
  let masked = iand(left, right);
  require_bound(value: masked, operand: left);
  require_bound(value: masked, operand: right);
  let shifted_literal = ishl.wrap(1_u32, count);
  require_nonzero(value: shifted_literal);
  let shifted_named = ishl.wrap(earlier_one, count);
  require_nonzero(value: shifted_named);
  return unit;
}

fn main() -> status: ExitStatus pure {
  sources(left: 7_u32, right: 3_u32, count: 2_u32);
  return exit_status(code: 0_u8);
}
