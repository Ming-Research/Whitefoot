alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn inner(p: i64, k: i64, j: i64, n: i64) -> at: i64 pure contract {
  requires n <= 1000_i64;
  requires k <= 1000_i64;
  requires p < k;
  requires j < n;
} {
  doc "A signed multiplicity could scale a premise by a negative number, which reverses it.";
  let span = n * k;
  let base = n * p;
  let at = base + j;
  invariant fits: base + j < span {
    use n times (p < k);
    use (j < n);
  }
  return at;
}

fn main() -> status: ExitStatus pure {
  let at = inner(p: 1_i64, k: 2_i64, j: 3_i64, n: 4_i64);
  return exit_status(code: 0_u8);
}
