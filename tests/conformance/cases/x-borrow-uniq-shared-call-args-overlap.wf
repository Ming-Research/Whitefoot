alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn mix(a: &Slots<u8, 4>, b: &Slots<u8, 4>) -> function_result: unit reads(b), writes(a) contract {
  requires 1_u64 <= deref(a).len;
  requires 1_u64 <= deref(b).len;
} {
  doc "Reads through one reference parameter and writes through the other.";
  let seen = deref(b)[0_u64];
  set deref(a)[0_u64] = seen;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "EFF-5: at a call the actual argument paths are substituted into the callee's row and compared pairwise. Both arguments name the same run, so the substituted write and read overlap and are not proved disjoint; the call is refused, carrying both substituted paths.";
  let x = slots_new::<u8, 4>();
  place_back(window: &x, value: 0_u8);
  mix(a: &x, b: &x);
  return exit_status(code: 0_u8);
}
