fn bump(marks: &[u64], x: u64) -> result: u8 pure contract {
  requires forall small(k in 0_u64..marks^.len): marks^[k] < 8_u64;
} {
  let v = 0_u8;
  if x < 10_u64 {
    if x == 1_u64 {
      set v = 1_u8;
    } else if x == 2_u64 {
      set v = 2_u8;
    } else {
      return 100_u8;
    }
  } else {
    set v = 4_u8;
  }
  let w = 251_u8 + v;
  return w;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
