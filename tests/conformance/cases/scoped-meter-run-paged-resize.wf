alias MeterScope = std::process::MeterScope;
alias MemoryMeter = std::process::MemoryMeter;
alias ScopeView = std::process::ScopeView;
alias ScopeBody = std::process::ScopeBody;

fn build(argument: unit) -> result: Box<Paged<u64>> pure {
  return box_paged_new::<u64>(capacity: 0_u64);
}

binding Build : ScopeBody<unit, Box<Paged<u64>>> {
  run = build;
}

fn enlarge(argument: Box<Paged<u64>>) -> result: Box<Paged<u64>> pure {
  if argument.inner.cap <= 513_u64 {
    grow_paged(cell: &argument, capacity: 513_u64);
  }
  return move argument;
}

binding Enlarge : ScopeBody<Box<Paged<u64>>, Box<Paged<u64>>> {
  run = enlarge;
}

fn release(value: Box<Paged<u64>>) -> result: unit pure {
  return unit;
}

fn positive(view: &ScopeView) -> result: Bool writes(view) waits {
  let reading = std::process::scope_bytes(view: view);
  match reading {
    Some(value: bytes) => {
      return bytes > 0_u64;
    }
    None() => {
      return False();
    }
  }
}

fn empty(view: &ScopeView) -> result: Bool writes(view) waits {
  let reading = std::process::scope_bytes(view: view);
  match reading {
    Some(value: bytes) => {
      return bytes == 0_u64;
    }
    None() => {
      return False();
    }
  }
}

fn close(meter: &MemoryMeter, scope: MeterScope) -> result: unit writes(meter) waits {
  loop {
    let closed = std::process::scope_close(meter: meter, scope: move scope);
    match move closed {
      Ok(value: done) => {
        return done;
      }
      Err(error: owner) => {
        set scope = move owner;
      }
    }
  }
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  let std::process::Inputs(cwd: directory, handles: handles, memory_meter: meter, ..) = move inputs;
  let std::fs::Directory(read: read, write: write) = move directory;
  std::fs::close_directory_write(factory: &handles, directory: move write);
  std::fs::close_directory(factory: &handles, directory: move read);
  let opened_a = std::process::scope_open(meter: &meter);
  match move opened_a {
    Err(error: full) => {
      return std::process::exit_status(code: 2_u8);
    }
    Ok(value: a) => {
      let av = std::process::scope_view(scope: &a);
      let built = spawn std::process::scope_run::<Build>(scope: move a, argument: unit);
      match move built {
        Refused(scope: refused_a, argument: original) => {
          close(meter: &meter, scope: move refused_a);
          return std::process::exit_status(code: 3_u8);
        }
        Ran(scope: returned_a, result: block) => {
          let before = positive(view: &av);
          let opened_b = std::process::scope_open(meter: &meter);
          match move opened_b {
            Err(error: exhausted) => {
              release(value: move block);
              close(meter: &meter, scope: move returned_a);
              return std::process::exit_status(code: 4_u8);
            }
            Ok(value: b) => {
              let bv = std::process::scope_view(scope: &b);
              let grown = spawn std::process::scope_run::<Enlarge>(scope: move b, argument: move block);
              match move grown {
                Refused(scope: refused_b, argument: refused_block) => {
                  release(value: move refused_block);
                  close(meter: &meter, scope: move refused_b);
                  close(meter: &meter, scope: move returned_a);
                  return std::process::exit_status(code: 5_u8);
                }
                Ran(scope: returned_b, result: larger) => {
                  let capacity = larger.inner.cap == 513_u64;
                  let directory_retained = positive(view: &av);
                  let pages_added = positive(view: &bv);
                  release(value: move larger);
                  let a_empty = empty(view: &av);
                  let b_empty = empty(view: &bv);
                  close(meter: &meter, scope: move returned_b);
                  close(meter: &meter, scope: move returned_a);
                  let not_before = bnot(before);
                  if not_before {
                    return std::process::exit_status(code: 6_u8);
                  }
                  let wrong_capacity = bnot(capacity);
                  if wrong_capacity {
                    return std::process::exit_status(code: 7_u8);
                  }
                  let directory_lost = bnot(directory_retained);
                  if directory_lost {
                    return std::process::exit_status(code: 8_u8);
                  }
                  let pages_missing = bnot(pages_added);
                  if pages_missing {
                    return std::process::exit_status(code: 9_u8);
                  }
                  let a_charged = bnot(a_empty);
                  if a_charged {
                    return std::process::exit_status(code: 10_u8);
                  }
                  let b_charged = bnot(b_empty);
                  if b_charged {
                    return std::process::exit_status(code: 11_u8);
                  }
                  return std::process::exit_status(code: 0_u8);
                }
              }
            }
          }
        }
      }
    }
  }
}
