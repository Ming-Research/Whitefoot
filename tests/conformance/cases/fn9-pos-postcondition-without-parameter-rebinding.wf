fn reset(p: &u64) -> result: unit writes(p) contract {
  ensures p^ == 1_u64;
} {
  doc "The control for fn9-neg-postcondition-after-parameter-rebinding: the body writes one to the caller's cell and does not rebind p, so the postcondition is proved.";
  set p^ = 1_u64;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The published postcondition makes the divisor one, and the quotient ten is the exit status.";
  let x = 5_u64;
  reset(p: &x);
  let quotient = 10_u64 / x;
  let code = cvt::<u64, u8>(quotient);
  return std::process::exit_status(code: code);
}
