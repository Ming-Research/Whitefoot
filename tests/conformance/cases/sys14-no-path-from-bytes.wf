alias ExitStatus = std::process::ExitStatus;
alias HostString = std::text::HostString;
alias Inputs = std::process::Inputs;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias relative_path = std::fs::relative_path;

fn exercise() -> status: ExitStatus pure {
  doc "The ordinary relative_path parameter is HostString. Passing a run of u8 is a normal FN-1 argument type mismatch; no path-from-bytes conversion is declared.";
  let name = slots_new::<u8, 3>();
  place_back(window: &name, value: 97_u8);
  place_back(window: &name, value: 98_u8);
  place_back(window: &name, value: 99_u8);
  match relative_path(value: move name) {
    Ok(value: path) => {
      return exit_status(code: 7_u8);
    }
    Err(error: problem) => {
      return exit_status(code: 8_u8);
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "PRE-2 ordinary Inputs are destructured once; the operation chain returns before the initial directory is explicitly closed on every exit.";
  let Inputs(args: unused_args, cwd: cwd, stdout: unused_stdout, stderr: unused_stderr, handles: entry_factory, stdin: unused_stdin) = move inputs;
  let outcome = exercise();
  close_directory(factory: &entry_factory, directory: move cwd);
  return move outcome;
}
