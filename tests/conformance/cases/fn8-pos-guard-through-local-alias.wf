fn fill(w: &Slots<u64, 4>) -> result: unit writes(w) {
  doc "q and r both name the caller's window exactly, so the guard read through q and place_back's requirement through r name one place.";
  let q = &w^;
  let r = &w^;
  if q^.len < q^.cap {
    place_back(window: r, value: 7_u64);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The window starts empty, so the guarded append runs once.";
  let w = slots_new::<u64, 4>();
  fill(w: &w);
  if w.len == 1_u64 {
    return std::process::exit_status(code: 0_u8);
  }
  return std::process::exit_status(code: 1_u8);
}
