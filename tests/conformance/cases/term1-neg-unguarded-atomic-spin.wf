alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn poll(cell: &Shared<u64>) -> result: u64 reads(cell) waits {
  doc "An unguarded atomic statement takes effect at once and is no wait, so polling with one makes no progress [TERM-1, SHARE-3].";
  let seen = 0_u64;
  loop {
    atomic value = &cell^ {
      set seen = value^;
    }
    if seen != 0_u64 {
      break;
    }
  }
  return seen;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
