struct Cell {
  digits: Array<u8, 2>;
}

fn produce(cell: &Cell, index: u64, fail: Bool) -> outcome: Result<u8, u8> writes(cell.digits) contract {
  requires index < cell^.digits.len;
  ensures when Ok(value: digit): digit <= cell^.digits[index];
} {
  if fail {
    let forwarded = Err<u8, u8>(error: 0_u8);
    return forwarded;
  }
  set cell^.digits[index] = 1_u8;
  return Ok<u8, u8>(value: 1_u8);
}

fn main() -> status: std::process::ExitStatus pure {
  let digits = array_filled::<u8, 2>(value: 0_u8);
  let cell = Cell(digits: digits);
  let failed = produce(cell: &cell, index: 0_u64, fail: true);
  let succeeded = produce(cell: &cell, index: 1_u64, fail: false);
  return std::process::exit_status(code: 0_u8);
}
