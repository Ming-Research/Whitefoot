  let u32_middle = edges_u32(value: 1_u32);
  if u32_middle != 3_u8 {
    return std::process::exit_status(code: 1_u8);
  }
  let i64_min = edges_i64(value: -9223372036854775808_i64);
  if i64_min != 1_u8 {
    return std::process::exit_status(code: 1_u8);
  }
  let i64_max = edges_i64(value: 9223372036854775807_i64);
  if i64_max != 2_u8 {
