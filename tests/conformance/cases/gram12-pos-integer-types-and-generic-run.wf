fn generic<T: Int>(value: T) -> result: u8 pure {
  match value {
    0_T => {
      return 0_u8;
    }
    1_T => {
      return 1_u8;
    }
    else => {
      return 2_u8;
    }
  }
}

fn main() -> status: std::process::ExitStatus pure {
  let i8_min = edges_i8(value: -128_i8);
  if i8_min != 1_u8 {
    return std::process::exit_status(code: 1_u8);
  }
  let i8_max = edges_i8(value: 127_i8);
  if i8_max != 2_u8 {
    return std::process::exit_status(code: 1_u8);
  }
  let i8_middle = edges_i8(value: 0_i8);
  if i8_middle != 3_u8 {
    return std::process::exit_status(code: 1_u8);
  }
  let u8_min = edges_u8(value: 0_u8);
