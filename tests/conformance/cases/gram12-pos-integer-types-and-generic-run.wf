fn edges_i8(value: i8) -> result: u8 pure {
  match value {
    -128_i8 => {
      return 1_u8;
    }
    127_i8 => {
      return 2_u8;
    }
    else => {
      return 3_u8;
    }
  }
}

fn edges_u8(value: u8) -> result: u8 pure {
  match value {
    0_u8 => {
      return 1_u8;
    }
    255_u8 => {
      return 2_u8;
    }
    else => {
      return 3_u8;
    }
  }
}

