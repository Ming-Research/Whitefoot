  let u64_middle = edges_u64(value: 1_u64);
  if u64_middle != 3_u8 {
    return std::process::exit_status(code: 1_u8);
  }
  let generic_i8_0 = generic::<i8>(value: 0_i8);
  if generic_i8_0 != 0_u8 {
    return std::process::exit_status(code: 2_u8);
