struct EqRecord {
  small: u8;
  wide: u64;
}

enum EqPayload {
  EqEmpty();
  EqWide(first: u64, second: u64, flag: Bool);
  EqSmall(value: u8);
}

fn main() -> status: std::process::ExitStatus pure {
  let first = EqRecord(small: 3_u8, wide: 17_u64);
  let same = EqRecord(small: 3_u8, wide: 17_u64);
  let changed = EqRecord(small: 3_u8, wide: 18_u64);
  let flag = True();
  let other_flag = False();
  let wide = EqPayload::EqWide(first: 7_u64, second: 9_u64, flag: flag);
  let same_wide = EqPayload::EqWide(first: 7_u64, second: 9_u64, flag: flag);
  let changed_wide = EqPayload::EqWide(first: 7_u64, second: 10_u64, flag: flag);
  let changed_flag = EqPayload::EqWide(first: 7_u64, second: 9_u64, flag: other_flag);
  let small = EqPayload::EqSmall(value: 7_u8);
  let empty = EqPayload::EqEmpty();
  let some = Some<u32>(value: 13_u32);
  let same_some = Some<u32>(value: 13_u32);
  let other_some = Some<u32>(value: 14_u32);
  let none = None<u32>();
  let bytes = array_filled::<u8, 4>(value: 8_u8);
  let same_bytes = array_filled::<u8, 4>(value: 8_u8);
  let changed_bytes = array_filled::<u8, 4>(value: 8_u8);
  set changed_bytes[3_u64] = 9_u8;
  let records = array_filled::<EqRecord, 4>(value: first);
  let same_records = array_filled::<EqRecord, 4>(value: same);
  let changed_records = array_filled::<EqRecord, 4>(value: same);
  set changed_records[2_u64] = changed;
  let empty_bytes = array_filled::<u8, 0>(value: 0_u8);
  let empty_other = array_filled::<u8, 0>(value: 1_u8);
  if first == same {
  } else {
    return std::process::exit_status(code: 1_u8);
  }
  if first != same {
    return std::process::exit_status(code: 2_u8);
  }
  if first == changed {
    return std::process::exit_status(code: 3_u8);
  }
  if first != changed {
  } else {
    return std::process::exit_status(code: 4_u8);
  }
  if wide == same_wide {
  } else {
    return std::process::exit_status(code: 5_u8);
  }
  if wide != same_wide {
    return std::process::exit_status(code: 6_u8);
  }
  if wide == changed_wide {
    return std::process::exit_status(code: 7_u8);
  }
  if wide != changed_wide {
  } else {
    return std::process::exit_status(code: 8_u8);
  }
  if wide == changed_flag {
    return std::process::exit_status(code: 9_u8);
  }
  if wide != changed_flag {
  } else {
    return std::process::exit_status(code: 10_u8);
  }
  if wide == small {
    return std::process::exit_status(code: 11_u8);
  }
  if wide != small {
  } else {
    return std::process::exit_status(code: 12_u8);
  }
  if wide == empty {
    return std::process::exit_status(code: 13_u8);
  }
  if wide != empty {
  } else {
    return std::process::exit_status(code: 14_u8);
  }
  if empty == empty {
  } else {
    return std::process::exit_status(code: 15_u8);
  }
  if empty != empty {
    return std::process::exit_status(code: 16_u8);
  }
  if some == same_some {
  } else {
    return std::process::exit_status(code: 17_u8);
  }
  if some != same_some {
    return std::process::exit_status(code: 18_u8);
  }
  if some == other_some {
    return std::process::exit_status(code: 19_u8);
  }
  if some != other_some {
  } else {
    return std::process::exit_status(code: 20_u8);
  }
  if some == none {
    return std::process::exit_status(code: 21_u8);
  }
  if some != none {
  } else {
    return std::process::exit_status(code: 22_u8);
  }
  if none == none {
  } else {
    return std::process::exit_status(code: 23_u8);
  }
  if none != none {
    return std::process::exit_status(code: 24_u8);
  }
  if bytes == same_bytes {
  } else {
    return std::process::exit_status(code: 25_u8);
  }
  if bytes != same_bytes {
    return std::process::exit_status(code: 26_u8);
  }
  if bytes == changed_bytes {
    return std::process::exit_status(code: 27_u8);
  }
  if bytes != changed_bytes {
  } else {
    return std::process::exit_status(code: 28_u8);
  }
  if records == same_records {
  } else {
    return std::process::exit_status(code: 29_u8);
  }
  if records != same_records {
    return std::process::exit_status(code: 30_u8);
  }
  if records == changed_records {
    return std::process::exit_status(code: 31_u8);
  }
  if records != changed_records {
  } else {
    return std::process::exit_status(code: 32_u8);
  }
  if unit == unit {
  } else {
    return std::process::exit_status(code: 33_u8);
  }
  if unit != unit {
    return std::process::exit_status(code: 34_u8);
  }
  if empty_bytes == empty_other {
  } else {
    return std::process::exit_status(code: 35_u8);
  }
  if empty_bytes != empty_other {
    return std::process::exit_status(code: 36_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
