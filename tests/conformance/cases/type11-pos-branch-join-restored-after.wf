struct Index {
  value: u64;
  invariant bounded(index): index.value < 16_u64;
}

fn lookup(index: &Index, table: &Array<u64, 16>) -> result: u64 reads(index), reads(table) {
  let at = index^.value;
  let got = table^[at];
  return got;
}

fn branch_restored_after(flag: Bool, table: &Array<u64, 16>) -> result: u64 reads(table) {
  let idx = Index(value: 3_u64);
  if flag {
    set idx.value = 31_u64;
  }
  set idx.value = 3_u64;
  let got = lookup(index: &idx, table: table);
  return got;
}
