struct ZeroesAliasGiveDistinct {
  cells: Array<u64, 1>;
  invariant(c): forall zero(k in 0_u64..c^.cells.len): c^.cells[k] == 0_u64;
}

fn need_aliasgivedistinct(z: &ZeroesAliasGiveDistinct) -> result: unit pure {
  return unit;
}

fn update_aliasgivedistinct(first: Shared<ZeroesAliasGiveDistinct>, second: Shared<ZeroesAliasGiveDistinct>, flag: Bool) -> result: u64 pure waits {
  let picked = if flag {
    atomic a = &first, b = &second {
      set a^.cells[0_u64] = 1_u64;
      set b^.cells[0_u64] = 0_u64;
      need_aliasgivedistinct(z: b);
      give 5_u64;
    }
  } else {
    give 200_u64;
  }
  return picked;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
