struct Cursor {
  index: u64;
}

fn write(values: &Array<u8, 2>, cursor: &Cursor, target: &u64) -> result: unit writes(target) contract {
  requires cursor^.index < values^.len;
  requires values^[cursor^.index] == 0_u8;
} {
  set target^ = 1_u64;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let values = array_filled::<u8, 2>(value: 0_u8);
  let cursor = Cursor(index: 0_u64);
  let other = 0_u64;
  if cursor.index < values.len {
    if values[cursor.index] == 0_u8 {
      write(values: &values, cursor: &cursor, target: &other);
    }
  }
  return std::process::exit_status(code: 0_u8);
}
