alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias read_next = std::io::read_next;

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "The ordinary read_next implementation returns Ok(start) without transfer for an empty range. The following nonempty read still observes the first arranged byte.";
  let Inputs(args: unused_args, cwd: unused_cwd, stdout: unused_stdout, stderr: unused_stderr, handles: entry_factory, stdin: input) = move inputs;
  close_directory(factory: &entry_factory, directory: move unused_cwd);
  let chunk = slots_new::<u8, 4>();
  for @scratch (
    at in 0_u64..4_u64,
    invariant grown: chunk.len >= at,
    invariant vacancy: chunk.cap - chunk.len + at >= 4_u64
  ) {
    place_back(window: &chunk, value: 0_u8);
  }
  let outcome = 0_u8;
  let window = &chunk[0_u64..4_u64];
  match read_next(factory: &entry_factory, input: &input, destination: window, start: 2_u64, end: 2_u64) {
    Ok(value: endpoint) => {
      let unmoved = endpoint == 2_u64;
      if unmoved {
      } else {
        set outcome = 6_u8;
      }
    }
    Err(error: read_stop_24) => {
      match read_stop_24 {
        ReadEnd() => {
          set outcome = 7_u8;
        }
        ReadFailed(error: problem) => {
          set outcome = 8_u8;
        }
      }
    }
  }
  if outcome == 0_u8 {
    match read_next(factory: &entry_factory, input: &input, destination: window, start: 0_u64, end: 4_u64) {
      Ok(value: endpoint) => {
      }
      Err(error: read_stop_25) => {
        match read_stop_25 {
          ReadEnd() => {
            set outcome = 10_u8;
          }
          ReadFailed(error: problem) => {
            set outcome = 11_u8;
          }
        }
      }
    }
  }
  if outcome == 0_u8 {
    let first = chunk[0_u64];
    let expected = first == 65_u8;
    if expected {
    } else {
      set outcome = 9_u8;
    }
  }
  return exit_status(code: outcome);
}
