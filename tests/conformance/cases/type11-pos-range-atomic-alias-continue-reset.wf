struct ZeroesAliasContinueReset {
  cells: Array<u64, 1>;
  invariant(c): forall zero(k in 0_u64..c^.cells.len): c^.cells[k] == 0_u64;
}

fn need_aliascontinuereset(z: &ZeroesAliasContinueReset) -> result: unit pure {
  return unit;
}

fn update_aliascontinuereset(first: Shared<ZeroesAliasContinueReset>, second: Shared<ZeroesAliasContinueReset>) -> result: unit pure waits {
  for (i in 0_u64..1_u64) {
    atomic a = &first, b = &second {
      set a^.cells[0_u64] = 1_u64;
      set a^.cells[0_u64] = 0_u64;
      need_aliascontinuereset(z: b);
      continue;
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
