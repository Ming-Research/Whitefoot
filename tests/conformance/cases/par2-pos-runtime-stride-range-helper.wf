alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn fill(output: &[u64]) -> result: u64 writes(output) {
  doc "Fills every element of the range reference it was handed.";
  let count = deref(output).len;
  for (i in 0_u64..count) {
    set deref(output)[i] = 7_u64;
  }
  return count;
}

fn rows(width: u64) -> result: Box<Array<u64>> pure contract {
  requires width <= 32_u64;
} {
  doc "Three adjacent runtime-width rows are filled through range references whose endpoints are proved inside the allocation.";
  let cells = 3_u64 * width;
  let values = box_array_filled::<u64>(count: cells, value: 0_u64);
  for (i in 0_u64..3_u64) {
    let start = i * width;
    let end = start + width;
    invariant bounded: end <= cells {
      use width times (i + 1_u64 <= 3_u64);
    }
    let row = &values.inner[start..end];
    let filled = fill(output: row);
  }
  return move values;
}

fn main() -> status: ExitStatus pure {
  doc "The retained exact products and the explicit endpoint proof permit the adjacent range assignment; zero stride is also a valid empty assignment.";
  let values = rows(width: 5_u64);
  let count = values.inner.len;
  if count != 15_u64 {
    return exit_status(code: 1_u8);
  }
  for (i in 0_u64..count) {
    let seen = values.inner[i];
    if seen != 7_u64 {
      return exit_status(code: 2_u8);
    }
  }
  let empty = rows(width: 0_u64);
  let zero = empty.inner.len;
  if zero != 0_u64 {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
