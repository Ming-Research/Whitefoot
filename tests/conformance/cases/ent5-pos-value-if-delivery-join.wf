alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn guard(value: i32) -> result: unit pure contract {
  requires value < 128_i32;
} {
  return unit;
}

fn choose(value: i32, narrow: Bool) -> result: i32 pure {
  let picked = if narrow {
    let narrow_value = value % 8_i32;
    give narrow_value;
  } else {
    let wide_value = value % 128_i32;
    give wide_value;
  }
  guard(value: picked);
  return picked;
}

fn main() -> status: ExitStatus pure {
  let take_narrow = True();
  let narrow = choose(value: 7_i32, narrow: take_narrow);
  if narrow == 7_i32 {
  } else {
    return exit_status(code: 201_u8);
  }
  let take_wide = False();
  let wide = choose(value: 127_i32, narrow: take_wide);
  if wide == 127_i32 {
  } else {
    return exit_status(code: 202_u8);
  }
  return exit_status(code: 0_u8);
}
