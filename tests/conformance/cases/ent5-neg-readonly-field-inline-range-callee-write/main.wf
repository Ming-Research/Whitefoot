alias Entry = pkg::kinds::Entry;
alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias kinds = pkg::kinds;

fn clobber(v: &[Entry], at: u64) -> result: unit writes(v) contract {
  requires at < deref(v).len;
} {
  doc "Replaces one element of the range with a wide one.";
  let wide = kinds::make_entry(width: 8_u64, weight: 1_u64);
  set deref(v)[at] = wide;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "ENT-5, CALL-3: the guard bounds entries[i].width. The call's actual is a range formed at the argument, &entries[1..3], whose resolved place is entries extended by that range step [REF-4, EFF-5]; the projected write reaches the range's element storage, which overlaps entries[i] under OWN-7, so the readonly-field term dies at the call. The widened element's endpoint then leaves cells[c] with an unproved c < cells.len.";
  let narrow = kinds::make_entry(width: 3_u64, weight: 1_u64);
  let entries = array_filled::<Entry, 4>(value: narrow);
  let cells = array_filled::<u64, 3>(value: 7_u64);
  let i = 1_u64;
  let total = 0_u64;
  if entries[i].width <= cells.len {
    clobber(v: &entries[1_u64..3_u64], at: 0_u64);
    for (c in 0_u64..entries[i].width) {
      let cell = cells[c];
      set total = total +wrap cell;
    }
  }
  return exit_status(code: 0_u8);
}
