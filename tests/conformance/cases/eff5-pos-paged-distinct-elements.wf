fn copy_one(from: &u64, into: &u64) -> result: unit reads(from), writes(into) {
  set into^ = from^;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let p = box_paged_new::<u64>(capacity: 2_u64);
  place_back(window: &p.inner, value: 17_u64);
  place_back(window: &p.inner, value: 0_u64);
  copy_one(from: &p.inner[0_u64], into: &p.inner[1_u64]);
  if p.inner[1_u64] != 17_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
