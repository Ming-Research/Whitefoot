alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn write_slot(window: &Slots<u64, 4>, index: u64) -> result: unit writes(window[index]) contract {
  requires index < deref(window).len;
} {
  doc "Writes element 0 of the window when index is at least 1.";
  if 1_u64 <= index {
    set index = 0_u64;
  }
  set deref(window)[index] = 9_u64;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "EFF-1, EFF-2, SET-1: the conditional form of set1-neg-row-index-write-after-index-parameter-write. After the join index may no longer hold its call value, so deref(window)[index] is not the row's window[index] and the set is refused.";
  let r = slots_new::<u64, 4>();
  place_back(window: &r, value: 1_u64);
  place_back(window: &r, value: 2_u64);
  let p = &r[0_u64];
  write_slot(window: &r, index: 1_u64);
  let seen = deref(p);
  if seen == 1_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
