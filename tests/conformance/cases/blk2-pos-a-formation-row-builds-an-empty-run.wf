alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn build() -> result: Slots<u8, 4> pure {
  doc "Forms an empty frame-resident run of four slots.";
  return slots_new::<u8, 4>();
}

fn main() -> status: ExitStatus pure {
  doc "slots_new forms an empty frame-resident run and publishes its length and its capacity exactly, which is the completeness a construction record owes. The helper writes no clause of its own; what the case fixes is that the record exists, resolves, hands a run back, and lowers.";
  return exit_status(code: 0_u8);
}
