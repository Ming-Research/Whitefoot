alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn merge_step(left: Array<u32, 3>, right: Array<u32, 3>, out: Array<u32, 3>, i: u64, j: u64, k: u64) -> result: Array<u32, 3> pure contract {
  requires i <= 3_u64;
  requires j <= 3_u64;
  requires k <= 3_u64;
} {
  doc "ACCEPT: merges two sorted 3-slot arrays by recursively advancing whichever index holds the smaller current element; each recursive step re-establishes the same three-index contract, so no subscript needs a written certificate.";
  let i_more = i < 3_u64;
  if i_more {
  } else {
    return out;
  }
  let j_more = j < 3_u64;
  if j_more {
  } else {
    return out;
  }
  let k_more = k < 3_u64;
  if k_more {
  } else {
    return out;
  }
  let lv = left[i];
  let rv = right[j];
  let take_left = lv <= rv;
  let work = out;
  if take_left {
    set work[k] = lv;
    let next_i = i + 1_u64;
    let next_k = k + 1_u64;
    return merge_step(left: left, right: right, out: work, i: next_i, j: j, k: next_k);
  } else {
    set work[k] = rv;
    let next_j = j + 1_u64;
    let next_k = k + 1_u64;
    return merge_step(left: left, right: right, out: work, i: i, j: next_j, k: next_k);
  }
}

fn main() -> status: ExitStatus pure {
  let left = array_filled::<u32, 3>(value: 0_u32);
  set left[0_u64] = 1_u32;
  set left[1_u64] = 4_u32;
  set left[2_u64] = 6_u32;
  let right = array_filled::<u32, 3>(value: 0_u32);
  set right[0_u64] = 2_u32;
  set right[1_u64] = 3_u32;
  set right[2_u64] = 9_u32;
  let out = array_filled::<u32, 3>(value: 0_u32);
  let merged = merge_step(left: left, right: right, out: out, i: 0_u64, j: 0_u64, k: 0_u64);
  let first = merged[0_u64];
  let second = merged[1_u64];
  let third = merged[2_u64];
  if first == 1_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  if second == 2_u32 {
  } else {
    return exit_status(code: 2_u8);
  }
  if third == 3_u32 {
  } else {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
