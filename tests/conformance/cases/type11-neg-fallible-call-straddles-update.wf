struct Index {
  value: u64;
  invariant bounded(index): index.value < 16_u64;
}

fn probe() -> result: Result<u8, unit> pure {
  return Ok<u8, unit>(value: 1_u8);
}

fn straddle(t: &Index) -> result: Result<u8, unit> writes(t.value) {
  set t^.value = 31_u64;
  let inner = propagate probe();
  set t^.value = 3_u64;
  return Ok<u8, unit>(value: inner);
}
