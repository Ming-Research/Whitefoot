alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn inner(destination: &[u8], value: u8) -> written: u64 writes(destination) contract {
  requires 2_u64 <= deref(destination).len;
  ensures written == 2_u64;
} {
  doc "Writes the first two element positions of the destination it was handed.";
  set deref(destination)[0_u64] = value;
  set deref(destination)[1_u64] = value;
  return 2_u64;
}

fn outer(destination: &[u8], value: u8) -> written: u64 writes(destination) contract {
  requires 2_u64 <= deref(destination).len;
  ensures written == 2_u64;
} {
  doc "Passes its own destination on to a helper of the same parameter shape.";
  let count = inner(destination: destination, value: value);
  return 2_u64;
}

fn main() -> status: ExitStatus pure {
  doc "A helper handed a range reference passes that same destination to a second helper of the same parameter shape; the callee's write reaches the range's storage, the origin window keeps its own length, and the outer caller reads back what the innermost helper wrote.";
  let table = slots_new::<u8, 4>();
  place_back(window: &table, value: 3_u8);
  place_back(window: &table, value: 3_u8);
  let window = &table[0_u64..2_u64];
  let count = outer(destination: window, value: 200_u8);
  let seen = deref(window).len;
  if seen == 2_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  let first = table[0_u64];
  let second = table[1_u64];
  if first == 200_u8 {
  } else {
    return exit_status(code: 202_u8);
  }
  if second == 200_u8 {
  } else {
    return exit_status(code: 203_u8);
  }
  return exit_status(code: 0_u8);
}
