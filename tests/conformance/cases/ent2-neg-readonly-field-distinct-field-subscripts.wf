struct Cursor {
  k: u64;
  other: u64;
}

fn select(table: &[Slots<u8, 8>], s: &Cursor, i: u64) -> result: u8 reads(table), reads(s.k), reads(s.other) contract {
  requires s^.k < table^.len;
  requires s^.other < table^.len;
} {
  doc "ENT-2: offsets k and other have different field identities despite sharing one reference root. A guard on the row selected by k cannot prove i below the length of the row selected by other.";
  if i < table^[s^.k].len {
    return table^[s^.other][i];
  }
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The function body must fail OP-4; collapsing sibling field offsets would incorrectly accept it.";
  return std::process::exit_status(code: 0_u8);
}
