alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Columns {
  left: Box<Slots<u64>>;
  right: Box<Slots<u64>>;
}

fn main() -> status: ExitStatus pure {
  doc "Parallel runtime-capacity columns are filled, folded, and released through one struct owner; counted-loop range facts discharge the indexing and normal owner exit releases the fields in reverse declaration order.";
  let left = box_slots_new::<u64>(capacity: 6_u64);
  for @build_left (
    at in 0_u64..6_u64,
    invariant grown: left.inner.len >= at,
    invariant spare: left.inner.cap - left.inner.len + at >= 6_u64
  ) {
    place_back(window: &left.inner, value: 0_u64);
  }
  let right = box_slots_new::<u64>(capacity: 6_u64);
  for @build_right (
    at in 0_u64..6_u64,
    invariant grown: right.inner.len >= at,
    invariant spare: right.inner.cap - right.inner.len + at >= 6_u64
  ) {
    place_back(window: &right.inner, value: 0_u64);
  }
  let columns = Columns(left: move left, right: move right);
  let length = columns.left.inner.len;
  for (fill_index in 0_u64..length) {
    set columns.left.inner[fill_index] = fill_index;
    let doubled = fill_index *wrap 2_u64;
    let right_room = columns.right.inner.len;
    let fill_right_ok = fill_index < right_room;
    if fill_right_ok {
      set columns.right.inner[fill_index] = doubled;
    } else {
      return exit_status(code: 202_u8);
    }
  }
  let total = 0_u64;
  for (fold_index in 0_u64..length) {
    let left_value = columns.left.inner[fold_index];
    let right_room = columns.right.inner.len;
    let fold_right_ok = fold_index < right_room;
    if fold_right_ok {
      let right_value = columns.right.inner[fold_index];
      set total = total +wrap left_value;
      set total = total +wrap right_value;
    } else {
      return exit_status(code: 203_u8);
    }
  }
  if total == 45_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
