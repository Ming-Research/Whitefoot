struct Frame {
  flags: Array<Bool, 1>;
  vals: Array<u64, 1>;
}

fn helper(frame: &Frame, other: &Frame) -> result: unit writes(other.flags) contract {
  requires forall before(k in 0_u64..1_u64) when frame^.flags[k]: frame^.vals[k] == 0_u64;
  ensures forall after(k in 0_u64..1_u64) when frame^.flags[k]: frame^.vals[k] == 0_u64;
} {
  set other^.flags[0_u64] = True();
  return unit;
}

fn caller(f: &Frame, g: &Frame) -> result: unit writes(g.flags) contract {
  requires forall start(k in 0_u64..1_u64) when f^.flags[k]: f^.vals[k] == 0_u64;
} {
  helper(frame: f, other: g);
  return unit;
}
