alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn stamp(left: &Array<u8, 4>, right: &Array<u8, 4>, value: u8) -> result: unit writes(left), writes(right) {
  doc "One element write through each reference parameter.";
  set deref(left)[1_u64] = value;
  set deref(right)[1_u64] = value;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "OWN-7, EFF-5: the overlap relation is over the complete path and not over one offset. The two reference arguments name grid[0] and grid[1], whose index steps are literals with different values, so the call's two substituted write paths are proved disjoint and the pair is admitted; every step below them is relative to its own containing element, and both stamped bytes are read back.";
  let inner_left = array_filled::<u8, 4>(value: 1_u8);
  let inner_right = array_filled::<u8, 4>(value: 3_u8);
  let grid = slots_new::<Array<u8, 4>, 2>();
  place_back(window: &grid, value: inner_left);
  place_back(window: &grid, value: inner_right);
  stamp(left: &grid[0_u64], right: &grid[1_u64], value: 9_u8);
  let seen_left = grid[0_u64][1_u64];
  let seen_right = grid[1_u64][1_u64];
  if seen_left == 9_u8 {
    if seen_right == 9_u8 {
      return exit_status(code: 0_u8);
    }
  }
  return exit_status(code: 4_u8);
}
