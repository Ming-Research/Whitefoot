alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn choose(ignored: i32, value: i32) -> result: i32 pure contract {
  ensures result == value;
} {
  return value;
}

fn relay(slot: i32, replacement: i32) -> result: i32 pure contract {
  ensures result == replacement;
} {
  set slot = choose(ignored: slot, value: replacement);
  return slot;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
