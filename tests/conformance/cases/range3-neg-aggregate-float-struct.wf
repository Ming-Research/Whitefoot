struct RangeFloat {
  index: u64;
  fraction: f64;
}

fn fill<T: copy>(value: T) -> result: Array<T, 1> pure contract {
  ensures forall same(k in 0_u64..result.len): result[k] == value;
} {
  let made = array_filled::<T, 1>(value: value);
  return made;
}

fn need(xs: &[RangeFloat], expected: u64) -> result: unit pure contract {
  requires forall same(k in 0_u64..xs^.len): xs^[k].index == expected;
} {
  return unit;
}

fn forward(value: RangeFloat) -> result: unit pure {
  let xs = fill::<RangeFloat>(value: value);
  need(xs: &xs[0_u64..1_u64], expected: value.index);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
