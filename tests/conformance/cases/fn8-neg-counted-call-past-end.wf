alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn get_bounded<const n: u64>(b: &Slots<u8, n>, i: u64) -> value: u8 reads(b) contract {
  define spare = deref(b).len;
  requires i < spare;
} {
  return deref(b)[i];
}

fn main() -> status: ExitStatus pure {
  doc "The counted range includes one more index than the run's length. The length invariant survives the whole loop, but it cannot prove the call requirement at the last binder value, so FN-8 rejects at that call.";
  let buf = slots_new::<u8, 5>();
  for (
    at in 0_u64..5_u64,
    invariant grown: buf.len >= at,
    invariant spare: buf.cap - buf.len + at >= 5_u64
  ) {
    place_back(window: &buf, value: 3_u8);
  }
  let n = buf.len;
  let acc = 0_u64;
  let past_end = n +wrap 1_u64;
  for (
    i in 0_u64..past_end,
    invariant kept: buf.len >= n
  ) {
    let byte = get_bounded::<5>(b: &buf, i: i);
    let widened = cvt::<u8, u64>(byte);
    set acc = acc +wrap widened;
  }
  if acc == 15_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
