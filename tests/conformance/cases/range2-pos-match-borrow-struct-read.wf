struct Cell {
  at: u64;
}

enum Flow {
  Open(block: Cell);
  Close(block: Cell);
}

fn need(order: &[Flow]) -> result: unit pure contract {
  requires forall zero(k in 0_u64..order^.len): order^[k].Open.block.at == 0_u64;
} {
  return unit;
}

fn forward(order: &[Flow]) -> result: unit reads(order) contract {
  requires forall held(k in 0_u64..order^.len): order^[k].Open.block.at == 0_u64;
} {
  if 0_u64 < order^.len {
    let r = &order^[0_u64];
    match &r^ {
      Open(block: b) => {
        let seen = b^.at;
      }
      Close(block: b) => {
      }
    }
  }
  need(order: order);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
