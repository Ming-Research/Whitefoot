fn select(table: &[Slots<u8, 8>], r: &u64, i: u64) -> result: u8 reads(table), reads(r) contract {
  requires r^ < table^.len;
} {
  doc "ENT-2: a dereferenced integer place is an admitted tracked offset, so the guard and the nested read name the same selected row's readonly len term.";
  if i < table^[r^].len {
    return table^[r^][i];
  }
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The function body is checked without a call.";
  return std::process::exit_status(code: 0_u8);
}
