fn reserve(cell: &Box<Slots<Slots<u64, 4>>>, capacity: u64) -> result: unit writes(cell) contract {
  requires 0_u64 < cell^.inner.len;
  requires capacity >= cell^.inner.cap;
} {
  let selected = &cell^.inner[0_u64];
  let fits = selected^.len < 3_u64;
  grow(cell: cell, capacity: capacity);
  if fits {
    let data = array_filled::<u64, 3>(value: 0_u64);
    let observed = data[cell^.inner[0_u64].len];
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
