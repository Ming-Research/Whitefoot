alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Pair {
  left: u64;
  right: u64;
}

interface Touch {
  fn touch(value: &Pair) -> result: unit reads(value.left), writes(value.right);
}

fn apply(input: &Pair) -> result: unit reads(input.left), writes(input.right) {
  doc "Formal and actual effect paths compare parameter and field ordinals, not binder spelling; the two field paths here match ordinal for ordinal.";
  let observed = deref(input).left;
  set deref(input).right = observed;
  return unit;
}

binding PairTouch : Touch {
  touch = apply;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
