alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn copy_bytes(out: &[u8], source: &[u8]) -> function_result: u64 reads(source), writes(out) contract {
  define out_length = deref(out).len;
  define source_length = deref(source).len;
  requires source_length <= out_length;
} {
  doc "Copies the source range into the destination range; the requirement's body-entry axiom combines with each counted binder fact to prove every output write.";
  let length = deref(source).len;
  for (offset in 0_u64..length) {
    let value = deref(source)[offset];
    set deref(out)[offset] = value;
  }
  return length;
}

fn main() -> status: ExitStatus pure {
  doc "Equal caller allocations discharge the output-capacity requirement before the call. In the callee, a counted range proves each source read, and that binder fact combines with the requirement to prove each output write. The two substituted effect paths have different roots, so EFF-5 admits the call. Explicit result controls observe the returned length and copied byte.";
  let length = 4_u64;
  let source = array_filled::<u8, 4>(value: 7_u8);
  let output = array_filled::<u8, 4>(value: 0_u8);
  let window = &source[0_u64..4_u64];
  let destination = &output[0_u64..4_u64];
  let window_length = deref(window).len;
  let destination_length = deref(destination).len;
  if window_length <= destination_length {
  } else {
    return exit_status(code: 203_u8);
  }
  let written = copy_bytes(out: destination, source: window);
  if written == length {
  } else {
    return exit_status(code: 201_u8);
  }
  let last = output[3_u64];
  if last == 7_u8 {
  } else {
    return exit_status(code: 202_u8);
  }
  return exit_status(code: 0_u8);
}
