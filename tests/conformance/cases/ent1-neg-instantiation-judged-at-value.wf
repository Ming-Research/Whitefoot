alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn element<const n: u64>(values: Slots<u8, n>) -> result: u8 pure contract {
  requires n <= values.len;
} {
  doc "The identical generic body rejects at the instantiation whose value leaves the obligation underivable [ENT-1, OP-4]: at n = 2 the constant offset 2 is not below the window the requirement guarantees, and the judgment is made at the instantiated value rather than symbolically over n.";
  return values[2_u64];
}

fn main() -> status: ExitStatus pure {
  doc "Fills a two-slot window and calls the narrow instance.";
  let empty = slots_new::<u8, 2>();
  place_back(window: &empty, value: 7_u8);
  place_back(window: &empty, value: 7_u8);
  let value = element::<2>(values: move empty);
  return exit_status(code: 0_u8);
}
