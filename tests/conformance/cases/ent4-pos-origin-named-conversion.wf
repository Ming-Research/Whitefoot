fn witness() -> r: unit pure {
  doc "The guard's complete expansion and the call's partial spelling share one origin.";
  let input = 257_u16;
  let reduced = cvt.wrap::<u16, u8>(input);
  if reduced == 1_u8 {
    need(input: input);
