fn invalid(cell: &Array<u64, 1>) -> result: unit writes(cell) contract {
  ensures forall preserved(k in 0_u64..cell^.len) when cell^[k] unchanged: cell^[k] == 0_u64;
} {
  set cell^[0_u64] = 9_u64;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
