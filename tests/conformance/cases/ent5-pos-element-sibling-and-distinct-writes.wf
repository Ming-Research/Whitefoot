struct Cell {
  digits: Array<u8, 2>;
  marker: u8;
}

fn sibling(cell: &Cell) -> result: u8 reads(cell.digits), writes(cell.marker) contract {
  requires 1_u8 <= cell^.digits[0_u64];
} {
  set cell^.marker = 0_u8;
  return cell^.digits[0_u64] - 1_u8;
}

fn distinct(values: &Array<u8, 2>, index: u64, other: u64) -> result: u8 writes(values) contract {
  requires index < values^.len;
  requires other < values^.len;
  requires index != other;
  requires 1_u8 <= values^[index];
} {
  set values^[other] = 0_u8;
  return values^[index] - 1_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
