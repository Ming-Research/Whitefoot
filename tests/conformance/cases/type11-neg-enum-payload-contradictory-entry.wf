struct Never {
  low: u64;
  high: u64;
  invariant above(never): never.low + 1_u64 <= never.high;
  invariant below(never): never.high <= never.low;
}

fn probe(item: Option<Never>) -> result: u64 pure {
  let slots = slots_new::<u64, 8>();
  place_back(window: &slots, value: 7_u64);
  let got = slots[3_u64];
  return got;
}

fn caller() -> result: u64 pure {
  let none = None<Never>();
  let got = probe(item: none);
  return got;
}
