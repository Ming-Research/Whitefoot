alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn consume(run: Slots<u8, 2>) -> code: u8 pure contract {
  requires run.len > 0_u64;
} {
  doc "PROV-6: a window whose element type is affine is affine, so the release its scope exit runs is derived and the row stays empty. The pair with the linear refusal is what makes that refusal about the type rather than about the scope.";
  let byte = run[0_u64];
  return byte;
}

fn main() -> status: ExitStatus pure {
  doc "The caller fills one slot, so the requirement holds at the call.";
  let fresh = slots_new::<u8, 2>();
  place_back(window: &fresh, value: 0_u8);
  let code = consume(run: move fresh);
  return exit_status(code: code);
}
