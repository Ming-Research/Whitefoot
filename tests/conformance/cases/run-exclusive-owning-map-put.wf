alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Resource {
  id: u64;
  data0: u64;
  data1: u64;
  data2: u64;
  data3: u64;
}

enum Slot {
  Vacant();
  Deleted();
  Occupied(fingerprint: u8, key: u64, payload: Box<Resource>);
}

enum Probe {
  Stop();
  Skip();
  Miss();
  Match();
}

enum PutOutcome {
  Inserted();
  Replaced(previous: Box<Resource>);
  Full(offered: Box<Resource>);
}

fn fingerprint(key: u64) -> result: u8 pure {
  doc "Seven low bits of the key, folded one at a time.";
  let tag = 0_u8;
  let bit0 = iand(key, 1_u64);
  if bit0 != 0_u64 {
    set tag = ior(tag, 1_u8);
  }
  let bit1 = iand(key, 2_u64);
  if bit1 != 0_u64 {
    set tag = ior(tag, 2_u8);
  }
  let bit2 = iand(key, 4_u64);
  if bit2 != 0_u64 {
    set tag = ior(tag, 4_u8);
  }
  let bit3 = iand(key, 8_u64);
  if bit3 != 0_u64 {
    set tag = ior(tag, 8_u8);
  }
  let bit4 = iand(key, 16_u64);
  if bit4 != 0_u64 {
    set tag = ior(tag, 16_u8);
  }
  let bit5 = iand(key, 32_u64);
  if bit5 != 0_u64 {
    set tag = ior(tag, 32_u8);
  }
  let bit6 = iand(key, 64_u64);
  if bit6 != 0_u64 {
    set tag = ior(tag, 64_u8);
  }
  return tag;
}

fn probe_index(home: u64, step: u64, count: u64) -> index: u64 pure contract {
  requires home < count;
  requires step < count;
  ensures index < count;
} {
  doc "Linear probing with an explicit wrap, so the returned offset is proved inside the window.";
  let until_end = count - home;
  if step >= until_end {
    let wrapped = step - until_end;
    return wrapped;
  }
  let straight = home + step;
  return straight;
}

fn probe(slot: &Slot, key: u64) -> result: Probe reads(slot) {
  doc "Matching through a reference leaves the scrutinee live and binds each payload as a reference naming the scrutinee path.";
  match deref(slot) {
    Vacant() => {
      return Probe::Stop();
    }
    Deleted() => {
      return Probe::Skip();
    }
    Occupied(fingerprint: saved, key: present, payload: owner) => {
      if deref(present) == key {
        return Probe::Match();
      }
      return Probe::Miss();
    }
  }
}

fn fill_slots(slots: &Slots<Slot, 2>, count: u64) -> result: unit writes(slots) contract {
  requires deref(slots).len == 0_u64;
  requires count <= deref(slots).cap - deref(slots).len;
  ensures deref(slots).len == count;
} {
  doc "One vacant slot per position, under a counted header that carries the length and the remaining free slots.";
  for (
    index in 0_u64..count,
    invariant filled: deref(slots).len >= index,
    invariant bounded: deref(slots).len <= index,
    invariant spare: deref(slots).cap - deref(slots).len + index >= count
  ) {
    let vacant = Slot::Vacant();
    place_back(window: slots, value: move vacant);
  }
  invariant complete_min: deref(slots).len >= count;
  invariant complete_max: deref(slots).len <= count;
  return unit;
}

fn put(slots: &Slots<Slot, 2>, key: u64, payload: Box<Resource>) -> outcome: PutOutcome writes(slots) contract {
  requires deref(slots).len > 0_u64;
  ensures deref(slots).len == deref(entry(slots)).len;
} {
  doc "The probe loop only selects a destination, so the owning payload is never moved inside a loop body; the one insertion is written after it and exchanges the old occupant out by swap.";
  let count = deref(slots).len;
  let first_deleted = count;
  let destination = count;
  for (step in 0_u64..count) {
    if destination == count {
      let home = key % count;
      let index = probe_index(home: home, step: step, count: count);
      let action = probe(slot: &deref(slots)[index], key: key);
      match action {
        Match() => {
          set destination = index;
        }
        Skip() => {
          if first_deleted == count {
            set first_deleted = index;
          }
        }
        Stop() => {
          if first_deleted < count {
            set destination = first_deleted;
          } else {
            set destination = index;
          }
        }
        Miss() => {
        }
      }
    }
  }
  if destination == count {
    if first_deleted < count {
      set destination = first_deleted;
    }
  }
  if destination < count {
  } else {
    return PutOutcome::Full(offered: move payload);
  }
  let tag = fingerprint(key: key);
  let replacement = Slot::Occupied(fingerprint: tag, key: key, payload: move payload);
  swap(first: &deref(slots)[destination], second: &replacement);
  match replacement {
    Occupied(fingerprint: old_tag, key: old_key, payload: old_payload) => {
      return PutOutcome::Replaced(previous: move old_payload);
    }
    Vacant() => {
      return PutOutcome::Inserted();
    }
    Deleted() => {
      return PutOutcome::Inserted();
    }
  }
}

fn allocate_put(slots: &Slots<Slot, 2>, key: u64, id: u64) -> outcome: PutOutcome writes(slots) contract {
  requires deref(slots).len > 0_u64;
  ensures deref(slots).len == deref(entry(slots)).len;
} {
  doc "Allocation is total, so the wrapper has no refusal arm and the cell reaches the insertion unconditionally.";
  let data0 = id *wrap 17_u64;
  let data1 = data0 +wrap 1_u64;
  let data2 = data0 +wrap 2_u64;
  let data3 = data0 +wrap 3_u64;
  let resource = Resource(id: id, data0: data0, data1: data1, data2: data2, data3: data3);
  let owner = box_new::<Resource>(value: resource);
  let result = put(slots: slots, key: key, payload: move owner);
  return move result;
}

fn check_put(outcome: PutOutcome, kind: u64, expected: u64) -> code: u8 pure {
  doc "Refusal and ordinary cleanup retain their owning payloads: every arm's payload is released with its binder.";
  match outcome {
    Inserted() => {
      if kind != 1_u64 {
        return 1_u8;
      }
      return 0_u8;
    }
    Replaced(previous: old) => {
      if kind != 2_u64 {
        return 2_u8;
      }
      let seen = old.inner.id;
      if seen != expected {
        return 3_u8;
      }
      return 0_u8;
    }
    Full(offered: back) => {
      if kind != 3_u64 {
        return 4_u8;
      }
      let seen = back.inner.id;
      if seen != expected {
        return 5_u8;
      }
      return 0_u8;
    }
  }
}

fn main() -> status: ExitStatus pure {
  doc "The owning enum-slot put and its allocation wrapper use reference window parameters. Collision insertion and duplicate replacement preserve the window length through verified equality contracts.";
  let slots = slots_new::<Slot, 2>();
  fill_slots(slots: &slots, count: 2_u64);
  let outcome0 = allocate_put(slots: &slots, key: 1_u64, id: 11_u64);
  let checked0 = check_put(outcome: move outcome0, kind: 1_u64, expected: 0_u64);
  if checked0 != 0_u8 {
    return exit_status(code: 1_u8);
  }
  invariant preserved0_min: slots.len >= 2_u64;
  invariant preserved0_max: slots.len <= 2_u64;
  let outcome1 = allocate_put(slots: &slots, key: 3_u64, id: 22_u64);
  let checked1 = check_put(outcome: move outcome1, kind: 1_u64, expected: 0_u64);
  if checked1 != 0_u8 {
    return exit_status(code: 2_u8);
  }
  invariant preserved1_min: slots.len >= 2_u64;
  invariant preserved1_max: slots.len <= 2_u64;
  let outcome2 = allocate_put(slots: &slots, key: 1_u64, id: 33_u64);
  let checked2 = check_put(outcome: move outcome2, kind: 2_u64, expected: 11_u64);
  if checked2 != 0_u8 {
    return exit_status(code: 3_u8);
  }
  invariant preserved2_min: slots.len >= 2_u64;
  invariant preserved2_max: slots.len <= 2_u64;
  return exit_status(code: 0_u8);
}
