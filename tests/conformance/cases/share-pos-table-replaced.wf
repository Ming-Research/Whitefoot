struct Store {
  map: KeyedTable<u8>;
}

const names: Array<u8, 2> =[97_u8, 98_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let table = keyed_table_new::<u8>(capacity: 0_u64);
  let state = Store(map: move table);
  let store = shared_new::<Store>(value: move state);
  let first = &names[0_u64..1_u64];
  let second = &names[1_u64..2_u64];
  atomic s = &store, a = &s^.map[first], b = &s^.map[second] {
    set a^ = Some<u8>(value: 1_u8);
    set b^ = Some<u8>(value: 2_u8);
  }
  let before = 0_u64;
  let fresh = keyed_table_new::<u8>(capacity: 0_u64);
  atomic s = &store, t = &s^.map {
    set before = keyed_table_count::<u8>(table: t);
    set t^ = move fresh;
  }
  let after = 9_u64;
  atomic s = &store, t = &s^.map {
    set after = keyed_table_count::<u8>(table: t);
    set t^[first] = Some<u8>(value: 4_u8);
  }
  let code = cvt.checked::<u64, u8>(before);
  match code {
    Ok(value: narrow) => {
      if after == 0_u64 {
        let status = narrow +wrap 10_u8;
        return std::process::exit_status(code: status);
      }
      return std::process::exit_status(code: 1_u8);
    }
    Err(error: unused) => {
      return std::process::exit_status(code: 2_u8);
    }
  }
}
