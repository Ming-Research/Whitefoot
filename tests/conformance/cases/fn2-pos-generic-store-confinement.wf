alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn identity<T: drop>(value: T) -> result: T pure {
  return move value;
}

fn main() -> status: ExitStatus pure {
  doc "FN-2: an identity instantiated with a boxed runtime-capacity run returns that same exact type. There is one heap [STOR-8], so no store brand confines the value and the instance is keyed on the element type alone; the runtime-capacity shape lives inside the `Box` [TYPE-9].";
  let run = box_slots_new::<u64>(capacity: 4_u64);
  let kept = identity::<Box<Slots<u64>>>(value: move run);
  let size = kept.inner.cap - kept.inner.len;
  return exit_status(code: 0_u8);
}
