alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Packet {
  Data(value: i32);
  Idle();
}

fn main() -> status: ExitStatus pure {
  doc "Repeated matches through one reference each derive their own arm-scoped payload binder, and the scrutinee stays live between them.";
  let packet = Packet::Data(value: 4_i32);
  let holder = &packet;
  match holder^ {
    Data(value: payload) => {
      let saved = payload^;
    }
    Idle() => {
    }
  }
  match holder^ {
    Data(value: payload) => {
      let again = payload^;
    }
    Idle() => {
    }
  }
  return exit_status(code: 0_u8);
}
