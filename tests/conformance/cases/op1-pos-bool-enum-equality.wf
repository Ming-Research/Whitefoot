alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> return_value: ExitStatus pure {
  let false_value = False();
  let true_value = True();
  let eq00 = eeq(false_value, false_value);
  let ne00 = ene(false_value, false_value);
  if eq00 {
  } else {
    return exit_status(code: 1_u8);
  }
  let not_ne00 = bnot(ne00);
  if not_ne00 {
  } else {
    return exit_status(code: 2_u8);
  }
  let eq01 = eeq(false_value, true_value);
  let ne01 = ene(false_value, true_value);
  let not_eq01 = bnot(eq01);
  if not_eq01 {
  } else {
    return exit_status(code: 3_u8);
  }
  if ne01 {
  } else {
    return exit_status(code: 4_u8);
  }
  let eq10 = eeq(true_value, false_value);
  let ne10 = ene(true_value, false_value);
  let not_eq10 = bnot(eq10);
  if not_eq10 {
  } else {
    return exit_status(code: 5_u8);
  }
  if ne10 {
  } else {
    return exit_status(code: 6_u8);
  }
  let eq11 = eeq(true_value, true_value);
  let ne11 = ene(true_value, true_value);
  if eq11 {
  } else {
    return exit_status(code: 7_u8);
  }
  let not_ne11 = bnot(ne11);
  if not_ne11 {
  } else {
    return exit_status(code: 8_u8);
  }
  return exit_status(code: 0_u8);
}
