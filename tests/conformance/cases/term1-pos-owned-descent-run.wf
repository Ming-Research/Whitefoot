alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Chain {
  End();
  Next(stamp: u64, tail: Box<Chain>);
}

fn main() -> status: ExitStatus pure {
  doc "The cursor moves into the Box below its referent on every backedge and the body writes only a scalar, so the Box cells below it fall [TERM-1].";
  let end = Chain::End();
  let root = box_new::<Chain>(value: move end);
  for (i in 0_u64..4_u64) {
    let item = Chain::Next(stamp: i, tail: move root);
    set root = box_new::<Chain>(value: move item);
  }
  let cursor = &root.inner;
  let total = 0_u64;
  loop {
    match cursor^ {
      End() => {
        break;
      }
      Next(stamp: value, tail: rest) => {
        set total = total +wrap value^;
        set cursor = &rest^.inner;
      }
    }
  }
  if total != 6_u64 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
