struct Pair {
  left: u64;
  right: u64;
}

fn bump(cells: &Array<Pair, 1>) -> result: unit writes(cells) {
  set cells^[0_u64].right = 9_u64;
  return unit;
}

fn delegate(cells: &Array<Pair, 1>) -> result: unit writes(cells) contract {
  ensures forall kept(k in 0_u64..cells^.len): cells^[k] unchanged;
} {
  bump(cells: cells);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
