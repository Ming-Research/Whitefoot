nocopy struct Row {
  left: u64;
  right: u64;
}

fn exchange(rows: &Slots<Slots<Row, 2>, 2>, i: u64, k: u64, l: u64) -> result: unit writes(rows) contract {
  requires i < rows^.len;
  requires k < rows^[i].len;
  requires l < rows^[i].len;
} {
  doc "OP-11: equal-depth slots under the same indexed row admit swap without proving the slot indices distinct.";
  swap(first: &rows^[i][k], second: &rows^[i][l]);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let inner = slots_new::<Row, 2>();
  let first = Row(left: 1_u64, right: 2_u64);
  place_back(window: &inner, value: move first);
  let second = Row(left: 3_u64, right: 4_u64);
  place_back(window: &inner, value: move second);
  let rows = slots_new::<Slots<Row, 2>, 2>();
  place_back(window: &rows, value: move inner);
  if rows[0_u64].len == 2_u64 {
    exchange(rows: &rows, i: 0_u64, k: 0_u64, l: 1_u64);
  } else {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
