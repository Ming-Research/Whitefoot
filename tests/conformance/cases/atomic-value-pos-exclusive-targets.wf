fn main() -> status: std::process::ExitStatus pure waits {
  let owner = shared_atomic_new(value: 0_u64);
  let second = shared_atomic_new(value: 4_u64);
  let yes = True();
  atomic a = &owner, b = &second {
    if yes {
      let seen = atomic_load(cell: a);
    } else {
      let seen = atomic_load(cell: b);
    }
  }
  return std::process::exit_status(code: 0_u8);
}
