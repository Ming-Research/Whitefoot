alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Cursor {
  idx: u64;
  limit: u64;
  tag: u8;
}

fn shrink(c: &Cursor) -> unused: unit writes(c.limit) {
  doc "Writes exactly the field its declared row names.";
  set deref(c).limit = 1_u64;
  return unit;
}

fn read_after_shrink<const n: u64>(table: Slots<u8, n>, cursor: Cursor) -> value: u8 pure contract {
  define spare = table.len;
  requires cursor.idx < cursor.limit;
  requires cursor.limit <= spare;
} {
  doc "Before the callee replaces the middle field, closure preserves the independent consequence that idx is below the length [ENT-4], and the projected write kills nothing else [ENT-5].";
  shrink(c: &cursor);
  return table[cursor.idx];
}

fn read_after_tag_write<const n: u64>(table: Slots<u8, n>, cursor: Cursor) -> value: u8 pure contract {
  define spare = table.len;
  requires cursor.idx < cursor.limit;
  requires cursor.limit <= spare;
} {
  doc "A write to an unrelated field retains the sibling scalar bounds; neither write may kill unrelated field support.";
  set cursor.tag = 9_u8;
  return table[cursor.idx];
}

fn main() -> status: ExitStatus pure {
  doc "No construction is needed to exercise the field survival.";
  return exit_status(code: 0_u8);
}
