fn invalid(values: &Paged<u64>) -> result: u64 reads(values) contract {
  requires 1_u64 < values^.pages.len;
} {
  doc "A current page-length fact is supported by the page selector's binding.";
  let selected = 0_u64;
  if 1_u64 < values^.pages[selected].len {
    set selected = 1_u64;
    return values^.pages[selected][1_u64];
  }
  return 0_u64;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Changing the selector cannot reuse the previous page's element bound.";
  return std::process::exit_status(code: 0_u8);
}
