alias ExitStatus = std::process::ExitStatus;
alias Node = pkg::nodes::Node;
alias exit_status = std::process::exit_status;

fn inspect(root: &Node) -> result: u64 writes(root) {
  let cursor = root;
  for (i in 0_u64..2_u64) {
    match deref(cursor).next {
      Some(value: child) => {
        set cursor = &deref(child).inner;
      }
      None() => {
        break;
      }
    }
  }
  set deref(cursor).value = 3_u64;
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  doc "Widening retains the readonly restriction of every possible formation path outside the field's declaring module.";
  return exit_status(code: 0_u8);
}
