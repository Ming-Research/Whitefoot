alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias Instant = std::time::Instant;
alias exit_status = std::process::exit_status;

const name: Array<u8, 3> =[108_u8, 111_u8, 103_u8];

const text: Array<u8, 5> =[97_u8, 98_u8, 99_u8, 100_u8, 101_u8];

fn append_range(factory: &std::io::HandleFactory, root: &std::fs::DirectoryWrite, start: u64, end: u64) -> result: u8 reads(root), writes(factory) must_wait contract {
  requires start <= end;
  requires end <= 5_u64;
} {
  let label = &name[0_u64..3_u64];
  match std::fs::open_append(factory: factory, root: root, name: label, start: 0_u64, end: 3_u64) {
    Ok(value: file) => {
      let source = &text[0_u64..5_u64];
      let outcome = 0_u8;
      match std::fs::append_once(factory: factory, file: &file, source: source, start: start, end: end) {
        Ok(value: next) => {
          if next != end {
            set outcome = 2_u8;
          }
        }
        Err(error: problem) => {
          set outcome = 3_u8;
        }
      }
      match std::fs::sync_file(factory: factory, file: &file) {
        Ok(value: synced) => {
        }
        Err(error: problem) => {
          set outcome = 4_u8;
        }
      }
      std::fs::close_write(factory: factory, file: move file);
      return outcome;
    }
    Err(error: problem) => {
      return 1_u8;
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure must_wait {
  let Inputs(args: unused_args, cwd: cwd_directory, stdout: unused_stdout, stderr: unused_stderr, handles: handles, stdin: unused_stdin, clock: clock, wall_clock: wall_clock) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  let first = append_range(factory: &handles, root: &cwd_write, start: 0_u64, end: 3_u64);
  let second = append_range(factory: &handles, root: &cwd_write, start: 3_u64, end: 5_u64);
  std::fs::close_directory_write(factory: &handles, directory: move cwd_write);
  if first != 0_u8 {
    std::fs::close_directory(factory: &handles, directory: move cwd);
    return exit_status(code: 10_u8);
  }
  if second != 0_u8 {
    std::fs::close_directory(factory: &handles, directory: move cwd);
    return exit_status(code: 11_u8);
  }
  let bytes = array_filled::<u8, 8>(value: 0_u8);
  let outcome = 0_u8;
  let label = &name[0_u64..3_u64];
  match std::fs::open_file(factory: &handles, root: &cwd, name: label, start: 0_u64, end: 3_u64) {
    Ok(value: file) => {
      let window = &bytes[0_u64..8_u64];
      match std::fs::read_at(factory: &handles, file: &file, destination: window, file_offset: 0_u64, start: 0_u64, end: 8_u64) {
        Ok(value: next) => {
          if next != 5_u64 {
            set outcome = 12_u8;
          }
        }
        Err(error: stop) => {
          set outcome = 13_u8;
        }
      }
      std::fs::close_read(factory: &handles, file: move file);
    }
    Err(error: problem) => {
      set outcome = 14_u8;
    }
  }
  std::fs::close_directory(factory: &handles, directory: move cwd);
  if outcome != 0_u8 {
    return exit_status(code: outcome);
  }
  if bytes[0_u64] != 97_u8 {
    return exit_status(code: 15_u8);
  }
  if bytes[4_u64] != 101_u8 {
    return exit_status(code: 16_u8);
  }
  return exit_status(code: 0_u8);
}
