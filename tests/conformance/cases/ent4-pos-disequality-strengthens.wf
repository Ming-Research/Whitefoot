alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn get(b: &[u8], i: u64) -> result: u8 reads(b) {
  doc "Closure rule (2): ordinary executed control establishes i at most spare and i unequal to spare, from which ENT-4 derives the strict bound required by the subscript. No unchecked conclusion stands in for either input-dependent condition.";
  let spare = deref(b).len;
  let within = i <= spare;
  if within {
    let distinct = i != spare;
    if distinct {
      return deref(b)[i];
    }
  }
  return 0_u8;
}

fn main() -> status: ExitStatus pure {
  doc "No construction is needed to exercise the closure rule.";
  return exit_status(code: 0_u8);
}
