struct Counter {
  count: u64;
}

fn need_one(digit: u8) -> result: unit pure contract {
  requires 1_u8 <= digit;
} {
  return unit;
}

fn inspect(counter: &Counter, digits: &Array<u8, 1>) -> result: unit reads(digits), writes(counter) contract {
  requires forall leading(k in 0_u64..1_u64) when 0_u64 < counter^.count: 1_u8 <= digits^[k];
} {
  doc "A field commit replaces its image; an old guard over the entry count cannot use the newly positive count.";
  set counter^.count = 1_u64;
  let digit = digits^[0_u64];
  need_one(digit: digit);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
