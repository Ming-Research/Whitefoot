fn scatter_twin(order: &[u64], twin: &[u64], mirror: &[u64], pos: &[u64], out: &[u64]) -> result: unit reads(mirror), writes(out) contract {
  requires pos^.len == out^.len;
  requires twin^.len == order^.len;
  requires mirror^.len == twin^.len;
  requires forall again(k in 0_u64..mirror^.len): mirror^[k] == twin^[k];
  requires forall same(k in 0_u64..twin^.len): twin^[k] == order^[k];
  requires forall inv(k in 0_u64..order^.len) when order^[k] < out^.len: pos^[order^[k]] == k;
} {
  doc "The loop reads mirror; again reaches twin in the first round and same reaches order in the second. Written inv instances supply the third link that automatic formation cannot reach, proving that the two iterations write distinct slots.";
  let count = mirror^.len;
  for (
    k in 0_u64..count,
    apart(i, j) {
      use inv(i);
      use inv(j);
    }
  ) {
    let e = mirror^[k];
    if e < out^.len {
      set out^[e] = k;
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
