fn bump_first(cell: &Array<u64, 2>, flag: Bool) -> result: Option<u64> writes(cell) contract {
  ensures when Some(value: stored): forall kept(k in 0_u64..1_u64): cell^[k] unchanged;
} {
  if flag {
    set cell^[0_u64] = 5_u64;
    return Some<u64>(value: 5_u64);
  }
  return None<u64>();
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
