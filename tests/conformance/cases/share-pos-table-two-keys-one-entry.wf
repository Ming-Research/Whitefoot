struct Store {
  map: KeyedTable<u8>;
}

const names: Array<u8, 2> =[97_u8, 97_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let table = keyed_table_new::<u8>(capacity: 0_u64);
  let state = Store(map: move table);
  let store = shared_new::<Store>(value: move state);
  let first = &names[0_u64..1_u64];
  let again = &names[1_u64..2_u64];
  atomic s = &store, one = &s^.map[first], other = &s^.map[again] {
    set one^ = Some<u8>(value: 3_u8);
    set other^ = Some<u8>(value: 9_u8);
  }
  let seen = 0_u8;
  let counted = 0_u64;
  atomic s = &store, slot = &s^.map[first] {
    match slot^ {
      Some(value: held) => {
        set seen = held^;
      }
      None() => {
      }
    }
    set counted = keyed_table_count::<u8>(table: &s^.map);
  }
  if counted != 1_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: seen);
}
