alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nodrop struct Token {
  id: u8;
}

fn peek(ticket: Token) -> code: u8 pure {
  doc "PROV-6: linearity is a property of the type and holds in every scope, so a value the linear modifier makes linear may not reach a scope exit by a compiler-derived release. The refusal names the binding, the edge, and the declaration that made the value linear.";
  let byte = ticket.id;
  return byte;
}

fn main() -> status: ExitStatus pure {
  doc "The rejection is in the helper above; this entry point does nothing.";
  return exit_status(code: 0_u8);
}
