enum BorrowedRoute {
  BorrowedCase(index: u64);
}

fn selected(value: &BorrowedRoute) -> result: &BorrowedRoute reads(value) contract {
  ensures when BorrowedCase(index: payload): payload <= 3_u64;
} {
  return value;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
