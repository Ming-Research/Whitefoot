alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn push(values: &Slots<u64, 4>, value: u64) -> result: unit writes(values) contract {
  requires deref(values).len < deref(values).cap;
} {
  doc "No postcondition, so the caller learns nothing about the window's length from this call.";
  place_back(window: values, value: value);
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "Without a postcondition the caller rereads the length and follows a genuine empty/nonempty branch before taking an element.";
  let values = slots_new::<u64, 4>();
  push(values: &values, value: 7_u64);
  let size = values.len;
  if size > 0_u64 {
    let last = take_back(window: &values);
  }
  return exit_status(code: 0_u8);
}
