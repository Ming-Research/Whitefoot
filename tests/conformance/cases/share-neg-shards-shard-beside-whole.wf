fn no_count() -> made: u8 pure {
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let stats = shared_shards_new::<u8, fn no_count>();
  let mine = any_shard();
  let count = 0_u64;
  atomic part = &stats[mine], all = &stats {
    set part^ = 1_u8;
    set count = all^.len;
  }
  return std::process::exit_status(code: 0_u8);
}
