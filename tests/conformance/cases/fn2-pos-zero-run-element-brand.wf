alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn empty<T>() -> result: Slots<T, 0> pure {
  let result = slots_new::<T, 0>();
  return move result;
}

fn main() -> status: ExitStatus pure {
  doc "FN-2: a zero-capacity run retains its explicitly written element type even though no element ever exists. The element type is itself a boxed runtime-capacity run, so the instantiation is checked with no payload at all [TYPE-9].";
  let empty_run = empty::<Box<Slots<u64>>>();
  return exit_status(code: 0_u8);
}
