alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn scaled(out: &[u8], src: &[u8]) -> written: u64 pure contract {
  define room = deref(out).len;
  define count = deref(src).len;
  define needed = count * 2_u64;
  requires room >= needed;
} {
  doc "The exact affine rows are read mathematically in a clause, so an expansion function states its own size precondition over a measure and a literal factor; the caller proves it from the lengths it allocated.";
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  doc "A range reference carries its own exact `len`, equal to its written endpoints [REF-4, MSR-1], so the two lengths reach the clause without a descriptor read or a caller branch; the affine requirement is discharged from them directly.";
  let src_run = array_filled::<u8, 4>(value: 0_u8);
  let out_run = array_filled::<u8, 8>(value: 0_u8);
  let window = &out_run[0_u64..8_u64];
  let view = &src_run[0_u64..4_u64];
  let n = scaled(out: window, src: view);
  return exit_status(code: 0_u8);
}
