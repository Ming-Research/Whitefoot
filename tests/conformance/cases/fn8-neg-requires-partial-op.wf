alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn partial_op(x: u64) -> result: u64 pure contract {
  define halved = x / 2_u64;
  define permitted = halved <= x;
  requires permitted;
} {
  doc "Only pure-total operations and the exact affine rows are legal in a static contract; exact division is proof-required on an input no relation states its way out of, so it remains partial and violates FN-8 even though it has no runtime fallback.";
  return x;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
