fn main() -> status: std::process::ExitStatus pure waits {
  let never = std::time::cancel_never();
  let first = std::time::cancel_state(watch: &never);
  let second = std::time::cancel_state(watch: &never);
  std::time::close_cancel_watch(watch: move never);
  let source = std::time::cancel_source();
  std::time::cancel_fire(source: &source);
  std::time::close_cancel_source(source: move source);
  atomic one = &first, two = &second {
    let fired = bor(one^.fired, two^.fired);
    if fired {
      return std::process::exit_status(code: 1_u8);
    }
  }
  return std::process::exit_status(code: 0_u8);
}
