struct Pair {
  value: u64;
  sibling: u64;
}

fn nonzero(value: u64) -> result: unit pure contract {
  requires value != 0_u64;
} {
  return unit;
}

fn selected(pair: &Pair) -> result: unit writes(pair.value) {
  match pair^.value {
    0_u64 => {
      return unit;
    }
    else => {
      set pair^.value = 0_u64;
      nonzero(value: pair^.value);
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
