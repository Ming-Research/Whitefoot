alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn fetch_shifted(b: &[u8], i: u64, wide: Bool) -> result: u8 reads(b) {
  doc "Each value_if edge bounds its own wrapping-derived atom by the same length, then gives that atom. The specified forward delivery preserves the common nonconstant relation on the receiving index [ENT-5, GIVE-1], so the subscript discharges [OP-4].";
  let spare = deref(b).len;
  let idx = if wide {
    let idx1 = i +wrap 2_u64;
    let inside1 = idx1 < spare;
    if inside1 {
    } else {
      return 0_u8;
    }
    give idx1;
  } else {
    let idx2 = i +wrap 1_u64;
    let inside2 = idx2 < spare;
    if inside2 {
    } else {
      return 0_u8;
    }
    give idx2;
  }
  return deref(b)[idx];
}

fn main() -> status: ExitStatus pure {
  doc "No construction is needed to exercise the delivery.";
  return exit_status(code: 0_u8);
}
