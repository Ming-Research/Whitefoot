alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Block {
  bytes: Slots<u8, 4>;
}

fn pass_bytes(bytes: Slots<u8, 4>) -> result: Slots<u8, 4> pure contract {
  ensures result.cap == bytes.cap;
  ensures result.len == bytes.len;
} {
  doc "Hands the window straight back, republishing its two measures.";
  return move bytes;
}

fn main() -> status: ExitStatus pure {
  doc "MSR-5: measures survive a chain of owned transfers. A captured capacity and a zero length cross a verified whole-value result relation, nominal construction, a destructuring consume and a Some payload; each step is one of MSR-3's placements, and the invariants at the end read what the first step published. The checks are source obligations; existing container programs own actual append and read behavior.";
  let known = slots_new::<u8, 4>();
  let passed = pass_bytes(bytes: move known);
  let record = Block(bytes: move passed);
  let Block(bytes: held) = move record;
  let outcome = Some<Slots<u8, 4>>(value: move held);
  match outcome {
    None() => {
      return exit_status(code: 1_u8);
    }
    Some(value: returned) => {
      invariant capacity_min: returned.cap >= 4_u64;
      invariant capacity_max: returned.cap <= 4_u64;
      invariant empty: returned.len <= 0_u64;
      place_back(window: &returned, value: 23_u8);
      let seen = returned[0_u64];
      let result = seen -wrap 23_u8;
      return exit_status(code: result);
    }
  }
}
