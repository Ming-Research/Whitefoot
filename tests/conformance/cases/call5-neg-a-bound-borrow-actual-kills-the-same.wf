alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn consume_room(run: &Slots<u8, 64>) -> result: unit writes(run) contract {
  requires 1_u64 < deref(run).cap - deref(run).len;
} {
  doc "Moves the back boundary twice and hands nothing back, so the amount its body moved the boundary by is not a fact of the signature.";
  place_back(window: run, value: 0_u8);
  place_back(window: run, value: 0_u8);
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "No transport reads the actual's spelling. This is the same program with the reference bound to a name and handed at the argument position rather than written there, which is a different checked argument shape reaching the same declared parameter. The two spellings differ in nothing a transport may read, so the declared whole-state write kills the caller's length exactly as before and take_back's requires deref(window).len > 0_u64 is undischarged.";
  let workspace = slots_new::<u8, 64>();
  let handle = &workspace;
  let taken = consume_room(run: handle);
  let extra = take_back(window: &workspace);
  return exit_status(code: 0_u8);
}
