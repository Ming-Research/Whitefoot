alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "STOR-8: there is one heap and allocation is total in the source; it never returns a failure, never traps, and no allocating operation carries a Result, so an allocating construction's result is used directly with no failure arm.";
  let b = box_new::<u64>(value: 7_u64);
  let bs = box_slots_new::<u64>(capacity: 4_u64);
  let seen = b.inner;
  let empty = bs.inner.len;
  if seen == 7_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  if empty == 0_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
