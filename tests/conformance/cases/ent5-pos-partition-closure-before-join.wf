alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn get(b: &[u8], i: u64, half: u64) -> result: u8 reads(b) {
  doc "The lower partition reaches i below the length through i below half at most the length, while the upper partition proves it directly. Each predecessor is closed before the join [ENT-4], which must preserve their common consequence [ENT-5, OP-4].";
  let spare = deref(b).len;
  let half_ok = half <= spare;
  if half_ok {
  } else {
    return 0_u8;
  }
  let lower = i < half;
  if lower {
  } else {
    let upper_start = i >= half;
    if upper_start {
      let upper_end = i < spare;
      if upper_end {
      } else {
        return 0_u8;
      }
    } else {
      return 0_u8;
    }
  }
  return deref(b)[i];
}

fn main() -> status: ExitStatus pure {
  doc "No construction is needed to exercise the partition join.";
  return exit_status(code: 0_u8);
}
