program no_heap;

alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "STOR-8: box_segments_filled allocates its run on the heap, so a program carrying the no-heap declaration cannot call it.";
  let lengths = array_filled::<u64, 2>(value: 1_u64);
  let made = box_segments_filled::<u64>(lengths: &lengths[0_u64..2_u64], value: 0_u64);
  return exit_status(code: 0_u8);
}
