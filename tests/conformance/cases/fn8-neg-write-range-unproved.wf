alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;
alias exit_status = std::process::exit_status;
alias write_once = std::io::write_once;

fn publish(factory: &HandleFactory, output: &OutputStream, source: &[u8], start: u64, end: u64) -> result: unit reads(source), writes(factory), writes(output) waits {
  doc "The ordinary write_once signature requires ordered endpoints within the source length. This wrapper declares neither relation, so FN-8 rejects at the inner call before lowering; no host transfer is needed to see it.";
  let no_deadline = None<std::time::Instant>();
  let wait_cancel_1 = std::time::cancel_never();
  let wait_outcome_1 = write_once(factory: factory, output: output, source: source, start: start, end: end, deadline: no_deadline, cancel: &wait_cancel_1);
  std::time::close_cancel_watch(watch: move wait_cancel_1);
  match wait_outcome_1 {
    Ok(value: next) => {
    }
    Err(error: problem) => {
    }
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
