fn invalid(cell: &Array<u64, 1>) -> result: Array<u64, 1> writes(cell) contract {
  ensures forall preserved(k in 0_u64..1_u64): result[k] unchanged;
} {
  set cell^[0_u64] = 9_u64;
  let made = array_filled::<u64, 1>(value: 0_u64);
  return made;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
