fn reserve(cell: &Box<Slots<Slots<u64, 4>>>, capacity: u64) -> result: unit writes(cell) contract {
  requires 0_u64 < cell^.inner.len;
  requires capacity >= cell^.inner.cap;
} {
  let outcome = cell^.inner[0_u64].len +checked 0_u64;
  grow(cell: cell, capacity: capacity);
  match outcome {
    Ok(value: length) => {
      invariant unchanged: length == cell^.inner[0_u64].len;
    }
    Err(error: overflowed) => {
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
