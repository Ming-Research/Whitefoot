alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "An unrelated binding after the replacement does not change the delivered run length judgment: the REBIND placement datum has empty support, so no later binding can retarget or remove it [MSR-3, ENT-5], and the subscript still discharges [OP-4].";
  let base = array_filled::<u32, 4>(value: 1_u32);
  let arr = slots_from_array::<u32, 4>(values: base);
  let before = arr[0_u64];
  let ok = before == 1_u32;
  if ok {
    return exit_status(code: 1_u8);
  }
  let seed = array_filled::<u32, 4>(value: 9_u32);
  let fresh = slots_from_array::<u32, 4>(values: seed);
  set arr = move fresh;
  let novel = 123456_u64;
  let after = arr[0_u64];
  return exit_status(code: 0_u8);
}
