alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "The same judgment over a heap construction record, whose published relations are all about the cell it made. Its relations are instantiated by the one path every record's are, so a defect there would reach every caller of it; the table read beside it is judged against the table's own length and is refused.";
  let table = slots_new::<u8, 4>();
  for (
    i in 0_u64..4_u64,
    invariant h: table.len == i
  ) {
    place_back(window: &table, value: 0_u8);
  }
  let made = box_slots_new::<u8>(capacity: 8_u64);
  let seen = table[9_u64];
  if seen == 0_u8 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 2_u8);
}
