alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn pick(flag: Bool) -> result: Box<i32> pure {
  doc "A value if delivers an owned cell from either branch. Allocation is total, so neither branch carries a failure arm.";
  let picked = if flag {
    let a = box_new::<i32>(value: 11_i32);
    give move a;
  } else {
    let b = box_new::<i32>(value: 22_i32);
    give move b;
  }
  return move picked;
}

fn main() -> status: ExitStatus pure {
  doc "The field inner returns the payload of the cell the true flag selects.";
  let flag = True();
  let picked = pick(flag: flag);
  let v = picked.inner;
  if v != 11_i32 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
