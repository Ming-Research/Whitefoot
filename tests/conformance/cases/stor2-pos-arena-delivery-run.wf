alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A value if delivers an owned cell from either branch, and the field inner returns the selected payload. Allocation is total, so neither branch carries a failure arm.";
  let flag = True();
  let picked = if flag {
    let a = box_new::<i32>(value: 11_i32);
    give move a;
  } else {
    let b = box_new::<i32>(value: 22_i32);
    give move b;
  }
  let v = picked.inner;
  if v != 11_i32 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
