fn close_it(factory: &std::io::HandleFactory, directory: std::fs::DirectoryRead) -> result: u8 writes(factory) waits {
  match std::fs::close_directory(factory: factory, directory: move directory) {
    Ok(value: closed) => {
      return 0_u8;
    }
    Err(error: problem) => {
      return 1_u8;
    }
  }
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  let std::process::Inputs(args: unused_args, cwd: cwd_directory, stdout: unused_stdout, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let code = close_it(factory: &factory, directory: move cwd);
  return std::process::exit_status(code: code);
}
