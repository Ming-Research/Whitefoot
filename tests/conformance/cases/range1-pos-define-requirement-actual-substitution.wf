fn need_small(source: &[u64], i: u64) -> result: unit pure contract {
  define next = i + 4_u64;
  requires next < source^.len;
  requires forall small(k in 0_u64..1_u64): source^[next] <= 7_u64;
} {
  doc "Only the element at the expanded index is required to be small.";
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Substituting i = 2 selects element 6, which is three; every other element is nine.";
  let values = array_filled::<u64, 7>(value: 9_u64);
  set values[6_u64] = 3_u64;
  need_small(source: &values[0_u64..7_u64], i: 2_u64);
  return std::process::exit_status(code: 0_u8);
}
