alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Vec2 {
  x: i32;
  y: i32;
}

fn sum_xy(v: Vec2) -> function_result: i32 pure {
  doc "TYPE-5: read the fields of an own struct parameter and return their sum; a by-value parameter carries no effect entry, so the declared row is the empty one [EFF-1].";
  let s = v.x +wrap v.y;
  return s;
}

fn main() -> status: ExitStatus pure {
  doc "TYPE-5: pass an own struct to a fn by value and use its fields cross-fn.";
  let vec2_atom_0001 = Vec2(x: 20_i32, y: 22_i32);
  let total = sum_xy(v: vec2_atom_0001);
  if total == 42_i32 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
