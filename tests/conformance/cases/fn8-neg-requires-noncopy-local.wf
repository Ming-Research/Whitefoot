alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn bounded(a: u64) -> result: u64 pure contract {
  define xs = slots_new::<u64, 4>();
  requires a < 8_u64;
} {
  doc "A requirement local is a fresh own copy value, and a function call is inadmissible in a clause however pure and total it is, so the aggregate-typed definition is refused [FN-8].";
  return a;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
