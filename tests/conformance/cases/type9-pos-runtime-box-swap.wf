fn main() -> status: std::process::ExitStatus pure {
  doc "TYPE-9, OP-11: exchanging the owning Boxes carries both windows' capacities and elements; both windows remain usable.";
  let small = box_slots_new::<u64>(capacity: 1_u64);
  let large = box_slots_new::<u64>(capacity: 64_u64);
  if small.inner.len < small.inner.cap {
    place_back(window: &small.inner, value: 11_u64);
  }
  if large.inner.len < large.inner.cap {
    place_back(window: &large.inner, value: 22_u64);
  }
  swap(first: &small, second: &large);
  if small.inner.cap != 64_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  if large.inner.cap != 1_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  if small.inner.len != 1_u64 {
    return std::process::exit_status(code: 3_u8);
  }
  if large.inner.len != 1_u64 {
    return std::process::exit_status(code: 4_u8);
  }
  if 0_u64 < small.inner.len {
    if small.inner[0_u64] != 22_u64 {
      return std::process::exit_status(code: 5_u8);
    }
  } else {
    return std::process::exit_status(code: 6_u8);
  }
  if 0_u64 < large.inner.len {
    if large.inner[0_u64] != 11_u64 {
      return std::process::exit_status(code: 7_u8);
    }
  } else {
    return std::process::exit_status(code: 8_u8);
  }
  for (i in 0_u64..60_u64) {
    if small.inner.len < small.inner.cap {
      place_back(window: &small.inner, value: i);
    }
  }
  if small.inner.len != 61_u64 {
    return std::process::exit_status(code: 9_u8);
  }
  if 60_u64 < small.inner.len {
    if small.inner[60_u64] != 59_u64 {
      return std::process::exit_status(code: 10_u8);
    }
  } else {
    return std::process::exit_status(code: 11_u8);
  }
  if 0_u64 < large.inner.len {
    let held = take_back(window: &large.inner);
    if held != 11_u64 {
      return std::process::exit_status(code: 12_u8);
    }
  } else {
    return std::process::exit_status(code: 13_u8);
  }
  if large.inner.len < large.inner.cap {
    place_back(window: &large.inner, value: 33_u64);
  }
  if 0_u64 < large.inner.len {
    if large.inner[0_u64] != 33_u64 {
      return std::process::exit_status(code: 14_u8);
    }
  } else {
    return std::process::exit_status(code: 15_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
