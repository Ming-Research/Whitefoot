alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Pair {
  P(a: i32, b: i32);
}

fn make() -> return_value: Pair pure {
  doc "GRAM-8: out-of-order field names are rejected; declared order is the one legal byte sequence.";
  return Pair::P(b: 2_i32, a: 1_i32);
}

fn main() -> return_value: ExitStatus pure {
  return exit_status(code: 0_u8);
}
