struct Pair {
  cell: Shared<u64>;
  other: Shared<u64>;
}

fn take(value: Shared<u64>) -> result: unit pure {
  return unit;
}

fn witness() -> result: u64 pure waits {
  doc "REF-2: a move out of one field as a consuming call argument consumes the whole owner and releases its other affine parts at the move [WIN-3, STOR-3], so a reference to the released sibling is invalid afterwards.";
  let c = shared_new::<u64>(value: 1_u64);
  let o = shared_new::<u64>(value: 2_u64);
  let pair = Pair(cell: move c, other: move o);
  let r = &pair.cell;
  let done = take(value: move pair.other);
  let seen = 0_u64;
  atomic state = &r^ {
    set seen = state^;
  }
  return seen;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
