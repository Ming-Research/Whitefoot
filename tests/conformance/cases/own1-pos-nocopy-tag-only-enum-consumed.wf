alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy enum Signal {
  Ready();
  Waiting();
}

fn main() -> status: ExitStatus pure {
  doc "A nocopy tag-only enum is affine: the written move into a whole-value match is its one consuming use, while drop remains available on every other leaving edge.";
  let signal = Signal::Ready();
  match move signal {
    Ready() => {
      return exit_status(code: 0_u8);
    }
    Waiting() => {
      return exit_status(code: 1_u8);
    }
  }
}
