alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A PRE-1 record's published relations may narrow what its caller derives and may never make everything derivable. The construction below publishes the new run's own measures and nothing about the table beside it, so the table read is judged against the table's own length and is refused.";
  let table = slots_new::<u8, 4>();
  for (
    i in 0_u64..4_u64,
    invariant h: table.len == i
  ) {
    place_back(window: &table, value: 0_u8);
  }
  let scratch = slots_new::<u8, 8>();
  let seen = table[9_u64];
  if seen == 0_u8 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 2_u8);
}
