fn one_count() -> made: u8 pure {
  return 1_u8;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let stats = shared_shards_new::<u8, fn one_count>();
  let count = 0_u64;
  atomic all = &stats when all^.len > 1_u64 {
    set count = all^.len;
  }
  return std::process::exit_status(code: 0_u8);
}
