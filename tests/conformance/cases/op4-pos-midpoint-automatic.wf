alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn probe(table: Slots<u8, 4>, lo: u64, hi: u64) -> found: u8 pure contract {
  define spare = table.len;
  requires lo < hi;
  requires hi <= spare;
} {
  doc "AUTO proves the doubled midpoint relation from the division image and lo < hi, then halves that published fact over the integers, so the subscript needs no written certificate [ENT-6, OP-4].";
  let span = hi - lo;
  let half = span / 2_u64;
  let mid = lo + half;
  invariant inside: 2_u64 * mid + 1_u64 <= 2_u64 * hi;
  let byte = table[mid];
  return byte;
}

fn main() -> status: ExitStatus pure {
  let table = slots_new::<u8, 4>();
  place_back(window: &table, value: 0_u8);
  place_back(window: &table, value: 0_u8);
  place_back(window: &table, value: 0_u8);
  place_back(window: &table, value: 0_u8);
  let found = probe(table: move table, lo: 0_u64, hi: 4_u64);
  return exit_status(code: found);
}
