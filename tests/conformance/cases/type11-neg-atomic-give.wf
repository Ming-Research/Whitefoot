struct Table {
  slots: Slots<u64, 8>;
  next: u64;
  invariant cursor(table): table.next < table.slots.len;
}

fn make() -> table: Table pure {
  let slots = slots_new::<u64, 8>();
  place_back(window: &slots, value: 10_u64);
  let made = Table(slots: move slots, next: 0_u64);
  return move made;
}

fn given(table: Shared<Table>, flag: Bool) -> result: u64 pure may_wait {
  let picked = if flag {
    atomic t = &table {
      set t^.next = 9_u64;
      give 5_u64;
    }
  } else {
    give 200_u64;
  }
  return picked;
}

fn main() -> status: std::process::ExitStatus pure may_wait {
  let initial = make();
  let table = shared_new::<Table>(value: move initial);
  let yes = True();
  let r = given(table: move table, flag: yes);
  return std::process::exit_status(code: 0_u8);
}
