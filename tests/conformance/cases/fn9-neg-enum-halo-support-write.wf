alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Slot {
  Array(value: u64);
  Node(value: u64);
  Missing();
}

fn find_slot(array: &Box<Slots<u64>>, nodes: &Box<Slots<u64>>, key: u64) -> r: Slot reads(array), reads(nodes) contract {
  ensures when Array(value: i): i < array^.inner.len;
  ensures when Node(value: i): i < nodes^.inner.len;
} {
  for (i in 0_u64..array^.inner.len) {
    if array^.inner[i] == key {
      return Slot::Array(value: i);
    }
  }
  for (j in 0_u64..nodes^.inner.len) {
    if nodes^.inner[j] == key {
      return Slot::Node(value: j);
    }
  }
  return Slot::Missing();
}

fn store(array: &Box<Slots<u64>>, nodes: &Box<Slots<u64>>, key: u64, value: u64) -> r: Bool writes(array), writes(nodes) {
  let slot = find_slot(array: array, nodes: nodes, key: key);
  let empty = box_slots_new::<u64>(capacity: 1_u64);
  swap(first: array, second: &empty);
  match slot {
    Array(value: i) => {
      set array^.inner[i] = value;
      return True();
    }
    Node(value: j) => {
      set nodes^.inner[j] = value;
      return True();
    }
    Missing() => {
      return False();
    }
  }
}

fn main() -> status: ExitStatus pure {
  let array = box_slots_new::<u64>(capacity: 1_u64);
  let nodes = box_slots_new::<u64>(capacity: 1_u64);
  place_back(window: &array.inner, value: 10_u64);
  place_back(window: &nodes.inner, value: 20_u64);
  let array_hit = store(array: &array, nodes: &nodes, key: 10_u64, value: 11_u64);
  let node_hit = store(array: &array, nodes: &nodes, key: 20_u64, value: 21_u64);
  let miss = store(array: &array, nodes: &nodes, key: 30_u64, value: 31_u64);
  if array_hit {
    if node_hit {
      if miss {
        return exit_status(code: 1_u8);
      }
      if array.inner.len == 1_u64 {
        if nodes.inner.len == 1_u64 {
          if array.inner[0_u64] == 11_u64 {
            if nodes.inner[0_u64] == 21_u64 {
              return exit_status(code: 0_u8);
            }
          }
        }
      }
    }
  }
  return exit_status(code: 1_u8);
}
