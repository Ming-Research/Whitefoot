fn same<T: copy>(targets: &[T], value: T) -> result: unit pure contract {
  requires forall same(k in 0_u64..targets^.len): targets^[k] == value;
} {
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let enabled = True();
  let targets = array_filled::<Bool, 1>(value: enabled);
  set targets[0_u64] = False();
  same::<Bool>(targets: &targets[0_u64..1_u64], value: enabled);
  return std::process::exit_status(code: 0_u8);
}
