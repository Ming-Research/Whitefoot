alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Cell {
  Full(v: i32);
  Void();
}

fn main() -> status: ExitStatus pure {
  doc "A payload enum is matched twice through references [OWN-13]: reference-mode matching leaves the scrutinee live for the second read, each payload binder names the scrutinee path extended by its payload step [REF-1, GRAM-10], and each binder is itself a reference, so its value is reached through deref to feed a give-delivered computation [TYPE-7, GIVE-1]; the accumulated total pins both reads and it runs to exit 0.";
  let c = Cell::Full(v: 20_i32);
  let p = &c;
  let a = match deref(p) {
    Full(v: x) => {
      give deref(x) +wrap 1_i32;
    }
    Void() => {
      give 0_i32;
    }
  }
  let q = &c;
  let b = match deref(q) {
    Full(v: y) => {
      give deref(y) *wrap 2_i32;
    }
    Void() => {
      give 0_i32;
    }
  }
  let t = a +wrap b;
  if t == 61_i32 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
