alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

interface CheckedMember {
  fn apply(x: i32) -> result: i32 pure;
}

fn checked_apply(x: i32) -> result: i32 pure contract {
  define valid = x >= 0_i32;
  requires valid;
} {
  return x;
}

binding First : CheckedMember {
  apply = checked_apply;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
