alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum ScanState {
  InSpace();
  InWord();
}

fn flip(s: ScanState) -> function_result: ScanState pure {
  let out = match s {
    InSpace() => {
      give ScanState::InWord();
    }
    InWord() => {
      give ScanState::InSpace();
    }
  }
  return out;
}

fn main() -> status: ExitStatus pure {
  doc "A 2-variant tag-only enum is Bool-isomorphic: copy semantics, matched twice, loop-carried and set-mutated; lowers as i1. The unexpected final arm returns a nonzero status, making the runtime observation explicit through ordinary control.";
  let st = ScanState::InSpace();
  let i = 0_u64;
  loop @l {
    if i >= 5_u64 {
      break @l;
    }
    let nx = flip(s: st);
    set st = nx;
    set i = i +wrap 1_u64;
  }
  match st {
    InSpace() => {
      return exit_status(code: 1_u8);
    }
    InWord() => {
    }
  }
  return exit_status(code: 0_u8);
}
