alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn clear_first(rows: &Slots<Slots<u8, 8>, 4>, index: u64) -> result: unit writes(rows[index]) contract {
  requires index < rows^.len;
  ensures rows^.len == entry(rows)^.len;
} {
  doc "Replaces exactly the selected row with an empty window while retaining the outer window's length.";
  set rows^[index] = slots_new::<u8, 8>();
  return unit;
}

fn probe(rows: &Slots<Slots<u8, 8>, 4>) -> result: u8 writes(rows) contract {
  requires rows^.len >= 1_u64;
  requires rows^[0_u64].len >= 1_u64;
} {
  doc "The outer length postcondition does not preserve an interior reference after its containing row is replaced.";
  let inner = &rows^[0_u64][0_u64];
  clear_first(rows: rows, index: 0_u64);
  return inner^;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
