interface Keep {
  fn keep(slot: &u64) -> result: unit writes(slot) contract {
    ensures slot^ >= entry(slot)^;
  };
}

fn stay(actual_slot: &u64) -> stayed: unit pure {
  return unit;
}

binding NoPromise : Keep {
  keep = stay;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
