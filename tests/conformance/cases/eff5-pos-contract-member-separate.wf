struct Pair {
  marker: u64;
  value: u64;
}

interface Touch {
  fn touch(frame: &Pair, other: &Pair) -> result: unit writes(frame.marker), writes(other.value) contract {
    requires frame^.value == 0_u64;
    ensures frame^.value == 0_u64;
  };
}

fn apply<interface Touch>(first: &Pair, second: &Pair) -> result: unit writes(first.marker), writes(second.value) contract {
  requires first^.value == 0_u64;
} {
  Touch::touch(frame: first, other: second);
  return unit;
}
