alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias DirectoryRead = std::fs::DirectoryRead;
alias DirectoryWrite = std::fs::DirectoryWrite;

fn copy_name(args: &std::text::Args, position: u64, destination: &[u8]) -> next: u64 reads(args), writes(destination) contract {
  ensures next <= destination^.len;
} {
  match std::text::arg_get(args: args, position: position) {
    Ok(value: text) => {
      match std::text::host_copy_bytes(value: &text, destination: destination, start: 0_u64, end: destination^.len) {
        Ok(value: end) => { return end; }
        Err(error: problem) => { return 0_u64; }
      }
    }
    Err(error: problem) => { return 0_u64; }
  }
}

fn make_file(factory: &HandleFactory, root: &DirectoryWrite, name: &[u8], byte: u8) -> result: u8 reads(root), reads(name), writes(factory) waits {
  match std::fs::open_append(factory: factory, root: root, name: name, start: 0_u64, end: name^.len) {
    Ok(value: file) => {
      let outcome = 0_u8;
      match std::fs::truncate_file(factory: factory, file: &file, length: 0_u64) {
        Ok(value: done) => {}
        Err(error: problem) => { set outcome = 2_u8; }
      }
      let bytes = array_filled::<u8, 1>(value: byte);
      match std::fs::append_once(factory: factory, file: &file, source: &bytes[0_u64..1_u64], start: 0_u64, end: 1_u64) {
        Ok(value: next) => { if next != 1_u64 { set outcome = 3_u8; } }
        Err(error: problem) => { set outcome = 4_u8; }
      }
      match std::fs::close_write(factory: factory, file: move file) {
        Ok(value: done) => {}
        Err(error: problem) => { set outcome = 5_u8; }
      }
      return outcome;
    }
    Err(error: problem) => { return 1_u8; }
  }
}

fn not_found(error: &std::io::IoError) -> result: Bool reads(error) {
  match error^ {
    NotFound(code: c, origin: o) => { return True(); }
    PermissionDenied(code: c, origin: o) => { return False(); }
    AlreadyExists(code: c, origin: o) => { return False(); }
    NotDirectory(code: c, origin: o) => { return False(); }
    IsDirectory(code: c, origin: o) => { return False(); }
    DirectoryNotEmpty(code: c, origin: o) => { return False(); }
    ReadOnly(code: c, origin: o) => { return False(); }
    ResourceBusy(code: c, origin: o) => { return False(); }
    InvalidInput(code: c, origin: o) => { return False(); }
    InvalidPath(code: c, origin: o) => { return False(); }
    Unsupported(code: c, origin: o) => { return False(); }
    TimedOut(code: c, origin: o) => { return False(); }
    DeadlinePassed() => { return False(); }
    BrokenPipe(code: c, origin: o) => { return False(); }
    WriteZero(code: c, origin: o) => { return False(); }
    UnexpectedEnd(code: c, origin: o) => { return False(); }
    ConnectionRefused(code: c, origin: o) => { return False(); }
    ConnectionReset(code: c, origin: o) => { return False(); }
    ConnectionAborted(code: c, origin: o) => { return False(); }
    NotConnected(code: c, origin: o) => { return False(); }
    AddressInUse(code: c, origin: o) => { return False(); }
    AddressUnavailable(code: c, origin: o) => { return False(); }
    ResourceExhausted(code: c, origin: o) => { return False(); }
    FileTooLarge(code: c, origin: o) => { return False(); }
    NoSpace(code: c, origin: o) => { return False(); }
    QuotaExceeded(code: c, origin: o) => { return False(); }
    CrossDevice(code: c, origin: o) => { return False(); }
    DeviceFailure(code: c, origin: o) => { return False(); }
    Other(code: c, origin: o) => { return False(); }
  }
}

fn exercise(factory: &HandleFactory, reader: &DirectoryRead, writer: &DirectoryWrite, first: &[u8], second: &[u8]) -> result: u8 reads(reader), reads(first), reads(second), writes(factory), writes(writer) waits {
  let outcome = make_file(factory: factory, root: writer, name: first, byte: 97_u8);
  if outcome != 0_u8 { return outcome; }
  match std::fs::remove_file(factory: factory, root: writer, name: first, start: 0_u64, end: first^.len) {
    Ok(value: done) => {}
    Err(error: problem) => { return 12_u8; }
  }
  match std::fs::open_file(factory: factory, root: reader, name: first, start: 0_u64, end: first^.len) {
    Ok(value: file) => {
      std::fs::close_read(factory: factory, file: move file);
      return 13_u8;
    }
    Err(error: problem) => { if bnot(not_found(error: &problem)) { return 14_u8; } }
  }
  match std::fs::remove_file(factory: factory, root: writer, name: first, start: 0_u64, end: first^.len) {
    Ok(value: done) => { return 15_u8; }
    Err(error: problem) => { if bnot(not_found(error: &problem)) { return 16_u8; } }
  }
  return 0_u8;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: args, cwd: directory, stdout: out, stderr: errors, handles: factory, stdin: input, clock: clock, wall_clock: wall) = move inputs;
  let std::fs::Directory(read: reader, write: writer) = move directory;
  let first = array_filled::<u8, 64>(value: 0_u8);
  let second = array_filled::<u8, 64>(value: 0_u8);
  let first_end = copy_name(args: &args, position: 1_u64, destination: &first[0_u64..64_u64]);
  let second_end = copy_name(args: &args, position: 2_u64, destination: &second[0_u64..64_u64]);
  let outcome = 99_u8;
  if first_end > 0_u64 && second_end > 0_u64 {
    set outcome = exercise(factory: &factory, reader: &reader, writer: &writer, first: &first[0_u64..first_end], second: &second[0_u64..second_end]);
  }
  std::fs::close_directory(factory: &factory, directory: move reader);
  std::fs::close_directory_write(factory: &factory, directory: move writer);
  return std::process::exit_status(code: outcome);
}
