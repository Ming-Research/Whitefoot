alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn conditionals(flag: Bool, other: Bool) -> code: u8 pure {
  doc "Runs each conditional form on flag and other and returns 0 when every form selects the branch and delivers the value the conditions call for, or the code of the first form that did not.";
  let seen = False();
  if flag {
    set seen = True();
  }
  if seen {
  } else {
    return 1_u8;
  }
  let untouched = True();
  if other {
    set untouched = False();
  }
  if untouched {
  } else {
    return 2_u8;
  }
  let taken = if flag {
    give True();
  } else {
    give False();
  }
  if taken {
  } else {
    return 3_u8;
  }
  let chained = if other {
    give False();
  } else if flag {
    give True();
  } else {
    give False();
  }
  if chained {
  } else {
    return 4_u8;
  }
  return 0_u8;
}

fn main() -> status: ExitStatus pure {
  let flag = True();
  let other = False();
  let code = conditionals(flag: flag, other: other);
  return exit_status(code: code);
}
