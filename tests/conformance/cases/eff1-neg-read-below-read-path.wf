alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Stats {
  count: u64;
  total: u64;
}

fn inspect(stats: &Stats) -> result: u64 reads(stats), reads(stats.count) {
  doc "EFF-1: reads(stats) states every observation at or below stats, so reads(stats.count) states one of them twice.";
  let whole = deref(stats);
  let count = deref(stats).count;
  return whole.total +wrap count;
}

fn main() -> status: ExitStatus pure {
  doc "The malformed declaration above is rejected before this entry calls it.";
  let stats = Stats(count: 3_u64, total: 4_u64);
  let seen = inspect(stats: &stats);
  return exit_status(code: 0_u8);
}
