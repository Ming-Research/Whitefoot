fn probe(rows: Array<Slots<u8, 2>, 2>, i: u64, j: u64) -> (first: u64, second: u64) pure contract {
  requires i < 2_u64;
  requires j < 2_u64;
  requires rows[i].len == 0_u64;
  requires rows[j].len == 1_u64;
  ensures first == rows[i].len;
  ensures second == rows[j].len;
} {
  let left = rows[i].len;
  let right = rows[j].len;
  return left, right;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
