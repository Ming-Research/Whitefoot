struct ZeroesAliasReset {
  cells: Array<u64, 1>;
  invariant(c): forall zero(k in 0_u64..c^.cells.len): c^.cells[k] == 0_u64;
}

fn need_aliasreset(z: &ZeroesAliasReset) -> result: unit pure {
  return unit;
}

fn update_aliasreset(first: Shared<ZeroesAliasReset>, second: Shared<ZeroesAliasReset>) -> result: unit pure waits {
  atomic a = &first, b = &second {
    set a^.cells[0_u64] = 1_u64;
    set a^.cells[0_u64] = 0_u64;
    need_aliasreset(z: b);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
