struct Cell {
  value: u8;
}

fn probe(cells: &Box<Segments<Cell>>) -> result: unit writes(cells) contract {
  requires cells^.inner.len > 0_u64;
  requires cells^.inner[0_u64].len > 0_u64;
} {
  set cells^.inner[0_u64][0_u64] = Cell(value: 1_u8);
  let ref = &cells^.inner[0_u64][0_u64];
  let value = ref^.value + 254_u8;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
