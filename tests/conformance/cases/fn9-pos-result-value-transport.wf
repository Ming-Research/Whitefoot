alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn selected(value: i32, fail: Bool) -> result: Result<i32, Overflow> pure contract {
  ensures when Ok(value: payload): payload == value;
} {
  if fail {
    let problem = Overflow();
    return Err<i32, Overflow>(error: problem);
  }
  return Ok<i32, Overflow>(value: value);
}

fn relay(value: i32, fail: Bool) -> result: Result<i32, Overflow> pure contract {
  ensures when Ok(value: payload): payload == value;
} {
  let outcome = selected(value: value, fail: fail);
  let saved = outcome;
  return saved;
}

fn direct(value: i32, fail: Bool) -> result: Result<i32, Overflow> pure contract {
  ensures when Ok(value: payload): payload == value;
} {
  return relay(value: value, fail: fail);
}

fn affine(value: i32) -> result: Result<i32, Box<u8>> pure contract {
  ensures when Ok(value: payload): payload == value;
} {
  let outcome = Ok<i32, Box<u8>>(value: value);
  let saved = move outcome;
  return move saved;
}

fn same(left: i32, right: i32) -> result: unit pure contract {
  requires left == right;
} {
  return unit;
}

fn exercise(value: i32, fail: Bool, choose: Bool) -> result: Result<i32, Overflow> pure contract {
  ensures when Ok(value: payload): payload == value;
} {
  let never_fail = False();
  let outcome = selected(value: value, fail: fail);
  let saved = outcome;
  set outcome = selected(value: 99_i32, fail: never_fail);
  match saved {
    Ok(value: payload) => {
      same(left: payload, right: value);
    }
    Err(error: problem) => {
      return Err<i32, Overflow>(error: problem);
    }
  }
  let delivered = if choose {
    give saved;
  } else {
    give relay(value: value, fail: fail);
  }
  let payload = propagate delivered;
  same(left: payload, right: value);
  let extracted = match relay(value: value, fail: fail) {
    Ok(value: item) => {
      give item;
    }
    Err(error: problem) => {
      return Err<i32, Overflow>(error: problem);
    }
  }
  same(left: extracted, right: value);
  for (iteration in 0_u64..2_u64) {
    match saved {
      Ok(value: item) => {
        same(left: item, right: value);
      }
      Err(error: problem) => {
        return Err<i32, Overflow>(error: problem);
      }
    }
  }
  set outcome = saved;
  let assigned = propagate outcome;
  same(left: assigned, right: value);
  let constructed = Ok<i32, Overflow>(value: assigned);
  let unwrapped = propagate constructed;
  same(left: unwrapped, right: value);
  match affine(value: value) {
    Ok(value: item) => {
      same(left: item, right: value);
    }
    Err(error: problem) => {
      let failure = Overflow();
      return Err<i32, Overflow>(error: failure);
    }
  }
  return direct(value: extracted, fail: never_fail);
}

fn main() -> status: ExitStatus pure {
  let yes = True();
  let no = False();
  match exercise(value: 7_i32, fail: no, choose: no) {
    Ok(value: payload) => {
      if payload != 7_i32 {
        return exit_status(code: 1_u8);
      }
    }
    Err(error: problem) => {
      return exit_status(code: 2_u8);
    }
  }
  match exercise(value: -3_i32, fail: no, choose: yes) {
    Ok(value: payload) => {
      if payload != -3_i32 {
        return exit_status(code: 3_u8);
      }
    }
    Err(error: problem) => {
      return exit_status(code: 4_u8);
    }
  }
  match exercise(value: 7_i32, fail: yes, choose: yes) {
    Ok(value: payload) => {
      return exit_status(code: 5_u8);
    }
    Err(error: problem) => {
    }
  }
  match direct(value: 7_i32, fail: yes) {
    Ok(value: payload) => {
      return exit_status(code: 6_u8);
    }
    Err(error: problem) => {
    }
  }
  return exit_status(code: 0_u8);
}
