alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn inc (y: i32) -> function_result: i32 pure {
  return iadd.wrap::<i32>(y, 1_i32);
}

fn add2 (x: i32, y: i32) -> function_result: i32 pure {
  return iadd.wrap::<i32>(x, y);
}

fn main () -> status: ExitStatus pure {
  doc "GRAM-9: a user-fn call (inc) nested in another call's argument atom position does not derive; bind it with a preceding let.";
  let r = add2(x: inc(y: 1_i32), y: 2_i32);
  return exit_status(code: 0_u8);
}
