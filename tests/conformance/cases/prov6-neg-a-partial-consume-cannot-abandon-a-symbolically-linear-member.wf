alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Carrier<T> {
  must_consume: T;
  returned: Box<Slots<u8>>;
}

fn take_returned<T>(carrier: Carrier<T>) -> result: Box<Slots<u8>> pure {
  doc "PROV-6: the linearity predicate a partial consume reads includes a symbolic type parameter's written linear bound. Moving a different field consumes the whole owner, and the residual linear member has no route out of it.";
  return move carrier.returned;
}

fn main() -> status: ExitStatus pure {
  doc "The rejection is in the generic template above; this entry point does nothing.";
  return exit_status(code: 0_u8);
}
