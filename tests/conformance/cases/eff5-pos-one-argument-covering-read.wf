alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Stats {
  count: u64;
  total: u64;
}

fn record(stats: &Stats) -> result: unit reads(stats), writes(stats.count) {
  doc "EFF-5: the row reads all of stats and writes stats.count; one argument supplies both entries, whose overlap holds at every position, so a call does not compare them.";
  let whole = deref(stats);
  set deref(stats).count = whole.count +wrap whole.total;
  return unit;
}

fn push_first(window: &Slots<u64, 4>) -> result: unit reads(window), writes(window.next), writes(window.len) contract {
  requires 0_u64 < deref(window).len;
  requires deref(window).len < deref(window).cap;
} {
  doc "EFF-5: a whole-window read beside writes of window.next and window.len, all supplied by one argument.";
  let first = deref(window)[0_u64];
  place_back(window: window, value: first);
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "Both precise rows are callable, and the calls compute the values their bodies state.";
  let stats = Stats(count: 1_u64, total: 5_u64);
  record(stats: &stats);
  record(stats: &stats);
  let counted = stats.count;
  if counted == 11_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let window = slots_new::<u64, 4>();
  place_back(window: &window, value: 9_u64);
  push_first(window: &window);
  let length = window.len;
  if 1_u64 < length {
    let copied = window[1_u64];
    if copied == 9_u64 {
    } else {
      return exit_status(code: 2_u8);
    }
  } else {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
