fn past_bound(clock: &std::time::WallClock, at: i64) -> result: i64 reads(clock) {
  match std::time::local_offset_seconds(clock: clock, at: at) {
    Some(value: offset) => {
      let ahead = offset + 9223372036854689409_i64;
      return ahead;
    }
    None() => {
      return 0_i64;
    }
  }
}
