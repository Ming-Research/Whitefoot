fn establish(values: &Array<u8, 2>, index: u64) -> result: unit writes(values) contract {
  requires index < values^.len;
  ensures 1_u8 <= values^[index];
} {
  set values^[index] = 1_u8;
  return unit;
}

fn decrement(values: &Array<u8, 2>, index: u64) -> result: u8 reads(values[index]) contract {
  requires index < values^.len;
  requires 1_u8 <= values^[index];
} {
  return values^[index] - 1_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  let values = array_filled::<u8, 2>(value: 0_u8);
  let indices = array_filled::<u64, 1>(value: 1_u64);
  if indices[0_u64] < values.len {
    establish(values: &values, index: indices[0_u64]);
    let digit = decrement(values: &values, index: indices[0_u64]);
    return std::process::exit_status(code: digit);
  }
  return std::process::exit_status(code: 1_u8);
}
