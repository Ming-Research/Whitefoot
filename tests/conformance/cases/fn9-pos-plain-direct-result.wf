alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn identity(value: i32) -> result: i32 pure contract {
  ensures result == value;
} {
  return value;
}

fn relay(value: i32) -> result: i32 pure contract {
  ensures result == value;
} {
  let called = identity(value: value);
  return called;
}

fn main() -> status: ExitStatus pure {
  let observed = relay(value: 7_i32);
  if observed == 7_i32 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
