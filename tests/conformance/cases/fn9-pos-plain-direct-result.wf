alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn identity(value: i32) -> result: i32 pure contract {
  ensures result == value;
} {
  return value;
}

fn relay(value: i32) -> result: i32 pure contract {
  ensures result == value;
} {
  let called = identity(value: value);
  return called;
}

fn main() -> status: ExitStatus pure {
  let observed = relay(value: 7_i32);
  let code = cvt::<i32, u8>(observed);
  return exit_status(code: code);
}
