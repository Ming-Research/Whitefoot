struct Pair {
  f: u64;
  g: u64;
}

fn set_g_at(part: &[Pair], at: u64) -> result: unit writes(part[at].g) contract {
  requires at < part^.len;
} {
  doc "The written index is relative to the slice supplied as the actual.";
  set part^[at].g = 1_u64;
  return unit;
}

fn need_small_interval(rows: &[Pair]) -> result: unit pure contract {
  requires forall small_interval(k in 1_u64..2_u64): rows^[k].f <= 7_u64;
} {
  return unit;
}

fn probe(rows: &[Pair]) -> result: unit writes(rows) contract {
  requires forall held_f(k in 1_u64..2_u64): rows^[k].f <= 7_u64;
  requires 2_u64 <= rows^.len;
} {
  doc "OWN-7 conservatively overlaps the slice's complete write path with the containing run's index one; suffix fields cannot separate paths past this range/index comparison, so RANGE-3 rejects the later requirement.";
  set_g_at(part: &rows^[1_u64..2_u64], at: 0_u64);
  need_small_interval(rows: rows);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
