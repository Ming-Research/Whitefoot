alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn worker(handle: Shared<Box<u8>>) -> result: u8 pure waits {
  doc "The block ends its own handle first, then writes and reads the state: while the block runs, the statement is the only handle of the object this context holds.";
  let seen = 0_u8;
  atomic state = &handle {
    release::<Shared<Box<u8>>>(value: move handle);
    set state^.inner = 9_u8;
    set seen = state^.inner;
  }
  return seen;
}

fn distance_from_nine(found: Option<Box<u8>>) -> result: u8 pure {
  doc "Zero for no state and for the state the statement left, the only state a close can return.";
  match move found {
    Some(value: kept) => {
      return kept.inner -wrap 9_u8;
    }
    None() => {
      return 0_u8;
    }
  }
}

fn main() -> status: ExitStatus pure waits {
  doc "SHARE-1, SHARE-3: the worker's statement counts as a handle until it completes, so a close that comes while it executes is not the last to end and returns None, and a close that returns Some finds the state the statement wrote. Either order gives 9, and a state released under the executing block is a use after release for the sanitizers.";
  let boxed = box_new::<u8>(value: 7_u8);
  let cell = shared_new::<Box<u8>>(value: move boxed);
  let other = shared_share::<Box<u8>>(shared: &cell);
  let seen = spawn worker(handle: move other);
  let closed = shared_close::<Box<u8>>(shared: move cell);
  let distance = distance_from_nine(found: move closed);
  let total = seen +wrap distance;
  return exit_status(code: total);
}
