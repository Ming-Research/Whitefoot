alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn append_one<T: drop, const n: u64>(values: &Slots<T, n>, value: T) -> result: unit writes(values) contract {
  requires deref(values).len < deref(values).cap;
  ensures deref(values).len == deref(entry(values)).len + 1_u64;
  ensures deref(values).cap == deref(entry(values)).cap;
} {
  doc "One generic boundary move up, checked once at the symbolic instance of its own parameters.";
  place_back(window: values, value: move value);
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "A generic exclusive append proves two-state length and capacity relations and is instantiated at both scalar and owning window elements.";
  let scalar = slots_new::<u64, 2>();
  let nested = slots_new::<Slots<u64, 2>, 2>();
  append_one::<u64, 2>(values: &scalar, value: 7_u64);
  invariant scalar_length: scalar.len >= 1_u64;
  append_one::<Slots<u64, 2>, 2>(values: &nested, value: move scalar);
  invariant nested_length: nested.len >= 1_u64;
  let child = take_back(window: &nested);
  let size = child.len;
  if size != 1_u64 {
    return exit_status(code: 1_u8);
  }
  let value = child[0_u64];
  if value != 7_u64 {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
