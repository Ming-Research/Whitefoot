alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy struct Cell {
  tag: u64;
  weight: u64;
}

fn invalid(i: u64, k: u64) -> result: unit pure contract {
  requires i < 2_u64;
  requires k < 2_u64;
  requires i < k;
} {
  doc "Index separation never keeps a later subscript live: one consuming use kills the whole binding that roots the place, so even a proved distinct candidate pair leaves the second read rooted in a dead binding.";
  let cell0 = Cell(tag: 0_u64, weight: 0_u64);
  let cell1 = Cell(tag: 0_u64, weight: 0_u64);
  let slots = slots_new::<Cell, 2>();
  place_back(window: &slots, value: move cell0);
  place_back(window: &slots, value: move cell1);
  let cells = slots_into_array::<Cell, 2>(values: move slots);
  let first = cells[i].tag;
  let taken = move cells;
  let observed = cells[k].tag;
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
