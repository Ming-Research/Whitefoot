alias ExitStatus = std::process::ExitStatus;
alias Node = pkg::nodes::Node;
alias exit_status = std::process::exit_status;

fn inspect(root: &[Node]) -> result: u64 writes(root) {
  let cursor = root;
  for (i in 0_u64..2_u64) {
    if cursor^.len != 0_u64 {
      let node = &cursor^[0_u64];
      match node^.children {
        Some(value: child) => {
          let count = child^.inner.len;
          set cursor = &child^.inner[0_u64..count];
        }
        None() => {
        }
      }
    }
  }
  if cursor^.len != 0_u64 {
    let observed = cursor^[0_u64].value;
    set cursor^[0_u64].value = 7_u64;
    return observed;
  }
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
