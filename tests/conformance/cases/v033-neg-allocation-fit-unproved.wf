alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn make(length: u64) -> values: Box<Slots<i64>> pure {
  doc "A runtime capacity with no established relation is admitted: no count carries a static obligation, and a size the selected target cannot allocate is heap exhaustion at run time [OP-9].";
  let block = box_slots_new::<i64>(capacity: length);
  return move block;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
