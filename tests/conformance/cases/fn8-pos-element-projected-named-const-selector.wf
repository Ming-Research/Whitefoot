struct Cursor {
  index: u64;
}

const chosen: Cursor = Cursor(index: 1_u64);

fn probe(values: &Array<u8, 2>, cursor: Cursor) -> result: u8 reads(values) contract {
  requires cursor.index < values^.len;
  requires 1_u8 <= values^[cursor.index];
} {
  return values^[cursor.index] - 1_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  let values = array_filled::<u8, 2>(value: 0_u8);
  set values[1_u64] = 1_u8;
  if 1_u8 <= values[chosen.index] {
    let digit = probe(values: &values, cursor: chosen);
    return std::process::exit_status(code: digit);
  }
  return std::process::exit_status(code: 1_u8);
}
