alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nodrop struct Token {
  id: u64;
}

struct Wrapper {
  ticket: Token;
  count: u64;
}

interface Inspect<T: drop> {
  fn inspect(value: &T) -> result: unit pure;
}

fn ignore(value: &Wrapper) -> result: unit pure {
  doc "Observes nothing, so the row is empty.";
  return unit;
}

binding WrapperInspect : Inspect<Wrapper> {
  inspect = ignore;
}

fn main() -> status: ExitStatus pure {
  doc "PROV-6: a type owning a linear part at any depth is linear, so Wrapper is linear although it carries no modifier of its own. The affine bound of the group is not satisfied and the actual application is refused, exactly as the explicitly declared linear argument is.";
  return exit_status(code: 0_u8);
}
