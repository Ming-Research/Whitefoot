alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn takes(value: i32) -> function_result: unit pure {
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "A reference variable denotes the reference [REF-1], and the storage it names is reached only through deref, so writing the bare reference where a value of the referent type is declared is the missing dereference [TYPE-7], whose mechanical fix is deref(p).";
  let a = 1_i32;
  let p = &a;
  takes(value: p);
  return exit_status(code: 0_u8);
}
