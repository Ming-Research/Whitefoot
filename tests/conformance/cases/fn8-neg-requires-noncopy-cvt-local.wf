alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy struct ProofToken {
  value: u8;
}

fn guarded(value: ProofToken) -> result: unit pure contract {
  define saved = value;
  define ok = value.value >= 0_u8;
  requires ok;
} {
  doc "A contract definition must derive an own copy value [FN-8]. ProofToken is explicitly nocopy even though its field is copy. OWN-1 rejects this bare affine initializer and supplies its contract-specific repair over copy operands or non-consuming admitted reads.";
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
