alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Combo {
  BothTrue();
  FirstTrue();
  SecondTrue();
  BothFalse();
}

fn get(b: &[u8], i: u64, combo: Combo) -> result: u8 reads(b) {
  doc "One of four reaching match arms supplies no index bound. An absent relation is not an unconstrained proof witness; ENT-5's all-predecessor join drops the relation and OP-4 rejects.";
  let spare = deref(b).len;
  match combo {
    BothTrue() => {
      let inside_a = i < spare;
      if inside_a {
      } else {
        return 0_u8;
      }
    }
    FirstTrue() => {
      let inside_b = i < spare;
      if inside_b {
      } else {
        return 0_u8;
      }
    }
    SecondTrue() => {
      let inside_c = i < spare;
      if inside_c {
      } else {
        return 0_u8;
      }
    }
    BothFalse() => {
    }
  }
  return deref(b)[i];
}

fn main() -> status: ExitStatus pure {
  doc "No construction is needed to exercise the join.";
  return exit_status(code: 0_u8);
}
