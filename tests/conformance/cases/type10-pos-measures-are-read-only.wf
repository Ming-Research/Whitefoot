alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "TYPE-10: len, cap and head are read-only pseudo-fields of a measured place; free slots is the ordinary expression cap - len. A program reads the measures like fields, and only window and construction operations change them.";
  let r = ring_new::<u64, 4>();
  let before = r.len;
  place_back(window: &r, value: 1_u64);
  let after = r.len;
  let capacity = r.cap;
  let spare = r.cap - r.len;
  let origin = r.head;
  if before == 0_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  if after == 1_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  if capacity == 4_u64 {
  } else {
    return exit_status(code: 3_u8);
  }
  if spare == 3_u64 {
  } else {
    return exit_status(code: 4_u8);
  }
  if origin == 0_u64 {
  } else {
    return exit_status(code: 5_u8);
  }
  return exit_status(code: 0_u8);
}
