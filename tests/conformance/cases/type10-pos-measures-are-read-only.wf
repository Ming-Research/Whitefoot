alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn observe(before: u64, after: u64, capacity: u64, spare: u64, origin: u64) -> result: unit pure contract {
  requires before == 0_u64;
  requires after == 1_u64;
  requires capacity == 4_u64;
  requires spare == 3_u64;
  requires origin == 0_u64;
} {
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "TYPE-10: len, cap and head are read-only pseudo-fields of a measured place; free slots is the ordinary expression cap - len. A program reads the measures like fields, and only window and construction operations change them.";
  let r = ring_new::<u64, 4>();
  let before = r.len;
  place_back(window: &r, value: 1_u64);
  let after = r.len;
  let capacity = r.cap;
  let spare = r.cap - r.len;
  let origin = r.head;
  let done = observe(before: before, after: after, capacity: capacity, spare: spare, origin: origin);
  return exit_status(code: 0_u8);
}
