struct Item {
  value: u64;
}

fn main() -> status: std::process::ExitStatus pure {
  let item = Item(value: 1_u64);
  let source = array_filled::<Item, 4>(value: item);
  let element = &source[0_u64].value;
  let ring = ring_new::<Item, 4>();
  place_front(window: &ring, value: source[0_u64]);
  let observed = element^;
  if observed == 1_u64 {
  } else {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
