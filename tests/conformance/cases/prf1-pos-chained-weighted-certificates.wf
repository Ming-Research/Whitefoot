alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn chained_bound(x: u32, lim_x: u32, y: u32, lim_y: u32, z: u32, lim_z: u32) -> result: unit pure contract {
  requires x <= lim_x;
  requires y <= lim_y;
  requires z <= lim_z;
} {
  invariant base_x: x <= lim_x;
  invariant base_y: y <= lim_y;
  invariant weighted_xy: 2_u32 * x + 3_u32 * y <= 2_u32 * lim_x + 3_u32 * lim_y {
    use 2 times base_x;
    use 3 times base_y;
  }
  invariant base_z: z <= lim_z;
  invariant chained_total: 2_u32 * x + 3_u32 * y + 5_u32 * z <= 2_u32 * lim_x + 3_u32 * lim_y + 5_u32 * lim_z {
    use weighted_xy;
    use 5 times base_z;
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
