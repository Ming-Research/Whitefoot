alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn headroom(run: &Slots<u8, 8>) -> total: u64 reads(run) contract {
  requires 4_u64 <= deref(run).len;
} {
  doc "The stated relation over the measure is wider than the requirement establishes.";
  let seen = 0_u64;
  for (
    at in 0_u64..4_u64,
    invariant reserved: 8_u64 <= deref(run).len
  ) {
    let byte = deref(run)[at];
  }
  return seen;
}

fn main() -> status: ExitStatus pure {
  doc "[INV-1] a measure factor is a proof obligation like any other affine factor rather than an assumption the spelling grants. The caller's requirement gives four slots and the header states eight, so the base obligation fails at the loop header and the residual names the writer's own measure place [MSR-1, OP-15].";
  let run = slots_new::<u8, 8>();
  for (
    at in 0_u64..8_u64,
    invariant grown: run.len >= at,
    invariant spare: run.cap - run.len + at >= 8_u64
  ) {
    place_back(window: &run, value: 0_u8);
  }
  let total = headroom(run: &run);
  return exit_status(code: 0_u8);
}
