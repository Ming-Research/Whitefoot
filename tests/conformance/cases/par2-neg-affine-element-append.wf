alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn append_while_mapping(a: &Slots<u64, 8>) -> result: unit writes(a) {
  doc "The element write has an affine map, but place_back writes the root's length and next slot, so PAR-2 still denies permission.";
  for (i in 0_u64..4_u64) {
    if i < a^.len {
      set a^[i] = i;
    }
    if a^.len < a^.cap {
      place_back(window: a, value: i);
    }
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "A permission denial leaves this source accepted; the compiler permission test asserts condition 2's shared-write reason.";
  let values = slots_new::<u64, 8>();
  append_while_mapping(a: &values);
  return exit_status(code: 0_u8);
}
