alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn width_of(table: Slots<u32, 4>) -> value: u64 pure {
  doc "Takes the run itself, by value.";
  let seen = table.len;
  return seen;
}

fn main() -> status: ExitStatus pure {
  doc "A run is an ordinary value, so a Box holder written where the run itself is required is the ordinary [TYPE-5] argument mismatch, whose mechanical fix is move cell.inner, the Box content being reached by the ordinary field step [TYPE-9], and never an implicit read.";
  let run = slots_new::<u32, 4>();
  place_back(window: &run, value: 7_u32);
  let cell = box_new::<Slots<u32, 4>>(value: move run);
  let seen = width_of(table: move cell);
  if seen == 1_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
