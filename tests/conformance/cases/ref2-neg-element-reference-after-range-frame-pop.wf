alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn pop_if(window: &Slots<u64, 4>) -> result: u64 writes(window.last), writes(window.len) {
  doc "Takes the last element back when there is one. Its row writes window.last, so a call may lower window.len below the index a reference into the window was formed under.";
  if 0_u64 < deref(window).len {
    let taken = take_back(window: window);
    return taken;
  }
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  doc "OP-10, REF-2, REF-4: part = &outer[0_u64..2_u64], so deref(part)[1_u64] is outer[1_u64] reached through a range frame. The call ends the bound held = &outer[1_u64][0_u64] was formed under, as a call on &outer[1_u64] does, so reading held afterwards is refused.";
  let outer = slots_new::<Slots<u64, 4>, 3>();
  let a = slots_new::<u64, 4>();
  let b = slots_new::<u64, 4>();
  place_back(window: &b, value: 5_u64);
  place_back(window: &outer, value: move a);
  place_back(window: &outer, value: move b);
  if outer.len == 2_u64 {
    if outer[1_u64].len == 1_u64 {
      let held = &outer[1_u64][0_u64];
      let part = &outer[0_u64..2_u64];
      let got = pop_if(window: &deref(part)[1_u64]);
      let seen = deref(held);
      return exit_status(code: 0_u8);
    }
  }
  return exit_status(code: 0_u8);
}
