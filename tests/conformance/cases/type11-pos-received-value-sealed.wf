struct Stack {
  slots: Slots<u64, 8>;
  invariant nonempty(stack): stack.slots.len >= 1_u64;
}

struct Holder {
  stack: Stack;
}

fn fresh(first: u64) -> made: Stack pure {
  let slots = slots_new::<u64, 8>();
  place_back(window: &slots, value: first);
  let stack = Stack(slots: move slots);
  return move stack;
}

fn moved_field(holder: Holder) -> result: u64 pure {
  let stack = move holder.stack;
  let got = stack.slots[0_u64];
  return got;
}

fn given(flag: bool) -> result: u64 pure {
  let stack = if flag {
    give fresh(first: 1_u64);
  } else {
    give fresh(first: 2_u64);
  }
  let got = stack.slots[0_u64];
  return got;
}

fn matched(maybe: Option<Stack>) -> result: u64 pure {
  let stack = match move maybe {
    Some(value: inner) => {
      give move inner;
    }
    None() => {
      give fresh(first: 4_u64);
    }
  }
  let got = stack.slots[0_u64];
  return got;
}
