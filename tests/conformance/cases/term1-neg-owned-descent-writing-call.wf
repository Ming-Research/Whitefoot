alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Chain {
  End();
  Next(stamp: u64, tail: Box<Chain>);
}

fn bump(count: &u64) -> result: unit writes(count) {
  doc "Raises count by one.";
  set count^ = count^ +wrap 1_u64;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "The cursor descends into a Box on every backedge, but the body calls a function whose row writes, which a structural descent does not admit, and no exit test derives a rank [TERM-1].";
  let end = Chain::End();
  let root = box_new::<Chain>(value: move end);
  for (i in 0_u64..4_u64) {
    let item = Chain::Next(stamp: i, tail: move root);
    set root = box_new::<Chain>(value: move item);
  }
  let cursor = &root.inner;
  let total = 0_u64;
  loop {
    match cursor^ {
      End() => {
        break;
      }
      Next(stamp: value, tail: rest) => {
        bump(count: &total);
        set cursor = &rest^.inner;
      }
    }
  }
  return exit_status(code: 0_u8);
}
