alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum State {
  Ready();
}

enum Wrapper {
  Wrapped(state: State);
}

fn inspect(wrapper: Wrapper) -> return_value: unit pure {
  doc "OWN-1: a concrete tag-only payload binder remains Copy and may be matched repeatedly.";
  match wrapper {
    Wrapped(state: inner) => {
      match inner {
        Ready() => {
        }
      }
      match inner {
        Ready() => {
        }
      }
    }
  }
  return unit;
}

fn main() -> return_value: ExitStatus pure {
  return exit_status(code: 0_u8);
}
