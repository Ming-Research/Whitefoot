struct Table {
  slots: Slots<u64, 8>;
  next: u64;
  invariant cursor(table): table.next < table.slots.len;
}

interface Cursor {
  fn advance(t: &Table) -> result: u64 reads(t.slots), writes(t.next);
}

fn step(t: &Table) -> result: u64 reads(t.slots), writes(t.next) {
  let at = t^.next;
  let got = t^.slots[at];
  let after = at + 1_u64;
  if after == t^.slots.len {
    set t^.next = 0_u64;
  } else {
    set t^.next = after;
  }
  return got;
}

binding Step : Cursor {
  advance = step;
}

fn twice<interface Cursor>(t: &Table) -> result: u64 reads(t.slots), writes(t.next) {
  let a = Cursor::advance(t: t);
  let b = Cursor::advance(t: t);
  let sum = a +wrap b;
  return sum;
}

fn main() -> status: std::process::ExitStatus pure {
  let slots = slots_new::<u64, 8>();
  place_back(window: &slots, value: 10_u64);
  place_back(window: &slots, value: 11_u64);
  let table = Table(slots: move slots, next: 0_u64);
  let sum = twice::<Step>(t: &table);
  let code = cvt.wrap::<u64, u8>(sum);
  return std::process::exit_status(code: code);
}
