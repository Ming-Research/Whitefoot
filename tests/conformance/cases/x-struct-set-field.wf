alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Counter {
  n: i32;
}

fn main() -> status: ExitStatus pure {
  doc "TYPE-5: mutate a struct field with `set place.f = atom`, use the machine-derived S5 post-write equality to discharge the following exact addition, and return the result as the exit status.";
  let c = Counter(n: 1_i32);
  set c.n = 41_i32;
  let v = c.n + 1_i32;
  let status_code = cvt::<i32, u8>(v);
  return exit_status(code: status_code);
}
