alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A signed bare `/` with one constant operand is in the divisor class [OP-2], so it carries the division obligation instead of a runtime test [ENT-6]. The constant divisor is zero, a ground false conjunct rejected at every non-contradictory point: the always-invalid exact spelling is a compile-time rejection.";
  let x = 10_i32;
  let q = x / 0_i32;
  return exit_status(code: 0_u8);
}
