alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias arg_get = std::text::arg_get;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias relative_path = std::fs::relative_path;

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "The ordinary relative_path implementation returns PathInvalid for the arranged absolute name. This is an ordinary runtime error value, not a source rejection.";
  let Inputs(args: args, cwd: unused_cwd, stdout: unused_stdout, stderr: unused_stderr, handles: entry_factory, stdin: unused_stdin) = move inputs;
  close_directory(factory: &entry_factory, directory: move unused_cwd);
  match arg_get(args: &args, position: 1_u64) {
    Ok(value: text) => {
      match relative_path(value: move text) {
        Ok(value: path) => {
          return exit_status(code: 10_u8);
        }
        Err(error: rejected) => {
          match rejected {
            PathInvalid() => {
              return exit_status(code: 0_u8);
            }
          }
        }
      }
    }
    Err(error: absent) => {
      return exit_status(code: 11_u8);
    }
  }
}
