alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn paired(flag: Bool) -> result: u64 pure {
  let first = 0_u64;
  let second = 0_u64;
  for (
    i in 0_u64..10_u64,
    invariant first_bound: first <= i,
    invariant second_bound: second <= i
  ) {
    if flag {
      set first = first + 1_u64;
    } else {
      set second = second + 1_u64;
    }
  }
  return first + second;
}

fn sequential(flag: Bool) -> result: u64 pure {
  let first = 0_u64;
  for (
    i in 0_u64..4_u64,
    invariant bound: first <= i
  ) {
    if flag {
      set first = first + 1_u64;
    }
  }
  let second = 0_u64;
  for (
    i in 0_u64..3_u64,
    invariant bound: second <= i
  ) {
    if flag {
      set second = second + 1_u64;
    }
  }
  return first + second;
}

fn count_byte() -> result: u8 pure {
  let count = 0_u8;
  for (
    i in 0_u64..255_u64,
    invariant bound: count <= i
  ) {
    set count = count + 1_u8;
  }
  return count;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
