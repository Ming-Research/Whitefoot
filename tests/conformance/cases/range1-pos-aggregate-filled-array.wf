fn need(targets: &[Array<u32, 2>]) -> result: unit pure contract {
  requires forall zero(k in 0_u64..targets^.len): targets^[k][0_u64] == 5_u32, targets^[k][1_u64] == 5_u32;
} {
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let row = array_filled::<u32, 2>(value: 5_u32);
  let targets = array_filled::<Array<u32, 2>, 1>(value: row);
  need(targets: &targets[0_u64..1_u64]);
  return std::process::exit_status(code: 0_u8);
}
