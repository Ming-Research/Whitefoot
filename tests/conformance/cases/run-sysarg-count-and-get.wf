alias Args = std::text::Args;
alias ExitStatus = std::process::ExitStatus;
alias HostString = std::text::HostString;
alias Inputs = std::process::Inputs;
alias arg_get = std::text::arg_get;
alias args_count = std::text::args_count;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "The ordinary Args library value contains the arranged complete native argument vector. args_count reports three; arg_get returns the present HostString values and InvalidIndex beyond the last. No semantic qualification or special release authority is involved.";
  let Inputs(args: arguments, cwd: root, handles: factory, ..) = move inputs;
  close_directory(factory: &factory, directory: move root);
  let count = args_count(args: &arguments);
  let counted = count == 3_u64;
  if counted {
  } else {
    return exit_status(code: 10_u8);
  }
  match arg_get(args: &arguments, position: 0_u64) {
    Ok(value: invoked) => {
    }
    Err(error: missing) => {
      return exit_status(code: 11_u8);
    }
  }
  match arg_get(args: &arguments, position: 2_u64) {
    Ok(value: last) => {
    }
    Err(error: absent) => {
      return exit_status(code: 12_u8);
    }
  }
  match arg_get(args: &arguments, position: 3_u64) {
    Ok(value: beyond) => {
      return exit_status(code: 13_u8);
    }
    Err(error: past) => {
      return exit_status(code: 0_u8);
    }
  }
}
