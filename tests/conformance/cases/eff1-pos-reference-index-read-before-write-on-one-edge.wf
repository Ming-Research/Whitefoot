alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn write_slot(window: &Slots<u64, 4>, index: u64) -> result: unit writes(window[index]) contract {
  requires index < deref(window).len;
} {
  doc "Writes element index of the window through a reference both arms form from the call value of index, one of them before writing index.";
  let flag = 1_u64 <= index;
  let e = if flag {
    give &deref(window)[index];
  } else {
    let t = &deref(window)[index];
    set index = 0_u64;
    give t;
  }
  set deref(e) = 9_u64;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "EFF-1, REF-1: both arms form e from the call value of index, and the write of index in one arm follows the formation, so after the join e still names the row's window[index], element 1, though index may no longer hold its call value.";
  let r = slots_new::<u64, 4>();
  place_back(window: &r, value: 1_u64);
  place_back(window: &r, value: 2_u64);
  let p = &r[0_u64];
  write_slot(window: &r, index: 1_u64);
  let seen = deref(p);
  if seen == 1_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
