fn released(store: &Shared<ConcurrentHashMap<u8>>) -> result: Bool writes(store) {
  let freed = shared_map_release_reserve::<u8>(map: store);
  if freed == 0_u64 {
    return False();
  }
  return True();
}

fn main() -> status: std::process::ExitStatus pure waits {
  let store = shared_map_new::<u8>(capacity: 1_u64);
  let other = shared_map_new::<u8>(capacity: 1_u64);
  let count = 0_u64;
  atomic t = &store when released(store: &other) {
    set count = map_count::<u8>(map: t);
  }
  let code = cvt.wrap::<u64, u8>(count);
  return std::process::exit_status(code: code);
}
