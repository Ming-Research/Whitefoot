fn released(store: &Shared<ConcurrentHashMap<u8>>, meter: &std::process::MemoryMeter) -> result: Bool reads(store), writes(meter) {
  doc "Observe a release through a meter-writing call.";
  let freed = std::process::release_map_reserve::<u8>(map: store, meter: meter);
  if freed == 0_u64 {
    return False();
  }
  return True();
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  doc "An atomic guard must not write the memory meter.";
  let std::process::Inputs(cwd: directory, handles: factory, memory_meter: meter, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let store = shared_map_new::<u8>(capacity: 1_u64);
  let other = shared_map_new::<u8>(capacity: 1_u64);
  let count = 0_u64;
  atomic t = &store when released(store: &other, meter: &meter) {
    set count = map_count::<u8>(map: t);
  }
  let code = cvt.wrap::<u64, u8>(count);
  return std::process::exit_status(code: code);
}
