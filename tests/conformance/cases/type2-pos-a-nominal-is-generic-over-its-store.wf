alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Chunk<T> {
  page: Box<Slots<T>>;
}

fn chunk_room<T>(observed: Chunk<T>) -> (rest: Chunk<T>, width: u64) pure {
  doc "Reads one chunk's own capacity and hands the chunk back.";
  let spare = observed.page.inner.cap - observed.page.inner.len;
  return move observed, spare;
}

fn main() -> status: ExitStatus pure {
  doc "A nominal's type argument is a component of its type name, so an instance is fixed by that argument and a value of it is built by the ordinary construction. The helper is generic over the element type on the terms every other type is: its parameter type names the argument, and the written instantiation determines it at the call.";
  let page = box_slots_new::<u8>(capacity: 256_u64);
  let observed = Chunk<u8>(page: move page);
  let (rest, width) = chunk_room::<u8>(observed: move observed);
  if width == 256_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
