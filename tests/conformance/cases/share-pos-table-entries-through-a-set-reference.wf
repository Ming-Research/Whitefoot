struct Store {
  map: KeyedTable<u8>;
}

const names: Array<u8, 2> =[97_u8, 98_u8];

fn fill(store: &Shared<Store>, keys: &KeySet) -> result: u64 reads(store), reads(keys) waits {
  let count = 0_u64;
  atomic s = &store^, t = &s^.map {
    let entries = &t^[keys^];
    for @each (at in 0_u64..entries^.len) {
      set entries^[at] = Some<u8>(value: 7_u8);
    }
    set count = keyed_table_count::<u8>(table: t);
  }
  return count;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let table = keyed_table_new::<u8>(capacity: 0_u64);
  let state = Store(map: move table);
  let store = shared_new::<Store>(value: move state);
  let keys = key_set_new(capacity: 2_u64);
  key_set_insert(keys: &keys, key: &names[0_u64..1_u64]);
  key_set_insert(keys: &keys, key: &names[1_u64..2_u64]);
  let count = fill(store: &store, keys: &keys);
  if count == 2_u64 {
    return std::process::exit_status(code: 5_u8);
  }
  return std::process::exit_status(code: 1_u8);
}
