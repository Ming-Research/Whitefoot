alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn merged(left_count: u64, right_count: u64) -> result: u64 pure {
  doc "The first exit test's rank does not fall on the backedge, the second's does: one leading test's rank is enough [TERM-1].";
  let taken = 0_u64;
  let cursor = 0_u64;
  loop {
    if left_count >= 3_u64 {
      break;
    }
    if cursor >= right_count {
      break;
    }
    set taken = taken +wrap 1_u64;
    set cursor = cursor +wrap 1_u64;
  }
  return taken;
}

fn main() -> status: ExitStatus pure {
  let taken = merged(left_count: 0_u64, right_count: 4_u64);
  if taken != 4_u64 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
