alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A Segments content cannot be moved out of its cell, exactly as a runtime-capacity content cannot.";
  let lengths = box_array_filled::<u64>(count: 2_u64, value: 1_u64);
  let made = box_segments_filled::<u64>(lengths: &lengths.inner[0_u64..2_u64], value: 0_u64);
  match move made {
    None() => {
      return exit_status(code: 1_u8);
    }
    Some(value: cell) => {
      let taken = move cell.inner;
      return exit_status(code: 0_u8);
    }
  }
}
