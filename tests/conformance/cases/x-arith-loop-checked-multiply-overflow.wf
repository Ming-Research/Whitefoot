alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A loop folds a running product with checked multiplication [OP-1]. Overflow is an expected typed Err handled by ordinary control.";
  let i = 0_i32;
  let acc = 1_i32;
  let factor = 7_i32;
  loop @l {
    if i >= 20_i32 {
      break @l;
    }
    match acc *checked factor {
      Ok(value: product) => {
        set acc = product;
      }
      Err(error: overflow) => {
        return exit_status(code: 0_u8);
      }
    }
    set i = i +wrap 1_i32;
  }
  return exit_status(code: 1_u8);
}
