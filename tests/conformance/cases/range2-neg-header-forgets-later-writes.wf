fn zeros(cells: &[u64]) -> result: u64 reads(cells) contract {
  requires forall zero(k in 0_u64..cells^.len): cells^[k] == 0_u64;
} {
  doc "Returns the first cell.";
  if 0_u64 < cells^.len {
    let first = cells^[0_u64];
    return first;
  }
  return 0_u64;
}

fn run() -> result: u64 pure {
  doc "The write is reached only from the second iteration on, which a dry walk from the loop's entry state does not see.";
  let cells = box_array_filled::<u64>(count: 4_u64, value: 0_u64);
  let flag = False();
  let seen = 0_u64;
  for (i in 0_u64..3_u64) {
    let got = zeros(cells: &cells.inner[0_u64..4_u64]);
    set seen = got;
    if flag {
      set cells.inner[0_u64] = 5_u64;
    }
    set flag = True();
  }
  return seen;
}

fn main() -> status: std::process::ExitStatus pure {
  let r = run();
  if r != 0_u64 {
    return std::process::exit_status(code: 3_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
