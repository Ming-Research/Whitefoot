alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn crc32<const n: u64>(bytes: Array<u8, n>) -> function_result: u32 pure {
  doc "Folds the byte run; a by-value parameter carries no effect entry, so the declared row is the empty one [EFF-1].";
  let crc = 4294967295_u32;
  let length = bytes.len;
  for (offset in 0_u64..length) {
    let byte = bytes[offset];
    let word = cvt::<u8, u32>(byte);
    set crc = ixor(crc, word);
    for (bit in 0_u64..8_u64) {
      let low_bit = iand(crc, 1_u32);
      let shifted = ishr.wrap(crc, 1_u32);
      let low_bit_set = low_bit == 1_u32;
      if low_bit_set {
        set crc = ixor(shifted, 3988292384_u32);
      } else {
        set crc = shifted;
      }
    }
  }
  return ixor(crc, 4294967295_u32);
}

fn main() -> status: ExitStatus pure {
  doc "The standard CRC32 vector 123456789 computes 0xCBF43926 through checked byte-run access, the general total u8-to-u32 cvt path, and ordinary loop-carried integer operations.";
  let bytes = array_filled::<u8, 9>(value: 0_u8);
  set bytes[0_u64] = 49_u8;
  set bytes[1_u64] = 50_u8;
  set bytes[2_u64] = 51_u8;
  set bytes[3_u64] = 52_u8;
  set bytes[4_u64] = 53_u8;
  set bytes[5_u64] = 54_u8;
  set bytes[6_u64] = 55_u8;
  set bytes[7_u64] = 56_u8;
  set bytes[8_u64] = 57_u8;
  let checksum = crc32::<9>(bytes: bytes);
  if checksum == 3421780262_u32 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
