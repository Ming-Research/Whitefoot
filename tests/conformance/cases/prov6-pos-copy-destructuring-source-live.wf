struct ScanResult {
  size: u64;
  accepted: Bool;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The second destructuring's size after the source is mutated, 9, and the first destructuring's retained size, 7, form the exit status 97.";
  let accepted = True();
  let rebuilt = ScanResult(size: 7_u64, accepted: accepted);
  let ScanResult(size: count, accepted: built) = rebuilt;
  let expected = True();
  if built != expected {
    return std::process::exit_status(code: 2_u8);
  }
  set rebuilt.size = 9_u64;
  let ScanResult(size: again, ..) = rebuilt;
  let scaled = again * 10_u64;
  let total = scaled + count;
  let code = cvt::<u64, u8>(total);
  return std::process::exit_status(code: code);
}
