alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "The writing half of the range-reference domain over a frame-resident Slots run: the range reference is formed over the initialized window, one element is written through it, and the run itself is read back.";
  let one = slots_new::<u8, 2>();
  place_back(window: &one, value: 7_u8);
  let window = &one[0_u64..1_u64];
  set deref(window)[0_u64] = 9_u8;
  let seen = one[0_u64];
  if seen == 9_u8 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
