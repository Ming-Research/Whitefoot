fn write(source: &Array<u8, 2>, target: &Array<u8, 2>, index: u64, other: u64) -> result: unit writes(target[other]) contract {
  requires index < source^.len;
  requires other < target^.len;
  requires source^[index] == 0_u8;
} {
  set target^[other] = 1_u8;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let values = array_filled::<u8, 2>(value: 0_u8);
  if values[0_u64] == 0_u8 {
    write(source: &values, target: &values, index: 0_u64, other: 0_u64);
  }
  return std::process::exit_status(code: 0_u8);
}
