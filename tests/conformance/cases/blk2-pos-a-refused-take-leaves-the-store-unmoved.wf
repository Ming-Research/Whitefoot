alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "Allocation out of a pool is total in the source, so a request larger than cap - len is refused by the writer's own branch and never by a failure value. The case observes both: the arm the program takes, and the pool's cursor after it, which is exactly the cursor it held at the branch.";
  let pool = slots_new::<u64, 4>();
  let spare = pool.cap - pool.len;
  let fits = spare >= 64_u64;
  if fits {
    place_back(window: &pool, value: 1_u64);
    return exit_status(code: 1_u8);
  }
  let cursor = pool.len;
  if cursor == 0_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
