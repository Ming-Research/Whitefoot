alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn take_from(pool: &Slots<u64, 4>, request: u64) -> result: u8 writes(pool) contract {
  requires 1_u64 <= request;
} {
  doc "Refuses by its own branch a request larger than the pool's free extent cap - len; a request that fits takes one placement.";
  let spare = pool^.cap - pool^.len;
  let fits = spare >= request;
  if fits {
    place_back(window: pool, value: 1_u64);
    return 1_u8;
  }
  return 0_u8;
}

fn main() -> status: ExitStatus pure {
  doc "Allocation out of a pool is total in the source, so a request larger than cap - len is refused by the writer's own branch and never by a failure value. The case observes both: the arm the allocation takes, and the pool's cursor after it, which is exactly the cursor it held at the branch.";
  let pool = slots_new::<u64, 4>();
  let taken = take_from(pool: &pool, request: 64_u64);
  if taken != 0_u8 {
    return exit_status(code: 1_u8);
  }
  let cursor = pool.len;
  if cursor == 0_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
