fn fill(part: &[u64]) -> result: unit writes(part) {
  for (k in 0_u64..part^.len) {
    set part^[k] = 9_u64;
  }
  return unit;
}

fn write_interval(rows: &Slots<u64, 4>, lo: u64, hi: u64) -> result: unit writes(rows[lo..hi]) contract {
  requires lo <= hi;
  requires hi <= rows^.len;
} {
  doc "EFF-5 substitutes both by-value endpoints into the effect-row interval.";
  fill(part: &rows^[lo..hi]);
  return unit;
}

fn need_first(rows: &Slots<u64, 4>) -> result: unit pure contract {
  requires forall small_first(k in 0_u64..1_u64): rows^[k] <= 7_u64;
} {
  return unit;
}

fn probe(rows: &Slots<u64, 4>) -> result: unit writes(rows) contract {
  requires forall held_elements(k in 0_u64..rows^.len): rows^[k] <= 7_u64;
  requires 2_u64 <= rows^.len;
} {
  doc "The substituted interval is 1..2; RANGE-2 keeps the element at zero outside it and RANGE-3 proves need_first's requirement.";
  write_interval(rows: rows, lo: 1_u64, hi: 2_u64);
  need_first(rows: rows);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
