struct Store {
  map: KeyedTable<u8>;
}

const names: Array<u8, 2> =[97_u8, 98_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let table = keyed_table_new::<u8>(capacity: 0_u64);
  let state = Store(map: move table);
  let store = shared_new::<Store>(value: move state);
  let first = &names[0_u64..1_u64];
  let second = &names[1_u64..2_u64];
  let before = 9_u8;
  atomic s = &store, slot = &s^.map[first] {
    match slot^ {
      Some(value: held) => {
        set before = held^;
      }
      None() => {
        set before = 0_u8;
      }
    }
    set slot^ = Some<u8>(value: 7_u8);
  }
  atomic s = &store, slot = &s^.map[second] {
    set slot^ = None<u8>();
  }
  let counted = 0_u64;
  atomic s = &store {
    set counted = keyed_table_count::<u8>(table: &s^.map);
  }
  let code = 10_u8 +wrap before;
  if counted == 1_u64 {
    set code = code +wrap 3_u8;
  }
  return std::process::exit_status(code: code);
}
