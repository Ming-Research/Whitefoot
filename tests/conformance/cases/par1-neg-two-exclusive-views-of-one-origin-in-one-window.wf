alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn fill_pair(first: &[u8], second: &[u8]) -> result: unit writes(first), writes(second) contract {
  requires 2_u64 <= deref(first).len;
  requires 2_u64 <= deref(second).len;
} {
  doc "Writes one element through each range reference it was handed.";
  set deref(first)[0_u64] = 3_u8;
  set deref(second)[1_u64] = 5_u8;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "The writer forms two range references over one run and hands one to each write parameter of a single call, so both substituted write paths resolve to the same storage. EFF-5 compares the substituted effects pairwise and refuses an overlapping pair containing a write that is not proved disjoint; the two identical ranges are not disjoint, so the call is the rejection.";
  let values = array_filled::<u8, 2>(value: 0_u8);
  let run = slots_from_array::<u8, 2>(values: values);
  let first_window = &run[0_u64..2_u64];
  let second_window = &run[0_u64..2_u64];
  fill_pair(first: first_window, second: second_window);
  return exit_status(code: 0_u8);
}
