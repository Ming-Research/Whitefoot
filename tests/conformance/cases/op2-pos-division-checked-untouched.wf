alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> return_value: ExitStatus pure {
  doc "The dissolution attaches obligations to the bare divisor class only [OP-2]. The explicit `/checked` respelling is untouched: it needs no discharge, is pure, and returns `Err(DivideByZero())` for a zero divisor [OP-1].";
  let n = 10_i32;
  let d = 0_i32;
  let outcome = n /checked d;
  match outcome {
    Ok(value: q) => {
      return exit_status(code: 1_u8);
    }
    Err(error: e) => {
      match e {
        DivideByZero() => {
        }
        DivOverflow() => {
          return exit_status(code: 2_u8);
        }
      }
    }
  }
  return exit_status(code: 0_u8);
}
