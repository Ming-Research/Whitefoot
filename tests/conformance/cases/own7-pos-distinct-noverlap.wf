alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Slot {
  value: i32;
}

fn write_both(first: &Slot, second: &Slot) -> result: unit writes(first.value), writes(second.value) {
  doc "Two declared writes on two reference parameters.";
  set deref(first).value = 5_i32;
  set deref(second).value = 6_i32;
  return unit;
}

fn main() -> return_value: ExitStatus pure {
  doc "OWN-7: paths rooted at distinct bindings do not overlap, so the pairwise call-site comparison admits both writes and each root keeps its own value.";
  let a = Slot(value: 1_i32);
  let b = Slot(value: 2_i32);
  write_both(first: &a, second: &b);
  if a.value == 5_i32 {
  } else {
    return exit_status(code: 1_u8);
  }
  if b.value == 6_i32 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
