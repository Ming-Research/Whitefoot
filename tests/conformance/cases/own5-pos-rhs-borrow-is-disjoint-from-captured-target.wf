alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Slot {
  value: u64;
}

fn change(cell: &Slot) -> result: u64 writes(cell.value) {
  doc "Writes the cell it was handed and returns an unrelated number.";
  set deref(cell).value = 9_u64;
  return 7_u64;
}

fn main() -> status: ExitStatus pure {
  doc "Distinct literal elements keep the right-hand side's reference disjoint from the captured commit target, and that reference ends before the following statement writes its own element.";
  let first = Slot(value: 0_u64);
  let second = Slot(value: 0_u64);
  let slots = slots_new::<Slot, 2>();
  place_back(window: &slots, value: first);
  place_back(window: &slots, value: second);
  let values = slots_into_array::<Slot, 2>(values: move slots);
  set values[0_u64].value = 3_u64;
  set values[1_u64].value = 5_u64;
  set values[0_u64].value = change(cell: &values[1_u64]);
  let bumped = values[1_u64].value +wrap 1_u64;
  set values[1_u64].value = bumped;
  if values[0_u64].value != 7_u64 {
    return exit_status(code: 1_u8);
  }
  if values[1_u64].value != 10_u64 {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
