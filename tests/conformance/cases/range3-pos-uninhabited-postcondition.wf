fn never(n: u64) -> result: Option<Box<Array<u64>>> pure contract {
  requires n < 1_u64;
  requires n > 5_u64;
  ensures when Some(value: cells): forall up(k in 0_u64..cells.inner.len): cells.inner[k] == k;
} {
  doc "Its requirements contradict each other, so the instance is uninhabited and owes no selected exit.";
  return None<Box<Array<u64>>>();
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
