fn missing_range(error: &std::io::IoError, destination: &[u8], end: u64) -> result: Result<u64, std::io::DescriptionError> reads(error), writes(destination) {
  doc "The write permission is present and zero <= end holds, but end <= destination length is unproved. Before the API exists lookup fails; with its declaration the intended failure is FN-8 at this call.";
  return std::io::error_copy_description(error: error, destination: destination, start: 0_u64, end: end);
}
