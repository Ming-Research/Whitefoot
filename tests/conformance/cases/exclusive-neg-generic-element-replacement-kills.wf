alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn replace_at<T: drop>(values: &Slots<T, 2>, at: u64, incoming: &T) -> result: unit writes(values[at]), writes(incoming) contract {
  requires at < deref(values).len;
} {
  doc "A generic helper preserving the outer window's boundary while exchanging one of its elements [OP-11].";
  swap(first: &deref(values)[at], second: incoming);
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "The helper leaves the outer run's length alone but replaces its element. The exact projected write kills the caller fact about that element's own measures [ENT-5, MSR-2], so the subsequent inner subscript is unproved [OP-4].";
  let child = slots_new::<u64, 2>();
  place_back(window: &child, value: 7_u64);
  let values = slots_new::<Slots<u64, 2>, 2>();
  place_back(window: &values, value: move child);
  let fresh = slots_new::<u64, 2>();
  let size = values[0_u64].len;
  if size > 0_u64 {
    replace_at::<Slots<u64, 2>>(values: &values, at: 0_u64, incoming: &fresh);
    let stale = values[0_u64][0_u64];
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
