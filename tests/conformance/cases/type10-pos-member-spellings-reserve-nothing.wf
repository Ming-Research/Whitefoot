alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Node {
  len: u64;
  next: u64;
}

struct Inner {
  len: u64;
}

struct Outer {
  next: Inner;
}

struct WindowField {
  len: Slots<u64, 2>;
}

struct Windows {
  filled: WindowField;
}

fn read_nested(value: &Outer) -> result: u64 reads(value.next.len) {
  return value^.next.len;
}

fn main() -> status: ExitStatus pure {
  doc "TYPE-10: the window-part spellings and the measure field names reserve nothing. They are selected by the type of the place they follow, so a struct of another type declares fields named len and next, and bindings are named filled and last.";
  let node = Node(len: 3_u64, next: 4_u64);
  let filled = node.len;
  let last = node.next;
  let inner = Inner(len: 7_u64);
  let outer = Outer(next: inner);
  let seen = read_nested(value: &outer);
  if seen == 7_u64 {
  } else {
    return exit_status(code: 3_u8);
  }
  let slots = slots_new::<u64, 2>();
  let field = WindowField(len: move slots);
  let windows = Windows(filled: move field);
  place_back(window: &windows.filled.len, value: 9_u64);
  let count = windows.filled.len.len;
  let last_tens = last * 10_u64;
  let count_hundreds = count * 100_u64;
  let partial = filled + last_tens;
  let code = partial + count_hundreds;
  let status_code = cvt::<u64, u8>(code);
  return exit_status(code: status_code);
}
