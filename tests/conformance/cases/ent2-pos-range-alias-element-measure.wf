fn probe(r: &[Slots<u8, 8>]) -> result: u8 reads(r) contract {
  requires r^.len >= 1_u64;
  requires r^[0_u64].len >= 5_u64;
} {
  doc "ENT-2, MSR-1: a place below an element of the range alias q, q^[0_u64].len, is the term r^[0_u64].len, so the element requirement on r discharges the nested read through q.";
  let q = r;
  let x = q^[0_u64][4_u64];
  return x;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "No call is needed to exercise the proof identity.";
  return std::process::exit_status(code: 0_u8);
}
