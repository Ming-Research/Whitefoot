alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn scale(x: u8) -> result: u8 pure contract {
  requires x <= 25_u8;
} {
  let y = x * 10_u8;
  return y;
}

fn widen_add(a: i8, b: i8) -> result: i32 pure {
  let wa = cvt::<i8, i32>(a);
  let wb = cvt::<i8, i32>(b);
  let sum = wa + wb;
  return sum;
}

fn nonnegative_gap(x: i32, y: i32) -> result: i32 pure contract {
  requires x >= 0_i32;
  requires y >= 0_i32;
  requires x >= y;
} {
  let difference = x - y;
  return difference;
}

fn signed_gap(high: i32, low: i32) -> result: i32 pure contract {
  requires high <= 1000_i32;
  requires low >= -1000_i32;
} {
  if low <= high {
    let gap = high - low;
    return gap;
  }
  return 0_i32;
}

fn offset_from_floor(value: i32) -> result: i32 pure contract {
  requires value >= -1000_i32;
  requires value <= 1000_i32;
} {
  let offset = value - -1000_i32;
  return offset;
}

fn widen_and_scale(a: i16, factor: i32) -> result: i32 pure contract {
  requires factor <= 100_i32;
  requires factor >= 0_i32;
} {
  let wide_a = cvt::<i16, i32>(a);
  let scaled = wide_a * factor;
  return scaled;
}

fn magnitude(value: i32) -> result: i32 pure {
  if value > -2147483648_i32 {
    let m = iabs(value);
    return m;
  }
  return 2147483647_i32;
}

fn safe_remainder(value: i32, divisor: i32) -> result: i32 pure {
  let is_defined = value %defined divisor;
  if is_defined {
    let remainder = value % divisor;
    return remainder;
  } else {
    return 0_i32;
  }
}

fn offset_from_origin(step: i32) -> result: i32 pure contract {
  requires step <= 1000_i32;
  requires step >= -1000_i32;
} {
  let base = -1000_i32;
  let scaled = step * 3_i32;
  let position = base + scaled;
  return position;
}

fn average_step(total: i32, steps: i32) -> result: i32 pure contract {
  requires total /defined steps;
} {
  let quotient = total / steps;
  return quotient;
}

fn distance_to_end(index: u64, length: u64) -> result: u64 pure contract {
  requires index <= length;
  ensures result <= length;
} {
  let remaining = length - index;
  return remaining;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
