alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy struct Item {
  weight: u64;
}

fn main() -> return_value: ExitStatus pure {
  doc "A loop body that consumes a binding declared outside it and never reinitializes it leaves the backedge in a state the entering edge did not have, so one iteration would start where the previous one did not end.";
  let item = Item(weight: 0_u64);
  loop @l {
    let taken = move item;
    break @l;
  }
  return exit_status(code: 0_u8);
}
