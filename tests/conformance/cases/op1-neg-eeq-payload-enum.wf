alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy enum PayloadEq {
  PayloadEmpty();
  PayloadValue(value: u32);
}

fn compare(left: PayloadEq, right: PayloadEq) -> return_value: Bool pure {
  doc "eeq is defined only over a tag-only enum type, so selecting it for an enum with a payload variant is an invalid operation [OP-1]; the operands are moved so OWN-1 forms no candidate first.";
  return eeq(move left, move right);
}

fn main() -> return_value: ExitStatus pure {
  return exit_status(code: 0_u8);
}
