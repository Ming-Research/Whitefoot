struct ZeroesAliasPropagateReset {
  cells: Array<u64, 1>;
  invariant(c): forall zero(k in 0_u64..c^.cells.len): c^.cells[k] == 0_u64;
}

fn need_aliaspropagatereset(z: &ZeroesAliasPropagateReset) -> result: unit pure {
  return unit;
}

fn update_aliaspropagatereset(first: Shared<ZeroesAliasPropagateReset>, second: Shared<ZeroesAliasPropagateReset>, outcome: Result<u8, unit>) -> result: Result<u8, unit> pure waits {
  atomic a = &first, b = &second {
    set a^.cells[0_u64] = 1_u64;
    set a^.cells[0_u64] = 0_u64;
    need_aliaspropagatereset(z: b);
    let inner = propagate outcome;
    set a^.cells[0_u64] = 0_u64;
  }
  return Ok<u8, unit>(value: 3_u8);
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
