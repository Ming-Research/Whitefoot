alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn selected(value: i32) -> result: Result<i32, Overflow> pure contract {
  ensures when Ok(value: result): result == value;
} {
  return Ok<i32, Overflow>(value: value);
}

fn relay(outer: i32, replacement: i32) -> result: i32 pure contract {
  ensures result == replacement;
} {
  match selected(value: replacement) {
    Ok(value: payload) => {
      set outer = payload;
      return outer;
    }
    Err(error: problem) => {
      return replacement;
    }
  }
}

fn main() -> status: ExitStatus pure {
  let observed = relay(outer: 0_i32, replacement: 7_i32);
  let code = cvt::<i32, u8>(observed);
  return exit_status(code: code);
}
