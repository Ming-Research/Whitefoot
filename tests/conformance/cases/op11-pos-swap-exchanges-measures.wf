alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn replace_empty(cell: &Box<Slots<u64>>) -> result: unit writes(cell) contract {
  requires cell^.inner.len == 0_u64;
  ensures cell^.inner.len == 0_u64;
  ensures cell^.inner.cap == 4_u64;
} {
  doc "The swap moves whole windows, so each target then has the measures the other had: the window handed back has the old window's length, zero, and can be released, and the cell has the fresh window's length and capacity [OP-11, MSR-2, OP-14, FN-9].";
  let fresh = box_slots_new::<u64>(capacity: 4_u64);
  swap(first: &cell^, second: &fresh);
  free_empty(window: move fresh);
  return unit;
}

fn main() -> status: ExitStatus pure {
  let cell = box_slots_new::<u64>(capacity: 2_u64);
  replace_empty(cell: &cell);
  place_back(window: &cell.inner, value: 7_u64);
  let back = take_back(window: &cell.inner);
  free_empty(window: move cell);
  if back != 7_u64 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
