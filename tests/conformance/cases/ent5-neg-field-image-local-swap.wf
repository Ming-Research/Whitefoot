nocopy struct Reading {
  value: i64;
}

fn make() -> made: Reading pure contract {
  ensures -1000_i64 <= made.value;
} {
  doc "The construction carries 0 into the field the postcondition names.";
  return Reading(value: 0_i64);
}

fn shift(d: u8, x: i64) -> result: i64 pure {
  doc "The swap writes both of its targets, the local holding the field included, which kills the call result's bound; the field now holds x, so the subtraction of a widened byte may overflow.";
  let e = make();
  let spare = Reading(value: x);
  swap(first: &e, second: &spare);
  let w = cvt::<u8, i64>(d);
  let v = e.value - w;
  return v;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
