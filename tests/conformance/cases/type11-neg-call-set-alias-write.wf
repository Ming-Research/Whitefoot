nocopy struct Pair {
  left: u64;
  right: u64;
  invariant equal(pair): pair.left == pair.right;
}

fn make() -> result: Pair pure {
  return Pair(left: 1_u64, right: 1_u64);
}

fn update(pair: &Pair) -> result: unit writes(pair) {
  let other = pair;
  set pair^ = make();
  set other^.left = 2_u64;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let pair = Pair(left: 0_u64, right: 0_u64);
  let done = update(pair: &pair);
  return std::process::exit_status(code: 0_u8);
}
