alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const values: Array<u8, 4> =[1_u8, 2_u8, 3_u8, 4_u8];

fn main() -> status: ExitStatus pure {
  doc "Per-input counted induction proves sum <= 255*(i+1) on the unchanged and advancing inputs separately; no terminal joined image is needed.";
  let sum = 0_u32;
  for (
    i in 0_u64..4_u64,
    invariant sum_bound: sum <= 255_u32 * i
  ) {
    let byte = values[i];
    let wide = cvt::<u8, u32>(byte);
    let parity = iand(wide, 1_u32);
    let is_odd = parity == 1_u32;
    if is_odd {
    } else {
      set sum = sum + wide;
    }
  }
  return exit_status(code: 0_u8);
}
