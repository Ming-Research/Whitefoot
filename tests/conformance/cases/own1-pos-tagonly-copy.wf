  Lo();
  Mid();
  Hi();
}

fn main() -> return_value: ExitStatus pure {
  doc "OWN-1 amendment: tag-only enums are copy - matched twice, passed bare, loop-carried, and set-mutated without move.";
  let t = Tri::Mid();
  match t {
    Lo() => {
    }
    Mid() => {
    }
    Hi() => {
    }
  }
  match t {
    Lo() => {
    }
    Mid() => {
    }
    Hi() => {
    }
  }
  let flag = 1_u64 == 1_u64;
  let both = band(flag, flag);
  let neither = bnot(both);
  let i = 0_u64;
  loop @l {
    if i >= 3_u64 {
      break @l;
    }
    if neither {
    }
    set i = i +wrap 1_u64;
  }
  return exit_status(code: 0_u8);
