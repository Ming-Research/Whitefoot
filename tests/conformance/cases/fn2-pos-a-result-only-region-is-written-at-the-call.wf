alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn nothing<T>() -> made: Option<T> pure {
  doc "Reports no value at all, over an element type no parameter position mentions.";
  return None<T>();
}

fn absorb(spare: Option<Slots<u8, 4>>) -> width: u64 pure {
  doc "Reports the capacity of the run it was handed, or zero when there is none.";
  match spare {
    None() => {
      return 0_u64;
    }
    Some(value: run) => {
      return run.cap;
    }
  }
}

fn main() -> status: ExitStatus pure {
  doc "FN-2: a type parameter that occupies no input position of its declaration is still written at the call and substituted into the result; every instantiation argument is explicit. The specialized `absorb` then observes that the empty result has exactly the element type the caller chose.";
  let spare = nothing::<Slots<u8, 4>>();
  let width = absorb(spare: move spare);
  if width == 0_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
