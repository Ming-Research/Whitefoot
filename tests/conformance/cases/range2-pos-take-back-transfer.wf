struct Block {
  parent: u32;
}

fn transfer(source: &Slots<Block, 1>, destination: &Slots<Block, 1>) -> result: unit writes(source.last), writes(source.len), writes(destination.next), writes(destination.len) contract {
  requires source^.len == 1_u64;
  requires destination^.len == 0_u64;
  requires forall old_parent(k in 0_u64..source^.len): source^[k].parent == 0_u32;
  ensures forall new_parent(k in 0_u64..destination^.len): destination^[k].parent == 0_u32;
} {
  let taken = take_back(window: source);
  place_back(window: destination, value: taken);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
