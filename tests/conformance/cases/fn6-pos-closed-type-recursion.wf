alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn poly<T: drop>(x: T) -> result: T pure {
  doc "FN-6 admits i32 as a closed type argument on the recursive edge, including when the entry instance supplies u8.";
  let y = poly::<i32>(x: 0_i32);
  return move x;
}

fn main() -> status: ExitStatus pure {
  let z = poly::<u8>(x: 0_u8);
  return exit_status(code: 0_u8);
}
