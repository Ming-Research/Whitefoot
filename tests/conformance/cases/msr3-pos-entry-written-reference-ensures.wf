interface Preserve {
  fn preserve(window: &Slots<u64, 4>) -> result: unit writes(window) contract {
    ensures window^.len == entry(window)^.len;
  };
}

fn keep(window: &Slots<u64, 4>) -> result: unit writes(window) contract {
  requires window^.len > 0_u64;
  ensures window^.len == entry(window)^.len;
} {
  let last = take_back(window: window);
  place_back(window: window, value: last);
  return unit;
}

fn invoke<fn operation(window: &Slots<u64, 4>) -> result: unit writes(window) contract {
  requires window^.len > 0_u64;
  ensures window^.len == entry(window)^.len;
}>(window: &Slots<u64, 4>) -> result: unit writes(window) contract {
  requires window^.len > 0_u64;
  ensures window^.len == entry(window)^.len;
} {
  operation(window: window);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let window = slots_new::<u64, 4>();
  place_back(window: &window, value: 7_u64);
  invoke::<fn keep>(window: &window);
  let last = take_back(window: &window);
  return std::process::exit_status(code: 0_u8);
}
