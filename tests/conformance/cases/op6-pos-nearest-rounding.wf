alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn narrow_bits(bits: u64) -> result: u32 pure {
  let value = reinterpret::<u64, f64>(bits);
  let rounded = cvt.nearest::<f64, f32>(value);
  return reinterpret::<f32, u32>(rounded);
}

fn unsigned_double_bits(value: u64) -> result: u64 pure {
  let rounded = cvt.nearest::<u64, f64>(value);
  return reinterpret::<f64, u64>(rounded);
}

fn to_single<T: Float>(value: T) -> result: f32 pure {
  return cvt.nearest::<T, f32>(value);
}

fn integer_to_single<T: Int>(value: T) -> result: f32 pure {
  return cvt.nearest::<T, f32>(value);
}

fn channel(value: f64) -> result: f32 pure contract {
  define rounded = cvt.nearest::<f64, f32>(value);
  requires fle(rounded, 1.0_f32);
} {
  return cvt.nearest::<f64, f32>(value);
}

fn bounded_channel(ratio: f64) -> result: f32 pure {
  let rounded = cvt.nearest::<f64, f32>(ratio);
  let bounded = fle(rounded, 1.0_f32);
  if bounded {
    return channel(value: ratio);
  }
  return 1.0_f32;
}

fn main() -> status: ExitStatus pure {
  doc "Rounding conversion is total for float destinations: an inexact quotient, ties to even, overflow to a signed infinity, subnormal and zero results with the input's sign, canonical NaN, exact agreement with cvt, integer rounding including u64 2^53+1 and a u64-to-f32 value that rounding through f64 would get wrong, symbolic endpoints and a contract definition.";
  let ratio = fdiv.strict(136.0_f64, 255.0_f64);
  let ratio_single = cvt.nearest::<f64, f32>(ratio);
  let ratio_bits = reinterpret::<f32, u32>(ratio_single);
  if ratio_bits != 1057523849_u32 {
    return exit_status(code: 1_u8);
  }
  let halfway_even = narrow_bits(bits: 4607182419068452864_u64);
  if halfway_even != 1065353216_u32 {
    return exit_status(code: 2_u8);
  }
  let halfway_odd = narrow_bits(bits: 4607182419605323776_u64);
  if halfway_odd != 1065353218_u32 {
    return exit_status(code: 3_u8);
  }
  let above_halfway = narrow_bits(bits: 4607182419068452865_u64);
  if above_halfway != 1065353217_u32 {
    return exit_status(code: 4_u8);
  }
  let largest_double = narrow_bits(bits: 9218868437227405311_u64);
  if largest_double != 2139095040_u32 {
    return exit_status(code: 5_u8);
  }
  let negative_largest = narrow_bits(bits: 18442240474082181119_u64);
  if negative_largest != 4286578688_u32 {
    return exit_status(code: 6_u8);
  }
  let overflow_tie = narrow_bits(bits: 5183643170835005440_u64);
  if overflow_tie != 2139095040_u32 {
    return exit_status(code: 7_u8);
  }
  let below_overflow_tie = narrow_bits(bits: 5183643170835005439_u64);
  if below_overflow_tie != 2139095039_u32 {
    return exit_status(code: 8_u8);
  }
  let subnormal_tie = narrow_bits(bits: 3938397874135498752_u64);
  if subnormal_tie != 2_u32 {
    return exit_status(code: 9_u8);
  }
  let subnormal_nearest = narrow_bits(bits: 3933894274508128256_u64);
  if subnormal_nearest != 1_u32 {
    return exit_status(code: 10_u8);
  }
  let underflow_tie = narrow_bits(bits: 3931642474694443008_u64);
  if underflow_tie != 0_u32 {
    return exit_status(code: 11_u8);
  }
  let negative_underflow_tie = narrow_bits(bits: 13155014511549218816_u64);
  if negative_underflow_tie != 2147483648_u32 {
    return exit_status(code: 12_u8);
  }
  let above_underflow_tie = narrow_bits(bits: 3931642474694443009_u64);
  if above_underflow_tie != 1_u32 {
    return exit_status(code: 13_u8);
  }
  let negative_zero = narrow_bits(bits: 9223372036854775808_u64);
  if negative_zero != 2147483648_u32 {
    return exit_status(code: 14_u8);
  }
  let negative_infinity = narrow_bits(bits: 18442240474082181120_u64);
  if negative_infinity != 4286578688_u32 {
    return exit_status(code: 15_u8);
  }
  let payload_nan = narrow_bits(bits: 18442240474082181121_u64);
  let canonical_nan = fnan::<f32>();
  let canonical_bits = reinterpret::<f32, u32>(canonical_nan);
  if payload_nan != canonical_bits {
    return exit_status(code: 16_u8);
  }
  let exact_half = cvt::<f64, f32>(0.5_f64);
  let rounded_half = cvt.nearest::<f64, f32>(0.5_f64);
  let exact_half_bits = reinterpret::<f32, u32>(exact_half);
  let rounded_half_bits = reinterpret::<f32, u32>(rounded_half);
  if rounded_half_bits != exact_half_bits {
    return exit_status(code: 17_u8);
  }
  let above_double_precision = unsigned_double_bits(value: 9007199254740993_u64);
  if above_double_precision != 4845873199050653696_u64 {
    return exit_status(code: 18_u8);
  }
  let odd_tie = unsigned_double_bits(value: 9007199254740995_u64);
  if odd_tie != 4845873199050653698_u64 {
    return exit_status(code: 19_u8);
  }
  let unsigned_maximum = unsigned_double_bits(value: 18446744073709551615_u64);
  if unsigned_maximum != 4895412794951729152_u64 {
    return exit_status(code: 20_u8);
  }
  let single_from_wide = cvt.nearest::<u64, f32>(1152921573326323713_u64);
  let single_from_wide_bits = reinterpret::<f32, u32>(single_from_wide);
  if single_from_wide_bits != 1568669697_u32 {
    return exit_status(code: 21_u8);
  }
  let negative_tie = integer_to_single::<i32>(value: -16777217_i32);
  let negative_tie_bits = reinterpret::<f32, u32>(negative_tie);
  if negative_tie_bits != 3414163456_u32 {
    return exit_status(code: 22_u8);
  }
  let signed_minimum = integer_to_single::<i64>(value: -9223372036854775808_i64);
  let signed_minimum_bits = reinterpret::<f32, u32>(signed_minimum);
  if signed_minimum_bits != 3741319168_u32 {
    return exit_status(code: 23_u8);
  }
  let integer_zero = integer_to_single::<u8>(value: 0_u8);
  let integer_zero_bits = reinterpret::<f32, u32>(integer_zero);
  if integer_zero_bits != 0_u32 {
    return exit_status(code: 24_u8);
  }
  let generic_ratio = to_single::<f64>(value: ratio);
  let generic_ratio_bits = reinterpret::<f32, u32>(generic_ratio);
  if generic_ratio_bits != 1057523849_u32 {
    return exit_status(code: 25_u8);
  }
  let signaling = reinterpret::<u32, f32>(2139095041_u32);
  let copied = to_single::<f32>(value: signaling);
  let copied_bits = reinterpret::<f32, u32>(copied);
  if copied_bits != 2139095041_u32 {
    return exit_status(code: 26_u8);
  }
  let red = bounded_channel(ratio: ratio);
  let red_bits = reinterpret::<f32, u32>(red);
  if red_bits != 1057523849_u32 {
    return exit_status(code: 27_u8);
  }
  return exit_status(code: 0_u8);
}
