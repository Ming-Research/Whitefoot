alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn probe(table: &Slots<u8, 4>, lo: u64, hi: u64) -> found: u8 reads(table) contract {
  define spare = deref(table).len;
  requires lo < hi;
  requires hi <= spare;
} {
  doc "The written certificate sums lo < hi and the published division image 2*half <= span into 2*(mid - hi) <= -1. Over the integers that halves to mid < hi, which with hi <= spare discharges the subscript below [PRF-1, ENT-6, OP-4].";
  let span = hi - lo;
  let half = span / 2_u64;
  let mid = lo + half;
  invariant inside: mid < hi {
    use (lo < hi);
    use (2_u64 * half <= span);
  }
  let byte = deref(table)[mid];
  return byte;
}

fn main() -> status: ExitStatus pure {
  doc "A four-slot window is filled from a full array, so its length is exactly four at the call.";
  let values = array_filled::<u8, 4>(value: 0_u8);
  let table = slots_from_array::<u8, 4>(values: values);
  let found = probe(table: &table, lo: 0_u64, hi: 4_u64);
  return exit_status(code: found);
}
