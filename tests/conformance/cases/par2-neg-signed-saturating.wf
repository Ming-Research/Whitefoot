fn reduce() -> result: i8 pure {
  doc "Signed saturation is not associative and has no scalar reduction permission.";
  let total = 127_i8;
  for (i in 0_u64..4_u64) {
    let amount = 1_i8;
    if i < 2_u64 {
      set amount = -1_i8;
    }
    set total = total +sat amount;
  }
  return total;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Check the independent expected results.";
  let reduced = reduce();
  return std::process::exit_status(code: 0_u8);
}
