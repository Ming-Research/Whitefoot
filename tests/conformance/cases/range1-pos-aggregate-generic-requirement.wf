enum Flow {
  Open(block: u64);
  Close(block: u64);
}

fn same<T: copy>(targets: &[T], value: T) -> result: unit pure contract {
  requires forall same(k in 0_u64..targets^.len): targets^[k] == value;
} {
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let opened = Flow::Open(block: 3_u64);
  let targets = array_filled::<Flow, 1>(value: opened);
  same::<Flow>(targets: &targets[0_u64..1_u64], value: opened);
  return std::process::exit_status(code: 0_u8);
}
