const names: Array<u8, 2> =[97_u8, 98_u8];

fn write(store: &Shared<ConcurrentHashMap<u8>>, key: &[u8]) -> result: unit reads(store) waits {
  atomic t = &store^ {
    set t^[key] = Some<u8>(value: 1_u8);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let store_map = map_new::<u8>(capacity: 0_u64);
  let store = shared_new::<ConcurrentHashMap<u8>>(value: move store_map);
  let name = &names[0_u64..1_u64];
  write(store: &store, key: name);
  return std::process::exit_status(code: 0_u8);
}
