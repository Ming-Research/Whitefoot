alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn scan(data: Array<u8, 5>) -> result: u8 pure {
  let total = 0_u8;
  for (i in 0_u64..5_u64) {
    let back = 5_u64 - i;
    let byte = data[back];
    set total = total +wrap byte;
  }
  return total;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
