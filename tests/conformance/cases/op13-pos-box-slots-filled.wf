fn filled<T: copy>(count: u64, value: T) -> result: Box<Slots<T>> pure contract {
  ensures result.inner.len == count;
  ensures result.inner.cap == count;
  ensures forall same(k in 0_u64..result.inner.len): result.inner[k] == value;
} {
  doc "Transfers the constructor's measure and fill facts through an explicitly instantiated Copy-generic function.";
  let made = box_slots_filled::<T>(count: count, value: value);
  return move made;
}

fn inspect(cells: &Box<Slots<u64>>) -> value: u64 reads(cells) contract {
  requires cells^.inner.len == 3_u64;
  requires cells^.inner.cap == 3_u64;
  requires forall seventeen(k in 0_u64..cells^.inner.len): cells^.inner[k] == 17_u64;
} {
  doc "The independently required measures and integer fill facts authorize the read.";
  return cells^.inner[2_u64];
}

fn main() -> status: std::process::ExitStatus pure {
  let cells = filled::<u64>(count: 3_u64, value: 17_u64);
  let value = inspect(cells: &cells);
  if value != 17_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
