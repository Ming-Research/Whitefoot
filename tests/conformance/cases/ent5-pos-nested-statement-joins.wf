alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum InnerKind {
  Head();
  Tail();
}

fn fetch_from_if(b: &[u8], i: u64, wide: Bool, kind: InnerKind) -> result: u8 reads(b) {
  doc "A match nested inside an if: direct and negated comparison edges establish the same strict bound on every reaching path, and both the inner and the outer join must retain it [ENT-5, OP-4].";
  let spare = deref(b).len;
  if wide {
    match kind {
      Head() => {
        let direct = i < spare;
        if direct {
        } else {
          return 0_u8;
        }
      }
      Tail() => {
        let far = i >= spare;
        if far {
          return 0_u8;
        }
      }
    }
  } else {
    let narrow_bound = i < spare;
    if narrow_bound {
    } else {
      return 0_u8;
    }
  }
  return deref(b)[i];
}

enum OuterKind {
  Exact();
  Margin();
}

fn fetch_from_match(b: &[u8], i: u64, kind: OuterKind, safe: Bool) -> result: u8 reads(b) {
  doc "The opposite nesting order, an if inside a match, must retain the same common bound.";
  let spare = deref(b).len;
  match kind {
    Exact() => {
      let inside = i < spare;
      if inside {
      } else {
        return 0_u8;
      }
    }
    Margin() => {
      if safe {
        let direct = i < spare;
        if direct {
        } else {
          return 0_u8;
        }
      } else {
        let far = i >= spare;
        if far {
          return 0_u8;
        }
      }
    }
  }
  return deref(b)[i];
}

fn main() -> status: ExitStatus pure {
  doc "No construction is needed to exercise the nested joins.";
  return exit_status(code: 0_u8);
}
