enum RoutedContradiction {
  Item(index: u64);
}

fn selected() -> result: RoutedContradiction pure contract {
  ensures when Item(index: payload): payload == 1_u64;
  ensures when Item(index: payload): payload == 2_u64;
} {
  return RoutedContradiction::Item(index: 1_u64);
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
