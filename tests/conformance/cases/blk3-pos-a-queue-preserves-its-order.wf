alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "place_back moves the back boundary and take_front moves the front one, so a ring is a queue with no Option anywhere; a failure exit code observes the order the three elements come back in. Each front removal replaces the whole window state, so the next requirement is discharged from a reread length; the exit status carries the three reread lengths as the digits of one number.";
  let run = ring_new::<u8, 4>();
  place_back(window: &run, value: 1_u8);
  place_back(window: &run, value: 2_u8);
  place_back(window: &run, value: 3_u8);
  let first = take_front(window: &run);
  if first == 1_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  let after_one = run.len;
  let second = take_front(window: &run);
  if second == 2_u8 {
  } else {
    return exit_status(code: 2_u8);
  }
  let after_two = run.len;
  let third = take_front(window: &run);
  if third == 3_u8 {
  } else {
    return exit_status(code: 3_u8);
  }
  let left = run.len;
  let hundreds = after_one * 100_u64;
  let tens = after_two * 10_u64;
  let upper = hundreds + tens;
  let combined = upper + left;
  let code = cvt::<u64, u8>(combined);
  return exit_status(code: code);
}
