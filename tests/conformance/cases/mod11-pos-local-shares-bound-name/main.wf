alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias Value = json::Value;

fn number(v: Value) -> n: i32 pure {
  doc "Reads the json package's own value type.";
  return v.n;
}

fn main() -> status: ExitStatus pure {
  doc "A local binder takes the spelling of a bound name, which still roots the qualified call.";
  let json = json::make(n: 7_i32);
  let n = number(v: json);
  if n == 7_i32 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
