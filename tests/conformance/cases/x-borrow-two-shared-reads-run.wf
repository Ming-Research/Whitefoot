alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "Two references naming one place coexist and are both read through postfix ^ [REF-1, TYPE-7]; read/read overlap is admitted without limit [EFF-5], so the sum of the two reads, 14, is the exit status.";
  let a = 7_i32;
  let s1 = &a;
  let s2 = &a;
  let sum = s1^ + s2^;
  let status_code = cvt::<i32, u8>(sum);
  return exit_status(code: status_code);
}
