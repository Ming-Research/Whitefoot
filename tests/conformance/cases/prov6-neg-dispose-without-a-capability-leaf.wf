alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy struct Frame {
  count: u64;
}

fn main() -> status: ExitStatus pure {
  doc "OP-14: free_empty's compiler-owned shape parameter admits exactly Slots and Ring in either placement and their boxed forms. A frame-resident struct is none of them, has no storage of its own to reclaim, and the scope exit owns its whole disposition.";
  let frame = Frame(count: 4_u64);
  free_empty(window: move frame);
  return exit_status(code: 0_u8);
}
