alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn last_index(values: &Slots<u8, 12>) -> index: u64 reads(values.len) contract {
  define capacity = deref(values).len;
  requires capacity > 0_u64;
  ensures index < capacity;
} {
  doc "A definition expands the run length in both the requirement and the result bound; a proved nonempty window admits length minus one and proves the returned index is strictly inside that same entry measure.";
  let capacity = deref(values).len;
  let index = capacity - 1_u64;
  return index;
}

fn main() -> status: ExitStatus pure {
  let values = slots_new::<u8, 12>();
  for (
    at_values in 0_u64..12_u64,
    invariant grown_values: values.len >= at_values,
    invariant spare_values: values.cap - values.len + at_values >= 12_u64
  ) {
    place_back(window: &values, value: 0_u8);
  }
  let index = last_index(values: &values);
  if index == 11_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
