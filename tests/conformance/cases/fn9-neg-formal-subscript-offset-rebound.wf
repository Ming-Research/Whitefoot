alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn width(rows: &Array<Slots<u8, 8>, 4>, i: u64) -> r: u64 reads(rows) contract {
  ensures r <= rows^[i].len;
} {
  doc "The clause's offset is i at entry, which no requirement bounds; the rebinding makes a bounded i the one in scope at the return.";
  set i = 0_u64;
  if rows^[i].len > 9_u64 {
    return 0_u64;
  }
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  doc "The declaration alone is judged.";
  return exit_status(code: 0_u8);
}
