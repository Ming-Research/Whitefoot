struct Pair {
  a: u64;
  b: u64;
}

interface Stage {
  fn touch(e: &Entries<Pair>, i: u64, j: u64) -> result: u64 reads(e[i].Some.value.a), writes(e[j].Some.value.a);
}

fn work<interface Stage>(t: &ConcurrentHashMap<Pair>, keys: &KeySet, i: u64, j: u64) -> result: u64 reads(keys), writes(t) {
  if i == j {
    return 0_u64;
  }
  let y = Stage::touch(e: &t^[keys^], i: i, j: j);
  return y;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
