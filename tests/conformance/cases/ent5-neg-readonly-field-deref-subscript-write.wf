fn select(table: &[Slots<u8, 8>], r: &u64, i: u64) -> result: u8 reads(table), writes(r) contract {
  requires r^ < table^.len;
} {
  doc "ENT-5: a dereferenced offset's support includes the integer storage its reference targets. Writing that target kills the old row-length guard, so the later nested read owes an unproved OP-4 bound.";
  if i < table^[r^].len {
    set r^ = 0_u64;
    return table^[r^][i];
  }
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The function body is checked without a call.";
  return std::process::exit_status(code: 0_u8);
}
