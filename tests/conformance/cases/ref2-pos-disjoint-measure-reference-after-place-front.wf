fn main() -> status: std::process::ExitStatus pure {
  let source = slots_new::<u64, 4>();
  let length = &source.len;
  let ring = ring_new::<u64, 4>();
  place_front(window: &ring, value: source.len);
  let observed = length^;
  if observed == 0_u64 {
  } else {
    return std::process::exit_status(code: 1_u8);
  }
