const name: Array<u8, 1> =[97_u8];

fn replace_held(slots: &Entries<u8>, index: u64) -> result: unit reads(slots[index]), reads(slots.len), writes(slots[index].Some.value) {
  if index < slots^.len {
    match &slots^[index] {
      Some(value: observed_state) => {
        set observed_state^ = 41_u8;
      }
      None() => {
      }
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let store = shared_map_new::<u8>(capacity: 1_u64);
  let keys = key_set_new(capacity: 1_u64);
  let key = &name[0_u64..1_u64];
  let index = key_set_insert(keys: &keys, key: key);
  atomic slots = &store[keys] {
    set slots^[index] = Some<u8>(value: 7_u8);
    replace_held(slots: slots, index: index);
  }
  let byte = 0_u8;
  atomic slot = &store[key] {
    match slot^ {
      Some(value: observed_state) => {
        set byte = observed_state^;
      }
      None() => {
      }
    }
  }
  if byte != 41_u8 {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: byte);
}
