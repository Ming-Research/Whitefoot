const names: Array<u8, 4> =[97_u8, 98_u8, 99_u8, 100_u8];

fn flush(map: &ConcurrentHashMap<Box<u64>>) -> result: unit writes(map) {
  map_clear::<Box<u64>>(map: map);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let store = shared_map_new::<Box<u64>>(capacity: 1_u64);
  let code = 42_u8;
  let a = &names[0_u64..1_u64];
  let b = &names[1_u64..2_u64];
  let c = &names[2_u64..3_u64];
  let d = &names[3_u64..4_u64];
  atomic t = &store {
    let first = box_new::<u64>(value: 1_u64);
    set t^[a] = Some<Box<u64>>(value: move first);
    let second = box_new::<u64>(value: 2_u64);
    set t^[b] = Some<Box<u64>>(value: move second);
  }
  let inside = 9_u64;
  let kept = 9_u64;
  atomic t = &store {
    let third = box_new::<u64>(value: 3_u64);
    set t^[c] = Some<Box<u64>>(value: move third);
    map_clear::<Box<u64>>(map: t);
    set inside = map_count::<Box<u64>>(map: t);
    match t^[a] {
      Some(..) => {
        set code = 1_u8;
      }
      None() => {
      }
    }
    match t^[c] {
      Some(..) => {
        set code = 2_u8;
      }
      None() => {
      }
    }
    let fourth = box_new::<u64>(value: 4_u64);
    set t^[d] = Some<Box<u64>>(value: move fourth);
    set kept = map_count::<Box<u64>>(map: t);
  }
  if inside != 0_u64 {
    set code = 3_u8;
  }
  if kept != 1_u64 {
    set code = 4_u8;
  }
  let keys = key_set_new(capacity: 4_u64);
  let after = 9_u64;
  atomic t = &store {
    let next = map_scan::<Box<u64>>(map: t, cursor: 0_u64, count: 0_u64, keys: &keys);
    loop {
      if next == 0_u64 {
        break;
      }
      set next = map_scan::<Box<u64>>(map: t, cursor: next, count: 0_u64, keys: &keys);
    }
    flush(map: t);
    flush(map: t);
    set after = map_count::<Box<u64>>(map: t);
  }
  if after != 0_u64 {
    set code = 5_u8;
  }
  if keys.len != 1_u64 {
    set code = 6_u8;
  }
  if keys.len < 1_u64 {
    return std::process::exit_status(code: 6_u8);
  }
  let buffer = array_filled::<u8, 1>(value: 0_u8);
  let length = key_set_read_key(keys: &keys, index: 0_u64, out: &buffer[0_u64..1_u64]);
  if length != 1_u64 {
    set code = 7_u8;
  }
  if buffer[0_u64] != 100_u8 {
    set code = 8_u8;
  }
  let empty = 9_u64;
  atomic t = &store {
    set empty = map_count::<Box<u64>>(map: t);
  }
  if empty != 0_u64 {
    set code = 9_u8;
  }
  return std::process::exit_status(code: code);
}
