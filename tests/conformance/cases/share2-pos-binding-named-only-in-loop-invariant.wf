fn main() -> status: std::process::ExitStatus pure waits {
  let keys = key_set_new(capacity: 1_u64);
  let store = shared_new::<KeySet>(value: move keys);
  atomic t = &store {
    for (
      i in 0_u64..1_u64,
      invariant nonnegative: 0_u64 <= t^.len
    ) {
      let count = i;
    }
  }
  atomic t = &store {
    loop (
      invariant nonnegative: 0_u64 <= t^.len
    ) {
      break;
    }
  }
  return std::process::exit_status(code: 0_u8);
}
