alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> return_value: ExitStatus pure {
  doc "A runtime-capacity window is taken from the one heap [OP-13]. Allocation is total, so the construction carries no failure arm; a size the target cannot allocate is heap exhaustion [OP-9, STOR-8].";
  let taken = box_slots_new::<i32>(capacity: 4_u64);
  let room = taken.inner.cap;
  if room == 4_u64 {
  } else {
    return exit_status(code: 70_u8);
  }
  return exit_status(code: 0_u8);
}
