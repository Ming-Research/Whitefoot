alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn filled<T: copy, const n: u64>(value: T) -> result: Slots<T, n> pure contract {
  ensures result.len >= n;
  ensures result.cap <= result.len;
} {
  doc "Builds a window of n slots, every one holding a copy of value; the copy bound is what admits the bare repeated use.";
  let built = slots_new::<T, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: built.len >= at,
    invariant spare: built.cap - built.len + at >= n
  ) {
    place_back(window: &built, value: value);
  }
  return move built;
}

fn walk_bound<const n: u64>(source: Slots<u8, 8>) -> last: u8 pure contract {
  requires n < source.len;
} {
  doc "A const generic as a clause operand and as a counted range endpoint.";
  for (at in 0_u64..n) {
    let seen = at;
  }
  return source[n];
}

fn main() -> status: ExitStatus pure {
  doc "MSR-6: the pbase admission carries the const generic into the two other positions a named const already reaches, the for_stmt endpoint and the clause operand. The requirement is stated over the parameter, the counted loop's upper endpoint is the same parameter, and the subscript at that offset discharges from the requirement after instantiation folds the parameter to its mathematical constant.";
  let run = filled::<u8, 8>(value: 0_u8);
  let last = walk_bound::<4>(source: move run);
  if last == 0_u8 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
