const names: Array<u8, 1> =[97_u8];

fn replace(slot: &Option<u8>) -> result: unit writes(slot) {
  set slot^ = Some<u8>(value: 9_u8);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let owner = shared_map_new::<u8>(capacity: 1_u64);
  let view = shared_read::<ConcurrentHashMap<u8>>(shared: &owner);
  let key = &names[0_u64..1_u64];
  atomic held = &view[key] {
    replace(slot: held);
  }
  return std::process::exit_status(code: 0_u8);
}
