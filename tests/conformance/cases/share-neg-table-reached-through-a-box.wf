struct Part {
  map: KeyedTable<u8>;
}

struct Store {
  boxed: Box<Part>;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let table = keyed_table_new::<u8>(capacity: 0_u64);
  let part = Part(map: move table);
  let boxed = box_new::<Part>(value: move part);
  let state = Store(boxed: move boxed);
  let store = shared_new::<Store>(value: move state);
  let count = 0_u64;
  atomic s = &store {
    set count = keyed_table_count::<u8>(table: &s^.boxed.inner.map);
  }
  return std::process::exit_status(code: 0_u8);
}
