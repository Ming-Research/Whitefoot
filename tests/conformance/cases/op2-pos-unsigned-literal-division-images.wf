alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn consume_images(quotient: u64, doubled: u64, count: u64) -> result: unit pure contract {
  requires quotient <= count;
  requires doubled <= count;
} {
  return unit;
}

fn doubled_floor(count: u64) -> result: u64 pure contract {
  ensures result <= count;
} {
  let quotient = count / 2_u64;
  let doubled = quotient * 2_u64;
  let consumed = consume_images(quotient: quotient, doubled: doubled, count: count);
  return doubled;
}

fn main() -> status: ExitStatus pure {
  let result = doubled_floor(count: 9_u64);
  if result == 8_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
