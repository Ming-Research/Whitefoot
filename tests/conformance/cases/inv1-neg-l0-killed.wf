fn probe(initial: u64, replacement: u64) -> result: unit pure contract {
  requires 2_u64 * initial <= 8_u64;
} {
  doc "Replacement kills the invariant's mutable-term bound while its old affine theorem stays true.";
  let x = initial;
  invariant bounded: x <= 4_u64;
  set x = replacement;
  if x == 4_u64 {
    return unit;
  }
  invariant stale: x <= 3_u64;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
