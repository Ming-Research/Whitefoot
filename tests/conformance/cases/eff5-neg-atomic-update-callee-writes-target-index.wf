alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn advanced(current: Box<u64>, cursor: &u64) -> result: Box<u64> writes(cursor) contract {
  ensures cursor^ == 1_u64;
} {
  doc "Writes the cursor the caller's target subscript reads.";
  set cursor^ = 1_u64;
  return move current;
}

fn main() -> status: ExitStatus pure {
  doc "EFF-5: the first argument reads the cursor through its subscript and the second lets the callee write it, so the call is refused. This keeps an OP-12 update from reading its target out at slot 0 while SET-1, evaluating the target after the call, would name slot 1.";
  let v = slots_new::<Box<u64>, 2>();
  let first = box_new::<u64>(value: 1_u64);
  place_back(window: &v, value: move first);
  let second = box_new::<u64>(value: 2_u64);
  place_back(window: &v, value: move second);
  let cursor = 0_u64;
  set v[cursor] = advanced(current: move v[cursor], cursor: &cursor);
  return exit_status(code: 0_u8);
}
