alias DirectoryRead = std::fs::DirectoryRead;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias IoError = std::io::IoError;
alias close_directory = std::fs::close_directory;
alias close_directory_source = std::fs::close_directory_source;
alias directory_next = std::fs::directory_next;
alias exit_status = std::process::exit_status;
alias open_directory_source = std::fs::open_directory_source;

fn factory_refusal(error: &IoError) -> result: Bool reads(error) {
  match deref(error) {
    NotFound(code: native_code, origin: native_origin) => {
      return False();
    }
    PermissionDenied(code: native_code, origin: native_origin) => {
      return False();
    }
    AlreadyExists(code: native_code, origin: native_origin) => {
      return False();
    }
    NotDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    IsDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    DirectoryNotEmpty(code: native_code, origin: native_origin) => {
      return False();
    }
    ReadOnly(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceBusy(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidInput(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidPath(code: native_code, origin: native_origin) => {
      return False();
    }
    Unsupported(code: native_code, origin: native_origin) => {
      return False();
    }
    TimedOut(code: native_code, origin: native_origin) => {
      return False();
    }
    BrokenPipe(code: native_code, origin: native_origin) => {
      return False();
    }
    WriteZero(code: native_code, origin: native_origin) => {
      return False();
    }
    UnexpectedEnd(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionRefused(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionReset(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionAborted(code: native_code, origin: native_origin) => {
      return False();
    }
    NotConnected(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressInUse(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressUnavailable(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceExhausted(code: native_code, origin: native_origin) => {
      return deref(native_origin) == 0_u8;
    }
    FileTooLarge(code: native_code, origin: native_origin) => {
      return False();
    }
    NoSpace(code: native_code, origin: native_origin) => {
      return False();
    }
    QuotaExceeded(code: native_code, origin: native_origin) => {
      return False();
    }
    CrossDevice(code: native_code, origin: native_origin) => {
      return False();
    }
    DeviceFailure(code: native_code, origin: native_origin) => {
      return False();
    }
    Other(code: native_code, origin: native_origin) => {
      return False();
    }
  }
}

fn exercise(cwd: &DirectoryRead, files: &HandleFactory) -> status: ExitStatus reads(cwd), writes(files) {
  doc "The ordinary enumeration library emits records with one kind byte, a little-endian u16 name length and the name bytes. The program checks the selected record format, kind range and announced entry count without a special language operand class.";
  let entries = slots_new::<u8, 4096>();
  for @scratch (
    at in 0_u64..4096_u64,
    invariant grown: entries.len >= at,
    invariant vacancy: entries.cap - entries.len + at >= 4096_u64
  ) {
    place_back(window: &entries, value: 0_u8);
  }
  let spare = entries.len;
  let status = 0_u8;
  match open_directory_source(factory: files, directory: cwd) {
    Ok(value: list) => {
      let produced = 0_u64;
      let announced = 0_u64;
      let window = &entries[0_u64..4096_u64];
      let (list_result_26, bytes, reported) = directory_next(source: &list, destination: window, start: 0_u64, end: 4096_u64);
      match list_result_26 {
        Ok(value: done) => {
          set produced = bytes;
          set announced = reported;
        }
        Err(error: list_stop_26) => {
          match list_stop_26 {
            ListEnd() => {
            }
            ListFailed(error: problem) => {
              set status = 3_u8;
            }
          }
        }
      }
      let at = 0_u64;
      let seen = 0_u64;
      loop @stored_entry {
        let header_end = at +wrap 3_u64;
        let complete = header_end <= produced;
        if complete {
        } else {
          break @stored_entry;
        }
        let kind_readable = at < spare;
        if kind_readable {
        } else {
          break @stored_entry;
        }
        let kind = entries[at];
        let closed = kind <= 4_u8;
        if closed {
        } else {
          set status = 9_u8;
          break @stored_entry;
        }
        let length_low_at = at +wrap 1_u64;
        let length_low_readable = length_low_at < spare;
        if length_low_readable {
        } else {
          break @stored_entry;
        }
        let length_high_at = at +wrap 2_u64;
        let length_high_readable = length_high_at < spare;
        if length_high_readable {
        } else {
          break @stored_entry;
        }
        let length_low = entries[length_low_at];
        let length_high = entries[length_high_at];
        let length_low_wide = cvt::<u8, u64>(length_low);
        let length_high_wide = cvt::<u8, u64>(length_high);
        let length_high_shifted = ishl.wrap(length_high_wide, 8_u32);
        let name_count = ior(length_low_wide, length_high_shifted);
        let named = name_count > 0_u64;
        if named {
        } else {
          set status = 10_u8;
          break @stored_entry;
        }
        let name_at = at +wrap 3_u64;
        let name_end = name_at +wrap name_count;
        let bounded = name_end <= produced;
        if bounded {
        } else {
          break @stored_entry;
        }
        set at = name_end;
        set seen = seen +wrap 1_u64;
      }
      let counted = seen == announced;
      if counted {
      } else {
        set status = 12_u8;
      }
      close_directory_source(factory: files, source: move list);
    }
    Err(error: problem) => {
      if factory_refusal(error: &problem) {
        return exit_status(code: 13_u8);
      }
      set status = 4_u8;
    }
  }
  return exit_status(code: status);
}

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "PRE-2 ordinary Inputs are destructured once; the borrowed operation chain returns before the initial directory is explicitly closed on every exit.";
  let Inputs(args: unused_args, cwd: cwd, stdout: unused_stdout, stderr: unused_stderr, handles: files, stdin: unused_stdin) = move inputs;
  let outcome = exercise(cwd: &cwd, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return move outcome;
}
