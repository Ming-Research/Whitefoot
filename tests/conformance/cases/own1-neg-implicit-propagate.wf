alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy struct Token {
  value: u8;
}

fn forward(outcome: Result<Token, unit>) -> result: Result<Token, unit> pure {
  let token = propagate outcome;
  return Ok<Token, unit>(value: move token);
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
