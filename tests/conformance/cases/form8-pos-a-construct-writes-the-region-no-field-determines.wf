alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Ticket<T> {
  count: u64;
}

fn main() -> status: ExitStatus pure {
  doc "FN-2: the other half. No field of `Ticket` mentions its type parameter, so nothing about the operands could have supplied it, and the construct writes it in its own type-argument list exactly as every other instantiation argument is written.";
  let one = Ticket<Slots<u8, 4>>(count: 7_u64);
  if one.count == 7_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
