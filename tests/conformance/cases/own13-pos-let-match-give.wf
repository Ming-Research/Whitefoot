alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> return_value: ExitStatus pure {
  doc "OWN-13: let-initializer value-match; the taken arm's own result is moved exactly once and is the exit status 42.";
  let v = match 40_i32 +checked 2_i32 {
    Ok(value: w) => {
      give w;
    }
    Err(error: e) => {
      return exit_status(code: 1_u8);
    }
  }
  let code = cvt::<i32, u8>(v);
  return exit_status(code: code);
}
