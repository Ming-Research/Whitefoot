struct Pair {
  marker: u64;
  value: u64;
}

fn inspect(first: &Pair, second: &Pair) -> result: unit pure contract {
  requires first^.value == 0_u64;
  requires second^.value == 0_u64;
} {
  return unit;
}

fn caller() -> result: unit pure {
  let object = Pair(marker: 0_u64, value: 0_u64);
  inspect(first: &object, second: &object);
  return unit;
}
