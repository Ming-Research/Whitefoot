fn put(map: &ConcurrentHashMap<u8>, a: u64, b: u64) -> result: unit writes(map) {
  let key = array_filled::<u8, 2>(value: 0_u8);
  set key[0_u64] = cvt.wrap::<u64, u8>(a);
  set key[1_u64] = cvt.wrap::<u64, u8>(b);
  let name = &key[0_u64..2_u64];
  set map^[name] = Some<u8>(value: 1_u8);
  return unit;
}

fn remove(map: &ConcurrentHashMap<u8>, a: u64, b: u64) -> result: unit writes(map) {
  let key = array_filled::<u8, 2>(value: 0_u8);
  set key[0_u64] = cvt.wrap::<u64, u8>(a);
  set key[1_u64] = cvt.wrap::<u64, u8>(b);
  let name = &key[0_u64..2_u64];
  set map^[name] = None<u8>();
  return unit;
}

fn note(keys: &KeySet, a: u64, b: u64) -> result: unit writes(keys) {
  let key = array_filled::<u8, 2>(value: 0_u8);
  set key[0_u64] = cvt.wrap::<u64, u8>(a);
  set key[1_u64] = cvt.wrap::<u64, u8>(b);
  let name = &key[0_u64..2_u64];
  key_set_insert(keys: keys, key: name);
  return unit;
}

fn collect(map: &ConcurrentHashMap<u8>, keys: &KeySet) -> result: unit reads(map), writes(keys) {
  let next = map_scan::<u8>(map: map, cursor: 0_u64, count: 0_u64, keys: keys);
  loop {
    if next == 0_u64 {
      break;
    }
    set next = map_scan::<u8>(map: map, cursor: next, count: 0_u64, keys: keys);
  }
  return unit;
}

fn index_of(keys: &KeySet, a: u64, b: u64) -> index: u64 writes(keys) {
  let key = array_filled::<u8, 2>(value: 0_u8);
  set key[0_u64] = cvt.wrap::<u64, u8>(a);
  set key[1_u64] = cvt.wrap::<u64, u8>(b);
  let at = key_set_insert(keys: keys, key: &key[0_u64..2_u64]);
  return at;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let store = shared_map_new::<u8>(capacity: 1_u64);
  let code = 42_u8;
  atomic t = &store {
    for @fill (a in 0_u64..4_u64) {
      for @row (b in 0_u64..8_u64) {
        put(map: t, a: a, b: b);
      }
    }
  }
  let keys = key_set_new(capacity: 4_u64);
  note(keys: &keys, a: 9_u64, b: 9_u64);
  note(keys: &keys, a: 2_u64, b: 5_u64);
  atomic t = &store {
    collect(map: t, keys: &keys);
  }
  if keys.len != 33_u64 {
    set code = 1_u8;
  }
  let absent = index_of(keys: &keys, a: 9_u64, b: 9_u64);
  if absent != 0_u64 {
    set code = 2_u8;
  }
  let present = index_of(keys: &keys, a: 2_u64, b: 5_u64);
  if present != 1_u64 {
    set code = 3_u8;
  }
  for @check (a in 0_u64..4_u64) {
    for @column (b in 0_u64..8_u64) {
      note(keys: &keys, a: a, b: b);
    }
  }
  if keys.len != 33_u64 {
    set code = 4_u8;
  }
  return std::process::exit_status(code: code);
}
