alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn increment(x: u8, middle: u8, replacement: u8) -> result: u8 pure contract {
  requires x <= middle;
  requires middle <= 254_u8;
} {
  set middle = replacement;
  let result = x + 1_u8;
  return result;
}

fn main() -> status: ExitStatus pure {
  let result = increment(x: 2_u8, middle: 10_u8, replacement: 0_u8);
  if result == 3_u8 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
