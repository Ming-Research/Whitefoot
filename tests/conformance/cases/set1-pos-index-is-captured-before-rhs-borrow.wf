alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Cursor {
  at: u64;
}

fn change(index: &Cursor) -> result: u64 writes(index.at) {
  doc "Writes the separate scalar index through its reference parameter and returns the value the caller commits.";
  set deref(index).at = 1_u64;
  return 41_u64;
}

fn main() -> status: ExitStatus pure {
  doc "The target captures index zero before the right-hand side writes the separate scalar index to one; the final commit still reaches the captured element.";
  let rows = slots_new::<u64, 2>();
  place_back(window: &rows, value: 3_u64);
  place_back(window: &rows, value: 5_u64);
  let index = Cursor(at: 0_u64);
  if index.at < rows.len {
    set rows[index.at] = change(index: &index);
  } else {
    return exit_status(code: 4_u8);
  }
  let first = rows[0_u64];
  if first != 41_u64 {
    return exit_status(code: 1_u8);
  }
  let second = rows[1_u64];
  if second != 5_u64 {
    return exit_status(code: 2_u8);
  }
  let moved = index.at;
  if moved != 1_u64 {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
