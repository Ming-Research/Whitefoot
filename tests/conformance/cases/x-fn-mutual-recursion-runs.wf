alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn iseven(n: i32) -> function_result: i32 pure {
  doc "Mutually recursive with isodd; returns 1 when n is even [FN-1, FN-6]. The guard is `<=` so the else arm establishes n > 0, discharging the OP-2 overflow obligation on `n - 1_i32`; the operation needs no runtime fallback, so the row is `pure`.";
  if n <= 0_i32 {
    return 1_i32;
  } else {
    let m = n - 1_i32;
    return isodd(n: m);
  }
}

fn isodd(n: i32) -> function_result: i32 pure {
  doc "Mutually recursive with iseven; returns 0 when n is even [FN-1, FN-6]. The guard is `<=` so the else arm establishes n > 0, discharging the OP-2 overflow obligation on `n - 1_i32`; the operation needs no runtime fallback, so the row is `pure`.";
  if n <= 0_i32 {
    return 0_i32;
  } else {
    let m = n - 1_i32;
    return iseven(n: m);
  }
}

fn main() -> status: ExitStatus pure {
  doc "Mutual recursion resolves across two signatures; forward reference is legal [FN-1].";
  let r = iseven(n: 8_i32);
  if r == 1_i32 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
