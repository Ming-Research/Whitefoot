alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A window operation publishes what it did to both windows as well as the elements it moved: append states deref(destination).len == deref(entry(destination)).len + deref(entry(source)).len and deref(source).len == 0_u64, so the caller reads both new lengths from the record and from nothing else.";
  let source = slots_new::<u8, 4>();
  place_back(window: &source, value: 1_u8);
  place_back(window: &source, value: 2_u8);
  let destination = slots_new::<u8, 8>();
  place_back(window: &destination, value: 3_u8);
  append(destination: &destination, source: &source);
  let moved = destination.len;
  if moved == 3_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  let drained = source.len;
  if drained == 0_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
