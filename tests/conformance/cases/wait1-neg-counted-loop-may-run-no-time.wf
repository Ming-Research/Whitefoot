alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias Instant = std::time::Instant;

fn naps(count: u64, until: Instant) -> result: unit pure must_wait {
  doc "The only wait is inside a counted loop, which may run its body no time, so a path to the return executes no wait [WAIT-1].";
  for (i in 0_u64..count) {
    std::time::sleep_until(deadline: until);
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
