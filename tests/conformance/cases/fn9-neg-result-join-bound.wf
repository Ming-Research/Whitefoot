alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn smaller() -> result: Result<i32, Overflow> pure contract {
  ensures when Ok(value: payload): payload < 8_i32;
} {
  return Ok<i32, Overflow>(value: 0_i32);
}

fn larger() -> result: Result<i32, Overflow> pure contract {
  ensures when Ok(value: payload): payload < 10_i32;
} {
  return Ok<i32, Overflow>(value: 0_i32);
}

fn bounded(value: i32) -> result: unit pure contract {
  requires value < 8_i32;
} {
  return unit;
}

fn consumer(choose: Bool) -> result: Result<unit, Overflow> pure {
  let outcome = if choose {
    give smaller();
  } else {
    give larger();
  }
  let value = propagate outcome;
  bounded(value: value);
  return Ok<unit, Overflow>(value: unit);
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
