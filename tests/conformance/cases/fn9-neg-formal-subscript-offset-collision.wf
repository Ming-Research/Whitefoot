alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn width(rows: &Array<Slots<u8, 8>, 4>, i: u64) -> r: u64 reads(rows) contract {
  requires i < 4_u64;
  ensures r <= rows^[i].len;
} {
  doc "Returns a bound on the length of element i.";
  if rows^[i].len > 9_u64 {
    return 9_u64;
  }
  return 0_u64;
}

fn relay(rows: &Array<Slots<u8, 8>, 4>, k: u64) -> r: u64 reads(rows) contract {
  requires k < 4_u64;
  ensures r <= rows^[k].len;
} {
  doc "The first result is bounded by element one; only the second call's relation is over element k.";
  let first = width(rows: rows, i: 1_u64);
  let other = width(rows: rows, i: k);
  if other > 9_u64 {
    return other;
  }
  return first;
}

fn main() -> status: ExitStatus pure {
  doc "The declarations alone are judged.";
  return exit_status(code: 0_u8);
}
