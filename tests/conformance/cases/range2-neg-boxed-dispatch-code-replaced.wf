fn dispatch(targets: &Box<Array<u64>>, code: &Box<Array<u8>>) -> result: u8 reads(targets), writes(code) contract {
  requires 0_u64 < targets^.inner.len;
  requires forall ok(j in 0_u64..targets^.inner.len): targets^.inner[j] < code^.inner.len;
} {
  let pc = 0_u64;
  loop (
    invariant slot: pc < targets^.inner.len
  ) {
    let t = targets^.inner[pc];
    let op = code^.inner[t];
    if op == 0_u8 {
      return op;
    }
    let replacement = box_array_filled::<u8>(count: 0_u64, value: 0_u8);
    set code^ = move replacement;
    set pc = 0_u64;
    continue;
  }
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
