struct Holder {
  count: u8;
  cell: Box<u8>;
}

fn same(h: Holder) -> result: Holder pure {
  return move h;
}

fn bump(marks: &[u64], x: u8) -> result: u8 pure contract {
  requires forall small(k in 0_u64..marks^.len): marks^[k] < 8_u64;
} {
  doc "The atomic update writes the storage at r's own path, so r stays valid and the write through r makes s.count x, which may be 9.";
  let s = Holder(count: 0_u8, cell: box_new::<u8>(value: 0_u8));
  let r = &s;
  set s = same(h: move s);
  set s.count = 1_u8;
  set r^.count = x;
  let v = s.count;
  let w = 251_u8 + v;
  return w;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
