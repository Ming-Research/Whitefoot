struct Triple {
  a: u8;
  b: u8;
  c: u8;
}

fn bump(marks: &[u64], x: u64, y: u8) -> result: u8 pure contract {
  requires forall small(k in 0_u64..marks^.len): marks^[k] < 8_u64;
} {
  doc "r names s.a or s.b, neither of which overlaps s.c, so the write through r leaves s.c 1.";
  let s = Triple(a: 1_u8, b: 1_u8, c: 1_u8);
  let r = if x < 10_u64 {
    give &s.a;
  } else {
    give &s.b;
  }
  set r^ = y;
  let v = s.c;
  let w = 251_u8 + v;
  return w;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
