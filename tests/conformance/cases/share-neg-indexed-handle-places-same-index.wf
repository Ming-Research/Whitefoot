fn pour(shards: &Array<Shared<u64>, 4>, slot: u64) -> result: unit reads(shards) waits contract {
  requires slot < 4_u64;
} {
  atomic source = &shards^[slot], target = &shards^[slot] {
    set target^ = target^ +wrap source^;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
