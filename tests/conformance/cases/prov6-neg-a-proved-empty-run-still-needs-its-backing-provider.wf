alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn release_without_free<T, const n: u64>(run: Slots<T, n>) -> result: unit pure contract {
  requires run.len == 0_u64;
} {
  doc "PROV-6: a zero-length fact says the window holds no element, and that is all it says. The window's own type is still linear, so the compiler-derived release never carries it and free_empty remains the one route that consumes the storage.";
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "The rejection is in the generic template above; this entry point does nothing.";
  return exit_status(code: 0_u8);
}
