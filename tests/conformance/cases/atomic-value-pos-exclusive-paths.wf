fn choose_atomic(owner: &Shared<AtomicValue>, choose: Bool) -> result: u64 reads(owner) waits {
  let old = 0_u64;
  atomic s = &owner^ {
    if choose {
      set old = atomic_raise(cell: s, value: 10_u64);
    } else {
      set old = atomic_load(cell: s);
    }
  }
  return old;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let owner = shared_atomic_new(value: 0_u64);
  let yes = True();
  let raised = choose_atomic(owner: &owner, choose: yes);
  let no = False();
  let seen = choose_atomic(owner: &owner, choose: no);
  if raised != 0_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  if seen != 10_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
