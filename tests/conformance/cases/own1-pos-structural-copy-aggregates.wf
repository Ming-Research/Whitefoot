alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Record {
  values: Array<u8, 2>;
}

enum Wrapped {
  Packed(record: Record);
}

fn pass<T>(value: T) -> back: T pure {
  doc "The template uses the spelling required by its unbounded parameter. At a copy instance this denotes a copy and leaves the caller's operand live.";
  return move value;
}

fn first(value: Wrapped) -> result: u8 pure {
  match value {
    Packed(record: payload) => {
      return payload.values[0_u64];
    }
  }
}

fn second(value: Wrapped) -> result: u8 pure {
  match value {
    Packed(record: payload) => {
      return payload.values[1_u64];
    }
  }
}

fn main() -> status: ExitStatus pure {
  doc "A struct containing an Array and an enum containing that struct copy their inline storage by value. Mutating two copies independently leaves the third copy, the source struct, and the source Array unchanged; an unbounded generic move instantiated with the copy struct also leaves its caller operand live.";
  let seed = array_filled::<u8, 2>(value: 0_u8);
  set seed[0_u64] = 1_u8;
  set seed[1_u64] = 2_u8;
  let record = Record(values: seed);
  let forwarded = pass::<Record>(value: record);
  set forwarded.values[0_u64] = 7_u8;
  let original = Wrapped::Packed(record: record);
  let changed_second = original;
  let untouched = original;
  let original_ref = &original;
  match deref(original_ref) {
    Packed(record: payload) => {
      set deref(payload).values[0_u64] = 9_u8;
    }
  }
  let second_ref = &changed_second;
  match deref(second_ref) {
    Packed(record: payload) => {
      set deref(payload).values[1_u64] = 8_u8;
    }
  }
  let original_first = first(value: original);
  let original_second = second(value: original);
  let changed_first = first(value: changed_second);
  let changed_second_value = second(value: changed_second);
  let untouched_first = first(value: untouched);
  let untouched_second = second(value: untouched);
  if original_first != 9_u8 {
    return exit_status(code: 1_u8);
  }
  if original_second != 2_u8 {
    return exit_status(code: 2_u8);
  }
  if changed_first != 1_u8 {
    return exit_status(code: 3_u8);
  }
  if changed_second_value != 8_u8 {
    return exit_status(code: 4_u8);
  }
  if untouched_first != 1_u8 {
    return exit_status(code: 5_u8);
  }
  if untouched_second != 2_u8 {
    return exit_status(code: 6_u8);
  }
  if seed[0_u64] != 1_u8 {
    return exit_status(code: 7_u8);
  }
  if record.values[0_u64] != 1_u8 {
    return exit_status(code: 8_u8);
  }
  if forwarded.values[0_u64] != 7_u8 {
    return exit_status(code: 9_u8);
  }
  return exit_status(code: 0_u8);
}
