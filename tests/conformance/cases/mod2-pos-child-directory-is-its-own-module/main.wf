alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn seven() -> result: u8 pure {
  doc "The root module's own seven: the child directory's records are another module and do not collide with it.";
  return 0_u8;
}

fn main() -> status: ExitStatus pure {
  let own = seven();
  let child = pkg::tools::seven();
  if child == 7_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: own);
}
