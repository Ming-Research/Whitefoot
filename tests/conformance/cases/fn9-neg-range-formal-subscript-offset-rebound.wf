alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn span(rows: &[Slots<u8, 8>], i: u64) -> r: u64 pure contract {
  requires i < rows^.len;
  ensures r <= rows^[i].len;
} {
  doc "The range element's offset is i at entry, which the requirement bounds; rebinding i makes its entry value unavailable at the return.";
  set i = 99_u64;
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  doc "The declaration alone is judged.";
  return exit_status(code: 0_u8);
}
