alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn distance(upper: u64, lower: u64) -> result: u64 pure {
  let ordered = lower <= upper;
  if ordered {
    let difference = upper - lower;
    return difference;
  } else {
    return 0_u64;
  }
}

fn main() -> status: ExitStatus pure {
  let result = distance(upper: 9_u64, lower: 4_u64);
  if result == 5_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
