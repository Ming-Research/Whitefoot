fn overwrite(number: &u64) -> result: unit writes(number) {
  set number^ = 3_u64;
  return unit;
}

fn update(entries: &Entries<Slots<u8, 4>>) -> result: unit writes(entries) {
  for (index in 0_u64..entries^.len) {
    let entry_ref = &entries^[index];
    match entry_ref^ {
      Some(value: window) => {
        overwrite(number: &window^.len);
      }
      None() => {
      }
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
