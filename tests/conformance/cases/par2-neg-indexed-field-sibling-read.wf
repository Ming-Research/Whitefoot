struct Row {
  tag: u8;
  count: u64;
  enabled: Bool;
}

fn reduce() -> result: u64 pure {
  doc "Reading another field of the root remains outside the binding-wide occurrence rule.";
  let disabled = False();
  let seed = Row(tag: 93_u8, count: 7_u64, enabled: disabled);
  let rows = array_filled::<Row, 4>(value: seed);
  for (i in 0_u64..4_u64) {
    let seen = rows[0_u64].tag;
    set rows[0_u64].count = rows[0_u64].count +wrap 1_u64;
  }
  return rows[0_u64].count;
}

fn main() -> status: std::process::ExitStatus pure {
  let result = reduce();
  return std::process::exit_status(code: 0_u8);
}
