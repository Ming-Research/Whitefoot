alias DirectoryRead = std::fs::DirectoryRead;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias close_directory = std::fs::close_directory;
alias close_directory_source = std::fs::close_directory_source;
alias exit_status = std::process::exit_status;
alias open_directory_source = std::fs::open_directory_source;

fn open_two(factory: &HandleFactory, directory: &DirectoryRead) -> result: unit reads(directory), writes(factory) {
  doc "PRE-2 opens pass the same HandleFactory reference twice in sequence and share one DirectoryRead reference; each resulting linear source is explicitly closed. Read/read overlap on the directory is admitted and the two writes of the factory are in different statements.";
  let first = open_directory_source(factory: factory, directory: directory);
  let second = open_directory_source(factory: factory, directory: directory);
  match first {
    Ok(value: source) => {
      close_directory_source(factory: factory, source: move source);
    }
    Err(error: problem) => {
    }
  }
  match second {
    Ok(value: source) => {
      close_directory_source(factory: factory, source: move source);
    }
    Err(error: problem) => {
    }
  }
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure {
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: factory, stdin: input) = move inputs;
  open_two(factory: &factory, directory: &cwd);
  close_directory(factory: &factory, directory: move cwd);
  return exit_status(code: 0_u8);
}
