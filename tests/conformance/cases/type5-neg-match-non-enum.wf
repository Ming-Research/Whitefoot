alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn inspect(value: i32) -> function_result: unit pure {
  doc "TYPE-5: a match scrutinee must have an enum type; globally known arm names cannot type a scalar match.";
