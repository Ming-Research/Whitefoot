alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn identity(n: u64) -> result: u64 pure {
  doc "Hands its argument back with no declared relation.";
  return n;
}

fn get(b: &[u8]) -> result: u8 reads(b) {
  doc "No fact crosses a call boundary [ENT-2]. The checked branch bounds probe, but the value returned by identity is a fresh term carrying no relation to it, so the subscript is undischarged [OP-4] and the residual names the returned binding.";
  let spare = deref(b).len;
  let probe = 0_u64;
  let inside = probe < spare;
  if inside {
  } else {
    return 0_u8;
  }
  let echoed = identity(n: probe);
  return deref(b)[echoed];
}

fn main() -> status: ExitStatus pure {
  doc "No construction is needed to exercise the call boundary.";
  return exit_status(code: 0_u8);
}
