alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn write_slot(window: &Slots<u64, 4>, index: u64) -> result: unit writes(window[index]) contract {
  requires index < deref(window).len;
} {
  doc "Writes element index of the window through a reference formed before a loop that writes index.";
  let e = &deref(window)[index];
  let n = 0_u64;
  loop {
    set deref(e) = 9_u64;
    if 2_u64 <= n {
      break;
    }
    set n = n +wrap 1_u64;
    set index = 0_u64;
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "EFF-1, REF-1: the loop form of eff1-pos-reference-index-read-before-index-parameter-write. e captured the call value of index before the loop, so every iteration's write through e is the row's window[index], though the loop writes index.";
  let r = slots_new::<u64, 4>();
  place_back(window: &r, value: 1_u64);
  place_back(window: &r, value: 2_u64);
  let p = &r[0_u64];
  write_slot(window: &r, index: 1_u64);
  let seen = deref(p);
  if seen == 1_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
