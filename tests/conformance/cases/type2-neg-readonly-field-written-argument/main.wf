alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias packets = pkg::packets;

fn main() -> status: ExitStatus pure {
  doc "TYPE-2: outside its declaring module an argument naming a readonly field at a reference parameter whose callee row writes that parameter is refused; swap writes both of its parameters.";
  let p = packets::make(id: 7_u64, size: 1_u64);
  let other = 8_u64;
  swap(first: &p.id, second: &other);
  return exit_status(code: 0_u8);
}
