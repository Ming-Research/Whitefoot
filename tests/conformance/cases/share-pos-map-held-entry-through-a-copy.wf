const key: Array<u8, 1> =[107_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let map = shared_map_new::<u8>(capacity: 0_u64);
  let code = 0_u8;
  atomic state = &map {
    let same = state;
    atomic slot = &same^[&key[0_u64..1_u64]] {
      set slot^ = Some<u8>(value: 6_u8);
    }
  }
  atomic slot = &map[&key[0_u64..1_u64]] {
    match slot^ {
      Some(value: seen) => {
        set code = seen^;
      }
      None() => {
      }
    }
  }
  return std::process::exit_status(code: code);
}
