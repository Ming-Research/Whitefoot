const names: Array<u8, 1> =[97_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let store = shared_map_new::<u8>(capacity: 0_u64);
  let name = &names[0_u64..1_u64];
  atomic slot = &store[name] {
    let same = slot;
    set same^ = Some<u8>(value: 6_u8);
  }
  let seen = 0_u8;
  atomic slot = &store[name] {
    match slot^ {
      Some(value: held) => {
        set seen = held^;
      }
      None() => {
      }
    }
  }
  return std::process::exit_status(code: seen);
}
