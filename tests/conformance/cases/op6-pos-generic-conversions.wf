alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn convert<S: Int, D: Int>(value: S) -> result: D pure contract {
  requires cvt.defined::<S, D>(value);
} {
  return cvt::<S, D>(value);
}

fn forwarded<S: Int, D: Int>(value: S) -> result: D pure contract {
  requires cvt.defined::<S, D>(value);
} {
  return convert::<S, D>(value: value);
}

fn attempt<S: Int, D: Float>(value: S) -> result: Result<D, NarrowError> pure {
  return cvt.checked::<S, D>(value);
}

fn same<T: Float>(value: T) -> result: T pure contract {
  define copied = cvt::<T, T>(value);
  requires cvt.defined::<T, T>(copied);
} {
  return cvt::<T, T>(value);
}

fn zero<T: Float, D: Int>() -> result: D pure {
  return cvt::<T, D>(0_T);
}

fn one<T: Int, D: Float>() -> result: D pure {
  return cvt::<T, D>(1_T);
}

fn small_integer<D: Int>() -> result: D pure {
  return cvt::<u32, D>(1_u32);
}

fn wrap_pair<S: Int, D: Int>(value: S) -> result: D pure {
  return cvt.wrap::<S, D>(value);
}

fn all_integer_destinations<S: Int>(value: S) -> result: unit pure {
  let signed_byte = wrap_pair::<S, i8>(value: value);
  let signed_half = wrap_pair::<S, i16>(value: value);
  let signed_word = wrap_pair::<S, i32>(value: value);
  let signed_double = wrap_pair::<S, i64>(value: value);
  let unsigned_byte = wrap_pair::<S, u8>(value: value);
  let unsigned_half = wrap_pair::<S, u16>(value: value);
  let unsigned_word = wrap_pair::<S, u32>(value: value);
  let unsigned_double = wrap_pair::<S, u64>(value: value);
  return unit;
}

interface Wrapped {
  fn all_bits(value: i8) -> result: u32 pure contract {
    define residue = cvt.wrap::<i8, u32>(value);
    requires residue == 4294967295_u32;
  };
}

fn signed_bits(value: i8) -> result: u32 pure contract {
  define residue = cvt.wrap::<i8, u32>(value);
  requires residue == 4294967295_u32;
} {
  return cvt.wrap::<i8, u32>(value);
}

binding AllBits : Wrapped {
  all_bits = signed_bits;
}

fn wrap_contract_forward<interface Wrapped>(value: i8) -> result: u32 pure contract {
  define residue = cvt.wrap::<i8, u32>(value);
  requires residue == 4294967295_u32;
} {
  return Wrapped::all_bits(value: value);
}

fn main() -> status: ExitStatus pure {
  doc "Symbolic Int and Float endpoints keep exact interface result types. Nested generic requirements specialize normally, and repeated symbolic endpoints are universally total even inside a contract definition.";
  let byte = forwarded::<u32, u8>(value: 7_u32);
  let same_byte = forwarded::<u8, u8>(value: byte);
  if same_byte != 7_u8 {
    return exit_status(code: 1_u8);
  }
  match attempt::<u8, f32>(value: 7_u8) {
    Ok(value: converted) => {
      let copied = same::<f32>(value: converted);
      if fne(copied, 7.0_f32) {
        return exit_status(code: 2_u8);
      }
    }
    Err(error: refused) => {
      return exit_status(code: 3_u8);
    }
  }
  match attempt::<u32, f32>(value: 16777217_u32) {
    Ok(value: converted) => {
      return exit_status(code: 4_u8);
    }
    Err(error: refused) => {
    }
  }
  let zero_value = zero::<f64, i64>();
  let one_value = one::<i64, f32>();
  let small_value = small_integer::<i8>();
  if zero_value != 0_i64 {
    return exit_status(code: 5_u8);
  }
  if fne(one_value, 1.0_f32) {
    return exit_status(code: 6_u8);
  }
  if small_value != 1_i8 {
    return exit_status(code: 7_u8);
  }
  all_integer_destinations::<i8>(value: -1_i8);
  all_integer_destinations::<i16>(value: -1_i16);
  all_integer_destinations::<i32>(value: -1_i32);
  all_integer_destinations::<i64>(value: -1_i64);
  all_integer_destinations::<u8>(value: 255_u8);
  all_integer_destinations::<u16>(value: 65535_u16);
  all_integer_destinations::<u32>(value: 4294967295_u32);
  all_integer_destinations::<u64>(value: 18446744073709551615_u64);
  let widened_negative = wrap_pair::<i8, u32>(value: -1_i8);
  if widened_negative != 4294967295_u32 {
    return exit_status(code: 8_u8);
  }
  let resigned = wrap_pair::<u32, i32>(value: 4294967295_u32);
  if resigned != -1_i32 {
    return exit_status(code: 9_u8);
  }
  let narrowed = wrap_pair::<i32, u8>(value: -257_i32);
  if narrowed != 255_u8 {
    return exit_status(code: 10_u8);
  }
  let identity = wrap_pair::<i64, i64>(value: -9223372036854775808_i64);
  if identity != -9223372036854775808_i64 {
    return exit_status(code: 11_u8);
  }
  let widened_positive = wrap_pair::<u8, i64>(value: 255_u8);
  if widened_positive != 255_i64 {
    return exit_status(code: 12_u8);
  }
  let residue = cvt.wrap::<i8, u32>(-1_i8);
  if residue == 4294967295_u32 {
    let selected = wrap_contract_forward::<AllBits>(value: -1_i8);
    if selected != 4294967295_u32 {
      return exit_status(code: 13_u8);
    }
  } else {
    return exit_status(code: 14_u8);
  }
  return exit_status(code: 0_u8);
}
