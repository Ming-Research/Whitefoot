alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "OP-11: swap exchanges the values at two owned places of one type, consuming neither root and leaving each root the sole owner of the value the other held, so the exchange the retired multi-target commit spelled is one built-in call. A swap over a copy place is refused with the restructuring that reads the two values and assigns them back, which is what the copy pair does here; the exit code reports that exchange, and three affine windows are rotated by two swaps, each value moved by neither and released exactly once.";
  let low = 3_u8;
  let high = 5_u8;
  let spare = low;
  set low = high;
  set high = spare;
  let first_values = array_filled::<u8, 3>(value: 1_u8);
  let first = slots_from_array::<u8, 3>(values: first_values);
  let second_values = array_filled::<u8, 3>(value: 2_u8);
  let second = slots_from_array::<u8, 3>(values: second_values);
  let third_values = array_filled::<u8, 3>(value: 3_u8);
  let third = slots_from_array::<u8, 3>(values: third_values);
  swap(first: &first, second: &second);
  swap(first: &second, second: &third);
  return exit_status(code: low);
}
