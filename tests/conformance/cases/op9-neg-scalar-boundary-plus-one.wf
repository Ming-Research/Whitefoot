alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn scalar_overflow(count: u64) -> made: Box<Slots<u64>> pure contract {
  requires count <= 2305843009213693952_u64;
} {
  doc "A scalar's stride ceiling is eight. The permitted count includes floor((2^64 - 1) / 8) + 1, so the allocation obligation is unproved [OP-9].";
  let taken = box_slots_new::<u64>(capacity: count);
  return move taken;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
