fn invalid(cell: &Array<u64, 1>) -> result: unit writes(cell) {
  for (
    j in 0_u64..1_u64,
    invariant forall preserved(k in 0_u64..cell^.len): cell^[k] unchanged
  ) {
    set cell^[j] = 9_u64;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
