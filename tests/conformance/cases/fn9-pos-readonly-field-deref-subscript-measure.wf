fn selected_length(table: &[Slots<u8, 8>], r: &u64) -> result: u64 reads(table), reads(r) contract {
  requires r^ < table^.len;
  ensures result == table^[r^].len;
} {
  doc "FN-9 and ENT-2: a dereferenced integer formal selects the same readonly measure in the body and its postcondition, even though its relative projection below the referent is empty.";
  return table^[r^].len;
}

fn from_contract(cursor: &u64, i: u64, rows: &[Slots<u8, 8>]) -> result: u8 reads(rows), reads(cursor) contract {
  requires cursor^ < rows^.len;
} {
  doc "CALL-6: the returned measure equality substitutes a dereferenced selector with the same identity as the caller's nested read, so a guard on the result supplies its bound.";
  let size = selected_length(table: rows, r: cursor);
  if i < size {
    return rows^[cursor^][i];
  }
  return 0_u8;
}

fn from_owned(i: u64, rows: &[Slots<u8, 8>], cursor: u64) -> result: u8 reads(rows) contract {
  requires cursor < rows^.len;
} {
  doc "The same dereference-formal postcondition substitutes an explicit borrow of an owned integer; its selector is identical to the caller's bare integer place.";
  let size = selected_length(table: rows, r: &cursor);
  if i < size {
    return rows^[cursor][i];
  }
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The postcondition and both ordinary callers are checked without executing them.";
  return std::process::exit_status(code: 0_u8);
}
