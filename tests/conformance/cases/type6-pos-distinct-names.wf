alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "Distinct value names and a break to a lexically enclosing loop [TYPE-6].";
  let i = 0_i32;
  let total = 0_i32;
  loop @l {
    if i >= 3_i32 {
      break @l;
    }
    set total = total +wrap i;
    set i = i +wrap 1_i32;
  }
  if total == 3_i32 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
