alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn apply(input: &Pair) -> result: unit reads(input.left), writes(input.right) {
  doc "A private interface group is module implementation, so its formals may name the module's private fields.";
  let observed = deref(input).left;
  set deref(input).right = observed;
  return unit;
}

binding PairTouch : Touch {
  touch = apply;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
