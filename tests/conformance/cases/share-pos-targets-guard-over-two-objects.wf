fn both(left: &u8, right: &u8) -> result: Bool reads(left), reads(right) {
  if left^ == 0_u8 {
    return False();
  }
  return right^ != 0_u8;
}

fn produce(first: Shared<u8>, second: Shared<u8>) -> result: unit pure waits {
  atomic a = &first {
    set a^ = 4_u8;
  }
  atomic b = &second {
    set b^ = 5_u8;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let first = shared_new::<u8>(value: 0_u8);
  let second = shared_new::<u8>(value: 0_u8);
  let one = shared_share::<u8>(shared: &first);
  let two = shared_share::<u8>(shared: &second);
  spawn produce(first: move one, second: move two);
  let seen = 0_u8;
  atomic a = &first, b = &second when both(left: a, right: b) {
    set seen = a^ +wrap b^;
  }
  return std::process::exit_status(code: seen);
}
