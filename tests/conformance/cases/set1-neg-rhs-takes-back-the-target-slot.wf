alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "SET-1, OP-4: the right-hand side runs first. take_back lowers r.len to 1, so the target r[1_u64], evaluated after it, is out of bounds and its subscript is refused. Evaluating the target first, as before, wrote a slot the window no longer fills.";
  let r = slots_new::<u64, 4>();
  place_back(window: &r, value: 1_u64);
  place_back(window: &r, value: 2_u64);
  set r[1_u64] = take_back(window: &r);
  return exit_status(code: 0_u8);
}
