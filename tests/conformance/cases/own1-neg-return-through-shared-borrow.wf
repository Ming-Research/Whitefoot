alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Pair {
  left: i32;
  right: i32;
}

fn steal(holder: &Pair) -> return_value: Pair reads(holder) {
  doc "A return cannot move an owned struct out of the path a reference names; the place is not rooted in a live own-mode binding of this function.";
  return move deref(holder);
}

fn main() -> return_value: ExitStatus pure {
  return exit_status(code: 0_u8);
}
