alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn preserve_pair_bounds(first: u64, first_limit: u64, second: u64, second_limit: u64) -> result: unit pure contract {
  requires first <= first_limit;
  requires second <= second_limit;
} {
  let left = 0_u64;
  let left_limit = 0_u64;
  let right = 0_u64;
  let right_limit = 0_u64;
  for (
    i in 0_u64..2_u64,
    invariant combined: left + right <= left_limit + right_limit
  ) {
    set left = first;
    set left_limit = first_limit;
    set right = second;
    set right_limit = second_limit;
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  let finished = preserve_pair_bounds(first: 3_u64, first_limit: 5_u64, second: 7_u64, second_limit: 9_u64);
  return exit_status(code: 0_u8);
}
