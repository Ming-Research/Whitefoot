alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn first(segments: &Box<Segments<u64>>) -> value: u64 reads(segments) contract {
  requires segments^.inner.len > 0_u64;
} {
  doc "A segment selector names a run place and cannot initialize a value binding.";
  let value = segments^.inner[0_u64];
  return value;
}

fn main() -> status: ExitStatus pure {
  doc "The run binding above is refused by OP-4.";
  return exit_status(code: 0_u8);
}
