struct Inner {
  stamp: u64;
}

struct Composite {
  nested: Inner;
  values: Array<u64, 4>;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The source's stamp after the bound copy is mutated, the second destructuring's stamp, the mutated copy's stamp and the mutated element's distance from the value stored, 7, 7, 13 and 0, sum to the exit status 27.";
  let seed = Inner(stamp: 7_u64);
  let initial = array_filled::<u64, 4>(value: 11_u64);
  let original = Composite(nested: seed, values: initial);
  let Composite(nested: copied, values: elements) = original;
  set copied.stamp = 13_u64;
  set elements[0_u64] = 17_u64;
  let source_stamp = original.nested.stamp;
  if original.values[0_u64] != 11_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  let Composite(nested: again, values: retained) = original;
  if retained[0_u64] != 11_u64 {
    return std::process::exit_status(code: 4_u8);
  }
  let patched = elements[0_u64];
  let drift = patched - 17_u64;
  let stamps = source_stamp +wrap again.stamp;
  let total = stamps +wrap copied.stamp;
  let observed = total +wrap drift;
  let code = cvt.wrap::<u64, u8>(observed);
  return std::process::exit_status(code: code);
}
