enum Mode {
  Fast();
  Slow();
}

struct Holder {
  mode: Mode;
}

fn positive(cells: &[u64]) -> result: u64 reads(cells) contract {
  requires forall pos(k in 0_u64..cells^.len): cells^[k] > 0_u64;
} {
  doc "Returns the first cell.";
  if 0_u64 < cells^.len {
    let first = cells^[0_u64];
    return first;
  }
  return 0_u64;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The field holds Fast where the loop begins, and the loop writes it: a later iteration takes the Slow arm, whose call the zero-filled cells do not satisfy.";
  let cells = box_array_filled::<u64>(count: 4_u64, value: 0_u64);
  let initial = Mode::Fast();
  let h = Holder(mode: initial);
  set h.mode = Mode::Fast();
  for (i in 0_u64..4_u64) {
    match h.mode {
      Fast() => {
        set h.mode = Mode::Slow();
      }
      Slow() => {
        let got = positive(cells: &cells.inner[0_u64..4_u64]);
      }
    }
  }
  return std::process::exit_status(code: 0_u8);
}
