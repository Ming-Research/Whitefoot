alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "The body writes a[1] on a path back to the head; at the head two index steps of a overlap whatever their offsets, so the fact a[2] == 0 does not reach the head and small[a[2]] is undischarged.";
  let a = array_filled::<u64, 4>(value: 0_u64);
  let small = array_filled::<u8, 2>(value: 1_u8);
  set a[2_u64] = 0_u64;
  let i = 0_u64;
  loop @l {
    let seen = small[a[2_u64]];
    set a[1_u64] = 100_u64;
    set i = i +wrap 1_u64;
    if i < 4_u64 {
    } else {
      break @l;
    }
  }
  return exit_status(code: 0_u8);
}
