alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn shifted(count: u64) -> total: u64 pure contract {
  ensures total == count;
} {
  doc "Writes the parameter back and then relates the result to it.";
  set count = 1_u64;
  return count;
}

fn main() -> status: ExitStatus pure {
  doc "MSR-3: the entry placement mints a datum per measure of a measured parameter and for nothing else, so a fragment parameter written back in the body still loses its entry image and the clause naming it is unproved. A value of fragment type is not a measured value and has no measure to carry.";
  let value = shifted(count: 0_u64);
  if value == 1_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
