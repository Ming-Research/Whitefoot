alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn admit(flag: Bool) -> result: unit pure contract {
  requires flag;
} {
  return unit;
}

fn main() -> return_value: ExitStatus pure {
  doc "PRE-1: prelude enums are usable with no declaration in the unit -- Bool (True/False) from a compare, Result (Ok/Err) from checked arithmetic. The checked sum is the exit status 7.";
  let r = match 3_i32 +checked 4_i32 {
    Ok(value: w) => {
      give w;
    }
    Err(error: e) => {
      return exit_status(code: 1_u8);
    }
  }
  let small = r < 100_i32;
  let admitted = admit(flag: small);
  let code = cvt::<i32, u8>(r);
  return exit_status(code: code);
}
