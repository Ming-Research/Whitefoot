alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> return_value: ExitStatus pure {
  doc "PRE-1: prelude enums are usable with no declaration in the unit -- Bool (True/False) from a compare, Result (Ok/Err) from checked arithmetic.";
  let r = match 3_i32 +checked 4_i32 {
    Ok(value: w) => {
      give w;
    }
    Err(error: e) => {
      return exit_status(code: 1_u8);
    }
  }
  if r < 100_i32 {
    if r == 7_i32 {
    } else {
      return exit_status(code: 2_u8);
    }
  } else {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
