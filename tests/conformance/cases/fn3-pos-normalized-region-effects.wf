alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Cell {
  value: u64;
}

interface BorrowedSum {
  fn sum(x: &Cell, y: &Cell) -> result: u64 reads(x.value), reads(y.value);
}

binding First : BorrowedSum {
  sum = add_borrowed;
}

fn add_borrowed(first: &Cell, second: &Cell) -> total: u64 reads(first.value), reads(second.value) {
  doc "FN-3 and EFF-1: formal and actual rows compare by parameter ordinal and path, never by binder spelling, so renaming both inputs preserves the boundary. The entries themselves stay in canonical order, every `reads` before every `writes` and each in written argument order.";
  return deref(first).value +wrap deref(second).value;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
