alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn count(segments: Segments<u64>) -> result: u64 pure {
  doc "A Segments<T> has no constant-capacity form and is placed only as the content of a Box, so a parameter of that type is refused at its type.";
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  doc "The parameter type above is refused by TYPE-9.";
  return exit_status(code: 0_u8);
}
