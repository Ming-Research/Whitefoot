fn selected(value: u64) -> result: unit pure {
  match value {
    4_u64 => {
      return unit;
    }
    else => {
      if value <= 4_u64 {
        invariant tightened: value <= 3_u64;
      }
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
