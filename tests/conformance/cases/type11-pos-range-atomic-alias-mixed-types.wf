struct ZeroesAliasMixedTypes {
  cells: Array<u64, 1>;
  invariant(c): forall zero(k in 0_u64..c^.cells.len): c^.cells[k] == 0_u64;
}

struct ZeroesAliasDifferentType {
  cells: Array<u64, 1>;
  invariant(c): forall zero(k in 0_u64..c^.cells.len): c^.cells[k] == 0_u64;
}

fn need_alias_different_type(z: &ZeroesAliasDifferentType) -> result: unit pure {
  return unit;
}

fn need_aliasmixedtypes(z: &ZeroesAliasMixedTypes) -> result: unit pure {
  return unit;
}

fn update_aliasmixedtypes(first: Shared<ZeroesAliasMixedTypes>, second: SharedRead<ZeroesAliasMixedTypes>, other: Shared<ZeroesAliasDifferentType>) -> result: unit pure waits {
  atomic a = &first, b = &second, c = &other {
    set a^.cells[0_u64] = 1_u64;
    need_alias_different_type(z: c);
    set a^.cells[0_u64] = 0_u64;
    need_aliasmixedtypes(z: b);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
