struct Decimal {
  count: u64;
  digits: Array<u8, 1>;
}

fn clear(decimal: &Decimal) -> result: unit writes(decimal) contract {
  requires 0_u64 < decimal^.count;
  ensures forall leading(k in 0_u64..1_u64) when 0_u64 < decimal^.count: 1_u8 <= decimal^.digits[k];
} {
  doc "The guard reads the exit count: clearing it makes the leading-digit conclusion vacuous even though the entry count was positive.";
  set decimal^.digits[0_u64] = 0_u8;
  set decimal^.count = 0_u64;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
