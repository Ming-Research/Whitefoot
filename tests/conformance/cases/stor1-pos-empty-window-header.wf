alias MemoryMeter = std::process::MemoryMeter;

fn hold(meter: &MemoryMeter, before: u64) -> result: u8 writes(meter) {
  doc "STOR-1: while capacity-0 Array, Slots and Ring boxes are live the heap reading equals the baseline; growing the Slots cell allocates its content and keeps the placed element.";
  let slots = box_slots_new::<u64>(capacity: 0_u64);
  let ring = box_ring_new::<u64>(capacity: 0_u64);
  let array = box_array_filled::<u64>(count: 0_u64, value: 7_u64);
  let empty = std::process::heap_in_use(meter: meter);
  if empty != before {
    return 1_u8;
  }
  if slots.inner.cap != 0_u64 {
    return 2_u8;
  }
  if ring.inner.head != 0_u64 {
    return 3_u8;
  }
  if array.inner.len != 0_u64 {
    return 4_u8;
  }
  grow(cell: &slots, capacity: 4_u64);
  place_back(window: &slots.inner, value: 9_u64);
  let grown = std::process::heap_in_use(meter: meter);
  if grown <= before {
    return 5_u8;
  }
  if slots.inner[0_u64] != 9_u64 {
    return 6_u8;
  }
  return 0_u8;
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  doc "STOR-1, STOR-3: after every box in hold is released the heap reading is back at the baseline, so releasing the shared empty headers freed and uncounted nothing.";
  let std::process::Inputs(cwd: directory, handles: factory, memory_meter: meter, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let before = std::process::heap_in_use(meter: &meter);
  let code = hold(meter: &meter, before: before);
  if code != 0_u8 {
    return std::process::exit_status(code: code);
  }
  let after = std::process::heap_in_use(meter: &meter);
  if after != before {
    return std::process::exit_status(code: 7_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
