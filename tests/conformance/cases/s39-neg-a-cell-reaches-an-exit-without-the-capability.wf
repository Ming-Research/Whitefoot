alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nodrop struct Ticket {
  code: u8;
}

fn peek(cell: Box<Ticket>) -> code: u8 pure {
  doc "A Box whose content is linear is itself linear, closed under ownership, so this binding may not reach the return edge by a compiler-derived release; the compiler never releases a linear value.";
  return 0_u8;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
