alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Sign {
  Neg();
  Zero();
  Pos();
}

fn main() -> return_value: ExitStatus pure {
  doc "GRAM-4: let, loop, break, set, statement match, if, the let-initializer match with give, and return. The `region` statement is gone, so the block structure is the ordinary lexical one.";
  let i = 0_i32;
  loop @l {
    if i >= 3_i32 {
      break @l;
    }
    set i = i +wrap 1_i32;
  }
  let s = Sign::Zero();
  match s {
    Neg() => {
    }
    Zero() => {
    }
    Pos() => {
    }
  }
  let d = if i == 3_i32 {
    give 7_i32;
  } else {
    give 0_i32;
  }
  if d == 7_i32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
