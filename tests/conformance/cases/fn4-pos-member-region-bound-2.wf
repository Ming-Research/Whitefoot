alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

interface Inspect<T> {
  fn length(values: &T) -> result: u64 reads(values);
}

fn shorter(values: &Array<u64, 4>) -> result: u64 reads(values) {
  doc "Parameter mode and exact type agree with the instantiated member, so the binding is admitted before any call exists.";
  return deref(values)[0_u64];
}

binding Narrow : Inspect<Array<u64, 4>> {
  length = shorter;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
