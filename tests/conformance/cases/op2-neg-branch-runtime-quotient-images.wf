alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn branch_part(count: u64, divisor: u64, choose_left: Bool) -> result: u64 pure contract {
  requires 1_u64 <= divisor;
} {
  let quotient = if choose_left {
    let left = count / divisor;
    give left;
  } else {
    let right = count / divisor;
    give right;
  }
  let whole = quotient * divisor;
  return whole;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
