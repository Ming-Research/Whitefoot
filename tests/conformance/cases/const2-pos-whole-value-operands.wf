alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Parcel {
  bytes: Array<u8, 5>;
}

const pattern: Array<u8, 5> = "abcde";
const expected_parcel: Parcel = Parcel(bytes: "abcde");

fn returned() -> result: Array<u8, 5> pure {
  return pattern;
}

fn selected(flag: Bool) -> result: Parcel pure {
  let choice = if flag {
    give expected_parcel;
  } else {
    give expected_parcel;
  }
  return choice;
}

fn main() -> status: ExitStatus pure {
  let direct = returned();
  let parcel = Parcel(bytes: pattern);
  let flag = True();
  let chosen = selected(flag: flag);
  if direct != pattern {
    return exit_status(code: 1_u8);
  }
  if parcel != expected_parcel {
    return exit_status(code: 2_u8);
  }
  set chosen.bytes[0_u64] = 'Z'_u8;
  if chosen == expected_parcel {
    return exit_status(code: 3_u8);
  }
  if expected_parcel.bytes[0_u64] != 'a'_u8 {
    return exit_status(code: 4_u8);
  }
  return exit_status(code: 0_u8);
}
