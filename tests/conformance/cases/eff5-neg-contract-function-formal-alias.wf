struct Pair {
  marker: u64;
  value: u64;
}

fn apply<fn op(frame: &Pair, other: &Pair) -> result: unit writes(frame.marker), writes(other.value) contract {
  requires frame^.value == 0_u64;
  ensures frame^.value == 0_u64;
}>(f: &Pair) -> result: unit writes(f) contract {
  requires f^.value == 0_u64;
} {
  doc "EFF-5, FN-2: the function formal supplies its own contract read before any actual function is selected.";
  op(frame: f, other: f);
  return unit;
}
