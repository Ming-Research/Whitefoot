alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn write_slot(window: &Slots<u64, 4>, index: u64) -> result: unit writes(window[index]) contract {
  requires index < deref(window).len;
} {
  doc "Writes element 0 of the window: the write of index before the access leaves deref(window)[index] a place other than the row's window[index].";
  set index = 0_u64;
  set deref(window)[index] = 9_u64;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "EFF-1, EFF-2, SET-1: a row evaluates its index parameter once, at the call, so writes(window[index]) names element 1 here. After set index = 0_u64 the body's deref(window)[index] is element 0, whose nearest nameable path is window, and the row does not declare that write, so the set is refused. The v0.74 checker attributed the access to window[index] by the parameter's spelling, and the caller then read the changed r[0] through p.";
  let r = slots_new::<u64, 4>();
  place_back(window: &r, value: 1_u64);
  place_back(window: &r, value: 2_u64);
  let p = &r[0_u64];
  write_slot(window: &r, index: 1_u64);
  let seen = deref(p);
  if seen == 1_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
