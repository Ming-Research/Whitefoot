struct ZeroesAliasConditionalBad {
  cells: Array<u64, 1>;
  invariant(c): forall zero(k in 0_u64..c^.cells.len): c^.cells[k] == 0_u64;
}

fn need_aliasconditionalbad(z: &ZeroesAliasConditionalBad) -> result: unit pure {
  return unit;
}

fn update_aliasconditionalbad(first: Shared<ZeroesAliasConditionalBad>, second: Shared<ZeroesAliasConditionalBad>, flag: Bool) -> result: unit pure waits {
  atomic a = &first, b = &second {
    if flag {
      set a^.cells[0_u64] = 1_u64;
      need_aliasconditionalbad(z: b);
      set a^.cells[0_u64] = 0_u64;
    } else {
      need_aliasconditionalbad(z: a);
      need_aliasconditionalbad(z: b);
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
