fn fill(value: &Frozen<u8>, out: &Array<u8, 1>) -> result: unit reads(value), writes(out) contract {
  ensures forall filled(k in 0_u64..out^.len): out^[k] == value^.inner;
} {
  set out^[0_u64] = value^.inner;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let held = frozen_new::<u8>(value: 7_u8);
  let output = array_filled::<u8, 1>(value: 0_u8);
  fill(value: &held, out: &output);
  let byte = output[0_u64];
  return std::process::exit_status(code: byte);
}
