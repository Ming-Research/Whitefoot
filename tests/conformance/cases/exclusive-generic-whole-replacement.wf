alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Pair {
  left: u64;
  right: u64;
}

fn exchange<T: drop>(target: &T, incoming: &T) -> result: unit writes(target), writes(incoming) {
  doc "Whole exchange through two bare reference parameters: swap leaves both roots live and each root the sole owner of the value the other held [OP-11].";
  swap(first: target, second: incoming);
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "The same generic exchange at a struct instantiation and at a run instantiation; the exchange installs each incoming value and leaves the displaced one at the other place, and the run's length facts do not survive it [ENT-5].";
  let held = Pair(left: 3_u64, right: 4_u64);
  let other = Pair(left: 9_u64, right: 10_u64);
  let values = slots_new::<u64, 2>();
  let fresh = slots_new::<u64, 2>();
  place_back(window: &values, value: 7_u64);
  exchange::<Pair>(target: &held, incoming: &other);
  exchange::<Slots<u64, 2>>(target: &values, incoming: &fresh);
  let now = values.len;
  let before = fresh.len;
  if held.left != 9_u64 {
    return exit_status(code: 1_u8);
  }
  if other.left != 3_u64 {
    return exit_status(code: 2_u8);
  }
  if now != 0_u64 {
    return exit_status(code: 3_u8);
  }
  if before != 1_u64 {
    return exit_status(code: 4_u8);
  }
  return exit_status(code: 0_u8);
}
