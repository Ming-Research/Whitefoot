alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Held {
  v: i32;
}

fn pick<T: drop>(value: T) -> result: T pure {
  doc "A generic fn declaring one type parameter [FN-2].";
  return move value;
}

fn main() -> status: ExitStatus pure {
  doc "The call states no instantiation argument; instantiation arguments are always explicit [FN-2].";
  let a = Held(v: 1_i32);
  let b = pick(value: a);
  return exit_status(code: 0_u8);
}
