struct Holder {
  inner: Shared<ConcurrentHashMap<u8>>;
}

const names: Array<u8, 1> =[97_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let map = shared_map_new::<u8>(capacity: 1_u64);
  let holder = Holder(inner: move map);
  let outer = shared_new::<Holder>(value: move holder);
  let key = &names[0_u64..1_u64];
  atomic h = &outer, e = &h^.inner[key] {
    set e^ = Some<u8>(value: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
