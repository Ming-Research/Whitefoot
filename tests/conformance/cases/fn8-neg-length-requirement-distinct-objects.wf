alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn get_bounded(b: &[u8], i: u64) -> value: u8 reads(b) contract {
  define spare = deref(b).len;
  requires i < spare;
} {
  return deref(b)[i];
}

fn main() -> status: ExitStatus pure {
  doc "A first call proves index seven is within an eight-element range reference. The same callee and index over a separate four-element range reference must be rejected; goal identity cannot reuse the first object's measure.";
  let wide = array_filled::<u8, 8>(value: 1_u8);
  let narrow = array_filled::<u8, 4>(value: 2_u8);
  let wp = &wide[0_u64..8_u64];
  let first = get_bounded(b: wp, i: 7_u64);
  if first == 1_u8 {
  } else {
    return exit_status(code: 201_u8);
  }
  let np = &narrow[0_u64..4_u64];
  let second = get_bounded(b: np, i: 7_u64);
  if second == 2_u8 {
  } else {
    return exit_status(code: 202_u8);
  }
  return exit_status(code: 0_u8);
}
