alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum State {
  Ready();
  Done();
}

fn main() -> status: ExitStatus pure {
  doc "Matching through a reference is the canonical borrowed match [OWN-13], but a reference variable denotes the reference [REF-1] and its referent is reached only through deref, so the bare reference scrutinee is the missing dereference [TYPE-7]; the fix is match deref(holder).";
  let state = State::Ready();
  let holder = &state;
  match holder {
    Ready() => {
    }
    Done() => {
    }
  }
  return exit_status(code: 0_u8);
}
