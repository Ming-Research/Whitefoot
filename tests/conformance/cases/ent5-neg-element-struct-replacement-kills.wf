struct Cell {
  digits: Array<u8, 2>;
  marker: u8;
}

fn probe(cell: &Cell) -> result: u8 writes(cell) contract {
  requires 1_u8 <= cell^.digits[0_u64];
} {
  let fresh = array_filled::<u8, 2>(value: 0_u8);
  set cell^ = Cell(digits: fresh, marker: 0_u8);
  return cell^.digits[0_u64] - 1_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
