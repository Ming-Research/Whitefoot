const key: Array<u8, 1> =[107_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let first = shared_map_new::<u8>(capacity: 0_u64);
  let second = shared_map_new::<u8>(capacity: 0_u64);
  atomic state = &first {
    atomic slot = &second[&key[0_u64..1_u64]] {
      set slot^ = Some<u8>(value: 1_u8);
    }
  }
  return std::process::exit_status(code: 0_u8);
}
