alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn get(b: &[u8], stop: Bool, done: Bool) -> result: u8 reads(b) {
  doc "An ordinary branch establishes the zero offset's bound before the loop. A return edge inside the loop cannot reach a later iteration head, so its scope-exit kills do not remove that real pre-loop fact [ENT-5], and the head subscript discharges [OP-4].";
  let spare = b^.len;
  let offset = 0_u64;
  let inside = offset < spare;
  if inside {
    let sample = 0_u8;
    let fuel = 64_u64;
    loop @walk (
      decreases fuel
    ) {
      set sample = b^[offset];
      if stop {
        return sample;
      }
      if done {
        break @walk;
      }
      if fuel == 0_u64 {
        break @walk;
      }
      set fuel = fuel -wrap 1_u64;
    }
    return sample;
  } else {
    return 0_u8;
  }
}

fn main() -> status: ExitStatus pure {
  doc "No construction is needed to exercise the loop head state.";
  return exit_status(code: 0_u8);
}
