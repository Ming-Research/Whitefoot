fn main() -> status: std::process::ExitStatus pure {
  doc "OP-10, REF-2: a page reference formed before clear names an initialized extent that clear ends, so reading it afterwards is refused even after the page is refilled.";
  let p = box_paged_new::<u64>(capacity: 1_u64);
  place_back(window: &p.inner, value: 3_u64);
  if p.inner.pages.len > 0_u64 {
    let page = &p.inner.pages[0_u64];
    clear(window: &p.inner);
    place_back(window: &p.inner, value: 4_u64);
    let count = page^.len;
  }
  return std::process::exit_status(code: 0_u8);
}
