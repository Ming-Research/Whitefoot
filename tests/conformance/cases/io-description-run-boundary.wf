alias IoError = std::io::IoError;
alias error_copy_description = std::io::error_copy_description;

const cancelled_text: Array<u8, 9> =[67_u8, 97_u8, 110_u8, 99_u8, 101_u8, 108_u8, 108_u8, 101_u8, 100_u8];

fn main() -> status: std::process::ExitStatus pure {
  doc "The nonwaiting ordinary callable copies Cancelled at offset two, preserves all sentinels on short and empty windows, returns both DescriptionError variants, and exports its endpoint bound for an ordinary indexed read. Before the API exists name resolution rejects; a truncating body, wrong Result layout or terminating NUL produces a nonzero exit.";
  let error = IoError::Cancelled();
  let bytes = array_filled::<u8, 16>(value: 90_u8);
  let destination = &bytes[0_u64..16_u64];
  match error_copy_description(error: &error, destination: destination, start: 2_u64, end: 10_u64) {
    Ok(value: next) => {
      return std::process::exit_status(code: 1_u8);
    }
    Err(error: problem) => {
      match problem {
        DescriptionTooSmall(required: needed) => {
          if needed == 9_u64 {
          } else {
            return std::process::exit_status(code: 2_u8);
          }
        }
        DescriptionUnavailable() => {
          return std::process::exit_status(code: 3_u8);
        }
      }
    }
  }
  match error_copy_description(error: &error, destination: destination, start: 2_u64, end: 2_u64) {
    Ok(value: next) => {
      return std::process::exit_status(code: 4_u8);
    }
    Err(error: problem) => {
      match problem {
        DescriptionTooSmall(required: needed) => {
          if needed == 9_u64 {
          } else {
            return std::process::exit_status(code: 5_u8);
          }
        }
        DescriptionUnavailable() => {
          return std::process::exit_status(code: 6_u8);
        }
      }
    }
  }
  for (index in 0_u64..16_u64) {
    if bytes[index] == 90_u8 {
    } else {
      return std::process::exit_status(code: 7_u8);
    }
  }
  let unknown = IoError::Other(code: 2147483647_u32, origin: 3_u8);
  match error_copy_description(error: &unknown, destination: destination, start: 2_u64, end: 16_u64) {
    Ok(value: next) => {
      return std::process::exit_status(code: 8_u8);
    }
    Err(error: problem) => {
      match problem {
        DescriptionTooSmall(required: needed) => {
          return std::process::exit_status(code: 9_u8);
        }
        DescriptionUnavailable() => {
        }
      }
    }
  }
  for (index in 0_u64..16_u64) {
    if bytes[index] == 90_u8 {
    } else {
      return std::process::exit_status(code: 10_u8);
    }
  }
  match error_copy_description(error: &error, destination: destination, start: 2_u64, end: 11_u64) {
    Ok(value: next) => {
      let after = destination^[next];
      if after == 90_u8 {
      } else {
        return std::process::exit_status(code: 11_u8);
      }
      if next == 11_u64 {
      } else {
        return std::process::exit_status(code: 12_u8);
      }
    }
    Err(error: problem) => {
      return std::process::exit_status(code: 13_u8);
    }
  }
  for (index in 0_u64..9_u64) {
    let offset = index +wrap 2_u64;
    if bytes[offset] == cancelled_text[index] {
    } else {
      return std::process::exit_status(code: 14_u8);
    }
  }
  for (index in 0_u64..2_u64) {
    if bytes[index] == 90_u8 {
    } else {
      return std::process::exit_status(code: 15_u8);
    }
  }
  for (index in 11_u64..16_u64) {
    if bytes[index] == 90_u8 {
    } else {
      return std::process::exit_status(code: 16_u8);
    }
  }
  return std::process::exit_status(code: 0_u8);
}
