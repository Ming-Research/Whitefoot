alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn builds(lengths: &[u64]) -> built: Bool reads(lengths) {
  doc "Tells whether box_segments_filled builds a run of u64 segments from these lengths.";
  let made = box_segments_filled::<u64>(lengths: lengths, value: 0_u64);
  match move made {
    None() => {
      return False();
    }
    Some(value: segments) => {
      return True();
    }
  }
}

fn main() -> status: ExitStatus pure {
  doc "box_segments_filled returns None exactly when stride_ceiling(T) * total + 8 * count exceeds 2^62: a total of 2^59 u64 elements needs 2^62 bytes and one bound more; a total that leaves u64 is refused, not wrapped; no lengths at all build an empty run.";
  let lengths = box_array_filled::<u64>(count: 2_u64, value: 0_u64);
  set lengths.inner[0_u64] = 576460752303423488_u64;
  let over = builds(lengths: &lengths.inner[0_u64..2_u64]);
  if over {
    return exit_status(code: 1_u8);
  }
  set lengths.inner[0_u64] = 9223372036854775808_u64;
  set lengths.inner[1_u64] = 9223372036854775808_u64;
  let wrapped = builds(lengths: &lengths.inner[0_u64..2_u64]);
  if wrapped {
    return exit_status(code: 2_u8);
  }
  let empty = builds(lengths: &lengths.inner[0_u64..0_u64]);
  if empty {
  } else {
    return exit_status(code: 3_u8);
  }
  set lengths.inner[0_u64] = 3_u64;
  set lengths.inner[1_u64] = 4_u64;
  let small = builds(lengths: &lengths.inner[0_u64..2_u64]);
  if small {
  } else {
    return exit_status(code: 4_u8);
  }
  return exit_status(code: 0_u8);
}
