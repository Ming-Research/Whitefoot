alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const pattern: Array<u8, 5> = "abcde";

fn main() -> status: ExitStatus pure {
  let text = pattern;
  set text[1_u64] = 'Z'_u8;
  let patched = text[1_u64];
  let drift = patched - 'Z'_u8;
  if pattern[1_u64] != 'b'_u8 {
    return exit_status(code: 2_u8);
  }
  if text[4_u64] != 'e'_u8 {
    return exit_status(code: 3_u8);
  }
  let length = text.len;
  let code = cvt::<u64, u8>(length);
  let status_code = code + drift;
  return exit_status(code: status_code);
}
