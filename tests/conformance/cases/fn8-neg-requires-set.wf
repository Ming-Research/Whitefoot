alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn mutable_clause(x: i32) -> result: i32 pure contract {
  define candidate = x;
  set candidate = candidate +wrap 1_i32;
  define permitted = candidate > x;
  requires permitted;
} {
  doc "A contract block admits no mutation statement; grammar traversal rejects set under GRAM-2 before FN-8 forms a contract.";
  return x;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
