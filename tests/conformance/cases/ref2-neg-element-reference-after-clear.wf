fn main() -> status: std::process::ExitStatus pure {
  doc "OP-10, REF-2: old = &bytes.inner[0_u64] is formed while the window holds one byte. clear ends every element's lifetime, so old dies there, and placing a byte at the same slot afterwards does not make it valid again.";
  let bytes = box_slots_new::<u8>(capacity: 4_u64);
  place_back(window: &bytes.inner, value: 65_u8);
  let old = &bytes.inner[0_u64];
  clear(window: &bytes.inner);
  place_back(window: &bytes.inner, value: 66_u8);
  let seen = old^;
  return std::process::exit_status(code: 0_u8);
}
