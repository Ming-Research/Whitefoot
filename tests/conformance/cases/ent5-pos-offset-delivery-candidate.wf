fn probe(left: u64, right: u64, flag: Bool) -> result: unit pure {
  doc "One delivery image establishes cursor != 4 and the other derives it from cursor <= 3; ENT-5 retains the candidate and ENT-4 tightens the later bound.";
  let cursor = if flag {
    if left == 4_u64 {
      return unit;
    }
    give left;
  } else {
    if 3_u64 < right {
      return unit;
    }
    give right;
  };
  if cursor <= 4_u64 {
    invariant tightened: cursor <= 3_u64;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
