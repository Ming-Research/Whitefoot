alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn bump(x: u64) -> return_value: u64 pure {
  doc "OP-2 constant-operand class: `x + 1_u64` has a constant operand, so it carries an overflow obligation. The dominating branch establishes x < 100 and derives the residual upper conjunct, so the site returns the exact value with no runtime overflow check and the row is `pure` under EFF-2.";
  let small = x < 100_u64;
  if small {
    let y = x + 1_u64;
    return y;
  } else {
    return 0_u64;
  }
}

fn main() -> return_value: ExitStatus pure {
  let raised = bump(x: 7_u64);
  return exit_status(code: 0_u8);
}
