alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn consume(run: Slots<u8, 4>) -> size: u64 pure {
  doc "Consumes the window it is handed and reports its length.";
  let n = run.len;
  return n;
}

fn main() -> status: ExitStatus pure {
  doc "MSR-3: the rebind placement at a SET-1 target. A commit whose right-hand side is a bare use of a measured place carries every measure that place had, exactly as the let rebind does: the datum is minted before the statement's own kills and read after them. The target binding is dead at statement entry and nothing else establishes a length for it, so only the placement discharges the later subscript.";
  let one = slots_new::<u8, 4>();
  place_back(window: &one, value: 5_u8);
  let two = slots_new::<u8, 4>();
  let taken = consume(run: move two);
  set two = move one;
  let seen = two[0_u64];
  if seen == 5_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
