alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

opaque struct Holder {
  item: Box<u8>;
}

fn duplicate(holder: Holder) -> (first: Holder, second: Holder) pure {
  doc "OWN-1: Holder owns a Box, which is declared nocopy, so Holder is affine and not copy. Using the parameter bare to supply two owned results is a hard error: a bare place used as an owned affine value needs the explicit move spelling and a value cannot be consumed twice.";
  return holder, holder;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
