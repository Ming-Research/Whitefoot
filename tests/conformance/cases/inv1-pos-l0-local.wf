fn probe(x: u64) -> result: unit pure contract {
  requires 2_u64 * x <= 8_u64;
} {
  doc "Only the proved local conclusion publishes the weak bound needed by disequality closure.";
  if x == 4_u64 {
    return unit;
  }
  invariant bounded: x <= 4_u64;
  invariant tightened: x <= 3_u64;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
