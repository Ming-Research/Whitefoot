alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn count_then_push(window: &Slots<u64, 8>, lo: u64, hi: u64) -> result: unit reads(window[lo..hi]), writes(window.next), writes(window.len) contract {
  requires lo <= hi;
  requires deref(window).len < deref(window).cap;
} {
  doc "Appends the length of the run window[lo..hi] when that run is formed, and zero otherwise. The contract does not bound hi by the window's length.";
  let count = 0_u64;
  if hi <= deref(window).len {
    let run = &deref(window)[lo..hi];
    set count = deref(run).len;
  }
  place_back(window: window, value: count);
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "EFF-5, WIN-2: a run of a window that ends at or below window.len never overlaps window.next. The call passes hi 2 and its entry state proves window.len equal to 2, so reads(window[0_u64..2_u64]) is separate from writes(window.next); the program observes the appended run length.";
  let window = slots_new::<u64, 8>();
  place_back(window: &window, value: 1_u64);
  place_back(window: &window, value: 2_u64);
  count_then_push(window: &window, lo: 0_u64, hi: 2_u64);
  if window.len == 3_u64 {
    if window[2_u64] == 2_u64 {
      return exit_status(code: 0_u8);
    }
  }
  return exit_status(code: 1_u8);
}
