fn start() -> counter: Counter pure {
  return Counter(count: 0_u64, limit: 1_u64);
}

fn bump(counter: &Counter) -> result: unit writes(counter.count) contract {
  requires deref(counter).limit > deref(counter).count;
} {
  let next = deref(counter).count + 1_u64;
  set deref(counter).count = next;
  return unit;
}
