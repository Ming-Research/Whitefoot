alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy struct Item {
  weight: u64;
}

fn main() -> return_value: ExitStatus pure {
  doc "A body that consumes a binding declared outside it and reinitializes that complete binding before the backedge agrees with the entering edge at the loop head and is admitted.";
  let item = Item(weight: 1_u64);
  loop @l {
    let taken = move item;
    let fresh = Item(weight: 2_u64);
    set item = move fresh;
    break @l;
  }
  if item.weight == 2_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
