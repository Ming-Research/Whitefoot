alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn push(window: &Slots<u64, 4>, value: u64) -> result: u64 writes(window.next), writes(window.len) contract {
  requires window^.len < window^.cap;
  ensures window^.len == entry(window)^.len + 1_u64;
} {
  doc "Appends one element. Its row writes window.next and window.len and nothing below the length, so a call never lowers window.len.";
  place_back(window: window, value: value);
  return 9_u64;
}

fn main() -> status: ExitStatus pure {
  doc "SET-1, REF-2: the target r[0_u64] is checked under 0 < r.len before the right-hand side. push writes only the append slot and the length, which leaves that bound holding and moves no filled slot, so the target stays valid and the commit stores 9 into the first slot beside the appended 5.";
  let r = slots_new::<u64, 4>();
  place_back(window: &r, value: 1_u64);
  set r[0_u64] = push(window: &r, value: 5_u64);
  if r.len != 2_u64 {
    return exit_status(code: 1_u8);
  }
  let first = r[0_u64];
  if first != 9_u64 {
    return exit_status(code: 2_u8);
  }
  let second = r[1_u64];
  if second != 5_u64 {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
