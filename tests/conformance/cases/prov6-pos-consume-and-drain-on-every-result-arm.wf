alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nodrop struct Ticket {
  number: u8;
}

fn consume(ticket: Ticket) -> number: u8 pure {
  doc "The destructuring consume is one of the two routes a linear value leaves a scope by.";
  let Ticket(number: taken) = move ticket;
  return taken;
}

fn acquire(fail: Bool) -> result: Result<Ticket, u8> pure {
  doc "A linear ticket on one outcome and an error code on the other.";
  if fail {
    return Err<Ticket, u8>(error: 7_u8);
  }
  let ticket = Ticket(number: 2_u8);
  return Ok<Ticket, u8>(value: move ticket);
}

fn drain(fail: Bool) -> result: u8 pure {
  doc "Every ticket is taken out and consumed on both outcomes, and the window's zero length is established on each leaving edge, which is exactly what free_empty requires of a window whose element type is linear.";
  let run = slots_new::<Ticket, 2>();
  let first_ticket = Ticket(number: 1_u8);
  place_back(window: &run, value: move first_ticket);
  match acquire(fail: fail) {
    Err(error: problem) => {
      let first = take_back(window: &run);
      let number = consume(ticket: move first);
      free_empty(window: move run);
      return problem;
    }
    Ok(value: second) => {
      place_back(window: &run, value: move second);
      let last = take_back(window: &run);
      let first = take_back(window: &run);
      let last_number = consume(ticket: move last);
      let first_number = consume(ticket: move first);
      free_empty(window: move run);
      let total = first_number +wrap last_number;
      return total;
    }
  }
}

fn attempt(fail: Bool) -> result: u8 pure {
  doc "The same acquisition without a window: the prior ticket is consumed on both outcomes.";
  let first = Ticket(number: 1_u8);
  match acquire(fail: fail) {
    Err(error: problem) => {
      let one = consume(ticket: move first);
      return problem;
    }
    Ok(value: second) => {
      let one = consume(ticket: move first);
      let two = consume(ticket: move second);
      let total = one +wrap two;
      return total;
    }
  }
}

fn main() -> status: ExitStatus pure {
  doc "Both outcomes of both helpers are exercised; no historical drained-window rejection label is retained as a language expectation.";
  let no = 0_u8 == 1_u8;
  let yes = 0_u8 == 0_u8;
  let success = attempt(fail: no);
  let failure = attempt(fail: yes);
  let drained_failure = drain(fail: yes);
  let drained_success = drain(fail: no);
  let correct_success = success == 3_u8;
  let correct_failure = failure == 7_u8;
  let correct = band(correct_success, correct_failure);
  if correct {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
