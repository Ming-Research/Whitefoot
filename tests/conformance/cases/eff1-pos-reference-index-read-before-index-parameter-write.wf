alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn write_slot(window: &Slots<u64, 4>, index: u64) -> result: unit writes(window[index]) contract {
  requires index < deref(window).len;
} {
  doc "Writes element index of the window through a reference formed before index is written.";
  let e = &deref(window)[index];
  set index = 0_u64;
  set deref(e) = 9_u64;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "EFF-1, REF-1: e = &deref(window)[index] reads index while it holds its call value, and the later set index = 0_u64 does not change the element e names, so the write through e is the row's window[index], element 1, and r[0] keeps its value.";
  let r = slots_new::<u64, 4>();
  place_back(window: &r, value: 1_u64);
  place_back(window: &r, value: 2_u64);
  let p = &r[0_u64];
  write_slot(window: &r, index: 1_u64);
  let seen = deref(p);
  if seen == 1_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
