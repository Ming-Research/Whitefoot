alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn rebox(cell: &Box<u64>) -> result: u64 writes(cell) {
  doc "Replaces the box, which releases the old one and its content.";
  let replacement = box_new::<u64>(value: 5_u64);
  set cell^ = move replacement;
  return 7_u64;
}

fn main() -> status: ExitStatus pure {
  doc "SET-1, REF-2: the target b.inner is the content of the box b holds when the target is evaluated. rebox replaces that box, a write of b, which is a proper prefix of the target, so the commit would store into the released box. The commit is refused.";
  let b = box_new::<u64>(value: 1_u64);
  set b.inner = rebox(cell: &b);
  if b.inner == 7_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
