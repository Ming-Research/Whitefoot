alias io = std::io;

fn say(factory: &io::HandleFactory, output: &io::OutputStream) -> result: u64 writes(factory), writes(output) waits {
  let bytes = array_filled::<u8, 2>(value: 111_u8);
  set bytes[1_u64] = 10_u8;
  let window = &bytes[0_u64..2_u64];
  let no_deadline = None<std::time::Instant>();
  let wait_cancel_1 = std::time::cancel_never();
  let wait_outcome_1 = io::write_once(factory: factory, output: output, source: window, start: 0_u64, end: 2_u64, deadline: no_deadline, cancel: &wait_cancel_1);
  std::time::close_cancel_watch(watch: move wait_cancel_1);
  match wait_outcome_1 {
    Ok(value: written) => {
      return written;
    }
    Err(error: problem) => {
      return 0_u64;
    }
  }
}
