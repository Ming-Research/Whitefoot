alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias fs = std::fs;
alias process = std::process;

fn main(inputs: Inputs) -> status: ExitStatus pure must_wait {
  let Inputs(args: unused_args, cwd: unused_cwd_directory, stdout: out, stderr: unused_err, handles: factory, stdin: unused_in, clock: unused_clock, wall_clock: unused_wall_clock) = move inputs;
  let std::fs::Directory(read: unused_cwd, write: unused_cwd_write) = move unused_cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move unused_cwd_write);
  fs::close_directory(factory: &factory, directory: move unused_cwd);
  let written = pkg::report::say(factory: &factory, output: &out);
  match cvt.checked::<u64, u8>(written) {
    Ok(value: code) => {
      return process::exit_status(code: code);
    }
    Err(error: overflowed) => {
      return process::exit_status(code: 200_u8);
    }
  }
}
