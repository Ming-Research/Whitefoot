alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn span(rows: &[Slots<u8, 8>], other: &[Slots<u8, 8>], i: u64) -> r: u64 pure contract {
  requires i < rows^.len;
  ensures r <= rows^[i].len;
} {
  doc "The requirement bounds i below the length of the range rows received, which the place denotes; the rebinding changes neither.";
  set rows = other;
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  doc "The declaration alone is judged.";
  return exit_status(code: 0_u8);
}
