alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn rotate(window: &Slots<Box<u64>, 4>) -> result: unit writes(window) contract {
  requires window^.len == 2_u64;
} {
  doc "The target is reached through the reference parameter and evaluated after the right-hand side, when the window holds one element.";
  set window^[1_u64] = remove_at(window: window, index: 0_u64);
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "SET-1, OP-4: the right-hand side runs first, and remove_at leaves one element in the window the parameter names, so the target window^[1_u64], evaluated after it, is out of bounds and its subscript is refused although the reference it is reached through stays valid.";
  let v = slots_new::<Box<u64>, 4>();
  let first = box_new::<u64>(value: 1_u64);
  place_back(window: &v, value: move first);
  let second = box_new::<u64>(value: 2_u64);
  place_back(window: &v, value: move second);
  rotate(window: &v);
  return exit_status(code: 0_u8);
}
