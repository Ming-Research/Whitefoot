alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn get_bounded<const n: u64>(b: &Slots<u8, n>, i: u64) -> (value: u8, length: u64) reads(b) contract {
  define spare = deref(b).len;
  requires i < spare;
  ensures length == spare;
} {
  doc "A two-result helper hands back the read byte and the run's unchanged length; the owner itself stays with the caller, so the helper reaches it through a reference [REF-1].";
  let value = deref(b)[i];
  return value, deref(b).len;
}

fn main() -> status: ExitStatus pure {
  doc "The counted caller names both result ordinals through a destructuring let binder list [CALL-4] and uses the length ordinal to preserve its header invariant and prove the next call requirement.";
  let buf = slots_new::<u8, 5>();
  for (
    at in 0_u64..5_u64,
    invariant grown: buf.len >= at,
    invariant spare: buf.cap - buf.len + at >= 5_u64
  ) {
    place_back(window: &buf, value: 3_u8);
  }
  let n = buf.len;
  let acc = 0_u64;
  for (
    i in 0_u64..n,
    invariant bounded: i <= n,
    invariant kept: buf.len >= n
  ) {
    let (byte, length) = get_bounded::<5>(b: &buf, i: i);
    let widened = cvt::<u8, u64>(byte);
    set acc = acc +wrap widened;
  }
  if acc == 15_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
