alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Holder {
  payload: Slots<u8, 4>;
  count: u64;
}

fn consume(h: Holder) -> result: unit pure {
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "swap exchanges a field's owner without consuming the root: the root stays live for sibling access and for the later whole-owner transfer, and the old owner ends up the sole owner of the local it was exchanged with.";
  let first = slots_new::<u8, 4>();
  for @fill_first (
    at in 0_u64..2_u64,
    invariant grown: first.len >= at,
    invariant vacancy: first.cap - first.len + at >= 2_u64
  ) {
    place_back(window: &first, value: 1_u8);
  }
  let holder = Holder(payload: move first, count: 0_u64);
  let second = slots_new::<u8, 4>();
  for @fill_second (
    at in 0_u64..3_u64,
    invariant grown: second.len >= at,
    invariant vacancy: second.cap - second.len + at >= 3_u64
  ) {
    place_back(window: &second, value: 2_u8);
  }
  swap(first: &holder.payload, second: &second);
  set holder.count = 1_u64;
  let observed = holder.count;
  let done = consume(h: move holder);
  return exit_status(code: 0_u8);
}
