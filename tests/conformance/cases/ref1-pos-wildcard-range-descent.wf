alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Node {
  value: u64;
  children: Option<Box<Slots<Node, 2>>>;
}

fn inspect(root: &[Node]) -> result: u64 writes(root) {
  let cursor = root;
  for (i in 0_u64..2_u64) {
    if deref(cursor).len != 0_u64 {
      let node = &deref(cursor)[0_u64];
      match deref(node).children {
        Some(value: child) => {
          let count = deref(child).inner.len;
          set cursor = &deref(child).inner[0_u64..count];
        }
        None() => {
        }
      }
    }
  }
  if deref(cursor).len != 0_u64 {
    let observed = deref(cursor)[0_u64].value;
    set deref(cursor)[0_u64].value = 7_u64;
    return observed;
  }
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
