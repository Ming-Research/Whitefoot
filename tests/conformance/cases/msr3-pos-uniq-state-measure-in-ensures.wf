alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn record(destination: &Slots<u8, 4>, value: u8) -> count: u64 writes(destination) contract {
  requires deref(destination).len < deref(destination).cap;
  ensures count == deref(destination).len;
  ensures deref(destination).len == deref(entry(destination)).len + 1_u64;
} {
  doc "Fills one slot of the window it is handed and reports the length that results.";
  place_back(window: destination, value: value);
  let after = deref(destination).len;
  return after;
}

fn main() -> status: ExitStatus pure {
  doc "MSR-3 admits a source ensures over the measure of a reference parameter the row writes: the bare measure denotes the exit-state term over the caller's resolved place, while entry(parameter) denotes the immutable entry datum, and the two are distinct terms even though both project from one formal and one actual.";
  let workspace = slots_new::<u8, 4>();
  let count = record(destination: &workspace, value: 1_u8);
  if count != 1_u64 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
