fn need(x: &u64) -> result: u64 reads(x) contract {
  requires x^ != 0_u64;
} {
  doc "Divides ten by the value x names.";
  let v = 10_u64 / x^;
  return v;
}

fn probe(first: &Shared<u64>, second: &Shared<u64>, flip: Bool) -> result: u64 reads(first), reads(second) waits {
  doc "The control for fn8-neg-guard-through-rebound-atomic-binder: q's path is rooted at the rebound binder a, so q^ keeps its spelling through q, and a guard written through q proves the call through q.";
  let r = 0_u64;
  atomic a = &first^, b = &second^ {
    let q = a;
    if flip {
      set a = &b^;
    }
    if q^ != 0_u64 {
      set r = need(x: q);
    }
  }
  return r;
}

fn main() -> status: std::process::ExitStatus pure waits {
  doc "first holds five, so the guarded call through q returns two.";
  let first = shared_new::<u64>(value: 5_u64);
  let second = shared_new::<u64>(value: 0_u64);
  let flip = 0_u64 == 0_u64;
  let r = probe(first: &first, second: &second, flip: flip);
  if r == 2_u64 {
    return std::process::exit_status(code: 0_u8);
  }
  return std::process::exit_status(code: 1_u8);
}
