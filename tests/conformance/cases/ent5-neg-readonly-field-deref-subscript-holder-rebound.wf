fn select(table: &[Slots<u8, 8>], x: &u64, y: &u64, i: u64) -> result: u8 reads(table), reads(x), reads(y) contract {
  requires x^ < table^.len;
  requires y^ < table^.len;
} {
  doc "ENT-5 and REF-1: selected captures the old dereferenced selector once. Rebinding that selector preserves selected's captured row but cannot identify it with the newly selected row. The two requirements prove each row's formation; only the final inner bound is missing.";
  let selector = x;
  let selected = &table^[selector^];
  set selector = y;
  if i < selected^.len {
    return table^[selector^][i];
  }
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The invalid nested read is checked without a call.";
  return std::process::exit_status(code: 0_u8);
}
