alias Reserve = std::snapshot::Reserve;
alias Job = std::snapshot::Job;
alias CreateError = std::snapshot::CreateError;

struct Store {
  table: ConcurrentHashMap<u8>;
  sequence: u64;
}

fn invoke<fn operation(reserve: Reserve, map: &ConcurrentHashMap<u8>, cut: &u64) -> result: Result<Job, CreateError> reads(map), reads(cut) contract {
  requires held(map, cut);
}>(reserve: Reserve, store: &Shared<Store>) -> result: Result<Job, CreateError> reads(store) waits {
  atomic current = &store^ {
    return operation(reserve: move reserve, map: &current^.table, cut: &current^.sequence);
  }
}

fn instantiate(reserve: Reserve, store: &Shared<Store>) -> result: Result<Job, CreateError> reads(store) waits {
  return invoke::<fn std::snapshot::capture_export::<u8>>(reserve: move reserve, store: store);
}
