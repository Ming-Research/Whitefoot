alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn room(a: u64, b: u64, limit: u64) -> result: u64 pure contract {
  requires a + b <= limit;
  requires a <= 16_u64;
  requires b <= 16_u64;
} {
  doc "An affine requirement names entry values. Replacing a cannot retarget its sum bound, so the later subtraction's domain is unproved [ENT-5, OP-2].";
  set a = 32_u64;
  let total = a + b;
  let remaining = limit - total;
  return remaining;
}

fn main() -> status: ExitStatus pure {
  doc "No construction is needed to exercise the replacement kill.";
  return exit_status(code: 0_u8);
}
