fn helper(source: &[u64], target: &[u64], width: &[u64], j: u64) -> result: unit writes(target[j]) contract {
  requires target^.len == 3_u64;
  requires source^.len == 3_u64;
  requires width^.len == 2_u64;
  requires j == 0_u64;
  ensures forall same(k in 0_u64..1_u64): source^[width^.len] == source^[width^.len];
} {
  set target^[j] = 0_u64;
  return unit;
}

fn caller() -> result: unit pure {
  let values = array_filled::<u64, 3>(value: 0_u64);
  let others = array_filled::<u64, 3>(value: 0_u64);
  let widths = array_filled::<u64, 2>(value: 0_u64);
  helper(source: &others[0_u64..3_u64], target: &values[0_u64..3_u64], width: &widths[0_u64..2_u64], j: 0_u64);
  return unit;
}
