fn need(x: &u64) -> result: u64 reads(x) contract {
  requires x^ != 0_u64;
} {
  doc "Divides ten by the value x names.";
  let v = 10_u64 / x^;
  return v;
}

fn probe(p: &u64) -> result: u64 reads(p) {
  doc "saved names the caller's cell. After p is rebound to one, the guard p^ != 0 reads one, so it says nothing of the cell need would divide by.";
  let saved = &p^;
  let one = 1_u64;
  set p = &one;
  if p^ != 0_u64 {
    let r = need(x: saved);
    return r;
  }
  return 0_u64;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The caller's cell holds zero.";
  let zero = 0_u64;
  let r = probe(p: &zero);
  if r == 10_u64 {
    return std::process::exit_status(code: 0_u8);
  }
  return std::process::exit_status(code: 1_u8);
}
