alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn worker(first: Shared<Box<u8>>, second: Shared<Box<u8>>) -> result: u8 pure waits {
  doc "One statement names the object through two handles and its block ends both before it touches the state: the statement counts once, so the state outlives the block and is released once.";
  let seen = 0_u8;
  atomic a = &first, b = &second {
    release::<Shared<Box<u8>>>(value: move first);
    release::<Shared<Box<u8>>>(value: move second);
    swap(first: a, second: b);
    set a^.inner = 9_u8;
    set seen = a^.inner;
  }
  return seen;
}

fn distance_from_nine(found: Option<Box<u8>>) -> result: u8 pure {
  doc "Zero for no state and for the state the statement left, the only state a close can return.";
  match move found {
    Some(value: kept) => {
      return kept.inner -wrap 9_u8;
    }
    None() => {
      return 0_u8;
    }
  }
}

fn main() -> status: ExitStatus pure waits {
  doc "SHARE-1, SHARE-2: a statement that names one object through two handles counts as one handle until it completes, so a close that comes while it executes returns None, a close that returns Some finds the state the statement wrote, and the state is released once, whichever order the contexts take.";
  let boxed = box_new::<u8>(value: 7_u8);
  let cell = shared_new::<Box<u8>>(value: move boxed);
  let one = shared_share::<Box<u8>>(shared: &cell);
  let two = shared_share::<Box<u8>>(shared: &cell);
  let seen = spawn worker(first: move one, second: move two);
  let closed = shared_close::<Box<u8>>(shared: move cell);
  let distance = distance_from_nine(found: move closed);
  let total = seen +wrap distance;
  return exit_status(code: total);
}
