struct Table {
  slots: Slots<u64, 8>;
  next: u64;
  invariant cursor(table): table.next < table.slots.len;
}

fn make(first: u64) -> table: Table pure {
  let slots = slots_new::<u64, 8>();
  place_back(window: &slots, value: first);
  let made = Table(slots: move slots, next: 0_u64);
  return move made;
}

fn peek(t: &Table) -> result: u64 reads(t) {
  let at = t^.next;
  let got = t^.slots[at];
  return got;
}

fn pair(left: &Table, right: &Table) -> result: u64 reads(left), reads(right) {
  let a = peek(t: left);
  let b = peek(t: right);
  let sum = a +wrap b;
  return sum;
}

fn main() -> status: std::process::ExitStatus pure {
  let one = make(first: 3_u64);
  let two = make(first: 4_u64);
  let sum = pair(left: &one, right: &two);
  let code = cvt.wrap::<u64, u8>(sum);
  return std::process::exit_status(code: code);
}
