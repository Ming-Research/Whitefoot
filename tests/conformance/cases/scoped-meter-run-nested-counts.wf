alias MeterScope = std::process::MeterScope;
alias MemoryMeter = std::process::MemoryMeter;
alias ScopeView = std::process::ScopeView;
alias ScopeBody = std::process::ScopeBody;

struct Family {
  child: MeterScope;
  parent_view: ScopeView;
  child_view: ScopeView;
  meter: MemoryMeter;
}

fn build(argument: Option<u64>) -> result: Box<u64> pure {
  return box_new::<u64>(value: 59_u64);
}

binding Build : ScopeBody<Option<u64>, Box<u64>> {
  run = build;
}

fn allocate(view: &ScopeView) -> result: Box<u64> writes(view) {
  return box_new::<u64>(value: 61_u64);
}

fn release(value: Box<u64>, parent: &ScopeView, child: &ScopeView) -> result: unit writes(parent), writes(child) {
  return unit;
}

fn close(meter: &MemoryMeter, scope: MeterScope) -> result: unit writes(meter) {
  loop {
    let closed = std::process::scope_close(meter: meter, scope: move scope);
    match move closed {
      Ok(value: done) => {
        return done;
      }
      Err(error: owner) => {
        set scope = move owner;
      }
    }
  }
}

fn family(argument: Family) -> result: u8 pure waits {
  let Family(child: child_owner, parent_view: pv, child_view: cv, meter: meter) = move argument;
  let own = allocate(view: &pv);
  let before = std::process::scope_bytes(view: &pv);
  let outcome = spawn std::process::scope_run::<Build>(scope: move child_owner, argument: before);
  match move outcome {
    Refused(scope: owner, argument: original) => {
      close(meter: &meter, scope: move owner);
      return 10_u8;
    }
    Ran(scope: owner, result: block) => {
      let child_bytes = std::process::scope_bytes(view: &cv);
      let parent_bytes = std::process::scope_bytes(view: &pv);
      let own_payload = own.inner == 61_u64;
      let block_payload = block.inner == 59_u64;
      release(value: move block, parent: &pv, child: &cv);
      let after = std::process::scope_bytes(view: &pv);
      close(meter: &meter, scope: move owner);
      let wrong_own = bnot(own_payload);
      if wrong_own {
        return 11_u8;
      }
      let wrong_block = bnot(block_payload);
      if wrong_block {
        return 12_u8;
      }
      match before {
        None() => {
          return 13_u8;
        }
        Some(value: baseline) => {
          match child_bytes {
            None() => {
              return 14_u8;
            }
            Some(value: child_live) => {
              match parent_bytes {
                None() => {
                  return 15_u8;
                }
                Some(value: parent_live) => {
                  match after {
                    None() => {
                      return 16_u8;
                    }
                    Some(value: remaining) => {
                      if baseline < 8_u64 {
                        return 17_u8;
                      }
                      if child_live != 8_u64 {
                        return 18_u8;
                      }
                      let expected = baseline +wrap 8_u64;
                      if parent_live != expected {
                        return 19_u8;
                      }
                      if remaining != baseline {
                        return 20_u8;
                      }
                      return 0_u8;
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

binding FamilyBody : ScopeBody<Family, u8> {
  run = family;
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  let std::process::Inputs(cwd: directory, handles: handles, memory_meter: meter, ..) = move inputs;
  let std::fs::Directory(read: read, write: write) = move directory;
  std::fs::close_directory_write(factory: &handles, directory: move write);
  std::fs::close_directory(factory: &handles, directory: move read);
  let opened = std::process::scope_open(meter: &meter);
  match move opened {
    Err(error: full) => {
      return std::process::exit_status(code: 2_u8);
    }
    Ok(value: parent) => {
      let opened_child = std::process::scope_open_child(meter: &meter, parent: &parent);
      match move opened_child {
        Err(error: exhausted) => {
          close(meter: &meter, scope: move parent);
          return std::process::exit_status(code: 3_u8);
        }
        Ok(value: child) => {
          let pv = std::process::scope_view(scope: &parent);
          let cv = std::process::scope_view(scope: &child);
          let peer = std::process::meter_share(meter: &meter);
          let members = Family(child: move child, parent_view: move pv, child_view: move cv, meter: move peer);
          let outcome = spawn std::process::scope_run::<FamilyBody>(scope: move parent, argument: move members);
          match move outcome {
            Refused(scope: owner, argument: original) => {
              let Family(child: returned_child, parent_view: unused_pv, child_view: unused_cv, meter: unused_meter) = move original;
              close(meter: &meter, scope: move returned_child);
              close(meter: &meter, scope: move owner);
              return std::process::exit_status(code: 4_u8);
            }
            Ran(scope: owner, result: code) => {
              close(meter: &meter, scope: move owner);
              return std::process::exit_status(code: code);
            }
          }
        }
      }
    }
  }
}
