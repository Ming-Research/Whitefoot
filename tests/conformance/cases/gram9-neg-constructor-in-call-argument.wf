alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn consume (value: Bool) -> return_value: unit pure {
  return unit;
}

fn main () -> return_value: ExitStatus pure {
  doc "GRAM-9: a constructor in a call-argument atom position does not derive; bind the constructed value with a preceding let.";
  consume(value: True());
  return exit_status(code: 0_u8);
}
