alias DirectoryRead = std::fs::DirectoryRead;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias IoError = std::io::IoError;
alias close_directory = std::fs::close_directory;
alias close_read = std::fs::close_read;
alias exit_status = std::process::exit_status;
alias open_file = std::fs::open_file;
alias read_at = std::fs::read_at;

fn factory_refusal(error: &IoError) -> result: Bool reads(error) {
  doc "Matching through a reference leaves the scrutinee live and binds each payload as a reference naming the scrutinee path.";
  match deref(error) {
    NotFound(code: native_code, origin: native_origin) => {
      return False();
    }
    PermissionDenied(code: native_code, origin: native_origin) => {
      return False();
    }
    AlreadyExists(code: native_code, origin: native_origin) => {
      return False();
    }
    NotDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    IsDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    DirectoryNotEmpty(code: native_code, origin: native_origin) => {
      return False();
    }
    ReadOnly(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceBusy(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidInput(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidPath(code: native_code, origin: native_origin) => {
      return False();
    }
    Unsupported(code: native_code, origin: native_origin) => {
      return False();
    }
    TimedOut(code: native_code, origin: native_origin) => {
      return False();
    }
    BrokenPipe(code: native_code, origin: native_origin) => {
      return False();
    }
    WriteZero(code: native_code, origin: native_origin) => {
      return False();
    }
    UnexpectedEnd(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionRefused(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionReset(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionAborted(code: native_code, origin: native_origin) => {
      return False();
    }
    NotConnected(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressInUse(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressUnavailable(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceExhausted(code: native_code, origin: native_origin) => {
      return deref(native_origin) == 0_u8;
    }
    FileTooLarge(code: native_code, origin: native_origin) => {
      return False();
    }
    NoSpace(code: native_code, origin: native_origin) => {
      return False();
    }
    QuotaExceeded(code: native_code, origin: native_origin) => {
      return False();
    }
    CrossDevice(code: native_code, origin: native_origin) => {
      return False();
    }
    DeviceFailure(code: native_code, origin: native_origin) => {
      return False();
    }
    Other(code: native_code, origin: native_origin) => {
      return False();
    }
  }
}

fn component() -> made: Slots<u8, 16> pure contract {
  ensures made.len == 16_u64;
} {
  doc "One fixed name the loop opens by, built once outside it.";
  let values = array_filled::<u8, 16>(value: 97_u8);
  let built = slots_from_array::<u8, 16>(values: values);
  return move built;
}

fn exercise(cwd: &DirectoryRead, files: &HandleFactory) -> status: ExitStatus reads(cwd), writes(files) {
  doc "The per-iteration cell is declared inside the counted body, so it is owned by its iteration and takes its compiler-derived release on that iteration's own leaving edge. The failed-open loop and the exit-zero observation remain an ordinary executable program.";
  let name = component();
  let total = 0_u64;
  for @scan (index in 0_u64..4_u64) {
    let data = box_array_filled::<u8>(count: 64_u64, value: 0_u8);
    let window = &name[0_u64..4_u64];
    match open_file(factory: files, root: cwd, name: window, start: 0_u64, end: 4_u64) {
      Ok(value: handle) => {
        let destination = &data.inner[0_u64..64_u64];
        match read_at(factory: files, file: &handle, destination: destination, file_offset: 0_u64, start: 0_u64, end: 64_u64) {
          Ok(value: produced) => {
            let raised = total +wrap produced;
            set total = raised;
          }
          Err(error: stop) => {
            match stop {
              ReadEnd() => {
              }
              ReadFailed(error: problem) => {
              }
            }
          }
        }
        close_read(factory: files, file: move handle);
      }
      Err(error: problem) => {
        let refused = factory_refusal(error: &problem);
        if refused {
          return exit_status(code: 1_u8);
        }
      }
    }
  }
  return exit_status(code: 0_u8);
}

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "PRE-2 ordinary Inputs are destructured once, the rest covered by the rest marker; the referenced operation chain returns before the initial directory is explicitly closed.";
  let Inputs(cwd: root, handles: files, ..) = move inputs;
  let outcome = exercise(cwd: &root, files: &files);
  close_directory(factory: &files, directory: move root);
  return move outcome;
}
