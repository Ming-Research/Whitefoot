alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn probe(limit: u64) -> result: unit pure {
  let sum = 0_u64;
  for (
    i in 0_u64..limit,
    invariant cvt: sum <= i
  ) {
    set sum = sum + 1_u64;
  }
  invariant scaled: 3_u64 * sum <= 3_u64 * limit {
    use 3 times cvt;
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
