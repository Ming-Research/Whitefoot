fn apply<fn exchange(first: &Slots<u64>, second: &Slots<u64>) -> result: unit writes(first), writes(second)>(first: &Slots<u64>, second: &Slots<u64>) -> result: unit writes(first), writes(second) {
  doc "FN-5: the forwarded actual is invoked through the receiving formal.";
  exchange(first: first, second: second);
  return unit;
}

fn relay<fn exchange(first: &Slots<u64>, second: &Slots<u64>) -> result: unit writes(first), writes(second)>(first: &Slots<u64>, second: &Slots<u64>) -> result: unit writes(first), writes(second) {
  doc "FN-2: forwarding a function-kind actual does not erase its type-parameter places.";
  apply::<fn exchange>(first: first, second: second);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "TYPE-9: the forwarded swap is refused at its originally written runtime-capacity targ.";
  let small = box_slots_new::<u64>(capacity: 1_u64);
  let large = box_slots_new::<u64>(capacity: 64_u64);
  relay::<fn swap::<Slots<u64>>>(first: &small.inner, second: &large.inner);
  return std::process::exit_status(code: 0_u8);
}
