struct Cursor {
  k: u64;
  other: u64;
}

fn select(table: &[Slots<u8, 8>], s: &Cursor, i: u64, change: Bool) -> result: u8 reads(table), writes(s) contract {
  requires s^.k < table^.len;
} {
  doc "ENT-5: one reaching branch writes the offset field, so the continuation join loses the old row-length guard. The requirement still proves the outer bound, which does not recover the missing inner bound.";
  if i < table^[s^.k].len {
    if change {
      set s^.k = 0_u64;
    }
    return table^[s^.k][i];
  }
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The nested element read must reject OP-4 although its outer bound is proved.";
  return std::process::exit_status(code: 0_u8);
}
