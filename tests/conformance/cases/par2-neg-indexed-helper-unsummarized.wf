fn overwrite(flags: &Box<Array<u8>>, bits: u8) -> result: unit writes(flags) {
  doc "A parameter-dependent overwrite is neither an operation nor a fixed constant mark.";
  if 0_u64 < flags^.inner.len {
    set flags^.inner[0_u64] = bits;
  }
  return unit;
}

fn mark(flags: &Box<Array<u8>>, span: u64, bits: u8) -> result: unit writes(flags) {
  doc "Forwarding to a helper without a summary cannot establish a summary.";
  overwrite(flags: flags, bits: bits);
  return unit;
}

fn reduce() -> result: u8 pure {
  doc "Rows contribute through a whole-root reference to a summarized helper.";
  let filters = box_array_filled::<u8>(count: 4_u64, value: 16_u8);
  for (row in 0_u64..4_u64) {
    mark(flags: &filters, span: 2_u64, bits: 3_u8);
  }
  if 3_u64 < filters.inner.len {
    if filters.inner[3_u64] != 16_u8 {
      return 0_u8;
    }
    return filters.inner[0_u64];
  }
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Sequential source remains accepted while checker tests observe permission.";
  let observed = reduce();
  return std::process::exit_status(code: 0_u8);
}
