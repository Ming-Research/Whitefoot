struct Cursor {
  k: u64;
  other: u64;
}

fn select(table: &[Slots<u8, 8>], s: &Cursor, i: u64, stop: Bool) -> result: u8 reads(table), writes(s) contract {
  requires s^.k < table^.len;
} {
  doc "ENT-5: a continuing write to the offset field removes the pre-loop row-length guard at the loop head. The body rechecks the outer bound, so only the inner element bound is unproved.";
  if i < table^[s^.k].len {
    loop {
      if s^.k < table^.len {
        let observed = table^[s^.k][i];
        if stop {
          return observed;
        }
      }
      set s^.k = 0_u64;
    }
  }
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The nested element read must reject OP-4 after its outer bound succeeds.";
  return std::process::exit_status(code: 0_u8);
}
