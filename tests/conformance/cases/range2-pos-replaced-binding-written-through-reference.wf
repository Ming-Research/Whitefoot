struct Counter {
  count: u8;
}

fn bump(marks: &[u64]) -> result: u8 pure contract {
  requires forall small(k in 0_u64..marks^.len): marks^[k] < 8_u64;
} {
  doc "Replacing s whole leaves r valid, so the write through r makes s.count 2, and 251 + 2 fits in u8.";
  let s = Counter(count: 0_u8);
  let r = &s;
  set s = Counter(count: 9_u8);
  set r^.count = 2_u8;
  let v = s.count;
  let w = 251_u8 + v;
  return w;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
