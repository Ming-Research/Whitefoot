alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn echo<const n: u64>() -> r: u64 pure {
  doc "Reads the const generic at its written type u64.";
  return n;
}

fn next<const m: u64>() -> r: u64 pure {
  doc "An operation whose IDENT terms are all u64 is admitted for a u64 parameter, the domain its evaluation is exact in.";
  return echo::<m + 1>();
}

fn main() -> status: ExitStatus pure {
  doc "The instance evaluates m + 1 to 4.";
  let v = next::<3>();
  if v == 4_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
