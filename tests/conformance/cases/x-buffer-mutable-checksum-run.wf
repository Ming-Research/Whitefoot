alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A heap-resident runtime-capacity run is taken from the one heap, filled, and folded through counted ranges whose binder facts prove every indexed access in bounds; the cell takes its compiler-derived release at normal owner exit.";
  let cell = box_slots_new::<u64>(capacity: 8_u64);
  for @build (
    at in 0_u64..8_u64,
    invariant grown: cell.inner.len >= at,
    invariant spare: cell.inner.cap - cell.inner.len + at >= 8_u64
  ) {
    place_back(window: &cell.inner, value: 0_u64);
  }
  let length = cell.inner.len;
  for (fill_index in 0_u64..length) {
    set cell.inner[fill_index] = fill_index +wrap 1_u64;
  }
  let total = 0_u64;
  for (fold_index in 0_u64..length) {
    let value = cell.inner[fold_index];
    set total = total +wrap value;
  }
  if total == 36_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
