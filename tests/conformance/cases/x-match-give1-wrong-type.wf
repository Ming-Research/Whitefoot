alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Choice {
  First();
  Second();
}

fn main() -> status: ExitStatus pure {
  doc "A binder's mode and type are derived by agreement over the closed delivery set, so two arms delivering different types are rejected at the later give [GIVE-1].";
  let c = Choice::First();
  let v = match c {
    First() => {
      give 1_i32;
    }
    Second() => {
      give True();
    }
  }
  return exit_status(code: 0_u8);
}
