alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum State {
  Ready();
  Done();
}

nocopy struct Holder {
  state: State;
}

fn main() -> return_value: ExitStatus pure {
  doc "OWN-1: projected copy reads do not consume their affine struct or window owner.";
  let state = State::Ready();
  let holder = Holder(state: state);
  match holder.state {
    Ready() => {
    }
    Done() => {
    }
  }
  match holder.state {
    Ready() => {
    }
    Done() => {
    }
  }
  let saved_holder = move holder;
  let items = slots_new::<u8, 2>();
  place_back(window: &items, value: 7_u8);
  place_back(window: &items, value: 7_u8);
  let first = items[0_u64];
  let second = items[1_u64];
  if first == 7_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if second == 7_u8 {
  } else {
    return exit_status(code: 2_u8);
  }
  let saved_items = move items;
  return exit_status(code: 0_u8);
}
