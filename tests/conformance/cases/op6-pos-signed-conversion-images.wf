alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn widen_ok(x: u16) -> result: i32 pure {
  return cvt::<u16, i32>(x);
}

fn to_unsigned(x: i32) -> result: u32 pure {
  match cvt.checked::<i32, u32>(x) {
    Ok(value: v) => {
      return v;
    }
    Err(error: e) => {
      return 0_u32;
    }
  }
}

fn widen_preserved(value: u8) -> result: i16 pure contract {
  requires value == 200_u8;
  ensures result == 200_i16;
} {
  let wide = cvt::<u8, i16>(value);
  return wide;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
