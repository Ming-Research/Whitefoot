alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A replacement run delivers its initialized length after a prior control join: the whole-binding commit is the REBIND naming event, whose placement datum carries the source window's measures to the destination place [MSR-3, SET-1]. The old run length dies with the commit [ENT-5] and is not incorrectly used, while the delivered length discharges the later subscript [OP-4].";
  let base = array_filled::<u32, 4>(value: 1_u32);
  let arr = slots_from_array::<u32, 4>(values: base);
  let before = arr[0_u64];
  let ok = before == 1_u32;
  if ok {
    return exit_status(code: 1_u8);
  }
  let seed = array_filled::<u32, 4>(value: 9_u32);
  let fresh = slots_from_array::<u32, 4>(values: seed);
  set arr = move fresh;
  let after = arr[0_u64];
  return exit_status(code: 0_u8);
}
