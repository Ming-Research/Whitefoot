alias Args = std::text::Args;
alias DirectoryRead = std::fs::DirectoryRead;
alias HandleFactory = std::io::HandleFactory;
alias HostPaths = std::fs::HostPaths;
alias PathEncoding = std::fs::PathEncoding;

const missing: Array<u8, 7> =[109_u8, 105_u8, 115_u8, 115_u8, 105_u8, 110_u8, 103_u8];

fn error_kind(error: &std::io::IoError) -> kind: u8 reads(error) {
  match error^ {
    NotFound(code: c, origin: o) => {
      return 1_u8;
    }
    PermissionDenied(code: c, origin: o) => {
      return 2_u8;
    }
    AlreadyExists(code: c, origin: o) => {
      return 9_u8;
    }
    NotDirectory(code: c, origin: o) => {
      return 3_u8;
    }
    IsDirectory(code: c, origin: o) => {
      return 4_u8;
    }
    DirectoryNotEmpty(code: c, origin: o) => {
      return 9_u8;
    }
    ReadOnly(code: c, origin: o) => {
      return 9_u8;
    }
    ResourceBusy(code: c, origin: o) => {
      return 9_u8;
    }
    InvalidInput(code: c, origin: o) => {
      return 9_u8;
    }
    InvalidPath(code: c, origin: o) => {
      return 5_u8;
    }
    Unsupported(code: c, origin: o) => {
      return 6_u8;
    }
    TimedOut(code: c, origin: o) => {
      return 9_u8;
    }
    DeadlinePassed() => {
      return 9_u8;
    }
    Cancelled() => {
      return 9_u8;
    }
    BrokenPipe(code: c, origin: o) => {
      return 9_u8;
    }
    WriteZero(code: c, origin: o) => {
      return 9_u8;
    }
    UnexpectedEnd(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionRefused(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionReset(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionAborted(code: c, origin: o) => {
      return 9_u8;
    }
    NotConnected(code: c, origin: o) => {
      return 9_u8;
    }
    AddressInUse(code: c, origin: o) => {
      return 9_u8;
    }
    AddressUnavailable(code: c, origin: o) => {
      return 9_u8;
    }
    ResourceExhausted(code: c, origin: o) => {
      return 9_u8;
    }
    FileTooLarge(code: c, origin: o) => {
      return 9_u8;
    }
    NoSpace(code: c, origin: o) => {
      return 9_u8;
    }
    QuotaExceeded(code: c, origin: o) => {
      return 9_u8;
    }
    CrossDevice(code: c, origin: o) => {
      return 9_u8;
    }
    DeviceFailure(code: c, origin: o) => {
      return 9_u8;
    }
    Other(code: c, origin: o) => {
      return 9_u8;
    }
  }
}

fn copy_argument(args: &Args, position: u64, destination: &[u8]) -> next: u64 reads(args), writes(destination) contract {
  ensures next <= destination^.len;
} {
  match std::text::arg_get(args: args, position: position) {
    Ok(value: text) => {
      let length = destination^.len;
      match std::text::host_copy_bytes(value: &text, destination: destination, start: 0_u64, end: length) {
        Ok(value: end) => {
          return end;
        }
        Err(error: problem) => {
          return 0_u64;
        }
      }
    }
    Err(error: problem) => {
      return 0_u64;
    }
  }
}

fn missing_pair(args: &Args, factory: &HandleFactory, paths: &HostPaths, base: &DirectoryRead) -> result: u8 reads(args), reads(paths), reads(base), writes(factory) waits {
  match std::text::arg_get(args: args, position: 1_u64) {
    Ok(value: text) => {
      match std::fs::open_host_directory(factory: factory, paths: paths, base: base, path: &text) {
        Ok(value: data) => {
          let std::fs::Directory(read: data_read, write: data_write) = move data;
          std::fs::close_directory_write(factory: factory, directory: move data_write);
          std::fs::close_directory(factory: factory, directory: move data_read);
          return 3_u8;
        }
        Err(error: problem) => {
          let kind = error_kind(error: &problem);
          if kind != 1_u8 {
            return 4_u8;
          }
        }
      }
    }
    Err(error: problem) => {
      return 1_u8;
    }
  }
  match std::fs::open_directory(factory: factory, root: base, name: &missing[0_u64..7_u64], start: 0_u64, end: 7_u64) {
    Ok(value: created) => {
      std::fs::close_directory(factory: factory, directory: move created);
      return 5_u8;
    }
    Err(error: problem) => {
      let kind = error_kind(error: &problem);
      if kind != 1_u8 {
        return 6_u8;
      }
    }
  }
  return 0_u8;
}

fn file_as_directory(args: &Args, factory: &HandleFactory, paths: &HostPaths, base: &DirectoryRead) -> result: u8 reads(args), reads(paths), reads(base), writes(factory) waits {
  match std::text::arg_get(args: args, position: 2_u64) {
    Ok(value: text) => {
      match std::fs::open_host_directory_read(factory: factory, paths: paths, base: base, path: &text) {
        Ok(value: opened) => {
          std::fs::close_directory(factory: factory, directory: move opened);
          return 7_u8;
        }
        Err(error: problem) => {
          let kind = error_kind(error: &problem);
          if kind != 3_u8 {
            return 8_u8;
          }
          return 0_u8;
        }
      }
    }
    Err(error: problem) => {
      return 1_u8;
    }
  }
}

fn through_file(factory: &HandleFactory, paths: &HostPaths, base: &DirectoryRead, path: &[u8]) -> result: u8 reads(paths), reads(base), reads(path), writes(factory) waits {
  let encoding = PathEncoding::NativeBytes();
  match std::fs::open_host_directory_read_bytes(factory: factory, paths: paths, base: base, path: path, start: 0_u64, end: path^.len, encoding: encoding) {
    Ok(value: opened) => {
      std::fs::close_directory(factory: factory, directory: move opened);
      return 10_u8;
    }
    Err(error: problem) => {
      let kind = error_kind(error: &problem);
      if kind != 3_u8 {
        return 11_u8;
      }
      return 0_u8;
    }
  }
}

fn exercise(args: &Args, factory: &HandleFactory, paths: &HostPaths, base: &DirectoryRead) -> result: u8 reads(args), reads(paths), reads(base), writes(factory) waits {
  let outcome = missing_pair(args: args, factory: factory, paths: paths, base: base);
  if outcome != 0_u8 {
    return outcome;
  }
  set outcome = file_as_directory(args: args, factory: factory, paths: paths, base: base);
  if outcome != 0_u8 {
    return outcome;
  }
  let inner = array_filled::<u8, 1024>(value: 0_u8);
  let inner_end = copy_argument(args: args, position: 3_u64, destination: &inner[0_u64..1024_u64]);
  if inner_end > 0_u64 {
    if inner_end <= 1024_u64 {
      return through_file(factory: factory, paths: paths, base: base, path: &inner[0_u64..inner_end]);
    }
  }
  return 9_u8;
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  doc "Opening a missing directory by absolute path returns NotFound and creates nothing, so the name stays absent below its existing parent; a regular file named as the directory, or as a component before it, returns NotDirectory. Before HostPaths exists name resolution rejects; an open that created the directory exits 3 or 5, and any other outcome exits 4, 6 to 11, or 12 without the authority.";
  let std::process::Inputs(args: args, cwd: directory, handles: factory, host_paths: host_paths, ..) = move inputs;
  let std::fs::Directory(read: reader, write: writer) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move writer);
  let outcome = 12_u8;
  match move host_paths {
    Some(value: paths) => {
      set outcome = exercise(args: &args, factory: &factory, paths: &paths, base: &reader);
    }
    None() => {
    }
  }
  std::fs::close_directory(factory: &factory, directory: move reader);
  return std::process::exit_status(code: outcome);
}
