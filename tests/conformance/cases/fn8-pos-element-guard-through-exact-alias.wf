fn element(x: &Box<Array<u64>>, i: u64) -> result: u64 reads(x) contract {
  requires i < x^.inner.len;
  requires x^.inner[i] != 0_u64;
} {
  doc "Returns element i of the run x names, which the caller proved nonzero.";
  let v = x^.inner[i];
  return v;
}

fn probe(cells: &Box<Array<u64>>, i: u64) -> result: u64 reads(cells) {
  doc "q names cells exactly, so the bound and the element goal read through q are the ones element's requirements are instantiated at.";
  let q = &cells^;
  if i < q^.inner.len {
    if q^.inner[i] != 0_u64 {
      let v = element(x: cells, i: i);
      return v;
    }
  }
  return 0_u64;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The run holds three fives.";
  let cells = box_array_filled::<u64>(count: 3_u64, value: 5_u64);
  let r = probe(cells: &cells, i: 2_u64);
  if r == 5_u64 {
    return std::process::exit_status(code: 0_u8);
  }
  return std::process::exit_status(code: 1_u8);
}
