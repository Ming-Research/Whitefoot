struct Flag {
  enabled: Bool;
}

fn same<T: copy>(targets: &[T], value: T) -> result: unit pure contract {
  requires forall same(k in 0_u64..targets^.len): targets^[k] == value;
} {
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let enabled = True();
  let value = Flag(enabled: enabled);
  let targets = array_filled::<Flag, 1>(value: value);
  let expected = Flag(enabled: enabled);
  same::<Flag>(targets: &targets[0_u64..1_u64], value: expected);
  return std::process::exit_status(code: 0_u8);
}
