alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn leading_digit(total: u64, divisor: u64) -> result: u64 pure contract {
  requires 1_u64 <= divisor;
  requires divisor <= 1152921504606846976_u64;
  requires total < 10_u64 * divisor;
  ensures result <= 9_u64;
} {
  doc "The quotient of a total below ten divisors by the divisor, which is below ten.";
  let quotient = total / divisor;
  return quotient;
}

fn main() -> status: ExitStatus pure {
  doc "Divides five totals and compares each quotient with the one computed outside the compiler.";
  let digit_1 = leading_digit(total: 0_u64, divisor: 1_u64);
  if digit_1 == 0_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let digit_2 = leading_digit(total: 9_u64, divisor: 1_u64);
  if digit_2 == 9_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  let digit_3 = leading_digit(total: 99_u64, divisor: 10_u64);
  if digit_3 == 9_u64 {
  } else {
    return exit_status(code: 3_u8);
  }
  let digit_4 = leading_digit(total: 37_u64, divisor: 4_u64);
  if digit_4 == 9_u64 {
  } else {
    return exit_status(code: 4_u8);
  }
  let digit_5 = leading_digit(total: 11529215046068469759_u64, divisor: 1152921504606846976_u64);
  if digit_5 == 9_u64 {
  } else {
    return exit_status(code: 5_u8);
  }
  return exit_status(code: 0_u8);
}
