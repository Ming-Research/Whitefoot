fn bump(x: i64) -> result: i64 pure contract {
  requires x <= -9223372036854775808_i64 * 9223372036854775807_i64 + -9223372036854775808_i64 * 9223372036854775807_i64 + -9223372036854775808_i64 + -9223372036854775808_i64;
} {
  doc "Every formation value fits i128: the side folds to -2^127 and the normalized bound is x <= -2^127. No i64 satisfies it, so the requirement contradicts x's type and the body's addition is proved.";
  let y = x + 1_i64;
  return y;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
