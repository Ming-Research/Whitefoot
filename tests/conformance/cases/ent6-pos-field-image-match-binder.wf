struct Reading {
  value: i64;
}

fn make() -> made: Reading pure contract {
  ensures -1000_i64 <= made.value;
} {
  doc "The construction carries 0 into the field the postcondition names.";
  return Reading(value: 0_i64);
}

fn shift(slot: Option<Reading>, d: u8) -> result: i64 pure {
  doc "A match binder is a root of a tracked field place: the guard bounds inner.value, and the copy of the field takes that image, so the subtraction of a widened byte is proved.";
  match slot {
    None() => {
      return 0_i64;
    }
    Some(value: inner) => {
      if -1000_i64 <= inner.value {
        let c = inner.value;
        let w = cvt::<u8, i64>(d);
        let v = c - w;
        return v;
      }
      return 0_i64;
    }
  }
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
