alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn release_now(cell: Box<Slots<u8>>) -> result: unit pure {
  doc "Consuming the value here runs, at this call, the same release walk the caller's scope exit would have run for it.";
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "PROV-6: an affine value is released early by moving it into a function that consumes it and ends, and there is no release operation. The two windows are reclaimed one after the other rather than both at the entry's own exit edge, which is the difference between a peak of one window and a peak of two.";
  let first = box_slots_new::<u8>(capacity: 4_u64);
  let size = first.inner.len;
  release_now(cell: move first);
  let second = box_slots_new::<u8>(capacity: 4_u64);
  release_now(cell: move second);
  if size == 0_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
