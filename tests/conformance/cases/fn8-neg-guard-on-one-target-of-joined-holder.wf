fn need(x: &u64) -> result: u64 reads(x) contract {
  requires x^ != 0_u64;
} {
  doc "Divides ten by the value x names.";
  let v = 10_u64 / x^;
  return v;
}

fn pick(a: &u64, b: &u64, other: Bool) -> result: u64 reads(a), reads(b) {
  doc "After the join q may name a's cell or b's, so its description is not exact and a guard on a^ does not prove the call through q.";
  let q = &a^;
  if other {
    set q = &b^;
  }
  if a^ != 0_u64 {
    let r = need(x: q);
    return r;
  }
  return 0_u64;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "a is nonzero and b is zero, and q names b.";
  let a = 5_u64;
  let b = 0_u64;
  let other = b == 0_u64;
  let r = pick(a: &a, b: &b, other: other);
  if r == 2_u64 {
    return std::process::exit_status(code: 0_u8);
  }
  return std::process::exit_status(code: 1_u8);
}
