alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Sign {
  Neg();
  Zero();
  Pos();
}

nocopy enum Wrap {
  W(inner: Sign);
  N();
}

fn main() -> status: ExitStatus pure {
  doc "OWN-1/OWN-13: matching an own composite moves the whole binding (partial move kills it); a second match of the moved binding is a use of a dead binding.";
  let pos_atom_0001 = Sign::Pos();
  let w = Wrap::W(inner: pos_atom_0001);
  match w {
    W(inner: s) => {
    }
    N() => {
    }
  }
  match w {
    W(inner: s) => {
    }
    N() => {
    }
  }
  return exit_status(code: 0_u8);
}
