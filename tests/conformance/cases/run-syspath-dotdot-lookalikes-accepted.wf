alias Args = std::text::Args;
alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias arg_get = std::text::arg_get;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias relative_path = std::fs::relative_path;

fn accepts(args: &Args, position: u64) -> result: Bool reads(args) {
  match arg_get(args: args, position: position) {
    Ok(value: text) => {
      match relative_path(value: move text) {
        Ok(value: path) => {
          return True();
        }
        Err(error: rejected) => {
          return False();
        }
      }
    }
    Err(error: absent) => {
      return False();
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "The ordinary path library takes only a whole component .. for a parent step: a name that merely contains two dots, three dots, a single dot as a component and an empty component are returned as relative paths. The arranged paths are ..x, x.., a/.../b, ., a//b and a/./b; the exit status names the first one rejected.";
  let Inputs(args: args, drivers: unused_driver_count, cwd: unused_cwd_directory, stdout: unused_stdout, stderr: unused_stderr, handles: entry_factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter, host_paths: unused_host_paths, process_id: unused_process_id) = move inputs;
  let std::fs::Directory(read: unused_cwd, write: unused_cwd_write) = move unused_cwd_directory;
  std::fs::close_directory_write(factory: &entry_factory, directory: move unused_cwd_write);
  close_directory(factory: &entry_factory, directory: move unused_cwd);
  let prefix = accepts(args: &args, position: 1_u64);
  if prefix {
  } else {
    return exit_status(code: 10_u8);
  }
  let suffix = accepts(args: &args, position: 2_u64);
  if suffix {
  } else {
    return exit_status(code: 11_u8);
  }
  let three = accepts(args: &args, position: 3_u64);
  if three {
  } else {
    return exit_status(code: 12_u8);
  }
  let single = accepts(args: &args, position: 4_u64);
  if single {
  } else {
    return exit_status(code: 13_u8);
  }
  let empty = accepts(args: &args, position: 5_u64);
  if empty {
  } else {
    return exit_status(code: 14_u8);
  }
  let current = accepts(args: &args, position: 6_u64);
  if current {
  } else {
    return exit_status(code: 15_u8);
  }
  return exit_status(code: 0_u8);
}
