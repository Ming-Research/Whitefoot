enum LoopExitChoice {
  LoopExitLeave();
  LoopExitStay();
}

fn main() -> status: std::process::ExitStatus pure {
  loop @outer {
    let chosen = match LoopExitChoice::LoopExitLeave() {
      LoopExitLeave() => {
        break @outer;
      }
      LoopExitStay() => {
        give 1_u64;
      }
    }
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
