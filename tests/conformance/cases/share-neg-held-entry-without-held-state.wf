const key: Array<u8, 1> =[107_u8];

fn fill(state: &Keyed<u8>) -> result: unit writes(state) {
  atomic slot = &state^[&key[0_u64..1_u64]] {
    set slot^ = Some<u8>(value: 1_u8);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let map = shared_map_new::<u8>(capacity: 0_u64);
  atomic state = &map {
    fill(state: state);
  }
  return std::process::exit_status(code: 0_u8);
}
