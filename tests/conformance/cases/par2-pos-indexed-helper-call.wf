fn mark(flags: &Box<Array<u8>>, span: u64, bits: u8) -> result: unit writes(flags) {
  doc "Contributions depend on inputs and measures, never on partial flags.";
  for (i in 0_u64..span) {
    if i < flags^.inner.len {
      let old = flags^.inner[i];
      let next = ior(old, bits);
      set flags^.inner[i] = next;
    }
  }
  return unit;
}

fn forward(flags: &Box<Array<u8>>, span: u64, bits: u8) -> result: unit writes(flags) {
  doc "A reference parameter forwards its indexed summary through one helper.";
  mark(flags: flags, span: span, bits: bits);
  return unit;
}

fn reduce() -> result: u8 pure {
  doc "Rows contribute through a whole-root reference to a summarized helper.";
  let filters = box_array_filled::<u8>(count: 4_u64, value: 16_u8);
  for (row in 0_u64..4_u64) {
    mark(flags: &filters, span: 2_u64, bits: 3_u8);
  }
  if 3_u64 < filters.inner.len {
    if filters.inner[3_u64] != 16_u8 {
      return 0_u8;
    }
    return filters.inner[0_u64];
  }
  return 0_u8;
}

fn composed() -> result: u8 pure {
  doc "Rows contribute through a whole-root reference to a summarized helper.";
  let filters = box_array_filled::<u8>(count: 4_u64, value: 16_u8);
  for (row in 0_u64..4_u64) {
    forward(flags: &filters, span: 2_u64, bits: 3_u8);
  }
  if 3_u64 < filters.inner.len {
    if filters.inner[3_u64] != 16_u8 {
      return 0_u8;
    }
    return filters.inner[0_u64];
  }
  return 0_u8;
}

struct Holder {
  cells: Box<Array<u8>>;
}

fn nested_owner() -> result: u8 pure {
  doc "A reference to a field maps the callee family below that actual prefix.";
  let cells = box_array_filled::<u8>(count: 4_u64, value: 16_u8);
  let wrapper = Holder(cells: move cells);
  for (row in 0_u64..4_u64) {
    mark(flags: &wrapper.cells, span: 2_u64, bits: 3_u8);
  }
  if 3_u64 < wrapper.cells.inner.len {
    if wrapper.cells.inner[3_u64] != 16_u8 {
      return 0_u8;
    }
    return wrapper.cells.inner[0_u64];
  }
  return 0_u8;
}

fn paired(first: &Box<Array<u8>>, second: &Box<Array<u8>>) -> result: unit writes(first), writes(second) {
  doc "Each reference parameter has its own summary over the whole body.";
  mark(flags: first, span: 2_u64, bits: 3_u8);
  mark(flags: second, span: 2_u64, bits: 3_u8);
  return unit;
}

fn two_roots() -> result: u8 pure {
  doc "Disjoint bindings may each receive one parameter of the same call.";
  let left = box_array_filled::<u8>(count: 4_u64, value: 16_u8);
  let right = box_array_filled::<u8>(count: 4_u64, value: 32_u8);
  for (row in 0_u64..4_u64) {
    paired(first: &left, second: &right);
  }
  if 3_u64 < left.inner.len {
    if 3_u64 < right.inner.len {
      if left.inner[3_u64] != 16_u8 {
        return 0_u8;
      }
      if right.inner[3_u64] != 32_u8 {
        return 0_u8;
      }
      return left.inner[0_u64] +wrap right.inner[0_u64];
    }
  }
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Both helper depths preserve the seed and untouched cells.";
  let direct_result = reduce();
  let composed_result = composed();
  if direct_result != 19_u8 {
    return std::process::exit_status(code: 1_u8);
  }
  if composed_result != 19_u8 {
    return std::process::exit_status(code: 2_u8);
  }
  let nested_result = nested_owner();
  let paired_result = two_roots();
  if nested_result != 19_u8 {
    return std::process::exit_status(code: 3_u8);
  }
  if paired_result != 54_u8 {
    return std::process::exit_status(code: 4_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
