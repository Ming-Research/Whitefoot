alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn replace_last(window: &Ring<u64, 8>, value: u64) -> result: unit writes(window.last), writes(window.next), writes(window.len) contract {
  requires window^.len > 0_u64;
  ensures window^.len == entry(window)^.len;
} {
  doc "Takes and replaces a ring's last value, retaining its length and logical origin.";
  let old = take_back(window: window);
  place_back(window: window, value: value);
  return unit;
}

fn probe(window: &Ring<u64, 8>) -> result: u64 writes(window) contract {
  requires window^.len >= 1_u64;
} {
  doc "A ring slot reference survives a last-slot write whose postcondition preserves its formation bound.";
  let first = &window^[0_u64];
  replace_last(window: window, value: 7_u64);
  return first^;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
