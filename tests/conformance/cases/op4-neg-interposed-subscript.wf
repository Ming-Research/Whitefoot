alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn peek(v: &u64) -> result: u64 reads(v) {
  doc "Reads through deref the value the reference names and hands back an owned copy.";
  return deref(v);
}

fn probe(values: Array<u8, 8>, index: u64, cell: &u64, other: &u64) -> result: u64 reads(cell), reads(other) {
  doc "A subscript between ordinary read calls still requires its own proved bound.";
  let a = peek(v: other);
  let picked = values[index];
  let b = peek(v: cell);
  return imax(a, b);
}

fn main() -> status: ExitStatus pure {
  let cell = 1_u64;
  let other = 2_u64;
  let table = array_filled::<u8, 8>(value: 0_u8);
  let total = probe(values: table, index: 3_u64, cell: &cell, other: &other);
  return exit_status(code: 0_u8);
}
