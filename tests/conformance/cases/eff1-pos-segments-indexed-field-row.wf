struct Item {
  byte: u8;
}

const lengths: Array<u64, 2> =[1_u64, 2_u64];

fn read_byte(s: &Segments<Item>, segment: u64, offset: u64) -> result: u8 reads(s[segment][offset].byte), reads(s[segment].len), reads(s.len) {
  if segment < s^.len {
    if offset < s^[segment].len {
      return s^[segment][offset].byte;
    }
  }
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  let item = Item(byte: 7_u8);
  let segments = box_segments_filled::<Item>(lengths: &lengths[0_u64..2_u64], value: item);
  if 1_u64 < segments.inner[1_u64].len {
    set segments.inner[1_u64][1_u64].byte = 21_u8;
  }
  let byte = read_byte(s: &segments.inner, segment: 1_u64, offset: 1_u64);
  if byte != 21_u8 {
    return std::process::exit_status(code: 1_u8);
  }
  let absent_segment = read_byte(s: &segments.inner, segment: 2_u64, offset: 0_u64);
  if absent_segment != 0_u8 {
    return std::process::exit_status(code: 2_u8);
  }
  let absent_element = read_byte(s: &segments.inner, segment: 0_u64, offset: 1_u64);
  if absent_element != 0_u8 {
    return std::process::exit_status(code: 3_u8);
  }
  return std::process::exit_status(code: byte);
}
