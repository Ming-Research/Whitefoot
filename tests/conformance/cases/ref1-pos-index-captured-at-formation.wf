alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "REF-1: an index expression inside a path is evaluated when the reference is formed, and a later assignment to the variable the expression used does not change the path.";
  let a = array_filled::<u64, 4>(value: 0_u64);
  set a[1_u64] = 7_u64;
  set a[3_u64] = 9_u64;
  let i = 1_u64;
  let p = &a[i];
  set i = 3_u64;
  let seen = deref(p);
  if seen == 7_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
