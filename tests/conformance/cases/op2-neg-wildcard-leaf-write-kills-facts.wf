alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Node {
  value: u64;
  next: Option<Box<Node>>;
}

fn inspect(root: &Node) -> result: u64 writes(root) {
  doc "A primitive write preserves the cursor but kills possibly overlapping value facts.";
  let cursor = root;
  for (i in 0_u64..2_u64) {
    match cursor^.next {
      Some(value: child) => {
        set cursor = &child^.inner;
      }
      None() => {
        break;
      }
    }
  }
  if cursor^.value != 0_u64 {
    set root^.value = 0_u64;
    return 1_u64 / cursor^.value;
  }
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
