alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Val {
  Small(a: i32);
  Big(b: u64);
  Bare();
}

fn classify(v: Val) -> function_result: i32 pure {
  doc "Match each variant of an enum whose payload slot is sized to the widest variant (u64); each payload is copied out at its own declared width [TYPE-2, TYPE-6, GRAM-10].";
  match v {
    Small(a: n) => {
      let bounded = n % 2147483647_i32;
      return bounded + 1_i32;
    }
    Big(b: m) => {
      if m >= 1000000000_u64 {
        return 2_i32;
      } else {
        return 3_i32;
      }
    }
    Bare() => {
      return 9_i32;
    }
  }
}

fn main() -> status: ExitStatus pure {
  doc "Construct all three variants and dispatch each through a by-value cross-fn match; the pinned sum proves every payload width round-trips.";
  let small_atom_0001 = Val::Small(a: 40_i32);
  let a = classify(v: small_atom_0001);
  let big_atom_0002 = Val::Big(b: 5000000000_u64);
  let b = classify(v: big_atom_0002);
  let bare_atom_0003 = Val::Bare();
  let c = classify(v: bare_atom_0003);
  if a +defined b {
  } else {
    return exit_status(code: 201_u8);
  }
  let s0 = a + b;
  if s0 +defined c {
  } else {
    return exit_status(code: 202_u8);
  }
  let s1 = s0 + c;
  if s1 == 52_i32 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
