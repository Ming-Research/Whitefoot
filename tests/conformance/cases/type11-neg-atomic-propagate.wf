struct Table {
  slots: Slots<u64, 8>;
  next: u64;
  invariant cursor(table): table.next < table.slots.len;
}

fn make() -> table: Table pure {
  let slots = slots_new::<u64, 8>();
  place_back(window: &slots, value: 10_u64);
  let made = Table(slots: move slots, next: 0_u64);
  return move made;
}

fn tried(table: &Shared<Table>, outcome: Result<u8, unit>) -> result: Result<u8, unit> reads(table) may_wait {
  atomic t = &table^ {
    set t^.next = 9_u64;
    let inner = propagate outcome;
    set t^.next = 0_u64;
  }
  return Ok<u8, unit>(value: 3_u8);
}

fn main() -> status: std::process::ExitStatus pure may_wait {
  let initial = make();
  let table = shared_new::<Table>(value: move initial);
  let good = Ok<u8, unit>(value: 6_u8);
  let r = tried(table: &table, outcome: good);
  return std::process::exit_status(code: 0_u8);
}
