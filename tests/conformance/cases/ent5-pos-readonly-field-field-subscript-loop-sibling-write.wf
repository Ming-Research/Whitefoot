struct Cursor {
  k: u64;
  other: u64;
}

fn select(table: &[Slots<u8, 8>], s: &Cursor, i: u64, stop: Bool) -> result: u8 reads(table), reads(s.k), writes(s.other) contract {
  requires s^.k < table^.len;
} {
  doc "ENT-5: a continuing sibling-field write overlaps no offset support, so the pre-loop row-length guard remains available at the ordinary loop head.";
  if i < table^[s^.k].len {
    loop {
      if s^.k < table^.len {
        let observed = table^[s^.k][i];
        if stop {
          return observed;
        }
      }
      set s^.other = 0_u64;
    }
  }
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The body must retain the guarded inner bound through the disjoint write.";
  return std::process::exit_status(code: 0_u8);
}
