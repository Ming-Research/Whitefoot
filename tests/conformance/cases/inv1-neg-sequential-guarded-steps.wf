alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn sum_paced(limit: u64) -> total: u64 pure {
  let fast = 0_u64;
  let n = 0_u64;
  let total = 0_u64;
  loop (
    invariant paced: fast <= limit
  ) {
    let spare = fast < limit;
    if spare {
      set total = total +wrap fast;
      set fast = fast + 1_u64;
    }
    let room_again = fast < limit;
    if room_again {
      set total = total +wrap fast;
      set fast = fast + 1_u64;
    }
    let more = n < 4_u64;
    if more {
      set n = n + 1_u64;
    } else {
      break;
    }
  }
  return total;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
