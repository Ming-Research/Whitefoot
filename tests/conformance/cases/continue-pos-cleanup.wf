fn main() -> status: std::process::ExitStatus pure {
  doc "Exercises the continue transfer.";
  let retained = box_new::<u64>(value: 7_u64);
  for @outer (i in 0_u64..3_u64) {
    let first = box_new::<u64>(value: i);
    for (j in 0_u64..2_u64) {
      let second = box_new::<u64>(value: j);
      continue @outer;
    }
  }
  if retained.inner != 7_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
