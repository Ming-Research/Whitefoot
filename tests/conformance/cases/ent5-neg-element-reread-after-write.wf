alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn h2(buf: &[u8], i: u64, w: u8) -> result: u8 writes(buf) {
  doc "The old local copy is bounded, but a store replaces the element with an arbitrary byte. A fresh element read cannot inherit the old copy's bound; its domain must be rejected [ENT-5, OP-2]. The old immutable local theorem need not itself be killed.";
  let limit = deref(buf).len;
  let in_range = i < limit;
  if in_range {
    let old = deref(buf)[i];
    let bounded = old <= 5_u8;
    if bounded {
      set deref(buf)[i] = w;
      let cur = deref(buf)[i];
      let z = cur + 250_u8;
      return z;
    } else {
      return 0_u8;
    }
  } else {
    return 0_u8;
  }
}

fn main() -> status: ExitStatus pure {
  doc "No construction is needed to exercise the element kill.";
  return exit_status(code: 0_u8);
}
