alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn replace_last_size(window: &Slots<u64, 8>, value: u64) -> size: u64 writes(window.last), writes(window.next), writes(window.len) contract {
  requires window^.len > 0_u64;
  ensures size >= 1_u64;
  ensures window^.len == size;
} {
  doc "Takes and replaces the last value and publishes the nonempty exit length through its result.";
  let old = take_back(window: window);
  place_back(window: window, value: value);
  return window^.len;
}

fn probe(window: &Slots<u64, 8>) -> result: u64 writes(window) contract {
  requires window^.len >= 1_u64;
} {
  doc "The direct result's postconditions must publish before checking the first slot's post-call formation bound.";
  let first = &window^[0_u64];
  let size = replace_last_size(window: window, value: 7_u64);
  return first^;
}

fn probe_set(window: &Slots<u64, 8>) -> result: u64 writes(window) contract {
  requires window^.len >= 1_u64;
} {
  doc "A direct set destination publishes the result's postconditions before the reference's formation bound is checked.";
  let first = &window^[0_u64];
  let size = 0_u64;
  set size = replace_last_size(window: window, value: 7_u64);
  return first^;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
