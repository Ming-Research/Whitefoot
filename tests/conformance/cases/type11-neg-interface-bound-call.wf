struct Table {
  slots: Slots<u64, 8>;
  next: u64;
  invariant cursor(table): table.next < table.slots.len;
}

interface Reader {
  fn read(t: &Table) -> result: u64 reads(t);
}

fn peek(t: &Table) -> result: u64 reads(t) {
  let at = t^.next;
  let got = t^.slots[at];
  return got;
}

binding Peek : Reader {
  read = peek;
}

fn use_reader<interface Reader>(t: &Table) -> result: u64 reads(t), writes(t.next) {
  set t^.next = 99_u64;
  let got = Reader::read(t: t);
  set t^.next = 0_u64;
  return got;
}

fn main() -> status: std::process::ExitStatus pure {
  let slots = slots_new::<u64, 8>();
  place_back(window: &slots, value: 10_u64);
  let table = Table(slots: move slots, next: 0_u64);
  let got = use_reader::<Peek>(t: &table);
  let code = cvt.wrap::<u64, u8>(got);
  return std::process::exit_status(code: code);
}
