alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Source {
  bytes: Slots<u8, 5>;
}

fn head(input: &Source) -> byte: u8 reads(input.bytes) {
  doc "A run field reached through a shared reference to its owner is one measured place: the measure read and the subscript name the same place through the same reference, so the OP-4 obligation is discharged from the guard written over that measure.";
  let size = deref(input).bytes.len;
  let ok = 0_u64 < size;
  if ok {
    return deref(input).bytes[0_u64];
  }
  return 0_u8;
}

fn main() -> status: ExitStatus pure {
  doc "The owner is reached through one shared reference and the field effect names only that structural substate.";
  let bytes = slots_new::<u8, 5>();
  place_back(window: &bytes, value: 43_u8);
  let input = Source(bytes: move bytes);
  let window = &input;
  let seen = head(input: window);
  if seen == 43_u8 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
