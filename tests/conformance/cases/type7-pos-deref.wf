alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn deref(value: i32) -> result: i32 pure {
  return value;
}

fn main() -> status: ExitStatus pure {
  doc "Reaching a referent is explicit via place^ [TYPE-7]; a reference variable denotes the reference [REF-1], so the stored 42 is read back through postfix access and the product read through the caret is the exit status 42.";
  let a = 42_i32;
  let p = &a;
  let v = deref(value: p^);
  let product = p^ *wrap 1_i32;
  if v == 42_i32 {
  } else {
    return exit_status(code: 1_u8);
  }
  let status_code = cvt::<i32, u8>(product);
  return exit_status(code: status_code);
}
