alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "The same publication read the other way: split_off publishes deref(source).len == index, so after a split at zero the source is known empty and take_back's requires deref(window).len > 0_u64 is refuted on the one path on which the source's new length is known at all.";
  let source = slots_new::<u64, 8>();
  for (
    i in 0_u64..8_u64,
    invariant h: source.len == i
  ) {
    place_back(window: &source, value: i);
  }
  let destination = slots_new::<u64, 8>();
  split_off(source: &source, index: 0_u64, destination: &destination);
  let taken = take_back(window: &source);
  return exit_status(code: 0_u8);
}
