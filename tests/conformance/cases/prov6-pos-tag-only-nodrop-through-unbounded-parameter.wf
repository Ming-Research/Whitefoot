alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nodrop enum Flag {
  On();
  Off();
}

fn pass<T>(value: T) -> back: T pure {
  return move value;
}

fn main() -> status: ExitStatus pure {
  doc "A tag-only nodrop enum satisfies an unbounded parameter and remains linear after substitution. The generic body transfers it whole, and the caller consumes the returned value exactly once.";
  let flag = Flag::On();
  let returned = pass::<Flag>(value: move flag);
  match move returned {
    On() => {
      return exit_status(code: 0_u8);
    }
    Off() => {
      return exit_status(code: 1_u8);
    }
  }
}
