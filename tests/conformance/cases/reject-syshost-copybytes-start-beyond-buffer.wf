alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias arg_get = std::text::arg_get;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias host_copy_bytes = std::text::host_copy_bytes;

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "The empty range at eight over a four-element destination refutes end <= deref(destination).len. FN-8 rejects the ordinary function requirement.";
  let Inputs(args: arguments, cwd: root, handles: factory, ..) = move inputs;
  close_directory(factory: &factory, directory: move root);
  let bytes = box_array_filled::<u8>(count: 4_u64, value: 0_u8);
  let window = &bytes.inner[0_u64..4_u64];
  match arg_get(args: &arguments, position: 1_u64) {
    Ok(value: text) => {
      match host_copy_bytes(value: &text, destination: window, start: 8_u64, end: 8_u64) {
        Ok(value: copied) => {
          return exit_status(code: 10_u8);
        }
        Err(error: problem) => {
          return exit_status(code: 11_u8);
        }
      }
    }
    Err(error: absent) => {
      return exit_status(code: 12_u8);
    }
  }
}
