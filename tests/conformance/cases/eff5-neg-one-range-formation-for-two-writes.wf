struct Bounds {
  lo: u64;
}

fn stamp_two_ranges(first: &[u8], second: &[u8]) -> result: u64 writes(first), writes(second) {
  if 0_u64 < first^.len {
    set first^[0_u64] = 7_u8;
  }
  if 0_u64 < second^.len {
    set second^[0_u64] = 8_u8;
  }
  return 2_u64;
}

fn collide(v: &[u8], b: Bounds) -> result: u64 writes(v) contract {
  requires b.lo <= v^.len;
} {
  doc "EFF-5, OWN-7: one range reference passed to both writable parameters names one storage twice, because its range step is the same step with the same captured endpoints. The empty range formed beside it does not separate the two substituted writes.";
  let part = &v^[b.lo..v^.len];
  let empty = &v^[v^.len..v^.len];
  let stamped = stamp_two_ranges(first: part, second: part);
  return stamped;
}
