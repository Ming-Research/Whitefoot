alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn shadow_param(x: i32) -> function_result: unit pure {
  doc "A let redeclaring the live parameter name x shadows it [TYPE-6].";
  let x = 9_i32;
  return unit;
}

fn main() -> status: ExitStatus pure {
  let r = shadow_param(x: 3_i32);
  return exit_status(code: 0_u8);
}
