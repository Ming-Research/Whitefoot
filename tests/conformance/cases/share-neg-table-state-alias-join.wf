const names: Array<u8, 1> =[97_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let table = keyed_table_new::<u8>(capacity: 0_u64);
  let store = shared_new::<KeyedTable<u8>>(value: move table);
  atomic s = &store, t = &s^ {
    let key = &names[0_u64..1_u64];
    let choose = True();
    let copied = if choose {
      give t;
    } else {
      give s;
    }
    set copied^[key] = Some<u8>(value: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
