struct Chain<U> {
  item: U;
  next: Option<Shared<Chain<U>>>;
}

fn keep<U: drop>(chain: Chain<U>) -> result: Chain<U> pure {
  return move chain;
}

fn keep_count(chain: Chain<u64>) -> result: Chain<u64> pure {
  return keep::<u64>(chain: move chain);
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
