alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const alternative: u64 = 9_u64;

fn select(value: &u64) -> chosen: u64 reads(value) {
  doc "Hands back owned data rather than a reference [REF-3]; named const storage supplies it.";
  let seen = deref(value);
  return alternative;
}

fn indexed(value: u64) -> result: u64 pure contract {
  requires value < 1_u64;
} {
  let rows = array_filled::<u64, 1>(value: 7_u64);
  return rows[value];
}

fn forward(value: &u64) -> result: u64 reads(value) {
  doc "A guard over the delivered owned result establishes the requirement of the next call even when the supplier ignores its input and answers with a constant.";
  let chosen = select(value: value);
  if chosen < 1_u64 {
    return indexed(value: chosen);
  } else {
    return 99_u64;
  }
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
