alias Reserve = std::snapshot::Reserve;
alias Job = std::snapshot::Job;
alias CreateError = std::snapshot::CreateError;

struct Inner {
  state: Shared<u8>;
}

struct Entry {
  inner: Box<Inner>;
}

struct Store {
  table: ConcurrentHashMap<Entry>;
  sequence: u64;
}

fn capture(reserve: Reserve, store: &Shared<Store>) -> result: Result<Job, CreateError> reads(store) waits {
  atomic current = &store^ {
    return std::snapshot::capture_export::<Entry>(reserve: move reserve, map: &current^.table, cut: &current^.sequence);
  }
}
