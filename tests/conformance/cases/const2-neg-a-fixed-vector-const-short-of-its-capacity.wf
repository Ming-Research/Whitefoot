alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const table: Array<u8, 4> =[10_u8, 20_u8];

fn main() -> status: ExitStatus pure {
  doc "An Array<T, N>-typed const takes exactly N entries, because len == cap == N is a standing fact of the type rather than a stored word. A shorter entry list is rejected at the item.";
  let v = table[0_u64];
  return exit_status(code: 0_u8);
}
