alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy struct Owner {
  values: Array<u64, 4>;
}

fn main() -> status: ExitStatus pure {
  doc "REF-2: a reference is invalidated when a proper prefix of its path is written, and using it after that event is a hard error.";
  let initial = array_filled::<u64, 4>(value: 0_u64);
  let a = Owner(values: initial);
  let p = &a.values[1_u64];
  let replacement = array_filled::<u64, 4>(value: 5_u64);
  let b = Owner(values: replacement);
  set a = move b;
  let seen = deref(p);
  if seen == 5_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
