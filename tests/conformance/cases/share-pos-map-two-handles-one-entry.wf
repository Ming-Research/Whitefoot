const names: Array<u8, 2> =[97_u8, 97_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let store = shared_map_new::<u8>(capacity: 1_u64);
  let other = shared_share::<ConcurrentHashMap<u8>>(shared: &store);
  let first = &names[0_u64..1_u64];
  let again = &names[1_u64..2_u64];
  atomic one = &store[first], two = &other[again] {
    set one^ = Some<u8>(value: 3_u8);
    set two^ = Some<u8>(value: 9_u8);
  }
  let seen = 0_u8;
  let counted = 0_u64;
  atomic t = &store {
    match t^[first] {
      Some(value: held) => {
        set seen = held^;
      }
      None() => {
      }
    }
    set counted = map_count::<u8>(map: t);
  }
  if counted != 1_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: seen);
}
