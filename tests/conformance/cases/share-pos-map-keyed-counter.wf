const key: Array<u8, 2> =[107_u8, 49_u8];

fn bump(map: SharedMap<u8>) -> result: unit pure waits {
  atomic slot = &map[&key[0_u64..2_u64]] {
    match slot^ {
      Some(value: seen) => {
        let next = seen^ +wrap 1_u8;
        set slot^ = Some<u8>(value: next);
      }
      None() => {
        set slot^ = Some<u8>(value: 1_u8);
      }
    }
  }
  return unit;
}

fn bump_three(map: &SharedMap<u8>) -> result: unit reads(map) waits {
  let first = shared_map_share::<u8>(shared: map);
  spawn bump(map: move first);
  let second = shared_map_share::<u8>(shared: map);
  spawn bump(map: move second);
  let third = shared_map_share::<u8>(shared: map);
  spawn bump(map: move third);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let map = shared_map_new::<u8>(capacity: 0_u64);
  atomic slot = &map[&key[0_u64..2_u64]] {
    set slot^ = Some<u8>(value: 4_u8);
  }
  bump_three(map: &map);
  let total = 0_u8;
  atomic slot = &map[&key[0_u64..2_u64]] {
    match slot^ {
      Some(value: seen) => {
        set total = seen^;
      }
      None() => {
      }
    }
  }
  return std::process::exit_status(code: total);
}
