const key: Array<u8, 1> =[107_u8];

fn add(counts: Shared<ConcurrentHashMap<u8>>) -> result: unit pure waits {
  let name = &key[0_u64..1_u64];
  atomic t = &counts {
    match t^[name] {
      Some(value: seen) => {
        let next = seen^ +wrap 1_u8;
        set t^[name] = Some<u8>(value: next);
      }
      None() => {
        set t^[name] = Some<u8>(value: 1_u8);
      }
    }
  }
  return unit;
}

fn add_three(counts: &Shared<ConcurrentHashMap<u8>>) -> result: unit reads(counts) waits {
  for @start (index in 0_u64..3_u64) {
    let handle = shared_share::<ConcurrentHashMap<u8>>(shared: counts);
    spawn add(counts: move handle);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let counts_map = map_new::<u8>(capacity: 0_u64);
  let counts = shared_new::<ConcurrentHashMap<u8>>(value: move counts_map);
  let name = &key[0_u64..1_u64];
  atomic t = &counts {
    set t^[name] = Some<u8>(value: 4_u8);
  }
  add_three(counts: &counts);
  let seen = 0_u8;
  atomic t = &counts {
    match t^[name] {
      Some(value: observed) => {
        set seen = observed^;
      }
      None() => {
      }
    }
  }
  return std::process::exit_status(code: seen);
}
