alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A counted loop carries a strict cursor header, writes through it, and either increments under the stronger guard or resets to zero. The two reaching images both preserve the header, and an element write kills no measure of the window it is inside.";
  let values = array_filled::<u32, 4>(value: 0_u32);
  let ring = slots_from_array::<u32, 4>(values: values);
  let cursor = 0_u64;
  let total = 0_u32;
  let value = 0_u32;
  for (
    i in 0_u64..10_u64,
    invariant cursor_in_ring: cursor < 4_u64
  ) {
    set ring[cursor] = value;
    set total = total +wrap value;
    let can_advance = cursor < 3_u64;
    if can_advance {
      set cursor = cursor + 1_u64;
    } else {
      set cursor = 0_u64;
    }
    set value = value +wrap 1_u32;
  }
  if total == 45_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  let last_written = ring[1_u64];
  if last_written == 9_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
