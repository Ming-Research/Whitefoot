alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy struct Pair {
  left: i32;
  right: i32;
}

fn pass_pair(item: Pair) -> return_value: Pair pure {
  doc "OWN-1: an own affine place in return position is moved exactly once.";
  return move item;
}

fn pass_box(holder: Box<i32>) -> return_value: Box<i32> pure {
  doc "OWN-1: a return transfers an own cell as a cell; it does not reach the cell's content.";
  return move holder;
}

fn main() -> return_value: ExitStatus pure {
  return exit_status(code: 0_u8);
}
