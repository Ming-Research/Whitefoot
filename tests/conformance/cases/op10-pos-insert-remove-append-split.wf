alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "OP-10: insert_at and remove_at each shift r.filled by one memmove and move the boundary by one, and append and split_off each move a run of elements between two windows and move both boundaries.";
  let r = slots_new::<u64, 4>();
  place_back(window: &r, value: 1_u64);
  place_back(window: &r, value: 3_u64);
  insert_at(window: &r, index: 1_u64, value: 2_u64);
  let middle = remove_at(window: &r, index: 1_u64);
  let other = slots_new::<u64, 4>();
  append(destination: &other, source: &r);
  split_off(source: &other, index: 1_u64, destination: &r);
  let left = other.len;
  let right = r.len;
  if middle == 2_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  if left == 1_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  if right == 1_u64 {
  } else {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
