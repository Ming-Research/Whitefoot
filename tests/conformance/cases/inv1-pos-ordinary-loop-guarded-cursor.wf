alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn count_to(limit: u64) -> reached: u64 pure {
  let cursor = 0_u64;
  loop (
    invariant bounded: cursor <= limit
  ) {
    let remaining = cursor < limit;
    if remaining {
      invariant guarded: cursor < limit;
      set cursor = cursor + 1_u64;
    } else {
      break;
    }
  }
  return cursor;
}

fn main() -> status: ExitStatus pure {
  let reached = count_to(limit: 4_u64);
  let correct = reached == 4_u64;
  if correct {
  } else {
    let failed = exit_status(code: 1_u8);
    return move failed;
  }
  let success = exit_status(code: 0_u8);
  return move success;
}
