alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> return_value: ExitStatus pure {
  doc "OWN-1 applies inside an index place: a u64 offset is copy and cannot be written with move.";
  let items = slots_new::<u8, 2>();
  place_back(window: &items, value: 0_u8);
  place_back(window: &items, value: 0_u8);
  let offset = 0_u64;
  let value = items[move offset];
  return exit_status(code: 0_u8);
}
