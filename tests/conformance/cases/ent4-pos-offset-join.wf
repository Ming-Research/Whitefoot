fn probe(cursor: u64, flag: Bool) -> result: unit pure {
  doc "One input establishes cursor != 4 and the other derives it from cursor <= 3; ENT-5's finite candidate rule keeps it.";
  if flag {
    if cursor == 4_u64 {
      return unit;
    }
  } else {
    if 3_u64 < cursor {
      return unit;
    }
  }
  let marker = 0_u8;
  if cursor <= 4_u64 {
    invariant tightened: cursor <= 3_u64;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
