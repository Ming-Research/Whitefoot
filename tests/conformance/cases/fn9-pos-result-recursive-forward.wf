alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn left(value: i32) -> result: Result<i32, u8> pure contract {
  ensures when Ok(value: payload): payload == value;
} {
  let outcome = right(value: value);
  return outcome;
}

fn right(value: i32) -> result: Result<i32, u8> pure contract {
  ensures when Ok(value: payload): payload == value;
} {
  return left(value: value);
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
