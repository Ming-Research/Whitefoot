struct Index {
  value: u64;
  invariant bounded(index): index.value < 16_u64;
}

const lengths: Array<u64, 2> =[1_u64, 2_u64];

fn lookup(index: &Index, table: &Array<u64, 16>) -> result: u64 reads(index), reads(table) {
  let at = index^.value;
  let got = table^[at];
  return got;
}

fn segment_element(table: &Array<u64, 16>) -> result: u64 reads(table) {
  let seed = Index(value: 3_u64);
  let segments = box_segments_filled::<Index>(lengths: &lengths[0_u64..2_u64], value: seed);
  let got = 0_u64;
  if 1_u64 < segments.inner.len {
    if 1_u64 < segments.inner[1_u64].len {
      set segments.inner[1_u64][1_u64].value = 31_u64;
      set got = lookup(index: &segments.inner[1_u64][1_u64], table: table);
    }
  }
  return got;
}
