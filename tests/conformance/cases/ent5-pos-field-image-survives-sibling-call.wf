alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Counter {
  doc "A count and a tag.";
  count: u64;
  tag: u64;
}

fn retag(counter: &Counter, tag: u64) -> result: unit writes(counter.tag) {
  doc "Writes only the tag.";
  set counter^.tag = tag;
  return unit;
}

fn advance(counter: &Counter, delta: u64) -> result: unit writes(counter) contract {
  requires counter^.count + delta <= 800_u64;
} {
  doc "Calls a function whose row writes only the sibling tag, then reads the count. The projected write is disjoint from the count, so the count keeps its entry image and the requirement bounds the sum.";
  retag(counter: counter, tag: 9_u64);
  let count = counter^.count;
  let total = count + delta;
  set counter^.count = total;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "Advances 5 by 7 and checks the count and the tag.";
  let counter = Counter(count: 5_u64, tag: 0_u64);
  let kept = counter.count;
  if kept <= 793_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  advance(counter: &counter, delta: 7_u64);
  let count = counter.count;
  if count == 12_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  let tag = counter.tag;
  if tag == 9_u64 {
  } else {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
