alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "Exercise every Boolean table operation through normal source compilation and host execution [OP-1, OP-8].";
  let yes = True();
  let no = False();
  let both = band(yes, no);
  let not_both = bnot(both);
  if not_both {
  } else {
    return exit_status(code: 1_u8);
  }
  let either = bor(no, yes);
  if either {
  } else {
    return exit_status(code: 2_u8);
  }
  let different = bxor(yes, no);
  if different {
  } else {
    return exit_status(code: 3_u8);
  }
  let same = bxor(yes, yes);
  let not_same = bnot(same);
  if not_same {
  } else {
    return exit_status(code: 4_u8);
  }
  return exit_status(code: 0_u8);
}
