alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Cursor {
  idx: u64;
  limit: u64;
}

fn cursor_read_at<const n: u64>(table: Slots<u8, n>, cursor: Cursor) -> value: u8 pure contract {
  define spare = table.len;
  requires cursor.idx < cursor.limit;
  requires cursor.limit <= spare;
} {
  doc "Replacing cursor.idx invalidates the old scalar field bound even when the disjoint cursor.limit remains. The old field image cannot prove the subscript for the replacement [ENT-5, OP-4].";
  set cursor.idx = 9_u64;
  return table[cursor.idx];
}

fn main() -> status: ExitStatus pure {
  doc "No construction is needed to exercise the field kill.";
  return exit_status(code: 0_u8);
}
