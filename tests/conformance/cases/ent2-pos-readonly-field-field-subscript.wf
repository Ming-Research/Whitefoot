struct Cursor {
  k: u64;
  other: u64;
}

fn select(table: &[Slots<u8, 8>], s: &Cursor, i: u64) -> result: u8 reads(table), reads(s.k) contract {
  requires s^.k < table^.len;
} {
  doc "ENT-2: a tracked integer field is an admitted offset of a subscripted readonly len term; repeating that offset lets the guard discharge the nested element read.";
  if i < table^[s^.k].len {
    return table^[s^.k][i];
  }
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The function body is checked without a call.";
  return std::process::exit_status(code: 0_u8);
}
