alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

interface Single {
  fn value() -> result: i32 pure;
}

binding First : Single {
  value = make_value;
  extra = make_extra;
}

fn make_value() -> result: i32 pure {
  return 1_i32;
}

fn make_extra() -> result: i32 pure {
  return 2_i32;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
