alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn probe(window: &Slots<u64, 8>) -> result: u64 writes(window) contract {
  requires window^.len == 1_u64;
} {
  doc "An emptied slot invalidates its reference immediately; filling that slot again does not revive the old reference.";
  let first = &window^[0_u64];
  let taken = take_back(window: window);
  place_back(window: window, value: 7_u64);
  return first^;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
