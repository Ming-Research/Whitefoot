alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn bounded_index(values: Slots<u8, 8>, index: u64) -> output: u64 pure contract {
  define capacity = values.cap;
  requires index < capacity;
  ensures output < capacity;
} {
  doc "One erased definition is read by both the requirement and the ensured relation.";
  return index;
}

fn main() -> status: ExitStatus pure {
  doc "One erased, pure contract definition is visible to both a requirement and an ensured normal-return relation.";
  let values = slots_new::<u8, 8>();
  let output = bounded_index(values: move values, index: 7_u64);
  if output == 7_u64 {
    return exit_status(code: 0_u8);
  } else {
    return exit_status(code: 1_u8);
  }
}
