alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Item {
  rank: u64;
}

interface Inspect<T> {
  fn inspect(value: &T) -> result: unit pure;
}

fn ignore(value: &Box<Item>) -> result: unit pure {
  doc "The group's captured type argument is substituted into the member signature before FN-4 compares it with this actual; the reference itself carries no qualifier to compare [REF-1].";
  return unit;
}

binding ItemInspect : Inspect<Box<Item>> {
  inspect = ignore;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
