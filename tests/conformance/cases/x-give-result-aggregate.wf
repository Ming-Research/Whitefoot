alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn choose(b: Bool) -> function_result: Result<u64, u64> pure {
  let result = if b {
    give Ok<u64, u64>(value: 1_u64);
  } else {
    give Err<u64, u64>(error: 2_u64);
  }
  return result;
}

fn main() -> status: ExitStatus pure {
  let true_atom_0001 = True();
  let first = choose(b: true_atom_0001);
  match first {
    Ok(value: ok_value) => {
      if ok_value == 1_u64 {
      } else {
        return exit_status(code: 1_u8);
      }
    }
    Err(error: ok_error) => {
      return exit_status(code: 2_u8);
    }
  }
  let false_atom_0002 = False();
  let second = choose(b: false_atom_0002);
  match second {
    Ok(value: err_value) => {
      return exit_status(code: 3_u8);
    }
    Err(error: err_error) => {
      if err_error == 2_u64 {
      } else {
        return exit_status(code: 4_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}
