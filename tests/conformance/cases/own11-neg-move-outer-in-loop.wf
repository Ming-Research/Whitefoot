alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy enum Sign {
  Neg(mag: i32);
  Zero();
  Pos();
}

fn main() -> return_value: ExitStatus pure {
  doc "OWN-11: a binding declared outside a loop may not be moved inside it.";
  let s = Sign::Pos();
  loop @l {
    match s {
      Neg(mag: m) => {
      }
      Zero() => {
      }
      Pos() => {
      }
    }
    break @l;
  }
  return exit_status(code: 0_u8);
}
