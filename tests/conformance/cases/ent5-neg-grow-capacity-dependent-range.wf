fn reserve(cell: &Box<Slots<u64>>, capacity: u64) -> result: unit writes(cell) contract {
  requires 0_u64 < cell^.inner.len;
  requires capacity >= cell^.inner.cap;
  requires forall contents(k in 0_u64..cell^.inner.len): cell^.inner[k] == cell^.inner.cap;
  ensures forall unchanged(k in 0_u64..cell^.inner.len): cell^.inner[k] == cell^.inner.cap;
} {
  grow(cell: cell, capacity: capacity);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
