struct Cursor {
  k: u64;
  other: u64;
}

fn touch(s: &Cursor) -> result: unit writes(s) {
  doc "The written boundary exhibits the assignment to k.";
  set s^.k = 0_u64;
  return unit;
}

fn select(table: &[Slots<u8, 8>], s: &Cursor, i: u64) -> result: u8 reads(table), writes(s) contract {
  requires s^.k < table^.len;
} {
  doc "ENT-5 and EFF-2: the callee's writes(s) boundary projects onto the offset owner and kills the selected row's old bound. Rechecking the outer bound cannot restore the inner guard.";
  if i < table^[s^.k].len {
    touch(s: s);
    if s^.k < table^.len {
      return table^[s^.k][i];
    }
  }
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The nested element read must reject OP-4 after its outer bound succeeds.";
  return std::process::exit_status(code: 0_u8);
}
