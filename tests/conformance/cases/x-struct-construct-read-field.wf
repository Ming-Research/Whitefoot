alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Point {
  x: i32;
  y: i32;
}

fn main() -> status: ExitStatus pure {
  doc "TYPE-2/GRAM-8: construct a struct, read its fields, use them in total wrapping arithmetic, and return the sum as the exit status.";
  let p = Point(x: 3_i32, y: 4_i32);
  let s = p.x +wrap p.y;
  let status_code = cvt::<i32, u8>(s);
  return exit_status(code: status_code);
}
