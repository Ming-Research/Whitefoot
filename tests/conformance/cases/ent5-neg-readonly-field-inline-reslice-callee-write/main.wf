alias Entry = pkg::kinds::Entry;
alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias kinds = pkg::kinds;

fn clobber(v: &[Entry], at: u64) -> result: unit writes(v) contract {
  requires at < deref(v).len;
} {
  doc "Replaces one element of the range with a wide one.";
  let wide = kinds::make_entry(width: 8_u64, weight: 1_u64);
  set deref(v)[at] = wide;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "ENT-5, CALL-3: the guard bounds deref(view)[1].width, an element of a named range. The call re-slices that range at the argument, &deref(view)[1..3], which names the path view names extended by the re-slice's range step [REF-4, EFF-5]; the index 1 lies inside that inner range 1..3, so OWN-7 does not separate its range step from the index step 1 and the projected write kills the readonly-field term. The endpoint then leaves cells[c] with an unproved c < cells.len.";
  let narrow = kinds::make_entry(width: 3_u64, weight: 1_u64);
  let entries = array_filled::<Entry, 4>(value: narrow);
  let cells = array_filled::<u64, 3>(value: 7_u64);
  let view = &entries[0_u64..4_u64];
  let total = 0_u64;
  if deref(view)[1_u64].width <= cells.len {
    clobber(v: &deref(view)[1_u64..3_u64], at: 0_u64);
    for (c in 0_u64..deref(view)[1_u64].width) {
      let cell = cells[c];
      set total = total +wrap cell;
    }
  }
  return exit_status(code: 0_u8);
}
