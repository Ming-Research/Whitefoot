struct Inner {
  map: KeyedTable<u8>;
}

const bytes: Array<u8, 2> =[97_u8, 98_u8];

fn read(store: Shared<KeyedTable<Inner>>) -> result: u8 pure waits {
  let key = &bytes[0_u64..1_u64];
  let missing = &bytes[1_u64..2_u64];
  let got = 0_u8;
  atomic s = &store, e = &s^[key] {
    match e^ {
      Some(value: inner) => {
        let t = &inner^.map;
        let slot = &t^[key];
        match slot^ {
          Some(value: n) => {
            set got = n^;
          }
          None() => {
            set got = 40_u8;
          }
        }
        let absent = &t^[missing];
        match absent^ {
          Some(value: n) => {
            set got = 50_u8;
          }
          None() => {
            set got = got +wrap 2_u8;
          }
        }
        let keys = key_set_new(capacity: 2_u64);
        let first = key_set_insert(keys: &keys, key: key);
        let second = key_set_insert(keys: &keys, key: missing);
        let entries = &t^[keys];
        let batch = 0_u8;
        for (i in 0_u64..keys.len) {
          match entries^[i] {
            Some(value: n) => {
              set batch = batch +wrap n^;
            }
            None() => {
              set batch = batch +wrap 2_u8;
            }
          }
        }
        if batch != got {
          set got = 70_u8;
        }
      }
      None() => {
        set got = 60_u8;
      }
    }
  }
  return got;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let outer = keyed_table_new::<Inner>(capacity: 1_u64);
  let store = shared_new::<KeyedTable<Inner>>(value: move outer);
  let key = &bytes[0_u64..1_u64];
  atomic s = &store, e = &s^[key] {
    let table = keyed_table_new::<u8>(capacity: 1_u64);
    let t = &table;
    set t^[key] = Some<u8>(value: 7_u8);
    let inner = Inner(map: move table);
    set e^ = Some<Inner>(value: move inner);
  }
  let a = shared_share::<KeyedTable<Inner>>(shared: &store);
  let b = shared_share::<KeyedTable<Inner>>(shared: &store);
  let first = spawn read(store: move a);
  let second = spawn read(store: move b);
  let code = first +wrap second;
  return std::process::exit_status(code: code);
}
