fn probe(rows: &[Slots<u8, 8>], i: u64, j: u64, k: u64) -> result: u8 writes(rows) contract {
  requires i <= j;
  requires j < rows^.len;
  requires k < rows^[i].len;
} {
  doc "ENT-5 and OWN-7 cannot separate i from j using only i <= j. When i equals j the write replaces the supported row with an empty one, so the later inner subscript lacks its OP-4 proof.";
  set rows^[j] = slots_new::<u8, 8>();
  let value = rows^[i][k];
  return value;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Checking probe must refuse the unproved inner subscript.";
  return std::process::exit_status(code: 0_u8);
}
