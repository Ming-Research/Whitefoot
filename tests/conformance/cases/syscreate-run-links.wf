alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias IoError = std::io::IoError;
alias DirectoryRead = std::fs::DirectoryRead;
alias DirectoryWrite = std::fs::DirectoryWrite;

fn copy_name(args: &std::text::Args, position: u64, destination: &[u8]) -> next: u64 reads(args), writes(destination) contract {
  ensures next <= destination^.len;
} {
  match std::text::arg_get(args: args, position: position) {
    Ok(value: text) => {
      let length = destination^.len;
      match std::text::host_copy_name_bytes(value: &text, destination: destination, start: 0_u64, end: length) {
        Ok(value: end) => {
          return end;
        }
        Err(error: problem) => {
          return 0_u64;
        }
      }
    }
    Err(error: problem) => {
      return 0_u64;
    }
  }
}

fn kind(error: &IoError) -> result: u8 reads(error) {
  match error^ {
    NotFound(code: c, origin: o) => {
      return 3_u8;
    }
    PermissionDenied(code: c, origin: o) => {
      return 0_u8;
    }
    AlreadyExists(code: c, origin: o) => {
      return 1_u8;
    }
    NotDirectory(code: c, origin: o) => {
      return 0_u8;
    }
    IsDirectory(code: c, origin: o) => {
      return 0_u8;
    }
    DirectoryNotEmpty(code: c, origin: o) => {
      return 0_u8;
    }
    ReadOnly(code: c, origin: o) => {
      return 0_u8;
    }
    ResourceBusy(code: c, origin: o) => {
      return 0_u8;
    }
    InvalidInput(code: c, origin: o) => {
      return 0_u8;
    }
    InvalidPath(code: c, origin: o) => {
      return 2_u8;
    }
    Unsupported(code: c, origin: o) => {
      return 0_u8;
    }
    TimedOut(code: c, origin: o) => {
      return 0_u8;
    }
    DeadlinePassed() => {
      return 0_u8;
    }
    Cancelled() => {
      return 0_u8;
    }
    BrokenPipe(code: c, origin: o) => {
      return 0_u8;
    }
    WriteZero(code: c, origin: o) => {
      return 0_u8;
    }
    UnexpectedEnd(code: c, origin: o) => {
      return 0_u8;
    }
    ConnectionRefused(code: c, origin: o) => {
      return 0_u8;
    }
    ConnectionReset(code: c, origin: o) => {
      return 0_u8;
    }
    ConnectionAborted(code: c, origin: o) => {
      return 0_u8;
    }
    NotConnected(code: c, origin: o) => {
      return 0_u8;
    }
    AddressInUse(code: c, origin: o) => {
      return 0_u8;
    }
    AddressUnavailable(code: c, origin: o) => {
      return 0_u8;
    }
    ResourceExhausted(code: c, origin: o) => {
      return 0_u8;
    }
    FileTooLarge(code: c, origin: o) => {
      return 0_u8;
    }
    NoSpace(code: c, origin: o) => {
      return 0_u8;
    }
    QuotaExceeded(code: c, origin: o) => {
      return 0_u8;
    }
    CrossDevice(code: c, origin: o) => {
      return 0_u8;
    }
    DeviceFailure(code: c, origin: o) => {
      return 0_u8;
    }
    Other(code: c, origin: o) => {
      return 0_u8;
    }
  }
}

fn check_bytes(factory: &HandleFactory, root: &DirectoryRead, name: &[u8], count: u64, first: u8, second: u8) -> result: u8 reads(root), reads(name), writes(factory) waits {
  match std::fs::open_file(factory: factory, root: root, name: name, start: 0_u64, end: name^.len) {
    Ok(value: opened) => {
      let bytes = array_filled::<u8, 4>(value: 255_u8);
      let outcome = 0_u8;
      match std::fs::read_at(factory: factory, file: &opened, destination: &bytes[0_u64..2_u64], file_offset: 0_u64, start: 0_u64, end: 2_u64) {
        Ok(value: next) => {
          if next != count {
            set outcome = 31_u8;
          }
        }
        Err(error: stop) => {
          match stop {
            ReadEnd() => {
              if count != 0_u64 {
                set outcome = 32_u8;
              }
            }
            ReadFailed(error: problem) => {
              set outcome = 33_u8;
            }
          }
        }
      }
      match std::fs::read_at(factory: factory, file: &opened, destination: &bytes[2_u64..4_u64], file_offset: count, start: 0_u64, end: 2_u64) {
        Ok(value: next) => {
          set outcome = 34_u8;
        }
        Err(error: stop) => {
          match stop {
            ReadEnd() => {
            }
            ReadFailed(error: problem) => {
              set outcome = 35_u8;
            }
          }
        }
      }
      std::fs::close_read(factory: factory, file: move opened);
      if count > 0_u64 {
        if bytes[0_u64] != first {
          set outcome = 36_u8;
        }
      }
      if count > 1_u64 {
        if bytes[1_u64] != second {
          set outcome = 37_u8;
        }
      }
      return outcome;
    }
    Err(error: problem) => {
      return 30_u8;
    }
  }
}

fn taken(factory: &HandleFactory, writer: &DirectoryWrite, name: &[u8], created: u8, wrong: u8) -> result: u8 reads(name), writes(factory), writes(writer) waits {
  match std::fs::create_new_file(factory: factory, root: writer, name: name, start: 0_u64, end: name^.len) {
    Ok(value: file) => {
      std::fs::close_write(factory: factory, file: move file);
      return created;
    }
    Err(error: problem) => {
      let found = kind(error: &problem);
      if found != 1_u8 {
        return wrong;
      }
      return 0_u8;
    }
  }
}

fn absent(factory: &HandleFactory, reader: &DirectoryRead, name: &[u8]) -> result: u8 reads(reader), reads(name), writes(factory) waits {
  match std::fs::open_file(factory: factory, root: reader, name: name, start: 0_u64, end: name^.len) {
    Ok(value: file) => {
      std::fs::close_read(factory: factory, file: move file);
      return 41_u8;
    }
    Err(error: problem) => {
      let found = kind(error: &problem);
      if found != 3_u8 {
        return 42_u8;
      }
      return 0_u8;
    }
  }
}

fn exercise(factory: &HandleFactory, reader: &DirectoryRead, writer: &DirectoryWrite, dangling: &[u8], linked: &[u8], data: &[u8], target: &[u8]) -> result: u8 reads(reader), reads(dangling), reads(linked), reads(data), reads(target), writes(factory), writes(writer) waits {
  let outcome = taken(factory: factory, writer: writer, name: dangling, created: 20_u8, wrong: 21_u8);
  if outcome != 0_u8 {
    return outcome;
  }
  set outcome = taken(factory: factory, writer: writer, name: linked, created: 22_u8, wrong: 23_u8);
  if outcome != 0_u8 {
    return outcome;
  }
  set outcome = absent(factory: factory, reader: reader, name: target);
  if outcome != 0_u8 {
    return outcome;
  }
  let kept = check_bytes(factory: factory, root: reader, name: data, count: 1_u64, first: 100_u8, second: 0_u8);
  return kept;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: args, drivers: unused_driver_count, cwd: directory, stdout: out, stderr: errors, handles: factory, stdin: input, clock: clock, wall_clock: wall, stops: unused_stops, memory_meter: unused_memory_meter, host_paths: unused_host_paths, process_id: unused_process_id) = move inputs;
  let std::fs::Directory(read: reader, write: writer) = move directory;
  let dangling = array_filled::<u8, 64>(value: 0_u8);
  let dangling_end = copy_name(args: &args, position: 1_u64, destination: &dangling[0_u64..64_u64]);
  let linked = array_filled::<u8, 64>(value: 0_u8);
  let linked_end = copy_name(args: &args, position: 2_u64, destination: &linked[0_u64..64_u64]);
  let data = array_filled::<u8, 64>(value: 0_u8);
  let data_end = copy_name(args: &args, position: 3_u64, destination: &data[0_u64..64_u64]);
  let target = array_filled::<u8, 64>(value: 0_u8);
  let target_end = copy_name(args: &args, position: 4_u64, destination: &target[0_u64..64_u64]);
  let outcome = 99_u8;
  let dangling_present = dangling_end > 0_u64;
  let linked_present = linked_end > 0_u64;
  let data_present = data_end > 0_u64;
  let target_present = target_end > 0_u64;
  let links = band(dangling_present, linked_present);
  let files = band(data_present, target_present);
  if band(links, files) {
    set outcome = exercise(factory: &factory, reader: &reader, writer: &writer, dangling: &dangling[0_u64..dangling_end], linked: &linked[0_u64..linked_end], data: &data[0_u64..data_end], target: &target[0_u64..target_end]);
  }
  std::fs::close_directory(factory: &factory, directory: move reader);
  std::fs::close_directory_write(factory: &factory, directory: move writer);
  return std::process::exit_status(code: outcome);
}
