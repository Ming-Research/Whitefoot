alias IoError = std::io::IoError;
alias error_copy_class_description = std::io::error_copy_class_description;

fn main() -> status: std::process::ExitStatus pure {
  doc "The class description of NoSpace is the same bytes whatever code and origin the error carries, an empty window reports its length without writing, and a class with no host code is unavailable and leaves the destination unchanged. Before the function exists name resolution rejects; a body that read the error's code, wrote a short window or described Other or DeadlinePassed exits nonzero.";
  let plain = IoError::NoSpace(code: 0_u32, origin: 0_u8);
  let coded = IoError::NoSpace(code: 12345_u32, origin: 9_u8);
  let first = array_filled::<u8, 256>(value: 90_u8);
  let second = array_filled::<u8, 256>(value: 90_u8);
  let first_window = &first[0_u64..256_u64];
  let second_window = &second[0_u64..256_u64];
  let length = 0_u64;
  match error_copy_class_description(error: &plain, destination: first_window, start: 0_u64, end: 256_u64) {
    Ok(value: next) => {
      set length = next;
    }
    Err(error: problem) => {
      return std::process::exit_status(code: 1_u8);
    }
  }
  match error_copy_class_description(error: &coded, destination: second_window, start: 0_u64, end: 256_u64) {
    Ok(value: written) => {
      if written == length {
      } else {
        return std::process::exit_status(code: 2_u8);
      }
    }
    Err(error: refused) => {
      return std::process::exit_status(code: 3_u8);
    }
  }
  for (index in 0_u64..256_u64) {
    if first[index] == second[index] {
    } else {
      return std::process::exit_status(code: 4_u8);
    }
  }
  match error_copy_class_description(error: &plain, destination: first_window, start: 2_u64, end: 2_u64) {
    Ok(value: empty) => {
      if length == 0_u64 {
      } else {
        return std::process::exit_status(code: 5_u8);
      }
    }
    Err(error: short) => {
      match short {
        DescriptionTooSmall(required: needed) => {
          if needed == length {
          } else {
            return std::process::exit_status(code: 6_u8);
          }
        }
        DescriptionUnavailable() => {
          return std::process::exit_status(code: 7_u8);
        }
      }
    }
  }
  let other = IoError::Other(code: 28_u32, origin: 1_u8);
  match error_copy_class_description(error: &other, destination: first_window, start: 0_u64, end: 256_u64) {
    Ok(value: described) => {
      return std::process::exit_status(code: 8_u8);
    }
    Err(error: missing) => {
      match missing {
        DescriptionTooSmall(required: wanted) => {
          return std::process::exit_status(code: 9_u8);
        }
        DescriptionUnavailable() => {
        }
      }
    }
  }
  let passed = IoError::DeadlinePassed();
  match error_copy_class_description(error: &passed, destination: first_window, start: 0_u64, end: 256_u64) {
    Ok(value: timed) => {
      return std::process::exit_status(code: 10_u8);
    }
    Err(error: absent) => {
      match absent {
        DescriptionTooSmall(required: asked) => {
          return std::process::exit_status(code: 11_u8);
        }
        DescriptionUnavailable() => {
        }
      }
    }
  }
  for (position in 0_u64..256_u64) {
    if first[position] == second[position] {
    } else {
      return std::process::exit_status(code: 12_u8);
    }
  }
  return std::process::exit_status(code: 0_u8);
}
