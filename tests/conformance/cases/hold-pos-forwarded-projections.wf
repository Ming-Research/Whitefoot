struct Pair {
  left: u64;
  right: u64;
}

fn observe(left: &u64, right: &u64) -> result: Pair reads(left), reads(right) contract {
  requires held(left, right);
} {
  return Pair(left: left^, right: right^);
}

struct State {
  left: u64;
  right: u64;
  visits: u64;
}

fn forward(state: &State) -> result: Pair reads(state) contract {
  requires held(state);
} {
  return observe(left: &state^.left, right: &state^.right);
}

fn sample(state: &Shared<State>) -> result: Pair reads(state) waits {
  atomic current = &state^ {
    return forward(state: current);
  }
}
