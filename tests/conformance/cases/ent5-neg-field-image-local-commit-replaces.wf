struct Exponent {
  value: i64;
  invariant floor(e): -1000_i64 <= e.value;
}

fn make() -> result: Exponent pure {
  return Exponent(value: 0_i64);
}

fn shift(d: u8, x: i64) -> result: i64 pure {
  doc "The commit replaces the field's image by the unbounded x and kills the call result's bound, so the subtraction of a widened byte may overflow.";
  let e = make();
  set e.value = x;
  let w = cvt::<u8, i64>(d);
  let r = e.value - w;
  return r;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
