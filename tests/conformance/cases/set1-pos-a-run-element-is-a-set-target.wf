alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A subscript of a run is an ordinary set target, and the slot it commits to is the window's and not the array's.";
  let run = ring_new::<u8, 4>();
  place_back(window: &run, value: 1_u8);
  place_back(window: &run, value: 2_u8);
  place_back(window: &run, value: 3_u8);
  let taken = take_front(window: &run);
  place_back(window: &run, value: 4_u8);
  set run[0_u64] = 9_u8;
  let first = run[0_u64];
  if first == 9_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  let second = run[1_u64];
  if second == 3_u8 {
  } else {
    return exit_status(code: 2_u8);
  }
  let third = run[2_u64];
  if third == 4_u8 {
  } else {
    return exit_status(code: 3_u8);
  }
  let held = run.len;
  if held == 3_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 4_u8);
}
