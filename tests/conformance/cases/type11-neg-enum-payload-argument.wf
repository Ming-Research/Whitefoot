struct Window {
  slots: Slots<u64, 8>;
  next: u64;
  invariant cursor(window): window.next < window.slots.len;
}

fn take(window: Option<Window>) -> result: u64 pure {
  match move window {
    Some(value: w) => {
      let at = w.next;
      let got = w.slots[at];
      return got;
    }
    None() => {
      return 0_u64;
    }
  }
}

fn caller() -> result: u64 pure {
  let slots = slots_new::<u64, 8>();
  place_back(window: &slots, value: 1_u64);
  let made = Window(slots: move slots, next: 0_u64);
  set made.next = 5_u64;
  let wrapped = Some<Window>(value: move made);
  let got = take(window: move wrapped);
  return got;
}
