alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn overfill() -> result: Slots<u8, 2> pure {
  doc "A third placement into a two-slot run has cap - len == 0, and the record's own free-slot requirement is what refuses it.";
  let run = slots_new::<u8, 2>();
  place_back(window: &run, value: 7_u8);
  place_back(window: &run, value: 8_u8);
  place_back(window: &run, value: 9_u8);
  return move run;
}

fn main() -> status: ExitStatus pure {
  doc "The per-record requirement discharge under MSR-4 is part of FN-8's own judgment, and the diagnostic names the operation rather than citing a source clause, because a PRE-1 declaration has no source body.";
  return exit_status(code: 0_u8);
}
