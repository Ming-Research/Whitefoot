fn main() -> status: std::process::ExitStatus pure {
  doc "Exercises the continue transfer.";
  let visits = 0_u64;
  let sum = 0_u64;
  for @outer (i in 0_u64..4_u64) {
    for (j in 0_u64..3_u64) {
      set visits = visits +wrap 1_u64;
      set sum = sum +wrap i;
      continue @outer;
    }
  }
  for (i in 18446744073709551614_u64..18446744073709551615_u64) {
    set visits = visits +wrap 1_u64;
    continue;
  }
  for (i in 2_u64..2_u64) {
    set visits = visits +wrap 100_u64;
    continue;
  }
  if visits != 5_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  if sum != 6_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
