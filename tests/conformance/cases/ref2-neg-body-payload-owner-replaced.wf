struct PayloadOwner {
  option: Option<u64>;
}

fn replace_owner(owner: &PayloadOwner) -> result: u64 reads(owner), writes(owner) {
  doc "Replacing the containing owner invalidates the selected enum reference, so the later payload read must prove reference validity at its use.";
  let cell = &owner^.option;
  match &cell^ {
    None() => {
      return 0_u64;
    }
    Some(value: inner) => {
      let absent = None<u64>();
      set owner^ = PayloadOwner(option: absent);
      let direct = cell^.Some.value;
      return direct;
    }
  }
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
