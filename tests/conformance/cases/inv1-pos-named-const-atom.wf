alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const cap: u64 = 255_u64;

fn walk(count: u64) -> last: u64 pure contract {
  requires count <= cap;
} {
  doc "A named integer const is an affine atom: the header relation names the declared limit rather than repeating its digits, and reads exactly as the literal it names.";
  let last = 0_u64;
  for (
    i in 0_u64..count,
    invariant within: i <= cap
  ) {
    set last = i;
  }
  return last;
}

fn main() -> status: ExitStatus pure {
  let r = walk(count: 4_u64);
  return exit_status(code: 0_u8);
}
