fn require_one(view: &[u64]) -> result: u64 reads(view.len) contract {
  requires view^.len == 1_u64;
} {
  return view^.len;
}

fn inspect_page(p: &Paged<u64>) -> result: u64 reads(p) contract {
  requires 0_u64 < p^.pages.len;
} {
  if p^.pages[0_u64].len == 1_u64 {
    return require_one(view: &p^.pages[0_u64]);
  }
  return 0_u64;
}

fn inspect_segment(s: &Segments<u64>) -> result: u64 reads(s) contract {
  requires 0_u64 < s^.len;
} {
  if s^[0_u64].len == 1_u64 {
    return require_one(view: &s^[0_u64]);
  }
  return 0_u64;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
