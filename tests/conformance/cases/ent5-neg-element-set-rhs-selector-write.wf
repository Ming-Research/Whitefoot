struct Cursor {
  index: u64;
}

fn change(cursor: &Cursor) -> result: u8 writes(cursor.index) contract {
  ensures cursor^.index == 1_u64;
  ensures result == 1_u8;
} {
  set cursor^.index = 1_u64;
  return 1_u8;
}

fn probe(values: &Array<u8, 2>, cursor: &Cursor) -> result: u8 writes(values), writes(cursor.index) contract {
  requires cursor^.index == 0_u64;
} {
  set values^[cursor^.index] = change(cursor: cursor);
  return values^[cursor^.index] - 1_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
