struct Bounds {
  lo: u64;
}

fn stamp_two_ranges(first: &[u8], second: &[u8]) -> result: u64 writes(first), writes(second) {
  if 0_u64 < first^.len {
    set first^[0_u64] = 7_u8;
  }
  if 0_u64 < second^.len {
    set second^[0_u64] = 8_u8;
  }
  return 2_u64;
}

fn collide(v: &[u8], b: Bounds) -> result: u64 writes(v) contract {
  requires b.lo <= v^.len;
} {
  doc "EFF-5, OWN-7: the empty range is formed before left and right. Each formation still captures only its own endpoints, so the call writing the two overlapping ranges lacks separation whatever order the formations ran in.";
  let empty = &v^[v^.len..v^.len];
  let left = &v^[b.lo..v^.len];
  let right = &v^[b.lo..v^.len];
  let stamped = stamp_two_ranges(first: left, second: right);
  return stamped;
}
