alias Entry = pkg::kinds::Entry;
alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias kinds = pkg::kinds;

fn main() -> status: ExitStatus pure {
  doc "ENT-5: replacing the whole element writes a place containing its readonly field, so the guard's bound on entries[i].width dies; the endpoint then reads the replacement's width and the cell read owes an unproved c < cells.len.";
  let narrow = kinds::make_entry(width: 3_u64, weight: 1_u64);
  let entries = array_filled::<Entry, 4>(value: narrow);
  let cells = array_filled::<u8, 3>(value: 7_u8);
  let i = 1_u64;
  let total = 0_u64;
  if entries[i].width <= cells.len {
    set entries[i] = kinds::make_entry(width: 8_u64, weight: 1_u64);
    for (c in 0_u64..entries[i].width) {
      let cell = cells[c];
      let widened = cvt::<u8, u64>(cell);
      set total = total +wrap widened;
    }
  }
  return exit_status(code: 0_u8);
}
