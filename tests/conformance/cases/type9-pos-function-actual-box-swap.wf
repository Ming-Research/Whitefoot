interface Exchange<T: drop> {
  fn exchange(first: &T, second: &T) -> result: unit writes(first), writes(second);
}

binding BoxExchange : Exchange<Box<Slots<u64>>> {
  exchange = swap::<Box<Slots<u64>>>;
}

fn apply<T: drop, fn exchange(first: &T, second: &T) -> result: unit writes(first), writes(second)>(first: &T, second: &T) -> result: unit writes(first), writes(second) {
  doc "FN-5: swap is an ordinary explicitly instantiated function-kind actual.";
  exchange(first: first, second: second);
  return unit;
}

fn relay<T: drop, fn exchange(first: &T, second: &T) -> result: unit writes(first), writes(second)>(first: &T, second: &T) -> result: unit writes(first), writes(second) {
  doc "FN-2: the raw actual keeps its own identity when forwarded.";
  apply::<T, fn exchange>(first: first, second: second);
  return unit;
}

fn generic_exchange<T: drop>(first: &T, second: &T) -> result: unit writes(first), writes(second) {
  doc "TYPE-9: a generic body can instantiate swap's exchange parameter at its own parameter.";
  apply::<T, fn swap::<T>>(first: first, second: second);
  return unit;
}

fn member_exchange<interface Exchange<T>>(first: &T, second: &T) -> result: unit writes(first), writes(second) {
  doc "FN-5: the bound interface member exchanges the complete owning values.";
  Exchange<T>::exchange(first: first, second: second);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "TYPE-9: owning Boxes remain admissible through raw actuals, forwarding, generic actuals and interface bindings.";
  let small = box_slots_new::<u64>(capacity: 1_u64);
  let large = box_slots_new::<u64>(capacity: 64_u64);
  relay::<Box<Slots<u64>>, fn swap::<Box<Slots<u64>>>>(first: &small, second: &large);
  if small.inner.cap != 64_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  generic_exchange::<Box<Slots<u64>>>(first: &small, second: &large);
  if small.inner.cap != 1_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  member_exchange::<BoxExchange>(first: &small, second: &large);
  if small.inner.cap != 64_u64 {
    return std::process::exit_status(code: 3_u8);
  }
  if large.inner.cap != 1_u64 {
    return std::process::exit_status(code: 4_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
