alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn fill(item: u64, window: &[u64]) -> result: unit writes(window) {
  doc "Writes item into every element of the segment it was handed.";
  let count = window^.len;
  for (j in 0_u64..count) {
    set window^[j] = item;
  }
  return unit;
}

fn weigh(run: &[u64]) -> total: u64 reads(run) {
  doc "Sums every element of the run, each weighted by its position plus one, so the order of the run is observed.";
  let total = 0_u64;
  let count = run^.len;
  for (j in 0_u64..count) {
    let place = j + 1_u64;
    let weighted = run^[j] *wrap place;
    set total = total +wrap weighted;
  }
  return total;
}

fn main() -> status: ExitStatus pure {
  doc "A run of segments of lengths 1, 0, 3 and 2 is built from those lengths; each segment k is filled with k + 1 through its own range reference, and the run of every element, 1 3 3 3 4 4, is read back in segment order.";
  let lengths = box_array_filled::<u64>(count: 4_u64, value: 0_u64);
  set lengths.inner[0_u64] = 1_u64;
  set lengths.inner[2_u64] = 3_u64;
  set lengths.inner[3_u64] = 2_u64;
  let made = box_segments_filled::<u64>(lengths: &lengths.inner[0_u64..4_u64], value: 0_u64);
  match move made {
    None() => {
      return exit_status(code: 1_u8);
    }
    Some(value: segments) => {
      let count = segments.inner.len;
      if count != 4_u64 {
        return exit_status(code: 2_u8);
      }
      for (k in 0_u64..count) {
        let item = k + 1_u64;
        fill(item: item, window: &segments.inner[k]);
      }
      let empty = &segments.inner[1_u64];
      let none = empty^.len;
      if none != 0_u64 {
        return exit_status(code: 3_u8);
      }
      let total = weigh(run: &segments.inner.all);
      if total != 72_u64 {
        return exit_status(code: 4_u8);
      }
      return exit_status(code: 0_u8);
    }
  }
}
