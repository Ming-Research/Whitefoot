alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn room(a: u64, b: u64, limit: u64) -> result: u64 pure contract {
  define sum = a + b;
  define bounded = sum <= limit;
  define permitted = a <= 16_u64;
  requires bor(bounded, permitted);
  requires a <= 16_u64;
  requires b <= 16_u64;
} {
  doc "A positive disjunction does not establish either child, so no affine image may be invented for the first one and the subtraction's domain stays unproved [ENT-3, OP-2].";
  let total = a + b;
  let remaining = limit - total;
  return remaining;
}

fn main() -> status: ExitStatus pure {
  doc "No construction is needed to exercise the requirement shape.";
  return exit_status(code: 0_u8);
}
