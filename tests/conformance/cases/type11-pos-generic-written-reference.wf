struct Span {
  start: u64;
  end: u64;
  invariant ordered(span): span.start <= span.end;
}

fn replace_with<T: drop>(slot: &T, fresh: T) -> result: unit writes(slot) {
  set slot^ = move fresh;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let held = Span(start: 1_u64, end: 2_u64);
  let fresh = Span(start: 3_u64, end: 10_u64);
  replace_with::<Span>(slot: &held, fresh: fresh);
  let a = held.start;
  let b = held.end;
  let d = b - a;
  let code = cvt.wrap::<u64, u8>(d);
  return std::process::exit_status(code: code);
}
