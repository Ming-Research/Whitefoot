alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn at_most(value: u32, limit: u32) -> result: unit pure contract {
  requires value <= limit;
} {
  return unit;
}

fn at_least(value: u32, floor: u32) -> result: unit pure contract {
  requires floor <= value;
} {
  return unit;
}

fn rows(left: u32, right: u32, signed: i32) -> result: unit pure {
  let low = iand(left, 255_u32);
  at_most(value: low, limit: 255_u32);
  at_most(value: low, limit: left);
  let high = iand(right, 3840_u32);
  let joined = ior(low, high);
  at_most(value: joined, limit: 4095_u32);
  at_least(value: joined, floor: low);
  at_least(value: joined, floor: high);
  let toggled = ixor(low, high);
  at_most(value: toggled, limit: 4095_u32);
  let flipped = inot(low);
  at_least(value: flipped, floor: 4294967040_u32);
  let masked = iand(signed, 255_i32);
  let narrow = cvt::<i32, u8>(masked);
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
