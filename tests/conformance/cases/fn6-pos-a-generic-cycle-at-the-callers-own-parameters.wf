alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn walk<const n: u64>(run: &Slots<u8, n>, at: u64) -> total: u64 reads(run) contract {
  requires at <= run^.len;
} {
  doc "A call that forwards the caller's own parameters in position and kind, as this one forwards n, preserves its instance key under FN-6.";
  let held = run^.len;
  let more = at < held;
  if more {
  } else {
    return 0_u64;
  }
  let here = run^[at];
  let widened = cvt::<u8, u64>(here);
  let next = at + 1_u64;
  let rest = walk::<n>(run: run, at: next);
  return widened +wrap rest;
}

fn countdown<T: Int>(at: u64) -> total: u64 pure {
  doc "The same cycle over a type parameter.";
  let done = at == 0_u64;
  if done {
    return 0_u64;
  }
  let next = at -wrap 1_u64;
  let rest = countdown::<T>(at: next);
  return rest +wrap 1_u64;
}

fn main() -> status: ExitStatus pure {
  doc "3 + 4 from the run, then 3 from the countdown.";
  let run = slots_new::<u8, 2>();
  place_back(window: &run, value: 3_u8);
  place_back(window: &run, value: 4_u8);
  let total = walk::<2>(run: &run, at: 0_u64);
  if total == 7_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let counted = countdown::<u16>(at: 3_u64);
  if counted == 3_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
