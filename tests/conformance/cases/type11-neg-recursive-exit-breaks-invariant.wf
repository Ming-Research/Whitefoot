struct Cursor {
  slots: Slots<u64, 8>;
  next: u64;
  invariant position(cursor): cursor.next < cursor.slots.len;
}

fn make_cursor(nested: Bool) -> made: Cursor pure {
  if nested {
    let no = False();
    let inner = make_cursor(nested: no);
    set inner.next = 7_u64;
    return move inner;
  }
  let slots = slots_new::<u64, 8>();
  place_back(window: &slots, value: 1_u64);
  let built = Cursor(slots: move slots, next: 0_u64);
  return move built;
}
