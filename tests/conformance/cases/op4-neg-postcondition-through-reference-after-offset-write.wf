alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn fill(x: &Slots<u64, 4>) -> result: unit writes(x) contract {
  ensures 3_u64 <= deref(x).len;
} {
  doc "Replaces the window x names with one holding three elements.";
  let fresh = slots_new::<u64, 4>();
  place_back(window: &fresh, value: 7_u64);
  place_back(window: &fresh, value: 7_u64);
  place_back(window: &fresh, value: 7_u64);
  set deref(x) = move fresh;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "REF-1, CALL-6: fill's postcondition 3 <= deref(x).len is established at the actual's resolved exit place, the row wr = &rows[k] names, which is rows[0]. set k = 1_u64 made rows[k] name another row, so the fact does not prove the read rows[k][2_u64], which is refused.";
  let rows = slots_new::<Slots<u64, 4>, 4>();
  let a = slots_new::<u64, 4>();
  let b = slots_new::<u64, 4>();
  place_back(window: &a, value: 1_u64);
  place_back(window: &b, value: 1_u64);
  place_back(window: &rows, value: move a);
  place_back(window: &rows, value: move b);
  let k = 0_u64;
  if k < rows.len {
    let wr = &rows[k];
    set k = 1_u64;
    fill(x: wr);
    if k < rows.len {
      let v = rows[k][2_u64];
      return exit_status(code: 0_u8);
    }
  }
  return exit_status(code: 0_u8);
}
