alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Holder {
  run: Slots<u8, 4>;
}

fn regrow(old: Slots<u8, 4>) -> bigger: Slots<u8, 4> pure contract {
  ensures bigger.len == old.len;
} {
  doc "Consumes the window it is handed and hands one of the same shape back.";
  return move old;
}

fn bump(cell: u64) -> back: u64 pure contract {
  requires cell +defined 1_u64;
  ensures back == cell + 1_u64;
} {
  doc "One more than the value it is handed.";
  let raised = cell + 1_u64;
  return raised;
}

fn refill(out: &Box<u64>) -> done: unit writes(out) contract {
  requires deref(out).inner +defined 1_u64;
} {
  doc "The atomic update at a cell's content reached through a reference parameter: the old value enters the callee by value and the result is committed with no program point between.";
  set deref(out).inner = bump(cell: deref(out).inner);
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "OP-12: the atomic in-place update at each of the three place shapes a commit reinitializes - a bare binding, a field of a struct, and Box content reached through a reference parameter whose row writes that path. The old value enters the callee by value and the callee's result is committed, so the place owns exactly one valid value at every program point and none of the three needs a hole.";
  let values = array_filled::<u8, 4>(value: 0_u8);
  let bare = slots_from_array::<u8, 4>(values: values);
  set bare = regrow(old: move bare);
  let holder = Holder(run: move bare);
  set holder.run = regrow(old: move holder.run);
  let target = box_new::<u64>(value: 5_u64);
  if target.inner +defined 1_u64 {
    refill(out: &target);
  } else {
    return exit_status(code: 2_u8);
  }
  let seen = target.inner;
  if seen == 6_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
