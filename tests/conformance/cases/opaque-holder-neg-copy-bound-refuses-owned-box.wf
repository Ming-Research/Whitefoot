alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

opaque struct Holder {
  item: Box<u8>;
}

fn twice<T: copy>(value: T) -> (first: T, second: T) pure {
  doc "A body written for the copy class: it uses its value bare, twice.";
  return value, value;
}

fn forward(holder: Holder) -> (first: Holder, second: Holder) pure {
  doc "PROV-6: Holder owns a Box, which is declared nocopy, so Holder is affine and not copy [OWN-1]. A copy bound accepts copy arguments only, so instantiating twice at Holder is a hard error at the instantiation.";
  let (a, b) = twice::<Holder>(value: move holder);
  return a, b;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
