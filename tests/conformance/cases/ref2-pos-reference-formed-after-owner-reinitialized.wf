struct Pair {
  cell: Shared<u64>;
  other: Shared<u64>;
}

fn witness() -> result: u64 pure waits {
  let c = shared_new::<u64>(value: 1_u64);
  let o = shared_new::<u64>(value: 2_u64);
  let pair = Pair(cell: move c, other: move o);
  let gone = move pair.other;
  let c2 = shared_new::<u64>(value: 3_u64);
  let o2 = shared_new::<u64>(value: 4_u64);
  set pair = Pair(cell: move c2, other: move o2);
  let r = &pair.cell;
  let seen = 0_u64;
  atomic state = &r^ {
    set seen = state^;
  }
  return seen;
}

fn main() -> status: std::process::ExitStatus pure waits {
  doc "REF-2: validity is re-established only by forming the reference again. The move out of pair.other consumes pair [WIN-3], the commit reinitializes the dead binding [SET-1], and a reference formed afterwards names the new storage, so it is valid and reads the new field value 3, where a stale value 1 would exit 1.";
  let seen = witness();
  if seen == 3_u64 {
  } else {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
