alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn twice<T: copy>(value: T) -> (first: T, second: T) pure {
  doc "A body written for the copy class: it uses its value bare, twice.";
  return value, value;
}

fn main() -> status: ExitStatus pure {
  doc "PROV-6, S37: the chain copy < affine < linear is read left to right, so a `copy` bound accepts copy arguments only. An affine argument is a hard error at the instantiation, naming the parameter, the bound and the argument; the reverse direction, a copy argument at an affine bound, is admitted.";
  let payload = box_new::<u8>(value: 3_u8);
  let (a, b) = twice::<Box<u8>>(value: move payload);
  return exit_status(code: 0_u8);
}
