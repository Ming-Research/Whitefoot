alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias Value = json::Value;

fn number(v: Value) -> n: i32 pure {
  doc "Reads the program's own json value type.";
  return v.n;
}

fn main() -> status: ExitStatus pure {
  doc "The program's json and halo's json are two packages under one name.";
  let s = halo::vm::seven();
  let v = json::make(n: s);
  let n = number(v: v);
  if n == 7_i32 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
