alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn divide(n: u64, d: u64) -> return_value: u64 pure {
  doc "The same unsigned divisor-class site has nothing proving the divisor nonzero. The fact state does not discharge the obligation, so OP-2 rejects at the `infix` node carrying the residual [ENT-6]; no runtime fallback is substituted for the missing proof.";
  let q = n / d;
  return q;
}

fn main() -> return_value: ExitStatus pure {
  return exit_status(code: 0_u8);
}
