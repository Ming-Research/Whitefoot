alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn replace_last(window: &Slots<u64, 8>, value: u64) -> result: unit writes(window.last), writes(window.next), writes(window.len) contract {
  requires window^.len > 0_u64;
  ensures window^.len == entry(window)^.len;
} {
  doc "Takes and replaces the last value, publishing the unchanged window length.";
  let old = take_back(window: window);
  place_back(window: window, value: value);
  return unit;
}

fn probe(window: &Slots<u64, 8>, end: u64) -> result: u64 writes(window) contract {
  requires window^.len >= 1_u64;
  requires end <= window^.len;
} {
  doc "The helper's length postcondition carries a symbolic range endpoint bound across its last-slot write.";
  let prefix = &window^[0_u64..end];
  replace_last(window: window, value: 7_u64);
  return prefix^.len;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
