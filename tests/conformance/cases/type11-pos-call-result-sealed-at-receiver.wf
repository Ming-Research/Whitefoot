struct Stack {
  slots: Slots<u64, 8>;
  invariant nonempty(stack): stack.slots.len >= 1_u64;
}

fn fresh(first: u64) -> made: Stack pure {
  let slots = slots_new::<u64, 8>();
  place_back(window: &slots, value: first);
  let stack = Stack(slots: move slots);
  return move stack;
}

fn split(first: u64) -> (stack: Stack, extra: u64) pure {
  let made = fresh(first: first);
  return move made, 1_u64;
}

fn let_result() -> result: u64 pure {
  let stack = fresh(first: 3_u64);
  let got = stack.slots[0_u64];
  return got;
}

fn destructured_result() -> result: u64 pure {
  let (stack, extra) = split(first: 4_u64);
  let got = stack.slots[0_u64];
  let sum = got +wrap extra;
  return sum;
}

fn stored_result(stack: &Stack) -> result: u64 writes(stack) {
  set stack^ = fresh(first: 5_u64);
  let got = stack^.slots[0_u64];
  return got;
}
