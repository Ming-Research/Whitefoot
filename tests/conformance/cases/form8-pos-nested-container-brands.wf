alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn read(values: &Slots<Box<Slots<Box<u8>>>, 2>) -> result: u64 reads(values.len) {
  doc "A measure read is a place form, and one read through a reference parameter exhibits reads(p.len) on the declared row [OP-15, EFF-1].";
  return deref(values).len;
}

fn relay(values: &Slots<Box<Slots<Box<u8>>>, 2>) -> result: u64 reads(values.len) {
  doc "Written type arguments inside nested run and cell element types are substituted at their own positions, so the relayed parameter type is the same exact type [FN-2, TYPE-9].";
  return read(values: values);
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
