alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

binding ReaderHost : Host<u64> {
  call = reader;
}

fn reader(env: &u64, stack: &Box<Slots<u64>>) -> r: u64 reads(stack.inner), writes(env) {
  let n = stack^.inner.len;
  set env^ = n;
  return n;
}

interface Host<E> {
  fn call(env: &E, stack: &Box<Slots<u64>>) -> r: u64 writes(env), writes(stack) contract {
    ensures stack^.inner.len == entry(stack)^.inner.len;
  };
}

fn run<interface Host<E>>(env: &E, stack: &Box<Slots<u64>>) -> r: u64 writes(env), writes(stack) {
  let got = Host::call(env: env, stack: stack);
  return got;
}

fn main() -> status: ExitStatus pure waits {
  let stack = box_slots_new::<u64>(capacity: 4_u64);
  let env = 0_u64;
  let got = run::<ReaderHost>(env: &env, stack: &stack);
  if got != 0_u64 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
