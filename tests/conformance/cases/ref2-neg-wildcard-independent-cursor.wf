alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Node {
  value: u64;
  next: Option<Box<Node>>;
}

fn inspect(root: &Node) -> result: u64 writes(root) {
  doc "An independent cursor write may destroy a previously saved target in the same subtree.";
  let cursor = root;
  for (i in 0_u64..2_u64) {
    match deref(cursor).next {
      Some(value: child) => {
        set cursor = &deref(child).inner;
      }
      None() => {
        break;
      }
    }
  }
  let saved = cursor;
  for (i in 0_u64..2_u64) {
    match deref(cursor).next {
      Some(value: child) => {
        set cursor = &deref(child).inner;
      }
      None() => {
        break;
      }
    }
  }
  set deref(cursor).next = None<Box<Node>>();
  return deref(saved).value;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
