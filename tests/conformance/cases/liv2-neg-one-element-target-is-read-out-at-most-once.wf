alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "WIN-3: there is no take operation and no hole, so a move out of a window slot is refused wherever it is written, including in the right-hand side of a commit whose target is another slot of the same window. The restructuring names take_back, remove_at and swap; the exchange this program wants is swap(first: &grid[0_u64], second: &grid[1_u64]).";
  let grid = slots_new::<Box<Slots<u8>>, 2>();
  let small = box_slots_new::<u8>(capacity: 256_u64);
  place_back(window: &grid, value: move small);
  let large = box_slots_new::<u8>(capacity: 512_u64);
  place_back(window: &grid, value: move large);
  set grid[0_u64] = move grid[1_u64];
  let held = grid.len;
  if held == 2_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
