alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "Checked arithmetic feeding a match: an i32 overflow diverts to the Err arm (bound via give), and the recovered sentinel then feeds a second compare-match, so overflow is handled as defined behavior, never UB [OP-1, GIVE-1, OWN-13, SCOPE-3].";
  let sum = match 2000000000_i32 +checked 200000000_i32 {
    Ok(value: w) => {
      give w;
    }
    Err(error: e) => {
      give 0_i32;
    }
  }
  let label = if sum > 0_i32 {
    give 1_i32;
  } else {
    give 0_i32;
  }
  if label == 0_i32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
