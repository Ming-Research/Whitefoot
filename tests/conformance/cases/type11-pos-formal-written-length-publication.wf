struct Bounded {
  database: u64;
  invariant database_limit(value): value.database < 16_u64;
}

fn relay<A: drop, fn apply(state: &Bounded, window: &Slots<u8, 2>, marker: A) -> result: unit writes(state), writes(window) contract {
  ensures window^.len == entry(window)^.len;
}>(state: &Bounded, window: &Slots<u8, 2>, marker: A) -> result: unit writes(state), writes(window) contract {
  ensures window^.len == entry(window)^.len;
} {
  return apply(state: state, window: window, marker: move marker);
}

fn update(state: &Bounded, window: &Slots<u8, 2>, marker: u8) -> result: unit writes(state), writes(window) contract {
  ensures window^.len == entry(window)^.len;
} {
  set state^.database = 0_u64;
  if window^.len > 0_u64 {
    set window^[0_u64] = 0_u8;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let state = Bounded(database: 1_u64);
  let window = slots_new::<u8, 2>();
  place_back(window: &window, value: 7_u8);
  relay::<u8, fn update>(state: &state, window: &window, marker: 0_u8);
  return std::process::exit_status(code: 0_u8);
}
