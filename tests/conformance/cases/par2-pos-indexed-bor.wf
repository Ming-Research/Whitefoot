fn reduce() -> result: Bool pure {
  doc "PAR-2 permits colliding indexed bor updates; the incoming cell value participates once.";
  let seed = False();
  let cells = box_array_filled::<Bool>(count: 2_u64, value: seed);
  let bit = True();
  for (i in 0_u64..4_u64) {
    set cells.inner[0_u64] = bor(cells.inner[0_u64], bit);
  }
  return cells.inner[0_u64];
}

fn main() -> status: std::process::ExitStatus pure {
  let result = reduce();
  if result {
    return std::process::exit_status(code: 0_u8);
  } else {
    return std::process::exit_status(code: 1_u8);
  }
}
