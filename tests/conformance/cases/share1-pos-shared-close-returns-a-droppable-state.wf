alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn value_or_zero(found: Option<u8>) -> result: u8 pure {
  match found {
    Some(value: inner) => {
      return inner;
    }
    None() => {
      return 0_u8;
    }
  }
}

fn release_now(handle: Shared<u8>) -> result: unit pure {
  doc "Consumes the handle and ends, which releases it here rather than at the caller's scope exit.";
  return unit;
}

fn main() -> status: ExitStatus pure waits {
  let cell = shared_new::<u8>(value: 5_u8);
  let other = shared_share::<u8>(shared: &cell);
  let early = shared_close::<u8>(shared: move other);
  let first = value_or_zero(found: early);
  let spare = shared_share::<u8>(shared: &cell);
  release_now(handle: move spare);
  let late = shared_close::<u8>(shared: move cell);
  let last = value_or_zero(found: late);
  let total = first +wrap last;
  return exit_status(code: total);
}
