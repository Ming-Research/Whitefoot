fn no_count() -> made: u8 pure {
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let stats = shared_shards_new::<u8, fn no_count>();
  let count = 0_u64;
  atomic all = &stats {
    let run = &all^[0_u64..1_u64];
    set count = run^.len;
  }
  let code = cvt.wrap::<u64, u8>(count);
  return std::process::exit_status(code: code);
}
