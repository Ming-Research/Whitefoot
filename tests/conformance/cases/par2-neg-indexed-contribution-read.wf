fn reduce() -> result: u64 pure {
  doc "The contribution reads the root.";
  let cells = box_array_filled::<u64>(count: 4_u64, value: 0_u64);
  for (i in 0_u64..4_u64) {
    set cells.inner[0_u64] = cells.inner[0_u64] +wrap cells.inner[1_u64];
  }
  return cells.inner[0_u64];
}

fn main() -> status: std::process::ExitStatus pure {
  let result = reduce();
  return std::process::exit_status(code: 0_u8);
}
