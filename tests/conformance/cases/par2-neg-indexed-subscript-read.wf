fn reduce() -> result: u64 pure {
  doc "A subscript derived from a partial root value violates the root-independent selection condition; its ordinary bound is proved.";
  let cells = box_array_filled::<u64>(count: 4_u64, value: 0_u64);
  for (i in 0_u64..4_u64) {
    let bucket = cells.inner[0_u64];
    if bucket < 4_u64 {
      set cells.inner[bucket] = cells.inner[bucket] +wrap 1_u64;
    }
  }
  return cells.inner[0_u64];
}

fn main() -> status: std::process::ExitStatus pure {
  let result = reduce();
  return std::process::exit_status(code: 0_u8);
}
