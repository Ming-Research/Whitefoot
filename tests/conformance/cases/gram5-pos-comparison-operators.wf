alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn ordered(low: u64, high: u64) -> result: Bool pure contract {
  requires low < high;
} {
  doc "Every integer comparison is one infix expression over two atoms, and a call writes its type arguments after the delimiter.";
  let below = low < high;
  let at_most = low <= high;
  let above = high > low;
  let at_least = high >= low;
  let same = low == low;
  let differs = low != high;
  let narrow = 7_u8;
  let wide = cvt::<u8, u32>(narrow);
  let widened = wide == 7_u32;
  let first = band(below, at_most);
  let second = band(above, at_least);
  let third = band(same, differs);
  let both = band(first, second);
  let all = band(both, third);
  return band(all, widened);
}

fn main() -> status: ExitStatus pure {
  let all = ordered(low: 1_u64, high: 2_u64);
  if all {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
