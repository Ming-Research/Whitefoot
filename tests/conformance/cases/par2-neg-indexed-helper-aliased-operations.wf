fn add_one(p: &Array<u64, 1>) -> result: unit writes(p) {
  doc "Add one to the sole cell.";
  set p^[0_u64] = p^[0_u64] +wrap 1_u64;
  return unit;
}

fn double_cell(p: &Array<u64, 1>) -> result: unit writes(p) {
  doc "Double the sole cell.";
  set p^[0_u64] = p^[0_u64] *wrap 2_u64;
  return unit;
}

fn reduce() -> result: u64 pure {
  doc "Aliased references update one storage with incompatible operations.";
  let cells = array_filled::<u64, 1>(value: 1_u64);
  let first = &cells;
  let second = first;
  for (i in 0_u64..2_u64) {
    add_one(p: first);
    double_cell(p: second);
  }
  return cells[0_u64];
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Sequential source yields ten; separate add and multiply families would yield twelve.";
  let observed = reduce();
  if observed == 10_u64 {
    return std::process::exit_status(code: 0_u8);
  }
  return std::process::exit_status(code: 1_u8);
}
