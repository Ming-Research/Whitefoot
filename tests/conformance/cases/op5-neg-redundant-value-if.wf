alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn choose(x: u64) -> r: u64 pure contract {
  requires x != 0_u64;
} {
  doc "Value selection uses the ordinary condition judgment.";
  let selected = if x != 0_u64 {
    give x;
  } else {
    give 1_u64;
  }
  return selected;
}

fn main() -> status: ExitStatus pure {
  doc "The checker judges every body.";
  return exit_status(code: 0_u8);
}
