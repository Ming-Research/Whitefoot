alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn choose(x: u64) -> r: u64 pure {
  doc "Origin transport equates the two bindings, but their comparison is not an L0 fact, so the test is admitted.";
  let m = iand(x, 1_u64);
  let n = iand(x, 1_u64);
  if m <= n {
    return 1_u64;
  }
  return 2_u64;
}

fn main() -> status: ExitStatus pure {
  doc "The checker judges every body.";
  return exit_status(code: 0_u8);
}
