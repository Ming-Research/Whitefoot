alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const limit: u64 = 7_u64;

fn widen<const n: u8>() -> r: u64 pure {
  doc "Reads the const generic at its written type u8.";
  return cvt::<u8, u64>(n);
}

fn main() -> status: ExitStatus pure {
  doc "A named const is an open const argument judged by its declared type, not its value: limit is u64 and the parameter is u8, although 7 fits u8.";
  let v = widen::<limit>();
  return exit_status(code: 0_u8);
}
