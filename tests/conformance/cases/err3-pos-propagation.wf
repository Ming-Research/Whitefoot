alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn half_checked(x: i64) -> result: Result<i64, Overflow> pure {
  let d = x +checked x;
  let v = propagate d;
  let r = v +checked 1_i64;
  return r;
}

fn main() -> status: ExitStatus pure {
  let big = 4611686018427387904_i64;
  let a = half_checked(x: 20_i64);
  match a {
    Ok(value: v) => {
      if v == 41_i64 {
      } else {
        return exit_status(code: 1_u8);
      }
    }
    Err(error: e) => {
      return exit_status(code: 2_u8);
    }
  }
  let b = half_checked(x: big);
  match b {
    Ok(value: v) => {
      return exit_status(code: 3_u8);
    }
    Err(error: e) => {
    }
  }
  return exit_status(code: 0_u8);
}
