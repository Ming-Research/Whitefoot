alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

interface Inspect<T> {
  fn length(values: &T) -> result: u64 reads(values);
}

fn shorter(values: &Array<u64, 4>) -> result: u64 reads(values) {
  doc "The instantiated member takes a reference to an eight-slot array; this actual takes a four-slot one.";
  return deref(values)[0_u64];
}

binding Narrow : Inspect<Array<u64, 8>> {
  length = shorter;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
