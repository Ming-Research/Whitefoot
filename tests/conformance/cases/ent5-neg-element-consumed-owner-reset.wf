nocopy struct Owner {
  digits: Array<u8, 2>;
}

fn consume(owner: Owner) -> result: unit pure {
  return unit;
}

fn probe(owner: Owner) -> result: u8 pure contract {
  requires 1_u8 <= owner.digits[0_u64];
} {
  consume(owner: move owner);
  let zeros = array_filled::<u8, 2>(value: 0_u8);
  set owner = Owner(digits: zeros);
  return owner.digits[0_u64] - 1_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
