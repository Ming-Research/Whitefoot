alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Holder {
  payload: Slots<u8, 4>;
  count: u64;
}

fn main() -> status: ExitStatus pure {
  doc "An established member length qualifies the indexed write while no commit has killed that fact.";
  let first = slots_new::<u8, 4>();
  for @fill_first (
    at in 0_u64..4_u64,
    invariant grown: first.len == at
  ) {
    place_back(window: &first, value: 7_u8);
  }
  let holder = Holder(payload: move first, count: 0_u64);
  let size = holder.payload.len;
  let allocated_length = size == 4_u64;
  if allocated_length {
    set holder.payload[3_u64] = 5_u8;
  }
  return exit_status(code: 0_u8);
}
