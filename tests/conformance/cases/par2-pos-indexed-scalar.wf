fn reduce() -> result: u64 pure {
  doc "The scalar and indexed accumulators recombine independently.";
  let cells = array_filled::<u64, 4>(value: 5_u64);
  let total = 10_u64;
  for (i in 0_u64..4_u64) {
    set total = total +wrap 2_u64;
    set cells[0_u64] = 1_u64 +wrap cells[0_u64];
  }
  return total +wrap cells[0_u64];
}

fn main() -> status: std::process::ExitStatus pure {
  let result = reduce();
  if result != 27_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
