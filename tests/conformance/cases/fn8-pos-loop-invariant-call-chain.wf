alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn scaled(value: u64, limit: u64) -> result: u64 pure contract {
  requires value <= limit;
  ensures result <= limit;
} {
  return value;
}

fn clamp_walk(count: u64, limit: u64) -> last: u64 pure {
  let cursor = 0_u64;
  for (
    i in 0_u64..count,
    invariant bounded: cursor <= limit
  ) {
    let picked = scaled(value: cursor, limit: limit);
    set cursor = picked;
  }
  return cursor;
}

fn main() -> status: ExitStatus pure {
  let last = clamp_walk(count: 4_u64, limit: 0_u64);
  if last == 0_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
