struct Bounds {
  lo: u64;
}

fn stamp_two_ranges(first: &[u8], second: &[u8]) -> result: u64 writes(first), writes(second) {
  if 0_u64 < first^.len {
    set first^[0_u64] = 7_u8;
  }
  if 0_u64 < second^.len {
    set second^[0_u64] = 8_u8;
  }
  return 2_u64;
}

fn collide(v: &[u8], b: Bounds) -> result: u64 writes(v) contract {
  requires b.lo <= v^.len;
} {
  doc "EFF-5, OWN-7: left and right capture the same values and overlap whenever either is nonempty. The empty range formed after them captures its own endpoints, which say nothing about theirs, so the call writing both lacks separation.";
  let left = &v^[b.lo..v^.len];
  let right = &v^[b.lo..v^.len];
  let empty = &v^[v^.len..v^.len];
  let stamped = stamp_two_ranges(first: left, second: right);
  return stamped;
}
