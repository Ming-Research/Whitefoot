const names: Array<u8, 2> =[97_u8, 98_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let table = keyed_table_new::<u8>(capacity: 0_u64);
  let store = shared_new::<KeyedTable<u8>>(value: move table);
  atomic s = &store, a = &s^[&names[0_u64..1_u64]], b = &s^[&names[1_u64..2_u64]] {
    set a^ = Some<u8>(value: 1_u8);
    set b^ = Some<u8>(value: 2_u8);
  }
  let count = 0_u64;
  atomic s = &store {
    set count = keyed_table_count::<u8>(table: s);
  }
  if count == 2_u64 {
    return std::process::exit_status(code: 6_u8);
  }
  return std::process::exit_status(code: 1_u8);
}
