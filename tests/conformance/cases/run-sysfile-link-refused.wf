alias Args = std::text::Args;
alias DirectoryRead = std::fs::DirectoryRead;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias arg_get = std::text::arg_get;
alias close_directory = std::fs::close_directory;
alias close_read = std::fs::close_read;
alias exit_status = std::process::exit_status;
alias open_read = std::fs::open_read;
alias read_at = std::fs::read_at;
alias relative_path = std::fs::relative_path;

const subdirectory: Array<u8, 3> =[115_u8, 117_u8, 98_u8];

fn reads_marker(args: &Args, root: &DirectoryRead, files: &HandleFactory, position: u64) -> result: Bool reads(args), reads(root), writes(files) waits {
  match arg_get(args: args, position: position) {
    Ok(value: text) => {
      match relative_path(value: move text) {
        Ok(value: path) => {
          match open_read(factory: files, root: root, path: &path) {
            Ok(value: file) => {
              let bytes = array_filled::<u8, 2>(value: 0_u8);
              let window = &bytes[0_u64..2_u64];
              match read_at(factory: files, file: &file, destination: window, file_offset: 0_u64, start: 0_u64, end: 2_u64) {
                Ok(value: next) => {
                  close_read(factory: files, file: move file);
                  if next != 1_u64 {
                    return False();
                  }
                  return bytes[0_u64] == 81_u8;
                }
                Err(error: stop) => {
                  close_read(factory: files, file: move file);
                  return False();
                }
              }
            }
            Err(error: problem) => {
              return False();
            }
          }
        }
        Err(error: rejected) => {
          return False();
        }
      }
    }
    Err(error: absent) => {
      return False();
    }
  }
}

fn refuses_open(args: &Args, root: &DirectoryRead, files: &HandleFactory, position: u64) -> result: Bool reads(args), reads(root), writes(files) waits {
  match arg_get(args: args, position: position) {
    Ok(value: text) => {
      match relative_path(value: move text) {
        Ok(value: path) => {
          match open_read(factory: files, root: root, path: &path) {
            Ok(value: file) => {
              close_read(factory: files, file: move file);
              return False();
            }
            Err(error: problem) => {
              return True();
            }
          }
        }
        Err(error: rejected) => {
          return False();
        }
      }
    }
    Err(error: absent) => {
      return False();
    }
  }
}

fn exercise(args: &Args, files: &HandleFactory, root: &DirectoryRead) -> result: u8 reads(args), reads(root), writes(files) waits {
  let entry = reads_marker(args: args, root: root, files: files, position: 1_u64);
  if entry {
  } else {
    return 10_u8;
  }
  let nested = reads_marker(args: args, root: root, files: files, position: 2_u64);
  if nested {
  } else {
    return 11_u8;
  }
  let escaping_file = refuses_open(args: args, root: root, files: files, position: 3_u64);
  if escaping_file {
  } else {
    return 12_u8;
  }
  let inner_file = refuses_open(args: args, root: root, files: files, position: 4_u64);
  if inner_file {
  } else {
    return 13_u8;
  }
  let inner_directory = refuses_open(args: args, root: root, files: files, position: 5_u64);
  if inner_directory {
  } else {
    return 14_u8;
  }
  let parent_directory = refuses_open(args: args, root: root, files: files, position: 6_u64);
  if parent_directory {
  } else {
    return 15_u8;
  }
  return 0_u8;
}

fn open_below(args: &Args, files: &HandleFactory, cwd: &DirectoryRead) -> result: u8 reads(args), reads(cwd), writes(files) waits {
  match std::fs::open_directory(factory: files, root: cwd, name: &subdirectory[0_u64..3_u64], start: 0_u64, end: 3_u64) {
    Ok(value: root) => {
      let outcome = exercise(args: args, files: files, root: &root);
      close_directory(factory: files, directory: move root);
      return outcome;
    }
    Err(error: problem) => {
      return 2_u8;
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "open_read refuses a symbolic link at any component, as the name operations do, so a path never leaves the directory it is given. Below the directory sub, ok.txt and inner/real.txt are read, while escape.txt (a link to a file beside sub), inner/alias.txt (a link to a file inside sub), dirlink/real.txt (dirlink is a link to inner, inside sub) and up/outside.txt (up is a link to the directory holding sub) open nothing. Refusing the directory sub exits 2.";
  let Inputs(args: arguments, cwd: root_directory, handles: files, ..) = move inputs;
  let std::fs::Directory(read: root, write: root_write) = move root_directory;
  std::fs::close_directory_write(factory: &files, directory: move root_write);
  let outcome = open_below(args: &arguments, files: &files, cwd: &root);
  close_directory(factory: &files, directory: move root);
  return exit_status(code: outcome);
}
