fn fill(source: &[u64], i: u64, j: u64) -> result: unit writes(source) contract {
  define next = i * j;
  requires 0_u64 < source^.len;
  ensures forall small(k in 0_u64..1_u64): source^[next] <= 7_u64;
} {
  doc "The postcondition applies the same range-term formation rule as a requirement.";
  set source^[0_u64] = 3_u64;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
