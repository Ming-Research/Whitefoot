alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

interface Inspect<T> {
  fn inspect(value: &T) -> result: unit pure;
}

fn ignore(value: &Box<u64>) -> result: unit pure {
  return unit;
}

binding Bound : Inspect<Box<u64>> {
  inspect = ignore;
}

fn spare() -> result: unit pure {
  return unit;
}

struct Holder<interface Inspect<T>> {
  value: T;
}

fn inspect(value: &Holder<Bound<fn spare>>) -> result: unit pure {
  doc "A written function actual occupies its own explicit argument-list position [FN-3] and cannot stand in a type-argument position of a nominal. FN-2 refuses the written argument independently of any stored-field analysis.";
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
