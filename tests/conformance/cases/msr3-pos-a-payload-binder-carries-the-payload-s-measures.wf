alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "MSR-3: the payload placement over an enum exactly one of whose variants carries fields. The construct carries the window's measures into the payload, the match consumes the scrutinee, and the datum minted before that consume is read at the arm binder that names the payload, so the window keeps its figure across both events and the placement into it is discharged.";
  let block = slots_new::<u8, 8>();
  place_back(window: &block, value: 1_u8);
  let slot = Some<Slots<u8, 8>>(value: move block);
  match slot {
    None() => {
      return exit_status(code: 1_u8);
    }
    Some(value: back) => {
      place_back(window: &back, value: 2_u8);
      let seen = back[0_u64];
      if seen == 1_u8 {
      } else {
        return exit_status(code: 2_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}
