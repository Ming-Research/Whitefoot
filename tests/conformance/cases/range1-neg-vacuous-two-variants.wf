enum Instr {
  Jump(t: u64);
  Branch(t: u64, c: u64);
  Halt();
}

fn follow(code: &Box<Slots<Instr>>, pc: u64) -> r: u64 reads(code) contract {
  requires pc < code^.inner.len;
  requires forall order(j in 0_u64..code^.inner.len): code^.inner[j].Jump.t < code^.inner[j].Branch.t;
} {
  doc "The conclusion reads the Jump target and the Branch target of one element, which no element holds at once, so it states nothing.";
  return pc;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
