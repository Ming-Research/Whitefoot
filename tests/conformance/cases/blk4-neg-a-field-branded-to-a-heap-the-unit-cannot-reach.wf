alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Bytes {
  v: Box<Slots<u8>>;
}

fn main() -> status: ExitStatus pure {
  doc "A runtime-capacity run reaches a field only as the content of its Box, and that field needs no store brand, region parameter or selected provider input: there is one heap and a Box carries no brand. Declaring this type requires no entry heap the unit must reach.";
  return exit_status(code: 0_u8);
}
