alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nodrop struct Token {
  id: u64;
}

interface Inspect<T: drop> {
  fn inspect(value: &T) -> result: unit pure;
}

fn ignore(value: &Token) -> result: unit pure {
  doc "Observes nothing, so the row is empty.";
  return unit;
}

binding TokenInspect : Inspect<Token> {
  inspect = ignore;
}

fn main() -> status: ExitStatus pure {
  doc "PROV-6: every actual application must satisfy its group's written linearity bound. Satisfaction is the chain copy < affine < linear read left to right, so an affine bound accepts copy and affine arguments only; Token carries the linear modifier and is refused here. The matching affine application and the ownership-closed linear one are the other two variants.";
  return exit_status(code: 0_u8);
}
