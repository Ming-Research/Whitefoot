enum Mode {
  Strict();
  Loose();
}

fn need_below(value: u64, bound: u64) -> result: unit pure contract {
  requires value < bound;
} {
  return unit;
}

fn pick(vals: &Slots<u64, 8>, i: u64, n: u64, mode: Mode) -> result: unit reads(vals) contract {
  requires i < vals^.len;
  requires forall strict(k in 0_u64..vals^.len) when mode is Strict: vals^[k] < n;
} {
  doc "The guard tests the own-mode parameter mode. In the Strict arm of a match on mode its tag is Strict's, so the instance at i bounds vals^[i].";
  match mode {
    Strict() => {
      need_below(value: vals^[i], bound: n);
    }
    Loose() => {
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
