alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn read(holder: Box<i32>) -> function_result: i32 pure {
  doc "FN-1: returning a Box where its content type is required is a return type mismatch; the mechanical fix is move holder.inner, the Box content being reached by the ordinary field step [TYPE-9], and transferring the cell itself is a distinct affine move.";
  return move holder;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
