alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Pair {
  left: i32;
  right: i32;
}

enum Packet {
  Data(item: Pair);
  Empty();
}

fn steal(packet: &Packet) -> return_value: unit reads(packet) {
  doc "A payload binder derived from matching through a reference names the scrutinee path, which is not rooted in a live own-mode binding of this function, so its affine referent cannot be moved out.";
  match deref(packet) {
    Data(item: element) => {
      let stolen = move deref(element);
    }
    Empty() => {
    }
  }
  return unit;
}

fn main() -> return_value: ExitStatus pure {
  return exit_status(code: 0_u8);
}
