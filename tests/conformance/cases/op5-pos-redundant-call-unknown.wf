alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn echo(x: u64) -> r: u64 pure {
  doc "The result has no published relation.";
  return x;
}

fn choose() -> r: u64 pure {
  doc "The implementation of echo supplies no caller fact.";
  let value = echo(x: 0_u64);
  if value == 0_u64 {
    return 1_u64;
  }
  return 2_u64;
}

fn main() -> status: ExitStatus pure {
  doc "The checker judges every body.";
  return exit_status(code: 0_u8);
}
