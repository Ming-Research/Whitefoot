struct Bytes {
  v: Box<Slots<u8>>;
}

struct Frame {
  flags: u64;
  page: Box<Array<u8>>;
}

fn main() -> status: ExitStatus pure {
  doc "TYPE-9: a runtime-capacity shape is admitted in a field exactly as the content of a Box; a Box carries no brand, so no program-start selection determines declaration validity.";
  return exit_status(code: 0_u8);
}
