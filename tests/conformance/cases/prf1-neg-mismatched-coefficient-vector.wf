alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn mismatched(first: u8, first_limit: u8, second: u8, second_limit: u8, third: u8, third_limit: u8) -> result: unit pure contract {
  requires first <= first_limit;
  requires second <= second_limit;
  requires third <= third_limit;
  requires first_limit <= 20_u8;
  requires second_limit <= 20_u8;
  requires third_limit <= 20_u8;
} {
  invariant first_bound: first <= first_limit;
  invariant second_bound: second <= second_limit;
  invariant third_bound: third <= third_limit;
  invariant total_bound: 2_u8 * first + 2_u8 * second + 2_u8 * third <= 2_u8 * first_limit + 2_u8 * second_limit + 2_u8 * third_limit {
    use 2 times first_bound;
    use 3 times second_bound;
    use 5 times third_bound;
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
