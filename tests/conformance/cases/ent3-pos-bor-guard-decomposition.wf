alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn get(table: Slots<u8, 4>, symbol: u64) -> result: u8 pure contract {
  requires 4_u64 <= table.len;
} {
  doc "ENT-3 signed Boolean decomposition: establishing a signed goal also establishes every member of its structural decomposition. The else edge of the bor guard establishes the negative sign of the disjunction, and decomp of a negative bor(A, B) is the conjunctive read of both negatives. So the edge establishes minus below and minus above, whose projections negate to symbol at least zero and symbol below 4; with 4 at most table.len required, the guarded subscript's bounds obligation discharges and the function is accepted. Decomposition is a finite structural walk at establishment: no composition, no De Morgan rewriting, no search.";
  let below = symbol < 0_u64;
  let above = symbol >= 4_u64;
  let invalid = bor(below, above);
  if invalid {
    return 0_u8;
  } else {
    return table[symbol];
  }
}

fn main() -> status: ExitStatus pure {
  doc "A full array converted into a full window supplies the declared length.";
  let seed = array_filled::<u8, 4>(value: 7_u8);
  let table = slots_from_array::<u8, 4>(values: seed);
  let value = get(table: move table, symbol: 2_u64);
  if value == 7_u8 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
