alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

interface Factory<T: drop> {
  fn make(value: T) -> result: T pure;
}

fn retain(value: Slots<u8, 4>) -> result: Slots<u8, 4> pure {
  doc "Returning the incoming owner is ordinary signature, row and contract matching; handing an owner back does not duplicate it [OWN-1].";
  return move value;
}

binding Identity : Factory<Slots<u8, 4>> {
  make = retain;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
