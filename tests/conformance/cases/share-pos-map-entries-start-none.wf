const names: Array<u8, 2> =[97_u8, 98_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let store_map = map_new::<u8>(capacity: 0_u64);
  let store = shared_new::<ConcurrentHashMap<u8>>(value: move store_map);
  let first = &names[0_u64..1_u64];
  let second = &names[1_u64..2_u64];
  let before = 9_u8;
  atomic t = &store {
    match t^[first] {
      Some(value: observed) => {
        set before = observed^;
      }
      None() => {
        set before = 0_u8;
      }
    }
    set t^[first] = Some<u8>(value: 7_u8);
  }
  atomic t = &store {
    set t^[second] = None<u8>();
  }
  let counted = 0_u64;
  atomic t = &store {
    set counted = map_count::<u8>(map: t);
  }
  let code = 10_u8 +wrap before;
  if counted == 1_u64 {
    set code = code +wrap 3_u8;
  }
  return std::process::exit_status(code: code);
}
