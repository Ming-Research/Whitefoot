const names: Array<u8, 2> =[97_u8, 98_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let store = shared_map_new::<u8>(capacity: 0_u64);
  let first = &names[0_u64..1_u64];
  let second = &names[1_u64..2_u64];
  let before = 9_u8;
  atomic slot = &store[first] {
    match slot^ {
      Some(value: held) => {
        set before = held^;
      }
      None() => {
        set before = 0_u8;
      }
    }
    set slot^ = Some<u8>(value: 7_u8);
  }
  atomic slot = &store[second] {
    set slot^ = None<u8>();
  }
  let counted = 0_u64;
  atomic t = &store {
    set counted = map_count::<u8>(map: t);
  }
  let code = 10_u8 +wrap before;
  if counted == 1_u64 {
    set code = code +wrap 3_u8;
  }
  return std::process::exit_status(code: code);
}
