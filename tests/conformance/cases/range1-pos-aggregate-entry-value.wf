struct Block {
  entry_slot: u32;
}

fn fill<T: copy>(value: T, other: T) -> result: Array<T, 1> pure contract {
  ensures forall same(k in 0_u64..result.len): result[k] == value;
} {
  let made = array_filled::<T, 1>(value: value);
  set value = other;
  return made;
}

fn main() -> status: std::process::ExitStatus pure {
  let first = Block(entry_slot: 0_u32);
  let other = Block(entry_slot: 1_u32);
  let targets = fill::<Block>(value: first, other: other);
  if targets[0_u64].entry_slot != 0_u32 {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
