fn mark(flag: Shared<u8>) -> result: u8 pure may_wait {
  atomic value = &flag {
    set value^ = 1_u8;
  }
  return 5_u8;
}

fn main() -> status: std::process::ExitStatus pure must_wait {
  let flag = shared_new::<u8>(value: 0_u8);
  let handle = shared_share::<u8>(shared: &flag);
  let weight = spawn mark(flag: move handle);
  let seen = 0_u8;
  if seen == 0_u8 {
    atomic value = &flag {
      set seen = value^;
    }
    set seen = seen +wrap weight;
  }
  return std::process::exit_status(code: seen);
}
