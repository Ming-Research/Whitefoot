struct Counter {
  count: u64;
}

fn reset(counter: &Counter) -> result: unit writes(counter.count) contract {
  ensures counter^.count == 1_u64;
} {
  set counter^.count = 1_u64;
  return unit;
}

fn need_one(digit: u8) -> result: unit pure contract {
  requires 1_u8 <= digit;
} {
  return unit;
}

fn inspect(counter: &Counter, digits: &Array<u8, 1>) -> result: unit writes(counter.count), reads(digits) contract {
  requires forall leading(k in 0_u64..1_u64) when 0_u64 < counter^.count: 1_u8 <= digits^[k];
} {
  doc "The call replaces the count image and proves its new value is one; that new value cannot activate the old range guard over untouched digits.";
  reset(counter: counter);
  let digit = digits^[0_u64];
  need_one(digit: digit);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
