alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn f(cell: &Box<i32>, x: i32) -> function_result: i32 pure, reads(cell) {
  doc "pure is the unique spelling of the empty row and is not an entry that another entry may follow, so the comma after it fails the enclosing fn_decl continuation under DIAG-1/GRAM-2. The program still rejects and pure still cannot combine with another entry.";
  return x;
}

fn main() -> status: ExitStatus pure {
  doc "Driver.";
  let cell = box_new::<i32>(value: 0_i32);
  let a = f(cell: &cell, x: 7_i32);
  return exit_status(code: 0_u8);
}
