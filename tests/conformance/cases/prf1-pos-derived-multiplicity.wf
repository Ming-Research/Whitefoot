alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn inner(stride_src: u64, padding: u64, height: u64, row: u64, width: u64) -> at: u64 pure contract {
  requires stride_src <= 2048_u64;
  requires padding <= 64_u64;
  requires height <= 2048_u64;
  requires row < height;
  requires width <= stride_src;
} {
  doc "A padded-bitmap row offset. The stride is computed rather than passed in, which is what every real stride is.";
  let stride = stride_src + padding;
  let span = stride * height;
  let base = stride * row;
  let at = base + width;
  invariant fits: base + width <= span {
    use stride times (row < height);
    use (width <= stride);
  }
  return at;
}

fn main() -> status: ExitStatus pure {
  let at = inner(stride_src: 40_u64, padding: 3_u64, height: 11_u64, row: 4_u64, width: 37_u64);
  return exit_status(code: 0_u8);
}
