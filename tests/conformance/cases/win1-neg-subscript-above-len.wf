alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "WIN-1: the subscript obligation is stated against len and never against cap, so an offset below cap but not below len is rejected.";
  let r = slots_new::<u64, 4>();
  place_back(window: &r, value: 11_u64);
  let seen = r[2_u64];
  if seen == 0_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
