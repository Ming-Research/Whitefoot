fn nonzero(value: u64) -> result: unit pure contract {
  requires value != 0_u64;
} {
  return unit;
}

fn selected(value: u64) -> result: unit pure {
  match value {
    0_u64 => {
    }
    else => {
    }
  }
  nonzero(value: value);
  return unit;
