alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "box_segments_filled returns its cell itself, with no refusal to match: lengths 3 and 4 build two segments of those lengths, and no lengths at all build an empty run.";
  let lengths = box_array_filled::<u64>(count: 2_u64, value: 0_u64);
  set lengths.inner[0_u64] = 3_u64;
  set lengths.inner[1_u64] = 4_u64;
  let small = box_segments_filled::<u64>(lengths: &lengths.inner[0_u64..2_u64], value: 9_u64);
  let count = small.inner.len;
  if count != 2_u64 {
    return exit_status(code: 1_u8);
  }
  let second = &small.inner[1_u64];
  let size = second^.len;
  if size != 4_u64 {
    return exit_status(code: 2_u8);
  }
  let empty = box_segments_filled::<u64>(lengths: &lengths.inner[0_u64..0_u64], value: 9_u64);
  let none = empty.inner.len;
  if none != 0_u64 {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
