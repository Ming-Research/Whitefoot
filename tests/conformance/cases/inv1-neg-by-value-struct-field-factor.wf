struct Counter {
  count: u64;
}

fn inspect(s: Counter) -> result: u64 pure {
  doc "A field of a by-value struct parameter is no reference field place: INV-1 admits a field factor only when its path is written from a reference parameter, so the invariant's factor is refused as a field selection.";
  invariant bounded: 0_u64 <= s.count;
  let capacity = s.count;
  return capacity;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
