const names: Array<u8, 3> =[97_u8, 98_u8, 99_u8];

fn reclaim_reserve(store: &Shared<ConcurrentHashMap<Box<u64>>>, meter: &std::process::MemoryMeter) -> freed: u64 reads(store), writes(meter) {
  doc "Release reserve through a callee that only reads the map handle.";
  let freed = std::process::release_map_reserve::<Box<u64>>(map: store, meter: meter);
  return freed;
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  doc "Release reserve directly and through another handle without changing entries.";
  let std::process::Inputs(cwd: directory, handles: factory, memory_meter: meter, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let store = shared_map_new::<Box<u64>>(capacity: 1_u64);
  let code = 42_u8;
  let a = &names[0_u64..1_u64];
  let b = &names[1_u64..2_u64];
  let c = &names[2_u64..3_u64];
  atomic t = &store {
    let first = box_new::<u64>(value: 1_u64);
    set t^[a] = Some<Box<u64>>(value: move first);
    let second = box_new::<u64>(value: 2_u64);
    set t^[b] = Some<Box<u64>>(value: move second);
  }
  let freed = std::process::release_map_reserve::<Box<u64>>(map: &store, meter: &meter);
  let again = reclaim_reserve(store: &store, meter: &meter);
  let other = shared_share::<ConcurrentHashMap<Box<u64>>>(shared: &store);
  let through = std::process::release_map_reserve::<Box<u64>>(map: &other, meter: &meter);
  let count = 9_u64;
  let seen = 0_u64;
  atomic t = &store {
    set count = map_count::<Box<u64>>(map: t);
    let entry_b = &t^[b];
    match entry_b^ {
      Some(value: held) => {
        set seen = held^.inner;
      }
      None() => {
      }
    }
    let third = box_new::<u64>(value: 3_u64);
    set t^[c] = Some<Box<u64>>(value: move third);
  }
  let after = 9_u64;
  atomic t = &store {
    set after = map_count::<Box<u64>>(map: t);
  }
  if count != 2_u64 {
    set code = 1_u8;
  }
  if seen != 2_u64 {
    set code = 2_u8;
  }
  if after != 3_u64 {
    set code = 3_u8;
  }
  return std::process::exit_status(code: code);
}
