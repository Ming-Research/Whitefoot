fn need_value(v: u64) -> result: u64 pure contract {
  requires v != 0_u64;
} {
  doc "Divides ten by v.";
  let q = 10_u64 / v;
  return q;
}

fn probe(p: &u64) -> result: u64 reads(p) {
  doc "saved^ is the caller's cell. After p is rebound to one, the guard p^ != 0 reads one, so it does not prove the requirement on the value read through saved.";
  let saved = &p^;
  let one = 1_u64;
  set p = &one;
  if p^ != 0_u64 {
    let r = need_value(v: saved^);
    return r;
  }
  return 0_u64;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The caller's cell holds zero.";
  let zero = 0_u64;
  let r = probe(p: &zero);
  if r == 10_u64 {
    return std::process::exit_status(code: 0_u8);
  }
  return std::process::exit_status(code: 1_u8);
}
