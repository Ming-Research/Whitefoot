struct Store {
  map: KeyedTable<u8>;
  count: u8;
}

const names: Array<u8, 2> =[97_u8, 98_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let table = keyed_table_new::<u8>(capacity: 2_u64);
  let state = Store(map: move table, count: 0_u8);
  let store = shared_new::<Store>(value: move state);
  let got = 0_u8;
  let counted = 0_u64;
  atomic s = &store, t = &s^.map {
    let first = &names[0_u64..1_u64];
    set t^[first] = Some<u8>(value: 5_u8);
    let second = &names[1_u64..2_u64];
    match t^[first] {
      Some(value: held) => {
        set t^[second] = Some<u8>(value: 4_u8);
        set got = held^;
      }
      None() => {
        set got = 2_u8;
      }
    }
    set s^.count = got;
  }
  let tens = got *wrap 10_u8;
  let ones = cvt.wrap::<u64, u8>(counted);
  let code = tens +wrap ones;
  return std::process::exit_status(code: code);
}
