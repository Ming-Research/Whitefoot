alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Packet<const n: u8> {
  doc "A storage shape's size is the argument of its u64 const parameter, so a u8 const generic is not a size.";
  bytes: Slots<u8, n>;
}

fn main() -> status: ExitStatus pure {
  doc "The field's type is rejected at its const node, whether or not any instance exists.";
  return exit_status(code: 0_u8);
}
