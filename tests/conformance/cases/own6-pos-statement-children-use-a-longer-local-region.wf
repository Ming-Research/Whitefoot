alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Holder {
  value: Box<u64>;
}

struct Counter {
  total: u64;
}

fn exchange(target: &Holder, incoming: Box<u64>) -> previous: u64 writes(target.value) {
  doc "The old content is read out, then one commit installs the incoming cell and releases the old one.";
  let previous = deref(target).value.inner;
  set deref(target).value = move incoming;
  return previous;
}

fn observe(owner: &Holder, incoming: Box<u64>) -> (old: u64, current: u64) writes(owner.value) {
  doc "A by-value parameter contributes no effect entry, so the row states only the write of the referenced field.";
  let old = exchange(target: owner, incoming: move incoming);
  let current = deref(owner).value.inner;
  return old, current;
}

fn tick(counter: &Counter) -> result: unit writes(counter.total) {
  doc "One declared write of the referenced field.";
  let seen = deref(counter).total;
  let raised = seen +wrap 1_u64;
  set deref(counter).total = raised;
  return unit;
}

fn repeat(counter: &Counter) -> result: unit writes(counter.total) {
  doc "Sequential statements each form their own access to the same referenced field.";
  let index = 0_u64;
  loop @again {
    if index == 2_u64 {
      break @again;
    }
    tick(counter: counter);
    let seen = deref(counter).total;
    let raised = seen +wrap 1_u64;
    set deref(counter).total = raised;
    let next_index = index +wrap 1_u64;
    set index = next_index;
  }
  return unit;
}

fn acquire_twice() -> result: u64 pure {
  doc "Allocation carries no effect entry, so two sequential cells leave the row empty and both results stay alive to the sum.";
  let first = box_new::<u64>(value: 31_u64);
  let second = box_new::<u64>(value: 47_u64);
  let left = first.inner;
  let right = second.inner;
  let sum = left +wrap right;
  return sum;
}

fn main() -> status: ExitStatus pure {
  doc "An argument reference lasts exactly through its call, statement-end retirement permits sequential calls, and owned results stay alive.";
  let cell = box_new::<u64>(value: 17_u64);
  let owner = Holder(value: move cell);
  let incoming = box_new::<u64>(value: 29_u64);
  let (old, current) = observe(owner: &owner, incoming: move incoming);
  if old != 17_u64 {
    return exit_status(code: 1_u8);
  }
  if current != 29_u64 {
    return exit_status(code: 2_u8);
  }
  let held = owner.value.inner;
  if held != 29_u64 {
    return exit_status(code: 3_u8);
  }
  let counter = Counter(total: 0_u64);
  repeat(counter: &counter);
  let sum = acquire_twice();
  if sum != 78_u64 {
    return exit_status(code: 4_u8);
  }
  if counter.total != 4_u64 {
    return exit_status(code: 5_u8);
  }
  return exit_status(code: 0_u8);
}
