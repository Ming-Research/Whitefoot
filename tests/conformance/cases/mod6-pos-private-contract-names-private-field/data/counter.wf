fn start() -> counter: Counter pure {
  return Counter(count: 0_u64, limit: 1_u64);
}

fn bump(counter: &Counter) -> result: unit writes(counter.count) contract {
  requires counter^.limit > counter^.count;
} {
  doc "A private function's contract may name the module's private fields, since only this module calls it.";
  let next = counter^.count + 1_u64;
  set counter^.count = next;
  return unit;
}

fn step(counter: &Counter) -> result: unit writes(counter) {
  if counter^.limit > counter^.count {
    bump(counter: counter);
  }
  return unit;
}
