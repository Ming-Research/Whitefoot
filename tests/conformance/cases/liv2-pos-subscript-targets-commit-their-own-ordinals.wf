alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn two_bytes(bound: u64) -> (small: u8, large: u8) pure {
  doc "Two results from one call.";
  return 1_u8, 2_u8;
}

fn main() -> status: ExitStatus pure {
  doc "SET-1, OP-4: one commit writes one place, and a subscript in a target is an ordinary target - its base and its offset are evaluated during target evaluation and its OP-4 obligation is judged exactly as in read position. The two ordinals of one call land at the binders of a destructuring let, and each binder is then committed at its own window slot; the exit code reports the byte the second window received.";
  let left_values = array_filled::<u8, 4>(value: 0_u8);
  let left = slots_from_array::<u8, 4>(values: left_values);
  let right_values = array_filled::<u8, 4>(value: 0_u8);
  let right = slots_from_array::<u8, 4>(values: right_values);
  let (small, large) = two_bytes(bound: 4_u64);
  set left[0_u64] = small;
  set right[0_u64] = large;
  let seen = right[0_u64];
  return exit_status(code: seen);
}
