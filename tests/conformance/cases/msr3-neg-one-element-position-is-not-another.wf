fn main() -> status: ExitStatus pure {
  doc "MSR-3, OWN-7: an element placement writes the element position it names and no other. The commit at blocks[0] carries that window's measures to blocks[0], and the two literal offsets are provably distinct, so nothing was established about blocks[1] and the subscript inside it has nothing to discharge against.";
  let blocks = slots_new::<Slots<u8, 8>, 2>();
  let first = slots_new::<u8, 8>();
  let second = slots_new::<u8, 8>();
  place_back(window: &blocks, value: move first);
  place_back(window: &blocks, value: move second);
  let third = slots_new::<u8, 8>();
  place_back(window: &third, value: 1_u8);
  set blocks[0_u64] = move third;
  let seen = blocks[1_u64][0_u64];
  if seen == 1_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
