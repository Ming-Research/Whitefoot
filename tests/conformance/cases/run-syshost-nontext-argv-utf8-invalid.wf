alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias arg_get = std::text::arg_get;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias host_copy_utf8 = std::text::host_copy_utf8;
alias host_utf8_len = std::text::host_utf8_len;

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "The ordinary host_copy_utf8 implementation reports invalid text for the arranged non-UTF-8 argument. The outcome is a normal enum match; no semantic operand class or target qualification applies.";
  let Inputs(args: args, cwd: unused_cwd, stdout: unused_stdout, stderr: unused_stderr, handles: entry_factory, stdin: unused_stdin) = move inputs;
  close_directory(factory: &entry_factory, directory: move unused_cwd);
  match arg_get(args: &args, position: 1_u64) {
    Ok(value: text) => {
      match host_utf8_len(value: &text) {
        Ok(value: measured) => {
          return exit_status(code: 10_u8);
        }
        Err(error: invalid) => {
          return exit_status(code: 0_u8);
        }
      }
    }
    Err(error: absent) => {
      return exit_status(code: 11_u8);
    }
  }
}
