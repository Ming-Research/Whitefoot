alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn release_at_exit<T: drop, const n: u64>(run: Slots<T, n>) -> result: unit pure contract {
  requires run.len == 0_u64;
} {
  doc "PROV-6: a window whose element type is affine is affine, so the compiler-derived release carries it off the return edge. The walk visits the window's elements before the backing, so the release needs no emptiness premise of its own; the written requirement records only that this instance is in fact empty.";
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "A constant-capacity window starts empty, so the requirement holds at the call and the release is derived on the callee's return edge.";
  let empty = slots_new::<u64, 4>();
  release_at_exit::<u64, 4>(run: move empty);
  return exit_status(code: 0_u8);
}
