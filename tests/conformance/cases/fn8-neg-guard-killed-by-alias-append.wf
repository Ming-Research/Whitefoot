fn fill(w: &Slots<u64, 4>) -> result: unit writes(w) {
  doc "q and r both name the caller's window. The guard proves the append through r; that append writes the window's len, which kills the guard's fact, so the second append through q is unproved.";
  let q = &w^;
  let r = &w^;
  if q^.len < q^.cap {
    place_back(window: r, value: 1_u64);
    place_back(window: q, value: 2_u64);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The window starts empty.";
  let w = slots_new::<u64, 4>();
  fill(w: &w);
  return std::process::exit_status(code: 0_u8);
}
