struct Inner {
  map: KeyedTable<u8>;
}

struct Store {
  inner: Inner;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let table = keyed_table_new::<u8>(capacity: 0_u64);
  let inner = Inner(map: move table);
  let state = Store(inner: move inner);
  let store = shared_new::<Store>(value: move state);
  let counted = 0_u64;
  atomic s = &store, t = &s^.inner.map {
    let copied = &s^.inner;
    set counted = keyed_table_count::<u8>(table: &copied^.map);
  }
  return std::process::exit_status(code: 0_u8);
}
