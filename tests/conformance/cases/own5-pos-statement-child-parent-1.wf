alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Cell {
  value: u64;
}

struct Pair {
  left: Cell;
  right: Cell;
}

fn change(cell: &Cell) -> result: u64 writes(cell.value) {
  doc "Writes the cell it was handed and returns an unrelated number.";
  set deref(cell).value = 9_u64;
  return 7_u64;
}

fn main() -> status: ExitStatus pure {
  doc "Two calls reaching disjoint fields through one reference each write their own path, and the whole value is written again after both have ended.";
  let l = Cell(value: 3_u64);
  let r = Cell(value: 5_u64);
  let pair = Pair(left: l, right: r);
  let holder = &pair;
  let first = change(cell: &deref(holder).left);
  let second = change(cell: &deref(holder).right);
  set deref(holder).left.value = 13_u64;
  return exit_status(code: 0_u8);
}
