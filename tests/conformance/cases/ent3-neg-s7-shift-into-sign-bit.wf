alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn nonnegative(value: i32) -> result: unit pure contract {
  requires 0_i32 <= value;
} {
  return unit;
}

fn raised(signed: i32) -> result: unit pure {
  let sign = iand(signed, 1_i32);
  let shifted = ishl.wrap(sign, 31_u32);
  nonnegative(value: shifted);
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
