alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const lookup: Array<u8, 8> =[0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8];

fn clamp(value: u64) -> result: u64 pure contract {
  ensures result <= 8_u64;
} {
  if value <= 7_u64 {
    return value;
  }
  return 7_u64;
}

fn relay(value: u64) -> result: u64 pure contract {
  ensures result <= 7_u64;
} {
  let clamped = clamp(value: value);
  return clamped;
}

fn select<T: Int>(value: T, index: u64) -> result: u8 pure {
  let bounded = relay(value: index);
  return lookup[bounded];
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
