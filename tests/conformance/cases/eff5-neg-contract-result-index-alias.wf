fn helper(source: &[u64], target: &[u64], j: u64) -> result: u64 writes(target[j]) contract {
  requires target^.len == 3_u64;
  requires j < 3_u64;
  ensures forall same(k in 0_u64..1_u64): source^[result] == source^[result];
} {
  set target^[j] = 1_u64;
  return 0_u64;
}

fn caller() -> result: unit pure {
  let source = array_filled::<u64, 3>(value: 0_u64);
  let result = helper(source: &source[0_u64..3_u64], target: &source[0_u64..3_u64], j: 2_u64);
  return unit;
}
