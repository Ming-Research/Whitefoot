enum Instr {
  Jump(t: u64);
  Branch(t: u64, c: u64);
  Halt();
}

fn need_below(value: u64, bound: u64) -> result: unit pure contract {
  requires value < bound;
} {
  return unit;
}

fn follow(code: &Box<Slots<Instr>>, pc: u64) -> r: u64 reads(code) contract {
  requires pc < code^.inner.len;
  requires forall targets(j in 0_u64..code^.inner.len): code^.inner[j].Jump.t < code^.inner.len, code^.inner[j].Branch.t < code^.inner.len;
} {
  doc "Returns the step after pc. A Jump's target and a Branch's target are each in bounds by their own conclusion of targets, which holds where its own variant is held.";
  let n = code^.inner.len;
  match code^.inner[pc] {
    Jump(t: jump_to) => {
      let jump = jump_to^;
      need_below(value: jump, bound: n);
      return jump;
    }
    Branch(t: branch_to, ..) => {
      let branch = branch_to^;
      need_below(value: branch, bound: n);
      return branch;
    }
    Halt() => {
      return pc;
    }
  }
}

fn run(code: &Box<Slots<Instr>>) -> r: u64 reads(code) contract {
  requires 0_u64 < code^.inner.len;
  requires forall jumps(j in 0_u64..code^.inner.len): code^.inner[j].Jump.t < code^.inner.len;
  requires forall branches(j in 0_u64..code^.inner.len): code^.inner[j].Branch.t < code^.inner.len;
} {
  doc "Proves each conclusion of follow's targets from its own fact.";
  let landed = follow(code: code, pc: 0_u64);
  return landed;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
