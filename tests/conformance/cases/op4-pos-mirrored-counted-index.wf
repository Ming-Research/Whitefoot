alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn reverse(bytes: &[u8]) -> result: unit writes(bytes) contract {
  requires bytes^.len >= 1_u64;
} {
  let count = bytes^.len;
  let last = count - 1_u64;
  for (i in 0_u64..count) {
    let mirror = last - i;
    if i < mirror {
      let front = bytes^[i];
      let back = bytes^[mirror];
      set bytes^[i] = back;
      set bytes^[mirror] = front;
    }
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
