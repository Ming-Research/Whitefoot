alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn filled<T: copy, const n: u64>(value: T) -> result: Slots<T, n> pure contract {
  ensures result.len >= n;
  ensures result.cap <= result.len;
} {
  doc "Builds a window of n slots, every one holding a copy of value; the copy bound is what admits the bare repeated use.";
  let built = slots_new::<T, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: built.len >= at,
    invariant spare: built.cap - built.len + at >= n
  ) {
    place_back(window: &built, value: value);
  }
  return move built;
}

fn read_halves(run: Slots<u8, 8>) -> total: u64 pure contract {
  requires 8_u64 <= run.len;
} {
  doc "Two disjoint logical ranges over one window.";
  let seen = 0_u64;
  for (at in 0_u64..4_u64) {
    let byte = run[at];
  }
  for (at in 4_u64..8_u64) {
    let byte = run[at];
  }
  return seen;
}

fn main() -> status: ExitStatus pure {
  doc "MSR-1, OP-4: a subscript offset is a logical offset naming the slot at physical offset (origin + i) mod cap, so its obligation is against len and never against cap. A Slots window begins at slot zero, so the map is the identity here and the injectivity sentence's conclusion - two disjoint logical ranges of one measured value describe disjoint storage - follows immediately from len <= cap, which MSR-2 publishes as a standing fact rather than as an obligation any occurrence submits. The two counted loops walk two disjoint ranges of one window and every subscript discharges against len.";
  let run = filled::<u8, 8>(value: 0_u8);
  let total = read_halves(run: move run);
  if total == 0_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
