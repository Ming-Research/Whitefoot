alias MemoryMeter = std::process::MemoryMeter;

fn memory_readings(meter: &MemoryMeter) -> result: u64 writes(meter) {
  let peer = std::process::meter_share(meter: meter);
  let heap = std::process::heap_in_use(meter: meter);
  let resident = std::process::resident_bytes(meter: &peer);
  return heap +wrap resident;
}
