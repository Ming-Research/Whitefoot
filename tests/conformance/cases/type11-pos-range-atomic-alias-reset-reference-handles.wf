struct ZeroesAliasRefReset {
  cells: Array<u64, 1>;
  invariant(c): forall zero(k in 0_u64..c^.cells.len): c^.cells[k] == 0_u64;
}

fn need_aliasrefreset(z: &ZeroesAliasRefReset) -> result: unit pure {
  return unit;
}

fn update_aliasrefreset(first: &Shared<ZeroesAliasRefReset>, second: &Shared<ZeroesAliasRefReset>) -> result: unit reads(first), reads(second) waits {
  atomic a = &first^, b = &second^ {
    set a^.cells[0_u64] = 1_u64;
    set a^.cells[0_u64] = 0_u64;
    need_aliasrefreset(z: b);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let cells = array_filled::<u64, 1>(value: 0_u64);
  let initial = ZeroesAliasRefReset(cells: cells);
  let shared = shared_new::<ZeroesAliasRefReset>(value: initial);
  update_aliasrefreset(first: &shared, second: &shared);
  return std::process::exit_status(code: 0_u8);
}
