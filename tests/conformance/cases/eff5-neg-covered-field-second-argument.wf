alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Stats {
  count: u64;
  total: u64;
}

fn record(stats: &Stats, extra: &u64) -> result: unit reads(stats), reads(extra), writes(stats.count) {
  doc "EFF-5: reads(stats) and writes(stats.count) come from one argument and are not compared with each other, but every entry of the other argument is.";
  let whole = deref(stats);
  let added = deref(extra);
  set deref(stats).count = whole.total +wrap added;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "The written field is also passed as the second argument, so the write through stats overlaps the read through extra.";
  let stats = Stats(count: 1_u64, total: 7_u64);
  record(stats: &stats, extra: &stats.count);
  return exit_status(code: 0_u8);
}
