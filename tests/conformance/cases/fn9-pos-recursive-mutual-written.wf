fn first(depth: u64) -> done: u64 pure contract {
  ensures done == 1_u64;
} {
  if depth > 0_u64 {
    let next = depth - 1_u64;
    let inner = second(depth: next);
    let difference = inner - 1_u64;
    return inner;
  }
  return 1_u64;
}

fn second(depth: u64) -> done: u64 pure contract {
  ensures done == 1_u64;
} {
  if depth > 0_u64 {
    let next = depth - 1_u64;
    let inner = first(depth: next);
    let difference = inner - 1_u64;
    return inner;
  }
  return 1_u64;
}

fn main() -> status: std::process::ExitStatus pure {
  let odd = first(depth: 3_u64);
  let even = second(depth: 4_u64);
  return std::process::exit_status(code: 0_u8);
}
