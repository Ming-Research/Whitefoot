alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn bounded_total(first: u8, first_limit: u8, second: u8, second_limit: u8, third: u8, third_limit: u8) -> total: u8 pure contract {
  requires first <= first_limit;
  requires second <= second_limit;
  requires third <= third_limit;
  requires first_limit <= 80_u8;
  requires second_limit <= 80_u8;
  requires third_limit <= 93_u8;
  ensures total <= 253_u8;
} {
  let first_two = first + second;
  let total = first_two + third;
  return total;
}

fn main() -> status: ExitStatus pure {
  let total = bounded_total(first: 1_u8, first_limit: 8_u8, second: 2_u8, second_limit: 8_u8, third: 3_u8, third_limit: 8_u8);
  if total == 6_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
