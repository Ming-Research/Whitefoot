fn probe(cursor: u64) -> result: unit pure {
  doc "The disequality survives until a later statement supplies its weak bound.";
  if cursor == 4_u64 {
    return unit;
  }
  if cursor <= 4_u64 {
    invariant tightened: cursor <= 3_u64;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
