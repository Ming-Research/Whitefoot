alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum State {
  Ready();
}

nocopy enum StepError {
  Failed();
}

fn forward(incoming: Result<State, StepError>) -> return_value: Result<i32, StepError> pure {
  doc "OWN-1: propagate records the concrete tag-only Ok payload type, so the bound state remains Copy across repeated matches.";
  let state = propagate incoming;
  match state {
    Ready() => {
    }
  }
  match state {
    Ready() => {
    }
  }
  return Ok<i32, StepError>(value: 0_i32);
}

fn main() -> return_value: ExitStatus pure {
  return exit_status(code: 0_u8);
}
