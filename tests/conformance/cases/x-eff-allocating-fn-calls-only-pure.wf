alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn bump(x: i32) -> function_result: i32 pure {
  doc "A pure helper that allocates nothing and calls no writing callee.";
  return x +wrap 1_i32;
}

fn f(cell: &Box<i32>, x: i32) -> function_result: i32 writes(cell) {
  doc "Declares a write of the cell content, but the body only calls a pure function and performs no such write, so the row is declared-but-unexhibited [EFF-2]. Allocation and release carry no effect entry at all [STOR-8], so no row is justified by them either.";
  let a = bump(x: x);
  return a;
}

fn main() -> status: ExitStatus pure {
  doc "Driver.";
  let cell = box_new::<i32>(value: 0_i32);
  let a = f(cell: &cell, x: 7_i32);
  return exit_status(code: 0_u8);
}
