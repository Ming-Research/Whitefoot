struct Window {
  slots: Slots<u64, 8>;
  next: u64;
  invariant cursor(window): window.next < window.slots.len;
}

fn spoil() -> made: Option<Window> pure {
  let slots = slots_new::<u64, 8>();
  place_back(window: &slots, value: 1_u64);
  let made = Window(slots: move slots, next: 0_u64);
  let wrapped = Some<Window>(value: move made);
  match &wrapped {
    Some(value: w) => {
      set w^.next = 5_u64;
    }
    None() => {
    }
  }
  return move wrapped;
}
