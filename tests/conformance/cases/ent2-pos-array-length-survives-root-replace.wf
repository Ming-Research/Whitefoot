alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy struct Samples {
  values: Array<u32, 4>;
}

fn main() -> status: ExitStatus pure {
  doc "[ENT-2] the implicit len = N of an Array<T, N> place holds at every program point. An element read feeding a branch condition puts a join on the path, and the OP-11 swap of the nocopy owners' root bindings then kills every relation supported by their array fields [ENT-5]. The length equality is a function of the field's type rather than a fact that had to survive, so closure still discharges the later subscripts [ENT-4, OP-4]; the program observes the exchanged values and exits 0.";
  let initial = array_filled::<u32, 4>(value: 1_u32);
  let samples = Samples(values: initial);
  let before = samples.values[0_u64];
  if before == 1_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  let replacement = array_filled::<u32, 4>(value: 9_u32);
  let fresh = Samples(values: replacement);
  swap(first: &samples, second: &fresh);
  let after = samples.values[0_u64];
  if after == 9_u32 {
  } else {
    return exit_status(code: 2_u8);
  }
  let restored = fresh.values[0_u64];
  if restored == 1_u32 {
  } else {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
