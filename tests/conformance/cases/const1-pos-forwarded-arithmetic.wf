alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn filled<T: copy, const n: u64>(value: T) -> result: Slots<T, n> pure contract {
  ensures result.len == n;
} {
  doc "Builds a run of n slots, every one holding a copy of value; the copy bound is what admits the bare repeated use.";
  let block = array_filled::<T, n>(value: value);
  let built = slots_from_array::<T, n>(values: block);
  return move built;
}

fn doubled<const n: u64>(value: u64) -> result: Slots<u64, n * 2> pure {
  doc "One-operation const arithmetic: a const-expression is at most one operation over two terms, exactly the shape GRAM-6 fixes for expressions. n * 2 is usable as a Slots<T, n> capacity and forwardable as a const targ, and each concrete instantiation evaluates it to one u64 value at monomorphization.";
  let built = filled::<u64, n * 2>(value: value);
  return move built;
}

fn main() -> status: ExitStatus pure {
  doc "The forwarded const-expression reaches a concrete capacity of six, which the caller reads back and then subscripts against.";
  let cells = doubled::<3>(value: 7_u64);
  let count = cells.len;
  if count == 6_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let last = cells[5_u64];
  if last == 7_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
