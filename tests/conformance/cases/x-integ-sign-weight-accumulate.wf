alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Sign {
  Neg();
  Zero();
  Pos();
}

fn classify(x: i32) -> function_result: Sign pure {
  doc "Classify an integer's sign; the closed-set result is consumed by match at each call site [FN-5].";
  if x < 0_i32 {
    return Sign::Neg();
  } else if x == 0_i32 {
    return Sign::Zero();
  } else {
    return Sign::Pos();
  }
}

fn weight(x: i32) -> function_result: i32 pure {
  doc "Map a sign to a weight; matching the own Sign moves it exactly once [OWN-13].";
  match classify(x: x) {
    Neg() => {
      return 0_i32;
    }
    Zero() => {
      return 1_i32;
    }
    Pos() => {
      return 2_i32;
    }
  }
}

fn main() -> status: ExitStatus pure {
  doc "Accumulate sign-weights of three inputs via cross-fn enum dispatch, then verify the sum [OP-1, OWN-13].";
  let neg = 0_i32 -wrap 5_i32;
  let wa = weight(x: neg);
  let wb = weight(x: 0_i32);
  let wc = weight(x: 7_i32);
  if wa +defined wb {
  } else {
    return exit_status(code: 202_u8);
  }
  let s0 = wa + wb;
  if s0 +defined wc {
  } else {
    return exit_status(code: 203_u8);
  }
  let s1 = s0 + wc;
  if s1 == 3_i32 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
