struct ZeroesAliasHelperReset {
  cells: Array<u64, 1>;
  invariant(c): forall zero(k in 0_u64..c^.cells.len): c^.cells[k] == 0_u64;
}

fn need_aliashelperreset(z: &ZeroesAliasHelperReset) -> result: unit pure {
  return unit;
}

fn overwrite_aliashelperreset(cell: &u64) -> result: unit writes(cell) {
  set cell^ = 1_u64;
  return unit;
}

fn update_aliashelperreset(first: Shared<ZeroesAliasHelperReset>, second: Shared<ZeroesAliasHelperReset>) -> result: unit pure waits {
  atomic a = &first, b = &second {
    overwrite_aliashelperreset(cell: &a^.cells[0_u64]);
    set a^.cells[0_u64] = 0_u64;
    need_aliashelperreset(z: b);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
