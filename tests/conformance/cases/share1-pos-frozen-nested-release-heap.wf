alias MemoryMeter = std::process::MemoryMeter;

struct Node {
  child: Frozen<Box<Array<u8>>>;
}

fn discard_child(value: Frozen<Box<Array<u8>>>) -> result: unit pure {
  return unit;
}

fn discard(value: Frozen<Node>) -> result: unit pure {
  return unit;
}

fn exercise(meter: &MemoryMeter, baseline: u64) -> result: Bool writes(meter) {
  let bytes = box_array_filled::<u8>(count: 4096_u64, value: 7_u8);
  let child = frozen_new::<Box<Array<u8>>>(value: move bytes);
  let elsewhere = frozen_share::<Box<Array<u8>>>(frozen: &child);
  let node = Node(child: move child);
  let root = frozen_new::<Node>(value: move node);
  let first = frozen_share::<Node>(frozen: &root);
  let second = frozen_share::<Node>(frozen: &root);
  let during = std::process::heap_in_use(meter: meter);
  if during <= baseline {
    return False();
  }
  discard_child(value: move elsewhere);
  let after_child = std::process::heap_in_use(meter: meter);
  if after_child != during {
    return False();
  }
  discard(value: move root);
  let after_root = std::process::heap_in_use(meter: meter);
  if after_root != during {
    return False();
  }
  discard(value: move first);
  let after_first = std::process::heap_in_use(meter: meter);
  if after_first != during {
    return False();
  }
  discard(value: move second);
  let after_last = std::process::heap_in_use(meter: meter);
  return after_last == baseline;
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  let std::process::Inputs(cwd: directory, handles: factory, memory_meter: meter, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let before = std::process::heap_in_use(meter: &meter);
  let released = exercise(meter: &meter, baseline: before);
  let after = std::process::heap_in_use(meter: &meter);
  if released {
    if after == before {
      return std::process::exit_status(code: 0_u8);
    }
  }
  return std::process::exit_status(code: 1_u8);
}
