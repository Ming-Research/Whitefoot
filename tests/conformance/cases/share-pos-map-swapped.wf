const names: Array<u8, 2> =[97_u8, 98_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let store = shared_map_new::<u8>(capacity: 2_u64);
  let first = &names[0_u64..1_u64];
  let second = &names[1_u64..2_u64];
  atomic t = &store {
    set t^[first] = Some<u8>(value: 1_u8);
    set t^[second] = Some<u8>(value: 2_u8);
  }
  let fresh = shared_map_new::<u8>(capacity: 2_u64);
  let left = 9_u64;
  let taken = 0_u64;
  atomic t = &store, f = &fresh {
    swap(first: t, second: f);
    set left = map_count::<u8>(map: t);
    set taken = map_count::<u8>(map: f);
  }
  let again = shared_share::<ConcurrentHashMap<u8>>(shared: &fresh);
  let kept = 0_u64;
  atomic f = &fresh, g = &again {
    swap(first: f, second: g);
    set kept = map_count::<u8>(map: g);
  }
  if left != 0_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  let tens = taken *wrap 10_u64;
  let total = tens +wrap kept;
  let code = cvt.wrap::<u64, u8>(total);
  return std::process::exit_status(code: code);
}
