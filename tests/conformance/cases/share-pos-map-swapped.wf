const names: Array<u8, 2> =[97_u8, 98_u8];

struct Pair {
  left: ConcurrentHashMap<u8>;
  right: ConcurrentHashMap<u8>;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let left_map = map_new::<u8>(capacity: 2_u64);
  let right_map = map_new::<u8>(capacity: 2_u64);
  let pair = Pair(left: move left_map, right: move right_map);
  let store = shared_new::<Pair>(value: move pair);
  let first = &names[0_u64..1_u64];
  let second = &names[1_u64..2_u64];
  atomic t = &store {
    set t^.left[first] = Some<u8>(value: 1_u8);
    set t^.left[second] = Some<u8>(value: 2_u8);
  }
  let left = 9_u64;
  let taken = 0_u64;
  atomic t = &store {
    swap(first: &t^.left, second: &t^.right);
    set left = map_count::<u8>(map: &t^.left);
    set taken = map_count::<u8>(map: &t^.right);
  }
  let kept = 0_u64;
  atomic t = &store {
    swap(first: &t^.right, second: &t^.right);
    set kept = map_count::<u8>(map: &t^.right);
  }
  if left != 0_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  let tens = taken *wrap 10_u64;
  let total = tens +wrap kept;
  let code = cvt.wrap::<u64, u8>(total);
  return std::process::exit_status(code: code);
}
