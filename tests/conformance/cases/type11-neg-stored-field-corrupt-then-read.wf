struct Index {
  value: u64;
  invariant bounded(index): index.value < 16_u64;
}

struct Holder {
  index: Index;
}

fn corrupt_read(table: &Array<u64, 16>) -> result: u64 reads(table) {
  let seed = Index(value: 3_u64);
  let holder = Holder(index: seed);
  set holder.index.value = 31_u64;
  let at = holder.index.value;
  let got = table^[at];
  return got;
}
