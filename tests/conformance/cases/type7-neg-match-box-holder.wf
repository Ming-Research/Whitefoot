alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum State {
  Ready();
}

fn inspect(holder: Box<State>) -> function_result: unit pure {
  doc "TYPE-5: a match scrutinee must have an enum type, and a Box holder is an opaque struct; the enclosed enum is the field inner, so the scrutinee is written holder.inner [TYPE-9].";
  match holder {
    Ready() => {
    }
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
