struct Window {
  slots: Slots<u64, 8>;
  next: u64;
  invariant cursor(window): window.next < window.slots.len;
}

fn take(window: Option<Window>) -> result: u64 pure {
  match move window {
    Some(value: w) => {
      let at = w.next;
      let got = w.slots[at];
      return got;
    }
    None() => {
      return 0_u64;
    }
  }
}

fn make() -> made: Option<Window> pure {
  let slots = slots_new::<u64, 8>();
  place_back(window: &slots, value: 7_u64);
  let made = Window(slots: move slots, next: 0_u64);
  return Some<Window>(value: move made);
}

fn main() -> status: std::process::ExitStatus pure {
  let made = make();
  let got = take(window: move made);
  let none = None<Window>();
  let zero = take(window: move none);
  let sum = got +wrap zero;
  let code = cvt.wrap::<u64, u8>(sum);
  return std::process::exit_status(code: code);
}
