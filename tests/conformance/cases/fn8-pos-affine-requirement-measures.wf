alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn fill(first: &[u64], second: &[u64], output: &[u64]) -> result: u64 reads(first.len), reads(second.len), writes(output) contract {
  requires deref(first).len <= 16_u64;
  requires deref(second).len <= 16_u64;
  requires deref(first).len + deref(second).len <= deref(output).len;
} {
  doc "Two length observations are read as place forms rather than calls [OP-15], so the affine requirement constrains their images directly; their sum bounds the one write into the caller-provided output. The whole-output write subsumes its descriptor read [EFF-1], while the two input measure reads remain explicit.";
  let a = deref(first).len;
  let b = deref(second).len;
  let capacity = deref(output).len;
  let total = a + b;
  invariant fits: total <= capacity;
  if total > 0_u64 {
    let last = total - 1_u64;
    set deref(output)[last] = 7_u64;
  }
  return total;
}

fn main() -> status: ExitStatus pure {
  let first = array_filled::<u64, 3>(value: 0_u64);
  let second = array_filled::<u64, 5>(value: 0_u64);
  let output = array_filled::<u64, 8>(value: 0_u64);
  let a = &first[0_u64..3_u64];
  let b = &second[0_u64..5_u64];
  let destination = &output[0_u64..8_u64];
  let count = fill(first: a, second: b, output: destination);
  if count != 8_u64 {
    return exit_status(code: 1_u8);
  }
  let seen = output[7_u64];
  if seen != 7_u64 {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
