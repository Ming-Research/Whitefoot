struct ZeroesAliasPartialPartition {
  cells: Array<u64, 1>;
  invariant(c): forall zero(k in 0_u64..c^.cells.len): c^.cells[k] == 0_u64;
}

fn need_aliaspartialpartition(z: &ZeroesAliasPartialPartition) -> result: unit pure {
  return unit;
}

fn update_aliaspartialpartition(first: Shared<ZeroesAliasPartialPartition>, second: Shared<ZeroesAliasPartialPartition>, third: Shared<ZeroesAliasPartialPartition>) -> result: unit pure waits {
  atomic a = &first, b = &second, c = &third {
    set a^.cells[0_u64] = 1_u64;
    set b^.cells[0_u64] = 0_u64;
    need_aliaspartialpartition(z: c);
    set a^.cells[0_u64] = 0_u64;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
