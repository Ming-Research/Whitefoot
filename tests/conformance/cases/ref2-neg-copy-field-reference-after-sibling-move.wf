struct Pair {
  count: u64;
  other: Shared<u64>;
}

fn witness() -> result: u64 pure waits {
  doc "REF-2: a move out of one field consumes the whole owner [WIN-3], so a reference to a copy field, which no release touches, is invalid afterwards because the owner is a moved prefix of its path.";
  let o = shared_new::<u64>(value: 2_u64);
  let pair = Pair(count: 1_u64, other: move o);
  let r = &pair.count;
  let gone = move pair.other;
  let seen = r^;
  return seen;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
