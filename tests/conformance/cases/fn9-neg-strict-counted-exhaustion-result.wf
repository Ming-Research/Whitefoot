alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn count_to_strict(limit: u64) -> count: u64 pure contract {
  ensures count < limit;
} {
  let cursor = 0_u64;
  for (
    i in 0_u64..limit,
    invariant bounded: cursor <= i
  ) {
    set cursor = cursor + 1_u64;
  }
  return cursor;
}

fn main() -> status: ExitStatus pure {
  let observed = count_to_strict(limit: 4_u64);
  if observed == 4_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
