alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn fetch(b: &[u8], i: u64, outer: Bool, inner: Bool) -> result: u8 reads(b) {
  doc "An inner join has one strict and one non-strict predecessor. Joining that weaker result with an outer strict predecessor cannot strengthen it; the final subscript remains unproved [ENT-5, OP-4].";
  let spare = deref(b).len;
  if outer {
    if inner {
      let tight = i < spare;
      if tight {
      } else {
        return 0_u8;
      }
    } else {
      let loose = i <= spare;
      if loose {
      } else {
        return 0_u8;
      }
    }
  } else {
    let tight2 = i < spare;
    if tight2 {
    } else {
      return 0_u8;
    }
  }
  return deref(b)[i];
}

fn main() -> status: ExitStatus pure {
  doc "No construction is needed to exercise the nested join.";
  return exit_status(code: 0_u8);
}
