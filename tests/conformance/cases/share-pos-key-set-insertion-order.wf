struct Store {
  map: KeyedTable<u64>;
}

const names: Array<u8, 2> =[98_u8, 97_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let table = keyed_table_new::<u64>(capacity: 0_u64);
  let state = Store(map: move table);
  let store = shared_new::<Store>(value: move state);
  let keys = key_set_new(capacity: 2_u64);
  let b = &names[0_u64..1_u64];
  let a = &names[1_u64..2_u64];
  let first = key_set_insert(keys: &keys, key: b);
  let second = key_set_insert(keys: &keys, key: a);
  let repeated = key_set_insert(keys: &keys, key: b);
  if first != 0_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  if second != 1_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  if repeated != 0_u64 {
    return std::process::exit_status(code: 3_u8);
  }
  if keys.len != 2_u64 {
    return std::process::exit_status(code: 4_u8);
  }
  atomic s = &store, es = &s^.map[keys] {
    set es^[0_u64] = Some<u64>(value: 19_u64);
    set es^[1_u64] = Some<u64>(value: 23_u64);
  }
  let b_value = 0_u64;
  let a_value = 0_u64;
  atomic s = &store, slot = &s^.map[b] {
    match slot^ {
      Some(value: held) => {
        set b_value = held^;
      }
      None() => {
      }
    }
  }
  if b_value != 19_u64 {
    return std::process::exit_status(code: 5_u8);
  }
  atomic s = &store, slot = &s^.map[a] {
    match slot^ {
      Some(value: held) => {
        set a_value = held^;
      }
      None() => {
      }
    }
  }
  if a_value != 23_u64 {
    return std::process::exit_status(code: 6_u8);
  }
  return std::process::exit_status(code: 37_u8);
}
