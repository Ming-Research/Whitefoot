alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Row {
  left: u64;
  right: u64;
}

fn main() -> status: ExitStatus pure {
  doc "A write of one field invalidates no reference to its disjoint sibling: the two field selections never overlap, so the live reference is still valid at its later read.";
  let row0 = Row(left: 3_u64, right: 4_u64);
  let row1 = Row(left: 3_u64, right: 4_u64);
  let row2 = Row(left: 3_u64, right: 4_u64);
  let row3 = Row(left: 3_u64, right: 4_u64);
  let slots = slots_new::<Row, 4>();
  place_back(window: &slots, value: row0);
  place_back(window: &slots, value: row1);
  place_back(window: &slots, value: row2);
  place_back(window: &slots, value: row3);
  let rows = slots_into_array::<Row, 4>(values: move slots);
  let saved = &rows[0_u64].left;
  set rows[0_u64].right = 9_u64;
  let observed = deref(saved);
  return exit_status(code: 0_u8);
}
