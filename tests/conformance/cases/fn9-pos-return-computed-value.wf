fn bump(value: u64, up: Bool) -> result: u64 pure contract {
  requires value <= 999999999999999999_u64;
  ensures result <= 1000000000000000000_u64;
} {
  doc "Each selected return proves the clause on its own: the computed return over its returned value, and the bare return over its place.";
  if up {
    return value + 1_u64;
  }
  return value;
}

fn digit(value: u64) -> result: u64 pure contract {
  ensures result < 10_u64;
} {
  doc "A remainder has no affine image; its returned value carries the ENT-3.S7 row's result bounds, as a let of it would.";
  return value % 10_u64;
}

fn main() -> status: std::process::ExitStatus pure {
  let rounded = bump(value: 40_u64, up: true);
  let low = digit(value: 1231_u64);
  let sum = rounded + low;
  if sum == 42_u64 {
    return std::process::exit_status(code: 42_u8);
  }
  return std::process::exit_status(code: 1_u8);
}
