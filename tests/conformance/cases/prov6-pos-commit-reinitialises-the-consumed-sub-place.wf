alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nodrop struct Chunk {
  page: Box<Slots<u8>>;
  spare: u8;
}

fn exchange(taken: Box<Slots<u8>>) -> given: Box<Slots<u8>> pure {
  doc "Hands the cell back, which is what makes the read-out a commit rather than an abandonment.";
  return move taken;
}

fn main() -> status: ExitStatus pure {
  doc "OP-12: `set p = f(p, args...);` is the atomic in-place update. The old value enters f by value, f's result is committed, and no program point lies between, so the linear owner has no residual at any point and the partial-consume refusal does not reach it. Without this form the rule refused the central statement of every library that transforms a component of a linear value in place.";
  let page = box_slots_new::<u8>(capacity: 4_u64);
  let chunk = Chunk(page: move page, spare: 5_u8);
  set chunk.page = exchange(taken: move chunk.page);
  let Chunk(page: taken, spare: left) = move chunk;
  return exit_status(code: left);
}
