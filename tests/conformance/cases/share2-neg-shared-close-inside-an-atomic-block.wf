nodrop struct Ticket {
  id: u8;
}

fn settle(held: Shared<Ticket>) -> result: u8 pure waits {
  match shared_close::<Ticket>(shared: move held) {
    Some(value: last) => {
      let Ticket(id: number) = move last;
      return number;
    }
    None() => {
      return 0_u8;
    }
  }
}

fn main() -> status: std::process::ExitStatus pure waits {
  let ticket = Ticket(id: 1_u8);
  let held = shared_new::<Ticket>(value: move ticket);
  let other = shared_share::<Ticket>(shared: &held);
  let seen = 0_u8;
  atomic state = &held {
    set seen = state^.id;
    match shared_close::<Ticket>(shared: move other) {
      Some(value: inner) => {
        let Ticket(id: inner_id) = move inner;
      }
      None() => {
      }
    }
  }
  let last = settle(held: move held);
  return std::process::exit_status(code: last);
}
