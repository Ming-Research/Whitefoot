fn probe(values: &Array<u8, 2>, offsets: &Array<u64, 1>) -> result: u8 reads(values), reads(offsets) contract {
  requires offsets^[0_u64] < 2_u64;
  requires 1_u8 <= values^[offsets^[0_u64]];
} {
  let index = offsets^[0_u64];
  return values^[index];
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
