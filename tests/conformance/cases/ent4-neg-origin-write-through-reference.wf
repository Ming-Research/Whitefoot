fn need(n: u64) -> r: unit pure contract {
  define parity = iand(n, 1_u64);
  requires parity == 0_u64;
} {
  doc "Consume the exact parity goal.";
  return unit;
}

fn witness() -> r: unit pure {
  doc "A write through a local reference kills the links of the written binding and of the definition reading it.";
  let a = 2_u64;
  let low = iand(a, 1_u64);
  let w = &a;
  set w^ = 3_u64;
  need(n: a);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Reject the unproved parity requirement at FN-8.";
  return std::process::exit_status(code: 0_u8);
}
