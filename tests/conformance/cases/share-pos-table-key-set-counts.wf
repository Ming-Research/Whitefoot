struct Store {
  map: KeyedTable<u8>;
}

const names: Array<u8, 2> =[97_u8, 98_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let table = keyed_table_new::<u8>(capacity: 0_u64);
  let state = Store(map: move table);
  let store = shared_new::<Store>(value: move state);
  let keys = key_set_new(capacity: 2_u64);
  let counts = array_filled::<u64, 3>(value: 0_u64);
  for @insert (at in 0_u64..3_u64) {
    let key_at = at % 2_u64;
    let end = key_at +wrap 1_u64;
    let index = key_set_insert(keys: &keys, key: &names[key_at..end]);
    if index < counts.len {
      set counts[index] = counts[index] +wrap 1_u64;
    } else {
      return std::process::exit_status(code: 3_u8);
    }
  }
  if counts[0_u64] != 2_u64 {
    return std::process::exit_status(code: 4_u8);
  }
  if counts[1_u64] != 1_u64 {
    return std::process::exit_status(code: 5_u8);
  }
  let first = &names[0_u64..1_u64];
  atomic s = &store, slot = &s^.map[first] {
    set slot^ = Some<u8>(value: 0_u8);
  }
  let counted = 0_u64;
  if keys.len > counts.len {
    return std::process::exit_status(code: 7_u8);
  }
  atomic s = &store, entries = &s^.map[keys] {
    for @look (at in 0_u64..keys.len) {
      match entries^[at] {
        Some(value: unused) => {
          let named = counts[at];
          set counted = counted +wrap named;
        }
        None() => {
        }
      }
    }
  }
  if keys.len != 2_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  if counted != 2_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  return std::process::exit_status(code: 6_u8);
}
