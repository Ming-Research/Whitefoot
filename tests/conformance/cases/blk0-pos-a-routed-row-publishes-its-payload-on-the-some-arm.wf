alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn bounded(request: u64) -> result: Result<u64, Overflow> pure contract {
  requires request <= 3_u64;
  ensures when Ok(value: granted): granted <= 3_u64;
} {
  doc "Publishes a bound on its Ok payload alone; the Err exit is unselected and carries no relation.";
  return Ok<u64, Overflow>(value: request);
}

fn main() -> status: ExitStatus pure {
  doc "A declaration whose result is an enum states part of its relation list per variant, and publication restricts each routed relation to the arm its route names. The Ok arm binds the payload the route's own binder spelling names, so the bound that route publishes is the caller's and the subscript is discharged from it with no branch on the payload at all.";
  let run = slots_new::<u8, 4>();
  place_back(window: &run, value: 7_u8);
  place_back(window: &run, value: 7_u8);
  place_back(window: &run, value: 7_u8);
  place_back(window: &run, value: 7_u8);
  match bounded(request: 0_u64) {
    Ok(value: granted) => {
      let seen = run[granted];
      if seen == 7_u8 {
      } else {
        return exit_status(code: 2_u8);
      }
    }
    Err(error: problem) => {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
