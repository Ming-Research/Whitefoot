fn need(x: &u64) -> result: u64 reads(x) contract {
  requires x^ != 0_u64;
} {
  doc "Divides ten by the value x names.";
  let v = 10_u64 / x^;
  return v;
}

fn probe(p: &u64) -> result: u64 reads(p) {
  doc "The control for fn8-neg-guard-through-rebound-parameter: saved's description is rooted at a rebound parameter and is not exact, so saved^ keeps its spelling through saved, and a guard written through saved proves the call through saved.";
  let saved = &p^;
  let one = 1_u64;
  set p = &one;
  if saved^ != 0_u64 {
    let r = need(x: saved);
    return r;
  }
  return 0_u64;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The caller's cell holds five, so the guarded call returns two.";
  let five = 5_u64;
  let r = probe(p: &five);
  if r == 2_u64 {
    return std::process::exit_status(code: 0_u8);
  }
  return std::process::exit_status(code: 1_u8);
}
