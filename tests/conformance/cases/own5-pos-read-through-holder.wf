alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Cell {
  value: i32;
}

fn main() -> return_value: ExitStatus pure {
  doc "Reads and writes through a reference are ordinary accesses to the path it names, and the owner sees the write after the reference goes out of use. The value read through the reference and the value the owner reads, 10 each, sum to the exit status 20.";
  let a = Cell(value: 3_i32);
  let u = &a;
  set u^.value = 10_i32;
  let through = u^.value;
  let owned = a.value;
  let total = through + owned;
  let code = cvt::<i32, u8>(total);
  return exit_status(code: code);
}
