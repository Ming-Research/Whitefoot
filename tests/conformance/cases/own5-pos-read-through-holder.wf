alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Cell {
  value: i32;
}

fn main() -> return_value: ExitStatus pure {
  doc "Reads and writes through a reference are ordinary accesses to the path it names, and the owner sees the write after the reference goes out of use.";
  let a = Cell(value: 3_i32);
  let u = &a;
  set deref(u).value = 10_i32;
  if deref(u).value == 10_i32 {
  } else {
    return exit_status(code: 1_u8);
  }
  if a.value == 10_i32 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
