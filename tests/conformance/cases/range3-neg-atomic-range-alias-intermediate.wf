struct ZeroesAliasIntermediate {
  cells: Array<u64, 1>;
  invariant(c): forall zero(k in 0_u64..c^.cells.len): c^.cells[k] == 0_u64;
}

fn need_aliasintermediate(z: &ZeroesAliasIntermediate) -> result: unit pure {
  return unit;
}

fn update_aliasintermediate(first: Shared<ZeroesAliasIntermediate>, second: Shared<ZeroesAliasIntermediate>) -> result: unit pure waits {
  atomic a = &first, b = &second {
    set a^.cells[0_u64] = 1_u64;
    need_aliasintermediate(z: b);
    set a^.cells[0_u64] = 0_u64;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
