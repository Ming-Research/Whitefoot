struct Frame {
  marker: u64;
  items: Array<u64, 1>;
}

fn helper(frame: &Frame, other: &Frame) -> result: unit writes(frame.marker), writes(other.items) contract {
  requires forall before(k in 0_u64..1_u64): frame^.items[k] == 0_u64;
  ensures forall after(k in 0_u64..1_u64): frame^.items[k] == 0_u64;
} {
  set frame^.marker = 1_u64;
  set other^.items[0_u64] = 1_u64;
  return unit;
}

fn caller(f: &Frame) -> result: unit writes(f) contract {
  requires forall start(k in 0_u64..1_u64): f^.items[k] == 0_u64;
} {
  doc "EFF-5: a bound range index widens the read to f.items, which other writes.";
  helper(frame: f, other: f);
  return unit;
}
