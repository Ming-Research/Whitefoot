fn no_count() -> made: u8 pure {
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let stats = shared_shards_new::<u8, fn no_count>();
  let mine = any_shard();
  let seen = 0_u8;
  atomic all = &stats {
    set seen = all^[mine];
  }
  return std::process::exit_status(code: seen);
}
