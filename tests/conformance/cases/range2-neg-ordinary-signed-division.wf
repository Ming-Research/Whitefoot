fn probe(xs: &[i64]) -> result: unit reads(xs) contract {
  requires forall nonzero(k in 0_u64..xs^.len): xs^[k] == 1_i64;
} {
  if 0_u64 < xs^.len {
    let x = xs^[0_u64];
    let y = xs^[0_u64];
    let quotient = x / y;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
