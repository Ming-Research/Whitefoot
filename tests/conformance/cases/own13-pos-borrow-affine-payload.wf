alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy struct Pair {
  left: i32;
  right: i32;
}

enum Packet {
  Data(item: Pair);
  Empty();
}

fn inspect(packet: &Packet) -> return_value: i32 reads(packet) {
  doc "OWN-13: matching through a reference derives a Pair payload binder naming that path, and a field of it is read without transferring ownership.";
  match deref(packet) {
    Data(item: payload) => {
      return deref(payload).left;
    }
    Empty() => {
      return 0_i32;
    }
  }
}

fn main() -> return_value: ExitStatus pure {
  return exit_status(code: 0_u8);
}
