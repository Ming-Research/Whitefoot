fn read(store: &Shared<KeyedTable<u64>>, key: &[u8]) -> result: u64 reads(store), reads(key) waits {
  atomic table = &store^, slot = &table^[key] {
    match slot^ {
      Some(value: held) => {
        return held^;
      }
      None() => {
        return 99_u64;
      }
    }
  }
}

fn main() -> status: std::process::ExitStatus pure waits {
  let bytes = box_slots_new::<u8>(capacity: 6_u64);
  place_back(window: &bytes.inner, value: 98_u8);
  place_back(window: &bytes.inner, value: 97_u8);
  place_back(window: &bytes.inner, value: 0_u8);
  place_back(window: &bytes.inner, value: 255_u8);
  let spans = box_slots_new::<KeySpan>(capacity: 7_u64);
  let span0 = KeySpan(start: 0_u64, end: 1_u64);
  place_back(window: &spans.inner, value: span0);
  let span1 = KeySpan(start: 1_u64, end: 2_u64);
  place_back(window: &spans.inner, value: span1);
  let span2 = KeySpan(start: 1_u64, end: 3_u64);
  place_back(window: &spans.inner, value: span2);
  let span3 = KeySpan(start: 4_u64, end: 4_u64);
  place_back(window: &spans.inner, value: span3);
  let span4 = KeySpan(start: 0_u64, end: 0_u64);
  set span4.start = 3_u64;
  set span4.end = 4_u64;
  place_back(window: &spans.inner, value: span4);
  let source = KeySource(bytes: move bytes, spans: move spans);
  let prepared = key_prepare(source: move source);
  match move prepared {
    Err(error: failure) => {
      return std::process::exit_status(code: 1_u8);
    }
    Ok(value: keys) => {
      let table = keyed_table_new::<u64>(capacity: 5_u64);
      let store = shared_new::<KeyedTable<u64>>(value: move table);
      let count = 0_u64;
      atomic state = &store, entries = &state^[keys] {
        set count = entries^.len;
        for @fill (at in 0_u64..keys.source.spans.inner.len) {
          set entries^[at] = Some<u64>(value: at);
        }
      }
      if count != 5_u64 {
        return std::process::exit_status(code: 2_u8);
      }
      let original = move keys.source;
      if original.bytes.inner.cap != 6_u64 {
        return std::process::exit_status(code: 10_u8);
      }
      if original.bytes.inner.len != 4_u64 {
        return std::process::exit_status(code: 3_u8);
      }
      if original.spans.inner.cap != 7_u64 {
        return std::process::exit_status(code: 10_u8);
      }
      if original.spans.inner.len != 5_u64 {
        return std::process::exit_status(code: 4_u8);
      }
      if original.bytes.inner[0_u64] != 98_u8 {
        return std::process::exit_status(code: 11_u8);
      }
      if original.bytes.inner[1_u64] != 97_u8 {
        return std::process::exit_status(code: 11_u8);
      }
      if original.bytes.inner[2_u64] != 0_u8 {
        return std::process::exit_status(code: 11_u8);
      }
      if original.bytes.inner[3_u64] != 255_u8 {
        return std::process::exit_status(code: 11_u8);
      }
      let value0 = read(store: &store, key: &original.bytes.inner[0_u64..1_u64]);
      if value0 != 0_u64 {
        return std::process::exit_status(code: 5_u8);
      }
      if original.spans.inner[0_u64].start != 0_u64 {
        return std::process::exit_status(code: 6_u8);
      }
      if original.spans.inner[0_u64].end != 1_u64 {
        return std::process::exit_status(code: 7_u8);
      }
      let value1 = read(store: &store, key: &original.bytes.inner[1_u64..2_u64]);
      if value1 != 1_u64 {
        return std::process::exit_status(code: 5_u8);
      }
      if original.spans.inner[1_u64].start != 1_u64 {
        return std::process::exit_status(code: 6_u8);
      }
      if original.spans.inner[1_u64].end != 2_u64 {
        return std::process::exit_status(code: 7_u8);
      }
      let value2 = read(store: &store, key: &original.bytes.inner[1_u64..3_u64]);
      if value2 != 2_u64 {
        return std::process::exit_status(code: 5_u8);
      }
      if original.spans.inner[2_u64].start != 1_u64 {
        return std::process::exit_status(code: 6_u8);
      }
      if original.spans.inner[2_u64].end != 3_u64 {
        return std::process::exit_status(code: 7_u8);
      }
      let value3 = read(store: &store, key: &original.bytes.inner[4_u64..4_u64]);
      if value3 != 3_u64 {
        return std::process::exit_status(code: 5_u8);
      }
      if original.spans.inner[3_u64].start != 4_u64 {
        return std::process::exit_status(code: 6_u8);
      }
      if original.spans.inner[3_u64].end != 4_u64 {
        return std::process::exit_status(code: 7_u8);
      }
      let value4 = read(store: &store, key: &original.bytes.inner[3_u64..4_u64]);
      if value4 != 4_u64 {
        return std::process::exit_status(code: 5_u8);
      }
      if original.spans.inner[4_u64].start != 3_u64 {
        return std::process::exit_status(code: 6_u8);
      }
      if original.spans.inner[4_u64].end != 4_u64 {
        return std::process::exit_status(code: 7_u8);
      }
      return std::process::exit_status(code: 9_u8);
    }
  }
}
