alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "The other two boundary operations. place_front moves the front boundary backwards, so the window wraps to the high slots of the ring, and take_back moves the back boundary, so the ring is a deque; with the queue case this exercises all four boundary operations and the wrap in both directions. A front operation replaces the whole window state, so each following requirement is discharged from a reread measure.";
  let run = ring_new::<u8, 4>();
  place_front(window: &run, value: 1_u8);
  let spare1 = run.cap - run.len;
  if spare1 == 3_u64 {
  } else {
    return exit_status(code: 6_u8);
  }
  place_front(window: &run, value: 2_u8);
  let spare2 = run.cap - run.len;
  if spare2 == 2_u64 {
  } else {
    return exit_status(code: 7_u8);
  }
  place_front(window: &run, value: 3_u8);
  let held = run.len;
  if held == 3_u64 {
  } else {
    return exit_status(code: 8_u8);
  }
  let front = run[0_u64];
  if front == 3_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  let last = take_back(window: &run);
  if last == 1_u8 {
  } else {
    return exit_status(code: 2_u8);
  }
  let next = take_back(window: &run);
  if next == 2_u8 {
  } else {
    return exit_status(code: 3_u8);
  }
  let remaining = run.len;
  if remaining == 1_u64 {
  } else {
    return exit_status(code: 9_u8);
  }
  let single = take_front(window: &run);
  if single == 3_u8 {
  } else {
    return exit_status(code: 4_u8);
  }
  let left = run.len;
  if left == 0_u64 {
  } else {
    return exit_status(code: 5_u8);
  }
  return exit_status(code: 0_u8);
}
