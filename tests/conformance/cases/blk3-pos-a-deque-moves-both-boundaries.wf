alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "The other two boundary operations. place_front moves the front boundary backwards, so the window wraps to the high slots of the ring, and take_back moves the back boundary, so the ring is a deque; with the queue case this exercises all four boundary operations and the wrap in both directions. A front operation replaces the whole window state, so each following requirement is discharged from a reread measure. The exit status is the sum of the five measures the records publish along the way.";
  let run = ring_new::<u8, 4>();
  place_front(window: &run, value: 1_u8);
  let spare1 = run.cap - run.len;
  place_front(window: &run, value: 2_u8);
  let spare2 = run.cap - run.len;
  place_front(window: &run, value: 3_u8);
  let observed = run.len;
  let front = run[0_u64];
  if front == 3_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  let last = take_back(window: &run);
  if last == 1_u8 {
  } else {
    return exit_status(code: 2_u8);
  }
  let next = take_back(window: &run);
  if next == 2_u8 {
  } else {
    return exit_status(code: 3_u8);
  }
  let remaining = run.len;
  let single = take_front(window: &run);
  if single == 3_u8 {
  } else {
    return exit_status(code: 4_u8);
  }
  let left = run.len;
  let spares = spare1 + spare2;
  let lengths = observed + remaining;
  let measures = spares + lengths;
  let combined = measures + left;
  let code = cvt::<u64, u8>(combined);
  return exit_status(code: code);
}
