const names: Array<u8, 1> =[97_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let store = shared_map_new::<u8>(capacity: 1_u64);
  let other = shared_share::<ConcurrentHashMap<u8>>(shared: &store);
  let mine = shared_map_new::<u8>(capacity: 1_u64);
  let name = &names[0_u64..1_u64];
  atomic t = &store, m = &mine, slot = &other[name] {
    swap(first: t, second: m);
    set slot^ = Some<u8>(value: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
