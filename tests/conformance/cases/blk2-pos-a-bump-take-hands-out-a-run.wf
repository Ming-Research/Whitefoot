alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A bump allocator is one storage used with place_back as its allocation step: the pool's cap fixes the extent it can ever hand out, and each placement publishes the pool's own new length. The case reads both sides of what the records publish: the pool's capacity, and its cursor after four placements.";
  let pool = slots_new::<u64, 16>();
  place_back(window: &pool, value: 0_u64);
  place_back(window: &pool, value: 0_u64);
  place_back(window: &pool, value: 0_u64);
  place_back(window: &pool, value: 0_u64);
  let capacity = pool.cap;
  if capacity == 16_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let cursor = pool.len;
  if cursor == 4_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
