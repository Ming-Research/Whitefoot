alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A bump allocator is one storage used with place_back as its allocation step: the pool's cap fixes the extent it can ever hand out, and each placement publishes the pool's own new length. The case reads both sides of what the records publish and returns them as its exit status: ten times the pool's capacity plus its cursor after four placements.";
  let pool = slots_new::<u64, 16>();
  place_back(window: &pool, value: 0_u64);
  place_back(window: &pool, value: 0_u64);
  place_back(window: &pool, value: 0_u64);
  place_back(window: &pool, value: 0_u64);
  let capacity = pool.cap;
  let cursor = pool.len;
  let tens = capacity * 10_u64;
  let combined = tens + cursor;
  let code = cvt::<u64, u8>(combined);
  return exit_status(code: code);
}
