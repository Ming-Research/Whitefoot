alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Cell {
  value: i32;
}

fn two(a: &Cell, b: &Cell) -> return_value: unit writes(a.value), writes(b.value) {
  set deref(a).value = 0_i32;
  set deref(b).value = 1_i32;
  return unit;
}

fn main() -> return_value: ExitStatus pure {
  doc "Two substituted write paths of one call that resolve to the same place are not proved disjoint.";
  let x = Cell(value: 0_i32);
  two(a: &x, b: &x);
  return exit_status(code: 0_u8);
}
