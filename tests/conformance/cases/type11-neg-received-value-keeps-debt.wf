struct Stack {
  slots: Slots<u64, 8>;
  invariant nonempty(stack): stack.slots.len >= 1_u64;
}

fn fresh(first: u64) -> made: Stack pure {
  let slots = slots_new::<u64, 8>();
  place_back(window: &slots, value: first);
  let stack = Stack(slots: move slots);
  return move stack;
}

fn drained(first: u64) -> result: u64 pure {
  let stack = fresh(first: first);
  let old = take_back(window: &stack.slots);
  let moved = move stack;
  let got = moved.slots[0_u64];
  let sum = got +wrap old;
  return sum;
}
