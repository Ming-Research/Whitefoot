enum RoutedOwned {
  Held(storage: Box<Slots<u64>>, index: u64);
  Empty();
}

fn make() -> result: RoutedOwned pure contract {
  ensures when Held(index: payload): payload <= 7_u64;
} {
  let storage = box_slots_new::<u64>(capacity: 1_u64);
  return RoutedOwned::Held(storage: move storage, index: 7_u64);
}

fn delivered(flag: Bool) -> result: u8 pure {
  let original = make();
  let moved = move original;
  let selected = if flag {
    give move moved;
  } else {
    let other = make();
    give move other;
  }
  match move selected {
    Held(storage: owned, index: value) => {
      let code = cvt::<u64, u8>(value);
      return code;
    }
    Empty() => {
      return 99_u8;
    }
  }
}

fn main() -> status: std::process::ExitStatus pure {
  let yes = True();
  let no = False();
  let first = delivered(flag: yes);
  let second = delivered(flag: no);
  if first != second {
    return std::process::exit_status(code: 99_u8);
  }
  return std::process::exit_status(code: first);
}
