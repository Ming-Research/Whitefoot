alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy struct Item {
  value: u64;
}

struct Slot {
  item: Item;
}

fn main() -> status: ExitStatus pure {
  doc "swap exchanges the affine values at two writable places and consumes neither root: both bindings stay live and each root becomes the sole owner of the value the other held. The previous field value is read back from the second place after the commit, and the field is read again through its live root.";
  let first = Item(value: 1_u64);
  let slot = Slot(item: move first);
  let second = Item(value: 2_u64);
  swap(first: &slot.item, second: &second);
  let old = second.value;
  if old == 1_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let current = slot.item.value;
  if current == 2_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
