struct Pair {
  marker: u64;
  value: u64;
}

fn apply<fn op(frame: &Pair, other: &Pair) -> result: unit writes(frame.marker), writes(other.value) contract {
  requires frame^.value == 0_u64;
  ensures frame^.value == 0_u64;
}>(first: &Pair, second: &Pair) -> result: unit writes(first.marker), writes(second.value) contract {
  requires first^.value == 0_u64;
} {
  op(frame: first, other: second);
  return unit;
}
