struct Pair {
  left: u8;
  right: u8;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let first = shared_new::<u8>(value: 1_u8);
  let second = shared_new::<u8>(value: 2_u8);
  atomic a = &first, b = &second {
    set a^ = b^;
  }
  let pair = Pair(left: 1_u8, right: 2_u8);
  let both = shared_new::<Pair>(value: move pair);
  atomic p = &both {
    set p^.left = p^.right;
  }
  return std::process::exit_status(code: 0_u8);
}
