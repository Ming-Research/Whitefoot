struct Pair {
  left: u64;
  right: u64;
}

fn observe(left: &u64, right: &u64) -> result: Pair reads(left), reads(right) contract {
  requires held(left, right);
} {
  return Pair(left: left^, right: right^);
}

fn forward(left: &u64, right: &u64) -> result: Pair reads(left), reads(right) contract {
  requires held(left);
} {
  return observe(left: left, right: right);
}
