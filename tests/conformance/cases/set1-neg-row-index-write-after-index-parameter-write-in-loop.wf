alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn write_slot(window: &Slots<u64, 4>, index: u64) -> result: unit reads(window.len), writes(window[index]) contract {
  requires index < deref(window).len;
} {
  doc "Writes element index on the first iteration and element 0 on the later ones.";
  let n = 0_u64;
  loop {
    if index < deref(window).len {
      set deref(window)[index] = 9_u64;
    }
    if 2_u64 <= n {
      break;
    }
    set n = n +wrap 1_u64;
    set index = 0_u64;
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "EFF-1, EFF-2, SET-1: the loop form of set1-neg-row-index-write-after-index-parameter-write. The body writes index after the access, and the backedge carries that write to the access in the next iteration, where deref(window)[index] is not the row's window[index], so the set is refused.";
  let r = slots_new::<u64, 4>();
  place_back(window: &r, value: 1_u64);
  place_back(window: &r, value: 2_u64);
  let p = &r[0_u64];
  write_slot(window: &r, index: 1_u64);
  let seen = deref(p);
  if seen == 1_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
