fn boxed(value: u64, cell: Shared<u64>) -> result: Box<u64> pure may_wait {
  atomic state = &cell {
    set state^ = value;
  }
  let next = value +wrap 1_u64;
  return box_new::<u64>(value: next);
}

fn main() -> status: std::process::ExitStatus pure must_wait {
  let cell = shared_new::<u64>(value: 0_u64);
  spawn boxed(value: 41_u64, cell: move cell);
  return std::process::exit_status(code: 0_u8);
}
