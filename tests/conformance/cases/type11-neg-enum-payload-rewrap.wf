struct Window {
  slots: Slots<u64, 8>;
  next: u64;
  invariant cursor(window): window.next < window.slots.len;
}

fn bump(window: Option<Window>) -> result: Option<Window> pure {
  match move window {
    Some(value: w) => {
      set w.next = 9_u64;
      return Some<Window>(value: move w);
    }
    None() => {
      return None<Window>();
    }
  }
}
