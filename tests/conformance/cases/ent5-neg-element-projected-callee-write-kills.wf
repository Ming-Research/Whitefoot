fn reset(digit: &u8) -> result: unit writes(digit) {
  set digit^ = 0_u8;
  return unit;
}

fn probe(values: &Array<u8, 2>, index: u64) -> result: u8 writes(values) contract {
  requires index < values^.len;
  requires 1_u8 <= values^[index];
} {
  reset(digit: &values^[index]);
  return values^[index] - 1_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
