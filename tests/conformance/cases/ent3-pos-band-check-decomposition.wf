alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn read_pair(table: Slots<u8, 8>, low: u64, high: u64) -> result: u8 pure contract {
  requires 8_u64 <= table.len;
} {
  doc "ENT-3 signed Boolean decomposition: the true edge of band(low_ok, high_ok) establishes both positive operands. Their comparison projections discharge both window subscript obligations.";
  let low_ok = low < 8_u64;
  let high_ok = high < 8_u64;
  let both = band(low_ok, high_ok);
  if both {
    let first = table[low];
    let second = table[high];
    return second;
  } else {
    return 0_u8;
  }
}

fn main() -> status: ExitStatus pure {
  doc "A full array converted into a full window supplies the declared length.";
  let seed = array_filled::<u8, 8>(value: 3_u8);
  let table = slots_from_array::<u8, 8>(values: seed);
  let value = read_pair(table: move table, low: 1_u64, high: 2_u64);
  if value == 3_u8 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
