fn reduce() -> result: u64 pure {
  doc "A Slots append changes length; even matching cell updates cannot grant this loop permission.";
  let cells = slots_new::<u64, 8>();
  place_back(window: &cells, value: 0_u64);
  for (i in 0_u64..4_u64) {
    if 0_u64 < cells.len {
      set cells[0_u64] = cells[0_u64] +wrap 1_u64;
    }
    if cells.len < cells.cap {
      place_back(window: &cells, value: 0_u64);
    }
  }
  return cells.len;
}

fn main() -> status: std::process::ExitStatus pure {
  let result = reduce();
  return std::process::exit_status(code: 0_u8);
}
