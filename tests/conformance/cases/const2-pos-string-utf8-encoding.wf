alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const word: Array<u8, 10> = "caf\u{e9}\u{1f600}\u{0}";

fn main() -> status: ExitStatus pure {
  doc "A STRING's bytes are the UTF-8 encoding of its scalar values: U+00E9 takes two bytes, U+1F600 four, and U+0000 one, so the text is ten bytes.";
  let lead = word[3_u64];
  if lead == 195_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  let trail = word[4_u64];
  if trail == 169_u8 {
  } else {
    return exit_status(code: 2_u8);
  }
  let four = word[5_u64];
  if four == 240_u8 {
  } else {
    return exit_status(code: 3_u8);
  }
  let end = word[8_u64];
  if end == 128_u8 {
  } else {
    return exit_status(code: 4_u8);
  }
  let zero = word[9_u64];
  if zero == 0_u8 {
  } else {
    return exit_status(code: 5_u8);
  }
  return exit_status(code: 0_u8);
}
