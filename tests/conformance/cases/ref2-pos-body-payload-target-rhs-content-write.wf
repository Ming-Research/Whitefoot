fn change_content(cell: &Option<u64>) -> result: u64 reads(cell), writes(cell.Some.value) {
  doc "A primitive payload write kills the current variant fact while preserving the already selected payload place.";
  match &cell^ {
    None() => {
      return 0_u64;
    }
    Some(value: inner) => {
      set inner^ = 41_u64;
      return 11_u64;
    }
  }
}

fn write_after_content_change(cell: &Option<u64>) -> result: unit writes(cell) {
  doc "The set target is captured before the right-hand side; a primitive content write cannot prevent its valid commit.";
  match &cell^ {
    None() => {
      return unit;
    }
    Some(..) => {
      set cell^.Some.value = change_content(cell: cell);
      return unit;
    }
  }
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The right-hand side first writes 41, then the captured target commit must replace it with the returned 11.";
  let cell = Some<u64>(value: 7_u64);
  let changed = write_after_content_change(cell: &cell);
  match &cell {
    None() => {
      return std::process::exit_status(code: 1_u8);
    }
    Some(value: observed) => {
      if observed^ == 11_u64 {
        return std::process::exit_status(code: 0_u8);
      }
      return std::process::exit_status(code: 2_u8);
    }
  }
}
