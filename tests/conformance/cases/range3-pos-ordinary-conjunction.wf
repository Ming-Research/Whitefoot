fn need(x: u64) -> result: unit pure contract {
  define below = x < 4_u64;
  define different = x != 2_u64;
  define one = x == 1_u64;
  define rest = band(different, one);
  requires band(below, rest);
} {
  return unit;
}

fn probe(xs: &[u64]) -> result: unit reads(xs) contract {
  requires forall one(k in 0_u64..xs^.len): xs^[k] == 1_u64;
} {
  if 0_u64 < xs^.len {
    let x = xs^[0_u64];
    need(x: x);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
