alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "OP-11: swap exchanges the values at two owned places of one type; neither root is consumed, both bindings remain live, and each root is the sole owner of the value the other held.";
  let a = box_new::<u64>(value: 1_u64);
  let b = box_new::<u64>(value: 2_u64);
  swap(first: &a, second: &b);
  let left = a.inner;
  let right = b.inner;
  if left == 2_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  if right == 1_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
