fn shrink(window: &Slots<u8, 2>, keep: Bool) -> result: unit writes(window.last), writes(window.len) contract {
  requires 0_u64 < window^.len;
  ensures window^[0_u64] <= 255_u8;
} {
  if keep {
    return unit;
  }
  let removed = take_back(window: window);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
