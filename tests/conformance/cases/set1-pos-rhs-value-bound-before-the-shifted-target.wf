alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "SET-1: the repair of set1-neg-rhs-shifts-the-target-slot. The removed box is bound with let first, so the target v[1_u64] is evaluated and its bound checked after remove_at, in the window it left, and the commit replaces the box that is now second.";
  let v = slots_new::<Box<u64>, 4>();
  let first = box_new::<u64>(value: 1_u64);
  place_back(window: &v, value: move first);
  let second = box_new::<u64>(value: 2_u64);
  place_back(window: &v, value: move second);
  let third = box_new::<u64>(value: 3_u64);
  place_back(window: &v, value: move third);
  let removed = remove_at(window: &v, index: 0_u64);
  set v[1_u64] = move removed;
  if v.len != 2_u64 {
    return exit_status(code: 1_u8);
  }
  if v[0_u64].inner != 2_u64 {
    return exit_status(code: 2_u8);
  }
  if v[1_u64].inner != 1_u64 {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
