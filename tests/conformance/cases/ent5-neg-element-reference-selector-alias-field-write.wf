struct Cursor {
  index: u64;
}

fn probe(values: &Array<u8, 2>, cursor: &Cursor) -> result: u8 reads(values), writes(cursor.index) contract {
  requires cursor^.index == 0_u64;
} {
  let selected = &cursor^.index;
  if 1_u8 <= values^[selected^] {
    set cursor^.index = 1_u64;
    return values^[selected^] - 1_u8;
  }
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
