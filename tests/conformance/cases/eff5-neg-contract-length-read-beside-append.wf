fn append_run_length(source: &Slots<u64, 8>, target: &Slots<u64, 8>, lo: u64, hi: u64) -> result: unit reads(source[lo..hi]), writes(target.next), writes(target.len) contract {
  requires lo <= hi;
  requires hi <= source^.len;
  requires target^.len < target^.cap;
} {
  let run = &source^[lo..hi];
  let count = run^.len;
  place_back(window: target, value: count);
  return unit;
}

fn caller() -> result: unit pure {
  doc "EFF-5: the contract read source^.len substitutes to window.len and meets writes(target.len), also window.len; the complete append_run_length call is rejected even though its element run ends before the append slot.";
  let window = slots_new::<u64, 8>();
  place_back(window: &window, value: 1_u64);
  place_back(window: &window, value: 2_u64);
  append_run_length(source: &window, target: &window, lo: 0_u64, hi: 2_u64);
  return unit;
}
