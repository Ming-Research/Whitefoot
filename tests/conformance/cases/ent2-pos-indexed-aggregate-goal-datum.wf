struct Leaf {
  value: u8;
}

struct Cell {
  len: Leaf;
}

fn probe(cells: &Array<Cell, 1>) -> result: unit reads(cells) {
  let wanted = Leaf(value: 1_u8);
  if cells^[0_u64].len == wanted {
    let ref = &cells^[0_u64];
    let value = ref^.len.value + 254_u8;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
