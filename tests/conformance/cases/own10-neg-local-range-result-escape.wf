alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn escape() -> result: u64 pure {
  doc "A range reference over local storage is a reference like any other and dies with the binding that formed it, so returning it is refused.";
  let values = slots_new::<u64, 4>();
  place_back(window: &values, value: 0_u64);
  place_back(window: &values, value: 0_u64);
  return &values[0_u64..2_u64];
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
