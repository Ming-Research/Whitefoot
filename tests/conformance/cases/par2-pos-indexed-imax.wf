fn reduce() -> result: i64 pure {
  doc "PAR-2 permits colliding indexed imax updates; the incoming cell value participates once.";
  let cells = box_array_filled::<i64>(count: 2_u64, value: -100_i64);
  for (i in 0_u64..4_u64) {
    set cells.inner[0_u64] = imax(cells.inner[0_u64], -7_i64);
  }
  return cells.inner[0_u64];
}

fn main() -> status: std::process::ExitStatus pure {
  let result = reduce();
  if result != -7_i64 {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
