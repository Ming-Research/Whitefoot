alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "MSR-1, OP-15: a measure read is a place form and not a call, and the table gives each measured type exactly the cells it has. A Slots has len and cap, a Ring adds head, and a range reference has len alone; free slots is the ordinary expression cap - len. The program reads every measure the table gives, computes free slots, and observes those values over constant-capacity and boxed runtime-capacity windows, a ring and a range reference.";
  let values = array_filled::<u8, 4>(value: 0_u8);
  let fixed = slots_from_array::<u8, 4>(values: values);
  let fixed_length = fixed.len;
  let fixed_capacity = fixed.cap;
  let fixed_room = fixed.cap - fixed.len;
  let cell = box_slots_new::<u8>(capacity: 8_u64);
  for @fill (
    at in 0_u64..8_u64,
    invariant grown: cell.inner.len >= at,
    invariant spare: cell.inner.cap - cell.inner.len + at >= 8_u64
  ) {
    place_back(window: &cell.inner, value: 0_u8);
  }
  let run_length = cell.inner.len;
  let run_capacity = cell.inner.cap;
  let run_room = cell.inner.cap - cell.inner.len;
  let cycle = ring_new::<u8, 2>();
  let ring_length = cycle.len;
  let ring_capacity = cycle.cap;
  let ring_room = cycle.cap - cycle.len;
  let ring_head = cycle.head;
  let view = &fixed[0_u64..4_u64];
  let view_length = deref(view).len;
  if view_length == 4_u64 {
    if ring_head == 0_u64 {
      if ring_length == 0_u64 {
        if ring_capacity == 2_u64 {
          if ring_room == 2_u64 {
            if run_length == 8_u64 {
              if run_capacity == 8_u64 {
                if run_room == 0_u64 {
                  if fixed_length == 4_u64 {
                    if fixed_capacity == 4_u64 {
                      if fixed_room == 0_u64 {
                        return exit_status(code: 0_u8);
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  return exit_status(code: 5_u8);
}
