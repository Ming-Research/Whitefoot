fn need(value: Bool) -> r: unit pure contract {
  requires value;
} {
  doc "Consume a proved Boolean value.";
  return unit;
}

fn witness(x: u64) -> r: unit pure {
  doc "A later stronger bound proves the earlier Boolean's defining comparison.";
  let test = x < 9_u64;
  if x < 8_u64 {
    need(value: test);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Check the ordinary function body.";
  return std::process::exit_status(code: 0_u8);
}
