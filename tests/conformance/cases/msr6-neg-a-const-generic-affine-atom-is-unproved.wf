alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn overstated<const n: u64>() -> result: Slots<u8, n> pure {
  doc "States a loop invariant over the const generic that the window's own capacity refutes: an empty window has n slots of room and not n + 1.";
  let built = slots_new::<u8, n>();
  for @fill (
    at in 0_u64..n,
    invariant spare: built.cap - built.len >= n + 1_u64
  ) {
    place_back(window: &built, value: 7_u8);
  }
  return move built;
}

fn main() -> status: ExitStatus pure {
  doc "MSR-6, INV-1: admitting a const generic as an affine atom adds a spelling and no fact source, so an invariant naming one is proved or refused exactly as one naming a local is.";
  let bytes = overstated::<4>();
  return exit_status(code: 0_u8);
}
