alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias ReadFile = std::fs::ReadFile;
alias close_read = std::fs::close_read;
alias exit_status = std::process::exit_status;

interface Disposer {
  fn release(factory: &HandleFactory, file: ReadFile) -> function_result: unit pure;
}

binding First : Disposer {
  release = release_read_file;
}

fn release_read_file(factory: &HandleFactory, file: ReadFile) -> function_result: unit writes(factory) {
  doc "FN-4: the explicit ordinary close has effects exceeding the formal's pure row. No implicit finalizer supplies the difference, and release itself carries no effect entry [STOR-3, STOR-8].";
  let closed = close_read(factory: factory, file: move file);
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
