alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Counter {
  doc "One count.";
  count: u64;
}

fn fill(counter: &Counter, steps: u64) -> result: unit writes(counter) contract {
  requires counter^.count + steps <= 800_u64;
} {
  doc "The body writes the count and the header states nothing about it, so the continuing kill removes the count's image at the loop head; the count read in the body is unbounded and adding one may overflow.";
  for (index in 0_u64..steps) {
    let now = counter^.count;
    let next = now + 1_u64;
    set counter^.count = next;
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
