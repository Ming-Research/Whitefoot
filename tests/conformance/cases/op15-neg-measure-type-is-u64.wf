alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn widen(n: i32) -> result: i32 pure {
  doc "An ordinary i32 consumer.";
  return n;
}

fn main() -> status: ExitStatus pure {
  doc "OP-15: a measure read's exact type is own u64 and its value mode is exact own, so the ordinary statement-local typing check applies at each use and no implicit conversion exists.";
  let r = slots_new::<u64, 4>();
  let n = widen(n: r.len);
  if n == 0_i32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
