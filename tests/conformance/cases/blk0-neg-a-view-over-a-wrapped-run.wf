alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A Ring's logical window is two extents, and a range reference has one len, so REF-4 refuses the range step over a Ring at the psuffix itself rather than submitting a non-wrap premise for proof. Without the refusal the range descriptor is one extent over a window that is two, and the read below would reach a byte the run does not own.";
  let run = ring_new::<u8, 4>();
  for (
    i in 0_u64..4_u64,
    invariant h: run.len == i
  ) {
    place_back(window: &run, value: 1_u8);
  }
  let window = &run[0_u64..4_u64];
  let last = deref(window)[3_u64];
  if last == 1_u8 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
