alias Args = std::text::Args;
alias DirectoryRead = std::fs::DirectoryRead;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias arg_get = std::text::arg_get;
alias close_directory = std::fs::close_directory;
alias close_read = std::fs::close_read;
alias exit_status = std::process::exit_status;
alias open_read = std::fs::open_read;
alias read_at = std::fs::read_at;
alias relative_path = std::fs::relative_path;

fn reads_marker(args: &Args, root: &DirectoryRead, files: &HandleFactory, position: u64) -> result: Bool reads(args), reads(root), writes(files) waits {
  match arg_get(args: args, position: position) {
    Ok(value: text) => {
      match relative_path(value: move text) {
        Ok(value: path) => {
          match open_read(factory: files, root: root, path: &path) {
            Ok(value: file) => {
              let bytes = array_filled::<u8, 2>(value: 0_u8);
              let window = &bytes[0_u64..2_u64];
              match read_at(factory: files, file: &file, destination: window, file_offset: 0_u64, start: 0_u64, end: 2_u64) {
                Ok(value: next) => {
                  close_read(factory: files, file: move file);
                  if next != 1_u64 {
                    return False();
                  }
                  return bytes[0_u64] == 81_u8;
                }
                Err(error: stop) => {
                  close_read(factory: files, file: move file);
                  return False();
                }
              }
            }
            Err(error: problem) => {
              return False();
            }
          }
        }
        Err(error: rejected) => {
          return False();
        }
      }
    }
    Err(error: absent) => {
      return False();
    }
  }
}

fn refuses_open(args: &Args, root: &DirectoryRead, files: &HandleFactory, position: u64) -> result: Bool reads(args), reads(root), writes(files) waits {
  match arg_get(args: args, position: position) {
    Ok(value: text) => {
      match relative_path(value: move text) {
        Ok(value: path) => {
          match open_read(factory: files, root: root, path: &path) {
            Ok(value: file) => {
              close_read(factory: files, file: move file);
              return False();
            }
            Err(error: problem) => {
              return True();
            }
          }
        }
        Err(error: rejected) => {
          return False();
        }
      }
    }
    Err(error: absent) => {
      return False();
    }
  }
}

fn exercise(args: &Args, cwd: &DirectoryRead, files: &HandleFactory) -> result: u8 reads(args), reads(cwd), writes(files) waits {
  let plain = reads_marker(args: args, root: cwd, files: files, position: 1_u64);
  if plain {
  } else {
    return 10_u8;
  }
  let marked = reads_marker(args: args, root: cwd, files: files, position: 2_u64);
  if marked {
  } else {
    return 11_u8;
  }
  let dotted = reads_marker(args: args, root: cwd, files: files, position: 3_u64);
  if dotted {
  } else {
    return 12_u8;
  }
  let directory = refuses_open(args: args, root: cwd, files: files, position: 4_u64);
  if directory {
  } else {
    return 13_u8;
  }
  let current = refuses_open(args: args, root: cwd, files: files, position: 5_u64);
  if current {
  } else {
    return 14_u8;
  }
  let trailing = refuses_open(args: args, root: cwd, files: files, position: 6_u64);
  if trailing {
  } else {
    return 15_u8;
  }
  let missing = refuses_open(args: args, root: cwd, files: files, position: 7_u64);
  if missing {
  } else {
    return 16_u8;
  }
  return 0_u8;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "open_read looks a path up component by component below its root: the same file is read by a/b/c.txt, ./a//b/./c.txt and a/b/./c.txt, where . and an empty component select the directory they are looked up in, while a/b, a/b/. and a/b/ name a directory and a/x/c.txt names a missing entry, so each of those four opens nothing.";
  let Inputs(args: arguments, cwd: root_directory, handles: files, ..) = move inputs;
  let std::fs::Directory(read: root, write: root_write) = move root_directory;
  std::fs::close_directory_write(factory: &files, directory: move root_write);
  let outcome = exercise(args: &arguments, cwd: &root, files: &files);
  close_directory(factory: &files, directory: move root);
  return exit_status(code: outcome);
}
