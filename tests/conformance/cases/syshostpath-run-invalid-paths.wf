alias DirectoryRead = std::fs::DirectoryRead;
alias HandleFactory = std::io::HandleFactory;
alias HostPaths = std::fs::HostPaths;
alias PathEncoding = std::fs::PathEncoding;
alias ReadFile = std::fs::ReadFile;

const window_bytes: Array<u8, 12> =[255_u8, 254_u8, 97_u8, 0_u8, 98_u8, 88_u8, 112_u8, 108_u8, 97_u8, 105_u8, 110_u8, 89_u8];

fn error_kind(error: &std::io::IoError) -> kind: u8 reads(error) {
  match error^ {
    NotFound(code: c, origin: o) => {
      return 1_u8;
    }
    PermissionDenied(code: c, origin: o) => {
      return 2_u8;
    }
    AlreadyExists(code: c, origin: o) => {
      return 9_u8;
    }
    NotDirectory(code: c, origin: o) => {
      return 3_u8;
    }
    IsDirectory(code: c, origin: o) => {
      return 4_u8;
    }
    DirectoryNotEmpty(code: c, origin: o) => {
      return 9_u8;
    }
    ReadOnly(code: c, origin: o) => {
      return 9_u8;
    }
    ResourceBusy(code: c, origin: o) => {
      return 9_u8;
    }
    InvalidInput(code: c, origin: o) => {
      return 9_u8;
    }
    InvalidPath(code: c, origin: o) => {
      return 5_u8;
    }
    Unsupported(code: c, origin: o) => {
      return 6_u8;
    }
    TimedOut(code: c, origin: o) => {
      return 9_u8;
    }
    DeadlinePassed() => {
      return 9_u8;
    }
    Cancelled() => {
      return 9_u8;
    }
    BrokenPipe(code: c, origin: o) => {
      return 9_u8;
    }
    WriteZero(code: c, origin: o) => {
      return 9_u8;
    }
    UnexpectedEnd(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionRefused(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionReset(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionAborted(code: c, origin: o) => {
      return 9_u8;
    }
    NotConnected(code: c, origin: o) => {
      return 9_u8;
    }
    AddressInUse(code: c, origin: o) => {
      return 9_u8;
    }
    AddressUnavailable(code: c, origin: o) => {
      return 9_u8;
    }
    ResourceExhausted(code: c, origin: o) => {
      return 9_u8;
    }
    FileTooLarge(code: c, origin: o) => {
      return 9_u8;
    }
    NoSpace(code: c, origin: o) => {
      return 9_u8;
    }
    QuotaExceeded(code: c, origin: o) => {
      return 9_u8;
    }
    CrossDevice(code: c, origin: o) => {
      return 9_u8;
    }
    DeviceFailure(code: c, origin: o) => {
      return 9_u8;
    }
    Other(code: c, origin: o) => {
      return 9_u8;
    }
  }
}

fn holds_byte(factory: &HandleFactory, file: &ReadFile, expected: u8) -> result: Bool writes(factory), writes(file) waits {
  let bytes = array_filled::<u8, 2>(value: 0_u8);
  match std::fs::read_at(factory: factory, file: file, destination: &bytes[0_u64..2_u64], file_offset: 0_u64, start: 0_u64, end: 2_u64) {
    Ok(value: next) => {
      if next != 1_u64 {
        return False();
      }
    }
    Err(error: problem) => {
      return False();
    }
  }
  let same = bytes[0_u64] == expected;
  return same;
}

fn refused_window(factory: &HandleFactory, paths: &HostPaths, base: &DirectoryRead, start: u64, end: u64, encoding: PathEncoding) -> result: Bool reads(paths), reads(base), writes(factory) waits contract {
  requires start <= end;
  requires end <= 12_u64;
} {
  match std::fs::open_host_read_bytes(factory: factory, paths: paths, base: base, path: &window_bytes[0_u64..12_u64], start: start, end: end, encoding: encoding) {
    Ok(value: file) => {
      std::fs::close_read(factory: factory, file: move file);
      return False();
    }
    Err(error: problem) => {
      let kind = error_kind(error: &problem);
      let invalid = kind == 5_u8;
      return invalid;
    }
  }
}

fn opened_window(factory: &HandleFactory, paths: &HostPaths, base: &DirectoryRead, encoding: PathEncoding) -> result: Bool reads(paths), reads(base), writes(factory) waits {
  match std::fs::open_host_read_bytes(factory: factory, paths: paths, base: base, path: &window_bytes[0_u64..12_u64], start: 6_u64, end: 11_u64, encoding: encoding) {
    Ok(value: file) => {
      let right = holds_byte(factory: factory, file: &file, expected: 80_u8);
      std::fs::close_read(factory: factory, file: move file);
      return right;
    }
    Err(error: problem) => {
      return False();
    }
  }
}

fn refused_argument(args: &std::text::Args, factory: &HandleFactory, paths: &HostPaths, base: &DirectoryRead) -> result: Bool reads(args), reads(paths), reads(base), writes(factory) waits {
  match std::text::arg_get(args: args, position: 1_u64) {
    Ok(value: text) => {
      match std::fs::open_host_directory_read(factory: factory, paths: paths, base: base, path: &text) {
        Ok(value: opened) => {
          std::fs::close_directory(factory: factory, directory: move opened);
          return False();
        }
        Err(error: problem) => {
          let kind = error_kind(error: &problem);
          let invalid = kind == 5_u8;
          return invalid;
        }
      }
    }
    Err(error: problem) => {
      return False();
    }
  }
}

fn exercise(args: &std::text::Args, factory: &HandleFactory, paths: &HostPaths, base: &DirectoryRead) -> result: u8 reads(args), reads(paths), reads(base), writes(factory) waits {
  let native = PathEncoding::NativeBytes();
  let text = PathEncoding::Utf8();
  let malformed = refused_window(factory: factory, paths: paths, base: base, start: 0_u64, end: 2_u64, encoding: text);
  if malformed {
  } else {
    return 1_u8;
  }
  let empty = refused_window(factory: factory, paths: paths, base: base, start: 2_u64, end: 2_u64, encoding: native);
  if empty {
  } else {
    return 2_u8;
  }
  let zero = refused_window(factory: factory, paths: paths, base: base, start: 2_u64, end: 5_u64, encoding: native);
  if zero {
  } else {
    return 3_u8;
  }
  let native_opened = opened_window(factory: factory, paths: paths, base: base, encoding: native);
  if native_opened {
  } else {
    return 4_u8;
  }
  let text_opened = opened_window(factory: factory, paths: paths, base: base, encoding: text);
  if text_opened {
  } else {
    return 5_u8;
  }
  let argument = refused_argument(args: args, factory: factory, paths: paths, base: base);
  if argument {
    return 0_u8;
  }
  return 6_u8;
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  doc "A host path that is not UTF-8 in a Utf8 window, an empty window, a window holding a zero byte and an empty argument each return InvalidPath without a lookup, while a window inside poison bytes opens exactly the bytes between its ends in either encoding. Before HostPaths exists name resolution rejects; a host lookup of a bad path, which reports NotFound or opens the file named by the bytes before a zero byte, exits 1 to 3 or 6, a window that read a poison byte exits 4 or 5, and an invocation without the authority exits 9.";
  let std::process::Inputs(args: args, cwd: directory, handles: factory, host_paths: host_paths, ..) = move inputs;
  let std::fs::Directory(read: reader, write: writer) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move writer);
  let outcome = 9_u8;
  match move host_paths {
    Some(value: paths) => {
      set outcome = exercise(args: &args, factory: &factory, paths: &paths, base: &reader);
    }
    None() => {
    }
  }
  std::fs::close_directory(factory: &factory, directory: move reader);
  return std::process::exit_status(code: outcome);
}
