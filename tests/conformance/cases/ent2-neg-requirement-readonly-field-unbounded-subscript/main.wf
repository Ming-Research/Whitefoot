alias ExitStatus = std::process::ExitStatus;
alias Node = pkg::kinds::Node;
alias exit_status = std::process::exit_status;
alias kinds = pkg::kinds;

fn child_count(nodes: &Slots<Node, 4>, kids: &[u64], i: u64) -> total: u64 reads(nodes), reads(kids) contract {
  requires deref(nodes)[i].count <= deref(kids).len;
} {
  doc "ENT-2, FN-8, OP-4: the requirement forms deref(nodes)[i] at body entry, where no earlier requirement bounds i, so its subscript owes an unproved i < deref(nodes).len at the clause.";
  return deref(nodes).len +wrap deref(kids).len;
}

fn main() -> status: ExitStatus pure {
  doc "Declaration only.";
  return exit_status(code: 0_u8);
}
