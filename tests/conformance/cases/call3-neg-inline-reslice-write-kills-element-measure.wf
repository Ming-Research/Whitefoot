alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn refill(part: &[Slots<u64, 8>], at: u64) -> result: unit writes(part) contract {
  requires at < deref(part).len;
} {
  doc "Replaces one element of the range with a full eight-element run.";
  let fresh = slots_new::<u64, 8>();
  for (k in 0_u64..8_u64) {
    if fresh.len < 8_u64 {
      place_back(window: &fresh, value: k);
    }
  }
  set deref(part)[at] = move fresh;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "The guard bounds the length of deref(view)[1_u64], an element of a bound range. The call's argument re-slices that range at the call, &deref(view)[1_u64..3_u64], which names the path view names extended by the re-slice's own range step [REF-4, EFF-5]. Under the outer range step both paths agree, and the index 1_u64 lies inside the inner range 1_u64..3_u64, so [OWN-7] does not separate the inner range step from the index step and the projected write kills the guarded element measure [CALL-3]. The loop's cells[c] then owes c < cells.len with no fact to discharge it, and OP-4 rejects.";
  let rows = slots_new::<Slots<u64, 8>, 4>();
  let first = slots_new::<u64, 8>();
  let second = slots_new::<u64, 8>();
  let third = slots_new::<u64, 8>();
  place_back(window: &rows, value: move first);
  place_back(window: &rows, value: move second);
  place_back(window: &rows, value: move third);
  let cells = array_filled::<u64, 3>(value: 7_u64);
  let total = 0_u64;
  if rows.len == 3_u64 {
    let view = &rows[0_u64..3_u64];
    if deref(view)[1_u64].len <= cells.len {
      refill(part: &deref(view)[1_u64..3_u64], at: 0_u64);
      for (c in 0_u64..deref(view)[1_u64].len) {
        let cell = cells[c];
        set total = total +wrap cell;
      }
    }
  }
  return exit_status(code: 0_u8);
}
