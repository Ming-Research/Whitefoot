fn probe() -> result: u64 pure {
  doc "The equality sentinel's false edge tightens the header bound before the increment.";
  let cursor = 0_u64;
  loop (
    invariant bounded: cursor <= 4_u64
  ) {
    if cursor == 4_u64 {
      break;
    }
    set cursor = cursor + 1_u64;
  }
  return cursor;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
