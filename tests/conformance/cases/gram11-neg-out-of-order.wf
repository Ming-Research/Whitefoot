alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn sub2(x: i32, y: i32) -> return_value: i32 pure {
  return x -wrap y;
}

fn main() -> return_value: ExitStatus pure {
  doc "GRAM-11: arguments out of declared order are rejected; declared order is the one legal byte sequence.";
  let r = sub2(y: 2_i32, x: 40_i32);
  return exit_status(code: 0_u8);
}
