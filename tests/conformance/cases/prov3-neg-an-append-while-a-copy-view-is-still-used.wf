alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A range reference captures the whole filled window, and take_back decreases its length below the range's captured endpoint. The formation bound no longer holds, so the later read through the invalid reference is refused [REF-2, REF-4, OP-10].";
  let run = slots_new::<u8, 4>();
  place_back(window: &run, value: 7_u8);
  place_back(window: &run, value: 9_u8);
  let window = &run[0_u64..2_u64];
  let dropped = take_back(window: &run);
  let seen = window^[0_u64];
  if seen == 7_u8 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
