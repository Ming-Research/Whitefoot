alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A range reference is formed over the filled window, and then take_back writes the window's last slot and its len. Those writes reach a proper prefix of the reference's path, so the reference is invalid after that call; the write itself is legal, and the later read through the stale reference is the rejection [REF-2, EFF-5].";
  let run = slots_new::<u8, 4>();
  place_back(window: &run, value: 7_u8);
  place_back(window: &run, value: 9_u8);
  let window = &run[0_u64..2_u64];
  let dropped = take_back(window: &run);
  let seen = deref(window)[0_u64];
  if seen == 7_u8 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
