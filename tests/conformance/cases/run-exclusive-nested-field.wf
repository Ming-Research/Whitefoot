alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Pair {
  changed: Slots<u64, 4>;
  untouched: Slots<u64, 4>;
}

fn push(pair: &Pair, value: u64) -> result: unit writes(pair.changed) contract {
  requires deref(pair).changed.len < deref(pair).changed.cap;
  ensures deref(pair).changed.len == deref(entry(pair)).changed.len + 1_u64;
} {
  doc "The projected write names one field, so the sibling field's support survives the call.";
  place_back(window: &deref(pair).changed, value: value);
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "Exact projected field effects kill the changed window's support while preserving its disjoint sibling; entry(pair) and exit field measures instantiate to the same resolved caller field at different states.";
  let changed = slots_new::<u64, 4>();
  let untouched = slots_new::<u64, 4>();
  let pair = Pair(changed: move changed, untouched: move untouched);
  push(pair: &pair, value: 7_u64);
  invariant changed_grew: pair.changed.len >= 1_u64;
  invariant sibling_kept: pair.untouched.len <= 0_u64;
  return exit_status(code: 0_u8);
}
