alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy enum Inner {
  Value(number: i32);
  Empty();
}

enum Wrap {
  W(inner: Inner);
  N();
}

fn main() -> status: ExitStatus pure {
  doc "OWN-1: an affine payload binder is consumed by one inner match; a second inner match of it is a use-after-consume.";
  let inner = Inner::Value(number: 7_i32);
  let w = Wrap::W(inner: move inner);
  match w {
    W(inner: s) => {
      match s {
        Value(number: first) => {
        }
        Empty() => {
        }
      }
      match s {
        Value(number: second) => {
        }
        Empty() => {
        }
      }
    }
    N() => {
    }
  }
  return exit_status(code: 0_u8);
}
