alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn filled<T: copy, const n: u64>(value: T) -> result: Slots<T, n> pure contract {
  ensures result.len == n;
} {
  doc "Builds a run of n slots, every one holding a copy of value; the copy bound is what admits the bare repeated use.";
  let block = array_filled::<T, n>(value: value);
  let built = slots_from_array::<T, n>(values: block);
  return move built;
}

fn first_or_length(taken: Slots<u8, 8>) -> outcome: Result<u64, Overflow> pure contract {
  ensures when Ok(value: reported): reported == taken.len;
} {
  doc "A routed relation names a consumed own operand's measure.";
  let reported = taken.len;
  return Ok<u64, Overflow>(value: reported);
}

fn needs_eight(bound: u64) -> ok: unit pure contract {
  requires 8_u64 <= bound;
} {
  doc "Needs a caller proof about its argument.";
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "A variant-routed ensures names a consumed own operand's measure. The relation is instantiated at the call over that call's call datum and established at the selected arm, where the caller reads it to discharge a later requirement.";
  let run = filled::<u8, 8>(value: 0_u8);
  match first_or_length(taken: move run) {
    Ok(value: reported) => {
      let confirmed = needs_eight(bound: reported);
    }
    Err(error: failure) => {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
