fn pick(cell: &Shared<u8>) -> result: u8 reads(cell) may_wait contract {
  ensures result >= 5_u8;
} {
  atomic value = &cell^ {
    if value^ == 1_u8 {
      return 6_u8;
    }
  }
  return 9_u8;
}

fn need(value: u8) -> result: u8 pure contract {
  requires value >= 5_u8;
} {
  return value;
}

fn main() -> status: std::process::ExitStatus pure may_wait {
  let cell = shared_new::<u8>(value: 1_u8);
  let got = pick(cell: &cell);
  let admitted = need(value: got);
  return std::process::exit_status(code: admitted);
}
