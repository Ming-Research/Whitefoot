struct Pair {
  cell: Shared<u64>;
  other: Shared<u64>;
}

fn witness() -> result: u64 pure waits {
  doc "REF-2: a move out of one field consumes the whole owner [WIN-3], so a reference to the owner itself is invalid afterwards and cannot reach the released sibling through it.";
  let c = shared_new::<u64>(value: 1_u64);
  let o = shared_new::<u64>(value: 2_u64);
  let pair = Pair(cell: move c, other: move o);
  let r = &pair;
  let gone = move pair.other;
  let seen = 0_u64;
  atomic state = &r^.cell {
    set seen = state^;
  }
  return seen;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
