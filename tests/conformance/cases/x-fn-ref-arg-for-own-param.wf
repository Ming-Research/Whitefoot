alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn takesown(n: i32) -> function_result: i32 pure {
  doc "Parameter n is an own i32 [FN-1].";
  return n;
}

fn main() -> status: ExitStatus pure {
  doc "The caller writes a reference where the signature declares an own value. A reference variable denotes the reference [REF-1] and its referent is reached only through deref, so the bare reference at an own parameter is the missing dereference [TYPE-7], whose fix is deref(b); the other half of the mode pair, an own value at a reference parameter, is instead a TYPE-5 mismatch.";
  let a = 5_i32;
  let b = &a;
  let r = takesown(n: b);
  return exit_status(code: 0_u8);
}
