fn reserve_slots(cell: &Box<Slots<u64>>, n: u64, capacity: u64) -> result: unit writes(cell) contract {
  requires cell^.inner.len == n;
  requires capacity >= cell^.inner.cap;
} {
  grow(cell: cell, capacity: capacity);
  invariant same_length: cell^.inner.len == n;
  return unit;
}

fn reserve_paged(cell: &Box<Paged<u64>>, n: u64, capacity: u64) -> result: unit writes(cell) contract {
  requires cell^.inner.len == n;
  requires capacity >= cell^.inner.cap;
} {
  grow_paged(cell: cell, capacity: capacity);
  invariant same_length: cell^.inner.len == n;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
