const names: Array<u8, 2> =[97_u8, 98_u8];

fn one(table: &ConcurrentHashMap<u8>) -> result: Bool reads(table) {
  let count = map_count::<u8>(map: table);
  return count == 1_u64;
}

fn deliver(store: Shared<ConcurrentHashMap<u8>>) -> result: unit pure waits {
  atomic t = &store {
    let key = &names[0_u64..1_u64];
    set t^[key] = Some<u8>(value: 1_u8);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let store = shared_map_new::<u8>(capacity: 0_u64);
  let name = &names[0_u64..1_u64];
  let second = &names[1_u64..2_u64];
  let n = 0_u64;
  let handle = shared_share::<ConcurrentHashMap<u8>>(shared: &store);
  spawn deliver(store: move handle);
  atomic t = &store when one(table: t) {
    set n = map_count::<u8>(map: t);
  }
  let code = cvt.wrap::<u64, u8>(n);
  return std::process::exit_status(code: code);
}
