alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn quotient_bound(count: u64, divisor: u64) -> result: u64 pure contract {
  requires 1_u64 <= divisor;
  ensures result <= count;
} {
  let value = count / divisor;
  return value;
}

fn covered(count: u64, divisor: u64) -> result: u64 pure contract {
  requires count <= 4096_u64;
  requires 1_u64 <= divisor;
  requires divisor <= 64_u64;
  ensures result <= count;
} {
  let quotient = count / divisor;
  let product = divisor * quotient;
  return product;
}

fn covered_by_set(count: u64, divisor: u64) -> result: u64 pure contract {
  requires count <= 4096_u64;
  requires 1_u64 <= divisor;
  requires divisor <= 64_u64;
  ensures result <= count;
} {
  let quotient = 0_u64;
  set quotient = count / divisor;
  let product = 0_u64;
  set product = quotient * divisor;
  return product;
}

fn main() -> status: ExitStatus pure {
  let divided = quotient_bound(count: 17_u64, divisor: 3_u64);
  let direct = covered(count: 17_u64, divisor: 3_u64);
  let committed = covered_by_set(count: 17_u64, divisor: 3_u64);
  if direct != 15_u64 {
    return exit_status(code: 1_u8);
  }
  if committed != 15_u64 {
    return exit_status(code: 2_u8);
  }
  if divided != 5_u64 {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
