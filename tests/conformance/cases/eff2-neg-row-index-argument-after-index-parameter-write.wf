alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn write_one(window: &Slots<u64, 4>, index: u64) -> result: unit writes(window[index]) contract {
  requires index < deref(window).len;
} {
  doc "Writes element index of the window.";
  set deref(window)[index] = 9_u64;
  return unit;
}

fn write_slot(window: &Slots<u64, 4>, index: u64) -> result: unit reads(window.len), writes(window[index]) contract {
  requires index < deref(window).len;
} {
  doc "Passes element 0 of the window to write_one.";
  set index = 0_u64;
  if index < deref(window).len {
    write_one(window: window, index: index);
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "EFF-1, EFF-2: the call form of set1-neg-row-index-write-after-index-parameter-write. The call's write reaches window at the argument index, which no longer holds write_slot's call value, so its path is window, and the declared row writes(window[index]) is refused with the repair writes(window).";
  let r = slots_new::<u64, 4>();
  place_back(window: &r, value: 1_u64);
  place_back(window: &r, value: 2_u64);
  let p = &r[0_u64];
  write_slot(window: &r, index: 1_u64);
  let seen = deref(p);
  if seen == 1_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
