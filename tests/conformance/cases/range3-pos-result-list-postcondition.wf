fn ramps(n: u64) -> (spare: Box<Array<u64>>, made: Box<Array<u64>>) pure contract {
  requires n <= 1000_u64;
  ensures made.inner.len == n;
  ensures forall up(k in 0_u64..made.inner.len): made.inner[k] == k;
} {
  doc "Builds a zeroed array and, as its second result, the array whose element k is k.";
  let zeros = box_array_filled::<u64>(count: n, value: 0_u64);
  let cells = box_array_filled::<u64>(count: n, value: 0_u64);
  for (
    k in 0_u64..n,
    invariant forall built(q in 0_u64..k): cells.inner[q] == q
  ) {
    set cells.inner[k] = k;
  }
  return move zeros, move cells;
}

fn checked_ramp(n: u64) -> (count: u64, made: Option<Box<Array<u64>>>) pure contract {
  ensures when Some(value: cells): forall up(k in 0_u64..cells.inner.len): cells.inner[k] == k;
} {
  doc "Builds the array whose element k is k as its second result, or none past a thousand.";
  if n > 1000_u64 {
    let none = None<Box<Array<u64>>>();
    return 0_u64, move none;
  }
  let cells = box_array_filled::<u64>(count: n, value: 0_u64);
  for (
    k in 0_u64..n,
    invariant forall built(q in 0_u64..k): cells.inner[q] == q
  ) {
    set cells.inner[k] = k;
  }
  let some = Some<Box<Array<u64>>>(value: move cells);
  return n, move some;
}

fn at_index(cells: &[u64]) -> result: u64 reads(cells) contract {
  requires forall up(k in 0_u64..cells^.len): cells^[k] == k;
} {
  doc "Returns the last element, which the requirement makes the last index.";
  if 0_u64 < cells^.len {
    let last = cells^.len - 1_u64;
    let value = cells^[last];
    return value;
  }
  return 0_u64;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Each postcondition names the second result: it is proved over the value the return hands back second and holds after the call for the binder that receives that ordinal, the routed one in the arm that takes Some, never for the first.";
  let (spare, made) = ramps(n: 5_u64);
  let length = made.inner.len;
  let got = at_index(cells: &made.inner[0_u64..length]);
  if got != 4_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  let zeros = spare.inner.len;
  if zeros != 5_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  let (count, maybe) = checked_ramp(n: 6_u64);
  match move maybe {
    None() => {
      return std::process::exit_status(code: 3_u8);
    }
    Some(value: cells) => {
      let size = cells.inner.len;
      let last = at_index(cells: &cells.inner[0_u64..size]);
      if last != 5_u64 {
        return std::process::exit_status(code: 4_u8);
      }
    }
  }
  if count != 6_u64 {
    return std::process::exit_status(code: 5_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
