alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn narrow(x: i32) -> return_value: i32 pure {
  doc "cvt.checked returns Result<Dst, NarrowError> for every numeric pair [OP-6]: i32->i8 yields Err(NarrowError()) when not exactly representable.";
  match cvt.checked::<i32, i8>(x) {
    Ok(value: v) => {
      return cvt::<i8, i32>(v);
    }
    Err(error: e) => {
      return 0_i32;
    }
  }
}

fn main() -> return_value: ExitStatus pure {
  return exit_status(code: 0_u8);
}
