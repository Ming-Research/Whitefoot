alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn clamp_range(value: i32, floor: i32, ceiling: i32) -> result: i32 pure contract {
  requires value >= floor;
  requires value <= ceiling;
  requires floor >= -100_i32;
  requires ceiling <= 100_i32;
  ensures result >= -100_i32;
  ensures result <= 100_i32;
} {
  return value;
}

fn main() -> status: ExitStatus pure {
  let result = clamp_range(value: -7_i32, floor: -50_i32, ceiling: 50_i32);
  if result == -7_i32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
