alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Frame {
  tag: u8;
  run: Slots<u8, 4>;
}

fn refresh(old: Slots<u8, 4>) -> fresher: Slots<u8, 4> pure {
  doc "Consumes the window it is handed and hands back another of the same shape.";
  let seen = old.len;
  let made = slots_new::<u8, 4>();
  return move made;
}

fn main() -> status: ExitStatus pure {
  doc "OP-12: the atomic in-place update at one field is not the partial consume that kills the whole root. The struct's other field is read after the commit, which no dead root admits, and the exit code reports it; no residual cleanup of the unselected content is derived.";
  let values = array_filled::<u8, 4>(value: 0_u8);
  let run = slots_from_array::<u8, 4>(values: values);
  let frame = Frame(tag: 3_u8, run: move run);
  set frame.run = refresh(old: move frame.run);
  let tag = frame.tag;
  return exit_status(code: tag);
}
