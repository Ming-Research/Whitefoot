alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A Slots window is a range-reference source [REF-4], its initialized storage being one contiguous extent beginning at slot zero [WIN-1]; a Ring is refused there instead, a wrapped window being two extents. Two overlapping range references of the one run are formed, which read/read overlap admits without limit [EFF-5], and the program reads the range length through one and the elements back through both.";
  let two = slots_new::<u8, 4>();
  place_back(window: &two, value: 3_u8);
  place_back(window: &two, value: 4_u8);
  let window = &two[0_u64..2_u64];
  let width = deref(window).len;
  if width == 2_u64 {
  } else {
    return exit_status(code: 21_u8);
  }
  let second_view = &two[0_u64..2_u64];
  let first = deref(window)[0_u64];
  let second = deref(second_view)[1_u64];
  let agreed = deref(second_view)[0_u64];
  if agreed == first {
  } else {
    return exit_status(code: 24_u8);
  }
  if first == 3_u8 {
  } else {
    return exit_status(code: 22_u8);
  }
  if second == 4_u8 {
  } else {
    return exit_status(code: 23_u8);
  }
  return exit_status(code: 0_u8);
}
