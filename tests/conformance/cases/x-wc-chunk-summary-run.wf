alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Summary {
  lines: u64;
  words: u64;
  bytes: u64;
  first_space: u64;
  last_space: u64;
}

fn summarize<const n: u64>(out: &Summary, input: Slots<u8, n>) -> function_result: unit writes(out.lines), writes(out.words), writes(out.bytes), writes(out.first_space), writes(out.last_space) {
  doc "Scans the owned chunk and publishes its counts through the field paths its row declares; the by-value input carries no effect entry [EFF-1].";
  let length = input.len;
  let index_value = 0_u64;
  let lines = 0_u64;
  let words = 0_u64;
  let previous_space = True();
  let first_space = 1_u64;
  if length == 0_u64 {
  } else {
    let first = input[0_u64];
    let first_ge_tab = first >= 9_u8;
    let first_le_cr = first <= 13_u8;
    let first_control_space = band(first_ge_tab, first_le_cr);
    let first_plain_space = first == 32_u8;
    let first_is_space = bor(first_control_space, first_plain_space);
    if first_is_space {
      set first_space = 1_u64;
    } else {
      set first_space = 0_u64;
    }
  }
  loop @scan {
    let done = index_value >= length;
    if done {
      break @scan;
    } else {
      let byte = input[index_value];
      let newline = byte == 10_u8;
      if newline {
        set lines = lines +wrap 1_u64;
      }
      let ge_tab = byte >= 9_u8;
      let le_cr = byte <= 13_u8;
      let control_space = band(ge_tab, le_cr);
      let plain_space = byte == 32_u8;
      let is_space = bor(control_space, plain_space);
      let not_space = bnot(is_space);
      let starts_word = band(previous_space, not_space);
      if starts_word {
        set words = words +wrap 1_u64;
      }
      set previous_space = is_space;
      set index_value = index_value +wrap 1_u64;
    }
  }
  set out^.lines = lines;
  set out^.words = words;
  set out^.bytes = length;
  set out^.first_space = first_space;
  if previous_space {
    set out^.last_space = 1_u64;
  } else {
    set out^.last_space = 0_u64;
  }
  return unit;
}

fn combine(out: &Summary, left: &Summary, right: &Summary) -> function_result: unit reads(left.lines), reads(left.words), reads(left.bytes), reads(left.first_space), reads(left.last_space), reads(right.lines), reads(right.words), reads(right.bytes), reads(right.first_space), reads(right.last_space), writes(out.lines), writes(out.words), writes(out.bytes), writes(out.first_space), writes(out.last_space) {
  doc "Combines two summaries associatively; the three reference parameters supply three distinct roots, so the call site proves every substituted pair disjoint [EFF-5, OWN-7].";
  if left^.bytes == 0_u64 {
    set out^.lines = right^.lines;
    set out^.words = right^.words;
    set out^.bytes = right^.bytes;
    set out^.first_space = right^.first_space;
    set out^.last_space = right^.last_space;
    return unit;
  }
  if right^.bytes == 0_u64 {
    set out^.lines = left^.lines;
    set out^.words = left^.words;
    set out^.bytes = left^.bytes;
    set out^.first_space = left^.first_space;
    set out^.last_space = left^.last_space;
    return unit;
  }
  let lines = left^.lines +wrap right^.lines;
  let raw_words = left^.words +wrap right^.words;
  let joined = 0_u64;
  if left^.last_space == 0_u64 {
    if right^.first_space == 0_u64 {
      set joined = 1_u64;
    }
  }
  let words = raw_words -wrap joined;
  let bytes = left^.bytes +wrap right^.bytes;
  set out^.lines = lines;
  set out^.words = words;
  set out^.bytes = bytes;
  set out^.first_space = left^.first_space;
  set out^.last_space = right^.last_space;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "Two owned byte chunks are summarized and associatively combined through one output struct and two input structs; whitespace state, early identity return, call-site disjointness, caller-visible writes, discharged bounds obligations, and inline-run storage execute through the normal compiler path.";
  let left_input = slots_new::<u8, 4>();
  place_back(window: &left_input, value: 97_u8);
  place_back(window: &left_input, value: 32_u8);
  place_back(window: &left_input, value: 98_u8);
  place_back(window: &left_input, value: 10_u8);
  let left = Summary(lines: 0_u64, words: 0_u64, bytes: 0_u64, first_space: 0_u64, last_space: 0_u64);
  summarize::<4>(out: &left, input: move left_input);
  let right_input = slots_new::<u8, 1>();
  place_back(window: &right_input, value: 99_u8);
  let right = Summary(lines: 0_u64, words: 0_u64, bytes: 0_u64, first_space: 0_u64, last_space: 0_u64);
  summarize::<1>(out: &right, input: move right_input);
  let total = Summary(lines: 0_u64, words: 0_u64, bytes: 0_u64, first_space: 0_u64, last_space: 0_u64);
  combine(out: &total, left: &left, right: &right);
  if total.lines == 1_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  if total.words == 3_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  if total.bytes == 5_u64 {
  } else {
    return exit_status(code: 3_u8);
  }
  if total.first_space == 0_u64 {
  } else {
    return exit_status(code: 4_u8);
  }
  if total.last_space == 0_u64 {
  } else {
    return exit_status(code: 5_u8);
  }
  let empty = Summary(lines: 0_u64, words: 0_u64, bytes: 0_u64, first_space: 1_u64, last_space: 1_u64);
  let copied = Summary(lines: 0_u64, words: 0_u64, bytes: 0_u64, first_space: 0_u64, last_space: 0_u64);
  combine(out: &copied, left: &empty, right: &total);
  if copied.lines == 1_u64 {
  } else {
    return exit_status(code: 6_u8);
  }
  if copied.words == 3_u64 {
  } else {
    return exit_status(code: 7_u8);
  }
  if copied.bytes == 5_u64 {
  } else {
    return exit_status(code: 8_u8);
  }
  return exit_status(code: 0_u8);
}
