alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

opaque struct Holder {
  item: Box<u8>;
}

fn duplicate(holder: Holder) -> (first: Holder, second: Holder) pure {
  doc "OWN-1: Holder owns a Box, which is declared nocopy, so Holder is affine and not copy. The first move consumes the binding, so the second move is a use of a dead binding.";
  let a = move holder;
  let b = move holder;
  return a, b;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
