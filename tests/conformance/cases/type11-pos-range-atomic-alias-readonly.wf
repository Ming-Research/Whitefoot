struct ZeroesAliasReadonly {
  cells: Array<u64, 1>;
  invariant(c): forall zero(k in 0_u64..c^.cells.len): c^.cells[k] == 0_u64;
}

fn need_aliasreadonly(z: &ZeroesAliasReadonly) -> result: unit pure {
  return unit;
}

fn update_aliasreadonly(first: Shared<ZeroesAliasReadonly>, second: SharedRead<ZeroesAliasReadonly>) -> result: unit pure waits {
  atomic a = &first, b = &second {
    need_aliasreadonly(z: a);
    need_aliasreadonly(z: b);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
