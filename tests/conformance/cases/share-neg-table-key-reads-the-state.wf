struct Store {
  map: KeyedTable<u8>;
  name: Array<u8, 2>;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let table = keyed_table_new::<u8>(capacity: 0_u64);
  let name = array_filled::<u8, 2>(value: 97_u8);
  let state = Store(map: move table, name: name);
  let store = shared_new::<Store>(value: move state);
  atomic s = &store, slot = &s^.map[&s^.name[0_u64..1_u64]] {
    set slot^ = Some<u8>(value: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
