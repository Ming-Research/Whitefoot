alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "swap admits two owning cell descriptors: a Box<u64> is affine and holds no reference, so exchanging the two descriptors leaves both roots live, each the sole owner of the cell the other held, and the previous content is read back through the second binding.";
  let first = box_new::<u64>(value: 1_u64);
  let second = box_new::<u64>(value: 2_u64);
  swap(first: &first, second: &second);
  let old = second.inner;
  if old == 1_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let current = first.inner;
  if current == 2_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
