alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Light {
  Red();
  Green();
  Yellow();
}

fn main() -> status: ExitStatus pure {
  doc "A traffic-light state machine advanced by value-matches: each match moves the own state and gives its own successor, so after three transitions the light returns to Red [OWN-13, GIVE-1, OP-1, SCOPE-3].";
  let s0 = Light::Red();
  let s1 = match s0 {
    Red() => {
      give Light::Green();
    }
    Green() => {
      give Light::Yellow();
    }
    Yellow() => {
      give Light::Red();
    }
  }
  let s2 = match s1 {
    Red() => {
      give Light::Green();
    }
    Green() => {
      give Light::Yellow();
    }
    Yellow() => {
      give Light::Red();
    }
  }
  let s3 = match s2 {
    Red() => {
      give Light::Green();
    }
    Green() => {
      give Light::Yellow();
    }
    Yellow() => {
      give Light::Red();
    }
  }
  let code = match s3 {
    Red() => {
      give 0_i32;
    }
    Green() => {
      give 1_i32;
    }
    Yellow() => {
      give 2_i32;
    }
  }
  if code == 0_i32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
