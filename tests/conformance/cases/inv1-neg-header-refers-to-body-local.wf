alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn sum_weighted(count: u64) -> total: u64 pure {
  let total = 0_u64;
  for (
    i in 0_u64..count,
    invariant bound: scratch <= i
  ) {
    let scratch = total;
    set total = total + 1_u64;
  }
  return total;
}

fn main() -> status: ExitStatus pure {
  let total = sum_weighted(count: 5_u64);
  return exit_status(code: 0_u8);
}
