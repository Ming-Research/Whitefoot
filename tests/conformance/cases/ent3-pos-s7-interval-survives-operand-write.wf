alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn at_most(value: u64, limit: u64) -> result: unit pure contract {
  requires value <= limit;
} {
  return unit;
}

fn rows(value: u64, other: u64) -> result: u64 pure {
  let high = ishr(value, 56_u32);
  set value = other;
  at_most(value: high, limit: 255_u64);
  let total = 0_u64;
  set total = imin(high, 7_u64);
  at_most(value: total, limit: 7_u64);
  return total;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
