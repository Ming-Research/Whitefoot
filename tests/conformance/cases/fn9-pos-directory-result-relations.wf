alias DirectorySource = std::fs::DirectorySource;
alias ListStop = std::fs::ListStop;
alias directory_next = std::fs::directory_next;

fn forward(source: &DirectorySource, destination: &[u8], start: u64, end: u64) -> (result: Result<unit, ListStop>, next: u64, entries: u64) writes(source), writes(destination) contract {
  requires start <= end;
  requires end <= deref(destination).len;
  ensures start <= next;
  ensures next <= end;
} {
  doc "An ordinary wrapper republishes the declared directory result bounds on both Result branches.";
  let (outcome, cursor, count) = directory_next(source: source, destination: destination, start: start, end: end);
  match outcome {
    Ok(value: done) => {
      return Ok<unit, ListStop>(value: unit), cursor, count;
    }
    Err(error: stopped) => {
      return Err<unit, ListStop>(error: stopped), start, count;
    }
  }
}

fn observe(source: &DirectorySource, destination: &[u8], start: u64, end: u64) -> result: unit writes(source), writes(destination) contract {
  requires start <= end;
  requires end <= deref(destination).len;
} {
  doc "The declared bounds cross the wrapper and remain available on both branches of the match.";
  let (outcome, cursor, count) = forward(source: source, destination: destination, start: start, end: end);
  match outcome {
    Ok(value: done) => {
      invariant bounded_low: start <= cursor;
      invariant bounded_high: cursor <= end;
    }
    Err(error: stopped) => {
      invariant bounded_low: start <= cursor;
      invariant bounded_high: cursor <= end;
    }
  }
  return unit;
}
