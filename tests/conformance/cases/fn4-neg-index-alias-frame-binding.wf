interface Touch {
  fn touch(table: &Array<Slots<u8, 2>, 2>, i: u64, j: u64) -> result: unit writes(table) contract {
    requires i < 2_u64;
    requires j < 2_u64;
    ensures table^[i].len == entry(table)^[i].len;
  };
}

fn update(actual_table: &Array<Slots<u8, 2>, 2>, actual_i: u64, actual_j: u64) -> updated: unit writes(actual_table[actual_j]) contract {
  requires actual_j < 2_u64;
} {
  set actual_table^[actual_j] = slots_new::<u8, 2>();
  return unit;
}

binding AliasingTouch : Touch {
  touch = update;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
