fn replace_alias(cell: &Option<u64>) -> result: u64 reads(cell), writes(cell) {
  doc "A whole-enum write through an alias invalidates the matched variant at the original reference.";
  let same = cell;
  match &cell^ {
    None() => {
      return 0_u64;
    }
    Some(value: inner) => {
      set same^ = None<u64>();
      let direct = cell^.Some.value;
      return direct;
    }
  }
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
