alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn dbl(x: i32) -> result: i32 pure {
  doc "A genuinely `pure` body: total `.wrap` addition and no reads, writes, or allocation [EFF-3].";
  let r = x +wrap x;
  return r;
}

fn main() -> status: ExitStatus pure {
  let a = dbl(x: 21_i32);
  if a == 42_i32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
