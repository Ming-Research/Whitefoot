fn bump_both(first: &u8, second: &u8) -> result: unit writes(first), writes(second) {
  set first^ = first^ +wrap 1_u8;
  set second^ = second^ +wrap 1_u8;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let x = shared_shards_new::<u8>(value: 0_u8);
  let y = shared_share::<Shards<u8>>(shared: &x);
  let mine = any_shard();
  atomic a = &x[mine], b = &y[mine] {
    bump_both(first: a, second: b);
  }
  return std::process::exit_status(code: 0_u8);
}
