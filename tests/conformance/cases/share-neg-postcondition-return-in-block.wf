fn pick(cell: &Shared<u8>) -> result: u8 reads(cell) waits contract {
  ensures result >= 5_u8;
} {
  atomic value = &cell^ {
    if value^ == 1_u8 {
      return 0_u8;
    }
  }
  return 9_u8;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let cell = shared_new::<u8>(value: 1_u8);
  let got = pick(cell: &cell);
  return std::process::exit_status(code: got);
}
