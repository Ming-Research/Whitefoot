alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const slots: Array<u8, 9> =[0_u8, 1_u8, 2_u8, 3_u8, 4_u8, 5_u8, 6_u8, 7_u8, 8_u8];

fn within(value: i8, low: i8, high: i8) -> result: unit pure contract {
  requires low <= value;
  requires value <= high;
} {
  return unit;
}

fn at_least(value: u8, floor: u8) -> result: unit pure contract {
  requires floor <= value;
} {
  return unit;
}

fn rows(small: u8, negative: i8) -> result: u8 pure {
  let low = iand(small, 127_u8);
  let same = reinterpret::<u8, i8>(low);
  within(value: same, low: 0_i8, high: 127_i8);
  if negative < 0_i8 {
    let resigned = reinterpret::<i8, u8>(negative);
    at_least(value: resigned, floor: 128_u8);
  }
  let rotated = irotl(1_u32, 3_u32);
  let slot = cvt::<u32, u64>(rotated);
  return slots[slot];
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
