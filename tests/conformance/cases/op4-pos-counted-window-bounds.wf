alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn window_sum<const n: u64>(buf: Slots<u8, n>, offset: u64, length: u64) -> total: u64 pure {
  let spare = buf.len;
  let end = offset +wrap length;
  let fits = end <= spare;
  let sum = 0_u64;
  if fits {
    for (
      i in offset..end,
      invariant within: end <= spare
    ) {
      let byte = buf[i];
      let widened = cvt::<u8, u64>(byte);
      set sum = sum +wrap widened;
    }
  }
  return sum;
}

fn copy_window(src: &[u8], dst: &[u8], start: u64, end: u64) -> result: unit reads(src), writes(dst) contract {
  define spare = deref(src).len;
  define out_room = deref(dst).len;
  requires start < end;
  requires end <= spare;
  requires end <= out_room;
} {
  for (i in start..end) {
    let byte = deref(src)[i];
    set deref(dst)[i] = byte;
  }
  return unit;
}

fn reverse_bytes<const n: u64>(buf: Slots<u8, n>) -> out: Slots<u8, n> pure {
  let work = move buf;
  let capacity = work.len;
  let lo = 0_u64;
  let hi = capacity;
  loop @rev (
    invariant lo_bound: lo <= capacity,
    invariant hi_bound: hi <= capacity
  ) {
    let has_more = lo < hi;
    if has_more {
    } else {
      break @rev;
    }
    let mirror = hi - 1_u64;
    let left = work[lo];
    let right = work[mirror];
    set work[lo] = right;
    set work[mirror] = left;
    set lo = lo + 1_u64;
    set hi = mirror;
  }
  return move work;
}

fn copy_checked_window(src: &[u8], start: u64, width: u64, dst: &[u8]) -> written: u64 reads(src), writes(dst) {
  let capacity = deref(src).len;
  let spare = deref(dst).len;
  let count = 0_u64;
  loop @copy (
    invariant progress: count <= width
  ) {
    let has_more = count < width;
    if has_more {
    } else {
      break @copy;
    }
    match start +checked count {
      Ok(value: source_at) => {
        let in_src = source_at < capacity;
        let in_dst = count < spare;
        if in_src {
        } else {
          break @copy;
        }
        if in_dst {
        } else {
          break @copy;
        }
        let byte = deref(src)[source_at];
        set deref(dst)[count] = byte;
      }
      Err(error: overflow) => {
        break @copy;
      }
    }
    set count = count +wrap 1_u64;
  }
  return count;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
