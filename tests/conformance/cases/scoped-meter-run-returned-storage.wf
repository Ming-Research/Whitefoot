alias MeterScope = std::process::MeterScope;
alias MemoryMeter = std::process::MemoryMeter;
alias ScopeView = std::process::ScopeView;
alias ScopeBody = std::process::ScopeBody;

fn build(argument: unit) -> result: Box<u64> pure {
  return box_new::<u64>(value: 71_u64);
}

binding Build : ScopeBody<unit, Box<u64>> {
  run = build;
}

fn release(value: Box<u64>, view: &ScopeView) -> result: unit writes(view) {
  return unit;
}

fn equals(view: &ScopeView, expected: u64) -> result: Bool writes(view) {
  match std::process::scope_bytes(view: view) {
    Some(value: bytes) => { return bytes == expected; }
    None() => { return False(); }
  }
}

fn close(meter: &MemoryMeter, scope: MeterScope) -> result: unit writes(meter) {
  loop {
    match std::process::scope_close(meter: meter, scope: move scope) {
      Ok(value: done) => { return done; }
      Err(error: owner) => { set scope = move owner; }
    }
  }
}

fn main(inputs: std::process::Inputs) -> result: std::process::ExitStatus pure waits {
  let std::process::Inputs(args: args, cwd: directory, stdout: out, stderr: err, handles: handles, stdin: input, clock: clock, wall_clock: wall, stops: stops, memory_meter: meter) = move inputs;
  let std::fs::Directory(read: read, write: write) = move directory;
  std::fs::close_directory_write(factory: &handles, directory: move write);
  std::fs::close_directory(factory: &handles, directory: move read);
  let correct = False();
  match std::process::scope_open(meter: &meter) {
    Err(error: full) => {}
    Ok(value: scope) => {
      let view = std::process::scope_view(scope: &scope);
      let outcome = spawn std::process::scope_run::<Build>(scope: move scope, argument: unit);
      match move outcome {
        Refused(scope: owner, argument: original) => { close(meter: &meter, scope: move owner); }
        Ran(scope: owner, result: block) => {
          let retained = equals(view: &view, expected: 8_u64);
          let payload = block.inner == 71_u64;
          match std::process::scope_close(meter: &meter, scope: move owner) {
            Ok(value: premature) => { release(value: move block, view: &view); }
            Err(error: busy_owner) => {
              release(value: move block, view: &view);
              let empty = equals(view: &view, expected: 0_u64);
              close(meter: &meter, scope: move busy_owner);
              set correct = band(retained, band(payload, empty));
            }
          }
        }
      }
    }
  }
  if correct { return std::process::exit_status(code: 0_u8); }
  return std::process::exit_status(code: 1_u8);
}
