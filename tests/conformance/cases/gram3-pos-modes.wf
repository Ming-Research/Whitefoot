alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn use3(a: i32, b: &i32, part: &[i32]) -> return_value: i32 reads(b), reads(part) contract {
  requires 0_u64 < deref(part).len;
} {
  doc "GRAM-3: a bare i32 type selects value mode, while &i32 and &[i32] select the reference and range-reference parameter kinds. Write authority is the row's [EFF-1].";
  let first = deref(part)[0_u64];
  let x = a +wrap deref(b);
  return x +wrap first;
}

fn main() -> return_value: ExitStatus pure {
  return exit_status(code: 0_u8);
}
