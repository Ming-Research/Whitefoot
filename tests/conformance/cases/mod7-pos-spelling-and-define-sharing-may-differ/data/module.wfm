public enum Sign {
  Neg();
  Zero();
  Pos();
}

public fn sign_of(value: i32) -> result: Sign pure doc "Classifies a value by its sign.";

public fn bounded(value: u64) -> result: pkg::data::Sign pure contract {
  define limit = 10_u64;
  requires value < limit;
} doc "Classifies a small value.";
