alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Choice {
  Short(values: Slots<u8, 4>);
  Long(values: Slots<u8, 8>);
}

fn needs_one<const n: u64>(values: &Slots<u8, n>) -> result: unit reads(values.len) contract {
  requires deref(values).len == 1_u64;
} {
  let observed = deref(values).len;
  return unit;
}

fn inspect(choose_short: Bool) -> result: unit pure {
  doc "MSR-3 gives each enum payload field its complete variant-and-field place step. One value-if delivers Short capacity four with established length one or Long capacity eight with established length two to the same match. The Short arm discharges needs_one; the Long arm must not inherit Short's fact and is rejected by FN-8.";
  let choice = if choose_short {
    let short_values = slots_new::<u8, 4>();
    place_back(window: &short_values, value: 11_u8);
    let short = Choice::Short(values: move short_values);
    give move short;
  } else {
    let long_values = slots_new::<u8, 8>();
    place_back(window: &long_values, value: 17_u8);
    place_back(window: &long_values, value: 23_u8);
    let long = Choice::Long(values: move long_values);
    give move long;
  }
  match choice {
    Short(values: selected) => {
      needs_one::<4>(values: &selected);
    }
    Long(values: selected) => {
      needs_one::<8>(values: &selected);
    }
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
