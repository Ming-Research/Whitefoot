struct Holder {
  len: Box<u64>;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "An ordinary owned field named len retains its root-consuming move; spelling-only measure routing previously rejected this move at WIN-3.";
  let value = box_new::<u64>(value: 17_u64);
  let holder = Holder(len: move value);
  let recovered = move holder.len;
  let number = recovered.inner;
  if number != 17_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 42_u8);
}
