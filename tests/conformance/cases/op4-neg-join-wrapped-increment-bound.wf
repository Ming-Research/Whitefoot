alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn get(b: &[u8], i: u64, pick: Bool) -> result: u8 reads(b) {
  doc "One predecessor bounds i +wrap 1, whose wrapped image is not the mathematical i + 1; the other bounds i directly.";
  let spare = deref(b).len;
  if pick {
    let stepped = i +wrap 1_u64;
    let inside = spare >= stepped;
    if inside {
    } else {
      return 0_u8;
    }
  } else {
    let inside2 = i < spare;
    if inside2 {
    } else {
      return 0_u8;
    }
  }
  return deref(b)[i];
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
