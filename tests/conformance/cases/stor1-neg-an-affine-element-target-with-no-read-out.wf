alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "An element target holding a heap-owned run is stored over while it is live and while the right-hand side supplies a different run. Assigning over an owned place releases the affine previous value, so the store is admitted and no read-out form is required.";
  let empty = slots_new::<Box<Slots<u8>>, 2>();
  let small = box_slots_new::<u8>(capacity: 256_u64);
  place_back(window: &empty, value: move small);
  let grid = move empty;
  let other = box_slots_new::<u8>(capacity: 512_u64);
  set grid[0_u64] = move other;
  let held = grid.len;
  if held == 1_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
