alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn compare(left: u32, right: u32) -> return_value: u32 pure {
  doc "OP-1 refuses a written type argument on iand; both operands belong to its domain, so only the written argument is invalid.";
  return iand::<u32>(left, right);
}

fn main() -> return_value: ExitStatus pure {
  return exit_status(code: 0_u8);
}
