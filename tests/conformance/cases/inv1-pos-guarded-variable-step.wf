alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn count_to(limit: u64) -> reached: u64 pure {
  let cursor = 0_u64;
  loop (
    invariant bounded: cursor <= limit
  ) {
    let remaining = cursor < limit;
    if remaining {
      let step_defined = cursor +defined 2_u64;
      if step_defined {
      } else {
        break;
      }
      let candidate = cursor + 2_u64;
      let big_fits = candidate <= limit;
      if big_fits {
        set cursor = candidate;
      } else {
        let small_defined = cursor +defined 1_u64;
        if small_defined {
        } else {
          break;
        }
        set cursor = cursor + 1_u64;
      }
    } else {
      break;
    }
  }
  return cursor;
}

fn main() -> status: ExitStatus pure {
  let reached = count_to(limit: 10_u64);
  return exit_status(code: 0_u8);
}
