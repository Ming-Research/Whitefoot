fn is_three(value: u64) -> result: unit pure contract {
  requires value == 3_u64;
} {
  return unit;
}

fn not_three(value: u64) -> result: unit pure contract {
  requires value != 3_u64;
} {
  return unit;
}

fn selected(value: u64) -> result: u8 pure {
  match value +wrap 1_u64 {
    3_u64 => {
      let computed = value +wrap 1_u64;
      is_three(value: computed);
      return 1_u8;
    }
    else => {
      let computed = value +wrap 1_u64;
      not_three(value: computed);
      return 0_u8;
    }
  }
}

fn main() -> status: std::process::ExitStatus pure {
  let named = selected(value: 2_u64);
  let other = selected(value: 4_u64);
  let wrapped = selected(value: 18446744073709551615_u64);
  if named != 1_u8 {
    return std::process::exit_status(code: 1_u8);
  }
  if other != 0_u8 {
    return std::process::exit_status(code: 2_u8);
  }
  if wrapped != 0_u8 {
    return std::process::exit_status(code: 3_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
