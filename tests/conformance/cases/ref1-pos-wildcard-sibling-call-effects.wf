alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Node {
  value: u64;
  next: Option<Box<Node>>;
}

fn read_and_clear(node: &Node) -> result: u64 reads(node.value), writes(node.next) {
  let observed = deref(node).value;
  set deref(node).next = None<Box<Node>>();
  return observed;
}

fn inspect(root: &Node) -> result: u64 writes(root) {
  let cursor = root;
  for (i in 0_u64..2_u64) {
    match deref(cursor).next {
      Some(value: child) => {
        set cursor = &deref(child).inner;
      }
      None() => {
        break;
      }
    }
  }
  return read_and_clear(node: cursor);
}

fn main() -> status: ExitStatus pure {
  doc "One captured cursor target retains disjoint finite sibling effects at a call.";
  return exit_status(code: 0_u8);
}
