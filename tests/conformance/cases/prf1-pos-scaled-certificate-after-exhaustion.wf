alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn prf1_scaled_after_exhaustion(limit: u64) -> total: u64 pure contract {
  requires limit <= 100_u64;
} {
  doc "INV-1 exact exhaustion substitutes limit for i in sum <= 2*i. A fresh local name denotes the exported binder-free premise P: sum <= 2*limit; the header name has expired. The coefficient two keeps P outside ENT-3.S16. For the target 3*P, ENT-6 AUTO subtracts P at most twice, no L0 image matches the scaled residual, interval discharge fails, and integer tightening only divides. The post-loop certificate is required.";
  let sum = 0_u64;
  for (
    i in 0_u64..limit,
    invariant sum_bound: sum <= 2_u64 * i
  ) {
    set sum = sum + 1_u64;
  }
  invariant exact_bound: sum <= 2_u64 * limit;
  invariant scaled_bound: 3_u64 * sum <= 6_u64 * limit {
    use 3 times exact_bound;
  }
  return sum;
}

fn main() -> status: ExitStatus pure {
  let total = prf1_scaled_after_exhaustion(limit: 5_u64);
  if total == 5_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
