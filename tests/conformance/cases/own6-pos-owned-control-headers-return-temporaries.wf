alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Cell {
  value: u64;
}

fn choose(cell: &Cell) -> result: Option<u64> writes(cell.value) {
  doc "Writes the cell and returns a payload result.";
  set deref(cell).value = 9_u64;
  return Some<u64>(value: 7_u64);
}

fn decide(cell: &Cell) -> result: Bool writes(cell.value) {
  doc "Writes the cell and selects the true branch.";
  set deref(cell).value = 11_u64;
  return True();
}

fn refuse(cell: &Cell) -> result: Bool writes(cell.value) {
  doc "Writes the cell and selects the false branch.";
  set deref(cell).value = 17_u64;
  return False();
}

fn through_holder(cell: &Cell) -> result: u64 writes(cell.value) {
  doc "A helper whose own reference parameter supplies every header argument resumes that path after each header call has ended.";
  match choose(cell: cell) {
    None() => {
      return 0_u64;
    }
    Some(value: chosen) => {
      set deref(cell).value = chosen;
      if decide(cell: cell) {
        let bumped = deref(cell).value +wrap 1_u64;
        set deref(cell).value = bumped;
      }
      return deref(cell).value;
    }
  }
}

fn main() -> status: ExitStatus pure {
  doc "Match and if headers, in statement and value forms, end their argument references before the branch work begins, so the same path is written again inside each branch.";
  let cell = Cell(value: 3_u64);
  match choose(cell: &cell) {
    None() => {
      return exit_status(code: 1_u8);
    }
    Some(value: chosen) => {
      set cell.value = chosen;
    }
  }
  if cell.value != 7_u64 {
    return exit_status(code: 2_u8);
  }
  let selected = match choose(cell: &cell) {
    None() => {
      give 0_u64;
    }
    Some(value: chosen) => {
      let bumped = chosen +wrap 1_u64;
      set cell.value = bumped;
      give bumped;
    }
  }
  if selected != 8_u64 {
    return exit_status(code: 3_u8);
  }
  if decide(cell: &cell) {
    let bumped = cell.value +wrap 1_u64;
    set cell.value = bumped;
  }
  if cell.value != 12_u64 {
    return exit_status(code: 4_u8);
  }
  let tested = if decide(cell: &cell) {
    let bumped = cell.value +wrap 2_u64;
    set cell.value = bumped;
    give bumped;
  } else {
    give 0_u64;
  }
  if tested != 13_u64 {
    return exit_status(code: 5_u8);
  }
  let rejected = if refuse(cell: &cell) {
    give 0_u64;
  } else {
    let bumped = cell.value +wrap 1_u64;
    set cell.value = bumped;
    give bumped;
  }
  if rejected != 18_u64 {
    return exit_status(code: 7_u8);
  }
  let resumed = through_holder(cell: &cell);
  if resumed != 12_u64 {
    return exit_status(code: 6_u8);
  }
  return exit_status(code: 0_u8);
}
