struct Store {
  map: KeyedTable<u8>;
  count: u8;
}

const names: Array<u8, 2> =[97_u8, 98_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let table = keyed_table_new::<u8>(capacity: 0_u64);
  let state = Store(map: move table, count: 0_u8);
  let store = shared_new::<Store>(value: move state);
  let name = &names[0_u64..1_u64];
  let keys = key_set_new(capacity: 1_u64);
  key_set_put(keys: &keys, key: name, payload: 1_u64);
  atomic s = &store, entries = &s^.map[keys] {
    let all = &entries^[0_u64..1_u64];
    set s^.count = 1_u8;
  }
  return std::process::exit_status(code: 0_u8);
}
