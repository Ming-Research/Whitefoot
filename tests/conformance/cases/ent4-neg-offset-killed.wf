fn probe(cursor: u64) -> result: unit pure {
  doc "Replacing a supporting term kills its offset disequality.";
  if cursor == 4_u64 {
    return unit;
  }
  set cursor = 4_u64;
  invariant tightened: cursor <= 3_u64;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
