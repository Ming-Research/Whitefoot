fn decrement(values: &Array<u8, 2>, index: u64) -> result: u8 reads(values[index]) contract {
  requires index < values^.len;
  requires 1_u8 <= values^[index];
} {
  let digit = values^[index];
  return digit - 1_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  let values = array_filled::<u8, 2>(value: 7_u8);
  if 1_u8 <= values[1_u64] {
    set values[1_u64] = 0_u8;
    let digit = decrement(values: &values, index: 1_u64);
    return std::process::exit_status(code: digit);
  }
  return std::process::exit_status(code: 0_u8);
}
