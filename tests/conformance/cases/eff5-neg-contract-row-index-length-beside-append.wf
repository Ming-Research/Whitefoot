fn touch(a: &Slots<u64, 4>, b: &Slots<u64, 4>, j: u64) -> result: unit writes(a.next), writes(a.len), writes(b[j]) contract {
  requires a^.len < a^.cap;
  requires j < b^.len;
} {
  place_back(window: a, value: 1_u64);
  set b^[j] = 5_u64;
  return unit;
}

fn caller() -> result: unit pure {
  doc "EFF-5: the contract read b^.len substitutes to window.len and meets writes(a.len), also window.len; the complete touch call is rejected even though the live row index is separate from the append slot.";
  let window = slots_new::<u64, 4>();
  place_back(window: &window, value: 0_u64);
  touch(a: &window, b: &window, j: 0_u64);
  return unit;
}
