alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "OP-11: swap exchanges the values at two owned places of one type and consumes neither root, so two elements of one window exchange slots with no writer-observable point at which a slot is empty or a stored element has a second owner. It is the one operation whose two reference arguments may name the same place, so the pair needs no distinctness proof. The exit code reports each cell's own capacity after the exchange.";
  let grid = slots_new::<Box<Slots<u8>>, 2>();
  let small = box_slots_new::<u8>(capacity: 256_u64);
  place_back(window: &grid, value: move small);
  let large = box_slots_new::<u8>(capacity: 512_u64);
  place_back(window: &grid, value: move large);
  swap(first: &grid[0_u64], second: &grid[1_u64]);
  let back = take_back(window: &grid);
  let width = back.inner.cap;
  if width == 256_u64 {
    let front = take_back(window: &grid);
    let other = front.inner.cap;
    if other == 512_u64 {
      return exit_status(code: 0_u8);
    }
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 1_u8);
}
