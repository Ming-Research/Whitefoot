fn ignore(r: &[u64], v: u64) -> result: u64 pure {
  doc "Ignores its reference argument.";
  return v;
}

fn fill(out: &[u64]) -> result: unit writes(out) {
  doc "Writes each cell once, passing the run to a callee that never touches it.";
  let n = out^.len;
  for (
    k in 0_u64..n,
    apart(i, j) {
    }
  ) {
    let y = ignore(r: &out^[0_u64..n], v: k);
    set out^[k] = y;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
