alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn get(x: &Slots<u64, 4>, i: u64) -> result: u64 reads(x) contract {
  requires i < x^.len;
} {
  doc "Reads element i of the window x names.";
  let v = x^[i];
  return v;
}

fn probe(rows: &Slots<Slots<u64, 4>, 4>, flag: Bool) -> result: u8 reads(rows) {
  doc "REF-1, ENT-2, FN-8: a write of k in one branch leaves wr = &rows^[k] one reference to the row its formation selected, as a write on every path does. That description is exact, so wr^.len is the term of that row, the one the call's requirement 2 < x^.len is instantiated at, and the guard 3 <= wr^.len proves it.";
  let k = 0_u64;
  if k < rows^.len {
    let wr = &rows^[k];
    if flag {
      set k = 1_u64;
    }
    if 3_u64 <= wr^.len {
      let d = get(x: wr, i: 2_u64);
      return 0_u8;
    }
  }
  return 0_u8;
}

fn main() -> status: ExitStatus pure {
  doc "Builds two rows of lengths one and three and selects the write of k by whether the window holds both; every path exits 0.";
  let rows = slots_new::<Slots<u64, 4>, 4>();
  let a = slots_new::<u64, 4>();
  let b = slots_new::<u64, 4>();
  place_back(window: &a, value: 1_u64);
  place_back(window: &b, value: 1_u64);
  place_back(window: &b, value: 2_u64);
  place_back(window: &b, value: 3_u64);
  place_back(window: &rows, value: move a);
  place_back(window: &rows, value: move b);
  let flag = rows.len == 2_u64;
  let code = probe(rows: &rows, flag: flag);
  return exit_status(code: code);
}
