alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn probe<const n: u64>(table: Slots<u8, n>, idx: u64, limit: u64) -> found: u8 pure contract {
  define spare = table.len;
  requires idx < limit;
  requires limit <= spare;
} {
  doc "A named local bound refers to the original index value. Committing 255 into the index supplies no bound against an arbitrary window length, so ENT-5 must not reinterpret the published invariant using the new image.";
  let measured = table.len;
  invariant in_range: idx < measured;
  set idx = 255_u64;
  let byte = table[idx];
  return byte;
}

fn main() -> status: ExitStatus pure {
  let table = slots_new::<u8, 4>();
  place_back(window: &table, value: 0_u8);
  place_back(window: &table, value: 0_u8);
  place_back(window: &table, value: 0_u8);
  place_back(window: &table, value: 0_u8);
  let found = probe::<4>(table: move table, idx: 1_u64, limit: 4_u64);
  return exit_status(code: found);
}
