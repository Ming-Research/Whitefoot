fn helper(source: &Slots<u64, 4>, target: &Slots<u64, 4>) -> result: unit writes(target.last), writes(target.len) contract {
  requires target^.len == 1_u64;
  requires forall zero(k in 0_u64..1_u64): source^[k] == 0_u64;
} {
  let removed = take_back(window: target);
  return unit;
}

fn caller() -> result: unit pure {
  let values = slots_new::<u64, 4>();
  place_back(window: &values, value: 0_u64);
  helper(source: &values, target: &values);
  return unit;
}
