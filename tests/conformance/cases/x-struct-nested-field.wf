alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Inner {
  v: i32;
}

struct Outer {
  inner: Inner;
  k: i32;
}

fn main() -> status: ExitStatus pure {
  doc "TYPE-2: a nested struct field (a struct-typed field); read the inner field through the outer.";
  let inner_atom_0001 = Inner(v: 10_i32);
  let o = Outer(inner: inner_atom_0001, k: 5_i32);
  let s = o.inner.v +wrap o.k;
  let status_code = cvt::<i32, u8>(s);
  return exit_status(code: status_code);
}
