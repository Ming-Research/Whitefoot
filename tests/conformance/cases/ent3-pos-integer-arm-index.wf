const table: Array<u8, 2> =[10_u8, 20_u8];

fn selected(index: u64) -> result: u8 pure {
  match index {
    1_u64 => {
      return table[index];
    }
    else => {
      return 0_u8;
    }
  }
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
