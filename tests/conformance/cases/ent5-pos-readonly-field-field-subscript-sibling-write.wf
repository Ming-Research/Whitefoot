struct Cursor {
  k: u64;
  other: u64;
}

fn select(table: &[Slots<u8, 8>], s: &Cursor, i: u64) -> result: u8 reads(table), reads(s.k), writes(s.other) contract {
  requires s^.k < table^.len;
} {
  doc "ENT-5 and OWN-7: the offset's support is k's field storage, so writing the disjoint sibling other preserves both the outer bound and the selected row's length guard.";
  if i < table^[s^.k].len {
    set s^.other = 1_u64;
    return table^[s^.k][i];
  }
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The function body is checked without a call.";
  return std::process::exit_status(code: 0_u8);
}
