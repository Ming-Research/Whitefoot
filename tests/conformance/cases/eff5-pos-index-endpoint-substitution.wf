alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn write_slot(window: &Slots<u64, 4>, index: u64, value: u64) -> result: unit writes(window[index]) contract {
  requires index < deref(window).len;
} {
  doc "EFF-5: an IDENT index in a declared effect path takes the value its own argument supplies, evaluated once at the call.";
  set deref(window)[index] = value;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "EFF-5: each effect path rooted at a reference parameter takes that argument's path and each IDENT index takes its argument's value, so a live reference at a proved-distinct offset is not a bystander of the substituted write.";
  let r = slots_new::<u64, 4>();
  place_back(window: &r, value: 1_u64);
  place_back(window: &r, value: 2_u64);
  let p = &r[0_u64];
  write_slot(window: &r, index: 1_u64, value: 9_u64);
  let seen = deref(p);
  if seen == 1_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
