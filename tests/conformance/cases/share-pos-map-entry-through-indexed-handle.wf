const names: Array<u8, 2> =[97_u8, 98_u8];

fn put(maps: &Array<Shared<ConcurrentHashMap<u64>>, 2>, slot: u64, key: &[u8], value: u64) -> result: unit reads(maps), reads(key) waits contract {
  requires slot < 2_u64;
} {
  atomic slot_entry = &maps^[slot][key] {
    set slot_entry^ = Some<u64>(value: value);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let first = shared_map_new::<u64>(capacity: 0_u64);
  let second = shared_map_new::<u64>(capacity: 0_u64);
  let slots = slots_new::<Shared<ConcurrentHashMap<u64>>, 2>();
  place_back(window: &slots, value: move first);
  place_back(window: &slots, value: move second);
  let maps = slots_into_array::<Shared<ConcurrentHashMap<u64>>, 2>(values: move slots);
  let a = &names[0_u64..1_u64];
  let b = &names[1_u64..2_u64];
  put(maps: &maps, slot: 1_u64, key: a, value: 5_u64);
  put(maps: &maps, slot: 1_u64, key: b, value: 7_u64);
  put(maps: &maps, slot: 0_u64, key: a, value: 30_u64);
  let ones = 0_u64;
  let zeros = 0_u64;
  atomic one = &maps[1_u64], zero = &maps[0_u64] {
    set ones = map_count::<u64>(map: one);
    set zeros = map_count::<u64>(map: zero);
  }
  let counted = ones *wrap 10_u64;
  set counted = counted +wrap zeros;
  let seen = 0_u64;
  atomic slot_entry = &maps[1_u64][b] {
    match slot_entry^ {
      Some(value: kept) => {
        set seen = kept^;
      }
      None() => {
        set seen = 0_u64;
      }
    }
  }
  set counted = counted +wrap seen;
  let code = cvt.wrap::<u64, u8>(counted);
  return std::process::exit_status(code: code);
}
