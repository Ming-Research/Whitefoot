alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn exchange(slot: &Box<u64>, incoming: &Box<u64>) -> result: unit writes(slot), writes(incoming) {
  doc "Exchanges the two cells with swap, which consumes neither root and leaves each root the sole owner of the value the other held.";
  swap(first: slot, second: incoming);
  return unit;
}

fn observe(owner: Box<u64>, incoming: Box<u64>) -> result: u64 pure {
  doc "EFF-2: the exchange changes the value at owner without changing that storage place, and its later read names owner. Both parameters are by-value, so neither contributes an effect path and the row is the empty one.";
  exchange(slot: &owner, incoming: &incoming);
  return owner.inner;
}

fn main() -> status: ExitStatus pure {
  doc "Builds two cells and exchanges them through the helper.";
  let held = box_new::<u64>(value: 3_u64);
  let spare = box_new::<u64>(value: 5_u64);
  let seen = observe(owner: move held, incoming: move spare);
  return exit_status(code: 0_u8);
}
