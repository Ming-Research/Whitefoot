const names: Array<u8, 3> =[97_u8, 98_u8, 99_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let store = shared_map_new::<u64>(capacity: 0_u64);
  let keys = key_set_new(capacity: 4_u64);
  let payloads = array_filled::<u64, 3>(value: 0_u64);
  let index_0 = key_set_insert(keys: &keys, key: &names[1_u64..2_u64]);
  if index_0 < payloads.len {
    set payloads[index_0] = 2_u64;
  } else {
    return std::process::exit_status(code: 3_u8);
  }
  let index_1 = key_set_insert(keys: &keys, key: &names[0_u64..1_u64]);
  if index_1 < payloads.len {
    set payloads[index_1] = 1_u64;
  } else {
    return std::process::exit_status(code: 4_u8);
  }
  let index_2 = key_set_insert(keys: &keys, key: &names[1_u64..2_u64]);
  if index_2 < payloads.len {
    set payloads[index_2] = 5_u64;
  } else {
    return std::process::exit_status(code: 5_u8);
  }
  if keys.len != 2_u64 {
    return std::process::exit_status(code: 6_u8);
  }
  if payloads[0_u64] != 5_u64 {
    return std::process::exit_status(code: 7_u8);
  }
  if payloads[1_u64] != 1_u64 {
    return std::process::exit_status(code: 9_u8);
  }
  if keys.len > payloads.len {
    return std::process::exit_status(code: 10_u8);
  }
  atomic entries = &store[keys] {
    for @put (at in 0_u64..keys.len) {
      let payload = payloads[at];
      set entries^[at] = Some<u64>(value: payload);
    }
  }
  let b = &names[1_u64..2_u64];
  let a = &names[0_u64..1_u64];
  let b_value = 0_u64;
  let a_value = 0_u64;
  atomic slot = &store[b] {
    match slot^ {
      Some(value: held) => {
        set b_value = held^;
      }
      None() => {
      }
    }
  }
  atomic slot = &store[a] {
    match slot^ {
      Some(value: held) => {
        set a_value = held^;
      }
      None() => {
      }
    }
  }
  if b_value != 5_u64 {
    return std::process::exit_status(code: 11_u8);
  }
  if a_value != 1_u64 {
    return std::process::exit_status(code: 12_u8);
  }
  let sum = 0_u64;
  let counted = 0_u64;
  atomic t = &store {
    let entries = &t^[keys];
    set counted = map_count::<u64>(map: t);
    for @read (at in 0_u64..entries^.len) {
      match entries^[at] {
        Some(value: held) => {
          set sum = sum +wrap held^;
        }
        None() => {
        }
      }
    }
  }
  if counted != 2_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  if sum != 6_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  return std::process::exit_status(code: 8_u8);
}
