struct Cursor {
  index: u64;
}

fn probe(values: &Array<u8, 2>, cursor: Cursor) -> result: u8 reads(values) contract {
  define selected = cursor;
  requires selected.index < values^.len;
  requires 1_u8 <= values^[selected.index];
} {
  return values^[cursor.index] - 1_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
