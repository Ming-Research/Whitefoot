struct Store {
  map: KeyedTable<u8>;
}

const names: Array<u8, 2> =[97_u8, 98_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let table = keyed_table_new::<u8>(capacity: 2_u64);
  let local = &table;
  let first = &names[0_u64..1_u64];
  let second = &names[1_u64..2_u64];
  let got = 0_u8;
  match local^[second] {
    Some(value: v) => {
      set got = v^;
    }
    None() => {
      set got = 2_u8;
    }
  }
  set local^[first] = Some<u8>(value: 5_u8);
  set local^[second] = Some<u8>(value: 4_u8);
  let counted = keyed_table_count::<u8>(table: local);
  let state = Store(map: move table);
  let store = shared_new::<Store>(value: move state);
  let shared = 0_u8;
  atomic s = &store, e = &s^.map[first] {
    match e^ {
      Some(value: v) => {
        set shared = v^;
      }
      None() => {
        set shared = 0_u8;
      }
    }
  }
  let hundreds = got *wrap 100_u8;
  let low = cvt.wrap::<u64, u8>(counted);
  let tens = low *wrap 10_u8;
  let upper = hundreds +wrap tens;
  let code = upper +wrap shared;
  return std::process::exit_status(code: code);
}
