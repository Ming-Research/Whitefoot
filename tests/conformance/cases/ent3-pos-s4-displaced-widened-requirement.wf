fn step_wide(i: u32, b: u32) -> out: u32 pure contract {
  requires cvt::<u32, u64>(i) + 1_u64 <= cvt::<u32, u64>(b);
} {
  let j = i + 1_u32;
  let out = b - j;
  return out;
}

fn main() -> status: std::process::ExitStatus pure {
  let out = step_wide(i: 4294967294_u32, b: 4294967295_u32);
  return std::process::exit_status(code: 0_u8);
}
