fn probe(x: u64, side: Bool) -> result: unit pure contract {
  requires 2_u64 * x <= 8_u64;
} {
  doc "One branch's local invariant cannot publish an L0 bound on the join's other input.";
  if side {
    invariant left: x <= 4_u64;
  } else {
  }
  let boundary = 0_u64;
  if x == 4_u64 {
    return unit;
  }
  invariant unavailable: x <= 3_u64;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
