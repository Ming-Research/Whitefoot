alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Hidden {
  providers: Array<Slots<u8>, 0>;
}

fn main() -> status: ExitStatus pure {
  doc "A full array's complete element type still participates in the placement closure at zero extent: a runtime-capacity shape exists only as the content of a cell, and a stored array field cannot hide one behind an empty extent.";
  return exit_status(code: 0_u8);
}
