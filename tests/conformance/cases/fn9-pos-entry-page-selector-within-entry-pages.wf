alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn f(p: &Paged<Slots<u8, 8>>, k: u64, i: u64) -> r: u64 writes(p) contract {
  requires k + 1_u64 == p^.pages.len;
  requires i + 1_u64 == p^.pages[k].len;
  requires p^.len > 0_u64;
  ensures r <= entry(p)^.pages[k][i].len;
} {
  doc "Page k and its element i existed at entry, though the removal may leave either past its exit length.";
  let last = take_back(window: p);
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  doc "The declaration alone is judged.";
  return exit_status(code: 0_u8);
}
