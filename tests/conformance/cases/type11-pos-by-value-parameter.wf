struct Table {
  slots: Slots<u64, 8>;
  next: u64;
  invariant cursor(table): table.next < table.slots.len;
}

fn make() -> table: Table pure {
  let slots = slots_new::<u64, 8>();
  place_back(window: &slots, value: 10_u64);
  place_back(window: &slots, value: 12_u64);
  let made = Table(slots: move slots, next: 1_u64);
  return move made;
}

fn consume(t: Table) -> result: u64 pure {
  let at = t.next;
  let got = t.slots[at];
  return got;
}

fn main() -> status: std::process::ExitStatus pure {
  let table = make();
  let got = consume(t: move table);
  let code = cvt.wrap::<u64, u8>(got);
  return std::process::exit_status(code: code);
}
