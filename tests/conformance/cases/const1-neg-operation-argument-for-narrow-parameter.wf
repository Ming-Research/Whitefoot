alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn widen<const n: u8>() -> r: u64 pure {
  doc "Reads the const generic at its written type u8.";
  return cvt::<u8, u64>(n);
}

fn next<const m: u8>() -> r: u64 pure {
  doc "An operation over an IDENT is evaluated in u64, so it is admitted only for a u64 parameter; here the parameter is u8, although m and the parameter share that type.";
  return widen::<m + 1>();
}

fn main() -> status: ExitStatus pure {
  doc "The rejection is the operation argument's own, whatever value any instance supplies.";
  let v = next::<3>();
  return exit_status(code: 0_u8);
}
