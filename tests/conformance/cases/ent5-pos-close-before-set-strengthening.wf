alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn increment(value: u8, byte_limit: u8, replacement: u8) -> result: u8 pure contract {
  requires value <= byte_limit;
  requires value != byte_limit;
} {
  set byte_limit = replacement;
  let result = value + 1_u8;
  return result;
}

fn main() -> status: ExitStatus pure {
  let result = increment(value: 2_u8, byte_limit: 10_u8, replacement: 0_u8);
  if result == 3_u8 {
  } else {
    return exit_status(code: 202_u8);
  }
  return exit_status(code: 0_u8);
}
