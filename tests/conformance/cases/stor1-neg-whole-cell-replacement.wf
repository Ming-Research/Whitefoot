alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy struct Pair {
  left: u64;
  right: u64;
}

fn overwrite(out: &Box<Pair>, replacement: Pair) -> function_result: unit writes(out) {
  doc "A live affine-typed final place is stored whole as the field inner of a heap-owned cell reached by a reference parameter whose row declares the write; the previous affine owner is released at the commit rather than discarded.";
  set deref(out).inner = move replacement;
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
