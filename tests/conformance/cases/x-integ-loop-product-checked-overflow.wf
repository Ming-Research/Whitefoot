alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A running product overflows i32 mid-loop. Checked multiplication produces a typed Err that ordinary control handles; give delivers the seed from a checked operation [OP-1, GIVE-1, SCOPE-3].";
  let prod = match 1_i32 +checked 0_i32 {
    Ok(value: seed) => {
      give seed;
    }
    Err(error: e) => {
      return exit_status(code: 0_u8);
    }
  }
  let i = 2_i32;
  loop @l {
    if i > 20_i32 {
      break @l;
    }
    match prod *checked i {
      Ok(value: product) => {
        set prod = product;
      }
      Err(error: overflow) => {
        return exit_status(code: 0_u8);
      }
    }
    set i = i +wrap 1_i32;
  }
  return exit_status(code: 1_u8);
}
