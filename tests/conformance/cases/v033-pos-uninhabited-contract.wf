alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn impossible(value: u8) -> output: u8 pure contract {
  requires value == 0_u8;
  requires value != 0_u8;
} {
  doc "The contradictory entry state discharges a subscript no reachable caller could satisfy.";
  let values = array_filled::<u8, 1>(value: 0_u8);
  return values[7_u64];
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
