alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn inspect<const n: u64>(source: &Slots<u8, n>, i: u64) -> seen: u8 reads(source) contract {
  define spare = deref(source).len;
  requires i < spare;
} {
  doc "Reads one element through a shared reference and writes nothing.";
  return deref(source)[i];
}

fn main() -> status: ExitStatus pure {
  doc "A call is a kill event for no fact supported by a shared-reference actual's place. The callee's row carries no writes of any path rooted at that parameter, so a body can exhibit none and EFF-2's both-ways check admits none in the declared row; no writes occurrence projects onto line and no MSR-2 kill fires. The length the two placements established survives both calls and discharges the requirement of each.";
  let line = slots_new::<u8, 4>();
  place_back(window: &line, value: 7_u8);
  place_back(window: &line, value: 9_u8);
  let first = inspect::<4>(source: &line, i: 0_u64);
  let second = inspect::<4>(source: &line, i: 1_u64);
  if first == 7_u8 {
  } else {
    return exit_status(code: 201_u8);
  }
  if second == 9_u8 {
  } else {
    return exit_status(code: 202_u8);
  }
  return exit_status(code: 0_u8);
}
