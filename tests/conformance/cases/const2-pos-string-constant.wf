alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const usage: Array<u8, 6> = "usage\n";

const empty: Array<u8, 0> = "";

fn main() -> status: ExitStatus pure {
  doc "A STRING defines an Array<u8, N> constant whose N entries are the bytes of its text, and the empty STRING defines Array<u8, 0>. The exit status is ten times the first constant's length plus the empty constant's length.";
  let first = usage[0_u64];
  if first == 'u'_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  let last = usage[5_u64];
  if last == '\n'_u8 {
  } else {
    return exit_status(code: 2_u8);
  }
  let length = usage.len;
  let none = empty.len;
  let tens = length * 10_u64;
  let combined = tens + none;
  let code = cvt::<u64, u8>(combined);
  return exit_status(code: code);
}
