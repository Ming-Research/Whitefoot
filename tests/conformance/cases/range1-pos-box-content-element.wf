alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Header {
  slot: u64;
}

struct Block {
  header: Header;
  weight: u64;
}

fn need_small(rows: &[Box<Block>]) -> result: unit pure contract {
  requires forall small(k in 0_u64..rows^.len): rows^[k].inner.header.slot <= 7_u64;
} {
  doc "Owes nothing; its requirement names a field below a Box element.";
  return unit;
}

fn forward(rows: &[Box<Block>]) -> result: unit pure contract {
  requires forall held(k in 0_u64..rows^.len): rows^[k].inner.header.slot <= 7_u64;
} {
  doc "The held fact instantiates through the Box content and discharges the callee's requirement.";
  need_small(rows: rows);
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
