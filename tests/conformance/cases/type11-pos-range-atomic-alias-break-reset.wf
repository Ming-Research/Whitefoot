struct ZeroesAliasBreakReset {
  cells: Array<u64, 1>;
  invariant(c): forall zero(k in 0_u64..c^.cells.len): c^.cells[k] == 0_u64;
}

fn need_aliasbreakreset(z: &ZeroesAliasBreakReset) -> result: unit pure {
  return unit;
}

fn update_aliasbreakreset(first: Shared<ZeroesAliasBreakReset>, second: Shared<ZeroesAliasBreakReset>) -> result: unit pure waits {
  loop @leave {
    atomic a = &first, b = &second {
      set a^.cells[0_u64] = 1_u64;
      set a^.cells[0_u64] = 0_u64;
      need_aliasbreakreset(z: b);
      break @leave;
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
