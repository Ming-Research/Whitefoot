struct Pair {
  marker: u64;
  value: u64;
}

fn helper(frame: &Pair, other: &Pair) -> result: unit writes(frame.value), writes(other.marker) contract {
  ensures frame^.value == 0_u64;
} {
  set frame^.value = 0_u64;
  set other^.marker = 1_u64;
  return unit;
}

fn caller() -> result: unit pure waits {
  let initial = Pair(marker: 0_u64, value: 0_u64);
  let object = shared_new::<Pair>(value: initial);
  atomic a = &object when a^.value == 0_u64 {
    helper(frame: a, other: a);
  }
  return unit;
}
