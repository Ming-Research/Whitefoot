struct Pair {
  marker: u64;
  value: u64;
}

fn helper(frame: &Pair, other: &Pair) -> result: unit writes(frame.value), writes(other.marker) contract {
  ensures frame^.value == 0_u64;
} {
  set frame^.value = 0_u64;
  set other^.marker = 1_u64;
  return unit;
}

fn caller() -> result: unit pure waits {
  let first_value = Pair(marker: 0_u64, value: 0_u64);
  let second_value = Pair(marker: 0_u64, value: 0_u64);
  let first = shared_new::<Pair>(value: first_value);
  let second = shared_new::<Pair>(value: second_value);
  atomic a = &first, b = &second when a^.value == 0_u64 {
    helper(frame: a, other: b);
  }
  return unit;
}
