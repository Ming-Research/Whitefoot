fn need(value: Bool) -> r: unit pure contract {
  requires value;
} {
  doc "Consume a proved Boolean value.";
  return unit;
}

fn witness(x: u64) -> r: unit pure {
  doc "The current bound refutes the saved comparison through its live definition.";
  let test = x < 9_u64;
  if x >= 9_u64 {
    need(value: test);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Reject the requirement with a transported negative sign.";
  return std::process::exit_status(code: 0_u8);
}
