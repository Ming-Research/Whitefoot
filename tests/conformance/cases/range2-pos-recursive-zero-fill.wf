fn zero_fill(out: &[u64], depth: u64) -> done: unit writes(out) contract {
  ensures forall cleared(k in 0_u64..out^.len): out^[k] == 0_u64;
} {
  if depth > 0_u64 {
    let next = depth - 1_u64;
    zero_fill(out: out, depth: next);
    return unit;
  }
  let length = out^.len;
  for (
    k in 0_u64..length,
    invariant forall filled(q in 0_u64..k): out^[q] == 0_u64
  ) {
    set out^[k] = 0_u64;
  }
  return unit;
}

fn first_zero(cells: &[u64]) -> result: u64 reads(cells) contract {
  requires forall zero(k in 0_u64..cells^.len): cells^[k] == 0_u64;
} {
  if 0_u64 < cells^.len {
    let first = cells^[0_u64];
    return first;
  }
  return 0_u64;
}

fn main() -> status: std::process::ExitStatus pure {
  let cells = box_array_filled::<u64>(count: 4_u64, value: 9_u64);
  zero_fill(out: &cells.inner[0_u64..4_u64], depth: 3_u64);
  let got = first_zero(cells: &cells.inner[0_u64..4_u64]);
  if got != 0_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  let empty = array_filled::<u64, 0>(value: 9_u64);
  zero_fill(out: &empty[0_u64..0_u64], depth: 0_u64);
  return std::process::exit_status(code: 0_u8);
}
