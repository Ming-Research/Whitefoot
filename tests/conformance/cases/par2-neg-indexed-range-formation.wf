fn reduce() -> result: u64 pure {
  doc "Forming an unused range still names the indexed root outside an update.";
  let cells = array_filled::<u64, 4>(value: 0_u64);
  for (i in 0_u64..4_u64) {
    let observed = &cells[0_u64..4_u64];
    set cells[0_u64] = cells[0_u64] +wrap 1_u64;
  }
  return cells[0_u64];
}

fn main() -> status: std::process::ExitStatus pure {
  let result = reduce();
  return std::process::exit_status(code: 0_u8);
}
