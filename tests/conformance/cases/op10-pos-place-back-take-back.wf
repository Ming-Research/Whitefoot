alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "OP-10: place_back fills the append slot r.next and moves the boundary r.len up by one; take_back empties the last filled slot r.last and moves that boundary down by one.";
  let r = slots_new::<u64, 4>();
  place_back(window: &r, value: 5_u64);
  place_back(window: &r, value: 6_u64);
  let popped = take_back(window: &r);
  let n = r.len;
  if popped == 6_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  if n == 1_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
