alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn same(left: u64, right: u64) -> result: unit pure contract {
  requires left == right;
} {
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "OP-10: place_back fills the append slot r.next and moves the boundary r.len up by one; take_back empties the last filled slot r.last and moves that boundary down by one. The call to same states the derived length as a requirement.";
  let r = slots_new::<u64, 4>();
  place_back(window: &r, value: 5_u64);
  place_back(window: &r, value: 6_u64);
  let popped = take_back(window: &r);
  let n = r.len;
  if popped == 6_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  same(left: n, right: 1_u64);
  return exit_status(code: 0_u8);
}
