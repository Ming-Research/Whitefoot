alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn probe(window: &Slots<u64, 8>) -> result: u64 writes(window) contract {
  requires window^.len >= 1_u64;
} {
  doc "An empty range at the old endpoint still requires that captured endpoint at or below the current length.";
  let end = window^.len;
  let empty = &window^[end..end];
  let taken = take_back(window: window);
  return empty^.len;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
