struct Frame {
  items: Array<u64, 1>;
}

fn helper(frame: &Frame, target: &Frame, i: u64) -> result: unit writes(target.items[i]) contract {
  define snapshot = frame^.items;
  requires i < 1_u64;
  requires forall observed(k in 0_u64..1_u64): snapshot.len == 1_u64;
} {
  set target^.items[i] = 1_u64;
  return unit;
}

fn caller(f: &Frame) -> result: unit writes(f.items) {
  helper(frame: f, target: f, i: 0_u64);
  return unit;
}
