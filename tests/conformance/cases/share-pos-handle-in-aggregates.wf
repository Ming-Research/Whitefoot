struct Holder {
  counter: Shared<u64>;
}

nocopy struct Node {
  value: u64;
  next: Option<Shared<Node>>;
}

fn main() -> status: std::process::ExitStatus pure may_wait {
  let counter = shared_new::<u64>(value: 2_u64);
  let holder = Holder(counter: move counter);
  atomic count = &holder.counter {
    set count^ = count^ +wrap 1_u64;
  }
  let inner = shared_new::<u64>(value: 4_u64);
  let outer = shared_new::<Shared<u64>>(value: move inner);
  atomic handle = &outer {
    let another = shared_share::<u64>(shared: handle);
  }
  let tail = None<Shared<Node>>();
  let first = Node(value: 5_u64, next: move tail);
  let linked = shared_new::<Node>(value: move first);
  let head = Some<Shared<Node>>(value: move linked);
  let total = 0_u64;
  atomic count = &holder.counter {
    set total = count^;
  }
  match move head {
    Some(value: node) => {
      atomic reached = &node {
        set total = total +wrap reached^.value;
      }
    }
    None() => {
    }
  }
  let code = cvt.wrap::<u64, u8>(total);
  return std::process::exit_status(code: code);
}
