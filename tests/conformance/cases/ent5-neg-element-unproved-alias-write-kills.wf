fn probe(values: &Array<u8, 2>, choose: Bool) -> result: u8 writes(values) contract {
  requires 1_u8 <= values^[0_u64];
} {
  let selected = &values^[1_u64];
  if choose {
    set selected = &values^[0_u64];
  }
  set selected^ = 0_u8;
  return values^[0_u64] - 1_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
