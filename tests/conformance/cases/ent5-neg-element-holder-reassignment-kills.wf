fn probe(values: &Array<u8, 2>) -> result: u8 reads(values) contract {
  requires 1_u8 <= values^[0_u64];
} {
  let zeros = array_filled::<u8, 2>(value: 0_u8);
  let holder = values;
  if 1_u8 <= holder^[0_u64] {
    set holder = &zeros;
    return holder^[0_u64] - 1_u8;
  }
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
