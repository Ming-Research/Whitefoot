fn pass(x: i64) -> result: i64 pure {
  doc "The header invariant bound folds exactly to -2^127; x > -2^127 normalizes to -x <= 2^127 - 1, which fits i128, so the invariant is formed, and every i64 satisfies it at entry and on every backedge. The earlier checker negated the folded side, overflowed, and rejected it with INV-1.";
  loop (
    invariant above_minimum: x > -9223372036854775808_i64 * 9223372036854775807_i64 + -9223372036854775808_i64 * 9223372036854775807_i64 + -9223372036854775808_i64 + -9223372036854775808_i64
  ) {
    return x;
  }
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
