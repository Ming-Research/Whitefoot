fn invalid(values: &Segments<u64>, slot: u64) -> result: u64 reads(values) contract {
  requires 0_u64 < values^.len;
  requires slot < values^.len;
} {
  doc "The outer len counts segments and cannot bound an element within one segment.";
  return values^[0_u64][slot];
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The preceding function is rejected at its invalid run-place use.";
  return std::process::exit_status(code: 0_u8);
}
