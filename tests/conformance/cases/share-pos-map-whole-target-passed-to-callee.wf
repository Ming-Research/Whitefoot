const names: Array<u8, 1> =[97_u8];

struct Tally {
  table: ConcurrentHashMap<u8>;
  total: u8;
}

fn fill(map: &ConcurrentHashMap<u8>, count: &u8, key: &[u8]) -> result: unit reads(key), writes(map), writes(count) {
  set map^[key] = Some<u8>(value: 9_u8);
  set count^ = 1_u8;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let table = map_new::<u8>(capacity: 1_u64);
  let tally = Tally(table: move table, total: 0_u8);
  let store = shared_new::<Tally>(value: move tally);
  let counted = 0_u64;
  atomic t = &store {
    fill(map: &t^.table, count: &t^.total, key: &names[0_u64..1_u64]);
  }
  atomic t = &store {
    set counted = map_count::<u8>(map: &t^.table);
  }
  let code = cvt.wrap::<u64, u8>(counted);
  return std::process::exit_status(code: code);
}
