alias AcceptedConnection = std::net::AcceptedConnection;
alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias IoError = std::io::IoError;
alias TcpConnection = std::net::TcpConnection;
alias close_directory = std::fs::close_directory;
alias close_listener = std::net::close_listener;
alias close_receive = std::net::close_receive;
alias close_send = std::net::close_send;
alias exit_status = std::process::exit_status;
alias socket_address_v4 = std::net::socket_address_v4;
alias tcp_accept = std::net::tcp_accept;
alias tcp_listen = std::net::tcp_listen;

fn factory_refusal(error: &IoError) -> result: Bool reads(error) {
  match deref(error) {
    NotFound(code: native_code, origin: native_origin) => {
      return False();
    }
    PermissionDenied(code: native_code, origin: native_origin) => {
      return False();
    }
    AlreadyExists(code: native_code, origin: native_origin) => {
      return False();
    }
    NotDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    IsDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    DirectoryNotEmpty(code: native_code, origin: native_origin) => {
      return False();
    }
    ReadOnly(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceBusy(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidInput(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidPath(code: native_code, origin: native_origin) => {
      return False();
    }
    Unsupported(code: native_code, origin: native_origin) => {
      return False();
    }
    TimedOut(code: native_code, origin: native_origin) => {
      return False();
    }
    BrokenPipe(code: native_code, origin: native_origin) => {
      return False();
    }
    WriteZero(code: native_code, origin: native_origin) => {
      return False();
    }
    UnexpectedEnd(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionRefused(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionReset(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionAborted(code: native_code, origin: native_origin) => {
      return False();
    }
    NotConnected(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressInUse(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressUnavailable(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceExhausted(code: native_code, origin: native_origin) => {
      return deref(native_origin) == 0_u8;
    }
    FileTooLarge(code: native_code, origin: native_origin) => {
      return False();
    }
    NoSpace(code: native_code, origin: native_origin) => {
      return False();
    }
    QuotaExceeded(code: native_code, origin: native_origin) => {
      return False();
    }
    CrossDevice(code: native_code, origin: native_origin) => {
      return False();
    }
    DeviceFailure(code: native_code, origin: native_origin) => {
      return False();
    }
    Other(code: native_code, origin: native_origin) => {
      return False();
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "Ordinary tcp_accept takes &listener and &factory. Refusal leaves both ordinary values available; a successful public connection is destructured and both halves explicitly closed. No shared-listener overlap or permit-return rule survives.";
  let Inputs(args: unused_args, cwd: unused_cwd, stdout: unused_stdout, stderr: unused_stderr, handles: handles, stdin: unused_stdin) = move inputs;
  close_directory(factory: &handles, directory: move unused_cwd);
  let address = socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: 9106_u16);
  match tcp_listen(factory: &handles, address: &address) {
    Ok(value: bound) => {
      match tcp_accept(factory: &handles, listener: &bound) {
        Ok(value: accepted_link) => {
          let AcceptedConnection(connection: link, peer: from) = move accepted_link;
          let TcpConnection(receive: close_receive_29, send: close_send_29) = move link;
          close_receive(factory: &handles, receive: move close_receive_29);
          close_send(factory: &handles, send: move close_send_29);
          let listener_credit = close_listener(factory: &handles, listener: move bound);
          return exit_status(code: 0_u8);
        }
        Err(error: problem) => {
          if factory_refusal(error: &problem) {
            let listener_credit = close_listener(factory: &handles, listener: move bound);
            return exit_status(code: 4_u8);
          }
          match tcp_accept(factory: &handles, listener: &bound) {
            Ok(value: accepted_retry) => {
              let AcceptedConnection(connection: retry, peer: retry_from) = move accepted_retry;
              let TcpConnection(receive: close_receive_30, send: close_send_30) = move retry;
              close_receive(factory: &handles, receive: move close_receive_30);
              close_send(factory: &handles, send: move close_send_30);
              let listener_credit = close_listener(factory: &handles, listener: move bound);
              return exit_status(code: 0_u8);
            }
            Err(error: second_problem) => {
              let listener_credit = close_listener(factory: &handles, listener: move bound);
              return exit_status(code: 3_u8);
            }
          }
        }
      }
    }
    Err(error: problem) => {
      if factory_refusal(error: &problem) {
        return exit_status(code: 6_u8);
      }
      return exit_status(code: 5_u8);
    }
  }
}
