alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn first(start: u64, end: u64) -> result: u64 pure contract {
  requires start <= end;
  requires end <= 8_u64;
} {
  doc "Relative endpoints select distinct initialized values and retain their captured meaning after the supplying binding is reassigned [REF-1]; re-slicing admits an empty child at the parent end [REF-4].";
  let values = array_filled::<u64, 8>(value: 0_u64);
  for (i in 0_u64..8_u64) {
    set values[i] = i;
  }
  let view = &values[start..end];
  set start = end;
  let count = deref(view).len;
  let empty = &deref(view)[count..count];
  let empty_count = deref(empty).len;
  if empty_count != 0_u64 {
    return 99_u64;
  }
  if count == 0_u64 {
    return 0_u64;
  }
  return deref(view)[0_u64];
}

fn main() -> status: ExitStatus pure {
  doc "A middle range and an end-anchored empty range are both formed and measured; the middle range selects the value its captured start names.";
  let middle = first(start: 2_u64, end: 5_u64);
  let tail = first(start: 8_u64, end: 8_u64);
  if middle != 2_u64 {
    return exit_status(code: 1_u8);
  }
  if tail != 0_u64 {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
