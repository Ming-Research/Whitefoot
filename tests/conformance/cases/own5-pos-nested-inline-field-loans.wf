alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Row {
  left: u64;
  right: u64;
}

struct Table {
  rows: Array<Row, 1>;
}

fn main() -> status: ExitStatus pure {
  doc "A field-index-field path distinguishes disjoint scalar siblings inside one element, so the write to the sibling leaves the reference to the first field valid.";
  let row0 = Row(left: 3_u64, right: 4_u64);
  let slots = slots_new::<Row, 1>();
  place_back(window: &slots, value: row0);
  let rows = slots_into_array::<Row, 1>(values: move slots);
  let table = Table(rows: rows);
  let left = &table.rows[0_u64].left;
  set table.rows[0_u64].right = 9_u64;
  let observed = deref(left);
  return exit_status(code: 0_u8);
}
