alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const second_row: u64 = 2_u64;

fn width(rows: &Array<Slots<u8, 8>, 4>, i: u64) -> r: u64 reads(rows) contract {
  requires i < 4_u64;
  ensures r == rows^[i].len;
} {
  doc "Returns the length of element i.";
  return rows^[i].len;
}

fn need(rows: &Array<Slots<u8, 8>, 4>, w: u64, i: u64) -> r: u64 reads(rows) contract {
  requires i < 4_u64;
  requires w <= rows^[i].len;
} {
  doc "Requires a bound on the length of element i.";
  return rows^[i].len;
}

fn second(rows: &Array<Slots<u8, 8>, 4>) -> r: u64 reads(rows) contract {
  ensures r == rows^[second_row].len;
} {
  doc "A named const actual is the offset of both the published relation and the instantiated requirement.";
  let w = width(rows: rows, i: second_row);
  let needed = need(rows: rows, w: w, i: second_row);
  return w;
}

fn main() -> status: ExitStatus pure {
  doc "The declarations alone are judged.";
  return exit_status(code: 0_u8);
}
