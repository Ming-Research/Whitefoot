alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn forward(x: u64, limit: u64) -> result: unit pure contract {
  requires x <= limit;
} {
  invariant early_use: x <= limit {
    use step_later;
  }
  invariant step_later: x <= limit;
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
