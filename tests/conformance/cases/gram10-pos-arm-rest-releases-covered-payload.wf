alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Held {
  Full(code: u8, cell: Box<u8>);
  Empty();
}

fn main() -> status: ExitStatus pure {
  doc "The arm binds `code` and a final `..` covers `cell`; the match consumes `held`, so the covered Box takes its release on entry to the arm.";
  let cell = box_new::<u8>(value: 9_u8);
  let held = Held::Full(code: 7_u8, cell: move cell);
  match move held {
    Full(code: found, ..) => {
      return exit_status(code: found);
    }
    Empty(..) => {
      return exit_status(code: 1_u8);
    }
  }
}
