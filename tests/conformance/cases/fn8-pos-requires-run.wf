alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn bounded(x: i32) -> result: i32 pure contract {
  define permitted = x >= 0_i32;
  requires permitted;
} {
  doc "A Bool-valued, pure-total static requirement is one complete goal that every ordinary caller proves before the function body [FN-8].";
  return x;
}

fn main() -> status: ExitStatus pure {
  let value = bounded(x: 7_i32);
  if value == 7_i32 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
