alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn write(out: &Slots<u8, 8>) -> result: unit writes(out) {
  doc "Writes one element behind its reference parameter; writes(out) states every access at or below out, so the length read needs no reads entry [EFF-1].";
  let spare = deref(out).len;
  let ok = 0_u64 < spare;
  if ok {
    set deref(out)[0_u64] = 1_u8;
  }
  return unit;
}

fn proxy(out: &Slots<u8, 8>) -> result: unit writes(out) {
  doc "Forwarding the reference preserves the callee row exactly: EFF-5 substitutes the actual path and the forwarded row is the same one [EFF-2].";
  write(out: out);
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "No construction is needed to exercise the forwarded row.";
  return exit_status(code: 0_u8);
}
