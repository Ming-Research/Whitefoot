alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  let cursor = 0_u64;
  let doubled = 0_u64;
  loop @walk (
    invariant bounded: cursor <= 4_u64,
    invariant twice_bounded: doubled <= cursor + cursor
  ) {
    let remaining = cursor < 4_u64;
    if remaining {
      set cursor = cursor + 1_u64;
      set doubled = doubled + 2_u64;
    } else {
      break @walk;
    }
  }
  let correct = doubled == 8_u64;
  if correct {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
