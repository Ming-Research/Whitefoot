enum RoutedGeneric<T: Int> {
  Pick(index: T);
  Absent();
}

fn select<T: Int>(value: T) -> result: RoutedGeneric<T> pure contract {
  ensures when Pick(index: payload): payload == value;
} {
  return RoutedGeneric<T>::Pick(index: value);
}

fn main() -> status: std::process::ExitStatus pure {
  let made = select::<u64>(value: 7_u64);
  match made {
    Pick(index: value) => {
      let code = cvt::<u64, u8>(value);
      return std::process::exit_status(code: code);
    }
    Absent() => {
      return std::process::exit_status(code: 99_u8);
    }
  }
}
