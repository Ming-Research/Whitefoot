alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn take_run(run: &Slots<u64>) -> result: u64 reads(run.len) {
  doc "TYPE-9 amendment S: a runtime-capacity form may be a reference referent or Box content; by-value storage remains refused at the complete type.";
  let n = run^.len;
  return n;
}

fn main() -> status: ExitStatus pure {
  doc "TYPE-9 amendment S admits a reference to a runtime-capacity shape; the runtime-capacity shape remains Box content and the caller observes its length.";
  let cell = box_slots_new::<u64>(capacity: 4_u64);
  place_back(window: &cell.inner, value: 11_u64);
  place_back(window: &cell.inner, value: 22_u64);
  let n = take_run(run: &cell.inner);
  let code = cvt.wrap::<u64, u8>(n);
  return exit_status(code: code);
}
