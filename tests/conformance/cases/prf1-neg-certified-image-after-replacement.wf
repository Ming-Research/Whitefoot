alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn chain_then_kill(first: u8, first_limit: u8, second: u8, second_limit: u8, replacement: u8) -> result: unit pure contract {
  requires first <= first_limit;
  requires second <= second_limit;
} {
  invariant pair_bound: first + second <= first_limit + second_limit;
  invariant chained: 3_u8 * first + 3_u8 * second <= 3_u8 * first_limit + 3_u8 * second_limit {
    use 3 times pair_bound;
  }
  set first = replacement;
  invariant reused: 9_u8 * first + 9_u8 * second <= 9_u8 * first_limit + 9_u8 * second_limit {
    use 3 times chained;
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
