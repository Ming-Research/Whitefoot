alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn fill(output: &[u64]) -> result: u64 writes(output) {
  doc "Two adjacent range references over one destination are proved disjoint by their captured endpoints, so both children are handed out at once and the origin's own length survives their writes.";
  let count = deref(output).len;
  if count <= 1_u64 {
    if 0_u64 < count {
      set deref(output)[0_u64] = 7_u64;
    }
    return count;
  }
  let middle = count / 2_u64;
  let left = &deref(output)[0_u64..middle];
  let right = &deref(output)[middle..count];
  let a = fill(output: left);
  let b = fill(output: right);
  let restored = deref(output)[0_u64];
  set deref(output)[0_u64] = restored;
  return a +wrap b;
}

fn main() -> status: ExitStatus pure {
  let values = box_array_filled::<u64>(count: 17_u64, value: 0_u64);
  for (i in 0_u64..17_u64) {
    set values.inner[i] = i;
  }
  let window = &values.inner[0_u64..17_u64];
  let filled = fill(output: window);
  if filled != 17_u64 {
    return exit_status(code: 1_u8);
  }
  for (i in 0_u64..17_u64) {
    let seen = values.inner[i];
    if seen != 7_u64 {
      return exit_status(code: 2_u8);
    }
  }
  let empty = box_array_filled::<u64>(count: 0_u64, value: 0_u64);
  let none = &empty.inner[0_u64..0_u64];
  let zero = fill(output: none);
  if zero != 0_u64 {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
