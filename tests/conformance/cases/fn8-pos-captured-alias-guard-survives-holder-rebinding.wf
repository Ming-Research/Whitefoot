fn need(x: &u64) -> result: u64 reads(x) contract {
  requires x^ != 0_u64;
} {
  let value = 10_u64 / x^;
  return value;
}

fn pick(a: &u64, b: &u64) -> result: u64 reads(a) {
  let q = &a^;
  let saved = &q^;
  if saved^ != 0_u64 {
    set q = &b^;
    let r = need(x: saved);
    return r;
  }
  return 0_u64;
}
