alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Sign {
  Neg();
  Zero();
  Pos();
}

fn classify(x: i32) -> return_value: Sign pure {
  return Sign::Pos();
}

fn main() -> return_value: ExitStatus pure {
  doc "GRAM-7: match as a let-initializer (value, give) AND as a statement (effect); one arm shape, two distinct node kinds.";
  let v = 21_i32;
  let d = if v > 0_i32 {
    give 42_i32;
  } else {
    give 0_i32;
  }
  let s = classify(x: d);
  match s {
    Neg() => {
      return exit_status(code: 1_u8);
    }
    Zero() => {
      return exit_status(code: 2_u8);
    }
    Pos() => {
      if d == 42_i32 {
      } else {
        return exit_status(code: 3_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}
