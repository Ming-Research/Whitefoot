alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn probe(table: &Array<u64, 4>, x: u64) -> result: u64 reads(table) {
  doc "A band member that names a Bool binding contributes that binding's comparison origin only while the binding holds its initializer; a set through a reference to it ends that, so the true edge of the band establishes nothing about x [ENT-3, ENT-5]. With x at 7 the subscript would read outside the table.";
  let inside = x < 4_u64;
  let writer = &inside;
  set writer^ = True();
  let truth = True();
  let both = band(inside, truth);
  if both {
    return table^[x];
  }
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  doc "The out-of-range call the rejected subscript would admit.";
  let table = array_filled::<u64, 4>(value: 0_u64);
  let got = probe(table: &table, x: 7_u64);
  return exit_status(code: 0_u8);
}
