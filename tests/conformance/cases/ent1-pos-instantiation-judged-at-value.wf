alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn element<const n: u64>(values: Slots<u8, n>) -> result: u8 pure {
  doc "Every generic source body first receives the source-schema ordinary judgment [ENT-1]. Executed control supplies the symbolic length bound required by the subscript, and the n = 4 concrete instance is then rechecked independently.";
  let spare = values.len;
  let inside = 2_u64 < spare;
  if inside {
    return values[2_u64];
  }
  return 0_u8;
}

fn main() -> status: ExitStatus pure {
  doc "Fills a four-slot window and calls the wide instance.";
  let empty = slots_new::<u8, 4>();
  place_back(window: &empty, value: 7_u8);
  place_back(window: &empty, value: 7_u8);
  place_back(window: &empty, value: 7_u8);
  place_back(window: &empty, value: 7_u8);
  let value = element::<4>(values: move empty);
  let expected = value == 7_u8;
  if expected {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
