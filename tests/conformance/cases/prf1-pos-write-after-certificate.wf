alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn use_then_write(first: u8, first_limit: u8, second: u8, second_limit: u8, replacement: u8) -> result: u8 pure contract {
  requires first <= first_limit;
  requires second <= second_limit;
} {
  invariant pair_bound: first + second <= first_limit + second_limit;
  invariant scaled_bound: 3_u8 * first + 3_u8 * second <= 3_u8 * first_limit + 3_u8 * second_limit {
    use 3 times pair_bound;
  }
  set first = replacement;
  return second;
}

fn main() -> status: ExitStatus pure {
  let result = use_then_write(first: 1_u8, first_limit: 4_u8, second: 2_u8, second_limit: 4_u8, replacement: 9_u8);
  return exit_status(code: result);
}
