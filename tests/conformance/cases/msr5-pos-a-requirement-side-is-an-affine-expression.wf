alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn filled<T: copy, const n: u64>(value: T) -> result: Slots<T, n> pure contract {
  ensures result.len >= n;
  ensures result.cap <= result.len;
} {
  doc "Builds a window of n slots, every one holding a copy of value; the copy bound is what admits the bare repeated use.";
  let built = slots_new::<T, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: built.len >= at,
    invariant spare: built.cap - built.len + at >= n
  ) {
    place_back(window: &built, value: value);
  }
  return move built;
}

fn transposed(run: Slots<u8, 8>, at: u64) -> value: u8 pure contract {
  requires at + 2_u64 <= run.len;
} {
  doc "Reads one element under a requirement that leaves a second element beyond it.";
  return run[at];
}

fn main() -> status: ExitStatus pure {
  doc "MSR-5, FN-8: a requirement side carries the whole affine expression rather than the difference-bound fragment a published relation is narrowed to, so at + 2_u64 <= run.len is both the caller's obligation and the premise the callee's own subscript bound discharges from.";
  let run = filled::<u8, 8>(value: 4_u8);
  let value = transposed(run: move run, at: 3_u64);
  if value == 4_u8 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
