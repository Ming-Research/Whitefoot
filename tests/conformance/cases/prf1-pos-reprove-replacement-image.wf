alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn blend(first: u8, first_limit: u8, second: u8, second_limit: u8, third: u8, third_limit: u8, replacement: u8, replacement_limit: u8) -> result: u8 pure contract {
  requires first <= first_limit;
  requires second <= second_limit;
  requires third <= third_limit;
  requires replacement <= replacement_limit;
  requires first_limit <= 80_u8;
  requires second_limit <= 80_u8;
  requires third_limit <= 90_u8;
  requires replacement_limit <= 80_u8;
} {
  invariant original_bound: first + second + third <= first_limit + second_limit + third_limit {
    use (first <= first_limit);
    use (second <= second_limit);
    use (third <= third_limit);
  }
  set first = replacement;
  invariant updated_bound: first + second + third <= replacement_limit + second_limit + third_limit {
    use (first <= replacement_limit);
    use (second <= second_limit);
    use (third <= third_limit);
  }
  invariant limit_sum: replacement_limit + second_limit + third_limit <= 250_u8;
  let result = first + second;
  return result;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
