struct BoundedSource {
  values: Box<Array<u32>>;
  invariant limit(owner): owner.values.inner.len <= 1073741824_u64;
}

fn source_failure<T: drop>() -> failed: Result<T, u32> pure {
  return Err<T, u32>(error: 1_u32);
}

fn make_source(fail: Bool) -> made: Result<BoundedSource, u32> pure contract {
  ensures when Ok(value: produced): produced.values.inner.len <= 1073741824_u64;
} {
  if fail {
    return source_failure::<BoundedSource>();
  }
  let values = box_array_filled::<u32>(count: 1_u64, value: 0_u32);
  let source = BoundedSource(values: move values);
  return Ok<BoundedSource, u32>(value: move source);
}
