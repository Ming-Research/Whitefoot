alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn fill(item: u64, window: &[u64]) -> result: unit writes(window) {
  doc "Writes item into every element of the segment it was handed.";
  let count = window^.len;
  for (j in 0_u64..count) {
    set window^[j] = item;
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "The routed postcondition fixes the segment count at three, so segment 3 is refuted by OP-4 at its subscript.";
  let lengths = box_array_filled::<u64>(count: 3_u64, value: 2_u64);
  let run = &lengths.inner[0_u64..3_u64];
  let made = box_segments_filled::<u64>(lengths: run, value: 0_u64);
  match move made {
    None() => {
      return exit_status(code: 1_u8);
    }
    Some(value: segments) => {
      fill(item: 5_u64, window: &segments.inner[3_u64]);
      let last = &segments.inner[3_u64];
      let size = last^.len;
      if size != 2_u64 {
        return exit_status(code: 2_u8);
      }
      let seen = last^[1_u64];
      if seen != 5_u64 {
        return exit_status(code: 3_u8);
      }
      return exit_status(code: 0_u8);
    }
  }
}
