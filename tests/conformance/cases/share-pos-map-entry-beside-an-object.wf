const names: Array<u8, 1> =[97_u8];

struct Tally {
  counts: ConcurrentHashMap<u8>;
  total: u8;
}

fn bump(tally: Shared<Tally>) -> result: unit pure waits {
  let name = &names[0_u64..1_u64];
  for @round (index in 0_u64..20_u64) {
    atomic s = &tally {
      match s^.counts[name] {
        Some(value: observed) => {
          let next = observed^ +wrap 1_u8;
          set s^.counts[name] = Some<u8>(value: next);
        }
        None() => {
          set s^.counts[name] = Some<u8>(value: 1_u8);
        }
      }
      set s^.total = s^.total +wrap 1_u8;
    }
  }
  return unit;
}

fn bump_four(tally: &Shared<Tally>) -> result: unit reads(tally) waits {
  for @start (index in 0_u64..4_u64) {
    let handle = shared_share::<Tally>(shared: tally);
    spawn bump(tally: move handle);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let counts = map_new::<u8>(capacity: 1_u64);
  let state = Tally(counts: move counts, total: 0_u8);
  let tally = shared_new::<Tally>(value: move state);
  bump_four(tally: &tally);
  let name = &names[0_u64..1_u64];
  let value = 0_u8;
  let total = 1_u8;
  atomic s = &tally {
    match s^.counts[name] {
      Some(value: observed) => {
        set value = observed^;
      }
      None() => {
      }
    }
    set total = s^.total;
  }
  if value != total {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: value);
}
