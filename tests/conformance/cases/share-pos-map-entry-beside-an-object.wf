const names: Array<u8, 1> =[97_u8];

fn bump(counts: Shared<ConcurrentHashMap<u8>>, tally: Shared<u8>) -> result: unit pure waits {
  let name = &names[0_u64..1_u64];
  for @round (index in 0_u64..20_u64) {
    atomic slot = &counts[name], c = &tally {
      match slot^ {
        Some(value: held) => {
          let next = held^ +wrap 1_u8;
          set slot^ = Some<u8>(value: next);
        }
        None() => {
          set slot^ = Some<u8>(value: 1_u8);
        }
      }
      set c^ = c^ +wrap 1_u8;
    }
  }
  return unit;
}

fn bump_four(counts: &Shared<ConcurrentHashMap<u8>>, tally: &Shared<u8>) -> result: unit reads(counts), reads(tally) waits {
  for @start (index in 0_u64..4_u64) {
    let map = shared_share::<ConcurrentHashMap<u8>>(shared: counts);
    let total = shared_share::<u8>(shared: tally);
    spawn bump(counts: move map, tally: move total);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let counts = shared_map_new::<u8>(capacity: 1_u64);
  let tally = shared_new::<u8>(value: 0_u8);
  bump_four(counts: &counts, tally: &tally);
  let name = &names[0_u64..1_u64];
  let value = 0_u8;
  let total = 1_u8;
  atomic slot = &counts[name], c = &tally {
    match slot^ {
      Some(value: held) => {
        set value = held^;
      }
      None() => {
      }
    }
    set total = c^;
  }
  if value != total {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: value);
}
