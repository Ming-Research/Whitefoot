alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Pair {
  left: Box<u64>;
  right: Box<u64>;
}

fn main() -> status: ExitStatus pure {
  doc "WIN-3: a move out of a field consumes the whole owner; a destructuring consume binds the fields it names and covers the rest with the rest marker, whose parts take their compiler-derived release.";
  let a = box_new::<u64>(value: 3_u64);
  let b = box_new::<u64>(value: 4_u64);
  let p = Pair(left: move a, right: move b);
  let Pair(left: first, ..) = move p;
  let seen = first.inner;
  if seen == 3_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
