alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy struct Pair {
  left: i32;
  right: i32;
}

enum Packet {
  Data(item: Pair);
  Empty();
}

fn inspect(packet: &Packet) -> result: i32 reads(packet) {
  doc "Matching through a reference binds the affine struct payload as a reference naming the scrutinee path extended by its payload step, so a field of it is read without consuming the enum.";
  match deref(packet) {
    Data(item: payload) => {
      return deref(payload).left;
    }
    Empty() => {
      return 0_i32;
    }
  }
}

fn main() -> status: ExitStatus pure {
  let pair = Pair(left: 41_i32, right: 1_i32);
  let packet = Packet::Data(item: move pair);
  let fallback = Packet::Empty();
  let held = &packet;
  let read = inspect(packet: held);
  if read != 41_i32 {
    return exit_status(code: 1_u8);
  }
  let hollow = &fallback;
  let zero = inspect(packet: hollow);
  if zero != 0_i32 {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
