alias Reserve = std::snapshot::Reserve;
alias Job = std::snapshot::Job;
alias CreateError = std::snapshot::CreateError;

struct Store<V: drop> {
  table: ConcurrentHashMap<V>;
  sequence: u64;
}

fn capture<V: drop>(reserve: Reserve, store: &Shared<Store<V>>) -> result: Result<Job, CreateError> reads(store) waits {
  atomic current = &store^ {
    return std::snapshot::capture_export::<V>(reserve: move reserve, map: &current^.table, cut: &current^.sequence);
  }
}

fn instantiate(reserve: Reserve, store: &Shared<Store<Box<Slots<u8>>>>) -> result: Result<Job, CreateError> reads(store) waits {
  return capture::<Box<Slots<u8>>>(reserve: move reserve, store: store);
}
