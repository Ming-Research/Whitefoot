alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn inspect(value: &u64) -> result: u64 reads(value) {
  doc "A reference parameter denotes the reference; the storage it names is read through deref.";
  return deref(value);
}

fn decide(value: &u64) -> result: Option<u64> reads(value) {
  doc "The reference argument is read once and lasts only through this call.";
  let seen = deref(value);
  let raised = seen +wrap 4_u64;
  return Some<u64>(value: raised);
}

fn main() -> status: ExitStatus pure {
  doc "The same reference, formed for a call whose result is bound first, still ends with that call.";
  let value = 3_u64;
  let decided = decide(value: &value);
  match decided {
    None() => {
    }
    Some(value: chosen) => {
      set value = chosen;
    }
  }
  let observed = inspect(value: &value);
  if observed == 7_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
