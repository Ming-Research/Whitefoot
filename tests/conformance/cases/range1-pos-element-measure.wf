alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn need_short(rows: &[Slots<u8, 8>]) -> result: unit pure contract {
  requires forall short(k in 0_u64..rows^.len): rows^[k].len <= 4_u64;
} {
  doc "Owes nothing; its requirement names the length of each row.";
  return unit;
}

fn forward(rows: &[Slots<u8, 8>]) -> result: unit pure contract {
  requires forall held(k in 0_u64..rows^.len): rows^[k].len <= 4_u64;
} {
  doc "The held fact over each row's length discharges the callee's requirement.";
  need_short(rows: rows);
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
