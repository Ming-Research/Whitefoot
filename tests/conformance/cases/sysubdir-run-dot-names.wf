alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias DirectoryRead = std::fs::DirectoryRead;
alias DirectoryWrite = std::fs::DirectoryWrite;

fn copy_name(args: &std::text::Args, position: u64, destination: &[u8]) -> next: u64 reads(args), writes(destination) contract {
  ensures next <= destination^.len;
} {
  match std::text::arg_get(args: args, position: position) {
    Ok(value: text) => {
      let length = destination^.len;
      match std::text::host_copy_bytes(value: &text, destination: destination, start: 0_u64, end: length) {
        Ok(value: end) => {
          return end;
        }
        Err(error: problem) => {
          return 0_u64;
        }
      }
    }
    Err(error: problem) => {
      return 0_u64;
    }
  }
}

fn make_file(factory: &HandleFactory, root: &DirectoryWrite, name: &[u8], byte: u8) -> result: u8 reads(root), reads(name), writes(factory) waits {
  match std::fs::open_append(factory: factory, root: root, name: name, start: 0_u64, end: name^.len) {
    Ok(value: file) => {
      let outcome = 0_u8;
      match std::fs::truncate_file(factory: factory, file: &file, length: 0_u64) {
        Ok(value: done) => {
        }
        Err(error: problem) => {
          set outcome = 2_u8;
        }
      }
      let bytes = array_filled::<u8, 1>(value: byte);
      match std::fs::append_once(factory: factory, file: &file, source: &bytes[0_u64..1_u64], start: 0_u64, end: 1_u64) {
        Ok(value: next) => {
          if next != 1_u64 {
            set outcome = 3_u8;
          }
        }
        Err(error: problem) => {
          set outcome = 4_u8;
        }
      }
      match std::fs::close_write(factory: factory, file: move file) {
        Ok(value: done) => {
        }
        Err(error: problem) => {
          set outcome = 5_u8;
        }
      }
      return outcome;
    }
    Err(error: problem) => {
      return 1_u8;
    }
  }
}

fn check_file(factory: &HandleFactory, root: &DirectoryRead, name: &[u8], byte: u8) -> result: u8 reads(root), reads(name), writes(factory) waits {
  match std::fs::open_file(factory: factory, root: root, name: name, start: 0_u64, end: name^.len) {
    Ok(value: opened) => {
      let bytes = array_filled::<u8, 2>(value: 255_u8);
      let outcome = 0_u8;
      match std::fs::read_at(factory: factory, file: &opened, destination: &bytes[0_u64..2_u64], file_offset: 0_u64, start: 0_u64, end: 2_u64) {
        Ok(value: next) => {
          if next != 1_u64 {
            set outcome = 6_u8;
          }
        }
        Err(error: problem) => {
          set outcome = 7_u8;
        }
      }
      std::fs::close_read(factory: factory, file: move opened);
      if bytes[0_u64] != byte {
        set outcome = 8_u8;
      }
      return outcome;
    }
    Err(error: problem) => {
      return 9_u8;
    }
  }
}

fn invalid_path(error: &std::io::IoError) -> result: Bool reads(error) {
  match error^ {
    NotFound(code: c, origin: o) => {
      return False();
    }
    PermissionDenied(code: c, origin: o) => {
      return False();
    }
    AlreadyExists(code: c, origin: o) => {
      return False();
    }
    NotDirectory(code: c, origin: o) => {
      return False();
    }
    IsDirectory(code: c, origin: o) => {
      return False();
    }
    DirectoryNotEmpty(code: c, origin: o) => {
      return False();
    }
    ReadOnly(code: c, origin: o) => {
      return False();
    }
    ResourceBusy(code: c, origin: o) => {
      return False();
    }
    InvalidInput(code: c, origin: o) => {
      return False();
    }
    InvalidPath(code: c, origin: o) => {
      return True();
    }
    Unsupported(code: c, origin: o) => {
      return False();
    }
    TimedOut(code: c, origin: o) => {
      return False();
    }
    DeadlinePassed() => {
      return False();
    }
    BrokenPipe(code: c, origin: o) => {
      return False();
    }
    WriteZero(code: c, origin: o) => {
      return False();
    }
    UnexpectedEnd(code: c, origin: o) => {
      return False();
    }
    ConnectionRefused(code: c, origin: o) => {
      return False();
    }
    ConnectionReset(code: c, origin: o) => {
      return False();
    }
    ConnectionAborted(code: c, origin: o) => {
      return False();
    }
    NotConnected(code: c, origin: o) => {
      return False();
    }
    AddressInUse(code: c, origin: o) => {
      return False();
    }
    AddressUnavailable(code: c, origin: o) => {
      return False();
    }
    ResourceExhausted(code: c, origin: o) => {
      return False();
    }
    FileTooLarge(code: c, origin: o) => {
      return False();
    }
    NoSpace(code: c, origin: o) => {
      return False();
    }
    QuotaExceeded(code: c, origin: o) => {
      return False();
    }
    CrossDevice(code: c, origin: o) => {
      return False();
    }
    DeviceFailure(code: c, origin: o) => {
      return False();
    }
    Other(code: c, origin: o) => {
      return False();
    }
  }
}

fn refuse_write_open(factory: &HandleFactory, writer: &DirectoryWrite, name: &[u8], opened: u8, kind: u8) -> result: u8 reads(writer), reads(name), writes(factory) waits {
  match std::fs::open_directory_write(factory: factory, root: writer, name: name, start: 0_u64, end: name^.len) {
    Ok(value: handle) => {
      std::fs::close_directory_write(factory: factory, directory: move handle);
      return opened;
    }
    Err(error: problem) => {
      let invalid = invalid_path(error: &problem);
      if invalid {
        return 0_u8;
      }
      return kind;
    }
  }
}

fn refuse_read_open(factory: &HandleFactory, reader: &DirectoryRead, name: &[u8], opened: u8, kind: u8) -> result: u8 reads(reader), reads(name), writes(factory) waits {
  match std::fs::open_directory(factory: factory, root: reader, name: name, start: 0_u64, end: name^.len) {
    Ok(value: handle) => {
      std::fs::close_directory(factory: factory, directory: move handle);
      return opened;
    }
    Err(error: problem) => {
      let invalid = invalid_path(error: &problem);
      if invalid {
        return 0_u8;
      }
      return kind;
    }
  }
}

fn refuse_file_open(factory: &HandleFactory, reader: &DirectoryRead, name: &[u8], opened: u8, kind: u8) -> result: u8 reads(reader), reads(name), writes(factory) waits {
  match std::fs::open_file(factory: factory, root: reader, name: name, start: 0_u64, end: name^.len) {
    Ok(value: handle) => {
      std::fs::close_read(factory: factory, file: move handle);
      return opened;
    }
    Err(error: problem) => {
      let invalid = invalid_path(error: &problem);
      if invalid {
        return 0_u8;
      }
      return kind;
    }
  }
}

fn refuse_append(factory: &HandleFactory, writer: &DirectoryWrite, name: &[u8], opened: u8, kind: u8) -> result: u8 reads(writer), reads(name), writes(factory) waits {
  match std::fs::open_append(factory: factory, root: writer, name: name, start: 0_u64, end: name^.len) {
    Ok(value: handle) => {
      std::fs::close_write(factory: factory, file: move handle);
      return opened;
    }
    Err(error: problem) => {
      let invalid = invalid_path(error: &problem);
      if invalid {
        return 0_u8;
      }
      return kind;
    }
  }
}

fn refuse_rename(factory: &HandleFactory, writer: &DirectoryWrite, from: &[u8], to: &[u8], done: u8, kind: u8) -> result: u8 reads(from), reads(to), writes(factory), writes(writer) waits {
  match std::fs::rename_file(factory: factory, root: writer, from: from, from_start: 0_u64, from_end: from^.len, to: to, to_start: 0_u64, to_end: to^.len) {
    Ok(value: renamed) => {
      return done;
    }
    Err(error: problem) => {
      let invalid = invalid_path(error: &problem);
      if invalid {
        return 0_u8;
      }
      return kind;
    }
  }
}

fn refuse_remove(factory: &HandleFactory, writer: &DirectoryWrite, name: &[u8], done: u8, kind: u8) -> result: u8 reads(name), writes(factory), writes(writer) waits {
  match std::fs::remove_file(factory: factory, root: writer, name: name, start: 0_u64, end: name^.len) {
    Ok(value: removed) => {
      return done;
    }
    Err(error: problem) => {
      let invalid = invalid_path(error: &problem);
      if invalid {
        return 0_u8;
      }
      return kind;
    }
  }
}

fn refuse_move(factory: &HandleFactory, from_root: &DirectoryWrite, from: &[u8], to_root: &DirectoryWrite, to: &[u8], done: u8, kind: u8) -> result: u8 reads(from), reads(to), writes(factory), writes(from_root), writes(to_root) waits {
  match std::fs::move_file(factory: factory, from_root: from_root, from: from, from_start: 0_u64, from_end: from^.len, to_root: to_root, to: to, to_start: 0_u64, to_end: to^.len) {
    Ok(value: moved) => {
      return done;
    }
    Err(error: problem) => {
      let invalid = invalid_path(error: &problem);
      if invalid {
        return 0_u8;
      }
      return kind;
    }
  }
}

fn exercise(factory: &HandleFactory, reader: &DirectoryRead, writer: &DirectoryWrite, dot: &[u8], dots: &[u8], plain: &[u8], folder: &[u8], leading_dot: &[u8], double_dot: &[u8]) -> result: u8 reads(reader), reads(dot), reads(dots), reads(plain), reads(folder), reads(leading_dot), reads(double_dot), writes(factory), writes(writer) waits {
  let outcome = make_file(factory: factory, root: writer, name: plain, byte: 97_u8);
  if outcome != 0_u8 {
    return outcome;
  }
  set outcome = refuse_write_open(factory: factory, writer: writer, name: dots, opened: 10_u8, kind: 11_u8);
  if outcome != 0_u8 {
    return outcome;
  }
  set outcome = refuse_write_open(factory: factory, writer: writer, name: dot, opened: 12_u8, kind: 13_u8);
  if outcome != 0_u8 {
    return outcome;
  }
  set outcome = refuse_read_open(factory: factory, reader: reader, name: dots, opened: 14_u8, kind: 15_u8);
  if outcome != 0_u8 {
    return outcome;
  }
  set outcome = refuse_read_open(factory: factory, reader: reader, name: dot, opened: 16_u8, kind: 17_u8);
  if outcome != 0_u8 {
    return outcome;
  }
  set outcome = refuse_file_open(factory: factory, reader: reader, name: dots, opened: 18_u8, kind: 19_u8);
  if outcome != 0_u8 {
    return outcome;
  }
  set outcome = refuse_append(factory: factory, writer: writer, name: dots, opened: 20_u8, kind: 21_u8);
  if outcome != 0_u8 {
    return outcome;
  }
  set outcome = refuse_rename(factory: factory, writer: writer, from: plain, to: dots, done: 22_u8, kind: 23_u8);
  if outcome != 0_u8 {
    return outcome;
  }
  set outcome = refuse_remove(factory: factory, writer: writer, name: dots, done: 24_u8, kind: 25_u8);
  if outcome != 0_u8 {
    return outcome;
  }
  match std::fs::open_directory_write(factory: factory, root: writer, name: folder, start: 0_u64, end: folder^.len) {
    Ok(value: target) => {
      set outcome = refuse_move(factory: factory, from_root: writer, from: plain, to_root: &target, to: dots, done: 26_u8, kind: 27_u8);
      std::fs::close_directory_write(factory: factory, directory: move target);
      if outcome != 0_u8 {
        return outcome;
      }
    }
    Err(error: problem) => {
      return 30_u8;
    }
  }
  let made = make_file(factory: factory, root: writer, name: leading_dot, byte: 98_u8);
  if made != 0_u8 {
    return 40_u8 +sat made;
  }
  set made = make_file(factory: factory, root: writer, name: double_dot, byte: 99_u8);
  if made != 0_u8 {
    return 50_u8 +sat made;
  }
  let found = check_file(factory: factory, root: reader, name: leading_dot, byte: 98_u8);
  if found != 0_u8 {
    return 60_u8 +sat found;
  }
  set found = check_file(factory: factory, root: reader, name: double_dot, byte: 99_u8);
  if found != 0_u8 {
    return 70_u8 +sat found;
  }
  return check_file(factory: factory, root: reader, name: plain, byte: 97_u8);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: args, cwd: directory, stdout: out, stderr: errors, handles: factory, stdin: input, clock: clock, wall_clock: wall, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: reader, write: writer) = move directory;
  let dot = array_filled::<u8, 64>(value: 0_u8);
  let dot_end = copy_name(args: &args, position: 1_u64, destination: &dot[0_u64..64_u64]);
  let dots = array_filled::<u8, 64>(value: 0_u8);
  let dots_end = copy_name(args: &args, position: 2_u64, destination: &dots[0_u64..64_u64]);
  let plain = array_filled::<u8, 64>(value: 0_u8);
  let plain_end = copy_name(args: &args, position: 3_u64, destination: &plain[0_u64..64_u64]);
  let folder = array_filled::<u8, 64>(value: 0_u8);
  let folder_end = copy_name(args: &args, position: 4_u64, destination: &folder[0_u64..64_u64]);
  let leading_dot = array_filled::<u8, 64>(value: 0_u8);
  let leading_end = copy_name(args: &args, position: 5_u64, destination: &leading_dot[0_u64..64_u64]);
  let double_dot = array_filled::<u8, 64>(value: 0_u8);
  let double_end = copy_name(args: &args, position: 6_u64, destination: &double_dot[0_u64..64_u64]);
  let outcome = 99_u8;
  if dot_end > 0_u64 {
    if dot_end <= 64_u64 {
      if dots_end > 0_u64 {
        if dots_end <= 64_u64 {
          if plain_end > 0_u64 {
            if plain_end <= 64_u64 {
              if folder_end > 0_u64 {
                if folder_end <= 64_u64 {
                  if leading_end > 0_u64 {
                    if leading_end <= 64_u64 {
                      if double_end > 0_u64 {
                        if double_end <= 64_u64 {
                          set outcome = exercise(factory: &factory, reader: &reader, writer: &writer, dot: &dot[0_u64..dot_end], dots: &dots[0_u64..dots_end], plain: &plain[0_u64..plain_end], folder: &folder[0_u64..folder_end], leading_dot: &leading_dot[0_u64..leading_end], double_dot: &double_dot[0_u64..double_end]);
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  std::fs::close_directory(factory: &factory, directory: move reader);
  std::fs::close_directory_write(factory: &factory, directory: move writer);
  return std::process::exit_status(code: outcome);
}
