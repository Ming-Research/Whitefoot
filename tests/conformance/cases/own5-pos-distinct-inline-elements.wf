alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Row {
  left: u64;
  right: u64;
}

fn main() -> status: ExitStatus pure {
  doc "Different literal indices provably select different storages, so two references into one array name disjoint elements and a write through one leaves the other valid.";
  let row0 = Row(left: 3_u64, right: 4_u64);
  let row1 = Row(left: 3_u64, right: 4_u64);
  let row2 = Row(left: 3_u64, right: 4_u64);
  let row3 = Row(left: 3_u64, right: 4_u64);
  let slots = slots_new::<Row, 4>();
  place_back(window: &slots, value: row0);
  place_back(window: &slots, value: row1);
  place_back(window: &slots, value: row2);
  place_back(window: &slots, value: row3);
  let rows = slots_into_array::<Row, 4>(values: move slots);
  let left = &rows[0_u64];
  let right = &rows[1_u64];
  let value = deref(left).left;
  set deref(right).right = value;
  let observed = deref(left).left;
  return exit_status(code: 0_u8);
}
