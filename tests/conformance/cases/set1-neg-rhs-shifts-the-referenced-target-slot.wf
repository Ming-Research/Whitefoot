alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "SET-1, REF-2: the spelling of set1-neg-rhs-shifts-the-target-slot through an explicit reference. e = &v[1_u64] is formed before the set, remove_at in the right-hand side ends the bound it was formed under, and the target e^ is evaluated after it, so the use of e there is refused as a use of an invalid reference.";
  let v = slots_new::<Box<u64>, 4>();
  let first = box_new::<u64>(value: 1_u64);
  place_back(window: &v, value: move first);
  let second = box_new::<u64>(value: 2_u64);
  place_back(window: &v, value: move second);
  let e = &v[1_u64];
  set e^ = remove_at(window: &v, index: 0_u64);
  return exit_status(code: 0_u8);
}
