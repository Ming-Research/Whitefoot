fn bump(marks: &[u64], x: u64, y: u8) -> result: u8 pure contract {
  requires forall small(k in 0_u64..marks^.len): marks^[k] < 8_u64;
} {
  doc "r names a or b, so the write of r^[1] may make a[1] y, which may be 9.";
  let a = array_filled::<u8, 4>(value: 0_u8);
  let b = array_filled::<u8, 4>(value: 0_u8);
  set a[1_u64] = 1_u8;
  set b[1_u64] = 1_u8;
  let r = if x < 10_u64 {
    give &a;
  } else {
    give &b;
  }
  set r^[1_u64] = y;
  let v = a[1_u64];
  let w = 251_u8 + v;
  return w;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
