struct Cell {
  digits: Array<u8, 2>;
}

struct Cursor {
  index: u64;
}

fn establish(cell: &Cell, cursor: &Cursor) -> result: unit reads(cursor.index), writes(cell.digits) contract {
  requires cursor^.index < cell^.digits.len;
  ensures 1_u8 <= cell^.digits[cursor^.index];
} {
  set cell^.digits[cursor^.index] = 1_u8;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let digits = array_filled::<u8, 2>(value: 0_u8);
  let cell = Cell(digits: digits);
  let cursor = Cursor(index: 0_u64);
  establish(cell: &cell, cursor: &cursor);
  let first = cell.digits[cursor.index] - 1_u8;
  set cursor.index = 1_u64;
  establish(cell: &cell, cursor: &cursor);
  let second = cell.digits[cursor.index] - 1_u8;
  return std::process::exit_status(code: first +wrap second);
}
