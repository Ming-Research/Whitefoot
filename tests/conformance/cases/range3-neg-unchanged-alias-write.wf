struct Pair {
  left: u64;
  right: u64;
}

fn tweak(cells: &Array<Pair, 1>) -> result: unit writes(cells) contract {
  ensures forall kept(k in 0_u64..cells^.len): cells^[k] unchanged;
} {
  let target_pair = &cells^[0_u64];
  set target_pair^.right = 9_u64;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
