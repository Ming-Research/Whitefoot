alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure contract {
  define permitted = 0_i32 > 0_i32;
  requires permitted;
} {
  doc "FN-7 and FN-8: a selected function has an ordinary static contract; this contradictory requirement makes its body uninhabited and is never checked by a runtime fallback.";
  return exit_status(code: 0_u8);
}
