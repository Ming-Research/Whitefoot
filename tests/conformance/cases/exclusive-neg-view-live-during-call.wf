alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn blend(target: &[u8], source: &[u8]) -> result: unit reads(source), writes(target) contract {
  requires deref(target).len > 0_u64;
  requires deref(source).len > 0_u64;
} {
  doc "Copies one element from the read range into the written range.";
  let first = deref(source)[0_u64];
  set deref(target)[0_u64] = first;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "Two range references over the same extent of one window are handed to one call, one of them at a written parameter. EFF-5 compares the substituted paths pairwise, no admitted family proves the two ranges disjoint [OWN-7, REF-4], and the overlapping write/read pair is rejected at the call.";
  let line = slots_new::<u8, 4>();
  place_back(window: &line, value: 1_u8);
  place_back(window: &line, value: 2_u8);
  let part = &line[0_u64..2_u64];
  let same = &line[0_u64..2_u64];
  blend(target: part, source: same);
  return exit_status(code: 0_u8);
}
