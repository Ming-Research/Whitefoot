alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn room(values: Slots<u64, 16>, extra: u64, limit: u64) -> result: u64 pure contract {
  requires values.len <= 16_u64;
  requires extra <= 16_u64;
  requires values.len + extra <= limit;
} {
  doc "Replacing the whole measured binding kills the current length image [ENT-5]. The requirement named the body-entry image, while the replacement is independently made nonempty, so a fresh length read cannot inherit the former length-plus-extra bound and the subtraction's domain is unproved [OP-2].";
  let replacement = slots_new::<u64, 16>();
  place_back(window: &replacement, value: 0_u64);
  set values = move replacement;
  let current = values.len;
  let total = current + extra;
  let remaining = limit - total;
  return remaining;
}

fn main() -> status: ExitStatus pure {
  doc "The function body itself contains the satisfiable counterexample: empty input, zero extra and zero limit, followed by the one-element replacement.";
  return exit_status(code: 0_u8);
}
