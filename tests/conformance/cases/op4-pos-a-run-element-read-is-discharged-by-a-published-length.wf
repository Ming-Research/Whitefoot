alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn two() -> made: Slots<u8, 4> pure contract {
  ensures made.len >= 2_u64;
} {
  doc "Builds a run of two values and publishes what its window then holds.";
  let filled = slots_new::<u8, 4>();
  place_back(window: &filled, value: 7_u8);
  place_back(window: &filled, value: 9_u8);
  return move filled;
}

fn main() -> status: ExitStatus pure {
  doc "OP-4: the same obligation a target owes, discharged at a read. The callee's verified relation puts two elements in the window, so `1_u64 < built.len` holds at the subscript and the read executes with no runtime check.";
  let built = two();
  let second = built[1_u64];
  if second == 9_u8 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
