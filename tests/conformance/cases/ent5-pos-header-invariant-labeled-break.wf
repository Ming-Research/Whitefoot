alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn find_mark(data: &[u8]) -> result: u64 reads(data) contract {
  ensures result <= data^.len;
} {
  doc "The labeled break leaves the inner loop and the outer loop in one edge. The outer header conclusion reaches the continuation on that edge and on the outer loop's own break, so the postcondition is proved [ENT-5, INV-1].";
  let length = data^.len;
  let pos = 0_u64;
  loop @scan (
    invariant bounded: pos <= length
  ) {
    if pos >= length {
      break;
    }
    let tries = 0_u64;
    loop {
      if tries >= 2_u64 {
        break;
      }
      let byte = data^[pos];
      if byte == 65_u8 {
        break @scan;
      }
      set tries = tries + 1_u64;
    }
    set pos = pos + 1_u64;
  }
  return pos;
}

fn main() -> status: ExitStatus pure {
  doc "One scan finds the mark and one runs to the end; each result is observed.";
  let marked = array_filled::<u8, 4>(value: 32_u8);
  set marked[2_u64] = 65_u8;
  let marked_view = &marked[0_u64..4_u64];
  let found = find_mark(data: marked_view);
  if found == 2_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  let blank = array_filled::<u8, 3>(value: 32_u8);
  let blank_view = &blank[0_u64..3_u64];
  let missing = find_mark(data: blank_view);
  if missing == 3_u64 {
  } else {
    return exit_status(code: 202_u8);
  }
  return exit_status(code: 0_u8);
}
