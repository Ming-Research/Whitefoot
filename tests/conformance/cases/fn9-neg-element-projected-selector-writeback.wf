struct Cell {
  digits: Array<u8, 2>;
}

struct Cursor {
  index: u64;
}

fn establish(cell: &Cell, cursor: &Cursor) -> result: unit writes(cell.digits), writes(cursor.index) contract {
  requires cursor^.index == 0_u64;
  ensures 1_u8 <= cell^.digits[cursor^.index];
} {
  set cell^.digits[cursor^.index] = 1_u8;
  set cursor^.index = 0_u64;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
