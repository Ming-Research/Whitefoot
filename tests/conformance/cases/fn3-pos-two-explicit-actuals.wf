alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

interface Zeroed {
  fn zero() -> result: i32 pure;
}

binding First : Zeroed {
  zero = i32_zero_a;
}

binding Second : Zeroed {
  zero = i32_zero_b;
}

fn i32_zero_a() -> result: i32 pure {
  return 0_i32;
}

fn i32_zero_b() -> result: i32 pure {
  return 0_i32;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
