alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const row: Array<u8, 5> = "a\tb\r\n";

fn main() -> status: ExitStatus pure {
  doc "In a STRING, \\t and \\r each denote one byte, U+0009 and U+000D, as in the doc text\there.";
  let tab = row[1_u64];
  if tab == 9_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  let carriage = row[3_u64];
  if carriage == '\r'_u8 {
  } else {
    return exit_status(code: 2_u8);
  }
  let newline = row[4_u64];
  if newline == 10_u8 {
  } else {
    return exit_status(code: 3_u8);
  }
  let length = row.len;
  if length == 5_u64 {
  } else {
    return exit_status(code: 4_u8);
  }
  return exit_status(code: 0_u8);
}
