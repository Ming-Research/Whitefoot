alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Pair {
  left: i32;
  right: i32;
}

fn observe(pair: &Pair) -> result: i32 reads(pair.left) contract {
  ensures result == pair^.left;
} {
  return pair^.left;
}

fn guard(left: i32, right: i32) -> result: unit pure contract {
  requires left == right;
} {
  return unit;
}

fn ordinary(pair: &Pair) -> result: unit reads(pair.left), writes(pair.right) {
  let observed = pair^.left;
  set pair^.right = 1_i32;
  guard(left: observed, right: pair^.left);
  return unit;
}

fn from_call(pair: &Pair) -> result: unit reads(pair.left), writes(pair.right) {
  let observed = observe(pair: &pair^);
  set pair^.right = 1_i32;
  guard(left: observed, right: pair^.left);
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
