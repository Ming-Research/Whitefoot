fn reserve(cell: &Box<Paged<u64>>, capacity: u64) -> result: unit writes(cell) contract {
  requires cell^.inner.pages.len == 1_u64;
  requires capacity >= cell^.inner.cap;
} {
  grow_paged(cell: cell, capacity: capacity);
  invariant initialized_pages: cell^.inner.pages.len == 1_u64;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
