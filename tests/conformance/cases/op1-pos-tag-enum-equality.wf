alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum EmptyEq {
}

enum OneEq {
  OneOnly();
}

enum TrioEq {
  TrioFirst();
  TrioSecond();
  TrioThird();
}

fn empty_compile_only(left: EmptyEq, right: EmptyEq) -> return_value: Bool pure {
  return eeq(left, right);
}

fn main() -> return_value: ExitStatus pure {
  let one = OneEq::OneOnly();
  let one_eq = eeq(one, one);
  let one_ne = ene(one, one);
  if one_eq {
  } else {
    return exit_status(code: 1_u8);
  }
  let not_one_ne = bnot(one_ne);
  if not_one_ne {
  } else {
    return exit_status(code: 2_u8);
  }
  let first = TrioEq::TrioFirst();
  let second = TrioEq::TrioSecond();
  let third = TrioEq::TrioThird();
  let eq00 = eeq(first, first);
  let ne00 = ene(first, first);
  if eq00 {
  } else {
    return exit_status(code: 3_u8);
  }
  let not_ne00 = bnot(ne00);
  if not_ne00 {
  } else {
    return exit_status(code: 4_u8);
  }
  let eq01 = eeq(first, second);
  let ne01 = ene(first, second);
  let not_eq01 = bnot(eq01);
  if not_eq01 {
  } else {
    return exit_status(code: 5_u8);
  }
  if ne01 {
  } else {
    return exit_status(code: 6_u8);
  }
  let eq02 = eeq(first, third);
  let ne02 = ene(first, third);
  let not_eq02 = bnot(eq02);
  if not_eq02 {
  } else {
    return exit_status(code: 7_u8);
  }
  if ne02 {
  } else {
    return exit_status(code: 8_u8);
  }
  let eq10 = eeq(second, first);
  let ne10 = ene(second, first);
  let not_eq10 = bnot(eq10);
  if not_eq10 {
  } else {
    return exit_status(code: 9_u8);
  }
  if ne10 {
  } else {
    return exit_status(code: 10_u8);
  }
  let eq11 = eeq(second, second);
  let ne11 = ene(second, second);
  if eq11 {
  } else {
    return exit_status(code: 11_u8);
  }
  let not_ne11 = bnot(ne11);
  if not_ne11 {
  } else {
    return exit_status(code: 12_u8);
  }
  let eq12 = eeq(second, third);
  let ne12 = ene(second, third);
  let not_eq12 = bnot(eq12);
  if not_eq12 {
  } else {
    return exit_status(code: 13_u8);
  }
  if ne12 {
  } else {
    return exit_status(code: 14_u8);
  }
  let eq20 = eeq(third, first);
  let ne20 = ene(third, first);
  let not_eq20 = bnot(eq20);
  if not_eq20 {
  } else {
    return exit_status(code: 15_u8);
  }
  if ne20 {
  } else {
    return exit_status(code: 16_u8);
  }
  let eq21 = eeq(third, second);
  let ne21 = ene(third, second);
  let not_eq21 = bnot(eq21);
  if not_eq21 {
  } else {
    return exit_status(code: 17_u8);
  }
  if ne21 {
  } else {
    return exit_status(code: 18_u8);
  }
  let eq22 = eeq(third, third);
  let ne22 = ene(third, third);
  if eq22 {
  } else {
    return exit_status(code: 19_u8);
  }
  let not_ne22 = bnot(ne22);
  if not_ne22 {
  } else {
    return exit_status(code: 20_u8);
  }
  return exit_status(code: 0_u8);
}
