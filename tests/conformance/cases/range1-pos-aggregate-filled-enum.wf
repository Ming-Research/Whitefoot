enum Flow {
  Open(block: u64);
  Close(block: u64);
}

fn need(targets: &[Flow]) -> result: unit pure contract {
  requires forall zero(k in 0_u64..targets^.len): targets^[k].Open.block == 3_u64;
} {
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let opened = Flow::Open(block: 3_u64);
  let targets = array_filled::<Flow, 1>(value: opened);
  need(targets: &targets[0_u64..1_u64]);
  return std::process::exit_status(code: 0_u8);
}
