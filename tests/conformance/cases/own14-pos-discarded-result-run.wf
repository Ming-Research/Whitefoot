alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn source(x: &i32) -> result: i32 reads(x) {
  doc "A function hands back owned data rather than a reference; the caller keeps the reference it formed.";
  return x^;
}

fn main() -> status: ExitStatus pure {
  doc "Discarding the returned owned copy leaves the underlying scalar unchanged and permits its later ordinary read, which is the exit status 5.";
  let v = 5_i32;
  let h = &v;
  source(x: h);
  let code = cvt::<i32, u8>(v);
  return exit_status(code: code);
}
