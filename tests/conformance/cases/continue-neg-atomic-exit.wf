struct Counter {
  value: u64;
  invariant bounded(counter): counter.value <= 4_u64;
}

fn main() -> status: std::process::ExitStatus pure waits {
  doc "Checks atomic normal exit on continue and reacquires the state.";
  let initial = Counter(value: 0_u64);
  let shared = shared_new::<Counter>(value: initial);
  let observed = 0_u64;
  for (i in 0_u64..2_u64) {
    atomic held = &shared {
      set held^.value = 5_u64;
      set observed = held^.value;
      continue;
    }
  }
  if observed != 4_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
