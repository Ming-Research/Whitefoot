alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn pop(values: &Slots<u64, 4>) -> (value: u64, count: u64) writes(values) contract {
  requires deref(values).len > 0_u64;
  ensures deref(values).len == deref(entry(values)).len - 1_u64;
  ensures count == deref(values).len;
} {
  doc "The window operation returns only its element; this function returns that element beside a scalar measure.";
  let value = take_back(window: values);
  let count = deref(values).len;
  return value, count;
}

fn main() -> status: ExitStatus pure {
  doc "A take returns only its element; a source caller returns that element and a scalar measure beside the window postcondition. Both scalar and state facts reach the caller.";
  let values = slots_new::<u64, 4>();
  place_back(window: &values, value: 7_u64);
  let (value, count) = pop(values: &values);
  invariant empty: values.len <= 0_u64;
  invariant reported: count <= 0_u64;
  if value != 7_u64 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
