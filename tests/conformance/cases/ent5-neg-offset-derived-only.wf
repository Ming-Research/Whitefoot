fn probe(cursor: u64, flag: Bool) -> result: unit pure {
  doc "ENT-5's finite candidate rule boundary: cursor <= 3 and cursor >= 5 each derive cursor != 4, but neither establishes that nonzero exclusion, so the later invariant is refused by INV-1.";
  if cursor < 4_u64 {
  }
  if flag {
    if 3_u64 < cursor {
      return unit;
    }
  } else {
    if cursor < 5_u64 {
      return unit;
    }
  }
  let marker = 0_u8;
  if cursor <= 4_u64 {
    invariant tightened: cursor <= 3_u64;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
