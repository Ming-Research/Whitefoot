alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Sample {
  value: f32;
}

const values: Array<f32, 2> =[1.5_f32, 2.5_f32];

fn main() -> status: ExitStatus pure {
  doc "An f32 constant element survives a struct field and a mutable run store and read with its exact representable value.";
  let sample = Sample(value: values[0_u64]);
  let storage = slots_new::<f32, 2>();
  place_back(window: &storage, value: 0.0_f32);
  place_back(window: &storage, value: 0.0_f32);
  set storage[1_u64] = sample.value;
  let loaded = storage[1_u64];
  if feq(loaded, 1.5_f32) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
