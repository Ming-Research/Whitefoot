fn main() -> status: std::process::ExitStatus pure {
  doc "TYPE-9: runtime-capacity contents take only the Box-content home, so exchanging their headers is refused.";
  let small = box_ring_new::<u64>(capacity: 1_u64);
  let large = box_ring_new::<u64>(capacity: 64_u64);
  swap(first: &small.inner, second: &large.inner);
  return std::process::exit_status(code: 0_u8);
}
