alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Block {
  count: u64;
}

fn pass_block(block: Block) -> result: Block pure contract {
  ensures result.count == block.count;
} {
  doc "FN-9 admits its specified whole-result forms, the explicit Result route and CALL-4's measures of owned descendants; an ordinary integer field of an aggregate result such as `result.count` is not a selectable result datum.";
  return move block;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
