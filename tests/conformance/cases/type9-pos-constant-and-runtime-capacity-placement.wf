alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn window_length(window: &Slots<u64, 4>) -> result: u64 reads(window.len) {
  doc "TYPE-9: a constant-capacity Slots<T, N> is a nameable type whose capacity is the type constant N and whose storage is inline in the owner or the stack frame.";
  let n = window^.len;
  return n;
}

fn boxed_length(cell: &Box<Slots<u64>>) -> result: u64 reads(cell.inner.len) {
  doc "TYPE-9: a runtime-capacity Slots<T> is allocated as Box content and may be referenced at that position; the ordinary field step inner reaches the content.";
  let n = cell^.inner.len;
  return n;
}

fn main() -> status: ExitStatus pure {
  doc "TYPE-9: three storage shapes, two placements each, and one cell; the constant-capacity form is written inline and the runtime-capacity form as Box content, referenced through the field inner.";
  let s = slots_new::<u64, 4>();
  let bs = box_slots_new::<u64>(capacity: 4_u64);
  let inline_len = window_length(window: &s);
  let boxed_len = boxed_length(cell: &bs);
  if inline_len == 0_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  if boxed_len == 0_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
