const one: u8 = 1_u8;
const also_one: u8 = 1_u8;

fn reduce() -> result: u8 pure {
  doc "Equal named and literal constants share one mark family; zero marks are not absence of a contribution.";
  let ones = array_filled::<u8, 4>(value: 9_u8);
  let zeros = array_filled::<u8, 4>(value: 9_u8);
  for (i in 0_u64..8_u64) {
    let bucket = i % 2_u64;
    if i < 2_u64 {
      set ones[bucket] = one;
    } else if i < 4_u64 {
      set ones[bucket] = also_one;
    } else {
      set ones[bucket] = 1_u8;
    }
    set zeros[bucket] = 0_u8;
  }
  let touched = ones[0_u64] +wrap ones[1_u64];
  let untouched = ones[3_u64] +wrap zeros[3_u64];
  let marked_zero = zeros[0_u64] +wrap zeros[1_u64];
  let subtotal = touched +wrap untouched;
  return subtotal +wrap marked_zero;
}

fn main() -> status: std::process::ExitStatus pure {
  let result = reduce();
  if result != 20_u8 {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
