alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

interface Reader<T: copy> {
  fn read(value: T) -> result: u64 pure;
}

fn select<interface Reader<A>, interface Reader<B>>(first: A, second: B) -> result: u64 pure {
  return Reader::read(value: first);
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
