fn probe(flag: Bool) -> result: u8 pure {
  if flag {
    let values = array_filled::<u8, 2>(value: 1_u8);
    if 1_u8 <= values[0_u64] {
      let old = values[0_u64] - 1_u8;
    } else {
      return 0_u8;
    }
  } else {
    return 0_u8;
  }
  let values = array_filled::<u8, 2>(value: 0_u8);
  return values[0_u64] - 1_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
