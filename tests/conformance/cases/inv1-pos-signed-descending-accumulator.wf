alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn accumulate_descending(count: u64) -> result: i32 pure contract {
  requires count <= 40_u64;
} {
  let sum = 0_i32;
  for (
    i in 0_u64..count,
    invariant lower_bound: sum >= -3_i32 * i
  ) {
    set sum = sum - 3_i32;
  }
  return sum;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
