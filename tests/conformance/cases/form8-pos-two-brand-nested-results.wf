alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Pair<L, R> {
  left: Box<L>;
  right: Box<R>;
}

fn build<L, R>(left: Box<L>, right: Box<R>) -> slots: Slots<Option<Pair<L, R>>, 1> pure {
  let pair = Pair<L, R>(left: move left, right: move right);
  let occupied = Some<Pair<L, R>>(value: move pair);
  let slots = slots_new::<Option<Pair<L, R>>, 1>();
  place_back(window: &slots, value: move occupied);
  return move slots;
}

fn pass<L, R>(slots: Slots<Option<Pair<L, R>>, 1>) -> result: Slots<Option<Pair<L, R>>, 1> pure {
  return move slots;
}

fn compose<L, R>(left: Box<L>, right: Box<R>) -> slots: Slots<Option<Pair<L, R>>, 1> pure {
  doc "Nested aggregate and run results preserve two distinct written type arguments across composition [FN-1, FN-2].";
  let slots = build::<L, R>(left: move left, right: move right);
  return pass::<L, R>(slots: move slots);
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
