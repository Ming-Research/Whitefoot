alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "A zero-capacity heap window reports zero length and exits normally. Exact release accounting belongs to runtime ledger tests.";
  let Inputs(args: unused_args, cwd: unused_cwd, stdout: unused_stdout, stderr: unused_stderr, handles: entry_factory, stdin: unused_stdin) = move inputs;
  close_directory(factory: &entry_factory, directory: move unused_cwd);
  let values = box_slots_new::<u8>(capacity: 0_u64);
  let length = values.inner.len;
  if length != 0_u64 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
