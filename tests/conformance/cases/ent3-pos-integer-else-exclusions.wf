const first: u64 = 2_u64;

fn exclude_first(value: u64) -> result: unit pure contract {
  requires value != 2_u64;
} {
  return unit;
}

fn exclude_second(value: u64) -> result: unit pure contract {
  requires value != 4_u64;
} {
  return unit;
}

fn selected(value: u64) -> result: unit pure {
  match value {
    first => {
      return unit;
    }
    4_u64 => {
      return unit;
    }
    else => {
      exclude_first(value: value);
      exclude_second(value: value);
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
