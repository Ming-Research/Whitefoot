fn reserve(cell: &Box<Paged<u64>>, capacity: u64) -> result: unit writes(cell) contract {
  requires 0_u64 < cell^.inner.pages.len;
  requires capacity >= cell^.inner.cap;
} {
  let page = &cell^.inner.pages[0_u64];
  if page^.len == 1_u64 {
    grow_paged(cell: cell, capacity: capacity);
    invariant stale: page^.len == 1_u64;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
