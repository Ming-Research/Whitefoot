fn make() -> result: Slots<u64, 4> pure contract {
  ensures result.len == 1_u64;
} {
  let slots = slots_new::<u64, 4>();
  place_back(window: &slots, value: 1_u64);
  return move slots;
}

fn consume(value: u64) -> result: unit pure contract {
  requires value == 1_u64;
} {
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let rows = slots_new::<Slots<u64, 4>, 1>();
  let initial = slots_new::<u64, 4>();
  place_back(window: &rows, value: move initial);
  let view = &rows[0_u64..1_u64];
  set view^[0_u64] = make();
  let value = view^[0_u64].len;
  let done = consume(value: value);
  return std::process::exit_status(code: 0_u8);
}
