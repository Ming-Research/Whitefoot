alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn inspect(rows: &[Slots<u64, 8>]) -> result: unit pure contract {
  requires forall held(k in 0_u64..rows^.len): rows^[k][0_u64] == 0_u64;
} {
  doc "The requirement subscripts a row of each element, an index below an element.";
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
