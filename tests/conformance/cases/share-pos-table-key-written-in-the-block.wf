struct Store {
  map: KeyedTable<u8>;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let table = keyed_table_new::<u8>(capacity: 0_u64);
  let state = Store(map: move table);
  let store = shared_new::<Store>(value: move state);
  let name = array_filled::<u8, 2>(value: 97_u8);
  let key = &name[0_u64..1_u64];
  atomic s = &store, slot = &s^.map[key] {
    set name[0_u64] = 98_u8;
    set slot^ = Some<u8>(value: 1_u8);
  }
  let found = 0_u8;
  atomic s = &store, a = &s^.map[&name[1_u64..2_u64]], b = &s^.map[&name[0_u64..1_u64]] {
    match a^ {
      Some(value: seen) => {
        set found = seen^;
      }
      None() => {
      }
    }
    match b^ {
      Some(value: seen) => {
        let more = seen^ +wrap 10_u8;
        set found = found +wrap more;
      }
      None() => {
      }
    }
  }
  return std::process::exit_status(code: found);
}
