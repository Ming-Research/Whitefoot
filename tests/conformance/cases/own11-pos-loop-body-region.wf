alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> return_value: ExitStatus pure {
  doc "A loop body is an ordinary block whose own bindings begin and end with one iteration, so a reference formed directly in it is per-iteration and needs no enclosing construct. The value read through it is the exit status 0.";
  let a = 0_i32;
  let code = 1_u8;
  loop @l {
    let p = &a;
    set code = cvt::<i32, u8>(p^);
    break @l;
  }
  return exit_status(code: code);
}
