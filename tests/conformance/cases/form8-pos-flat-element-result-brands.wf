alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Entry<T> {
  payload: Box<T>;
}

fn build<T>(first: Box<T>, replacement: Box<T>) -> (slots: Slots<Option<Entry<T>>, 1>, returned: Box<T>) pure contract {
  ensures slots.len == 1_u64;
} {
  doc "Two owned results carry written type arguments inside a run's element type, and the run's length is published for the element exchange below.";
  let stored_entry = Entry<T>(payload: move first);
  let occupied = Some<Entry<T>>(value: move stored_entry);
  let slots = slots_new::<Option<Entry<T>>, 1>();
  place_back(window: &slots, value: move occupied);
  return move slots, move replacement;
}

fn exchange_one<T>(slots: &Slots<Option<Entry<T>>, 1>, spare: &Option<Entry<T>>) -> result: unit writes(slots), writes(spare) contract {
  requires 1_u64 <= deref(slots).len;
} {
  doc "One commit per statement and no hole: `swap` exchanges the stored element with the caller's spare, consumes neither root, and leaves each root the sole owner of what the other held [OP-11, SET-1].";
  swap(first: &deref(slots)[0_u64], second: spare);
  return unit;
}

fn compose<T>(first: Box<T>, replacement: Box<T>) -> (updated: Slots<Option<Entry<T>>, 1>, previous: Option<Entry<T>>) pure {
  let (slots, returned) = build::<T>(first: move first, replacement: move replacement);
  let stored_entry = Entry<T>(payload: move returned);
  let spare = Some<Entry<T>>(value: move stored_entry);
  exchange_one::<T>(slots: &slots, spare: &spare);
  return move slots, move spare;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
