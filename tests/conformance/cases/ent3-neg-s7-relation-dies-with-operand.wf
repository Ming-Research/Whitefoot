alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn at_most(value: u64, limit: u64) -> result: unit pure contract {
  requires value <= limit;
} {
  return unit;
}

fn rows(value: u64, other: u64) -> result: unit pure {
  let low = iand(value, other);
  set value = 0_u64;
  at_most(value: low, limit: value);
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
