const names: Array<u8, 2> =[97_u8, 98_u8];

struct Tally {
  table: ConcurrentHashMap<u8>;
  total: u8;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let table = map_new::<u8>(capacity: 2_u64);
  let tally = Tally(table: move table, total: 0_u8);
  let store = shared_new::<Tally>(value: move tally);
  let got = 0_u8;
  let counted = 0_u64;
  atomic t = &store {
    let first = &names[0_u64..1_u64];
    set t^.table[first] = Some<u8>(value: 5_u8);
    let second = &names[1_u64..2_u64];
    match t^.table[second] {
      Some(value: v) => {
        set got = v^;
      }
      None() => {
        set got = 2_u8;
      }
    }
    set t^.table[second] = Some<u8>(value: 4_u8);
    set counted = map_count::<u8>(map: &t^.table);
    set t^.total = got;
  }
  let tens = got *wrap 10_u8;
  let ones = cvt.wrap::<u64, u8>(counted);
  let code = tens +wrap ones;
  return std::process::exit_status(code: code);
}
