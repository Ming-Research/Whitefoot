alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn first_of(part: &[u8]) -> value: u8 reads(part) contract {
  requires 0_u64 < deref(part).len;
} {
  return deref(part)[0_u64];
}

fn choose_first(take_left: Bool, left: &[u8], right: &[u8]) -> value: u8 reads(left), reads(right) contract {
  requires 0_u64 < deref(left).len;
  requires 0_u64 < deref(right).len;
} {
  doc "A two-supplier function selects inside its own frame instead of handing a reference back [REF-3]: both range references arrive as arguments and the selected one is read here.";
  if take_left {
    return first_of(part: left);
  } else {
    return first_of(part: right);
  }
}

fn main() -> status: ExitStatus pure {
  doc "A range reference passes through one call and a two-supplier call reads either input; the caller keeps both references alive across the calls because neither call writes their storage [EFF-5].";
  let left = slots_new::<u8, 2>();
  place_back(window: &left, value: 11_u8);
  let right = slots_new::<u8, 2>();
  place_back(window: &right, value: 29_u8);
  let left_part = &left[0_u64..1_u64];
  let right_part = &right[0_u64..1_u64];
  let passed = first_of(part: left_part);
  if passed == 11_u8 {
  } else {
    return exit_status(code: 201_u8);
  }
  let take_left = False();
  let selected = choose_first(take_left: take_left, left: left_part, right: right_part);
  if selected == 29_u8 {
  } else {
    return exit_status(code: 202_u8);
  }
  return exit_status(code: 0_u8);
}
