struct NumberState {
  number: u64;
}

fn change_record(cell: &Option<NumberState>) -> result: u64 reads(cell), writes(cell.Some.value) {
  doc "Replacing the selected inline record payload ends the arm's variant fact.";
  match &cell^ {
    None() => {
      return 0_u64;
    }
    Some(..) => {
      set cell^.Some.value = NumberState(number: 41_u64);
      return 11_u64;
    }
  }
}

fn write_record_field(cell: &Option<NumberState>) -> result: unit writes(cell) {
  doc "SET-1 evaluates the target after the right-hand side, whose payload write ended the variant fact, so the payload selection is refused.";
  match &cell^ {
    None() => {
      return unit;
    }
    Some(..) => {
      set cell^.Some.value.number = change_record(cell: cell);
      return unit;
    }
  }
}

fn main() -> status: std::process::ExitStatus pure {
  let record = NumberState(number: 7_u64);
  let cell = Some<NumberState>(value: record);
  let changed = write_record_field(cell: &cell);
  match &cell {
    None() => {
      return std::process::exit_status(code: 1_u8);
    }
    Some(value: observed) => {
      if observed^.number == 11_u64 {
        return std::process::exit_status(code: 0_u8);
      }
      return std::process::exit_status(code: 2_u8);
    }
  }
}
