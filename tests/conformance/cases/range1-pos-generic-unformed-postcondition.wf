struct Mark {
  weight: u64;
}

fn first_of<T: copy>(values: &[T]) -> result: Option<Box<Array<T>>> reads(values) contract {
  ensures when Some(value: cells): forall same(k in 0_u64..cells.inner.len): cells.inner[k] == cells.inner[0_u64];
} {
  doc "Returns None at every exit; the postcondition compares values of T.";
  if values^.len > 1000_u64 {
    return None<Box<Array<T>>>();
  }
  return None<Box<Array<T>>>();
}

fn main() -> status: std::process::ExitStatus pure {
  doc "At the Mark instance the postcondition states nothing, so it owes no selected exit either.";
  let weight = Mark(weight: 1_u64);
  let marks = box_array_filled::<Mark>(count: 2_u64, value: weight);
  let got = first_of::<Mark>(values: &marks.inner[0_u64..2_u64]);
  match move got {
    None() => {
      return std::process::exit_status(code: 0_u8);
    }
    Some(..) => {
      return std::process::exit_status(code: 1_u8);
    }
  }
}
