alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn choose(x: u64) -> r: u64 pure contract {
  requires x < 0_u64;
} {
  doc "An uninhabited body does not acquire a redundant-condition rejection.";
  if True() {
    return 1_u64;
  }
  return 2_u64;
}

fn main() -> status: ExitStatus pure {
  doc "The checker judges every body.";
  return exit_status(code: 0_u8);
}
