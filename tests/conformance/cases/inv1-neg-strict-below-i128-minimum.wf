fn pass(x: i64) -> result: i64 pure {
  doc "The header invariant bound folds exactly to -2^127; x < -2^127 normalizes to x <= -2^127 - 1, whose right-hand constant lies outside i128, so INV-1 rejects the invariant where it is formed.";
  loop (
    invariant below_minimum: x < -9223372036854775808_i64 * 9223372036854775807_i64 + -9223372036854775808_i64 * 9223372036854775807_i64 + -9223372036854775808_i64 + -9223372036854775808_i64
  ) {
    return x;
  }
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
