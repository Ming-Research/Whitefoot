alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "MSR-3: a placement carries the window's own measures but does not descend through its element positions. The rebind carries the window's length and capacity, so the subscript into the renamed window still discharges, while the element measures an earlier event established die with the consume the rebind performs and the cell exchanged out of that slot arrives with none.";
  let blocks = slots_new::<Box<Slots<u8>>, 2>();
  let first = box_slots_new::<u8>(capacity: 8_u64);
  let second = box_slots_new::<u8>(capacity: 16_u64);
  let third = box_slots_new::<u8>(capacity: 32_u64);
  place_back(window: &blocks, value: move first);
  swap(first: &blocks[0_u64], second: &second);
  let renamed = move blocks;
  swap(first: &renamed[0_u64], second: &third);
  place_back(window: &third.inner, value: 9_u8);
  let seen = third.inner[0_u64];
  if seen == 9_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
