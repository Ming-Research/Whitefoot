alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Sign {
  Neg(mag: i32);
  Zero();
  Pos();
}

fn main() -> status: ExitStatus pure {
  doc "Both OWN-13 scrutinee modes in one program: matching through a reference leaves the value live, then a later own-place match moves it exactly once (no double move); accepts and runs to exit 0.";
  let s = Sign::Pos();
  let b = &s;
  match deref(b) {
    Neg(mag: m) => {
    }
    Zero() => {
    }
    Pos() => {
    }
  }
  match s {
    Neg(mag: n) => {
    }
    Zero() => {
    }
    Pos() => {
    }
  }
  return exit_status(code: 0_u8);
}
