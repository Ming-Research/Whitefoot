struct Row {
  entries: Slots<u64, 4>;
}

fn need(rows: &[Row]) -> result: unit pure contract {
  requires forall wanted(b in 0_u64..rows^.len, k in 0_u64..rows^[b].entries.len): rows^[b].entries[k] == 0_u64;
} {
  return unit;
}

fn forward(rows: &[Row]) -> result: unit pure contract {
  requires forall held(b in 0_u64..rows^.len, k in 0_u64..rows^[b].entries.len): rows^[b].entries[k] == 0_u64;
} {
  need(rows: rows);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
