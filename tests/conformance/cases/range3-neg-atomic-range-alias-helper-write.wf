struct ZeroesAliasHelperBad {
  cells: Array<u64, 1>;
  invariant(c): forall zero(k in 0_u64..c^.cells.len): c^.cells[k] == 0_u64;
}

fn need_aliashelperbad(z: &ZeroesAliasHelperBad) -> result: unit pure {
  return unit;
}

fn overwrite_aliashelperbad(cell: &u64) -> result: unit writes(cell) {
  set cell^ = 1_u64;
  return unit;
}

fn update_aliashelperbad(first: Shared<ZeroesAliasHelperBad>, second: Shared<ZeroesAliasHelperBad>) -> result: unit pure waits {
  atomic a = &first, b = &second {
    overwrite_aliashelperbad(cell: &a^.cells[0_u64]);
    need_aliashelperbad(z: b);
    set a^.cells[0_u64] = 0_u64;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
