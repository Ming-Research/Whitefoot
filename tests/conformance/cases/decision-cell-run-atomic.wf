struct WriteState {
  verdict: DecisionCell;
  byte: u8;
}

fn accept_write(cell: &DecisionCell, target: &u8, byte: u8) -> result: DecisionState reads(cell), writes(target) {
  let winner = claim_written(cell: cell);
  let written = Written();
  if winner == written {
    set target^ = byte;
  }
  return winner;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let cell = decision_cell_new();
  let observer = decision_cell_share(cell: &cell);
  let initial = WriteState(verdict: move cell, byte: 7_u8);
  let shared = shared_new::<WriteState>(value: move initial);
  let written = Written();
  atomic state = &shared {
    let winner = accept_write(cell: &state^.verdict, target: &state^.byte, byte: 7_u8);
    if winner != written {
      return std::process::exit_status(code: 1_u8);
    }
    let visible = decision_cell_read(cell: &observer);
    if visible != written {
      return std::process::exit_status(code: 2_u8);
    }
    let late_kill = claim_killed(cell: &observer);
    if late_kill != written {
      return std::process::exit_status(code: 3_u8);
    }
    if state^.byte != 7_u8 {
      return std::process::exit_status(code: 4_u8);
    }
  }
  let killed_cell = decision_cell_new();
  let killed = Killed();
  let first_kill = claim_killed(cell: &killed_cell);
  if first_kill != killed {
    return std::process::exit_status(code: 5_u8);
  }
  let target = shared_new::<u8>(value: 9_u8);
  atomic byte = &target {
    let winner = accept_write(cell: &killed_cell, target: byte, byte: 12_u8);
    if winner != killed {
      return std::process::exit_status(code: 6_u8);
    }
    if byte^ != 9_u8 {
      return std::process::exit_status(code: 7_u8);
    }
  }
  return std::process::exit_status(code: 0_u8);
}
