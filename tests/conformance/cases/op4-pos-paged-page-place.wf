fn edit_page(values: &Paged<u64>, page_index: u64, slot: u64) -> value: u64 writes(values) {
  doc "Read and write one element through a direct initialized page place.";
  if page_index < values^.pages.len {
    if slot < values^.pages[page_index].len {
      let before = values^.pages[page_index][slot];
      set values^.pages[page_index][slot] = before +wrap 5_u64;
      return values^.pages[page_index][slot];
    }
  }
  return 0_u64;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Direct page lengths track current extents while a borrowed page retains its captured length.";
  let storage = box_paged_new::<u64>(capacity: 3_u64);
  place_back(window: &storage.inner, value: 7_u64);
  let captured = &storage.inner.pages[0_u64];
  if storage.inner.pages[0_u64].len != 1_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  place_back(window: &storage.inner, value: 11_u64);
  if captured^.len != 1_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  if storage.inner.pages[0_u64].len != 2_u64 {
    return std::process::exit_status(code: 3_u8);
  }
  let changed = edit_page(values: &storage.inner, page_index: 0_u64, slot: 1_u64);
  if changed != 16_u64 {
    return std::process::exit_status(code: 4_u8);
  }
  if storage.inner.pages.len != 1_u64 {
    return std::process::exit_status(code: 8_u8);
  }
  if storage.inner.len != 2_u64 {
    return std::process::exit_status(code: 9_u8);
  }
  let borrowed = &storage.inner.pages[0_u64];
  if borrowed^.len != 2_u64 {
    return std::process::exit_status(code: 5_u8);
  }
  if borrowed^[1_u64] != 16_u64 {
    return std::process::exit_status(code: 6_u8);
  }
  set storage.inner.pages[0_u64][0_u64] = 19_u64;
  if storage.inner[0_u64] != 19_u64 {
    return std::process::exit_status(code: 7_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
