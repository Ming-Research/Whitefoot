fn weigh(factory: &std::io::HandleFactory, directory: std::fs::DirectoryRead, weight: u8) -> result: u8 writes(factory) waits {
  std::fs::close_directory(factory: factory, directory: move directory);
  return weight;
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  let std::process::Inputs(args: unused_args, cwd: cwd, stdout: unused_stdout, stderr: unused_stderr, handles: handles, stdin: unused_stdin) = move inputs;
  let weight = mustpar weigh(factory: &handles, directory: move cwd, weight: 7_u8);
  return std::process::exit_status(code: weight);
}
