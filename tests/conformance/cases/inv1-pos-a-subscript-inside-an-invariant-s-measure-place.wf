alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "INV-1, MSR-1: an affine factor's measure place is formed with subscripts as well as field selections, under the enclosing concrete instance and at the enclosing loop depth. The header invariant below measures one element of a window of windows, and MSR-2's standing ordering over that element's own measures is what discharges it.";
  let inner = slots_new::<u8, 4>();
  let table = slots_new::<Slots<u8, 4>, 2>();
  place_back(window: &table, value: move inner);
  let grid = move table;
  let seen = 0_u8;
  for @scan (
    at in 0_u64..1_u64,
    invariant flat: grid[0_u64].len <= grid[0_u64].cap
  ) {
    set seen = 1_u8;
  }
  if seen == 1_u8 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
