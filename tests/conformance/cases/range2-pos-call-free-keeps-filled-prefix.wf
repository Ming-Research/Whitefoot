fn need_prefix(destination: &Slots<u64, 8>, count: u64) -> result: unit pure contract {
  requires forall small_prefix(k in 0_u64..count): destination^[k] <= 7_u64;
} {
  return unit;
}

fn probe(destination: &Slots<u64, 8>, source: &Slots<u64, 8>) -> result: unit writes(destination.free), writes(destination.len), writes(source.filled), writes(source.len) contract {
  requires forall held_prefix(k in 0_u64..destination^.len): destination^[k] <= 7_u64;
  requires source^.len <= destination^.cap - destination^.len;
} {
  doc "WIN-2 separates the filled destination prefix from append's destination.free write; RANGE-2 retains the old prefix facts despite the changed length.";
  let old_count = destination^.len;
  append(destination: destination, source: source);
  need_prefix(destination: destination, count: old_count);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
