alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "Storage class is a function of type [STOR-1]: an i32 local is frame-resident with no per-binding storage annotation and no default clause; its sum is the exit status 10.";
  let a = 7_i32;
  let b = a +wrap 3_i32;
  let code = cvt::<i32, u8>(b);
  return exit_status(code: code);
}
