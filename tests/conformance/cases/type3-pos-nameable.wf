alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Color {
  Red();
  Green();
  Blue();
}

fn paint(x: &i32, y: &i32) -> function_result: Color pure {
  doc "Each type and parameter kind has a finite canonical source spelling requiring no compiler execution; the type and reference marker determine the kind.";
  return Color::Red();
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
