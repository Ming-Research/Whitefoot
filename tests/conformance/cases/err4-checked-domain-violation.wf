alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn opaque_value(value: i32) -> result: i32 pure {
  return value;
}

fn main() -> status: ExitStatus pure {
  doc "Representability failure is an expected typed value [ERR-4]. The checked operation returns Err on i32 max plus one and ordinary control reports successful handling.";
  let peak = opaque_value(value: 2147483647_i32);
  let step = opaque_value(value: 1_i32);
  match peak +checked step {
    Ok(value: sum) => {
      return exit_status(code: 1_u8);
    }
    Err(error: overflow) => {
      return exit_status(code: 0_u8);
    }
  }
}
