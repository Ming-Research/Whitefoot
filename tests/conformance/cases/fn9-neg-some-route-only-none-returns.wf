alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn never(data: &[u8]) -> result: Option<u64> reads(data) contract {
  ensures when Some(value: found): found < data^.len;
} {
  doc "A direct None is unselected, not unreachable [FN-9]: a Some clause whose function returns only None has an empty selected-return set and is refused.";
  return None<u64>();
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
