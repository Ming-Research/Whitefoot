alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Pair {
  Both(left: u64, right: u64);
}

fn observe(cell: &u64) -> result: u64 reads(cell) contract {
  ensures result == deref(cell);
} {
  return deref(cell);
}

fn expect_equal(cell: &u64, seen: u64) -> result: unit reads(cell) contract {
  requires deref(cell) == seen;
} {
  let sampled = deref(cell);
  return unit;
}

fn inspect(pair: &Pair) -> result: unit reads(pair) {
  match deref(pair) {
    Both(left: l, right: r) => {
      let observed = observe(cell: l);
      expect_equal(cell: r, seen: observed);
      return unit;
    }
  }
}

fn main() -> status: ExitStatus pure {
  let pair = Pair::Both(left: 1_u64, right: 0_u64);
  inspect(pair: &pair);
  return exit_status(code: 0_u8);
}
