alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias write_once = std::io::write_once;

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "The ordinary write_once requirement refuses a literal end past the source range length before any host transfer [FN-8, PRE-2].";
  let Inputs(args: unused_args, cwd: unused_cwd, stdout: out, stderr: unused_stderr, handles: entry_factory, stdin: unused_stdin) = move inputs;
  let closed = close_directory(factory: &entry_factory, directory: move unused_cwd);
  let bytes = array_filled::<u8, 4>(value: 65_u8);
  let part = &bytes[0_u64..4_u64];
  match write_once(factory: &entry_factory, output: &out, source: part, start: 1_u64, end: 9_u64) {
    Ok(value: written) => {
      return exit_status(code: 10_u8);
    }
    Err(error: problem) => {
      return exit_status(code: 20_u8);
    }
  }
}
