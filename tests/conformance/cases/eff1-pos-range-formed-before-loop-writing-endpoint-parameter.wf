alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn clear(part: &[u64]) -> result: unit writes(part) {
  doc "Writes 9 to every element of the range part names.";
  let i = 0_u64;
  loop {
    if deref(part).len <= i {
      break;
    }
    set deref(part)[i] = 9_u64;
    set i = i +wrap 1_u64;
  }
  return unit;
}

fn write_run(window: &Slots<u64, 4>, lo: u64, hi: u64) -> result: unit writes(window[lo..hi]) contract {
  requires lo <= hi;
  requires hi <= deref(window).len;
} {
  doc "Clears the run from lo to hi on every iteration of a loop that writes lo.";
  let part = &deref(window)[lo..hi];
  let n = 0_u64;
  loop {
    clear(part: part);
    if 1_u64 <= n {
      break;
    }
    set n = n +wrap 1_u64;
    set lo = 0_u64;
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "EFF-1, REF-4: the loop form of eff1-pos-range-formed-before-endpoint-parameter-write. part captured the call values of lo and hi before the loop, so every iteration's write through part is the row's window[lo..hi], though the loop writes lo.";
  let r = slots_new::<u64, 4>();
  place_back(window: &r, value: 1_u64);
  place_back(window: &r, value: 2_u64);
  let p = &r[0_u64];
  write_run(window: &r, lo: 1_u64, hi: 2_u64);
  let seen = deref(p);
  if seen == 1_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
