alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const values: Array<u64, 8> =[1_u64, 2_u64, 3_u64, 4_u64, 5_u64, 6_u64, 7_u64, 8_u64];

fn window_sum(start: u64, end: u64) -> result: u64 pure contract {
  requires start <= end;
  requires end <= 8_u64;
} {
  doc "An index expression inside a path is evaluated when the reference is formed, so assigning to the binding that supplied an endpoint cannot retarget the range [REF-1, OWN-7].";
  let view = &values[start..end];
  set start = end;
  let count = deref(view).len;
  let total = 0_u64;
  for (i in 0_u64..count) {
    let value = deref(view)[i];
    set total = total +wrap value;
  }
  return total;
}

fn main() -> status: ExitStatus pure {
  doc "A range reference captures its endpoints before the source binding changes; middle and empty windows retain their lengths and contents.";
  let middle = window_sum(start: 2_u64, end: 5_u64);
  let empty = window_sum(start: 8_u64, end: 8_u64);
  if middle != 12_u64 {
    return exit_status(code: 1_u8);
  }
  if empty != 0_u64 {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
