alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy struct Row {
  left: u64;
  right: u64;
}

fn main() -> status: ExitStatus pure {
  doc "Moving the owner is now an ordinary consuming use; it invalidates every reference formed from it, and the later use of that reference is the rejection.";
  let row0 = Row(left: 3_u64, right: 4_u64);
  let row1 = Row(left: 3_u64, right: 4_u64);
  let row2 = Row(left: 3_u64, right: 4_u64);
  let row3 = Row(left: 3_u64, right: 4_u64);
  let slots = slots_new::<Row, 4>();
  place_back(window: &slots, value: move row0);
  place_back(window: &slots, value: move row1);
  place_back(window: &slots, value: move row2);
  place_back(window: &slots, value: move row3);
  let rows = slots_into_array::<Row, 4>(values: move slots);
  let saved = &rows[0_u64];
  let moved = move rows;
  let observed = deref(saved).left;
  return exit_status(code: 0_u8);
}
