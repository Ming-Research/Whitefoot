fn one(depth: u64) -> done: u64 pure contract {
  ensures done == 1_u64;
} {
  if depth > 0_u64 {
    let next = depth - 1_u64;
    let inner = one(depth: next);
    return inner;
  }
  return 1_u64;
}

fn main() -> status: std::process::ExitStatus pure {
  let base = one(depth: 0_u64);
  let nested = one(depth: 3_u64);
  return std::process::exit_status(code: 0_u8);
}
