fn helper(source: &Slots<u64, 4>, target: &Slots<u64, 4>, i: u64) -> result: unit writes(target[i]) contract {
  requires source^.len == 1_u64;
  requires target^.len == 1_u64;
  requires i == 0_u64;
} {
  set target^[i] = 1_u64;
  return unit;
}

fn caller() -> result: unit pure {
  let values = slots_new::<u64, 4>();
  place_back(window: &values, value: 0_u64);
  helper(source: &values, target: &values, i: 0_u64);
  return unit;
}
