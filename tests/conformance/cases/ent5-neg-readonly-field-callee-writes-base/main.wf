alias Entry = pkg::kinds::Entry;
alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias kinds = pkg::kinds;

fn widen(xs: &Array<Entry, 4>, i: u64) -> result: unit writes(xs) contract {
  requires i < 4_u64;
} {
  doc "The row writes the whole referent; replacing one element is the only change the readonly field admits.";
  let wide = kinds::make_entry(width: 8_u64, weight: 1_u64);
  set deref(xs)[i] = wide;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "ENT-5, EFF-2: the call's projected write reaches the storage of entries[1].width, so the guard's bound dies at the call; the endpoint reads the widened element and the cell read owes an unproved c < cells.len.";
  let narrow = kinds::make_entry(width: 3_u64, weight: 1_u64);
  let entries = array_filled::<Entry, 4>(value: narrow);
  let cells = array_filled::<u8, 3>(value: 7_u8);
  let total = 0_u64;
  if entries[1_u64].width <= cells.len {
    widen(xs: &entries, i: 1_u64);
    for (c in 0_u64..entries[1_u64].width) {
      let cell = cells[c];
      let widened = cvt::<u8, u64>(cell);
      set total = total +wrap widened;
    }
  }
  return exit_status(code: 0_u8);
}
