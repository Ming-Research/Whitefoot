alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn split(taken: Slots<u8, 8>) -> (kept: u64, spare: u64) pure contract {
  ensures kept == taken.len;
  ensures spare == taken.len;
} {
  doc "Two results, each related to the measure of the run this call consumed.";
  let measured = taken.len;
  return measured, measured;
}

fn needs_eight(bound: u64) -> ok: unit pure contract {
  requires 8_u64 <= bound;
} {
  doc "Needs a caller proof about its argument.";
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "A two-result contract reaches both binders of a destructuring let, and each binder discharges a later requirement from its own ordinal's relation.";
  let run = slots_new::<u8, 8>();
  for @fill (
    at in 0_u64..8_u64,
    invariant grown: run.len >= at,
    invariant vacancy: run.cap - run.len + at >= 8_u64
  ) {
    place_back(window: &run, value: 0_u8);
  }
  let (kept, spare) = split(taken: move run);
  let first = needs_eight(bound: kept);
  let second = needs_eight(bound: spare);
  return exit_status(code: 0_u8);
}
