fn record(maps: &Array<Shared<ConcurrentHashMap<u64>>, 2>, i: u64, j: u64, key: &[u8]) -> result: unit reads(maps), reads(key) waits contract {
  requires i < 2_u64;
  requires j < 2_u64;
} {
  let counted = 0_u64;
  atomic whole = &maps^[i], keyed = &maps^[j][key] {
    set counted = map_count::<u64>(map: whole);
    set keyed^ = Some<u64>(value: counted);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
