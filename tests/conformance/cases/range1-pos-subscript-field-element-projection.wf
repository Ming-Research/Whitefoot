struct Decimal {
  count: u64;
  digits: Array<u8, 1>;
}

fn need_one(digit: u8) -> result: unit pure contract {
  requires 1_u8 <= digit;
} {
  return unit;
}

fn inspect(decimals: &Array<Decimal, 1>) -> result: unit reads(decimals) contract {
  requires forall leading(k in 0_u64..1_u64) when 0_u64 < decimals^[k].count: 1_u8 <= decimals^[k].digits[0_u64];
} {
  doc "A field below a subscript is an existing element projection, rather than an ENT-6 tracked field atom.";
  if 0_u64 < decimals^[0_u64].count {
    let digit = decimals^[0_u64].digits[0_u64];
    need_one(digit: digit);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
