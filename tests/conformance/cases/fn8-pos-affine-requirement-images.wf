alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn headroom(a: u64, b: u64, limit: u64) -> result: u64 pure contract {
  requires a + b <= limit;
  requires a <= 16_u64;
  requires b <= 16_u64;
} {
  doc "An admitted non-L0 ordering requirement supplies its captured affine image; the body uses the operands in reversed order and subtracts their sum. The binder is no longer spelled `room`, which is reserved from every declaration role [FORM-3, TYPE-10].";
  let total = b + a;
  let remaining = limit - total;
  return remaining;
}

fn main() -> status: ExitStatus pure {
  let value = headroom(a: 3_u64, b: 5_u64, limit: 11_u64);
  if value != 3_u64 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
