alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  let count_a = 0_u32;
  for (
    i in 0_u64..3_u64,
    invariant bound_a: count_a <= 1000000000_u32 * i
  ) {
    set count_a = count_a + 1000000000_u32;
  }
  let count_b = 0_u32;
  for (
    j in 0_u64..3_u64,
    invariant bound_b: count_b <= 1000000000_u32 * j
  ) {
    set count_b = count_b + 1000000000_u32;
  }
  let total = count_a + count_b;
  return exit_status(code: 0_u8);
}
