alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn loopy2(limit: u8, bump: u8) -> result: u8 pure contract {
  requires limit <= 5_u8;
} {
  let cursor = 0_u8;
  let lim = limit;
  loop (
    invariant bounded: cursor <= lim
  ) {
    let remaining = cursor < lim;
    if remaining {
      invariant guarded: cursor < lim;
      set cursor = cursor +wrap 1_u8;
      set lim = bump;
    } else {
      break;
    }
  }
  return cursor;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
