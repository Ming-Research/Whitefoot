struct Index {
  value: u64;
  invariant bounded(index): index.value < 16_u64;
}

struct State {
  items: Array<Index, 4>;
  single: Index;
}

fn lookup(index: &Index) -> result: u64 reads(index) {
  let got = index^.value;
  return got;
}

fn peek(state: Shared<State>, at: u64) -> result: u64 pure waits contract {
  requires at < 4_u64;
} {
  let got = 0_u64;
  atomic s = &state {
    set got = lookup(index: &s^.items[at]);
  }
  return got;
}
