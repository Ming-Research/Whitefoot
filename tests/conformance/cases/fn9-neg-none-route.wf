alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn nothing(limit: u64) -> result: Option<u64> pure contract {
  ensures when None(value: gone): gone < limit;
} {
  doc "A route must name a declared field whose type supplies data [FN-9]: None declares no value field, so the route is refused.";
  return None<u64>();
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
