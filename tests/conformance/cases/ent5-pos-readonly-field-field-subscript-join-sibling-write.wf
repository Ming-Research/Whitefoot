struct Cursor {
  k: u64;
  other: u64;
}

fn select(table: &[Slots<u8, 8>], s: &Cursor, i: u64, change: Bool) -> result: u8 reads(table), reads(s.k), writes(s.other) contract {
  requires s^.k < table^.len;
} {
  doc "ENT-5: one reaching branch writes only a disjoint sibling field, so every join input retains the same selected row's length bound.";
  if i < table^[s^.k].len {
    if change {
      set s^.other = 0_u64;
    }
    if s^.k < table^.len {
      return table^[s^.k][i];
    }
  }
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The body must retain the guarded inner bound through the disjoint write.";
  return std::process::exit_status(code: 0_u8);
}
