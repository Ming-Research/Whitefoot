alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn only<T: drop>(value: T) -> made: Slots<T, 4> pure contract {
  ensures made.len >= 1_u64;
} {
  doc "Builds a run of one element at an unbounded element type.";
  let built = slots_new::<T, 4>();
  place_back(window: &built, value: move value);
  return move built;
}

fn main() -> status: ExitStatus pure {
  doc "A shape's element type is any nameable type, an unbounded type parameter included, which FN-2 resolves at every concrete instance; neither placement inherits a flat-element restriction.";
  let payload = Some<u8>(value: 5_u8);
  let run = only::<Option<u8>>(value: payload);
  let held = run.len;
  if held == 1_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let taken = take_back(window: &run);
  match taken {
    Some(value: got) => {
      if got == 5_u8 {
        return exit_status(code: 0_u8);
      }
      return exit_status(code: 2_u8);
    }
    None() => {
      return exit_status(code: 3_u8);
    }
  }
}
