enum Op {
  Set(v: u64);
  Keep();
  Halt();
}

fn run(code: &Box<Slots<Op>>, limit: u64) -> r: u64 reads(code) {
  doc "The replacing branch runs exactly when the payload exceeds the bound, so its induction input cannot prove the header relation.";
  let pc = 0_u64;
  let x = 0_u64;
  if pc < code^.inner.len {
    loop (
      invariant xb: x <= limit
    ) {
      match code^.inner[pc] {
        Set(v: vv) => {
          if vv^ <= limit {
            return x;
          } else {
            set x = vv^;
          }
        }
        Keep() => {
        }
        Halt() => {
          return x;
        }
      }
    }
  }
  return x;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Checks the source relation without executing the probe.";
  return std::process::exit_status(code: 0_u8);
}
