alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn peek(value: &i32) -> result: i32 reads(value) {
  doc "A reference carries no region, no permission marker and no other qualifier: the declaration writes `&i32` and nothing else, and whether the callee may write is stated by the row alone [REF-1, EFF-1, GRAM-5].";
  return deref(value);
}

fn main() -> status: ExitStatus pure {
  doc "The composed spellings run: a `&` borrow expression, a reference-kind local naming that path, a call passing it, and a read of the referent through `deref`. No region block, region name or type application appears anywhere.";
  let a = 40_i32;
  let p = &a;
  let v = peek(value: p);
  if v == 40_i32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
