enum Flow {
  Open(block: u64);
  Close(block: u64);
}

fn guarded<T: copy>(targets: &[T], value: T) -> result: unit pure contract {
  requires forall same(k in 0_u64..targets^.len) when targets^[k] == value: targets^[k] == value;
} {
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let targets = array_filled::<Flow, 1>(value: Flow::Open(block: 3_u64));
  guarded::<Flow>(targets: &targets[0_u64..1_u64], value: Flow::Open(block: 3_u64));
  guarded::<Flow>(targets: &targets[0_u64..1_u64], value: Flow::Close(block: 4_u64));
  return std::process::exit_status(code: 0_u8);
}
