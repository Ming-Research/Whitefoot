alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "The other arm of the same branch. On the arm on which no window operation ran, the run the writer holds is exactly the run it held before the branch: nothing was published there and the measures already established stand, so the placement that follows discharges its own free-slots requirement from them.";
  let run = slots_new::<u8, 4>();
  let full = run.len == run.cap;
  if full {
    return exit_status(code: 1_u8);
  }
  place_back(window: &run, value: 3_u8);
  let held = run.len;
  if held == 1_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
