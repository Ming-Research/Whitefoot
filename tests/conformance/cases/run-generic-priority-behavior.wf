alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Item {
  rank: u64;
}

struct Ascending {
}

fn ascending_compare(env: &Ascending, left: &Item, right: &Item) -> order: i32 reads(left.rank), reads(right.rank) contract {
  ensures order >= -1_i32;
  ensures order <= 1_i32;
} {
  doc "A reference parameter denotes the reference, so the compared fields are reached through deref.";
  if deref(left).rank < deref(right).rank {
    return -1_i32;
  }
  if deref(left).rank > deref(right).rank {
    return 1_i32;
  }
  return 0_i32;
}

interface Order<T, E> {
  fn compare(env: &E, left: &T, right: &T) -> order: i32 reads(env), reads(left), reads(right) contract {
    ensures order >= -1_i32;
    ensures order <= 1_i32;
  };
}

struct Queue<interface Order<T, E>> {
  heap: Slots<T, 16>;
}

binding ItemOrder : Order<Item, Ascending> {
  compare = ascending_compare;
}

fn exchange_at<T>(heap: &Slots<T, 16>, left: u64, right: u64) -> result: unit writes(heap) contract {
  requires left < deref(heap).len;
  requires right < deref(heap).len;
  ensures deref(heap).len == deref(entry(heap)).len;
  ensures deref(heap).cap == deref(entry(heap)).cap;
} {
  doc "swap is the one operation whose two reference arguments may name the same place, so no left-equals-right branch is needed and no temporary hole ever exists.";
  swap(first: &deref(heap)[left], second: &deref(heap)[right]);
  return unit;
}

fn sift_rise<interface Order<T, E>>(queue: &Queue<Order<T, E>>, count: u64, env: &E) -> result: unit reads(env), writes(queue.heap) contract {
  requires deref(queue).heap.len == count;
  requires count >= 1_u64;
  ensures deref(queue).heap.len == count;
  ensures deref(queue).heap.cap == deref(entry(queue)).heap.cap;
} {
  doc "The header carries the position bound and both window measures across every backedge.";
  let at = count - 1_u64;
  loop @rise (
    invariant live: at < count,
    invariant count_low: deref(queue).heap.len >= count,
    invariant count_high: deref(queue).heap.len <= count,
    invariant cap_low: deref(queue).heap.cap >= 16_u64,
    invariant cap_high: deref(queue).heap.cap <= 16_u64
  ) {
    if at == 0_u64 {
      return unit;
    }
    let before = at - 1_u64;
    let parent = before / 2_u64;
    let order = Order::compare(env: env, left: &deref(queue).heap[parent], right: &deref(queue).heap[at]);
    if order <= 0_i32 {
      return unit;
    }
    exchange_at::<T>(heap: &deref(queue).heap, left: parent, right: at);
    set at = parent;
  }
  return unit;
}

fn sift_sink<interface Order<T, E>>(queue: &Queue<Order<T, E>>, count: u64, env: &E) -> result: unit reads(env), writes(queue.heap) contract {
  requires deref(queue).heap.len == count;
  requires count >= 1_u64;
  ensures deref(queue).heap.len == count;
  ensures deref(queue).heap.cap == deref(entry(queue)).heap.cap;
} {
  doc "The same header, walking down instead of up.";
  let at = 0_u64;
  loop @sink (
    invariant live: at < count,
    invariant count_low: deref(queue).heap.len >= count,
    invariant count_high: deref(queue).heap.len <= count,
    invariant cap_low: deref(queue).heap.cap >= 16_u64,
    invariant cap_high: deref(queue).heap.cap <= 16_u64
  ) {
    let doubled = at * 2_u64;
    let left = doubled + 1_u64;
    if left >= count {
      return unit;
    }
    let best = left;
    let right = left + 1_u64;
    if right < count {
      let sibling_order = Order::compare(env: env, left: &deref(queue).heap[right], right: &deref(queue).heap[left]);
      if sibling_order < 0_i32 {
        set best = right;
      }
    }
    let order = Order::compare(env: env, left: &deref(queue).heap[at], right: &deref(queue).heap[best]);
    if order <= 0_i32 {
      return unit;
    }
    exchange_at::<T>(heap: &deref(queue).heap, left: at, right: best);
    set at = best;
  }
  return unit;
}

fn push<interface Order<T, E>>(queue: &Queue<Order<T, E>>, value: T, env: &E) -> result: unit reads(env), writes(queue.heap) contract {
  requires 1_u64 <= deref(queue).heap.cap - deref(queue).heap.len;
  ensures deref(queue).heap.len == deref(entry(queue)).heap.len + 1_u64;
} {
  doc "An owned scalar or owner enters the window and then rises into place.";
  let entering = deref(queue).heap.len;
  let count = entering + 1_u64;
  place_back(window: &deref(queue).heap, value: move value);
  sift_rise::<Order<T, E>>(queue: queue, count: count, env: env);
  return unit;
}

fn pop<interface Order<T, E>>(queue: &Queue<Order<T, E>>, env: &E) -> minimum: T reads(env), writes(queue.heap) contract {
  requires deref(queue).heap.len >= 1_u64;
  ensures deref(queue).heap.len == deref(entry(queue)).heap.len - 1_u64;
} {
  doc "The tail is taken out and exchanged with the root by swap, so no slot is ever empty inside the window.";
  let last = take_back(window: &deref(queue).heap);
  let count = deref(queue).heap.len;
  if count == 0_u64 {
    return move last;
  }
  let minimum = move last;
  swap(first: &deref(queue).heap[0_u64], second: &minimum);
  sift_sink::<Order<T, E>>(queue: queue, count: count, env: env);
  return move minimum;
}

struct Direction {
  descending: Bool;
}

fn word_compare(env: &Ascending, left: &u64, right: &u64) -> order: i32 reads(left), reads(right) contract {
  ensures order >= -1_i32;
  ensures order <= 1_i32;
} {
  doc "Scalar elements compared through deref reads.";
  if deref(left) < deref(right) {
    return -1_i32;
  }
  if deref(left) > deref(right) {
    return 1_i32;
  }
  return 0_i32;
}

fn directed_compare(env: &Direction, left: &Item, right: &Item) -> order: i32 reads(env.descending), reads(left.rank), reads(right.rank) contract {
  ensures order >= -1_i32;
  ensures order <= 1_i32;
} {
  doc "A stateful comparison whose environment path is declared beside the two element paths.";
  if deref(left).rank < deref(right).rank {
    if deref(env).descending {
      return 1_i32;
    }
    return -1_i32;
  }
  if deref(left).rank > deref(right).rank {
    if deref(env).descending {
      return -1_i32;
    }
    return 1_i32;
  }
  return 0_i32;
}

binding WordOrder : Order<u64, Ascending> {
  compare = word_compare;
}

binding DirectedOrder : Order<Item, Direction> {
  compare = directed_compare;
}

fn empty_heap<T>() -> heap: Slots<T, 16> pure contract {
  ensures heap.len == 0_u64;
} {
  doc "A constant-capacity window starts empty.";
  let made = slots_new::<T, 16>();
  return move made;
}

fn priority_round(seed: u64, entering: u64) -> (checksum: u64, next_state: u64) pure {
  doc "Sixteen pseudorandom words enter the queue and leave it in order; the local queue is frame state, so the row stays empty.";
  let checksum = entering;
  let state = seed;
  let heap = empty_heap::<u64>();
  let queue = Queue<WordOrder>(heap: move heap);
  let env = Ascending();
  for (
    index in 0_u64..16_u64,
    invariant grown: queue.heap.len >= index,
    invariant spare: queue.heap.cap - queue.heap.len + index >= 16_u64
  ) {
    let product = state *wrap 6364136223846793005_u64;
    set state = product +wrap 1442695040888963407_u64;
    let value = state % 97_u64;
    push::<WordOrder>(queue: &queue, value: value, env: &env);
  }
  for (
    index in 0_u64..16_u64,
    invariant remaining: queue.heap.len + index >= 16_u64
  ) {
    let value = pop::<WordOrder>(queue: &queue, env: &env);
    let product = checksum *wrap 1099511628211_u64;
    set checksum = product +wrap value;
  }
  return checksum, state;
}

fn priority_trace(seed: u64, rounds: u64) -> checksum: u64 pure {
  doc "One commit per statement, so a round's two results are bound together and then committed separately.";
  let checksum = 0_u64;
  let state = seed;
  for (round in 0_u64..rounds) {
    let (produced, advanced) = priority_round(seed: state, entering: checksum);
    set checksum = produced;
    set state = advanced;
  }
  return checksum;
}

fn directed_demo() -> result: u8 pure {
  doc "The second instantiation, whose comparison reads its own environment.";
  let heap = empty_heap::<Item>();
  let queue = Queue<DirectedOrder>(heap: move heap);
  let descending = True();
  let env = Direction(descending: descending);
  let first = Item(rank: 9_u64);
  let second = Item(rank: 2_u64);
  let third = Item(rank: 7_u64);
  push::<DirectedOrder>(queue: &queue, value: first, env: &env);
  push::<DirectedOrder>(queue: &queue, value: second, env: &env);
  push::<DirectedOrder>(queue: &queue, value: third, env: &env);
  let high = pop::<DirectedOrder>(queue: &queue, env: &env);
  let middle = pop::<DirectedOrder>(queue: &queue, env: &env);
  let low = pop::<DirectedOrder>(queue: &queue, env: &env);
  if high.rank != 9_u64 {
    return 1_u8;
  }
  if middle.rank != 7_u64 {
    return 2_u8;
  }
  if low.rank != 2_u64 {
    return 3_u8;
  }
  return 0_u8;
}

fn main() -> status: ExitStatus pure {
  doc "Both generic instantiations execute; an owned scalar supplied to a local window contributes no enclosing effect path, while the environment and window paths retain their actual accesses.";
  let code = directed_demo();
  if code != 0_u8 {
    return exit_status(code: code);
  }
  let trace = priority_trace(seed: 1_u64, rounds: 1_u64);
  if trace != 16743229412097926756_u64 {
    return exit_status(code: 4_u8);
  }
  return exit_status(code: 0_u8);
}
