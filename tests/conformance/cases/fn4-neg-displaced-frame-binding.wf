interface Advance {
  fn advance(slot: &u64) -> result: unit writes(slot) contract {
    ensures slot^ == entry(slot)^ + 1_u64;
  };
}

fn stay(actual_slot: &u64) -> stayed: unit pure {
  return unit;
}

binding NoAdvance : Advance {
  advance = stay;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
