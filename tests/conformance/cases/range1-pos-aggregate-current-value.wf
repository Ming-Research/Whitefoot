struct Block {
  slot: u32;
}

fn probe<T: copy>(value: T, other: T) -> result: unit pure {
  set value = other;
  let cells = array_filled::<T, 1>(value: value);
  loop (
    invariant forall same(k in 0_u64..cells.len): cells[k] == value
  ) {
    break;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let first = Block(slot: 0_u32);
  let other = Block(slot: 1_u32);
  probe::<Block>(value: first, other: other);
  return std::process::exit_status(code: 0_u8);
}
