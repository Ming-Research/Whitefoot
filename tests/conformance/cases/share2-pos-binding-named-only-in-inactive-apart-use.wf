fn probe<T: copy>(value: T) -> result: u8 pure waits contract {
  requires forall reflexive(q in 0_u64..1_u64): value <= value;
} {
  let keys = key_set_new(capacity: 1_u64);
  let store = shared_new::<KeySet>(value: move keys);
  atomic t = &store {
    for (
      i in 0_u64..1_u64,
      apart(first, second) {
        use reflexive(t^.len);
      }
    ) {
      let count = i;
    }
  }
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let value = True();
  let code = probe::<Bool>(value: value);
  return std::process::exit_status(code: code);
}
