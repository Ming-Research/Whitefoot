alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn answer(value: i32) -> result: unit pure contract {
  requires value == 42_i32;
} {
  return unit;
}

fn main() -> return_value: ExitStatus pure {
  doc "Op names carry a domain prefix and a .mode suffix iff on a mode axis [OP-7]: ineg.checked (i-prefix, checked mode), while value equality `==` is a prefix-free operator over equality types. The checked sum is the exit status 42.";
  let r = match 40_i32 +checked 2_i32 {
    Ok(value: v) => {
      give v;
    }
    Err(error: e) => {
      return exit_status(code: 1_u8);
    }
  }
  let confirmed = answer(value: r);
  let code = cvt::<i32, u8>(r);
  return exit_status(code: code);
}
