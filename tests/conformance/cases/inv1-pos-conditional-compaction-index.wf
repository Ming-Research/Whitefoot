alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn compact(buf: &[u8]) -> result: u64 writes(buf) {
  doc "The sum<=i header proves each conditional destination index below the current input binder.";
  let n = deref(buf).len;
  let sum = 0_u64;
  for (
    i in 0_u64..n,
    invariant sum_bound: sum <= i
  ) {
    let byte = deref(buf)[i];
    let keep = byte >= 128_u8;
    if keep {
      set deref(buf)[sum] = byte;
      set sum = sum + 1_u64;
    }
  }
  return sum;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
