fn copy_first(from: &Run<u64>, into: &Run<u64>) -> result: unit reads(from), writes(into) contract {
  requires from^.len > 0_u64;
  requires into^.len > 0_u64;
} {
  set into^[0_u64] = from^[0_u64];
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let p = box_paged_new::<u64>(capacity: 2_u64);
  place_back(window: &p.inner, value: 31_u64);
  place_back(window: &p.inner, value: 0_u64);
  copy_first(from: &p.inner[0_u64..1_u64], into: &p.inner[1_u64..2_u64]);
  if p.inner[1_u64] != 31_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
