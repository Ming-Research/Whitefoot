alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Row {
  left: u64;
  right: u64;
}

fn store(rows: &Array<Row, 4>, value: u64) -> result: unit reads(rows) {
  doc "An index and a field inherit the writability of their selected base, and a reference parameter whose row declares only reads supplies none.";
  set deref(rows)[0_u64].left = value;
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
