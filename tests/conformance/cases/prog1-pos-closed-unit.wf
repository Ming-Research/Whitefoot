alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn helper(x: i32) -> return_value: i32 pure {
  doc "In-unit helper; every callee name is defined within this compilation unit. Explicit wrapping arithmetic makes the helper total so this case isolates closed-world resolution.";
  return x +wrap 1_i32;
}

fn main() -> return_value: ExitStatus pure {
  doc "PROG-1 closed world: helper is defined in-unit, `==`/True are the prelude+table; no import/extern/dynamic-load construct exists to reach outside the unit.";
  let a = 6_i32;
  let b = helper(x: a);
  if b == 7_i32 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
