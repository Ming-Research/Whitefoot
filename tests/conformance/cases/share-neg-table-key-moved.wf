struct Store {
  map: KeyedTable<u8>;
}

const names: Array<u8, 2> =[97_u8, 98_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let table = keyed_table_new::<u8>(capacity: 0_u64);
  let state = Store(map: move table);
  let store = shared_new::<Store>(value: move state);
  let keys = key_set_new(capacity: 1_u64);
  key_set_insert(keys: &keys, key: &names[0_u64..1_u64]);
  atomic s = &store, entries = &s^.map[move keys] {
    set entries^[0_u64] = Some<u8>(value: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
