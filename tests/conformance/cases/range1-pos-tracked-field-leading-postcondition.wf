struct Decimal {
  count: u64;
  digits: Array<u8, 1>;
}

fn establish(decimal: &Decimal) -> result: unit writes(decimal.digits), reads(decimal.count) contract {
  ensures forall leading(k in 0_u64..1_u64) when 0_u64 < decimal^.count: 1_u8 <= decimal^.digits[k];
} {
  doc "The postcondition guard reads the current tracked count field, and the written digit establishes its conclusion.";
  set decimal^.digits[0_u64] = 1_u8;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
