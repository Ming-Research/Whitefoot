alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn mutate(x: &u64) -> function_result: unit pure {
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "Modes are exact and there is no implicit borrow: an own binding does not satisfy a reference parameter, whose argument is written with the borrow form.";
  let value = 0_u64;
  mutate(x: value);
  return exit_status(code: 0_u8);
}
