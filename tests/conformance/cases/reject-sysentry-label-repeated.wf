alias Args = std::text::Args;
alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main(args: Args, again: Args) -> status: ExitStatus pure {
  doc "FN-7: two ordinary parameters may have the same nominal type. They are separate owned values with distinct binder names.";
  return exit_status(code: 0_u8);
}
