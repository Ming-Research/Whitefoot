alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Pair<T: copy> {
  left: T;
  right: T;
}

struct Packet<T: copy, const n: u64> {
  tag: u8;
  values: Array<T, n>;
}

const count: u64 = 2_u64;

const small: Pair<u8> = Pair<u8>(left: 5_u8, right: 7_u8);

const packet: Packet<Pair<u64>, count> = Packet<Pair<u64>, count>(tag: 11_u8, values:[Pair<u64>(left: 13_u64, right: 17_u64), Pair<u64>(left: 19_u64, right: 23_u64)]);

fn read<T: copy>(pair: &Pair<T>) -> result: T reads(pair) {
  return deref(pair).left;
}

fn main() -> status: ExitStatus pure {
  doc "CONST-2 admits concrete generic struct constants, including nested generic fields and fixed arrays. Explicit type and integer arguments select the exact instances; scalar fields and ordinary read-only references observe their static values.";
  let first = read::<u8>(pair: &small);
  if first == 5_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  let tag = packet.tag;
  if tag == 11_u8 {
  } else {
    return exit_status(code: 2_u8);
  }
  let nested = read::<u64>(pair: &packet.values[0_u64]);
  if nested == 13_u64 {
  } else {
    return exit_status(code: 3_u8);
  }
  let last = packet.values[1_u64].right;
  if last == 23_u64 {
  } else {
    return exit_status(code: 4_u8);
  }
  let length = packet.values.len;
  if length == count {
  } else {
    return exit_status(code: 5_u8);
  }
  return exit_status(code: 0_u8);
}
