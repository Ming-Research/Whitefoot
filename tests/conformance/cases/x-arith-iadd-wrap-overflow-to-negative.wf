alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "+wrap wraps two's-complement on overflow [OP-1]: i32::MAX + 1 produces i32::MIN, and that result raised by i32::MAX and then by 43 is the exit status 42.";
  let hi = 2147483647_i32;
  let w = hi +wrap 1_i32;
  let lifted = w + 2147483647_i32;
  let code = lifted + 43_i32;
  let status_code = cvt::<i32, u8>(code);
  return exit_status(code: status_code);
}
