nocopy struct Item {
  value: u8;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let items = slots_new::<Item, 1>();
  let initial = Item(value: 1_u8);
  place_back(window: &items, value: move initial);
  let owner = shared_new::<Slots<Item, 1>>(value: move items);
  let view = shared_read::<Slots<Item, 1>>(shared: &owner);
  atomic held = &view {
    if held^.len != 1_u64 {
      return std::process::exit_status(code: 0_u8);
    }
    let selected = &held^[0_u64..1_u64];
    let taken = move selected^[0_u64];
  }
  return std::process::exit_status(code: 0_u8);
}
