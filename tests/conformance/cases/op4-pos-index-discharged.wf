alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const values: Array<i32, 4> =[10_i32, 20_i32, 30_i32, 40_i32];

fn get(i: u64) -> result: i32 pure {
  doc "The deterministic remainder rule derives 0 <= bounded < 4, which discharges the following const-array subscript obligation [OP-4].";
  let bounded = i % 4_u64;
  return values[bounded];
}

fn main() -> return_value: ExitStatus pure {
  return exit_status(code: 0_u8);
}
