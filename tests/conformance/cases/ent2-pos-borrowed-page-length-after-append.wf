fn one(length: u64) -> result: u64 pure contract {
  requires length == 1_u64;
} {
  return length;
}

fn inspect(p: &Paged<u64>) -> result: u64 writes(p) contract {
  requires 0_u64 < p^.pages.len;
  requires p^.len < p^.cap;
} {
  let captured = &p^.pages[0_u64];
  if captured^.len == 1_u64 {
    place_back(window: p, value: 0_u64);
    return one(length: captured^.len);
  }
  return 0_u64;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
