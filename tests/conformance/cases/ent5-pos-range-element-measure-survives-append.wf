alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "The guard bounds deref(run)[0_u64].len by cells.len, where run is the range rows[0_u64..2_u64] formed while rows.len is 2. The place_back after it writes rows.next, and its entry state proves the range's end 2 at or below rows.len, so WIN-2 separates the range from the append slot, ENT-5 leaves the guarded measure fact alive, and the loop's cells[c] reads are proved in bounds. The program observes the sum over the element's two cells and the appended element.";
  let rows = slots_new::<Slots<u64, 8>, 4>();
  let first = slots_new::<u64, 8>();
  let second = slots_new::<u64, 8>();
  let third = slots_new::<u64, 8>();
  place_back(window: &first, value: 5_u64);
  place_back(window: &first, value: 6_u64);
  place_back(window: &rows, value: move first);
  place_back(window: &rows, value: move second);
  let cells = array_filled::<u64, 3>(value: 7_u64);
  let total = 0_u64;
  if rows.len == 2_u64 {
    let run = &rows[0_u64..2_u64];
    if deref(run)[0_u64].len <= cells.len {
      place_back(window: &rows, value: move third);
      for (c in 0_u64..deref(run)[0_u64].len) {
        let cell = cells[c];
        set total = total +wrap cell;
      }
      if rows.len == 3_u64 {
        if total == 14_u64 {
          return exit_status(code: 0_u8);
        }
      }
      return exit_status(code: 2_u8);
    }
  }
  return exit_status(code: 1_u8);
}
