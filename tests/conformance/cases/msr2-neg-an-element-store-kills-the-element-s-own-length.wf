alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "MSR-2: a write at an element position of P overlaps the descriptor storage of P[i] and none of P's own. The swap at grid[0] therefore kills every measure of grid[0] and no measure of grid, which is exactly what the residual below names: the outer subscript is still discharged from grid.len, and the inner one has nothing left to stand on.";
  let row = slots_new::<u8, 8>();
  place_back(window: &row, value: 5_u8);
  let table = slots_new::<Slots<u8, 8>, 4>();
  place_back(window: &table, value: move row);
  let grid = move table;
  let fresh = slots_new::<u8, 8>();
  let rows = grid.len;
  if rows == 1_u64 {
    let width = grid[0_u64].len;
    if width == 1_u64 {
      swap(first: &grid[0_u64], second: &fresh);
      let cell = grid[0_u64][0_u64];
      if cell == 5_u8 {
        return exit_status(code: 0_u8);
      }
      return exit_status(code: 4_u8);
    }
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 3_u8);
}
