struct Part {
  log: Box<Slots<u8>>;
}

fn part_new() -> made: Part pure {
  let log = box_slots_new::<u8>(capacity: 4_u64);
  return Part(log: move log);
}

fn main() -> status: std::process::ExitStatus pure waits {
  let parts = shared_shards_new::<Part, fn part_new>();
  let mine = any_shard();
  atomic part = &parts[mine] {
    let taken = move part^.log;
  }
  return std::process::exit_status(code: 0_u8);
}
