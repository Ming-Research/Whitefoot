alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum DecodeError {
  ZeroByte();
}

fn transform<const n: u64>(input: Slots<u8, n>) -> function_result: Result<Slots<u8, n>, DecodeError> pure contract {
  requires input.len >= n;
} {
  doc "Builds a matching output window, then transforms each byte or reports the first zero; abandonment on the error path releases the partly built output.";
  let output = slots_new::<u8, n>();
  for @build (
    at in 0_u64..n,
    invariant grown: output.len >= at,
    invariant spare: output.cap - output.len + at >= n
  ) {
    place_back(window: &output, value: 0_u8);
  }
  let length = output.len;
  for (offset in 0_u64..length) {
    let byte = input[offset];
    let zero = byte == 0_u8;
    if zero {
      let error = DecodeError::ZeroByte();
      return Err<Slots<u8, n>, DecodeError>(error: error);
    } else {
      let transformed = byte +wrap 1_u8;
      set output[offset] = transformed;
    }
  }
  return Ok<Slots<u8, n>, DecodeError>(value: move output);
}

fn abandon<const n: u64>(result: Result<Slots<u8, n>, DecodeError>) -> function_result: unit pure {
  doc "Consumes a result without inspecting it, so its active variant takes the compiler-derived release.";
  return unit;
}

fn success_matches(value: Slots<u8, 3>) -> result: Bool pure {
  doc "Observes the transformed length and the two expected bytes.";
  let length = value.len;
  let expected_length = length == 3_u64;
  if expected_length {
  } else {
    return False();
  }
  let first = value[0_u64];
  let middle = value[1_u64];
  let first_expected = first == 2_u8;
  let middle_expected = middle == 5_u8;
  return band(first_expected, middle_expected);
}

fn main() -> status: ExitStatus pure {
  doc "A fallible fixed-size byte transform uses a counted range for matching input and output indices, then uses an observed length branch to prove fixed verification reads. Ordinary controls observe success length and bytes plus every unexpected Result variant, while failure and abandonment preserve active-variant cleanup.";
  let success_input = slots_new::<u8, 3>();
  place_back(window: &success_input, value: 1_u8);
  place_back(window: &success_input, value: 4_u8);
  place_back(window: &success_input, value: 1_u8);
  let success = transform::<3>(input: move success_input);
  match move success {
    Ok(value: transformed) => {
      let matches = success_matches(value: move transformed);
      if matches {
      } else {
        return exit_status(code: 1_u8);
      }
    }
    Err(error: success_error) => {
      return exit_status(code: 2_u8);
    }
  }
  let failure_input = slots_new::<u8, 2>();
  place_back(window: &failure_input, value: 8_u8);
  place_back(window: &failure_input, value: 0_u8);
  let failure = transform::<2>(input: move failure_input);
  match move failure {
    Ok(value: failure_value) => {
      return exit_status(code: 3_u8);
    }
    Err(error: failure_error) => {
      match failure_error {
        ZeroByte() => {
        }
      }
    }
  }
  let abandoned_input = slots_new::<u8, 1>();
  place_back(window: &abandoned_input, value: 6_u8);
  let abandoned = transform::<1>(input: move abandoned_input);
  abandon::<1>(result: move abandoned);
  let abandoned_error_input = slots_new::<u8, 1>();
  place_back(window: &abandoned_error_input, value: 0_u8);
  let abandoned_error = transform::<1>(input: move abandoned_error_input);
  abandon::<1>(result: move abandoned_error);
  return exit_status(code: 0_u8);
}
