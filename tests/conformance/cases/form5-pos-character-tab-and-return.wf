alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "The escapes \\t and \\r denote U+0009 and U+000D in a character literal of either suffix [FORM-5]. The program subtracts each scalar value from its literal and returns the sum of the differences, zero, as its exit status.";
  let tab = '\t'_u8 - 9_u8;
  let carriage = '\r'_u8 - 13_u8;
  let wide_tab = '\t'_u32 - 9_u32;
  let wide_carriage = '\r'_u32 - 13_u32;
  let narrow_all = tab + carriage;
  let wide_all = wide_tab + wide_carriage;
  let wide_byte = cvt::<u32, u8>(wide_all);
  let code = narrow_all + wide_byte;
  return exit_status(code: code);
}
