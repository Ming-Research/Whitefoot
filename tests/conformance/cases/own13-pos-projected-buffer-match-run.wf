alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Packet {
  Data(bytes: Box<Slots<u8>>);
  Empty();
}

struct Envelope {
  packet: Packet;
}

fn inspect(envelope: &Envelope) -> result: u64 reads(envelope.packet) {
  doc "Matching through a struct projection binds the cell payload as a reference, and the window length behind that cell is read through it.";
  match deref(envelope).packet {
    Data(bytes: payload) => {
      return deref(payload).inner.len;
    }
    Empty() => {
      return 0_u64;
    }
  }
}

fn main() -> status: ExitStatus pure {
  let bytes = box_slots_new::<u8>(capacity: 3_u64);
  place_back(window: &bytes.inner, value: 7_u8);
  place_back(window: &bytes.inner, value: 7_u8);
  place_back(window: &bytes.inner, value: 7_u8);
  let packet = Packet::Data(bytes: move bytes);
  let envelope = Envelope(packet: move packet);
  let observed = inspect(envelope: &envelope);
  if observed != 3_u64 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
