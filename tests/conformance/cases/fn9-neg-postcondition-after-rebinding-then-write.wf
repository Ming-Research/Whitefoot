fn reset(p: &u64) -> result: unit writes(p) contract {
  ensures p^ == 1_u64;
} {
  doc "The body writes zero to the caller's cell, rebinds p to a local and then writes one through p, which writes the local. The postcondition concerns the caller's cell, which holds zero, so it must not be proved.";
  set p^ = 0_u64;
  let local = 0_u64;
  set p = &local;
  set p^ = 1_u64;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "x holds zero after the call, while the postcondition would tell the caller it holds one.";
  let x = 5_u64;
  reset(p: &x);
  let quotient = 10_u64 / x;
  if quotient == 10_u64 {
    return std::process::exit_status(code: 0_u8);
  }
  return std::process::exit_status(code: 1_u8);
}
