struct Cursor {
  k: u64;
  other: u64;
}

fn select(table: &[Slots<u8, 8>], s: &Cursor, i: u64) -> result: u8 reads(table), writes(s) contract {
  requires s^.k < table^.len;
} {
  doc "ENT-5 and OWN-7: replacing the entire Cursor overlaps the offset field k, so the old selected row's length guard cannot prove the later element read.";
  if i < table^[s^.k].len {
    set s^ = Cursor(k: 0_u64, other: 0_u64);
    return table^[s^.k][i];
  }
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The function body must be refused for the missing OP-4 bound.";
  return std::process::exit_status(code: 0_u8);
}
