alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn control(x: i32) -> result: i32 pure contract {
  define permitted = x >= 0_i32;
  return x;
  requires permitted;
} {
  doc "A contract block admits no control-transfer statement; grammar traversal rejects return under GRAM-2 before FN-8 forms a contract.";
  return x;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
