fn read_without_rematching(cell: &Option<u64>) -> result: u64 writes(cell) {
  doc "A backedge's overlapping payload write kills the outer match's refinement at the arbitrary loop header.";
  match &cell^ {
    None() => {
      return 0_u64;
    }
    Some(value: inner) => {
      let observed = 0_u64;
      for (round in 0_u64..2_u64) {
        let direct = cell^.Some.value;
        set observed = direct;
        set inner^ = 41_u64;
      }
      return observed;
    }
  }
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
