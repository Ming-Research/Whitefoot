alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn assemble(cap: u64) -> made: u64 pure contract {
  ensures made <= cap;
} {
  doc "Publishes a bound on its own result.";
  return 0_u64;
}

fn consume(bound: u64) -> echoed: u64 pure contract {
  requires bound <= 4_u64;
} {
  doc "Requires its argument to be inside the published bound.";
  return bound;
}

fn main() -> status: ExitStatus pure {
  doc "[ENT-3.S12] a set target is a destination of the published relation. The relation is established after the call's own transfer, consumes and effect kills and after the target's commit and kills, over the committed place, so the caller carries the bound past the assignment and discharges the later callee requirement from it. Its control is ent3-pos-s12-a-published-relation-reaches-a-let-binder, the same callee and the same requirement at the other destination.";
  let capacity = 4_u64;
  let carried = 9_u64;
  set carried = assemble(cap: capacity);
  let echoed = consume(bound: carried);
  if echoed == 0_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
