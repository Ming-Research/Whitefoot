alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn guarded_slots(a: &Slots<u64, 4>) -> result: unit writes(a) {
  doc "The guard reads the mapped root's descriptor; each write reaches only element i.";
  for (i in 0_u64..6_u64) {
    if i < a^.len {
      set a^[i] = i +wrap 1_u64;
    }
  }
  return unit;
}

fn guarded_array(a: &Array<u64, 4>) -> result: unit writes(a) {
  doc "Array length reads have the same descriptor separation as Slots length reads.";
  for (i in 0_u64..6_u64) {
    if i < a^.len {
      set a^[i] = i +wrap 1_u64;
    }
  }
  return unit;
}

fn length(a: &Slots<u64, 4>) -> result: u64 reads(a.len) {
  return a^.len;
}

fn helper_slots(a: &Slots<u64, 4>) -> result: unit writes(a) {
  doc "The helper's projected row reads only the mapped root's length.";
  let count = a^.len;
  for (i in 0_u64..count) {
    let size = length(a: a);
    set a^[i] = size;
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "Check the guarded writes, the helper result and the empty Slots boundary; compiler tests check permission.";
  let values = array_filled::<u64, 4>(value: 0_u64);
  guarded_array(a: &values);
  for (i in 0_u64..4_u64) {
    let expected = i +wrap 1_u64;
    if values[i] != expected {
      return exit_status(code: 1_u8);
    }
  }
  let initial = array_filled::<u64, 4>(value: 0_u64);
  let slots = slots_from_array::<u64, 4>(values: initial);
  guarded_slots(a: &slots);
  let count = slots.len;
  if count != 4_u64 {
    return exit_status(code: 2_u8);
  }
  for (i in 0_u64..count) {
    let expected = i +wrap 1_u64;
    if slots[i] != expected {
      return exit_status(code: 3_u8);
    }
  }
  helper_slots(a: &slots);
  let filled = slots.len;
  if filled != 4_u64 {
    return exit_status(code: 4_u8);
  }
  for (i in 0_u64..filled) {
    if slots[i] != 4_u64 {
      return exit_status(code: 5_u8);
    }
  }
  let empty = slots_new::<u64, 4>();
  guarded_slots(a: &empty);
  if empty.len != 0_u64 {
    return exit_status(code: 6_u8);
  }
  return exit_status(code: 0_u8);
}
