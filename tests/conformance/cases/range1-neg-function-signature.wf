alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

interface Probe {
  fn probe(cells: &[u64]) -> value: u64 reads(cells) contract {
    requires forall zero(k in 0_u64..cells^.len): cells^[k] == 0_u64;
  };
}

fn main() -> status: ExitStatus pure {
  doc "RANGE-1: a range clause is admitted as a requirement of a function declaration and as a loop header invariant, not in the contract of a function signature.";
  return exit_status(code: 0_u8);
}
