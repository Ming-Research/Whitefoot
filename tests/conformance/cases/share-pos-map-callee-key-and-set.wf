const names: Array<u8, 2> =[97_u8, 98_u8];

fn fill(m: &ConcurrentHashMap<u8>, ks: &KeySet, k: &[u8]) -> result: u8 reads(ks), reads(k), writes(m) {
  doc "SHARE-2: a callee's map reference admits key and key-set selections; the entries length equals the set length without a guard.";
  let es = &m^[ks^];
  for @each (i in 0_u64..ks^.len) {
    set es^[i] = Some<u8>(value: 4_u8);
  }
  set m^[k] = Some<u8>(value: 9_u8);
  match m^[k] {
    Some(value: held) => {
      return held^;
    }
    None() => {
      return 0_u8;
    }
  }
}

fn main() -> status: std::process::ExitStatus pure waits {
  let store = shared_map_new::<u8>(capacity: 2_u64);
  let ks = key_set_new(capacity: 2_u64);
  let first = &names[0_u64..1_u64];
  let second = &names[1_u64..2_u64];
  let a = key_set_insert(keys: &ks, key: first);
  let b = key_set_insert(keys: &ks, key: second);
  let seen = 0_u8;
  atomic t = &store {
    set seen = fill(m: t, ks: &ks, k: first);
    match t^[second] {
      Some(value: held) => {
        set seen = seen +wrap held^;
      }
      None() => {
      }
    }
  }
  return std::process::exit_status(code: seen);
}
