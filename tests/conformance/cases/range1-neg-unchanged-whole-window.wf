fn invalid(cell: &Slots<u64, 1>) -> result: unit writes(cell) contract {
  requires cell^.len == 1_u64;
  ensures forall preserved(k in 0_u64..cell^.len): cell^ unchanged;
} {
  set cell^[0_u64] = 9_u64;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
