alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Cell<T> {
  value: T;
}

const cell: Cell<Slots<u64, 2>> = Cell<Slots<u64, 2>>(value:[3_u64, 5_u64]);

fn main() -> status: ExitStatus pure {
  doc "CONST-2 checks the instantiated field types. A fixed-capacity Slots field remains ineligible for constant storage when introduced through a generic argument.";
  return exit_status(code: 0_u8);
}
