fn main() -> status: std::process::ExitStatus pure {
  let bytes = array_filled::<u8, 1>(value: 97_u8);
  let keys = key_set_new(capacity: 1_u64);
  let original = keys.len;
  for (
    i in 0_u64..1_u64,
    invariant unchanged: keys.len == original
  ) {
    key_set_insert(keys: &keys, key: &bytes[0_u64..1_u64]);
  }
  return std::process::exit_status(code: 0_u8);
}
