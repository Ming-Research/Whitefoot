fn one(length: u64) -> result: u64 pure contract {
  requires length == 1_u64;
} {
  return length;
}

fn inspect(p: &Box<Paged<u64>>) -> result: u64 writes(p) contract {
  requires 0_u64 < p^.inner.pages.len;
} {
  if p^.inner.pages[0_u64].len == 1_u64 {
    let capacity = p^.inner.cap;
    grow_paged(cell: p, capacity: capacity);
    if 0_u64 < p^.inner.pages.len {
      return one(length: p^.inner.pages[0_u64].len);
    }
  }
  return 0_u64;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
