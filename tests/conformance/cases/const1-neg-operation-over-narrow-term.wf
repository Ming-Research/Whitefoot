alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn echo<const n: u64>() -> r: u64 pure {
  doc "Reads the const generic at its written type u64.";
  return n;
}

fn next<const m: u8>() -> r: u64 pure {
  doc "Every IDENT term must be declared with its parameter's type, so m + 0 does not widen the u8 parameter m to u64.";
  return echo::<m + 0>();
}

fn main() -> status: ExitStatus pure {
  doc "The rejection is the operation argument's own, whatever value any instance supplies.";
  let v = next::<3>();
  return exit_status(code: 0_u8);
}
