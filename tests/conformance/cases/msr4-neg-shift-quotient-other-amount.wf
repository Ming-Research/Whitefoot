alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn shift_right_digits(digits: &Array<u8, 6>, shift: u32, other: u32) -> result: u64 writes(digits) contract {
  requires shift <= 60_u32;
  requires other <= 60_u32;
} {
  doc "The remainder is kept below two to the shift, but each quotient digit is shifted by the other amount, so a smaller other amount leaves digits far above what a byte holds.";
  let multiplier = ishl(1_u64, shift);
  let mask = multiplier - 1_u64;
  let remainder = 0_u64;
  for (
    index in 0_u64..6_u64,
    invariant remainder_bound: remainder <= mask
  ) {
    let digit = digits^[index];
    if digit <= 9_u8 {
    } else {
      return multiplier;
    }
    let wide = cvt::<u8, u64>(digit);
    let scaled = remainder * 10_u64;
    let total = scaled + wide;
    invariant total_bound: total <= 10_u64 * mask + 9_u64 {
      use 10 times remainder_bound;
    }
    let quotient = ishr(total, other);
    let kept = iand(total, mask);
    let narrow = cvt::<u64, u8>(quotient);
    set digits^[index] = narrow;
    set remainder = kept;
  }
  return remainder;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
