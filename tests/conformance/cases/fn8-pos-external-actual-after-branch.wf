alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias args_count = std::text::args_count;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;

fn read_at_index(bytes: &Slots<u8, 4>, index: u64) -> result: u8 reads(bytes) contract {
  define spare = deref(bytes).len;
  requires index < spare;
} {
  return deref(bytes)[index];
}

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "A real caller branch proves the instantiated requirement for an ordinary call-produced index. The verified requirement then enters the callee body and discharges its subscript, with no provenance side channel and no runtime fallback.";
  let Inputs(args: args, cwd: unused_cwd, stdout: unused_stdout, stderr: unused_stderr, handles: entry_factory, stdin: unused_stdin) = move inputs;
  let closed = close_directory(factory: &entry_factory, directory: move unused_cwd);
  let index = args_count(args: &args);
  let bytes = slots_new::<u8, 4>();
  for (
    at in 0_u64..4_u64,
    invariant grown: bytes.len >= at,
    invariant spare: bytes.cap - bytes.len + at >= 4_u64
  ) {
    place_back(window: &bytes, value: 0_u8);
  }
  let held = bytes.len;
  if index < held {
    let value = read_at_index(bytes: &bytes, index: index);
    return exit_status(code: value);
  } else {
    return exit_status(code: 0_u8);
  }
}
