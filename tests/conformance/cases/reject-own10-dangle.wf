alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn dangle(x: i32) -> function_result: i32 pure {
  doc "REF-3: references never escape. A reference may be bound to a local and passed as a call argument, but it may not be returned; a function that finds something returns an index or other owned data and the caller forms the reference.";
  return &x;
}

fn main() -> status: ExitStatus pure {
  doc "The rejection is in the helper above; this entry point does nothing.";
  return exit_status(code: 0_u8);
}
