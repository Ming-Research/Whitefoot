fn probe(r: &[u64], s: &[u64]) -> result: u64 reads(r), reads(s) {
  doc "ENT-2, OP-4: q is bound to r and a set later rebinds r to s; r is rebound, so q is no range alias and the guard on r's new target does not reach the read of q's old run.";
  let q = r;
  set r = s;
  if 1_u64 < r^.len {
    let second = q^[1_u64];
    return second;
  }
  return 0_u64;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "No call is needed to exercise the proof identity.";
  return std::process::exit_status(code: 0_u8);
}
