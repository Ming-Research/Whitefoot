fn probe(r: &[u64], s: &[u64]) -> result: u64 reads(r), reads(s) contract {
  requires r^.len >= 2_u64;
} {
  doc "ENT-2, OP-4: q is bound to r after a set rebinds r to s, which may be empty; r is rebound, so q is no range alias, and nothing transfers r's original requirement to q.";
  let first = r^[1_u64];
  set r = s;
  let q = r;
  let second = q^[1_u64];
  return first +wrap second;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "No call is needed to exercise the proof identity.";
  return std::process::exit_status(code: 0_u8);
}
