struct Inner {
  map: KeyedTable<u8>;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let table = keyed_table_new::<u8>(capacity: 0_u64);
  let inner = Inner(map: move table);
  let state = Some<Inner>(value: move inner);
  let store = shared_new::<Option<Inner>>(value: move state);
  let counted = 0_u64;
  atomic s = &store {
    match s^ {
      Some(value: part) => {
        let copied = part;
        set counted = keyed_table_count::<u8>(table: &copied^.map);
      }
      None() => {
      }
    }
  }
  return std::process::exit_status(code: 0_u8);
}
