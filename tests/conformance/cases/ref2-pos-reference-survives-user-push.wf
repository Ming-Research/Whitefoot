alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn push(window: &Slots<u64, 4>, value: u64) -> result: unit writes(window.next), writes(window.len) contract {
  requires deref(window).len < deref(window).cap;
} {
  doc "Appends one element. Its row writes window.next and window.len and nothing below the length, so a call never lowers window.len.";
  place_back(window: window, value: value);
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "OP-10, REF-2: e = &r[0_u64] is formed under 0 < r.len, and a call to push, whose row writes only r.next and r.len, leaves that bound holding, so e stays valid across it and still reads the first element.";
  let r = slots_new::<u64, 4>();
  place_back(window: &r, value: 1_u64);
  let e = &r[0_u64];
  push(window: &r, value: 5_u64);
  let seen = deref(e);
  if seen == 1_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
