alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "slots_into_array requires values.len == n. One initialized slot in a capacity-two run does not form a complete array; the conversion must not expose the raw second slot, and the undischarged requirement is an FN-8 call-site rejection.";
  let partial = slots_new::<u64, 2>();
  place_back(window: &partial, value: 7_u64);
  let invalid = slots_into_array::<u64, 2>(values: move partial);
  return exit_status(code: 0_u8);
}
