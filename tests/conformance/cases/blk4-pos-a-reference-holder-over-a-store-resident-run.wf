alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A reference holder over a heap-resident run: let holder = &cell.inner; names the path the Box content occupies, and the measure read and the subscript reach that one run through that one holder rather than through one shape each.";
  let cell = box_slots_new::<u8>(capacity: 2_u64);
  place_back(window: &cell.inner, value: 5_u8);
  let holder = &cell.inner;
  let size = deref(holder).len;
  if 0_u64 < size {
    let seen = deref(holder)[0_u64];
    if seen == 5_u8 {
    } else {
      return exit_status(code: 1_u8);
    }
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
