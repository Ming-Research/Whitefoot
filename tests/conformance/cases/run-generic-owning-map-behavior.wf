alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Seed {
  salt: u64;
}

fn seed_hash(env: &Seed, key: &u64) -> hash: u64 reads(env.salt), reads(key) {
  doc "Reference parameters are read through deref, so the salt and the key are ordinary place reads.";
  let mixed = deref(key) +wrap deref(env).salt;
  return mixed;
}

fn seed_equal(env: &Seed, left: &u64, right: &u64) -> equal: Bool reads(left), reads(right) {
  doc "The supplied row is a subset of the formal's, which FN-4 admits.";
  let same = deref(left) == deref(right);
  return same;
}

struct Resource {
  id: u64;
  data0: u64;
  data1: u64;
  data2: u64;
  data3: u64;
}

enum Slot<K> {
  Vacant();
  Deleted();
  Occupied(fingerprint: u8, key: K, payload: Box<Resource>);
}

enum Probe {
  Stop();
  Skip();
  Miss();
  Match();
}

enum KeyPut<K> {
  Installed(previous: Slot<K>);
  Rejected(key: K, payload: Box<Resource>);
}

interface Key<K, E> {
  fn hash(env: &E, key: &K) -> hash: u64 reads(env), reads(key);
  fn equal(env: &E, left: &K, right: &K) -> equal: Bool reads(env), reads(left), reads(right);
}

struct Map<interface Key<K, E>> {
  slots: Box<Slots<Slot<K>>>;
}

binding SeedKey : Key<u64, Seed> {
  hash = seed_hash;
  equal = seed_equal;
}

struct Empty {
}

fn word_hash(env: &Empty, key: &u64) -> hash: u64 reads(key) {
  doc "An empty-environment hash.";
  return deref(key);
}

fn word_equal(env: &Empty, left: &u64, right: &u64) -> equal: Bool reads(left), reads(right) {
  doc "An empty-environment equality.";
  let same = deref(left) == deref(right);
  return same;
}

binding WordKey : Key<u64, Empty> {
  hash = word_hash;
  equal = word_equal;
}

fn fingerprint(key: u64) -> result: u8 pure {
  doc "Seven low bits of the hash, folded one at a time.";
  let tag = 0_u8;
  let bit0 = iand(key, 1_u64);
  if bit0 != 0_u64 {
    set tag = ior(tag, 1_u8);
  }
  let bit1 = iand(key, 2_u64);
  if bit1 != 0_u64 {
    set tag = ior(tag, 2_u8);
  }
  let bit2 = iand(key, 4_u64);
  if bit2 != 0_u64 {
    set tag = ior(tag, 4_u8);
  }
  let bit3 = iand(key, 8_u64);
  if bit3 != 0_u64 {
    set tag = ior(tag, 8_u8);
  }
  let bit4 = iand(key, 16_u64);
  if bit4 != 0_u64 {
    set tag = ior(tag, 16_u8);
  }
  let bit5 = iand(key, 32_u64);
  if bit5 != 0_u64 {
    set tag = ior(tag, 32_u8);
  }
  let bit6 = iand(key, 64_u64);
  if bit6 != 0_u64 {
    set tag = ior(tag, 64_u8);
  }
  return tag;
}

fn probe_index(home: u64, step: u64, count: u64) -> index: u64 pure contract {
  requires home < count;
  requires step < count;
  ensures index < count;
} {
  doc "Linear probing with an explicit wrap, so the returned offset is proved inside the window.";
  let until_end = count - home;
  if step >= until_end {
    let wrapped = step - until_end;
    return wrapped;
  }
  let straight = home + step;
  return straight;
}

fn key_probe<interface Key<K, E>>(slot: &Slot<K>, tag: u8, key: &K, env: &E) -> action: Probe reads(slot), reads(key), reads(env) {
  doc "Matching through a reference leaves the scrutinee live and binds each payload as a reference naming the scrutinee path.";
  match deref(slot) {
    Vacant() => {
      return Probe::Stop();
    }
    Deleted() => {
      return Probe::Skip();
    }
    Occupied(fingerprint: saved, key: present, payload: owner) => {
      if deref(saved) == tag {
        let same = Key::equal(env: env, left: present, right: key);
        if same {
          return Probe::Match();
        }
      }
      return Probe::Miss();
    }
  }
}

fn key_put<interface Key<K, E>>(slots: &Box<Slots<Slot<K>>>, key: K, payload: Box<Resource>, env: &E) -> outcome: KeyPut<K> reads(env), writes(slots) contract {
  ensures deref(slots).inner.len == deref(entry(slots)).inner.len;
} {
  doc "The probe loop only selects a destination, so the owning key and payload are never moved inside a loop body; the one installation is written after it and exchanges the old occupant out by swap.";
  let hash = Key::hash(env: env, key: &key);
  let tag = fingerprint(key: hash);
  let count = deref(slots).inner.len;
  let first_deleted = count;
  let destination = count;
  for (step in 0_u64..count) {
    if destination == count {
      let home = hash % count;
      let index = probe_index(home: home, step: step, count: count);
      let action = key_probe::<Key<K, E>>(slot: &deref(slots).inner[index], tag: tag, key: &key, env: env);
      match action {
        Match() => {
          set destination = index;
        }
        Skip() => {
          if first_deleted == count {
            set first_deleted = index;
          }
        }
        Stop() => {
          if first_deleted < count {
            set destination = first_deleted;
          } else {
            set destination = index;
          }
        }
        Miss() => {
        }
      }
    }
  }
  if destination == count {
    if first_deleted < count {
      set destination = first_deleted;
    }
  }
  if destination < count {
  } else {
    return KeyPut<K>::Rejected(key: move key, payload: move payload);
  }
  let offered = Slot<K>::Occupied(fingerprint: tag, key: move key, payload: move payload);
  swap(first: &deref(slots).inner[destination], second: &offered);
  return KeyPut<K>::Installed(previous: move offered);
}

fn key_fill<K>(slots: &Box<Slots<Slot<K>>>, count: u64) -> result: unit writes(slots) contract {
  requires deref(slots).inner.len == 0_u64;
  requires count <= deref(slots).inner.cap - deref(slots).inner.len;
  ensures deref(slots).inner.len == count;
} {
  doc "One vacant slot per position, under a counted header that carries the length and the remaining room.";
  for (
    index in 0_u64..count,
    invariant filled: deref(slots).inner.len >= index,
    invariant bounded: deref(slots).inner.len <= index,
    invariant spare: deref(slots).inner.cap - deref(slots).inner.len + index >= count
  ) {
    let vacant = Slot<K>::Vacant();
    place_back(window: &deref(slots).inner, value: move vacant);
  }
  invariant complete_min: deref(slots).inner.len >= count;
  invariant complete_max: deref(slots).inner.len <= count;
  return unit;
}

fn key_create<K>(count: u64) -> result: Box<Slots<Slot<K>>> pure contract {
  requires count <= 384307168202282324_u64;
  ensures result.inner.len == count;
} {
  doc "Allocation is total, so the creation has no failure arm and the static allocation-size obligation is discharged at the constructor. For this native fixture's concrete Slot types, STOR-6 also requires the 16-byte descriptor plus 24 bytes per slot to fit the signed 64-bit address domain: floor((9223372036854775807 - 16) / 24) = 384307168202282324. The former u64 product-only ceiling did not qualify a native allocation. All workload inputs and runtime observations are unchanged.";
  let spare = box_slots_new::<Slot<K>>(capacity: count);
  key_fill::<K>(slots: &spare, count: count);
  return move spare;
}

fn key_inspect<interface Key<K, E>>(slot: &Slot<K>, tag: u8, key: &K, env: &E) -> (action: Probe, id: u64) reads(slot), reads(key), reads(env) {
  doc "The same probe, reporting the occupant's identifier beside its verdict.";
  match deref(slot) {
    Vacant() => {
      return Probe::Stop(), 0_u64;
    }
    Deleted() => {
      return Probe::Skip(), 0_u64;
    }
    Occupied(fingerprint: saved, key: present, payload: owner) => {
      if deref(saved) == tag {
        let same = Key::equal(env: env, left: present, right: key);
        if same {
          let found = deref(owner).inner.id;
          return Probe::Match(), found;
        }
      }
      return Probe::Miss(), 0_u64;
    }
  }
}

fn key_find<interface Key<K, E>>(slots: &Box<Slots<Slot<K>>>, key: &K, env: &E) -> (found: Option<u64>, examined: u64) reads(slots), reads(key), reads(env) {
  doc "The lookup walks the same probe order and reports how many positions it examined.";
  let hash = Key::hash(env: env, key: key);
  let tag = fingerprint(key: hash);
  let count = deref(slots).inner.len;
  for (offset in 0_u64..count) {
    let home = hash % count;
    let index = probe_index(home: home, step: offset, count: count);
    let work = offset + 1_u64;
    let (action, id) = key_inspect::<Key<K, E>>(slot: &deref(slots).inner[index], tag: tag, key: key, env: env);
    match action {
      Stop() => {
        return None<u64>(), work;
      }
      Match() => {
        return Some<u64>(value: id), work;
      }
      Skip() => {
      }
      Miss() => {
      }
    }
  }
  return None<u64>(), count;
}

struct Branded {
  value: Box<u64>;
}

fn branded_hash(env: &Seed, key: &Branded) -> hash: u64 reads(env.salt), reads(key.value) {
  doc "An owning key whose content is reached through the cell step.";
  let value = deref(key).value.inner;
  let mixed = value +wrap deref(env).salt;
  return mixed;
}

fn branded_equal(env: &Seed, left: &Branded, right: &Branded) -> equal: Bool reads(left.value), reads(right.value) {
  doc "Two owning keys compared by their contents.";
  let a = deref(left).value.inner;
  let b = deref(right).value.inner;
  let same = a == b;
  return same;
}

binding BrandedKey : Key<Branded, Seed> {
  hash = branded_hash;
  equal = branded_equal;
}

fn never_equal(env: &Empty, left: &u64, right: &u64) -> equal: Bool pure {
  doc "A hostile equality that is not even reflexive.";
  return False();
}

binding HostileKey : Key<u64, Empty> {
  hash = word_hash;
  equal = never_equal;
}

fn demo_payload(id: u64) -> result: Box<Resource> pure {
  doc "Allocation is total, so the payload constructor has no failure arm.";
  let data0 = id *wrap 17_u64;
  let data1 = data0 +wrap 1_u64;
  let data2 = data0 +wrap 2_u64;
  let data3 = data0 +wrap 3_u64;
  let value = Resource(id: id, data0: data0, data1: data1, data2: data2, data3: data3);
  let owner = box_new::<Resource>(value: value);
  return move owner;
}

fn seed_case() -> code: u8 pure {
  doc "The stateful hash and equality instantiation: one insertion and one successful lookup.";
  let env = Seed(salt: 8_u64);
  let query = 5_u64;
  let slots = key_create::<u64>(count: 4_u64);
  let map = Map<SeedKey>(slots: move slots);
  let owner = demo_payload(id: 81_u64);
  let outcome = key_put::<SeedKey>(slots: &map.slots, key: 5_u64, payload: move owner, env: &env);
  let (found, examined) = key_find::<SeedKey>(slots: &map.slots, key: &query, env: &env);
  match found {
    None() => {
      return 1_u8;
    }
    Some(value: id) => {
      if id != 81_u64 {
        return 2_u8;
      }
    }
  }
  return 0_u8;
}

fn branded_case() -> code: u8 pure {
  doc "The owning-key instantiation: the key itself owns a heap cell and is stored in the slot.";
  let env = Seed(salt: 8_u64);
  let slots = key_create::<Branded>(count: 4_u64);
  let map = Map<BrandedKey>(slots: move slots);
  let key_owner = box_new::<u64>(value: 9_u64);
  let key = Branded(value: move key_owner);
  let query_owner = box_new::<u64>(value: 9_u64);
  let query = Branded(value: move query_owner);
  let owner = demo_payload(id: 81_u64);
  let outcome = key_put::<BrandedKey>(slots: &map.slots, key: move key, payload: move owner, env: &env);
  let (found, examined) = key_find::<BrandedKey>(slots: &map.slots, key: &query, env: &env);
  match found {
    None() => {
      return 3_u8;
    }
    Some(value: id) => {
      if id != 81_u64 {
        return 4_u8;
      }
    }
  }
  return 0_u8;
}

fn hostile_case() -> code: u8 pure {
  doc "Repeated identical keys under a non-reflexive equality stay safe: every insertion lands in a vacant slot and every owner is still cleaned up.";
  let env = Empty();
  let query = 5_u64;
  let slots = key_create::<u64>(count: 2_u64);
  let map = Map<HostileKey>(slots: move slots);
  for (ordinal in 0_u64..2_u64) {
    let id = ordinal +wrap 81_u64;
    let owner = demo_payload(id: id);
    let outcome = key_put::<HostileKey>(slots: &map.slots, key: 5_u64, payload: move owner, env: &env);
    match outcome {
      Rejected(key: offered_key, payload: offered_owner) => {
        return 5_u8;
      }
      Installed(previous: old) => {
        match old {
          Occupied(fingerprint: tag, key: old_key, payload: old_owner) => {
            return 6_u8;
          }
          Vacant() => {
          }
          Deleted() => {
          }
        }
      }
    }
  }
  let (found, examined) = key_find::<HostileKey>(slots: &map.slots, key: &query, env: &env);
  match found {
    Some(value: id) => {
      return 7_u8;
    }
    None() => {
      if examined != 2_u64 {
        return 8_u8;
      }
    }
  }
  return 0_u8;
}

fn behavior_contract(variant: u64) -> code: u8 pure {
  doc "One entry per instantiation.";
  if variant == 0_u64 {
    return seed_case();
  }
  if variant == 1_u64 {
    return branded_case();
  }
  return hostile_case();
}

fn main() -> status: ExitStatus pure {
  doc "One owning enum-slot map instantiated with stateful hash and equality, an owning key, and an empty-environment hostile equality. All owners are cleaned up.";
  for (variant in 0_u64..3_u64) {
    let code = behavior_contract(variant: variant);
    if code != 0_u8 {
      return exit_status(code: code);
    }
  }
  return exit_status(code: 0_u8);
}
