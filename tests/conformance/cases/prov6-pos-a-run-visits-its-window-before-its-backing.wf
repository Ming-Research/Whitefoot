alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Holder {
  data: Box<Slots<u8>>;
}

fn hold(value: u8) -> made: Holder pure {
  doc "Takes one two-slot window from the one heap, fills it, and wraps it in the nominal that owns it.";
  let fresh = box_slots_new::<u8>(capacity: 2_u64);
  place_back(window: &fresh.inner, value: value);
  place_back(window: &fresh.inner, value: value);
  let wrapped = Holder(data: move fresh);
  return move wrapped;
}

fn walk(first: Holder) -> code: u8 pure {
  doc "PROV-6: a container's elements are visited before its backing is released. The constant-capacity window is frame-resident and reclaims nothing of its own, and its slots hold values that each own one heap cell, so the derived release is the window walk in ascending logical order and each cell is freed after its content.";
  let run = slots_new::<Holder, 4>();
  place_back(window: &run, value: move first);
  let second = hold(value: 5_u8);
  place_back(window: &run, value: move second);
  let held = run.len;
  if held == 2_u64 {
  } else {
    return 1_u8;
  }
  let back = take_back(window: &run);
  let width = back.data.inner.len;
  if width == 2_u64 {
  } else {
    return 2_u8;
  }
  let left = run.len;
  if left == 1_u64 {
  } else {
    return 3_u8;
  }
  return 0_u8;
}

fn main() -> status: ExitStatus pure {
  doc "The entry builds the first holder and hands it to the walk, whose own window then owns both.";
  let first = hold(value: 3_u8);
  let code = walk(first: move first);
  return exit_status(code: code);
}
