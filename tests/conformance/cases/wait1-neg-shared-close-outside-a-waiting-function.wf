nodrop struct Ticket {
  id: u8;
}

fn settle(held: Shared<Ticket>) -> result: u8 pure {
  match shared_close::<Ticket>(shared: move held) {
    Some(value: last) => {
      let Ticket(id: number) = move last;
      return number;
    }
    None() => {
      return 0_u8;
    }
  }
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
