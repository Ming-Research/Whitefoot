alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Pair {
  left: Box<Slots<u8>>;
  right: Box<Slots<u8>>;
}

fn change(cell: &Box<Slots<u8>>) -> result: u64 writes(cell) {
  doc "Writes the first element of the window behind the cell it was handed, when that window has one.";
  let size = deref(cell).inner.len;
  let available = size != 0_u64;
  if available {
    set deref(cell).inner[0_u64] = 9_u8;
  }
  return 7_u64;
}

fn main() -> status: ExitStatus pure {
  doc "Two calls reaching disjoint cell fields through one reference write their own storage, and the first field is written again after both have ended.";
  let first = box_slots_new::<u8>(capacity: 1_u64);
  place_back(window: &first.inner, value: 3_u8);
  let second = box_slots_new::<u8>(capacity: 1_u64);
  place_back(window: &second.inner, value: 5_u8);
  let pair = Pair(left: move first, right: move second);
  let holder = &pair;
  let a = change(cell: &deref(holder).left);
  let b = change(cell: &deref(holder).right);
  let resumed = change(cell: &deref(holder).left);
  return exit_status(code: 0_u8);
}
