alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Holder<T: drop> {
  run: T;
}

fn hold<T: drop>(value: T) -> made: Holder<T> pure {
  doc "Wraps one owned run in a nominal generic over its element type.";
  let held = Holder<T>(run: move value);
  return move held;
}

fn main() -> status: ExitStatus pure {
  doc "FN-2: a call's type arguments are substituted into every position of the callee's signature, results included, so two calls of one declaration at two arguments hand back two types. Setting a `Holder<Slots<u16, 4>>` into a dead binding of `Holder<Slots<u8, 4>>` is TYPE-5's exact-identity mismatch and not an accepted transfer.";
  let first = slots_new::<u8, 4>();
  let second = slots_new::<u16, 4>();
  let one = hold::<Slots<u8, 4>>(value: move first);
  let kept = move one;
  let Holder(run: gone) = move kept;
  let two = hold::<Slots<u16, 4>>(value: move second);
  set kept = move two;
  return exit_status(code: 0_u8);
}
