alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn divide(n: u64, d: u64) -> result: u64 pure {
  doc "The exact division domain is discharged statically [EFF-2, OP-2, ENT-6], so the operation has no runtime fallback and `pure` is the exact row.";
  if d > 0_u64 {
    let q = n / d;
    return q;
  }
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  let v = divide(n: 84_u64, d: 2_u64);
  if v == 42_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
