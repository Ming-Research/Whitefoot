fn probe(rows: &[Slots<u8, 8>]) -> result: u8 writes(rows) contract {
  requires rows^.len >= 3_u64;
  requires rows^[2_u64].len >= 1_u64;
} {
  doc "ENT-5 compares no two subscripts at one position by their offsets at a loop head. The body replaces row one, so at the next head that write overlaps row two's length and the requirement over it no longer bounds the inner read.";
  let total = 0_u8;
  for (i in 0_u64..2_u64) {
    let first = rows^[2_u64][0_u64];
    set total = total +wrap first;
    set rows^[1_u64] = slots_new::<u8, 8>();
  }
  return total;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Checking probe must refuse a measure fact a continuing write overlaps at the loop head.";
  return std::process::exit_status(code: 0_u8);
}
