const names: Array<u8, 2> =[97_u8, 97_u8];

struct Store {
  table: ConcurrentHashMap<u8>;
}

fn write_both(first: &Option<u8>, second: &Option<u8>) -> result: unit writes(first), writes(second) {
  doc "Writes a value into each of two entries.";
  set first^ = Some<u8>(value: 1_u8);
  set second^ = Some<u8>(value: 2_u8);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  doc "Two key slices taken from different positions hold equal bytes, so the two entries passed to the writer are one entry of the map.";
  let table = map_new::<u8>(capacity: 1_u64);
  let state = Store(table: move table);
  let store = shared_new::<Store>(value: move state);
  let left = &names[0_u64..1_u64];
  let right = &names[1_u64..2_u64];
  atomic s = &store {
    write_both(first: &s^.table[left], second: &s^.table[right]);
  }
  return std::process::exit_status(code: 0_u8);
}
