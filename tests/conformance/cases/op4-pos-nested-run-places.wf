fn read_element(value: &u64) -> result: u64 reads(value) {
  return value^;
}

fn read_selected(s: &Segments<u64>, i: u64, j: u64) -> result: u64 reads(s) contract {
  requires i < s^.len;
  requires j < s^[i].len;
} {
  return read_element(value: &s^[i][j]);
}

fn main() -> status: std::process::ExitStatus pure {
  doc "A page element can own segments whose direct accesses retain every enclosing place step.";
  let widths = box_array_filled::<u64>(count: 1_u64, value: 2_u64);
  let segments = box_segments_filled::<u64>(lengths: &widths.inner[0_u64..1_u64], value: 7_u64);
  let pages = box_paged_new::<Box<Segments<u64>>>(capacity: 1_u64);
  place_back(window: &pages.inner, value: move segments);
  if pages.inner.pages.len != 1_u64 {
    return std::process::exit_status(code: 5_u8);
  }
  if pages.inner.pages[0_u64].len != 1_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  if pages.inner.pages[0_u64][0_u64].inner.len != 1_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  if pages.inner.pages[0_u64][0_u64].inner[0_u64].len != 2_u64 {
    return std::process::exit_status(code: 3_u8);
  }
  set pages.inner.pages[0_u64][0_u64].inner[0_u64][1_u64] = 13_u64;
  let selected = &pages.inner.pages[0_u64][0_u64].inner[0_u64][1_u64];
  if selected^ != 13_u64 {
    return std::process::exit_status(code: 4_u8);
  }
  let passed = read_selected(s: &pages.inner.pages[0_u64][0_u64].inner, i: 0_u64, j: 1_u64);
  if passed != 13_u64 {
    return std::process::exit_status(code: 6_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
