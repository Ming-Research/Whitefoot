alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias HandleFactory = std::io::HandleFactory;
alias DirectoryRead = std::fs::DirectoryRead;
alias DirectoryWrite = std::fs::DirectoryWrite;

fn copy_name(args: &std::text::Args, position: u64, destination: &[u8]) -> next: u64 reads(args), writes(destination) contract {
  ensures next <= destination^.len;
} {
  match std::text::arg_get(args: args, position: position) {
    Ok(value: text) => {
      let length = destination^.len;
      match std::text::host_copy_bytes(value: &text, destination: destination, start: 0_u64, end: length) {
        Ok(value: end) => {
          return end;
        }
        Err(error: problem) => {
          return 0_u64;
        }
      }
    }
    Err(error: problem) => {
      return 0_u64;
    }
  }
}

fn make_file(factory: &HandleFactory, root: &DirectoryWrite, name: &[u8], byte: u8) -> result: u8 reads(root), reads(name), writes(factory) waits {
  match std::fs::open_append(factory: factory, root: root, name: name, start: 0_u64, end: name^.len) {
    Ok(value: file) => {
      let outcome = 0_u8;
      match std::fs::truncate_file(factory: factory, file: &file, length: 0_u64) {
        Ok(value: done) => {
        }
        Err(error: problem) => {
          set outcome = 2_u8;
        }
      }
      let bytes = array_filled::<u8, 1>(value: byte);
      match std::fs::append_once(factory: factory, file: &file, source: &bytes[0_u64..1_u64], start: 0_u64, end: 1_u64) {
        Ok(value: next) => {
          if next != 1_u64 {
            set outcome = 3_u8;
          }
        }
        Err(error: problem) => {
          set outcome = 4_u8;
        }
      }
      match std::fs::close_write(factory: factory, file: move file) {
        Ok(value: done) => {
        }
        Err(error: problem) => {
          set outcome = 5_u8;
        }
      }
      return outcome;
    }
    Err(error: problem) => {
      return 1_u8;
    }
  }
}

fn check_file(factory: &HandleFactory, root: &DirectoryRead, name: &[u8], byte: u8) -> result: u8 reads(root), reads(name), writes(factory) waits {
  match std::fs::open_file(factory: factory, root: root, name: name, start: 0_u64, end: name^.len) {
    Ok(value: opened) => {
      let bytes = array_filled::<u8, 2>(value: 255_u8);
      let outcome = 0_u8;
      match std::fs::read_at(factory: factory, file: &opened, destination: &bytes[0_u64..2_u64], file_offset: 0_u64, start: 0_u64, end: 2_u64) {
        Ok(value: next) => {
          if next != 1_u64 {
            set outcome = 6_u8;
          }
        }
        Err(error: problem) => {
          set outcome = 7_u8;
        }
      }
      std::fs::close_read(factory: factory, file: move opened);
      if bytes[0_u64] != byte {
        set outcome = 8_u8;
      }
      return outcome;
    }
    Err(error: problem) => {
      return 9_u8;
    }
  }
}

fn not_found(error: &std::io::IoError) -> result: Bool reads(error) {
  match error^ {
    NotFound(code: c, origin: o) => {
      return True();
    }
    PermissionDenied(code: c, origin: o) => {
      return False();
    }
    AlreadyExists(code: c, origin: o) => {
      return False();
    }
    NotDirectory(code: c, origin: o) => {
      return False();
    }
    IsDirectory(code: c, origin: o) => {
      return False();
    }
    DirectoryNotEmpty(code: c, origin: o) => {
      return False();
    }
    ReadOnly(code: c, origin: o) => {
      return False();
    }
    ResourceBusy(code: c, origin: o) => {
      return False();
    }
    InvalidInput(code: c, origin: o) => {
      return False();
    }
    InvalidPath(code: c, origin: o) => {
      return False();
    }
    Unsupported(code: c, origin: o) => {
      return False();
    }
    TimedOut(code: c, origin: o) => {
      return False();
    }
    DeadlinePassed() => {
      return False();
    }
    BrokenPipe(code: c, origin: o) => {
      return False();
    }
    WriteZero(code: c, origin: o) => {
      return False();
    }
    UnexpectedEnd(code: c, origin: o) => {
      return False();
    }
    ConnectionRefused(code: c, origin: o) => {
      return False();
    }
    ConnectionReset(code: c, origin: o) => {
      return False();
    }
    ConnectionAborted(code: c, origin: o) => {
      return False();
    }
    NotConnected(code: c, origin: o) => {
      return False();
    }
    AddressInUse(code: c, origin: o) => {
      return False();
    }
    AddressUnavailable(code: c, origin: o) => {
      return False();
    }
    ResourceExhausted(code: c, origin: o) => {
      return False();
    }
    FileTooLarge(code: c, origin: o) => {
      return False();
    }
    NoSpace(code: c, origin: o) => {
      return False();
    }
    QuotaExceeded(code: c, origin: o) => {
      return False();
    }
    CrossDevice(code: c, origin: o) => {
      return False();
    }
    DeviceFailure(code: c, origin: o) => {
      return False();
    }
    Other(code: c, origin: o) => {
      return False();
    }
  }
}

fn change_entries(factory: &HandleFactory, writer: &DirectoryWrite, first: &[u8], second: &[u8]) -> result: u8 reads(first), reads(second), writes(factory), writes(writer) waits {
  let outcome = make_file(factory: factory, root: writer, name: first, byte: 97_u8);
  if outcome != 0_u8 {
    return outcome;
  }
  set outcome = make_file(factory: factory, root: writer, name: second, byte: 98_u8);
  if outcome != 0_u8 {
    return outcome;
  }
  match std::fs::rename_file(factory: factory, root: writer, from: second, from_start: 0_u64, from_end: second^.len, to: first, to_start: 0_u64, to_end: first^.len) {
    Ok(value: done) => {
    }
    Err(error: problem) => {
      return 14_u8;
    }
  }
  set outcome = make_file(factory: factory, root: writer, name: second, byte: 99_u8);
  if outcome != 0_u8 {
    return outcome;
  }
  match std::fs::remove_file(factory: factory, root: writer, name: second, start: 0_u64, end: second^.len) {
    Ok(value: done) => {
    }
    Err(error: problem) => {
      return 15_u8;
    }
  }
  match std::fs::sync_directory(factory: factory, root: writer) {
    Ok(value: done) => {
      return 0_u8;
    }
    Err(error: problem) => {
      return 16_u8;
    }
  }
}

fn check_entries(factory: &HandleFactory, reader: &DirectoryRead, first: &[u8], second: &[u8]) -> result: u8 reads(reader), reads(first), reads(second), writes(factory) waits {
  let outcome = check_file(factory: factory, root: reader, name: first, byte: 98_u8);
  if outcome != 0_u8 {
    return outcome;
  }
  match std::fs::open_file(factory: factory, root: reader, name: second, start: 0_u64, end: second^.len) {
    Ok(value: opened) => {
      std::fs::close_read(factory: factory, file: move opened);
      return 17_u8;
    }
    Err(error: problem) => {
      let missing = not_found(error: &problem);
      if missing {
        return 0_u8;
      }
      return 18_u8;
    }
  }
}

fn exercise(factory: &HandleFactory, reader: &DirectoryRead, writer: &DirectoryWrite, folder: &[u8], first: &[u8], second: &[u8]) -> result: u8 reads(reader), reads(folder), reads(first), reads(second), writes(factory), writes(writer) waits {
  match std::fs::open_directory_write(factory: factory, root: writer, name: folder, start: 0_u64, end: folder^.len) {
    Ok(value: opened) => {
      let outcome = change_entries(factory: factory, writer: &opened, first: first, second: second);
      std::fs::close_directory_write(factory: factory, directory: move opened);
      if outcome != 0_u8 {
        return outcome;
      }
    }
    Err(error: problem) => {
      return 19_u8;
    }
  }
  match std::fs::open_directory(factory: factory, root: reader, name: folder, start: 0_u64, end: folder^.len) {
    Ok(value: opened) => {
      let outcome = check_entries(factory: factory, reader: &opened, first: first, second: second);
      std::fs::close_directory(factory: factory, directory: move opened);
      return outcome;
    }
    Err(error: problem) => {
      return 20_u8;
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: args, cwd: directory, stdout: out, stderr: errors, handles: factory, stdin: input, clock: clock, wall_clock: wall) = move inputs;
  let std::fs::Directory(read: reader, write: writer) = move directory;
  let folder = array_filled::<u8, 64>(value: 0_u8);
  let folder_end = copy_name(args: &args, position: 1_u64, destination: &folder[0_u64..64_u64]);
  let first = array_filled::<u8, 64>(value: 0_u8);
  let first_end = copy_name(args: &args, position: 2_u64, destination: &first[0_u64..64_u64]);
  let second = array_filled::<u8, 64>(value: 0_u8);
  let second_end = copy_name(args: &args, position: 3_u64, destination: &second[0_u64..64_u64]);
  let outcome = 99_u8;
  if folder_end > 0_u64 {
    if folder_end <= 64_u64 {
      if first_end > 0_u64 {
        if first_end <= 64_u64 {
          if second_end > 0_u64 {
            if second_end <= 64_u64 {
              set outcome = exercise(factory: &factory, reader: &reader, writer: &writer, folder: &folder[0_u64..folder_end], first: &first[0_u64..first_end], second: &second[0_u64..second_end]);
            }
          }
        }
      }
    }
  }
  std::fs::close_directory(factory: &factory, directory: move reader);
  std::fs::close_directory_write(factory: &factory, directory: move writer);
  return std::process::exit_status(code: outcome);
}
