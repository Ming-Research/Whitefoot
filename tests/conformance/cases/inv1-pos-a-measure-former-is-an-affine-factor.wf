alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn filled<T: copy, const n: u64>(value: T) -> result: Slots<T, n> pure contract {
  ensures result.len >= n;
  ensures result.cap <= result.len;
} {
  doc "Builds a window of n slots, every one holding a copy of value; the copy bound is what admits the bare repeated use.";
  let built = slots_new::<T, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: built.len >= at,
    invariant spare: built.cap - built.len + at >= n
  ) {
    place_back(window: &built, value: value);
  }
  return move built;
}

fn headroom(run: Slots<u8, 8>) -> total: u64 pure contract {
  requires 8_u64 <= run.len;
} {
  doc "A header invariant states a relation over a measure of the window it scans.";
  let seen = 0_u64;
  for (
    at in 0_u64..4_u64,
    invariant reserved: seen + 4_u64 <= run.len
  ) {
    let byte = run[at];
  }
  return seen;
}

fn main() -> status: ExitStatus pure {
  doc "INV-1, MSR-1, MSR-5: a measure place is an affine factor of a header invariant. The relation the writer states is the one a contract clause already states, in the same spelling, and the checker proves it at the loop base and at every backedge over the same ENT-2 measure term the automatic derivation of a numeric goal already carries an atom for.";
  let run = filled::<u8, 8>(value: 0_u8);
  let total = headroom(run: move run);
  if total == 0_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
