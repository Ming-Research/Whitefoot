alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const table: Array<u8, 4> =[10_u8, 20_u8, 30_u8, 40_u8];

fn main() -> status: ExitStatus pure {
  doc "A const array is read-only static rodata, indexed with copy-out; its length is the type constant N, which the program returns as its exit status.";
  let v = table[2_u64];
  if v == 30_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  let n = table.len;
  let code = cvt::<u64, u8>(n);
  return exit_status(code: code);
}
