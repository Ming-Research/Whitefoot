struct Pair {
  f: u64;
  g: u64;
}

fn replace_row(row: &Pair) -> result: unit writes(row) {
  let replacement = Pair(f: 9_u64, g: 1_u64);
  set row^ = replacement;
  return unit;
}

fn need_small_tail(rows: &[Pair]) -> result: unit pure contract {
  requires forall small_tail(k in 1_u64..rows^.len): rows^[k].f <= 7_u64;
} {
  return unit;
}

fn probe(rows: &[Pair]) -> result: unit writes(rows) contract {
  requires forall held_tail(k in 1_u64..rows^.len): rows^[k].f <= 7_u64;
  requires 1_u64 <= rows^.len;
} {
  doc "RANGE-2 forgets every field at the written tuple zero, while every other tuple keeps its old facts.";
  replace_row(row: &rows^[0_u64]);
  need_small_tail(rows: rows);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
