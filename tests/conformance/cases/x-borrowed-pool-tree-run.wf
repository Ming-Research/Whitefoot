alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum PoolError {
  LeftOutOfBounds();
  RightOutOfBounds();
  ArithmeticOverflow();
}

struct Cursor {
  position: u64;
}

fn build(left: &[u64], right: &[u64], cursor: &Cursor, depth: u32) -> function_result: Result<u64, PoolError> writes(left), writes(right), writes(cursor.position) {
  doc "Build a complete tree bottom-up in two parallel runs; index zero is the null sentinel. The three write paths have three distinct roots, so the call site proves them disjoint [EFF-5].";
  let leaves = ishl.wrap(1_u64, depth);
  let start = deref(cursor).position;
  let index_value = 0_u64;
  loop @leaves {
    let done = index_value >= leaves;
    if done {
      break @leaves;
    } else {
      let slot = deref(cursor).position;
      let left_room = deref(left).len;
      let left_ok = slot < left_room;
      if left_ok {
      } else {
        let error = PoolError::LeftOutOfBounds();
        return Err<u64, PoolError>(error: error);
      }
      set deref(left)[slot] = 0_u64;
      let right_room = deref(right).len;
      let right_ok = slot < right_room;
      if right_ok {
      } else {
        let error = PoolError::RightOutOfBounds();
        return Err<u64, PoolError>(error: error);
      }
      set deref(right)[slot] = 0_u64;
      set deref(cursor).position = slot + 1_u64;
      set index_value = index_value + 1_u64;
    }
  }
  let width = leaves;
  loop @levels {
    let complete = width <= 1_u64;
    if complete {
      break @levels;
    } else {
      let half = ishr.wrap(width, 1_u32);
      let next_start = deref(cursor).position;
      let parent = 0_u64;
      loop @parents {
        let parents_done = parent >= half;
        if parents_done {
          break @parents;
        } else {
          let parent_halvable = parent <= 9223372036854775807_u64;
          if parent_halvable {
          } else {
            let error = PoolError::ArithmeticOverflow();
            return Err<u64, PoolError>(error: error);
          }
          let doubled = parent * 2_u64;
          let left_child_defined = start +defined doubled;
          let left_child = if left_child_defined {
            give start + doubled;
          } else {
            let error = PoolError::ArithmeticOverflow();
            return Err<u64, PoolError>(error: error);
          }
          let left_child_incrementable = left_child <= 18446744073709551614_u64;
          if left_child_incrementable {
          } else {
            let error = PoolError::ArithmeticOverflow();
            return Err<u64, PoolError>(error: error);
          }
          let right_child = left_child + 1_u64;
          let slot = deref(cursor).position;
          let left_room = deref(left).len;
          let left_ok = slot < left_room;
          if left_ok {
          } else {
            let error = PoolError::LeftOutOfBounds();
            return Err<u64, PoolError>(error: error);
          }
          set deref(left)[slot] = left_child;
          let right_room = deref(right).len;
          let right_ok = slot < right_room;
          if right_ok {
          } else {
            let error = PoolError::RightOutOfBounds();
            return Err<u64, PoolError>(error: error);
          }
          set deref(right)[slot] = right_child;
          set deref(cursor).position = slot + 1_u64;
          set parent = parent + 1_u64;
        }
      }
      set start = next_start;
      set width = half;
    }
  }
  return Ok<u64, PoolError>(value: start);
}

fn checksum(left: &[u64], right: &[u64], root: u64) -> function_result: Result<u64, PoolError> reads(left), reads(right) {
  doc "Walks the built tree through two read-only range references and counts its nodes.";
  let left_room = deref(left).len;
  let left_ok = root < left_room;
  if left_ok {
  } else {
    let error = PoolError::LeftOutOfBounds();
    return Err<u64, PoolError>(error: error);
  }
  let left_child = deref(left)[root];
  let leaf = left_child == 0_u64;
  if leaf {
    return Ok<u64, PoolError>(value: 1_u64);
  }
  let right_room = deref(right).len;
  let right_ok = root < right_room;
  if right_ok {
  } else {
    let error = PoolError::RightOutOfBounds();
    return Err<u64, PoolError>(error: error);
  }
  let right_child = deref(right)[root];
  let left_count = propagate checksum(left: left, right: right, root: left_child);
  let right_count = propagate checksum(left: left, right: right, root: right_child);
  let child_sum_defined = left_count +defined right_count;
  let children = if child_sum_defined {
    give left_count + right_count;
  } else {
    let error = PoolError::ArithmeticOverflow();
    return Err<u64, PoolError>(error: error);
  }
  let children_countable = children <= 18446744073709551614_u64;
  let total = if children_countable {
    give children + 1_u64;
  } else {
    let error = PoolError::ArithmeticOverflow();
    return Err<u64, PoolError>(error: error);
  }
  return Ok<u64, PoolError>(value: total);
}

fn main() -> status: ExitStatus pure {
  doc "Two parallel heap-resident runs and a cursor field are handed to the builder as three references with three distinct roots, and the checksum walk takes two read-only range references over the same storage. Bounds and arithmetic failures use explicit typed PoolError results, main maps failures to nonzero statuses, and projected access, caller-visible storage, effects, and owner-only cleanup all use the normal compiler path.";
  let left = box_slots_new::<u64>(capacity: 64_u64);
  for @fill_left (
    at in 0_u64..64_u64,
    invariant grown_left: left.inner.len >= at,
    invariant spare_left: left.inner.cap - left.inner.len + at >= 64_u64
  ) {
    place_back(window: &left.inner, value: 0_u64);
  }
  let right = box_slots_new::<u64>(capacity: 64_u64);
  for @fill_right (
    at in 0_u64..64_u64,
    invariant grown_right: right.inner.len >= at,
    invariant spare_right: right.inner.cap - right.inner.len + at >= 64_u64
  ) {
    place_back(window: &right.inner, value: 0_u64);
  }
  let cursor = Cursor(position: 1_u64);
  let depth = 5_u32;
  let left_length = left.inner.len;
  let right_length = right.inner.len;
  let left_out = &left.inner[0_u64..left_length];
  let right_out = &right.inner[0_u64..right_length];
  let built = build(left: left_out, right: right_out, cursor: &cursor, depth: depth);
  match built {
    Ok(value: root) => {
      let left_in = &left.inner[0_u64..left_length];
      let right_in = &right.inner[0_u64..right_length];
      let checksum_result = checksum(left: left_in, right: right_in, root: root);
      match checksum_result {
        Ok(value: nodes) => {
          if nodes == 63_u64 {
          } else {
            return exit_status(code: 201_u8);
          }
        }
        Err(error: checksum_error) => {
          return exit_status(code: 204_u8);
        }
      }
    }
    Err(error: build_error) => {
      return exit_status(code: 203_u8);
    }
  }
  if cursor.position == 64_u64 {
  } else {
    return exit_status(code: 202_u8);
  }
  return exit_status(code: 0_u8);
}
