alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "MSR-3: the element placement. A measured value committed at an element position keeps its measures as facts about P[i], so a window that passed through a written slot still discharges the window operation into it without re-reading cap - len. The retired replace statement also handed the displaced value the position's own facts; that direction has no successor, because one commit writes one place.";
  let blocks = slots_new::<Slots<u8, 8>, 2>();
  let first = slots_new::<u8, 8>();
  place_back(window: &blocks, value: move first);
  let second = slots_new::<u8, 8>();
  set blocks[0_u64] = move second;
  place_back(window: &blocks[0_u64], value: 9_u8);
  let seen = blocks[0_u64][0_u64];
  if seen == 9_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
