enum Op {
  Left();
  Right();
  Halt();
}

fn run(code: &Box<Slots<Op>>, limit: u64) -> r: u64 reads(code) {
  doc "Each input preserves both components of the correlated header equality.";
  let pc = 0_u64;
  let acc = 0_u64;
  let cache = limit;
  if pc < code^.inner.len {
    loop (
      invariant sum: acc + cache == limit
    ) {
      match code^.inner[pc] {
        Left() => {
          set acc = limit;
          set cache = 0_u64;
        }
        Right() => {
          set acc = 0_u64;
          set cache = limit;
        }
        Halt() => {
          return acc;
        }
      }
      invariant joined: acc + cache == limit;
    }
  }
  return acc;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Checks the source relation without executing the probe.";
  return std::process::exit_status(code: 0_u8);
}
