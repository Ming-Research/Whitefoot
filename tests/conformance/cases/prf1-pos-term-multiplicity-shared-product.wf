alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn inner(p: u64, k: u64, j: u64, n: u64) -> at: u64 pure contract {
  requires n <= 1000_u64;
  requires k <= 1000_u64;
  requires p < k;
  requires j < n;
} {
  doc "Two bindings hold the same product; the target names the second, and the fold follows the target rather than the older binding.";
  let span = n * k;
  let first = n * p;
  let second = n * p;
  let at = second + j;
  invariant fits: second + j < span {
    use n times (p < k);
    use (j < n);
  }
  return at;
}

fn main() -> status: ExitStatus pure {
  let at = inner(p: 1_u64, k: 2_u64, j: 3_u64, n: 4_u64);
  return exit_status(code: 0_u8);
}
