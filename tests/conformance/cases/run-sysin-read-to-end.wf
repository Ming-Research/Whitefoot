alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias read_next = std::io::read_next;

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "The ordinary read_next operation takes the input and shared invocation factory state by reference and declares the writes in its row. Repeated Ok endpoints advance the source total to the arranged twenty-one bytes; a later Err(ReadEnd) ends the loop.";
  let Inputs(args: unused_args, cwd: unused_cwd, stdout: unused_stdout, stderr: unused_stderr, handles: entry_factory, stdin: input) = move inputs;
  close_directory(factory: &entry_factory, directory: move unused_cwd);
  let chunk = slots_new::<u8, 8>();
  for @scratch (
    at in 0_u64..8_u64,
    invariant grown: chunk.len >= at,
    invariant vacancy: chunk.cap - chunk.len + at >= 8_u64
  ) {
    place_back(window: &chunk, value: 0_u8);
  }
  let total = 0_u64;
  let outcome = 0_u8;
  let window = &chunk[0_u64..8_u64];
  loop @chunks {
    let ended = 0_u8;
    match read_next(factory: &entry_factory, input: &input, destination: window, start: 0_u64, end: 8_u64) {
      Ok(value: endpoint) => {
        set total = total +wrap endpoint;
      }
      Err(error: read_stop_23) => {
        match read_stop_23 {
          ReadEnd() => {
            set ended = 1_u8;
          }
          ReadFailed(error: problem) => {
            set outcome = 3_u8;
            set ended = 1_u8;
          }
        }
      }
    }
    if ended == 1_u8 {
      break @chunks;
    }
  }
  if outcome == 0_u8 {
    let complete = total == 21_u64;
    if complete {
    } else {
      set outcome = 4_u8;
    }
  }
  return exit_status(code: outcome);
}
