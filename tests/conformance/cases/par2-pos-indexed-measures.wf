fn reduce(count: u64) -> result: u64 pure {
  doc "An in-body length guard reads the unchanged Array descriptor of a runtime-sized array.";
  let cells = box_array_filled::<u64>(count: count, value: 5_u64);
  for (i in 0_u64..8_u64) {
    let bucket = i % 2_u64;
    if bucket < cells.inner.len {
      set cells.inner[bucket] = cells.inner[bucket] +wrap 1_u64;
    }
  }
  if 3_u64 < cells.inner.len {
    return cells.inner[0_u64] +wrap cells.inner[3_u64];
  }
  return 0_u64;
}

fn capacities() -> result: u64 pure {
  doc "An initialized Slots root admits len and cap reads in its body.";
  let initial = array_filled::<u64, 4>(value: 5_u64);
  let cells = slots_from_array::<u64, 4>(values: initial);
  for (i in 0_u64..8_u64) {
    let count = cells.len;
    let capacity = cells.cap;
    let bucket = i % 2_u64;
    set cells[bucket] = cells[bucket] +wrap 1_u64;
  }
  return cells[0_u64] +wrap cells[3_u64];
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Check the independent expected results.";
  let boxed = reduce(count: 4_u64);
  let slotted = capacities();
  if boxed != 14_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  if slotted != 14_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
