alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A cell constructed from Bool yields the original value through its field inner. Normal exit is observed; this case does not count deallocations.";
  let flag = True();
  let owner = box_new::<Bool>(value: flag);
  let loaded = owner.inner;
  if loaded {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
