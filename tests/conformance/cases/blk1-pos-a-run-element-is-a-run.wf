alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "What a slot may hold: a shape's element type is any nameable type, a shape included, so a Slots<Slots<u8, 4>, 2> holds complete inner runs, each with its own descriptor word in its own slot. An element that is a run is affine, so it leaves the outer window through a window operation and comes back with its own window intact, its measures reread at the caller. The exit status is ten times the outer length after the placement plus the outer length after the removal.";
  let outer = slots_new::<Slots<u8, 4>, 2>();
  let inner = slots_new::<u8, 4>();
  place_back(window: &inner, value: 7_u8);
  place_back(window: &inner, value: 9_u8);
  place_back(window: &outer, value: move inner);
  let count = outer.len;
  let first = take_back(window: &outer);
  let emptied = outer.len;
  let width = first.len;
  if width == 2_u64 {
  } else {
    return exit_status(code: 3_u8);
  }
  let front = first[0_u64];
  if front == 7_u8 {
  } else {
    return exit_status(code: 4_u8);
  }
  let back = first[1_u64];
  if back == 9_u8 {
  } else {
    return exit_status(code: 5_u8);
  }
  let tens = count * 10_u64;
  let combined = tens + emptied;
  let code = cvt::<u64, u8>(combined);
  return exit_status(code: code);
}
