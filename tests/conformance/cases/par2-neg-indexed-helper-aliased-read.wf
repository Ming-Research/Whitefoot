fn add_one(p: &Array<u64, 1>) -> result: unit writes(p) {
  doc "Add one to the sole cell.";
  set p^[0_u64] = p^[0_u64] +wrap 1_u64;
  return unit;
}

fn reduce() -> result: u64 pure {
  doc "A call update cannot conceal an ordinary cell read through an alias.";
  let cells = array_filled::<u64, 1>(value: 1_u64);
  let first = &cells;
  let second = first;
  for (i in 0_u64..2_u64) {
    add_one(p: first);
    let observed = second^[0_u64];
  }
  return cells[0_u64];
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Sequential source remains accepted while checker tests observe permission.";
  let observed = reduce();
  return std::process::exit_status(code: 0_u8);
}
