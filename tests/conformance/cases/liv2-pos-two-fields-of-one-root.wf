alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Pair {
  low: u8;
  high: u8;
}

fn two_bytes(bound: u64) -> (small: u8, large: u8) pure {
  doc "Two results from one call.";
  return 4_u8, 9_u8;
}

fn main() -> status: ExitStatus pure {
  doc "SET-1, OWN-7: two distinct fields of one root are non-overlapping places, so each takes its own commit and neither disturbs the other or kills the root. A set target that names a binding in scope is a commit and never a declaration, which is now the only thing a set target can be. The exit code reports the second field.";
  let pair = Pair(low: 0_u8, high: 0_u8);
  let (small, large) = two_bytes(bound: 4_u64);
  set pair.low = small;
  set pair.high = large;
  let total = 0_u8;
  let held = 0_u8;
  let (other_small, other_large) = two_bytes(bound: 4_u64);
  set total = other_small;
  set held = other_large;
  return exit_status(code: pair.high);
}
