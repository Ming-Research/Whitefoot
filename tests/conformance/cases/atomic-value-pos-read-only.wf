fn main() -> status: std::process::ExitStatus pure waits {
  let owner = shared_atomic_new(value: 0_u64);
  let view = shared_read::<AtomicValue>(shared: &owner);
  atomic s = &view {
    let comparison_1 = atomic_load(cell: s);
    if comparison_1 != 0_u64 {
      return std::process::exit_status(code: 1_u8);
    }
  }
  return std::process::exit_status(code: 0_u8);
}
