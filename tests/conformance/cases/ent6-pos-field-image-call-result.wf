struct Exponent {
  value: i64;
  invariant floor(e): -1000_i64 <= e.value;
}

fn make() -> result: Exponent pure {
  return Exponent(value: 0_i64);
}

fn shift(d: u8) -> result: i64 pure {
  let e = make();
  let w = cvt::<u8, i64>(d);
  let r = e.value - w;
  return r;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
