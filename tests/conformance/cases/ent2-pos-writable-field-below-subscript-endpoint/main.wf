alias Entry = pkg::kinds::Entry;
alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias kinds = pkg::kinds;

fn main() -> status: ExitStatus pure {
  doc "ENT-2: an in-bounds mutable integer field below a subscript is an ordinary term, so the counted endpoint names entries[1].head directly.";
  let narrow = kinds::make_entry(width: 3_u64, head: 3_u64);
  let entries = array_filled::<Entry, 4>(value: narrow);
  let total = 0_u64;
  for (c in 0_u64..entries[1_u64].head) {
    set total = total +wrap 1_u64;
  }
  return exit_status(code: 0_u8);
}
