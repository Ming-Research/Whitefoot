alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Held {
  Full(bytes: Slots<u8, 4>);
  Empty();
}

fn pass_held(held: Held) -> result: Held pure contract {
  ensures result.Full.bytes.cap == 4_u64;
} {
  doc "An enum-payload step admits no measure member of a result place: no route selects a variant of an unrouted result, so `result.Full.bytes.cap` is no relation datum.";
  return move held;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
