fn find_one(depth: u64) -> found: Option<u64> pure contract {
  ensures when Some(value: payload): payload == 1_u64;
} {
  if depth > 0_u64 {
    let next = depth - 1_u64;
    let inner = find_one(depth: next);
    match inner {
      Some(value: selected) => {
        let difference = selected - 1_u64;
        return Some<u64>(value: selected);
      }
      None() => {
        return None<u64>();
      }
    }
  }
  return Some<u64>(value: 1_u64);
}

fn main() -> status: std::process::ExitStatus pure {
  let found = find_one(depth: 3_u64);
  match found {
    Some(value: selected) => {
      return std::process::exit_status(code: 0_u8);
    }
    None() => {
      return std::process::exit_status(code: 2_u8);
    }
  }
}
