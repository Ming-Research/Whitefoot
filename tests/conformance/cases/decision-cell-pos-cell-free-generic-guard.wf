fn equal<T: Eq>(value: &T, expected: T) -> result: Bool reads(value) {
  return value^ == expected;
}

fn predicate<T: drop, fn inspect(value: &T) -> result: Bool reads(value)>(value: &T) -> result: Bool reads(value) {
  return inspect(value: value);
}

fn nonzero(value: &u8) -> result: Bool reads(value) {
  return value^ != 0_u8;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let target = shared_new::<u8>(value: 7_u8);
  atomic byte = &target when equal::<u8>(value: byte, expected: 7_u8) {
    set byte^ = 9_u8;
  }
  atomic byte = &target when predicate::<u8, fn nonzero>(value: byte) {
    if byte^ == 9_u8 {
      return std::process::exit_status(code: 0_u8);
    }
  }
  return std::process::exit_status(code: 1_u8);
}
