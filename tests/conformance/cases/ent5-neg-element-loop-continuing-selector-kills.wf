fn probe(values: &Array<u8, 2>, index: u64) -> result: u8 reads(values) contract {
  requires index < values^.len;
  requires 1_u8 <= values^[index];
} {
  let total = 0_u8;
  for (
    pass in 0_u64..2_u64,
    invariant membership: index <= 1_u64
  ) {
    let digit = values^[index] - 1_u8;
    set total = total +wrap digit;
    set index = 1_u64;
  }
  return total;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
