alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn replace_last_report_unspecified(window: &Slots<u64, 8>, value: u64) -> (previous: u64, size: u64) writes(window.last), writes(window.next), writes(window.len) contract {
  requires window^.len > 0_u64;
  ensures size >= 1_u64;
} {
  doc "Returns the replaced value and exit length without promising that the returned length equals the window's exit length.";
  let old = take_back(window: window);
  place_back(window: window, value: value);
  return old, window^.len;
}

fn probe(window: &Slots<u64, 8>) -> result: u64 writes(window) contract {
  requires window^.len >= 1_u64;
} {
  doc "The positive result bound alone cannot prove the window remains nonempty; the caller cannot import that relation from the helper's body.";
  let first = &window^[0_u64];
  let (previous, size) = replace_last_report_unspecified(window: window, value: 7_u64);
  return first^;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
