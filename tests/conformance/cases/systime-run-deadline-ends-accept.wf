alias AcceptedConnection = std::net::AcceptedConnection;
alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias Instant = std::time::Instant;
alias IoError = std::io::IoError;
alias TcpConnection = std::net::TcpConnection;
alias close_directory = std::fs::close_directory;
alias close_directory_write = std::fs::close_directory_write;
alias close_listener = std::net::close_listener;
alias close_receive = std::net::close_receive;
alias close_send = std::net::close_send;
alias exit_status = std::process::exit_status;
alias instant_after = std::time::instant_after;
alias instant_reached = std::time::instant_reached;
alias now = std::time::now;
alias socket_address_v4 = std::net::socket_address_v4;
alias tcp_accept = std::net::tcp_accept;
alias tcp_listen = std::net::tcp_listen;

fn deadline_passed(error: &IoError) -> result: Bool reads(error) {
  doc "Whether an operation's outcome is the passing of its own deadline [PRE-2].";
  match error^ {
    NotFound(code: c, origin: o) => {
      return False();
    }
    PermissionDenied(code: c, origin: o) => {
      return False();
    }
    AlreadyExists(code: c, origin: o) => {
      return False();
    }
    NotDirectory(code: c, origin: o) => {
      return False();
    }
    IsDirectory(code: c, origin: o) => {
      return False();
    }
    DirectoryNotEmpty(code: c, origin: o) => {
      return False();
    }
    ReadOnly(code: c, origin: o) => {
      return False();
    }
    ResourceBusy(code: c, origin: o) => {
      return False();
    }
    InvalidInput(code: c, origin: o) => {
      return False();
    }
    InvalidPath(code: c, origin: o) => {
      return False();
    }
    Unsupported(code: c, origin: o) => {
      return False();
    }
    TimedOut(code: c, origin: o) => {
      return False();
    }
    DeadlinePassed() => {
      return True();
    }
    BrokenPipe(code: c, origin: o) => {
      return False();
    }
    WriteZero(code: c, origin: o) => {
      return False();
    }
    UnexpectedEnd(code: c, origin: o) => {
      return False();
    }
    ConnectionRefused(code: c, origin: o) => {
      return False();
    }
    ConnectionReset(code: c, origin: o) => {
      return False();
    }
    ConnectionAborted(code: c, origin: o) => {
      return False();
    }
    NotConnected(code: c, origin: o) => {
      return False();
    }
    AddressInUse(code: c, origin: o) => {
      return False();
    }
    AddressUnavailable(code: c, origin: o) => {
      return False();
    }
    ResourceExhausted(code: c, origin: o) => {
      return False();
    }
    FileTooLarge(code: c, origin: o) => {
      return False();
    }
    NoSpace(code: c, origin: o) => {
      return False();
    }
    QuotaExceeded(code: c, origin: o) => {
      return False();
    }
    CrossDevice(code: c, origin: o) => {
      return False();
    }
    DeviceFailure(code: c, origin: o) => {
      return False();
    }
    Other(code: c, origin: o) => {
      return False();
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure must_wait {
  doc "An accept on a listener no client reaches, bounded by a deadline 20 milliseconds away, produces DeadlinePassed, and a clock read after it returns a reading at or after the deadline [PRE-2].";
  let Inputs(args: unused_args, cwd: cwd_directory, stdout: unused_stdout, stderr: unused_stderr, handles: handles, stdin: unused_stdin, clock: clock, wall_clock: unused_wall_clock) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  close_directory_write(factory: &handles, directory: move cwd_write);
  close_directory(factory: &handles, directory: move cwd);
  let address = socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: 0_u16);
  match tcp_listen(factory: &handles, address: &address) {
    Ok(value: listener) => {
      let started = now(clock: &clock);
      let soon = instant_after(instant: started, nanoseconds: 20000000_u64);
      let bound = Some<Instant>(value: soon);
      match tcp_accept(factory: &handles, listener: &listener, deadline: bound) {
        Ok(value: accepted) => {
          let AcceptedConnection(connection: link, peer: unused_peer) = move accepted;
          let TcpConnection(receive: link_receive, send: link_send) = move link;
          close_receive(factory: &handles, receive: move link_receive);
          close_send(factory: &handles, send: move link_send);
          close_listener(factory: &handles, listener: move listener);
          return exit_status(code: 10_u8);
        }
        Err(error: problem) => {
          let passed = deadline_passed(error: &problem);
          let after = now(clock: &clock);
          let reached = instant_reached(deadline: soon, instant: after);
          close_listener(factory: &handles, listener: move listener);
          if passed {
            if reached {
              return exit_status(code: 0_u8);
            }
            return exit_status(code: 12_u8);
          }
          return exit_status(code: 11_u8);
        }
      }
    }
    Err(error: problem) => {
      return exit_status(code: 13_u8);
    }
  }
}
