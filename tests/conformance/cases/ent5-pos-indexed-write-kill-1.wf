alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn overwrite(slots: &Slots<u64, 2>, at: u64) -> result: unit writes(slots[at]) contract {
  requires at < deref(slots).len;
} {
  doc "Writes exactly the element position its declared row names; a call to it would kill the facts supported by that element.";
  set deref(slots)[at] = 9_u64;
  return unit;
}

fn read_if_valid(index: u64) -> result: unit pure {
  doc "The unchanged control retains the prewrite range fact of the referenced element: no projected write reaches indices[0], so the guard's bound survives to the subscript [ENT-5, OP-4].";
  let indices = slots_new::<u64, 2>();
  place_back(window: &indices, value: index);
  place_back(window: &indices, value: 9_u64);
  let data = slots_new::<u8, 1>();
  place_back(window: &data, value: 7_u8);
  let guarded = &indices[0_u64];
  let valid = deref(guarded) < 1_u64;
  if valid {
    let observed = data[deref(guarded)];
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "Calls the reader with a zero index.";
  read_if_valid(index: 0_u64);
  return exit_status(code: 0_u8);
}
