alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn open_read_alias(root: u64, path: u64) -> result: u64 pure {
  doc "A source function whose name extends a host function's is an ordinary distinct function; the host function enters no inventory of a source that does not name it [MOD-10].";
  return root;
}

fn main() -> status: ExitStatus pure {
  let opened = open_read_alias(root: 3_u64, path: 4_u64);
  let expected = opened == 3_u64;
  if expected {
    return exit_status(code: 0_u8);
  } else {
    return exit_status(code: 1_u8);
  }
}
