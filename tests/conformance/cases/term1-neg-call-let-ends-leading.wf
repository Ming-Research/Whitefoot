alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn same(value: u64) -> result: u64 pure {
  doc "Returns value.";
  return value;
}

fn count_to(limit: u64) -> result: u64 pure {
  doc "The first statement binds a call's result, which ends the leading statements, so the later test derives no rank [TERM-1].";
  let cursor = 0_u64;
  loop {
    let bound = same(value: limit);
    if cursor >= bound {
      break;
    }
    set cursor = cursor +wrap 1_u64;
  }
  return cursor;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
