alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> return_value: ExitStatus pure {
  doc "OP-2: integer negation has exact, wrap, and checked rows; the exact row is admitted only when its ineg.defined obligation is proved.";
  let wrapped = ineg.wrap(-128_i8);
  if wrapped == -128_i8 {
  } else {
    return exit_status(code: 1_u8);
  }
  let exact = ineg(-42_i8);
  if exact == 42_i8 {
  } else {
    return exit_status(code: 2_u8);
  }
  let checked_minimum = ineg.checked(-128_i8);
  match checked_minimum {
    Ok(value: unexpected_value) => {
      return exit_status(code: 3_u8);
    }
    Err(error: overflow_error) => {
    }
  }
  return exit_status(code: 0_u8);
}
