alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> return_value: ExitStatus pure {
  doc "OP-2: integer negation has exact, wrap, and checked rows; the exact row is admitted only when its ineg.defined obligation is proved. The exact result 42 less the wrapped minimum -128 is the exit status 170.";
  let wrapped = ineg.wrap(-128_i8);
  let exact = ineg(-42_i8);
  let checked_minimum = ineg.checked(-128_i8);
  match checked_minimum {
    Ok(value: unexpected_value) => {
      return exit_status(code: 3_u8);
    }
    Err(error: overflow_error) => {
    }
  }
  let wrapped_wide = cvt::<i8, i16>(wrapped);
  let exact_wide = cvt::<i8, i16>(exact);
  let difference = exact_wide - wrapped_wide;
  let code = cvt::<i16, u8>(difference);
  return exit_status(code: code);
}
