struct Pair {
  f: u64;
  g: u64;
}

fn set_f(row: &Pair) -> result: unit writes(row.f) {
  doc "Writes the exact field the quantified requirement reads.";
  set row^.f = 9_u64;
  return unit;
}

fn need_small(rows: &[Pair]) -> result: unit pure contract {
  requires forall small(k in 0_u64..rows^.len): rows^[k].f <= 7_u64;
} {
  return unit;
}

fn probe(rows: &[Pair]) -> result: unit writes(rows) contract {
  requires forall held_f(k in 0_u64..rows^.len): rows^[k].f <= 7_u64;
  requires 1_u64 <= rows^.len;
} {
  doc "RANGE-2 forgets the written f projection; retaining the other fields cannot prove need_small's RANGE-3 requirement.";
  set_f(row: &rows^[0_u64]);
  need_small(rows: rows);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
