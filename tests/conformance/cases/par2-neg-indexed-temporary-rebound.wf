fn reduce() -> result: u64 pure {
  doc "The update temporary is immutable throughout the body, including after its use.";
  let cells = box_array_filled::<u64>(count: 4_u64, value: 5_u64);
  for (i in 0_u64..4_u64) {
    let bucket = 0_u64;
    let amount = 1_u64;
    let updated = cells.inner[bucket] +wrap amount;
    set cells.inner[bucket] = updated;
    set updated = 9_u64;
  }
  return cells.inner[0_u64];
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Check the independent expected results.";
  let reduced = reduce();
  return std::process::exit_status(code: 0_u8);
}
