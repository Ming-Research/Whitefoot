alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Stamp {
  bytes: Array<u8, 2>;
  tag: u64;
}

const original: Stamp = Stamp(bytes: "ab", tag: 7_u64);

fn main() -> status: ExitStatus pure {
  let duplicate = original;
  set duplicate.tag = 9_u64;
  set duplicate.bytes[1_u64] = 'Z'_u8;
  if duplicate.bytes[1_u64] != 'Z'_u8 {
    return exit_status(code: 2_u8);
  }
  if original.bytes[1_u64] != 'b'_u8 {
    return exit_status(code: 4_u8);
  }
  let copied_tag = duplicate.tag;
  let static_tag = original.tag;
  let tens = copied_tag * 10_u64;
  let combined = tens + static_tag;
  let code = cvt::<u64, u8>(combined);
  return exit_status(code: code);
}
