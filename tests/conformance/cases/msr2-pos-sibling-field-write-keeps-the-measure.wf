alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn filled<T: copy, const n: u64>(value: T) -> result: Slots<T, n> pure contract {
  ensures result.len >= n;
  ensures result.cap <= result.len;
} {
  doc "Builds a window of n slots, every one holding a copy of value; the copy bound is what admits the bare repeated use.";
  let built = slots_new::<T, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: built.len >= at,
    invariant spare: built.cap - built.len + at >= n
  ) {
    place_back(window: &built, value: value);
  }
  return move built;
}

struct Frame {
  flags: u64;
  tail: Slots<u8, 8>;
}

fn main() -> status: ExitStatus pure {
  doc "MSR-2: the support of a measure term over P is P's descriptor storage, not P's root binding. frame.flags and frame.tail are two disjoint parts of one struct, so a SET-1 commit to the sibling field overlaps neither the descriptor storage of frame.tail nor any holder reached to it, and frame.tail.len survives the write. The subscript after the write therefore still discharges against that fact.";
  let body = filled::<u8, 8>(value: 0_u8);
  let frame = Frame(flags: 0_u64, tail: move body);
  let size = frame.tail.len;
  if 3_u64 < size {
    set frame.flags = 1_u64;
    let byte = frame.tail[3_u64];
    if byte == 1_u8 {
      return exit_status(code: 1_u8);
    }
  }
  return exit_status(code: 0_u8);
}
