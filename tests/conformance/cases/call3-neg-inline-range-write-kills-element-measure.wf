alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn refill(part: &[Slots<u64, 8>], at: u64) -> result: unit writes(part) contract {
  requires at < deref(part).len;
} {
  doc "Replaces one element of the range with a full eight-element run.";
  let fresh = slots_new::<u64, 8>();
  for (k in 0_u64..8_u64) {
    if fresh.len < 8_u64 {
      place_back(window: &fresh, value: k);
    }
  }
  set deref(part)[at] = move fresh;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "The guard bounds rows[1_u64].len by cells.len. The call's argument forms its range at the call, &rows[1_u64..3_u64], and [EFF-5] substitutes that formation's path, rows extended by its range step, into the row's writes(part). Element 1 lies inside that range, so [OWN-7] leaves the range step overlapping the index step of rows[1_u64]; the projected write therefore reaches that element's descriptor storage and [CALL-3] kills the guarded measure fact exactly as it would through a bound range reference. The loop's cells[c] therefore owes c < cells.len with no fact to discharge it, and OP-4 rejects; the callee really does replace rows[1_u64] with an eight-element run.";
  let rows = slots_new::<Slots<u64, 8>, 4>();
  let first = slots_new::<u64, 8>();
  let second = slots_new::<u64, 8>();
  let third = slots_new::<u64, 8>();
  place_back(window: &rows, value: move first);
  place_back(window: &rows, value: move second);
  place_back(window: &rows, value: move third);
  let cells = array_filled::<u64, 3>(value: 7_u64);
  let total = 0_u64;
  if rows.len == 3_u64 {
    if rows[1_u64].len <= cells.len {
      refill(part: &rows[1_u64..3_u64], at: 0_u64);
      for (c in 0_u64..rows[1_u64].len) {
        let cell = cells[c];
        set total = total +wrap cell;
      }
    }
  }
  return exit_status(code: 0_u8);
}
