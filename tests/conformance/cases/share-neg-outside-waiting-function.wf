fn peek(cell: &Shared<u8>) -> result: u8 reads(cell) {
  let seen = 0_u8;
  atomic value = &cell^ {
    set seen = value^;
  }
  return seen;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let cell = shared_new::<u8>(value: 3_u8);
  let seen = peek(cell: &cell);
  return std::process::exit_status(code: seen);
}
