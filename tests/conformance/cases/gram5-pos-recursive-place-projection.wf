alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct InnerProjection {
  value: i32;
}

struct OuterProjection {
  inner: InnerProjection;
}

fn read_projection(outer: &OuterProjection) -> return_value: i32 reads(outer.inner.value) {
  doc "A place rooted at a reference parameter resolves to the path that reference names, and the field suffixes follow it [REF-1].";
  return deref(outer).inner.value;
}

fn main() -> return_value: ExitStatus pure {
  doc "GRAM-5: a structural place base can be followed by multiple field suffixes, each denoting one field projection; the base itself is reached through `deref`, because the parameter is a reference and its referent is named by that one step [TYPE-7].";
  let inner = InnerProjection(value: 42_i32);
  let outer = OuterProjection(inner: inner);
  let result = read_projection(outer: &outer);
  if result == 42_i32 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
