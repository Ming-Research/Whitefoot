struct Index {
  value: u64;
  invariant bounded(index): index.value < 16_u64;
}

fn give_broken(flag: Bool, table: &Array<u64, 16>) -> result: u64 reads(table) {
  let idx = Index(value: 3_u64);
  set idx.value = 31_u64;
  let chosen = if flag {
    give idx;
  } else {
    let other = Index(value: 4_u64);
    give other;
  }
  let at = chosen.value;
  let got = table^[at];
  return got;
}
