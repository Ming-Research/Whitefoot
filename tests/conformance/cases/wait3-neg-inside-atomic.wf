fn add(total: Shared<u8>) -> result: unit pure may_wait {
  atomic value = &total {
    set value^ = value^ +wrap 1_u8;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure may_wait {
  let total = shared_new::<u8>(value: 0_u8);
  let other = shared_new::<u8>(value: 0_u8);
  atomic value = &total {
    spawn add(total: move other);
  }
  return std::process::exit_status(code: 0_u8);
}
