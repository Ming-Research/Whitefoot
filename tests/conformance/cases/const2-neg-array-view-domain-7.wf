alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const values: Array<u8, 2> =[0_u8, 0_u8];

fn main() -> status: ExitStatus pure {
  doc "A range reference formed over a const array preserves element bounds and const immutability alike: a named const is never a writable target, so the write through that range reference is refused at the target place.";
  let view = &values[0_u64..2_u64];
  set deref(view)[0_u64] = 1_u8;
  let seen = deref(view)[0_u64];
  return exit_status(code: 0_u8);
}
