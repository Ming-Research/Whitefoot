alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn get(b: &[u8], start: u64) -> result: u8 reads(b) {
  doc "A fact dies at a set commit whose resolved target overlaps the resolved place of any support member [ENT-5](a). The checked branch bounds offset, the later commit kills that old bound, and S5 establishes only offset = start; because start is unbounded, the subscript remains undischarged [OP-4].";
  let spare = deref(b).len;
  let offset = 0_u64;
  let inside = offset < spare;
  if inside {
  } else {
    return 0_u8;
  }
  set offset = start;
  return deref(b)[offset];
}

fn main() -> status: ExitStatus pure {
  doc "No construction is needed to exercise the commit kill.";
  return exit_status(code: 0_u8);
}
