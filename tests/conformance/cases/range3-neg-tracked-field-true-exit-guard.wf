struct Decimal {
  count: u64;
  digits: Array<u8, 1>;
}

fn corrupt(decimal: &Decimal) -> result: unit writes(decimal) contract {
  requires decimal^.count == 0_u64;
  ensures forall leading(k in 0_u64..1_u64) when 0_u64 < decimal^.count: 1_u8 <= decimal^.digits[k];
} {
  doc "The entry guard was false, but setting the exit count to one makes the conclusion owed and the zero digit refutes it at return.";
  set decimal^.count = 1_u64;
  set decimal^.digits[0_u64] = 0_u8;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
