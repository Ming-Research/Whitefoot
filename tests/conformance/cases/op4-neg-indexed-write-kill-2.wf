alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn overwrite(cell: &Slots<u64, 2>, at: u64) -> result: unit writes(cell[at]) contract {
  requires at < deref(cell).len;
} {
  doc "Writes one new value at the slot its own index argument names.";
  set deref(cell)[at] = 9_u64;
  return unit;
}

fn read_if_valid(index: u64) -> result: unit pure {
  doc "OP-4, ENT-5: the guarded fact about the value a reference names is killed by a projected callee write onto exactly that slot, while the reference itself stays valid because the written path is not a proper prefix of it. The later subscript therefore has no bound left.";
  let indices = slots_new::<u64, 2>();
  place_back(window: &indices, value: index);
  place_back(window: &indices, value: 9_u64);
  let data = slots_new::<u8, 1>();
  place_back(window: &data, value: 7_u8);
  let guarded = &indices[0_u64];
  let valid = deref(guarded) < 1_u64;
  if valid {
    overwrite(cell: &indices, at: 0_u64);
    let observed = data[deref(guarded)];
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  read_if_valid(index: 0_u64);
  return exit_status(code: 0_u8);
}
