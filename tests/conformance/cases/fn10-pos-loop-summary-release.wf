alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Cell {
  value: u64;
}

fn walk(n: u64, target: &Cell) -> result: u64 writes(target) {
  if n == 0_u64 {
    return deref(target).value;
  }
  let next = n - 1_u64;
  let initial = Cell(value: 0_u64);
  let owner = box_new::<Cell>(value: initial);
  let held = &owner.inner.value;
  let cursor = target;
  let done = False();
  loop {
    set deref(cursor) = Cell(value: 7_u64);
    set cursor = target;
    if done {
      return musttail walk(n: next, target: target);
    }
    set done = True();
    set cursor = &owner.inner;
  }
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  doc "The settled loop summary includes the local owner. Its possible prefix write invalidates held before the tail transfer, so the unreferenced owner can be released.";
  let cell = Cell(value: 0_u64);
  let result = walk(n: 3_u64, target: &cell);
  if result != 7_u64 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
