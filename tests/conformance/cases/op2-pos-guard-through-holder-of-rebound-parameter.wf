fn probe(p: &u64, other: &u64, flip: Bool) -> result: u64 reads(p) {
  doc "The control for op2-neg-guard-through-holder-of-rebound-parameter: the guard and the divisor are both read through saved.";
  let saved = &p^;
  if flip {
    set p = &other^;
  }
  if saved^ != 0_u64 {
    let r = 10_u64 / saved^;
    return r;
  }
  return 0_u64;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The first cell holds five, so the guarded division returns two.";
  let five = 5_u64;
  let zero = 0_u64;
  let flip = 0_u64 == 0_u64;
  let r = probe(p: &five, other: &zero, flip: flip);
  if r == 2_u64 {
    return std::process::exit_status(code: 0_u8);
  }
  return std::process::exit_status(code: 1_u8);
}
