struct Cursor {
  k: u64;
  other: u64;
}

fn select(table: &[Slots<u8, 8>], s: &Cursor, i: u64) -> result: u8 reads(table), writes(s) contract {
  requires s^.k < table^.len;
} {
  doc "ENT-5 and OWN-7: a write through an exact alias overlaps the field supplying the selected row offset. The requirement still proves the outer bound, but the old inner guard must not justify the new row's element read.";
  if i < table^[s^.k].len {
    let cursor_ref = s;
    set cursor_ref^.k = 0_u64;
    return table^[s^.k][i];
  }
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The nested element read must reject OP-4 although its outer bound is proved.";
  return std::process::exit_status(code: 0_u8);
}
