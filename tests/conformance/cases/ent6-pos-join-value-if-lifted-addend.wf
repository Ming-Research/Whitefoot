alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const values: Array<u8, 4> =[1_u8, 2_u8, 3_u8, 4_u8];

fn main() -> status: ExitStatus pure {
  doc "The same even-index fold with the choice lifted out of the control join and into the addend. The value_if delivers one owned value under [GIVE-1], the body applies one unconditional update, and the single value image leaves nothing for the [ENT-6] join to weaken. The local invariant bounds the delivered addend by the byte ceiling, so [INV-1] re-establishes the header target on the one incoming edge and [OP-2] admits the exact addition; the explicit control observes 2 + 4.";
  let sum = 0_u32;
  for (
    i in 0_u64..4_u64,
    invariant sum_bound: sum <= 255_u32 * i
  ) {
    let byte = values[i];
    let wide = cvt::<u8, u32>(byte);
    let zero = 0_u32;
    let parity = iand(wide, 1_u32);
    let is_odd = parity == 1_u32;
    let addend = if is_odd {
      give zero;
    } else {
      give wide;
    }
    invariant addend_bound: addend <= 255_u32;
    set sum = sum + addend;
  }
  let folded = sum == 6_u32;
  if folded {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
