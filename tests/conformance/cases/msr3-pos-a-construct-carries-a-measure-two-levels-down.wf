alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Inner {
  samples: Slots<u32, 4>;
}

struct Outer {
  inner: Inner;
}

fn main() -> status: ExitStatus pure {
  doc "MSR-3: the construct placement is per placement, not per depth. MSR-1 admits a measure place formed with any number of field selections, so the first operand names one measured place at inner.samples; the second construct renames that place to outer.inner.samples and carries its measures with it, which is what discharges the subscript's OP-4 obligation two levels down.";
  let made = slots_new::<u32, 4>();
  place_back(window: &made, value: 1_u32);
  let inner = Inner(samples: move made);
  let outer = Outer(inner: move inner);
  let size = outer.inner.samples.len;
  if size == 1_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  let first = outer.inner.samples[0_u64];
  if first == 1_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
