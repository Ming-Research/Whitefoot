alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A character literal is an integer literal of its suffix type whose value is the scalar value of its one text item, spelled raw, as a named escape, or as a hexadecimal scalar. The program subtracts each scalar value from its literal and returns the sum of the differences, zero, as its exit status.";
  let letter = 'a'_u8 - 97_u8;
  let space = ' '_u8 - 32_u8;
  let tilde = '~'_u8 - 126_u8;
  let double = '"'_u8 - 34_u8;
  let single = '\''_u8 - 39_u8;
  let backslash = '\\'_u8 - 92_u8;
  let newline = '\n'_u8 - 10_u8;
  let zero = '\u{0}'_u8 - 0_u8;
  let delete = '\u{7f}'_u8 - 127_u8;
  let accent = '\u{e9}'_u32 - 233_u32;
  let last = '\u{10ffff}'_u32 - 1114111_u32;
  let wide = 'A'_u32 - 65_u32;
  let narrow_two = letter + space;
  let narrow_three = narrow_two + tilde;
  let narrow_four = narrow_three + double;
  let narrow_five = narrow_four + single;
  let narrow_six = narrow_five + backslash;
  let narrow_seven = narrow_six + newline;
  let narrow_eight = narrow_seven + zero;
  let narrow_all = narrow_eight + delete;
  let wide_two = accent + last;
  let wide_all = wide_two + wide;
  let wide_byte = cvt::<u32, u8>(wide_all);
  let code = narrow_all + wide_byte;
  return exit_status(code: code);
}
