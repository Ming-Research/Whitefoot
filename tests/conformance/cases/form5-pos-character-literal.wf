alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A character literal is an integer literal of its suffix type whose value is the scalar value of its one text item, spelled raw, as one of the three escapes, or as a hexadecimal scalar.";
  let letter = 'a'_u8 == 97_u8;
  if letter {
  } else {
    return exit_status(code: 1_u8);
  }
  let space = ' '_u8 == 32_u8;
  if space {
  } else {
    return exit_status(code: 2_u8);
  }
  let tilde = '~'_u8 == 126_u8;
  if tilde {
  } else {
    return exit_status(code: 3_u8);
  }
  let double = '"'_u8 == 34_u8;
  if double {
  } else {
    return exit_status(code: 4_u8);
  }
  let single = '\''_u8 == 39_u8;
  if single {
  } else {
    return exit_status(code: 5_u8);
  }
  let backslash = '\\'_u8 == 92_u8;
  if backslash {
  } else {
    return exit_status(code: 6_u8);
  }
  let newline = '\n'_u8 == 10_u8;
  if newline {
  } else {
    return exit_status(code: 7_u8);
  }
  let zero = '\u{0}'_u8 == 0_u8;
  if zero {
  } else {
    return exit_status(code: 8_u8);
  }
  let delete = '\u{7f}'_u8 == 127_u8;
  if delete {
  } else {
    return exit_status(code: 9_u8);
  }
  let accent = '\u{e9}'_u32 == 233_u32;
  if accent {
  } else {
    return exit_status(code: 10_u8);
  }
  let last = '\u{10ffff}'_u32 == 1114111_u32;
  if last {
  } else {
    return exit_status(code: 11_u8);
  }
  let wide = 'A'_u32 == 65_u32;
  if wide {
  } else {
    return exit_status(code: 12_u8);
  }
  return exit_status(code: 0_u8);
}
