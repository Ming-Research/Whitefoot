alias MeterScope = std::process::MeterScope;
alias MemoryMeter = std::process::MemoryMeter;
alias ScopeView = std::process::ScopeView;
alias ScopeBody = std::process::ScopeBody;

fn build(argument: Option<u64>) -> result: Box<u64> pure waits {
  return box_new::<u64>(value: 47_u64);
}

fn release(value: Box<u64>) -> result: unit pure {
  return unit;
}

fn inherited(argument: ScopeView) -> result: u8 pure waits {
  let before = std::process::scope_bytes(view: &argument);
  let block = spawn build(argument: before);
  let payload = block.inner == 47_u64;
  let held = std::process::scope_bytes(view: &argument);
  release(value: move block);
  let after = std::process::scope_bytes(view: &argument);
  let wrong_payload = bnot(payload);
  if wrong_payload {
    return 10_u8;
  }
  match before {
    None() => {
      return 11_u8;
    }
    Some(value: baseline) => {
      match held {
        None() => {
          return 12_u8;
        }
        Some(value: live) => {
          match after {
            None() => {
              return 13_u8;
            }
            Some(value: empty) => {
              let expected = baseline +wrap 8_u64;
              if live != expected {
                return 14_u8;
              }
              if empty != baseline {
                return 15_u8;
              }
              return 0_u8;
            }
          }
        }
      }
    }
  }
}

binding Inherited : ScopeBody<ScopeView, u8> {
  run = inherited;
}

fn close(meter: &MemoryMeter, scope: MeterScope) -> result: unit writes(meter) {
  loop {
    let closed = std::process::scope_close(meter: meter, scope: move scope);
    match move closed {
      Ok(value: done) => {
        return done;
      }
      Err(error: owner) => {
        set scope = move owner;
      }
    }
  }
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  let std::process::Inputs(cwd: directory, handles: handles, memory_meter: meter, ..) = move inputs;
  let std::fs::Directory(read: read, write: write) = move directory;
  std::fs::close_directory_write(factory: &handles, directory: move write);
  std::fs::close_directory(factory: &handles, directory: move read);
  let opened = std::process::scope_open(meter: &meter);
  match move opened {
    Err(error: full) => {
      return std::process::exit_status(code: 2_u8);
    }
    Ok(value: scope) => {
      let view = std::process::scope_view(scope: &scope);
      let outcome = spawn std::process::scope_run::<Inherited>(scope: move scope, argument: move view);
      match move outcome {
        Refused(scope: owner, argument: original) => {
          close(meter: &meter, scope: move owner);
          return std::process::exit_status(code: 3_u8);
        }
        Ran(scope: owner, result: code) => {
          close(meter: &meter, scope: move owner);
          return std::process::exit_status(code: code);
        }
      }
    }
  }
}
