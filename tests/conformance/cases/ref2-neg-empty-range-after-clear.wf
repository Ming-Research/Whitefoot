fn main() -> status: std::process::ExitStatus pure {
  doc "OP-10, REF-2: an empty range formed before clear is still formed under 0 <= len after it, but clear ends every reference into its window, an empty range included.";
  let bytes = box_slots_new::<u8>(capacity: 4_u64);
  let none = &bytes.inner[0_u64..0_u64];
  clear(window: &bytes.inner);
  let count = none^.len;
  return std::process::exit_status(code: 0_u8);
}
