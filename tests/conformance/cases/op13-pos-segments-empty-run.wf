alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "No lengths at all build an empty run: its segment count is zero and the run of all its elements is empty.";
  let lengths = box_array_filled::<u64>(count: 1_u64, value: 3_u64);
  let empty = box_segments_filled::<u64>(lengths: &lengths.inner[0_u64..0_u64], value: 9_u64);
  let count = empty.inner.len;
  if count != 0_u64 {
    return exit_status(code: 1_u8);
  }
  let joined = &empty.inner.all;
  let size = joined^.len;
  if size != 0_u64 {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
