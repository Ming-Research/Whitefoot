fn probe(left: u64, right: u64, flag: Bool) -> result: unit pure {
  doc "ENT-5's finite candidate rule also bounds delivery: the images cursor <= 3 and cursor >= 5 only derive cursor != 4, so INV-1 refuses the later invariant.";
  if left < 4_u64 {
  }
  let cursor = if flag {
    if 3_u64 < left {
      return unit;
    }
    give left;
  } else {
    if right < 5_u64 {
      return unit;
    }
    give right;
  };
  if cursor <= 4_u64 {
    invariant tightened: cursor <= 3_u64;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
