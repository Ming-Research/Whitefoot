const names: Array<u8, 1> =[97_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let keys = key_set_new(capacity: 1_u64);
  key_set_insert(keys: &keys, key: &names[0_u64..1_u64]);
  let buffer = array_filled::<u8, 1>(value: 0_u8);
  let length = key_set_read_key(keys: &keys, index: 1_u64, out: &buffer[0_u64..1_u64]);
  let code = cvt.wrap::<u64, u8>(length);
  return std::process::exit_status(code: code);
}
