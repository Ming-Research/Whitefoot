alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Sign {
  Neg();
  Zero();
  Pos();
}

fn main() -> status: ExitStatus pure {
  doc "IDENT, TYPEID, LABEL (@l) and OPNAME (+checked) lexical classes used canonically [FORM-3]; the REGIONID class is gone with regions, and a reference is written with the bare `&` and read through `deref`.";
  let a = 3_i32;
  let p = &a;
  loop @l {
    break @l;
  }
  let v = match deref(p) +checked 1_i32 {
    Ok(value: w) => {
      give w;
    }
    Err(error: e) => {
      return exit_status(code: 1_u8);
    }
  }
  if v == 4_i32 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
