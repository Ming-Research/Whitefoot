alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Flag {
  First();
  Second();
}

fn make_ok(value: u64) -> function_result: Result<u64, Flag> pure {
  return Ok<u64, Flag>(value: value);
}

fn make_err(second: Bool) -> function_result: Result<u64, Flag> pure {
  if second {
    let second_atom_0001 = Flag::Second();
    return Err<u64, Flag>(error: second_atom_0001);
  } else {
    let first_atom_0002 = Flag::First();
    return Err<u64, Flag>(error: first_atom_0002);
  }
}

fn result_code(result: Result<u64, Flag>) -> function_result: u64 pure {
  match result {
    Ok(value: ok_value) => {
      return ok_value;
    }
    Err(error: result_error) => {
      match result_error {
        First() => {
          return 10_u64;
        }
        Second() => {
          return 20_u64;
        }
      }
    }
  }
}

fn make_some(second: Bool) -> function_result: Option<Flag> pure {
  if second {
    let second_atom_0003 = Flag::Second();
    return Some<Flag>(value: second_atom_0003);
  } else {
    let first_atom_0004 = Flag::First();
    return Some<Flag>(value: first_atom_0004);
  }
}

fn make_none() -> function_result: Option<Flag> pure {
  return None<Flag>();
}

fn option_code(option: Option<Flag>) -> function_result: u64 pure {
  match option {
    None() => {
      return 30_u64;
    }
    Some(value: option_value) => {
      match option_value {
        First() => {
          return 40_u64;
        }
        Second() => {
          return 50_u64;
        }
      }
    }
  }
}

fn main() -> status: ExitStatus pure {
  let ok = make_ok(value: 7_u64);
  let ok_code = result_code(result: ok);
  if ok_code == 7_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  let false_atom_0005 = False();
  let first_error = make_err(second: false_atom_0005);
  let first_code = result_code(result: first_error);
  if first_code == 10_u64 {
  } else {
    return exit_status(code: 202_u8);
  }
  let true_atom_0006 = True();
  let second_error = make_err(second: true_atom_0006);
  let second_code = result_code(result: second_error);
  if second_code == 20_u64 {
  } else {
    return exit_status(code: 203_u8);
  }
  let false_atom_0007 = False();
  let some_first = make_some(second: false_atom_0007);
  let some_first_code = option_code(option: some_first);
  if some_first_code == 40_u64 {
  } else {
    return exit_status(code: 204_u8);
  }
  let true_atom_0008 = True();
  let some_second = make_some(second: true_atom_0008);
  let some_second_code = option_code(option: some_second);
  if some_second_code == 50_u64 {
  } else {
    return exit_status(code: 205_u8);
  }
  let none = make_none();
  let none_code = option_code(option: none);
  if none_code == 30_u64 {
  } else {
    return exit_status(code: 206_u8);
  }
  return exit_status(code: 0_u8);
}
