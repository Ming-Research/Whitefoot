alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A counted loop and affine invariant prove every exact sum step before execution: sum 0..4 == 10.";
  let sum = 0_u64;
  for (
    i in 0_u64..5_u64,
    invariant sum_bound: sum <= 5_u64 * i
  ) {
    set sum = sum + i;
  }
  if sum == 10_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  let doubled = match sum *checked 2_u64 {
    Ok(value: d) => {
      give d;
    }
    Err(error: e) => {
      return exit_status(code: 203_u8);
    }
  }
  let code = cvt::<u64, u8>(doubled);
  return exit_status(code: code);
}
