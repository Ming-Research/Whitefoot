alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn sumto(n: i32) -> result: i32 pure {
  doc "Recursion is permitted [FN-6]. The guard discharges the exact decrement domain, while the bounded fixture uses wrapping accumulation because arithmetic behavior is not this case's subject.";
  if n <= 0_i32 {
    return 0_i32;
  } else {
    let m = n - 1_i32;
    let r = sumto(n: m);
    return n +wrap r;
  }
}

fn main() -> status: ExitStatus pure {
  let s = sumto(n: 4_i32);
  if s == 10_i32 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
