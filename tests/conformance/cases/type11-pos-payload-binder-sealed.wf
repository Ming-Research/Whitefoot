struct Stack {
  slots: Slots<u64, 8>;
  invariant nonempty(stack): stack.slots.len >= 1_u64;
}

fn fresh(first: u64) -> made: Stack pure {
  let slots = slots_new::<u64, 8>();
  place_back(window: &slots, value: first);
  let stack = Stack(slots: move slots);
  return move stack;
}

fn maybe_fresh(first: u64) -> made: Option<Stack> pure {
  let stack = fresh(first: first);
  return Some<Stack>(value: move stack);
}

fn fallible(first: u64) -> made: Result<Stack, u32> pure {
  let stack = fresh(first: first);
  return Ok<Stack, u32>(value: move stack);
}

fn parameter_payload(maybe: Option<Stack>) -> result: u64 pure {
  match move maybe {
    Some(value: stack) => {
      let got = stack.slots[0_u64];
      return got;
    }
    None() => {
      return 0_u64;
    }
  }
}

fn result_payload() -> result: u64 pure {
  let maybe = maybe_fresh(first: 3_u64);
  match move maybe {
    Some(value: stack) => {
      let got = stack.slots[0_u64];
      return got;
    }
    None() => {
      return 0_u64;
    }
  }
}

fn propagated() -> result: Result<u64, u32> pure {
  let stack = propagate fallible(first: 3_u64);
  let got = stack.slots[0_u64];
  return Ok<u64, u32>(value: got);
}
