alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Pick {
  Zero();
  Wide();
}

fn get(b: &[u8], i: u64, choice: Pick) -> result: u8 reads(b) {
  let spare = deref(b).len;
  let cursor = i;
  match choice {
    Zero() => {
      set cursor = 0_u64;
    }
    Wide() => {
      let inside = i < spare;
      if inside {
      } else {
        return 0_u8;
      }
    }
  }
  return deref(b)[cursor];
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
