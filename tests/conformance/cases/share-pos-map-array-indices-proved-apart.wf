const names: Array<u8, 1> =[97_u8];

struct Store {
  dbs: Array<ConcurrentHashMap<u8>, 4>;
}

fn shift(source: &ConcurrentHashMap<u8>, target: &ConcurrentHashMap<u8>, key: &[u8]) -> result: unit reads(key), writes(source), writes(target) {
  doc "Moves the entry under the key from the source map to the target map.";
  let taken = source^[key];
  set target^[key] = taken;
  set source^[key] = None<u8>();
  return unit;
}

fn transfer(store: &Shared<Store>, i: u64, j: u64, key: &[u8]) -> result: unit reads(store), reads(key) waits contract {
  requires i < 4_u64;
  requires j < 4_u64;
} {
  doc "Moves the entry under the key from database i to database j in one statement, on the path where the check proves the two numbers different.";
  if i != j {
    atomic s = &store^ {
      shift(source: &s^.dbs[i], target: &s^.dbs[j], key: key);
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  doc "The entry written in database 2 moves to database 3; a second transfer from database 3 to itself takes the path the check refuses and changes nothing.";
  let zero = map_new::<u8>(capacity: 1_u64);
  let one = map_new::<u8>(capacity: 1_u64);
  let two = map_new::<u8>(capacity: 1_u64);
  let three = map_new::<u8>(capacity: 1_u64);
  let slots = slots_new::<ConcurrentHashMap<u8>, 4>();
  place_back(window: &slots, value: move zero);
  place_back(window: &slots, value: move one);
  place_back(window: &slots, value: move two);
  place_back(window: &slots, value: move three);
  let dbs = slots_into_array::<ConcurrentHashMap<u8>, 4>(values: move slots);
  let state = Store(dbs: move dbs);
  let store = shared_new::<Store>(value: move state);
  let key = &names[0_u64..1_u64];
  atomic s = &store {
    set s^.dbs[2_u64][key] = Some<u8>(value: 7_u8);
  }
  transfer(store: &store, i: 2_u64, j: 3_u64, key: key);
  transfer(store: &store, i: 3_u64, j: 3_u64, key: key);
  let left = 0_u64;
  let moved = 0_u64;
  let found = None<u8>();
  atomic s = &store {
    set left = map_count::<u8>(map: &s^.dbs[2_u64]);
    set moved = map_count::<u8>(map: &s^.dbs[3_u64]);
    set found = s^.dbs[3_u64][key];
  }
  let hundreds = left *wrap 100_u64;
  let tens = moved *wrap 10_u64;
  let counts = hundreds +wrap tens;
  let code = cvt.wrap::<u64, u8>(counts);
  match found {
    Some(value: seen) => {
      set code = code +wrap seen;
    }
    None() => {
    }
  }
  return std::process::exit_status(code: code);
}
