struct Reading {
  value: i64;
}

fn make() -> made: Reading pure contract {
  ensures -1000_i64 <= made.value;
} {
  doc "The construction carries 0 into the field the postcondition names.";
  return Reading(value: 0_i64);
}

fn scramble(value: i64) -> result: i64 pure {
  doc "Returns three times value, wrapped.";
  let mixed = value *wrap 3_i64;
  return mixed;
}

fn shift(d: u8) -> result: i64 pure {
  doc "The in-place update commits a call result to the local's field, whose image is a fresh atom and loses the call result's bound, so the subtraction of a widened byte may overflow.";
  let e = make();
  set e.value = scramble(value: e.value);
  let w = cvt::<u8, i64>(d);
  let v = e.value - w;
  return v;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
