alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Slot {
  value: i32;
}

fn bump(target: &Slot) -> result: unit writes(target.value) {
  doc "The declared write on the referenced field reaches the caller's own storage.";
  set deref(target).value = 42_i32;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "A write declared on a reference parameter updates the caller's actual storage and the value remains after the call returns.";
  let a = Slot(value: 0_i32);
  bump(target: &a);
  if a.value != 42_i32 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
