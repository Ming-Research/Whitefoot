fn make(index: &u64) -> result: Slots<u64, 4> writes(index) contract {
  ensures index^ == 1_u64;
  ensures result.len == 1_u64;
} {
  set index^ = 1_u64;
  let slots = slots_new::<u64, 4>();
  place_back(window: &slots, value: 7_u64);
  return move slots;
}

fn probe(rows: &Paged<Slots<u64, 4>>) -> result: unit writes(rows) contract {
  requires rows^.pages.len >= 2_u64;
} {
  let index = 0_u64;
  if rows^.pages[index].len > 0_u64 {
    set rows^.pages[index][0_u64] = make(index: &index);
    if rows^.pages[index].len > 0_u64 {
      let value = rows^.pages[index][0_u64][0_u64];
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
