struct Pair {
  left: u64;
  right: u64;
}

fn observe(left: &u64, right: &u64) -> result: Pair reads(left), reads(right) contract {
  requires held(left, right);
} {
  return Pair(left: left^, right: right^);
}

fn sample(pair: &Shared<Pair>, use_local: Bool) -> result: Pair reads(pair) waits {
  let local = 0_u64;
  atomic current = &pair^ {
    let chosen = &current^.right;
    if use_local {
      set chosen = &local;
    }
    return observe(left: &current^.left, right: chosen);
  }
}
