struct Pair {
  left: u64;
  right: u64;
}

fn observe(left: &u64, right: &u64) -> result: Pair reads(left), reads(right) contract {
  requires held(left, right);
} {
  return Pair(left: left^, right: right^);
}

fn sample(left: &Shared<u64>, right: &Shared<u64>, use_local: Bool) -> result: Pair reads(left), reads(right) waits {
  let local = 0_u64;
  atomic current_left = &left^, current_right = &right^ {
    let chosen = current_right;
    if use_local {
      set chosen = &local;
    }
    return observe(left: current_left, right: chosen);
  }
}
