alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn pause() -> result: unit pure waits {
  doc "Declares waits but returns at once.";
  return unit;
}

fn spin() -> result: unit pure waits {
  doc "The loop calls a function that declares waits, but only a call of a host module's waiting function waits for the host, so the loop has no wait and no rank [TERM-1, PRE-2].";
  loop {
    pause();
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
