fn nonzero(value: u64) -> result: unit pure contract {
  requires value != 0_u64;
} {
  return unit;
}

fn selected(value: u64, stop: Bool) -> result: unit pure {
  match value {
    0_u64 => {
      return unit;
    }
    else => {
      loop {
        nonzero(value: value);
        set value = 0_u64;
        if stop {
          break;
        }
      }
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
