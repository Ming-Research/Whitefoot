fn need(xs: &Array<u64, 4>, n: u64) -> result: unit pure contract {
  requires forall small(k in 0_u64..n): xs^[k] < 4_u64;
} {
  return unit;
}

fn caller(xs: &Array<u64, 4>) -> result: unit writes(xs) {
  doc "The write through w makes n four; the range walk may not keep its earlier value, so small is owed over all four elements and only the first is known to be below four.";
  let n = 1_u64;
  let w = &n;
  set w^ = 4_u64;
  set xs^[0_u64] = 0_u64;
  need(xs: xs, n: n);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
