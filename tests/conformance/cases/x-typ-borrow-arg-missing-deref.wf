alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Point {
  x: i32;
  y: i32;
}

fn takes_i32(value: i32) -> function_result: unit pure {
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "A reference formed over a field names that field's path [REF-1], but the reference variable denotes the reference and the field is reached only through deref, so the bare reference at a call argument whose parameter is own i32 is the missing dereference [TYPE-7]; the mechanical fix is deref(r).";
  let p = Point(x: 7_i32, y: 9_i32);
  let r = &p.x;
  let a = takes_i32(value: r);
  return exit_status(code: 0_u8);
}
