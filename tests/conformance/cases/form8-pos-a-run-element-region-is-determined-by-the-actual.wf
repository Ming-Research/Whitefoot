alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn width_of<T>(blocks: &Slots<T, 4>) -> taken: Option<T> writes(blocks.last), writes(blocks.len) contract {
  requires deref(blocks).len > 0_u64;
} {
  doc "Takes one block off the back of a run of runs, generic over the element type [OP-10].";
  let one = take_back(window: blocks);
  return Some<T>(value: move one);
}

fn main() -> status: ExitStatus pure {
  doc "FN-2: a type parameter occupying a position at any depth of a written argument is supplied explicitly at the call exactly as a top-level one is. The element type here is itself a boxed runtime-capacity run [TYPE-9], which is what lets one helper serve a run of runs.";
  let blocks = slots_new::<Box<Slots<u8>>, 4>();
  let block = box_slots_new::<u8>(capacity: 16_u64);
  place_back(window: &blocks, value: move block);
  let taken = width_of::<Box<Slots<u8>>>(blocks: &blocks);
  match taken {
    None() => {
      return exit_status(code: 1_u8);
    }
    Some(value: got) => {
      let width = got.inner.cap;
      if width == 16_u64 {
      } else {
        return exit_status(code: 2_u8);
      }
    }
  }
  let left = blocks.len;
  if left == 0_u64 {
  } else {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
