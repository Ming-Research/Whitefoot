struct Cursor {
  k: u64;
  other: u64;
}

fn select(table: &[Slots<u8, 8>], s: &Cursor, i: u64) -> result: u8 reads(table), reads(s.k) contract {
  requires s^.k < table^.len;
} {
  doc "ENT-2 and ENT-5: an exact local reference alias has the same proof path as its source. Reading the guarded row through that alias cannot attach its shorter scope to the preexisting fact.";
  if i < table^[s^.k].len {
    if i == i {
      let alias = s;
      let observed = table^[alias^.k].len;
    }
    return table^[s^.k][i];
  }
  return 0_u8;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The nested scope ends before the guarded read; its exact alias must not kill the original bound.";
  return std::process::exit_status(code: 0_u8);
}
