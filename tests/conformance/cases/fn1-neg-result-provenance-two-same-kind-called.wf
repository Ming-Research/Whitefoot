alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Cell {
  value: i32;
}

fn pick(a: &Cell, b: &Cell) -> result: i32 reads(a.value), reads(b.value) {
  let seen = deref(a).value +wrap deref(b).value;
  return &deref(a).value;
}

fn main() -> status: ExitStatus pure {
  doc "The still-illegal form with a call site present: `pick` hands a reference back out of its frame, which REF-3 refuses at the returned `borrow_expr` in the callee. The caller is retained deliberately, so the case pins that the declaration is still the reported error when a call exists; fn1-neg-result-provenance-two-same-kind pins the same declaration with no caller at all.";
  let v = Cell(value: 1_i32);
  let w = Cell(value: 2_i32);
  let r = pick(a: &v, b: &w);
  return exit_status(code: 0_u8);
}
