fn probe(r: &[Slots<u8, 8>]) -> result: u8 writes(r) contract {
  requires r^.len >= 1_u64;
  requires r^[0_u64].len >= 5_u64;
} {
  doc "ENT-2, ENT-5, OP-4: replacing an element through the range alias q writes the storage of r^[0_u64], so the requirement on its length dies and the fresh element, which is empty, refutes the read through r.";
  let q = r;
  set q^[0_u64] = slots_new::<u8, 8>();
  let x = r^[0_u64][4_u64];
  return x;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "No call is needed to exercise the proof identity.";
  return std::process::exit_status(code: 0_u8);
}
