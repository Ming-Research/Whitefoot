struct ZeroesAliasReturnReset {
  cells: Array<u64, 1>;
  invariant(c): forall zero(k in 0_u64..c^.cells.len): c^.cells[k] == 0_u64;
}

fn need_aliasreturnreset(z: &ZeroesAliasReturnReset) -> result: unit pure {
  return unit;
}

fn update_aliasreturnreset(first: Shared<ZeroesAliasReturnReset>, second: Shared<ZeroesAliasReturnReset>) -> result: unit pure waits {
  atomic a = &first, b = &second {
    set a^.cells[0_u64] = 1_u64;
    set a^.cells[0_u64] = 0_u64;
    need_aliasreturnreset(z: b);
    return unit;
  }
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
