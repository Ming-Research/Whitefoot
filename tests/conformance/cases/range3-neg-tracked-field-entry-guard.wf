struct Decimal {
  count: u64;
  digits: Array<u8, 1>;
}

fn clear(decimal: &Decimal) -> result: unit writes(decimal) contract {
  requires 0_u64 < decimal^.count;
  ensures forall leading(k in 0_u64..1_u64) when 0_u64 < entry(decimal)^.count: 1_u8 <= decimal^.digits[k];
} {
  doc "The entry-qualified count keeps its positive entry image after the live count is cleared; the exit digit zero therefore refutes the conclusion.";
  set decimal^.count = 0_u64;
  set decimal^.digits[0_u64] = 0_u8;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
