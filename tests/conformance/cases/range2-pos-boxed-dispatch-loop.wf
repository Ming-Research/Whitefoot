fn dispatch(targets: &Box<Array<u64>>, code: &Box<Array<u8>>) -> result: u8 reads(targets), reads(code) contract {
  requires 0_u64 < code^.inner.len;
  requires targets^.inner.len == code^.inner.len;
  requires forall ok(j in 0_u64..targets^.inner.len): targets^.inner[j] < code^.inner.len;
} {
  let pc = 0_u64;
  loop (
    invariant inside: pc < code^.inner.len
  ) {
    let t = targets^.inner[pc];
    let op = code^.inner[t];
    if op == 0_u8 {
      return op;
    }
    set pc = t;
    continue;
  }
}

fn main() -> status: std::process::ExitStatus pure {
  let code = box_array_filled::<u8>(count: 3_u64, value: 1_u8);
  set code.inner[2_u64] = 0_u8;
  let targets = box_array_filled::<u64>(count: 3_u64, value: 2_u64);
  set targets.inner[0_u64] = 1_u64;
  let got = dispatch(targets: &targets, code: &code);
  if got != 0_u8 {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
