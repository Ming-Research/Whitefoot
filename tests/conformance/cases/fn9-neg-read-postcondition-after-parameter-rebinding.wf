fn wait_for_one(p: &u64) -> result: unit reads(p) contract {
  ensures p^ == 1_u64;
} {
  doc "The body reads the caller's cell, rebinds p to a local and returns only once p^ reads one, which is the local. The postcondition concerns the caller's cell, so the guard must not prove it.";
  let first = p^;
  let one = 1_u64;
  set p = &one;
  loop {
    if p^ == 1_u64 {
      return unit;
    }
  }
}

fn main() -> status: std::process::ExitStatus pure {
  doc "x keeps five, while the postcondition would tell the caller it holds one.";
  let x = 5_u64;
  wait_for_one(p: &x);
  let quotient = 10_u64 / x;
  if quotient == 2_u64 {
    return std::process::exit_status(code: 0_u8);
  }
  return std::process::exit_status(code: 1_u8);
}
