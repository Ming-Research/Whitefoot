fn need(value: Bool) -> r: unit pure contract {
  define first = value;
  define complete = band(first, True());
  requires complete;
} {
  doc "Contract definitions compose with ordinary-let origins.";
  return unit;
}

fn witness(x: u64) -> r: unit pure {
  doc "Nested aliases and Boolean introduction retain the same proposition.";
  let test = x < 9_u64;
  let copied = test;
  let nested = band(copied, True());
  if x < 8_u64 {
    need(value: nested);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Check the ordinary function body.";
  return std::process::exit_status(code: 0_u8);
}
