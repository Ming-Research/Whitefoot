alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Counter {
  doc "One count.";
  count: u64;
}

fn clamp_to_limit(value: u64) -> result: u64 pure contract {
  ensures result <= 800_u64;
} {
  doc "Returns value when it is at most 800 and 800 otherwise.";
  if value <= 800_u64 {
    return value;
  }
  return 800_u64;
}

fn probe(counter: &Counter, bounded: u64, wild: u64) -> result: u64 writes(counter) contract {
  requires bounded <= 800_u64;
  ensures counter^.count <= 800_u64;
} {
  doc "The first image of the count is formed by the subtraction inside a judgment in a branch the requirement makes unreachable, and that judgment's atoms are discarded. The call result formed next takes a fresh atom bounded by 800. The count's image must not survive the discarded judgment, or it would name that bounded atom and prove the postcondition about a count nothing bounds.";
  if 900_u64 < bounded {
    let seen = counter^.count - 0_u64;
    if seen <= 5_u64 {
      set counter^.count = 0_u64;
    }
  }
  let small = clamp_to_limit(value: wild);
  return small;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
