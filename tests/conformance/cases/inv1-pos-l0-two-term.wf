fn probe(y: u64) -> result: u64 pure contract {
  requires y <= 10_u64;
} {
  doc "The header difference bound closes through limit's offset equality before the disequality tightens it.";
  let x = y;
  let limit = y + 2_u64;
  loop (
    invariant bounded: x - y <= 2_u64
  ) {
    if x == limit {
      break;
    }
    set x = x + 1_u64;
  }
  return x;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
