fn count(stats: Shared<Shards<u64>>) -> result: unit pure waits {
  let mine = any_shard();
  for @round (index in 0_u64..10_u64) {
    atomic part = &stats[mine] {
      set part^ = part^ +wrap 1_u64;
    }
  }
  return unit;
}

fn count_four(stats: &Shared<Shards<u64>>) -> result: unit reads(stats) waits {
  for @start (index in 0_u64..4_u64) {
    let handle = shared_share::<Shards<u64>>(shared: stats);
    spawn count(stats: move handle);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let stats = shared_shards_new::<u64>(value: 0_u64);
  count_four(stats: &stats);
  let total = 0_u64;
  atomic all = &stats {
    for @shard (i in 0_u64..all^.len) {
      set total = total +wrap all^[i];
    }
  }
  let code = cvt.wrap::<u64, u8>(total);
  return std::process::exit_status(code: code);
}
