alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn filled<T: copy, const n: u64>(value: T) -> result: Slots<T, n> pure contract {
  ensures result.len >= n;
  ensures result.cap <= result.len;
} {
  doc "Builds a window of n slots, every one holding a copy of value; the copy bound is what admits the bare repeated use.";
  let built = slots_new::<T, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: built.len >= at,
    invariant spare: built.cap - built.len + at >= n
  ) {
    place_back(window: &built, value: value);
  }
  return move built;
}

fn size_of(taken: Slots<u8, 8>) -> measured: u64 pure contract {
  ensures measured == taken.len;
} {
  doc "Consumes the window and hands its length back.";
  let held = taken.len;
  return held;
}

fn needs_eight(bound: u64) -> ok: unit pure contract {
  requires 8_u64 <= bound;
} {
  doc "Needs a caller proof about its argument.";
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "MSR-3: the own operand of a published relation denotes this call's call datum, a compiler-owned term with empty support, so the relation survives the consume the same statement performs and the caller discharges a later requirement from it.";
  let run = filled::<u8, 8>(value: 0_u8);
  let measured = size_of(taken: move run);
  let confirmed = needs_eight(bound: measured);
  return exit_status(code: 0_u8);
}
