fn main() -> status: std::process::ExitStatus pure {
  doc "TYPE-9: Paged content takes only the Box-content home, never the exchange place.";
  let small = box_paged_new::<u64>(capacity: 1_u64);
  let large = box_paged_new::<u64>(capacity: 64_u64);
  swap(first: &small.inner, second: &large.inner);
  return std::process::exit_status(code: 0_u8);
}
