alias ExitStatus = std::process::ExitStatus;
alias data = pkg::data;
alias exit_status = std::process::exit_status;
alias report = pkg::report;

fn main() -> status: ExitStatus pure {
  doc "Each module names only the modules its row lists; the dependency rows point to earlier rows.";
  let sign = data::sign_of(value: 5_i32);
  let code = report::code_of(sign: sign);
  return exit_status(code: code);
}
