alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn remove_first(window: &Slots<u64, 4>) -> result: u64 writes(window.filled), writes(window.len) {
  doc "Removes the first element when there is one. Its row writes window.filled, so a call may lower window.len as remove_at does.";
  if 0_u64 < deref(window).len {
    let taken = remove_at(window: window, index: 0_u64);
    return taken;
  }
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  doc "OP-10, REF-2: e = &w[0_u64] is formed under 0 < w.len. The call to remove_first, a program function whose row writes w.filled, ends that bound as remove_at does, so reading e afterwards is refused.";
  let w = slots_new::<u64, 4>();
  place_back(window: &w, value: 5_u64);
  if w.len == 1_u64 {
    let e = &w[0_u64];
    let got = remove_first(window: &w);
    let seen = deref(e);
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 0_u8);
}
