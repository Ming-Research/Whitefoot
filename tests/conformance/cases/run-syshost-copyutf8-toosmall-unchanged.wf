alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias arg_get = std::text::arg_get;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias host_copy_utf8 = std::text::host_copy_utf8;

fn sentinel_status(bytes: &[u8], failure: u8) -> result: u8 reads(bytes) {
  doc "Reports zero when every byte of the range still holds the sentinel, and the supplied failure code otherwise.";
  let spare = deref(bytes).len;
  for (offset in 0_u64..spare) {
    let byte = deref(bytes)[offset];
    let intact = byte == 90_u8;
    if intact {
    } else {
      return failure;
    }
  }
  return 0_u8;
}

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "The ordinary UTF-8 copy library operation reports Utf8CopyTooSmall with the encoded length and leaves the sentinel destination unchanged.";
  let Inputs(args: args, cwd: unused_cwd, stdout: unused_stdout, stderr: unused_stderr, handles: entry_factory, stdin: unused_stdin) = move inputs;
  close_directory(factory: &entry_factory, directory: move unused_cwd);
  let bytes = slots_new::<u8, 4>();
  for @scratch (
    at in 0_u64..4_u64,
    invariant grown: bytes.len >= at,
    invariant vacancy: bytes.cap - bytes.len + at >= 4_u64
  ) {
    place_back(window: &bytes, value: 90_u8);
  }
  let window = &bytes[0_u64..4_u64];
  match arg_get(args: &args, position: 1_u64) {
    Ok(value: text) => {
      match host_copy_utf8(value: &text, destination: window, start: 0_u64, end: 4_u64) {
        Ok(value: encoded) => {
          return exit_status(code: 10_u8);
        }
        Err(error: problem) => {
          match problem {
            Utf8CopyTooSmall(required: needed) => {
              let exact = needed == 6_u64;
              if exact {
              } else {
                return exit_status(code: 11_u8);
              }
            }
            Utf8CopyInvalid() => {
              return exit_status(code: 12_u8);
            }
          }
        }
      }
      let observed = sentinel_status(bytes: window, failure: 13_u8);
      let intact = observed == 0_u8;
      if intact {
      } else {
        return exit_status(code: observed);
      }
      return exit_status(code: 0_u8);
    }
    Err(error: absent) => {
      return exit_status(code: 14_u8);
    }
  }
}
