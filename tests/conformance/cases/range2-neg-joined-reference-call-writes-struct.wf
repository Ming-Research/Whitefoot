struct Counter {
  count: u8;
}

fn put(c: &Counter, y: u8) -> result: unit writes(c.count) {
  set c^.count = y;
  return unit;
}

fn bump(marks: &[u64], x: u64, y: u8) -> result: u8 pure contract {
  requires forall small(k in 0_u64..marks^.len): marks^[k] < 8_u64;
} {
  doc "r names s or t, so the call writing through r may make s.count y, which may be 9.";
  let s = Counter(count: 1_u8);
  let t = Counter(count: 1_u8);
  let r = if x < 10_u64 {
    give &s;
  } else {
    give &t;
  }
  put(c: r, y: y);
  let v = s.count;
  let w = 251_u8 + v;
  return w;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
