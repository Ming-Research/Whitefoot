const names: Array<u8, 2> =[97_u8, 98_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  let store = shared_map_new::<u8>(capacity: 0_u64);
  let name = &names[0_u64..1_u64];
  let second = &names[1_u64..2_u64];
  let n = 0_u64;
  let first_count = 0_u64;
  atomic t = &store {
    set t^[name] = Some<u8>(value: 1_u8);
    set t^[second] = Some<u8>(value: 2_u8);
    set first_count = map_count::<u8>(map: t);
    set t^[name] = None<u8>();
    set n = map_count::<u8>(map: t);
  }
  let tens = first_count *wrap 10_u64;
  let total = tens +wrap n;
  let code = cvt.wrap::<u64, u8>(total);
  return std::process::exit_status(code: code);
}
