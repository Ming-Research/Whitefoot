alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Marker<T: drop> {
}

fn invalid() -> result: unit pure {
  doc "Even an empty source nominal cannot be instantiated with a reference kind; GRAM-3 gives `targ` no reference-kind production, independently of stored-field analysis [TYPE-8].";
  let marker = Marker<&[u8]>();
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
