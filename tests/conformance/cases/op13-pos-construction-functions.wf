alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn same(left: u64, right: u64) -> result: unit pure contract {
  requires left == right;
} {
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "OP-13: the construction functions are the prelude records; a window built by slots_new, ring_new, box_slots_new or box_ring_new starts empty, an Array built by array_filled has every slot holding the supplied value, and allocation is total so no construction returns a Result. The calls to same state the derived empty lengths as requirements.";
  let a = array_filled::<u64, 3>(value: 7_u64);
  let s = slots_new::<u64, 3>();
  let g = ring_new::<u64, 3>();
  let b = box_new::<u64>(value: 9_u64);
  let ba = box_array_filled::<u64>(count: 3_u64, value: 7_u64);
  let bs = box_slots_new::<u64>(capacity: 3_u64);
  let br = box_ring_new::<u64>(capacity: 3_u64);
  let array_first = a[0_u64];
  let boxed_filled = ba.inner[0_u64];
  let empty = s.len;
  let ring_empty = g.len;
  let boxed = b.inner;
  let boxed_slots_empty = bs.inner.len;
  let boxed_ring_empty = br.inner.len;
  if array_first == 7_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  if boxed_filled == 7_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  same(left: empty, right: 0_u64);
  same(left: ring_empty, right: 0_u64);
  if boxed == 9_u64 {
  } else {
    return exit_status(code: 5_u8);
  }
  same(left: boxed_slots_empty, right: 0_u64);
  same(left: boxed_ring_empty, right: 0_u64);
  return exit_status(code: 0_u8);
}
