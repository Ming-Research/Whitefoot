alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn mixed_forms(first: u8, first_limit: u8, second: u8, second_limit: u8, third: u8, third_limit: u8) -> result: unit pure contract {
  requires first <= first_limit;
  requires second <= second_limit;
  requires third <= third_limit;
  requires first_limit <= 40_u8;
  requires second_limit <= 40_u8;
  requires third_limit <= 40_u8;
} {
  invariant pair_bound: first + second <= first_limit + second_limit;
  invariant combined: 2_u8 * first + 2_u8 * second + third <= 2_u8 * first_limit + 2_u8 * second_limit + third_limit + 3_u8 {
    use 2 times pair_bound;
    use (third <= third_limit);
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
