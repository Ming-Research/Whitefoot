alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn scaled(p: u64, k: u64, n: u64) -> span: u64 pure contract {
  requires n <= 1000_u64;
  requires k <= 1000_u64;
  requires n >= 1_u64;
  requires p < k;
} {
  doc "Nothing in scope equals the product the scaled premise passes through.";
  let span = n * k;
  invariant fits: p < span {
    use n times (p < k);
  }
  return span;
}

fn main() -> status: ExitStatus pure {
  let span = scaled(p: 1_u64, k: 2_u64, n: 4_u64);
  return exit_status(code: 0_u8);
}
