alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nodrop struct Ticket {
  number: u8;
}

fn consume(ticket: Ticket) -> number: u8 pure {
  let Ticket(number: number) = move ticket;
  return number;
}

fn acquire(fail: Bool) -> result: Result<Ticket, u8> pure {
  if fail {
    return Err<Ticket, u8>(error: 7_u8);
  }
  let ticket = Ticket(number: 2_u8);
  return Ok<Ticket, u8>(value: move ticket);
}

fn attempt(fail: Bool) -> result: u8 pure {
  let first = Ticket(number: 1_u8);
  match acquire(fail: fail) {
    Err(error: problem) => {
      return problem;
    }
    Ok(value: second) => {
      let one = consume(ticket: move first);
      let two = consume(ticket: move second);
      return one +wrap two;
    }
  }
}

fn main() -> status: ExitStatus pure {
  let yes = 0_u8 == 0_u8;
  let result = attempt(fail: yes);
  return exit_status(code: result);
}
