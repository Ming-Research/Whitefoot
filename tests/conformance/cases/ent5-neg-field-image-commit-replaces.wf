alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Counter {
  doc "One count.";
  count: u64;
}

fn advance(counter: &Counter, delta: u64, wild: u64) -> result: unit writes(counter) contract {
  requires counter^.count + delta <= 800_u64;
} {
  doc "The commit replaces the field's entry image by wild's, so the read-back is unbounded and the sum may overflow.";
  set counter^.count = wild;
  let count = counter^.count;
  let total = count + delta;
  set counter^.count = total;
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
