alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn measure<const n: u64>(source: Slots<u8, n>) -> size: u64 pure contract {
  ensures size == source.len;
} {
  doc "Consumes the run and hands back its length; a by-value parameter carries no effect entry and a measure read carries the empty row, so the declaration is pure.";
  let taken = source.len;
  return taken;
}

fn main() -> status: ExitStatus pure {
  doc "The result of a call carries exactly the callee's declared relations. The own argument is affine, so the call is a consuming use and every fact supported by line dies at it; the declared relation names that operand's measure, which at the caller denotes the call datum, and a datum has empty support, so the consume the same statement performs cannot kill it. The caller therefore knows size == 2 after the call and knows it only from the contract.";
  let line = slots_new::<u8, 4>();
  place_back(window: &line, value: 7_u8);
  place_back(window: &line, value: 7_u8);
  let size = measure::<4>(source: move line);
  if size == 2_u64 {
  } else {
    return exit_status(code: 201_u8);
  }
  return exit_status(code: 0_u8);
}
