alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn safe_div(n: i32, d: i32) -> result: i32 pure contract {
  define nonzero = d != 0_i32;
  define not_neg1 = d != -1_i32;
  requires band(nonzero, not_neg1);
} {
  return n / d;
}

fn negate(n: i32) -> result: i32 pure {
  if n > -2147483648_i32 {
    return ineg(n);
  }
  return 0_i32;
}

fn negate_guarded(x: i16) -> negated: i16 pure {
  let is_min = x == -32768_i16;
  if is_min {
    return 32767_i16;
  } else {
    return ineg(x);
  }
}

fn magnitude_guarded(x: i32) -> abs_value: i32 pure {
  let is_min = x == -2147483648_i32;
  if is_min {
    return 2147483647_i32;
  } else {
    return iabs(x);
  }
}

fn shifted(value: i32, amount: u32) -> result: i32 pure {
  if amount < 32_u32 {
    return ishr(value, amount);
  }
  return 0_i32;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
