alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum StepError {
  Negative();
}

fn step(x: i32) -> result: Result<i32, StepError> pure {
  doc "Reports a negative input as an ordinary error value [ERR-1].";
  if x < 0_i32 {
    let negative_atom_0001 = StepError::Negative();
    return Err<i32, StepError>(error: negative_atom_0001);
  } else {
    return Ok<i32, StepError>(value: x);
  }
}

fn forward(x: i32) -> result: Result<i32, StepError> pure {
  doc "Ok binds y and the continuation runs; Err returns Err(err) with the same E [ERR-3].";
  let y = propagate step(x: x);
  let next = y +wrap 1_i32;
  return Ok<i32, StepError>(value: next);
}

fn main() -> status: ExitStatus pure {
  doc "The continuation transforms 41 to 42, while an Err payload returns unchanged without executing that continuation.";
  let accepted = forward(x: 41_i32);
  match accepted {
    Ok(value: accepted_value) => {
      if accepted_value != 42_i32 {
        return exit_status(code: 1_u8);
      }
    }
    Err(error: accepted_error) => {
      return exit_status(code: 2_u8);
    }
  }
  let rejected = forward(x: -1_i32);
  match rejected {
    Ok(value: rejected_value) => {
      return exit_status(code: 3_u8);
    }
    Err(error: rejected_error) => {
      match rejected_error {
        Negative() => {
        }
      }
    }
  }
  return exit_status(code: 0_u8);
}
