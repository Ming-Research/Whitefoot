alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn filled_four(value: u32) -> result: Slots<u32, 4> pure contract {
  ensures result.len >= 4_u64;
  ensures result.cap <= result.len;
} {
  doc "One full run of four slots, built by the ordinary counted fill.";
  let built = slots_new::<u32, 4>();
  for @fill (
    at in 0_u64..4_u64,
    invariant grown: built.len >= at,
    invariant spare: built.cap - built.len + at >= 4_u64
  ) {
    place_back(window: &built, value: value);
  }
  return move built;
}

fn main() -> status: ExitStatus pure {
  doc "[ENT-2] the implicit cap = n of a Slots<T, n> place holds at every program point. An element read feeding a branch condition puts a join on the path, and the OP-11 swap of the run's root bindings then kills every relation supported by those places [ENT-5]. The capacity equality is a function of the place's type rather than a fact that had to survive, so it still reads back on both sides of the exchange [ENT-4]; the honest difference from an Array is that len is a descriptor word rather than a type constant, so the length does not survive the exchange and the subscripts stand before it.";
  let samples = filled_four(value: 1_u32);
  let before = samples[0_u64];
  if before == 1_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  let fresh = filled_four(value: 9_u32);
  swap(first: &samples, second: &fresh);
  let capacity = samples.cap;
  if capacity == 4_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  let carried = fresh.cap;
  if carried == 4_u64 {
  } else {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
