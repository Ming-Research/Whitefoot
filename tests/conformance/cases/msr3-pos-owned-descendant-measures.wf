alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Packet {
  first: Box<Slots<u8>>;
  second: Box<Slots<u8>>;
}

fn main() -> status: ExitStatus pure {
  doc "MSR-3, ENT-2: named placements carry the current measures of exact owned descendants through fields, payloads and Box.inner even when their enclosing value is unmeasured. The two descendant paths have different lengths and remain distinct through the same owner rebind and payload placement. Destructuring the boxed content preserves both facts without a measure guard, and the executable observes the corresponding elements.";
  let initial_first = box_slots_new::<u8>(capacity: 1_u64);
  let initial_second = box_slots_new::<u8>(capacity: 1_u64);
  let initial = Packet(first: move initial_first, second: move initial_second);
  let holder = box_new::<Packet>(value: move initial);
  let short = box_slots_new::<u8>(capacity: 2_u64);
  place_back(window: &short.inner, value: 11_u8);
  let long = box_slots_new::<u8>(capacity: 3_u64);
  place_back(window: &long.inner, value: 22_u8);
  place_back(window: &long.inner, value: 33_u8);
  set holder.inner = Packet(first: move short, second: move long);
  let renamed = move holder;
  let selected = Some<Box<Packet>>(value: move renamed);
  match selected {
    None() => {
      return exit_status(code: 3_u8);
    }
    Some(value: owned) => {
      let Packet(first: one, second: two) = move owned.inner;
      invariant first_length: one.inner.len == 1_u64;
      invariant second_length: two.inner.len == 2_u64;
      let first_value = one.inner[0_u64];
      let second_value = two.inner[1_u64];
      if first_value == 11_u8 {
      } else {
        return exit_status(code: 1_u8);
      }
      if second_value == 33_u8 {
      } else {
        return exit_status(code: 2_u8);
      }
      return exit_status(code: 0_u8);
    }
  }
}
