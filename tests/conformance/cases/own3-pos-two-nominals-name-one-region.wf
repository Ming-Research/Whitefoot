alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Lease<T> {
  run: Box<Slots<T>>;
}

struct BlockPool<T> {
  free: Slots<Box<Slots<T>>, 8>;
}

fn main() -> status: ExitStatus pure {
  doc "A type parameter is owner-local to the declaration that introduces it, so two nominals of one compilation unit may each write T; the second declaration is neither a repeated parameter nor a redeclaration of the first's.";
  return exit_status(code: 0_u8);
}
