alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Chunk<T: drop, const n: u64> {
  page: Slots<T, n>;
}

fn main() -> status: ExitStatus pure {
  doc "A source nominal declares its own type and const parameters and holds a constant-capacity window in a field, which TYPE-9 admits inline in its owner.";
  return exit_status(code: 0_u8);
}
