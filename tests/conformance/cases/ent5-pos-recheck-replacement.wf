alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn guarded_local(x: u8, w: u8) -> result: u8 pure contract {
  requires x <= 5_u8;
} {
  doc "Only a fresh guard after the replacement admits the later exact arithmetic.";
  set x = w;
  let ok = x <= 5_u8;
  if ok {
    let z = x + 250_u8;
    return z;
  } else {
    return 0_u8;
  }
}

struct Cell {
  v: u8;
}

fn guarded_field(b: Cell, w: u8) -> result: u8 pure {
  doc "The immutable old read remains an old-value fact, not a proof about the fresh field read.";
  let old = b.v;
  let bounded = old <= 5_u8;
  if bounded {
    set b.v = w;
    let ok = b.v <= 5_u8;
    if ok {
      let z = b.v + 250_u8;
      return z;
    } else {
      return 0_u8;
    }
  } else {
    return 0_u8;
  }
}

fn guarded_element(buf: &[u8], i: u64, w: u8) -> result: u8 writes(buf) {
  doc "The same recheck after an element write through a range reference the row declares.";
  let limit = deref(buf).len;
  let in_range = i < limit;
  if in_range {
    let old = deref(buf)[i];
    let bounded = old <= 5_u8;
    if bounded {
      set deref(buf)[i] = w;
      let cur = deref(buf)[i];
      let ok = cur <= 5_u8;
      if ok {
        let z = cur + 250_u8;
        return z;
      } else {
        return 0_u8;
      }
    } else {
      return 0_u8;
    }
  } else {
    return 0_u8;
  }
}

fn second_or_zero(values: Slots<u32, 6>, idx: u64) -> result: u32 pure contract {
  requires values.len >= 6_u64;
} {
  doc "The same recheck after an index replacement: only the new guard admits the second subscript [ENT-5, OP-4].";
  let in_range = idx < 6_u64;
  if in_range {
  } else {
    return 0_u32;
  }
  let first = values[idx];
  let bumped = idx +wrap 1_u64;
  set idx = bumped;
  let still_in_range = idx < 6_u64;
  if still_in_range {
  } else {
    return first;
  }
  let second = values[idx];
  return second;
}

fn main() -> status: ExitStatus pure {
  doc "No construction is needed to exercise the rechecks.";
  return exit_status(code: 0_u8);
}
