fn change_content(cell: &Option<u64>) -> result: u64 reads(cell), writes(cell.Some.value) {
  doc "A primitive payload write kills the current variant fact.";
  match &cell^ {
    None() => {
      return 0_u64;
    }
    Some(value: inner) => {
      set inner^ = 41_u64;
      return 11_u64;
    }
  }
}

fn write_after_content_change(cell: &Option<u64>) -> result: unit writes(cell) {
  doc "SET-1 evaluates the payload target after the right-hand side, whose content write ended the variant fact, so the payload selection is refused; binding the value and matching again is the accepted spelling.";
  match &cell^ {
    None() => {
      return unit;
    }
    Some(..) => {
      set cell^.Some.value = change_content(cell: cell);
      return unit;
    }
  }
}

fn main() -> status: std::process::ExitStatus pure {
  let cell = Some<u64>(value: 7_u64);
  let changed = write_after_content_change(cell: &cell);
  match &cell {
    None() => {
      return std::process::exit_status(code: 1_u8);
    }
    Some(value: observed) => {
      if observed^ == 11_u64 {
        return std::process::exit_status(code: 0_u8);
      }
      return std::process::exit_status(code: 2_u8);
    }
  }
}
