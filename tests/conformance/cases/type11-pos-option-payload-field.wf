struct Index {
  value: u64;
  invariant bounded(index): index.value < 16_u64;
}

struct Holder {
  index: Index;
}

fn peek_holder(held: &Option<Holder>, table: &Array<u64, 16>) -> result: u64 reads(held), reads(table) {
  match &held^ {
    Some(value: h) => {
      let at = h^.index.value;
      let got = table^[at];
      return got;
    }
    None() => {
      return 0_u64;
    }
  }
}
