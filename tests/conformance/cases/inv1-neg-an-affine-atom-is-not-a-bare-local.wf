alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Bounds {
  low: u64;
  high: u64;
}

fn main() -> status: ExitStatus pure {
  doc "[INV-1] an affine factor's atom is one bare IDENT place or one integer literal. A field selection derives under the widened production [GRAM-4, MSR-5] and is refused at the factor by the rule, not by the parser, which is what keeps one production serving both an invariant and a contract clause.";
  let limits = Bounds(low: 0_u64, high: 4_u64);
  let seen = 0_u64;
  for (
    at in 0_u64..4_u64,
    invariant bounded: seen <= limits.high
  ) {
  }
  return exit_status(code: 0_u8);
}
