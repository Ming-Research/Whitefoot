alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy struct Cell {
  value: i32;
}

fn take(cell: Cell) -> return_value: i32 pure {
  return cell.value;
}

fn main() -> return_value: ExitStatus pure {
  doc "A by-value parameter carries no effect entry, so the helper's row is pure; the commit still writes a root the right-hand side already consumed.";
  let cell = Cell(value: 1_i32);
  set cell.value = take(cell: move cell);
  return exit_status(code: 0_u8);
}
