struct Pair {
  marker: u64;
  value: u64;
  invariant zero(pair): pair.value == 0_u64;
}

fn helper(frame: &Pair, other: &Pair) -> result: unit writes(frame.marker), writes(other.value) {
  set frame^.marker = 1_u64;
  set other^.value = 0_u64;
  return unit;
}

fn caller() -> result: unit pure {
  let object = Pair(marker: 0_u64, value: 0_u64);
  helper(frame: &object, other: &object);
  return unit;
}
