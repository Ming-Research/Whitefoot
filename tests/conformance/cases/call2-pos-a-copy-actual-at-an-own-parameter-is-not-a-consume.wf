alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn get_bounded(window: &Slots<u8, 4>, i: u64, limit: u64) -> value: u8 reads(window) contract {
  requires i < limit;
  requires limit <= deref(window).len;
} {
  doc "Reads one element under a bound handed over by value.";
  return deref(window)[i];
}

fn main() -> status: ExitStatus pure {
  doc "CALL-2 makes an own argument a consuming use only where its type is affine or linear. u64 is copy, so handing the saved bound at an own parameter is a duplicate: the caller's place and every fact supported by it survive, and the second call proves its own requirement from the same fact that a consume of an affine actual would have killed.";
  let line = slots_new::<u8, 4>();
  place_back(window: &line, value: 7_u8);
  place_back(window: &line, value: 9_u8);
  let bound = line.len;
  let first = get_bounded(window: &line, i: 0_u64, limit: bound);
  let second = get_bounded(window: &line, i: 1_u64, limit: bound);
  if first == 7_u8 {
  } else {
    return exit_status(code: 201_u8);
  }
  if second == 9_u8 {
  } else {
    return exit_status(code: 202_u8);
  }
  return exit_status(code: 0_u8);
}
