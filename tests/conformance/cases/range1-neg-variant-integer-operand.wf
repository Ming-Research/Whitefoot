enum Step {
  Next();
  Stop();
}

fn inspect(values: &Slots<u64, 4>) -> result: unit reads(values) contract {
  requires forall ends(j in 0_u64..values^.len): values^[j] is Stop;
} {
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
