fn probe(rows: &[Slots<u8, 8>], i: u64, j: u64, k: u64) -> result: u8 writes(rows) contract {
  requires i < j;
  requires j < rows^.len;
  requires k < rows^[i].len;
} {
  doc "ENT-5 and OWN-7 use i < j in the write's current context to separate rows[j] from the support of k < rows[i].len, preserving the nested subscript proof.";
  set rows^[j] = slots_new::<u8, 8>();
  let value = rows^[i][k];
  return value;
}

fn main() -> status: std::process::ExitStatus pure {
  doc "Checking probe exercises symbolic separation without constructing runtime rows.";
  return std::process::exit_status(code: 0_u8);
}
