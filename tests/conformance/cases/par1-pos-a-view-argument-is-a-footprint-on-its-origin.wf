alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn fill(destination: &[u8], value: u8) -> result: unit writes(destination) contract {
  requires 2_u64 <= deref(destination).len;
} {
  doc "Writes two elements through the range reference it was handed, so what it writes is the storage that reference was formed over.";
  set deref(destination)[0_u64] = value;
  set deref(destination)[1_u64] = value;
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "A range-reference argument is a footprint on the storage it was formed over, whether the reference is written at the call or bound by a let and handed on. The two fill calls hand on references bound above them; their substituted write paths resolve to left and right, which have distinct roots and therefore do not overlap, so the adjacent pair is permitted and the program reads both runs back.";
  let left_values = array_filled::<u8, 2>(value: 0_u8);
  let left = slots_from_array::<u8, 2>(values: left_values);
  let right_values = array_filled::<u8, 2>(value: 0_u8);
  let right = slots_from_array::<u8, 2>(values: right_values);
  let left_window = &left[0_u64..2_u64];
  let right_window = &right[0_u64..2_u64];
  fill(destination: left_window, value: 3_u8);
  fill(destination: right_window, value: 5_u8);
  let first = left[0_u64];
  if first == 3_u8 {
  } else {
    return exit_status(code: 201_u8);
  }
  let second = right[1_u64];
  if second == 5_u8 {
  } else {
    return exit_status(code: 202_u8);
  }
  return exit_status(code: 0_u8);
}
