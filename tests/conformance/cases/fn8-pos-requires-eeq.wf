alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum ClauseEq {
  ClauseFirst();
  ClauseSecond();
  ClauseThird();
}

fn guarded(left: ClauseEq, right: ClauseEq) -> result: unit pure contract {
  define same = eeq(left, right);
  requires same;
} {
  return unit;
}

fn main() -> status: ExitStatus pure {
  let left = ClauseEq::ClauseSecond();
  let right = ClauseEq::ClauseSecond();
  let same = eeq(left, right);
  if same {
    guarded(left: left, right: right);
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
