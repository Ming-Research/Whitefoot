alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Marker<T> {
  value: u64;
}

fn read_marker(marker: &Marker<Slots<u8, 4>>) -> value: u64 reads(marker.value) {
  doc "One reader names one written instantiation in its parameter type and needs no provider argument beside it.";
  return deref(marker).value;
}

fn main() -> status: ExitStatus pure {
  doc "FN-2: the same reader serves two separately constructed values of that one written instantiation. The argument is written at each construction and at the parameter type, and the reader's own temporary reference is formed at each call and carries no name of its own [REF-1].";
  let first = Marker<Slots<u8, 4>>(value: 7_u64);
  let second = Marker<Slots<u8, 4>>(value: 9_u64);
  let first_value = read_marker(marker: &first);
  let second_value = read_marker(marker: &second);
  if first_value == 7_u64 {
    if second_value == 9_u64 {
      return exit_status(code: 0_u8);
    }
  }
  return exit_status(code: 1_u8);
}
