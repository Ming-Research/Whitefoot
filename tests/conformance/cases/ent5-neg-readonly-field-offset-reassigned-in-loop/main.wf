alias Entry = pkg::kinds::Entry;
alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias kinds = pkg::kinds;

fn main() -> status: ExitStatus pure {
  doc "ENT-5: the offset i is part of the support of entries[i].width. The outer body reassigns i, so the continuing kill removes the pre-loop bound at the outer head; the second pass selects the wide element and its cell read owes an unproved c < cells.len.";
  let narrow = kinds::make_entry(width: 3_u64, weight: 1_u64);
  let entries = array_filled::<Entry, 4>(value: narrow);
  set entries[2_u64] = kinds::make_entry(width: 8_u64, weight: 1_u64);
  let cells = array_filled::<u8, 3>(value: 7_u8);
  let i = 1_u64;
  let total = 0_u64;
  if entries[i].width <= cells.len {
    for (
      pass in 0_u64..2_u64,
      invariant bounded: i <= 2_u64
    ) {
      for (c in 0_u64..entries[i].width) {
        let cell = cells[c];
        let widened = cvt::<u8, u64>(cell);
        set total = total +wrap widened;
      }
      set i = 2_u64;
    }
  }
  return exit_status(code: 0_u8);
}
