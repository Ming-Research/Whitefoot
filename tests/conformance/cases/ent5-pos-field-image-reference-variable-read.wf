struct Reading {
  value: i64;
}

fn make() -> made: Reading pure contract {
  ensures -1000_i64 <= made.value;
} {
  doc "The construction carries 0 into the field the postcondition names.";
  return Reading(value: 0_i64);
}

fn shift(d: u8) -> result: i64 pure {
  doc "The reference variable names the local exactly, so the field read through it takes the local field's image and the call result's bound reaches the copy.";
  let e = make();
  let r = &e;
  let c = r^.value;
  let w = cvt::<u8, i64>(d);
  let v = c - w;
  return v;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
