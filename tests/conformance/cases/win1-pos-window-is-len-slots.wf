alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "WIN-1: a Slots window is exactly the len slots beginning at slot zero, every other slot holds nothing, and a subscript r[i] carries the obligation i < r.len.";
  let r = slots_new::<u64, 4>();
  place_back(window: &r, value: 11_u64);
  place_back(window: &r, value: 22_u64);
  let first = r[0_u64];
  let second = r[1_u64];
  let n = r.len;
  if first == 11_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  if second == 22_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  if n == 2_u64 {
  } else {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
