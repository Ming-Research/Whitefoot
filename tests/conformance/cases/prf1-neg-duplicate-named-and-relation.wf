alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn duplicate_mixed(alpha: u16, alpha_cap: u16, beta: u16, beta_cap: u16) -> result: unit pure contract {
  requires alpha <= alpha_cap;
  requires beta <= beta_cap;
} {
  invariant pair_bound: alpha + beta <= alpha_cap + beta_cap;
  invariant tripled_bound: 3_u16 * alpha + 3_u16 * beta <= 3_u16 * alpha_cap + 3_u16 * beta_cap {
    use pair_bound;
    use (alpha + beta <= alpha_cap + beta_cap);
    use pair_bound;
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
