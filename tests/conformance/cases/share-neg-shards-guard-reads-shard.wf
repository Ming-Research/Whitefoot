fn one_count() -> made: u8 pure {
  return 1_u8;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let stats = shared_shards_new::<u8, fn one_count>();
  let mine = any_shard();
  atomic part = &stats[mine] when part^ != 0_u8 {
    set part^ = 0_u8;
  }
  return std::process::exit_status(code: 0_u8);
}
