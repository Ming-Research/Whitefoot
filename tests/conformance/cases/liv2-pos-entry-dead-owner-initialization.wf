alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy struct Item {
  value: u64;
}

fn reuse(owner: Item, incoming: Item) -> (current: Item, previous: Item) pure {
  doc "Reinitializes a binding that is already dead at statement entry, so the commit writes over no previous owner.";
  let previous = move owner;
  set owner = move incoming;
  return move owner, move previous;
}

fn relay(owner: Item) -> result: Item pure {
  doc "Hands the value straight back.";
  return move owner;
}

fn rebind(owner: Item) -> result: Item pure {
  doc "The same-statement update: the old value enters the callee and the callee's result is committed at the same place.";
  set owner = relay(owner: move owner);
  return move owner;
}

fn main() -> status: ExitStatus pure {
  doc "SET-1, EFF-2: reinitializing a complete binding already dead at statement entry writes no previous owner, while a same-statement update keeps its read and its commit write. An own parameter contributes no effect entry at all, so both helpers declare pure, and both forms preserve the transferred ordinary struct values.";
  let first = Item(value: 11_u64);
  let second = Item(value: 22_u64);
  let (current, previous) = reuse(owner: move first, incoming: move second);
  let returned = rebind(owner: move current);
  if returned.value != 22_u64 {
    return exit_status(code: 1_u8);
  }
  if previous.value != 11_u64 {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
