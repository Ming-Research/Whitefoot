enum Node {
  Open(live: Bool, slot: u64);
  Closed();
}

fn need_zero(slot: u64) -> result: unit pure contract {
  requires slot == 0_u64;
} {
  return unit;
}

fn inspect(nodes: &Slots<Node, 1>) -> result: unit reads(nodes) contract {
  requires nodes^.len == 1_u64;
  requires forall held(k in 0_u64..nodes^.len) when nodes^[k].Open.live: nodes^[k].Open.slot == 0_u64;
} {
  let selected = nodes^[0_u64];
  match selected {
    Open(live: held_live, slot: held_slot) => {
      if held_live {
        need_zero(slot: held_slot);
      }
    }
    Closed() => {
    }
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
