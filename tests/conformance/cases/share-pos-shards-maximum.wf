fn no_peak() -> made: u8 pure {
  return 0_u8;
}

fn raise(peak: Shared<Shards<u8>>, value: u8) -> result: unit pure waits {
  let mine = any_shard();
  atomic part = &peak[mine] {
    set part^ = imax(part^, value);
  }
  return unit;
}

fn raise_three(peak: &Shared<Shards<u8>>) -> result: unit reads(peak) waits {
  let first = shared_share::<Shards<u8>>(shared: peak);
  spawn raise(peak: move first, value: 4_u8);
  let second = shared_share::<Shards<u8>>(shared: peak);
  spawn raise(peak: move second, value: 9_u8);
  let third = shared_share::<Shards<u8>>(shared: peak);
  spawn raise(peak: move third, value: 2_u8);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let peak = shared_shards_new::<u8, fn no_peak>();
  raise_three(peak: &peak);
  let highest = 0_u8;
  atomic all = &peak {
    for @shard (i in 0_u64..all^.len) {
      set highest = imax(highest, all^[i]);
    }
  }
  return std::process::exit_status(code: highest);
}
