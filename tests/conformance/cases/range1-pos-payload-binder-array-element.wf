enum Instr {
  Jump(t: u64);
  Branch(t: u64, c: u64);
  Halt();
}

fn need_below(value: u64, bound: u64) -> result: unit pure contract {
  requires value < bound;
} {
  return unit;
}

fn follow(code: &Array<Instr, 4>, pc: u64) -> r: u64 reads(code) contract {
  requires pc < code^.len;
  requires forall targets(j in 0_u64..code^.len): code^[j].Jump.t < code^.len, code^[j].Branch.t < code^.len;
} {
  doc "The match selects an element of a fixed Array through a reference, so each payload binder's referent is an element projection of that Array and targets bounds it.";
  let n = code^.len;
  match code^[pc] {
    Jump(t: jump_to) => {
      need_below(value: jump_to^, bound: n);
      return jump_to^;
    }
    Branch(t: branch_to, ..) => {
      need_below(value: branch_to^, bound: n);
      return branch_to^;
    }
    Halt() => {
      return pc;
    }
  }
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
