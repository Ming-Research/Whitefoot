alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn touched_byte(limit: u64, xs: &[u8]) -> value: u8 reads(xs) contract {
  define count = deref(xs).len;
  requires limit <= count;
  requires limit >= 1_u64;
} {
  let cursor = 0_u64;
  loop {
    let more = cursor < limit;
    if more {
      set cursor = cursor + 1_u64;
    } else {
      break;
    }
  }
  let last = cursor - 1_u64;
  return deref(xs)[last];
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
