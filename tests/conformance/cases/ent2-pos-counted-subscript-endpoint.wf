alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn probe(bounds: Array<u64, 2>) -> result: unit pure {
  doc "A scalar integer element below a constant subscript is a term of clause (b), so it is an admitted counted endpoint [ENT-2]; each subscript discharges its own bounds [OP-4].";
  for @items (i in bounds[0_u64]..bounds[1_u64]) {
  }
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "No construction is needed to exercise the endpoint admission.";
  return exit_status(code: 0_u8);
}
