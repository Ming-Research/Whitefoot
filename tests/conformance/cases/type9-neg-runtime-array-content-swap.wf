fn main() -> status: std::process::ExitStatus pure {
  doc "TYPE-9: a runtime-capacity Array cannot take the exchange place even when its elements are copy.";
  let small = box_array_filled::<u64>(count: 1_u64, value: 11_u64);
  let large = box_array_filled::<u64>(count: 64_u64, value: 22_u64);
  swap(first: &small.inner, second: &large.inner);
  return std::process::exit_status(code: 0_u8);
}
