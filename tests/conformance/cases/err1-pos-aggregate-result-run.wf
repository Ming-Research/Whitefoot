alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Extent {
  offset: u64;
  width: u64;
}

fn locate(offset: u64, width: u64) -> result: Result<Extent, u64> pure {
  let extent = Extent(offset: offset, width: width);
  return Ok<Extent, u64>(value: extent);
}

fn missing(code: u64) -> result: Result<Extent, u64> pure {
  return Err<Extent, u64>(error: code);
}

fn main() -> status: ExitStatus pure {
  let found = locate(offset: 3_u64, width: 4_u64);
  match found {
    Ok(value: found_extent) => {
      if found_extent.offset != 3_u64 {
        return exit_status(code: 1_u8);
      }
      if found_extent.width != 4_u64 {
        return exit_status(code: 2_u8);
      }
    }
    Err(error: found_code) => {
      return exit_status(code: 3_u8);
    }
  }
  let absent = missing(code: 9_u64);
  match absent {
    Ok(value: absent_extent) => {
      return exit_status(code: 4_u8);
    }
    Err(error: absent_code) => {
      if absent_code != 9_u64 {
        return exit_status(code: 5_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}
