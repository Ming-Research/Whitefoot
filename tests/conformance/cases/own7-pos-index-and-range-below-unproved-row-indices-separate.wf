alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn record_run(rows: &Array<Array<u64, 4>, 4>, i: u64, j: u64, lo: u64, hi: u64, k: u64) -> result: unit reads(rows[i][lo..hi]), writes(rows[j][k]) contract {
  requires i < 4_u64;
  requires j < 4_u64;
  requires lo <= hi;
  requires hi <= 4_u64;
  requires k < 4_u64;
} {
  doc "Writes the length of the run rows[i][lo..hi] into rows[j][k]. EFF-5: one argument supplies both entries, so every call compares them.";
  let run = &deref(rows)[i][lo..hi];
  let n = deref(run).len;
  set deref(rows)[j][k] = n;
  return unit;
}

fn record_across(rows: &Array<Array<u64, 4>, 4>, i: u64, j: u64) -> result: unit writes(rows) contract {
  requires i < 4_u64;
  requires j < 4_u64;
} {
  doc "Passes lo 0, hi 2 and k 3 for rows i and j that nothing proves equal or distinct.";
  record_run(rows: rows, i: i, j: j, lo: 0_u64, hi: 2_u64, k: 3_u64);
  return unit;
}

fn main() -> status: ExitStatus pure {
  doc "OWN-7: the containing paths rows[i] and rows[j] of the run and the slot differ only in an index step, so they select one row, where slot 3 lies past the end of 0..2, or two different rows, and the call separates the index from the range without relating i and j. The program runs the call on one row and on two rows.";
  let row = array_filled::<u64, 4>(value: 1_u64);
  let rows = array_filled::<Array<u64, 4>, 4>(value: row);
  record_across(rows: &rows, i: 2_u64, j: 2_u64);
  record_across(rows: &rows, i: 0_u64, j: 1_u64);
  if rows[2_u64][3_u64] == 2_u64 {
    if rows[1_u64][3_u64] == 2_u64 {
      if rows[0_u64][3_u64] == 1_u64 {
        return exit_status(code: 0_u8);
      }
    }
  }
  return exit_status(code: 1_u8);
}
