enum PayloadChoice {
  Vacant();
  Occupied(prefix: u8, value: u64);
}

fn first(cell: &Option<u64>) -> result: u64 reads(cell) {
  doc "A borrowed Some arm establishes the current variant for a direct payload selection through the reference.";
  match &cell^ {
    None() => {
      return 0_u64;
    }
    Some(value: inner) => {
      let direct = cell^.Some.value;
      return direct;
    }
  }
}

fn read_choice(choice: &PayloadChoice) -> result: u64 reads(choice) {
  doc "A source enum payload selection retains its declared field ordinal after a differently typed sibling.";
  match &choice^ {
    Vacant() => {
      return 0_u64;
    }
    Occupied(prefix: marker, value: inner) => {
      let direct = choice^.Occupied.value;
      return direct;
    }
  }
}

fn main() -> status: std::process::ExitStatus pure {
  doc "The direct selection must return seven from Some(7), zero from None, and the source enum's second payload field.";
  let present = Some<u64>(value: 7_u64);
  let observed = first(cell: &present);
  if observed != 7_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  let absent = None<u64>();
  let fallback = first(cell: &absent);
  if fallback != 0_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  let choice = PayloadChoice::Occupied(prefix: 3_u8, value: 29_u64);
  let selected = read_choice(choice: &choice);
  if selected != 29_u64 {
    return std::process::exit_status(code: 3_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
