alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "MSR-1: an admitted measure place is formed with subscripts as well as field selections, so grid[0_u64].len is a term over a window of windows. The subscript inside the place is an ordinary OP-4 occurrence and is discharged from the length the outer place_back published; the element read then reaches the inner window's own descriptor in the slot it occupies.";
  let row = slots_new::<u8, 8>();
  place_back(window: &row, value: 5_u8);
  let table = slots_new::<Slots<u8, 8>, 4>();
  place_back(window: &table, value: move row);
  let grid = move table;
  let rows = grid.len;
  if rows == 1_u64 {
    let width = grid[0_u64].len;
    if width == 1_u64 {
      let cell = grid[0_u64][0_u64];
      if cell == 5_u8 {
        return exit_status(code: 0_u8);
      }
      return exit_status(code: 4_u8);
    }
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 3_u8);
}
