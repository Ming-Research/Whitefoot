enum Slot {
  Full(count: u8);
  Empty();
}

fn bump(marks: &[u64], x: u8) -> result: u8 pure contract {
  requires forall small(k in 0_u64..marks^.len): marks^[k] < 8_u64;
} {
  doc "Replacing e whole leaves r valid, so the write through r makes e Full with count x, which may be 9.";
  let e = Empty();
  let r = &e;
  set e = Empty();
  set r^ = Full(count: x);
  match e {
    Full(count: held) => {
      let w = 251_u8 + held;
      return w;
    }
    Empty() => {
      return 0_u8;
    }
  }
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
