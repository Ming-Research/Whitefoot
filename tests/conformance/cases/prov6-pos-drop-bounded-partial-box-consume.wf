alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Inner<T: drop> {
  selected: Box<u64>;
  residual: T;
}

fn take<T: drop>(owner: Box<Inner<T>>) -> selected: Box<u64> pure {
  doc "PROV-6 and WIN-3: T: drop excludes a linear residual, so this projected Box-content consume is valid for copy and affine T.";
  return move owner.inner.selected;
}

fn main() -> status: ExitStatus pure {
  doc "Instantiate one take template with copy u64 and affine Box<u8> residuals, then check that each selected value is returned intact.";
  let selected_copy_case = box_new::<u64>(value: 41_u64);
  let inner_copy_case = Inner<u64>(selected: move selected_copy_case, residual: 3_u64);
  let owner_copy_case = box_new::<Inner<u64>>(value: move inner_copy_case);
  let selected_copy_result = take::<u64>(owner: move owner_copy_case);
  let copied_value = selected_copy_result.inner;
  let selected_affine_case = box_new::<u64>(value: 42_u64);
  let residual_affine_case = box_new::<u8>(value: 5_u8);
  let inner_affine_case = Inner<Box<u8>>(selected: move selected_affine_case, residual: move residual_affine_case);
  let owner_affine_case = box_new::<Inner<Box<u8>>>(value: move inner_affine_case);
  let selected_affine_result = take::<Box<u8>>(owner: move owner_affine_case);
  let affine_value = selected_affine_result.inner;
  if copied_value == 41_u64 {
    if affine_value == 42_u64 {
      return exit_status(code: 0_u8);
    }
  }
  return exit_status(code: 1_u8);
}
