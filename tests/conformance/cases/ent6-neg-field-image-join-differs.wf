alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Counter {
  doc "One count.";
  count: u64;
}

fn advance(counter: &Counter, delta: u64, wild: u64) -> result: unit writes(counter) contract {
  requires counter^.count + delta <= 800_u64;
} {
  doc "One arm replaces the count by wild and the other keeps its entry image. The join keeps no image the arms do not share, so the count read after it is unbounded and the sum may overflow.";
  if delta < 5_u64 {
    set counter^.count = wild;
  }
  let count = counter^.count;
  let total = count + delta;
  set counter^.count = total;
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
