alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "EFF-5: a live reference outside the call whose path has a proper prefix among the call's substituted write paths becomes invalid after the call, so remove_at, which writes the filled part, kills a reference into that window.";
  let r = slots_new::<u64, 4>();
  place_back(window: &r, value: 1_u64);
  place_back(window: &r, value: 2_u64);
  let p = &r[0_u64];
  let gone = remove_at(window: &r, index: 1_u64);
  let seen = deref(p);
  if seen == 1_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
