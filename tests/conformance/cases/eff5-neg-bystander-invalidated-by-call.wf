alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "OP-10 explicitly invalidates a window reference at a direct remove_at call, including this reference to a slot that remains filled. The filled-part write changes slot contents and the length word overlaps no slot; neither is an ordinary proper-prefix replacement. The later reference use is refused under REF-2.";
  let r = slots_new::<u64, 4>();
  place_back(window: &r, value: 1_u64);
  place_back(window: &r, value: 2_u64);
  let p = &r[0_u64];
  let gone = remove_at(window: &r, index: 1_u64);
  let seen = p^;
  if seen == 1_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
