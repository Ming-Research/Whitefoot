alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn at_most(value: u32, limit: u32) -> result: unit pure contract {
  requires value <= limit;
} {
  return unit;
}

fn ones(small: u8) -> result: unit pure {
  let field = iand(small, 31_u8);
  let count = ipopcount(field);
  at_most(value: count, limit: 4_u32);
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
