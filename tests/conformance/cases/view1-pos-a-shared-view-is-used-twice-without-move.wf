alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn first_byte(window: &[u8]) -> byte: u8 reads(window) {
  doc "Reads the first byte of a range reference when the range is nonempty.";
  let width = deref(window).len;
  let inside = 0_u64 < width;
  if inside {
    let slot = deref(window)[0_u64];
    return slot;
  }
  return 0_u8;
}

fn main() -> status: ExitStatus pure {
  doc "A reference is not an owned value [REF-1], so handing one to a helper is not a consuming use: one range reference is passed to the helper twice with no move and its own length is read after both calls, so a classification that consumed it at the first call would be visible as a rejection rather than as a silent difference. Read/read overlap at the two calls is admitted [EFF-5].";
  let data = array_filled::<u8, 2>(value: 13_u8);
  let window = &data[0_u64..2_u64];
  let once = first_byte(window: window);
  let twice = first_byte(window: window);
  let width = deref(window).len;
  if width == 2_u64 {
  } else {
    return exit_status(code: 21_u8);
  }
  if once == 13_u8 {
  } else {
    return exit_status(code: 22_u8);
  }
  if twice == once {
  } else {
    return exit_status(code: 23_u8);
  }
  return exit_status(code: 0_u8);
}
