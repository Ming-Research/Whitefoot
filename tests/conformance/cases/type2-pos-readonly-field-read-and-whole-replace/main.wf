alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias packets = pkg::packets;

fn main() -> status: ExitStatus pure {
  doc "TYPE-2: outside its declaring module a readonly field is read like any field; an ordinary field beside it is assignable, and a whole-value assignment replaces the readonly field together with its owner.";
  let p = packets::make(id: 7_u64, size: 1_u64);
  set p.size = 2_u64;
  let first = p.id;
  set p = packets::make(id: 9_u64, size: 3_u64);
  let second = p.id;
  if first == 7_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  if second == 9_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
