alias DirectoryRead = std::fs::DirectoryRead;
alias HandleFactory = std::io::HandleFactory;
alias HostPaths = std::fs::HostPaths;
alias ReadFile = std::fs::ReadFile;

const elsewhere: Array<u8, 9> =[101_u8, 108_u8, 115_u8, 101_u8, 119_u8, 104_u8, 101_u8, 114_u8, 101_u8];

fn error_kind(error: &std::io::IoError) -> kind: u8 reads(error) {
  match error^ {
    NotFound(code: c, origin: o) => {
      return 1_u8;
    }
    PermissionDenied(code: c, origin: o) => {
      return 2_u8;
    }
    AlreadyExists(code: c, origin: o) => {
      return 9_u8;
    }
    NotDirectory(code: c, origin: o) => {
      return 3_u8;
    }
    IsDirectory(code: c, origin: o) => {
      return 4_u8;
    }
    DirectoryNotEmpty(code: c, origin: o) => {
      return 9_u8;
    }
    ReadOnly(code: c, origin: o) => {
      return 9_u8;
    }
    ResourceBusy(code: c, origin: o) => {
      return 9_u8;
    }
    InvalidInput(code: c, origin: o) => {
      return 9_u8;
    }
    InvalidPath(code: c, origin: o) => {
      return 5_u8;
    }
    Unsupported(code: c, origin: o) => {
      return 6_u8;
    }
    TimedOut(code: c, origin: o) => {
      return 9_u8;
    }
    DeadlinePassed() => {
      return 9_u8;
    }
    Cancelled() => {
      return 9_u8;
    }
    BrokenPipe(code: c, origin: o) => {
      return 9_u8;
    }
    WriteZero(code: c, origin: o) => {
      return 9_u8;
    }
    UnexpectedEnd(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionRefused(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionReset(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionAborted(code: c, origin: o) => {
      return 9_u8;
    }
    NotConnected(code: c, origin: o) => {
      return 9_u8;
    }
    AddressInUse(code: c, origin: o) => {
      return 9_u8;
    }
    AddressUnavailable(code: c, origin: o) => {
      return 9_u8;
    }
    ResourceExhausted(code: c, origin: o) => {
      return 9_u8;
    }
    FileTooLarge(code: c, origin: o) => {
      return 9_u8;
    }
    NoSpace(code: c, origin: o) => {
      return 9_u8;
    }
    QuotaExceeded(code: c, origin: o) => {
      return 9_u8;
    }
    CrossDevice(code: c, origin: o) => {
      return 9_u8;
    }
    DeviceFailure(code: c, origin: o) => {
      return 9_u8;
    }
    Other(code: c, origin: o) => {
      return 9_u8;
    }
  }
}

fn holds_byte(factory: &HandleFactory, file: &ReadFile, expected: u8) -> result: Bool writes(factory), writes(file) waits {
  let bytes = array_filled::<u8, 2>(value: 0_u8);
  match std::fs::read_at(factory: factory, file: file, destination: &bytes[0_u64..2_u64], file_offset: 0_u64, start: 0_u64, end: 2_u64) {
    Ok(value: next) => {
      if next != 1_u64 {
        return False();
      }
    }
    Err(error: problem) => {
      return False();
    }
  }
  let same = bytes[0_u64] == expected;
  return same;
}

fn exercise(args: &std::text::Args, factory: &HandleFactory, paths: &HostPaths, base: &DirectoryRead) -> result: u8 reads(args), reads(paths), reads(base), writes(factory) waits {
  match std::text::arg_get(args: args, position: 1_u64) {
    Ok(value: text) => {
      match std::fs::open_host_read(factory: factory, paths: paths, base: base, path: &text) {
        Ok(value: file) => {
          let right = holds_byte(factory: factory, file: &file, expected: 65_u8);
          std::fs::close_read(factory: factory, file: move file);
          if right {
            return 0_u8;
          }
          return 2_u8;
        }
        Err(error: problem) => {
          let kind = error_kind(error: &problem);
          if kind == 5_u8 {
            return 3_u8;
          }
          return 4_u8;
        }
      }
    }
    Err(error: problem) => {
      return 1_u8;
    }
  }
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  doc "An absolute path given as an argument opens the file it names, ignoring the base, a sibling directory that holds a decoy at the path's last two components. Before HostPaths exists name resolution rejects; an open that refused the absolute spelling exits 3, one that read the decoy or any other bytes exits 2, and an invocation without the authority exits 9.";
  let std::process::Inputs(args: args, cwd: directory, handles: factory, host_paths: host_paths, ..) = move inputs;
  let std::fs::Directory(read: reader, write: writer) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move writer);
  let outcome = 9_u8;
  match std::fs::open_directory(factory: &factory, root: &reader, name: &elsewhere[0_u64..9_u64], start: 0_u64, end: 9_u64) {
    Ok(value: base) => {
      match move host_paths {
        Some(value: paths) => {
          set outcome = exercise(args: &args, factory: &factory, paths: &paths, base: &base);
        }
        None() => {
        }
      }
      std::fs::close_directory(factory: &factory, directory: move base);
    }
    Err(error: problem) => {
      set outcome = 8_u8;
    }
  }
  std::fs::close_directory(factory: &factory, directory: move reader);
  return std::process::exit_status(code: outcome);
}
