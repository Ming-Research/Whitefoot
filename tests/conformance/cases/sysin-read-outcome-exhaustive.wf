alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias ReadStop = std::io::ReadStop;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias read_next = std::io::read_next;

fn main(inputs: Inputs) -> status: ExitStatus pure may_wait {
  doc "ReadStop is an ordinary enum nested inside Result. Omitting ReadFailed from its match remains ERR-2 non-exhaustiveness; the storage and reference changes alter the API shape without weakening the rejected coverage.";
  let Inputs(args: unused_args, cwd: unused_cwd_directory, stdout: unused_stdout, stderr: unused_stderr, handles: entry_factory, stdin: input, clock: unused_clock, wall_clock: unused_wall_clock) = move inputs;
  let std::fs::Directory(read: unused_cwd, write: unused_cwd_write) = move unused_cwd_directory;
  std::fs::close_directory_write(factory: &entry_factory, directory: move unused_cwd_write);
  close_directory(factory: &entry_factory, directory: move unused_cwd);
  let chunk = slots_new::<u8, 4>();
  for @scratch (
    at in 0_u64..4_u64,
    invariant grown: chunk.len >= at,
    invariant vacancy: chunk.cap - chunk.len + at >= 4_u64
  ) {
    place_back(window: &chunk, value: 0_u8);
  }
  let window = &chunk[0_u64..4_u64];
  let no_deadline = None<std::time::Instant>();
  match read_next(factory: &entry_factory, input: &input, destination: window, start: 0_u64, end: 4_u64, deadline: no_deadline) {
    Ok(value: endpoint) => {
    }
    Err(error: read_stop_7) => {
      match read_stop_7 {
        ReadEnd() => {
        }
      }
    }
  }
  return exit_status(code: 0_u8);
}
