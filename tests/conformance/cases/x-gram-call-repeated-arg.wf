alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn add2(x: i32, y: i32) -> function_result: i32 pure {
  return x +wrap y;
}

fn main() -> status: ExitStatus pure {
  doc "GRAM-11: a call to add2 repeating parameter x (x, x) is rejected - the second slot must be y; a repeat is never a reordering license.";
  let r = add2(x: 1_i32, x: 2_i32);
  return exit_status(code: 0_u8);
}
