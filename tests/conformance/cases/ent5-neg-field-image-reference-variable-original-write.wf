struct Reading {
  value: i64;
}

fn make() -> made: Reading pure contract {
  ensures -1000_i64 <= made.value;
} {
  doc "The construction carries 0 into the field the postcondition names.";
  return Reading(value: 0_i64);
}

fn shift(d: u8, x: i64) -> result: i64 pure {
  doc "The reference variable's referent path is the local itself, so a write through the original place kills the image the field read through the variable takes; the copy is unbounded and the subtraction of a widened byte may overflow.";
  let e = make();
  let r = &e;
  set e.value = x;
  let c = r^.value;
  let w = cvt::<u8, i64>(d);
  let v = c - w;
  return v;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
