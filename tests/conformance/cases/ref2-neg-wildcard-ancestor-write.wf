alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Node {
  value: u64;
  next: Option<Box<Node>>;
}

fn inspect(root: &Node) -> result: u64 writes(root) {
  doc "An unknown-depth cursor is invalidated by a potentially destructive write through its ancestor.";
  let cursor = root;
  for (i in 0_u64..2_u64) {
    match cursor^.next {
      Some(value: child) => {
        set cursor = &child^.inner;
      }
      None() => {
        break;
      }
    }
  }
  set root^.next = None<Box<Node>>();
  return cursor^.value;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
