fn make(index: &u64) -> result: Slots<u64, 4> writes(index) contract {
  ensures index^ == 1_u64;
  ensures result.len == 1_u64;
} {
  set index^ = 1_u64;
  let slots = slots_new::<u64, 4>();
  place_back(window: &slots, value: 7_u64);
  return move slots;
}

fn main() -> status: std::process::ExitStatus pure {
  let rows = slots_new::<Slots<u64, 4>, 2>();
  let first = slots_new::<u64, 4>();
  let second = slots_new::<u64, 4>();
  place_back(window: &rows, value: move first);
  place_back(window: &rows, value: move second);
  let index = 0_u64;
  let destination = &rows[index];
  set destination^ = make(index: &index);
  let value = destination^[0_u64];
  return std::process::exit_status(code: 0_u8);
}
