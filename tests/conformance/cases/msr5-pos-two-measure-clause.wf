alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn filled<T: copy, const n: u64>(value: T) -> result: Slots<T, n> pure contract {
  ensures result.len >= n;
  ensures result.cap <= result.len;
} {
  doc "Builds a window of n slots, every one holding a copy of value; the copy bound is what admits the bare repeated use.";
  let built = slots_new::<T, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: built.len >= at,
    invariant spare: built.cap - built.len + at >= n
  ) {
    place_back(window: &built, value: value);
  }
  return move built;
}

fn read_shared(short: Slots<u8, 4>, long: Slots<u8, 8>) -> value: u8 pure contract {
  requires short.len <= long.len;
  requires 3_u64 < short.len;
} {
  doc "A two-measure clause chains to the subscript bound with no contract definition.";
  return long[3_u64];
}

fn main() -> status: ExitStatus pure {
  doc "MSR-5: a clause names a measure of a place directly on either side of its comparison, and again against a literal, with no contract definition in the block.";
  let small = filled::<u8, 4>(value: 0_u8);
  let large = filled::<u8, 8>(value: 0_u8);
  let value = read_shared(short: move small, long: move large);
  if value == 0_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
