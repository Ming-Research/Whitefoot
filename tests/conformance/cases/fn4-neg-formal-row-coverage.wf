alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Counter {
  count: u64;
}

interface PureMember {
  fn apply(store: &Counter, x: i32) -> result: i32 reads(store.count);
}

fn writing_apply(store: &Counter, x: i32) -> result: i32 writes(store.count) {
  doc "FN-4 requires each actual write to be covered by a formal write. A writing actual exceeds a reads-only formal; writes subsumes reads, not conversely [EFF-1].";
  let seen = deref(store).count;
  set deref(store).count = seen;
  return x;
}

binding First : PureMember {
  apply = writing_apply;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
