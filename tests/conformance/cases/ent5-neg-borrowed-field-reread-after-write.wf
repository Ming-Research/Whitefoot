alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Cell {
  v: u8;
}

fn h3(b: &Cell, w: u8) -> result: u8 writes(b.v) {
  doc "A field reached through a reference parameter is replaced between two reads. The earlier local copy's bound cannot prove the fresh field read's domain [ENT-5, OP-2].";
  let old = deref(b).v;
  let bounded = old <= 5_u8;
  if bounded {
    set deref(b).v = w;
    let cur = deref(b).v;
    let z = cur + 250_u8;
    return z;
  } else {
    return 0_u8;
  }
}

fn main() -> status: ExitStatus pure {
  doc "No construction is needed to exercise the reread kill.";
  return exit_status(code: 0_u8);
}
