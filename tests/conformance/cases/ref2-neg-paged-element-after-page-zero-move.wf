fn main() -> status: std::process::ExitStatus pure {
  doc "Page-zero replacement relocates its element and invalidates an element reference under REF-2.";
  let p = box_paged_new::<u64>(capacity: 1_u64);
  place_back(window: &p.inner, value: 3_u64);
  let selected = &p.inner[0_u64];
  grow_paged(cell: &p, capacity: 2_u64);
  let seen = selected^;
  return std::process::exit_status(code: 0_u8);
}
