struct Pair {
  left: u64;
  right: u64;
}

interface Touch {
  fn touch(pair: &Pair, other: &u64) -> result: unit writes(pair.left), writes(other) contract {
    ensures pair^.right == entry(pair)^.right;
  };
}

fn update(actual_pair: &Pair, actual_other: &u64) -> updated: unit writes(actual_other) {
  set actual_other^ = 1_u64;
  return unit;
}

binding AliasingTouch : Touch {
  touch = update;
}

fn exercise<interface Touch>(target: &Pair) -> exercised: unit writes(target) {
  Touch::touch(pair: target, other: &target^.right);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let initial = Pair(left: 0_u64, right: 9_u64);
  exercise::<AliasingTouch>(target: &initial);
  return std::process::exit_status(code: 0_u8);
}
