struct Pair {
  marker: u64;
  value: u64;
}

fn helper(frame: &Pair, other: &Pair) -> result: unit writes(frame.marker), writes(other.value) contract {
  requires frame^.value == 0_u64;
  ensures frame^.value == 0_u64;
} {
  set frame^.marker = 1_u64;
  set other^.value = 1_u64;
  return unit;
}

fn caller(first: Shared<Pair>, second: Shared<Pair>) -> result: unit pure waits {
  doc "EFF-5: potentially aliased atomic targets use the ordinary path overlap judgment for contract reads.";
  atomic a = &first, b = &second when a^.value == 0_u64 {
    helper(frame: a, other: b);
  }
  return unit;
}
