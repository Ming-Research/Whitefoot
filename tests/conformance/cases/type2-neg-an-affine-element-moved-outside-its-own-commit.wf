alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "An affine element leaves its slot through take_back, remove_at, or swap, and through nothing else. A bare move out of a window slot is none of those: it would mint a second owner of the stored value and leave the slot holding one it no longer owns.";
  let empty = slots_new::<Box<Slots<u8>>, 2>();
  let small = box_slots_new::<u8>(capacity: 256_u64);
  place_back(window: &empty, value: move small);
  let grid = move empty;
  let stolen = move grid[0_u64];
  let width = stolen.inner.cap - stolen.inner.len;
  if width == 256_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
