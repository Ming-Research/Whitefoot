enum InflateError {
  Truncated();
  InvalidStoredLength();
  InvalidHuffmanTree();
  InvalidHuffmanCode();
  InvalidDistance();
  InvalidBlockType();
  OutputFull();
}

struct InflateState {
  input_offset: u64;
  output_offset: u64;
  hold: u64;
  bits: u32;
}

const length_bases: Array<u16, 29> =[3_u16, 4_u16, 5_u16, 6_u16, 7_u16, 8_u16, 9_u16, 10_u16, 11_u16, 13_u16, 15_u16, 17_u16, 19_u16, 23_u16, 27_u16, 31_u16, 35_u16, 43_u16, 51_u16, 59_u16, 67_u16, 83_u16, 99_u16, 115_u16, 131_u16, 163_u16, 195_u16, 227_u16, 258_u16];

const length_extras: Array<u8, 29> =[0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 0_u8, 1_u8, 1_u8, 1_u8, 1_u8, 2_u8, 2_u8, 2_u8, 2_u8, 3_u8, 3_u8, 3_u8, 3_u8, 4_u8, 4_u8, 4_u8, 4_u8, 5_u8, 5_u8, 5_u8, 5_u8, 0_u8];

const distance_bases: Array<u16, 30> =[1_u16, 2_u16, 3_u16, 4_u16, 5_u16, 7_u16, 9_u16, 13_u16, 17_u16, 25_u16, 33_u16, 49_u16, 65_u16, 97_u16, 129_u16, 193_u16, 257_u16, 385_u16, 513_u16, 769_u16, 1025_u16, 1537_u16, 2049_u16, 3073_u16, 4097_u16, 6145_u16, 8193_u16, 12289_u16, 16385_u16, 24577_u16];

const distance_extras: Array<u8, 30> =[0_u8, 0_u8, 0_u8, 0_u8, 1_u8, 1_u8, 2_u8, 2_u8, 3_u8, 3_u8, 4_u8, 4_u8, 5_u8, 5_u8, 6_u8, 6_u8, 7_u8, 7_u8, 8_u8, 8_u8, 9_u8, 9_u8, 10_u8, 10_u8, 11_u8, 11_u8, 12_u8, 12_u8, 13_u8, 13_u8];

fn read_bits(state: &InflateState, input: &[u8], count: u32, mask: u64) -> outcome: Result<u64, InflateError> reads(input), writes(state.input_offset), writes(state.hold), writes(state.bits) contract {
  ensures when Ok(value: result): result <= mask;
} {
  doc "The bit reservoir is reached through the state reference its row declares, and the compressed bytes through a range reference the caller formed.";
  loop @fill_bits {
    let enough = deref(state).bits >= count;
    if enough {
      break @fill_bits;
    } else {
      let input_length = deref(input).len;
      let input_done = deref(state).input_offset >= input_length;
      if input_done {
        let error = InflateError::Truncated();
        return Err<u64, InflateError>(error: error);
      }
      let next_byte = deref(input)[deref(state).input_offset];
      let next_word = cvt::<u8, u64>(next_byte);
      let shifted = ishl.wrap(next_word, deref(state).bits);
      set deref(state).hold = ior(deref(state).hold, shifted);
      set deref(state).bits = deref(state).bits +wrap 8_u32;
      set deref(state).input_offset = deref(state).input_offset +wrap 1_u64;
    }
  }
  let value = iand(deref(state).hold, mask);
  set deref(state).hold = ishr.wrap(deref(state).hold, count);
  set deref(state).bits = deref(state).bits -wrap count;
  return Ok<u64, InflateError>(value: value);
}

fn decode_fixed_symbol(state: &InflateState, input: &[u8]) -> result: Result<u64, InflateError> reads(input), writes(state.input_offset), writes(state.hold), writes(state.bits) {
  let code = 0_u64;
  let first = 0_u64;
  let symbol_index = 0_u64;
  let bit_length = 1_u32;
  let decoded = 0_u64;
  loop @code_lengths {
    let bit = 0_u64;
    match read_bits(state: state, input: input, count: 1_u32, mask: 1_u64) {
      Ok(value: read_bit) => {
        set bit = read_bit;
      }
      Err(error: read_error) => {
        return Err<u64, InflateError>(error: read_error);
      }
    }
    set code = ior(code, bit);
    let count = 0_u64;
    if bit_length == 7_u32 {
      set count = 24_u64;
    } else if bit_length == 8_u32 {
      set count = 152_u64;
    } else if bit_length == 9_u32 {
      set count = 112_u64;
    }
    let first_after_count = first +wrap count;
    let at_or_after_first = code >= first;
    let before_end = code < first_after_count;
    let found = band(at_or_after_first, before_end);
    if found {
      let offset = code -wrap first;
      let ordered = symbol_index +wrap offset;
      if ordered < 24_u64 {
        set decoded = ordered +wrap 256_u64;
        break @code_lengths;
      }
      if ordered < 168_u64 {
        set decoded = ordered -wrap 24_u64;
        break @code_lengths;
      }
      if ordered < 176_u64 {
        let tail = ordered -wrap 168_u64;
        set decoded = tail +wrap 280_u64;
        break @code_lengths;
      }
      set decoded = ordered -wrap 32_u64;
      break @code_lengths;
    }
    set symbol_index = symbol_index +wrap count;
    set first = ishl.wrap(first_after_count, 1_u32);
    set code = ishl.wrap(code, 1_u32);
    if bit_length == 9_u32 {
      let error = InflateError::InvalidHuffmanCode();
      return Err<u64, InflateError>(error: error);
    }
    set bit_length = bit_length +wrap 1_u32;
  }
  return Ok<u64, InflateError>(value: decoded);
}

fn emit_byte(state: &InflateState, out: &[u8], value: u8) -> result: Result<unit, InflateError> writes(state.output_offset), writes(out) {
  doc "One decoded byte lands in the caller's range reference; its length is the range's own measure [REF-4, MSR-1].";
  let output_length = deref(out).len;
  let output_full = deref(state).output_offset >= output_length;
  if output_full {
    let error = InflateError::OutputFull();
    return Err<unit, InflateError>(error: error);
  }
  set deref(out)[deref(state).output_offset] = value;
  set deref(state).output_offset = deref(state).output_offset +wrap 1_u64;
  return Ok<unit, InflateError>(value: unit);
}

fn decode_fixed(state: &InflateState, input: &[u8], out: &[u8]) -> result: Result<unit, InflateError> reads(input), writes(state.input_offset), writes(state.output_offset), writes(state.hold), writes(state.bits), writes(out) {
  loop @fixed_codes {
    let symbol = 0_u64;
    match decode_fixed_symbol(state: state, input: input) {
      Ok(value: decoded_symbol) => {
        set symbol = decoded_symbol;
      }
      Err(error: symbol_error) => {
        return Err<unit, InflateError>(error: symbol_error);
      }
    }
    let literal = symbol <= 255_u64;
    if literal {
      let byte = cvt::<u64, u8>(symbol);
      match emit_byte(state: state, out: out, value: byte) {
        Ok(value: emitted) => {
        }
        Err(error: emit_error) => {
          return Err<unit, InflateError>(error: emit_error);
        }
      }
    } else {
      let end_of_block = symbol == 256_u64;
      if end_of_block {
        break @fixed_codes;
      } else {
        let copy_length = 0_u64;
        match decode_length(state: state, input: input, symbol: symbol) {
          Ok(value: decoded_length) => {
            set copy_length = decoded_length;
          }
          Err(error: length_error) => {
            return Err<unit, InflateError>(error: length_error);
          }
        }
        let distance_symbol = 0_u64;
        match read_bits(state: state, input: input, count: 5_u32, mask: 31_u64) {
          Ok(value: distance_code) => {
            let remaining = distance_code;
            for (bit in 0_u64..5_u64) {
              let shifted = ishl.wrap(distance_symbol, 1_u32);
              let low_bit = iand(remaining, 1_u64);
              set distance_symbol = ior(shifted, low_bit);
              set remaining = ishr(remaining, 1_u32);
            }
          }
          Err(error: distance_symbol_error) => {
            return Err<unit, InflateError>(error: distance_symbol_error);
          }
        }
        match copy_distance(state: state, input: input, out: out, copy_length: copy_length, distance_symbol: distance_symbol) {
          Ok(value: copied) => {
          }
          Err(error: copy_error) => {
            return Err<unit, InflateError>(error: copy_error);
          }
        }
      }
    }
  }
  return Ok<unit, InflateError>(value: unit);
}

fn inflate(out: &[u8], input: &[u8]) -> result: Result<u64, InflateError> reads(input), writes(out) {
  doc "The decoder owns no storage: its compressed input and its destination are two range references the caller formed, and the bit reservoir is one frame-resident struct [REF-4, STOR-1].";
  let input_length = deref(input).len;
  let output_length = deref(out).len;
  let state = InflateState(input_offset: 0_u64, output_offset: 0_u64, hold: 0_u64, bits: 0_u32);
  loop @blocks {
    let final_value = 0_u64;
    match read_bits(state: &state, input: input, count: 1_u32, mask: 1_u64) {
      Ok(value: final_bit) => {
        set final_value = final_bit;
      }
      Err(error: final_error) => {
        return Err<u64, InflateError>(error: final_error);
      }
    }
    let final_block = final_value == 1_u64;
    let block_type = 0_u64;
    match read_bits(state: &state, input: input, count: 2_u32, mask: 3_u64) {
      Ok(value: block_type_bits) => {
        set block_type = block_type_bits;
      }
      Err(error: block_type_error) => {
        return Err<u64, InflateError>(error: block_type_error);
      }
    }
    let stored_block = block_type == 0_u64;
    if stored_block {
      set state.hold = 0_u64;
      set state.bits = 0_u32;
      let length_bytes_remaining = input_length -wrap state.input_offset;
      let length_truncated = length_bytes_remaining < 4_u64;
      if length_truncated {
        let error = InflateError::Truncated();
        return Err<u64, InflateError>(error: error);
      }
      let len_high_offset = state.input_offset +wrap 1_u64;
      let nlen_low_offset = state.input_offset +wrap 2_u64;
      let nlen_high_offset = state.input_offset +wrap 3_u64;
      let header_room = deref(input).len;
      let header_zero_ok = state.input_offset < header_room;
      if header_zero_ok {
      } else {
        let error = InflateError::Truncated();
        return Err<u64, InflateError>(error: error);
      }
      let len_low_byte = deref(input)[state.input_offset];
      let header_one_ok = len_high_offset < header_room;
      if header_one_ok {
      } else {
        let error = InflateError::Truncated();
        return Err<u64, InflateError>(error: error);
      }
      let len_high_byte = deref(input)[len_high_offset];
      let header_two_ok = nlen_low_offset < header_room;
      if header_two_ok {
      } else {
        let error = InflateError::Truncated();
        return Err<u64, InflateError>(error: error);
      }
      let nlen_low_byte = deref(input)[nlen_low_offset];
      let header_three_ok = nlen_high_offset < header_room;
      if header_three_ok {
      } else {
        let error = InflateError::Truncated();
        return Err<u64, InflateError>(error: error);
      }
      let nlen_high_byte = deref(input)[nlen_high_offset];
      set state.input_offset = state.input_offset +wrap 4_u64;
      let len_low = cvt::<u8, u16>(len_low_byte);
      let len_high_word = cvt::<u8, u16>(len_high_byte);
      let len_high = ishl.wrap(len_high_word, 8_u32);
      let stored_length = ior(len_low, len_high);
      let nlen_low = cvt::<u8, u16>(nlen_low_byte);
      let nlen_high_word = cvt::<u8, u16>(nlen_high_byte);
      let nlen_high = ishl.wrap(nlen_high_word, 8_u32);
      let stored_complement = ior(nlen_low, nlen_high);
      let expected_complement = inot(stored_length);
      let complement_valid = stored_complement == expected_complement;
      if complement_valid {
      } else {
        let error = InflateError::InvalidStoredLength();
        return Err<u64, InflateError>(error: error);
      }
      let copy_length = cvt::<u16, u64>(stored_length);
      let input_remaining = input_length -wrap state.input_offset;
      let input_short = input_remaining < copy_length;
      if input_short {
        let error = InflateError::Truncated();
        return Err<u64, InflateError>(error: error);
      }
      let output_remaining = output_length -wrap state.output_offset;
      let output_short = output_remaining < copy_length;
      if output_short {
        let error = InflateError::OutputFull();
        return Err<u64, InflateError>(error: error);
      }
      let copied = 0_u64;
      loop @copy_stored {
        let copy_done = copied == copy_length;
        if copy_done {
          break @copy_stored;
        } else {
          let source_index = state.input_offset +wrap copied;
          let stored_room = deref(input).len;
          let source_in_input = source_index < stored_room;
          if source_in_input {
          } else {
            let error = InflateError::Truncated();
            return Err<u64, InflateError>(error: error);
          }
          let byte = deref(input)[source_index];
          match emit_byte(state: &state, out: out, value: byte) {
            Ok(value: emitted) => {
            }
            Err(error: emit_error) => {
              return Err<u64, InflateError>(error: emit_error);
            }
          }
          set copied = copied +wrap 1_u64;
        }
      }
      set state.input_offset = state.input_offset +wrap copy_length;
    } else {
      let fixed_block = block_type == 1_u64;
      if fixed_block {
        match decode_fixed(state: &state, input: input, out: out) {
          Ok(value: decoded) => {
          }
          Err(error: decode_error) => {
            return Err<u64, InflateError>(error: decode_error);
          }
        }
      } else {
        let dynamic_block = block_type == 2_u64;
        if dynamic_block {
          match decode_dynamic(state: &state, input: input, out: out) {
            Ok(value: decoded) => {
            }
            Err(error: decode_error) => {
              return Err<u64, InflateError>(error: decode_error);
            }
          }
        } else {
          let error = InflateError::InvalidBlockType();
          return Err<u64, InflateError>(error: error);
        }
      }
    }
    if final_block {
      break @blocks;
    }
  }
  return Ok<u64, InflateError>(value: state.output_offset);
}
