alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Block {
  bytes: Slots<u8, 256>;
}

nodrop struct Lease {
  run: Block;
}

struct BlockPool {
  free: Slots<Block, 8>;
}

fn block_new() -> made: Block pure {
  doc "One run of 256 slots, frame-resident inside the block that owns it [STOR-1].";
  let bytes = slots_new::<u8, 256>();
  let made = Block(bytes: move bytes);
  return move made;
}

fn pool_new() -> made: BlockPool pure {
  doc "A pool is a Slots plus the blocks it holds [OP-13]: eight runs are carved into one run of runs and kept as a free list.";
  let free = slots_new::<Block, 8>();
  for @carve (
    at in 0_u64..8_u64,
    invariant grown: free.len >= at,
    invariant bounded: free.len <= at,
    invariant spare: free.cap - free.len + at >= 8_u64
  ) {
    let run = block_new();
    place_back(window: &free, value: move run);
  }
  let pool = BlockPool(free: move free);
  return move pool;
}

fn take_free(free: &Slots<Block, 8>) -> block: Block writes(free.last), writes(free.len) contract {
  requires deref(free).len > 0_u64;
  ensures deref(free).len + 1_u64 == deref(entry(free)).len;
} {
  doc "One block off the back boundary; the row names exactly the last filled slot and the length take_back moves [OP-10].";
  let block = take_back(window: free);
  return move block;
}

fn return_free(free: &Slots<Block, 8>, block: Block) -> result: unit writes(free.next), writes(free.len) contract {
  requires deref(free).len < deref(free).cap;
  ensures deref(free).len == deref(entry(free)).len + 1_u64;
} {
  doc "One block back onto the append slot, under the caller's proof that the free list has room.";
  place_back(window: free, value: move block);
  return unit;
}

fn pool_take(pool: BlockPool) -> (rest: BlockPool, leased: Option<Lease>) pure {
  doc "Leases one run, or reports that the free list is empty. The pool arrives by value, so the row is empty and the reference the body forms is rooted in local storage [EFF-1, EFF-2].";
  let spare = pool.free.len;
  let any = spare > 0_u64;
  if any {
    let one = take_free(free: &pool.free);
    invariant removed_one_upper: pool.free.len + 1_u64 <= spare;
    invariant removed_one_lower: pool.free.len + 1_u64 >= spare;
    let ticket = Lease(run: move one);
    return move pool, Some<Lease>(value: move ticket);
  }
  return move pool, None<Lease>();
}

fn pool_release(pool: BlockPool, lease: Lease) -> rest: BlockPool pure contract {
  requires pool.free.len < pool.free.cap;
} {
  doc "Returns one lease to the free list; the caller has proved there is room. The linear lease leaves this scope only by being taken apart, which is what makes the return unavoidable [PROV-6].";
  let Lease(run: back) = move lease;
  return_free(free: &pool.free, block: move back);
  return move pool;
}

struct StaticBlock {
  bytes: Slots<u8, 4>;
}

fn take_static(free: &Slots<StaticBlock, 2>) -> block: StaticBlock writes(free.last), writes(free.len) contract {
  requires deref(free).len > 0_u64;
  ensures deref(free).len + 1_u64 == deref(entry(free)).len;
} {
  doc "The same boundary take over a frame-resident element type.";
  let block = take_back(window: free);
  return move block;
}

fn return_static(free: &Slots<StaticBlock, 2>, block: StaticBlock) -> result: unit writes(free.next), writes(free.len) contract {
  requires deref(free).len < deref(free).cap;
  ensures deref(free).len == deref(entry(free)).len + 1_u64;
} {
  doc "The same boundary place over a frame-resident element type.";
  place_back(window: free, value: move block);
  return unit;
}

fn static_block_round_trip() -> code: u8 pure {
  doc "One block leaves the free list, every byte of its run is incremented, and the block goes back; a second round trip reads the incremented bytes back out.";
  let payload = slots_new::<u8, 4>();
  place_back(window: &payload, value: 1_u8);
  place_back(window: &payload, value: 2_u8);
  place_back(window: &payload, value: 3_u8);
  place_back(window: &payload, value: 4_u8);
  let record = StaticBlock(bytes: move payload);
  let full = slots_new::<StaticBlock, 2>();
  place_back(window: &full, value: move record);
  let block = take_static(free: &full);
  invariant capacity: block.bytes.cap >= 4_u64;
  let length = block.bytes.len;
  for (at in 0_u64..length) {
    let byte = block.bytes[at];
    let next = byte +wrap 1_u8;
    set block.bytes[at] = next;
  }
  return_static(free: &full, block: move block);
  let recovered = take_static(free: &full);
  let recovered_length = recovered.bytes.len;
  let sum = 0_u8;
  for (at in 0_u64..recovered_length) {
    let byte = recovered.bytes[at];
    set sum = sum +wrap byte;
  }
  return_static(free: &full, block: move recovered);
  invariant conserved: full.len >= 1_u64;
  let result = sum -wrap 14_u8;
  return result;
}

fn boxed_block_round_trip() -> code: u8 pure {
  doc "The same round trip where the free list holds heap cells: a Box owns one heap object, its content is the field inner, and the cell is released when its owner's scope ends [TYPE-9, STOR-3].";
  let payload = slots_new::<u8, 4>();
  place_back(window: &payload, value: 1_u8);
  place_back(window: &payload, value: 2_u8);
  place_back(window: &payload, value: 3_u8);
  place_back(window: &payload, value: 4_u8);
  let cell = box_new::<Slots<u8, 4>>(value: move payload);
  let free = slots_new::<Box<Slots<u8, 4>>, 2>();
  place_back(window: &free, value: move cell);
  let block = take_back(window: &free);
  invariant capacity: block.inner.cap >= 4_u64;
  let length = block.inner.len;
  for (at in 0_u64..length) {
    let byte = block.inner[at];
    let next = byte +wrap 1_u8;
    set block.inner[at] = next;
  }
  place_back(window: &free, value: move block);
  let recovered = take_back(window: &free);
  let recovered_length = recovered.inner.len;
  let sum = 0_u8;
  for (at in 0_u64..recovered_length) {
    let byte = recovered.inner[at];
    set sum = sum +wrap byte;
  }
  place_back(window: &free, value: move recovered);
  invariant conserved: free.len >= 1_u64;
  let result = sum -wrap 14_u8;
  return result;
}

fn main() -> status: ExitStatus pure {
  doc "Runs the block pool: eight runs carved into one run of runs, a lease taken off the back boundary and returned to a free list the caller proved had room, then the two round trips over a frame-resident and a heap-cell element type.";
  let pool = pool_new();
  let held = pool.free.len;
  if held == 8_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  let (rest, leased) = pool_take(pool: move pool);
  match leased {
    None() => {
      return exit_status(code: 3_u8);
    }
    Some(value: ticket) => {
      let spare = rest.free.len;
      let fits = spare < 8_u64;
      if fits {
        let back = pool_release(pool: move rest, lease: move ticket);
        let full = back.free.len;
        if full == 8_u64 {
        } else {
          return exit_status(code: 4_u8);
        }
      } else {
        let Lease(run: orphan) = move ticket;
        return exit_status(code: 5_u8);
      }
    }
  }
  let static_code = static_block_round_trip();
  if static_code != 0_u8 {
    return exit_status(code: static_code);
  }
  let boxed_code = boxed_block_round_trip();
  return exit_status(code: boxed_code);
}
