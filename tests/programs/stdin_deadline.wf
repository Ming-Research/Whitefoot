alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias Instant = std::time::Instant;
alias IoError = std::io::IoError;
alias ReadStop = std::io::ReadStop;
alias close_directory = std::fs::close_directory;
alias close_directory_write = std::fs::close_directory_write;
alias exit_status = std::process::exit_status;
alias instant_after = std::time::instant_after;
alias instant_reached = std::time::instant_reached;
alias now = std::time::now;
alias read_next = std::io::read_next;

fn deadline_passed(error: &IoError) -> result: Bool reads(error) {
  doc "Whether an operation's outcome is the passing of its own deadline [PRE-2].";
  match error^ {
    NotFound(code: c, origin: o) => {
      return False();
    }
    PermissionDenied(code: c, origin: o) => {
      return False();
    }
    AlreadyExists(code: c, origin: o) => {
      return False();
    }
    NotDirectory(code: c, origin: o) => {
      return False();
    }
    IsDirectory(code: c, origin: o) => {
      return False();
    }
    DirectoryNotEmpty(code: c, origin: o) => {
      return False();
    }
    ReadOnly(code: c, origin: o) => {
      return False();
    }
    ResourceBusy(code: c, origin: o) => {
      return False();
    }
    InvalidInput(code: c, origin: o) => {
      return False();
    }
    InvalidPath(code: c, origin: o) => {
      return False();
    }
    Unsupported(code: c, origin: o) => {
      return False();
    }
    TimedOut(code: c, origin: o) => {
      return False();
    }
    DeadlinePassed() => {
      return True();
    }
    BrokenPipe(code: c, origin: o) => {
      return False();
    }
    WriteZero(code: c, origin: o) => {
      return False();
    }
    UnexpectedEnd(code: c, origin: o) => {
      return False();
    }
    ConnectionRefused(code: c, origin: o) => {
      return False();
    }
    ConnectionReset(code: c, origin: o) => {
      return False();
    }
    ConnectionAborted(code: c, origin: o) => {
      return False();
    }
    NotConnected(code: c, origin: o) => {
      return False();
    }
    AddressInUse(code: c, origin: o) => {
      return False();
    }
    AddressUnavailable(code: c, origin: o) => {
      return False();
    }
    ResourceExhausted(code: c, origin: o) => {
      return False();
    }
    FileTooLarge(code: c, origin: o) => {
      return False();
    }
    NoSpace(code: c, origin: o) => {
      return False();
    }
    QuotaExceeded(code: c, origin: o) => {
      return False();
    }
    CrossDevice(code: c, origin: o) => {
      return False();
    }
    DeviceFailure(code: c, origin: o) => {
      return False();
    }
    Other(code: c, origin: o) => {
      return False();
    }
  }
}

fn read_stop_deadline(stop: &ReadStop) -> result: Bool reads(stop) {
  doc "Whether a receive ended because its deadline passed.";
  match stop^ {
    ReadEnd() => {
      return False();
    }
    ReadFailed(error: failure) => {
      let passed = deadline_passed(error: failure);
      return passed;
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure must_wait {
  doc "Reads standard input with a deadline while its writer is silent, then reads the byte the writer sends afterwards, which the bounded read did not take [PRE-2].";
  let Inputs(args: unused_args, cwd: cwd_directory, stdout: unused_stdout, stderr: unused_stderr, handles: handles, stdin: input, clock: clock, wall_clock: unused_wall_clock) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  close_directory_write(factory: &handles, directory: move cwd_write);
  close_directory(factory: &handles, directory: move cwd);
  let bytes = slots_new::<u8, 1>();
  place_back(window: &bytes, value: 0_u8);
  let started = now(clock: &clock);
  let soon = instant_after(instant: started, nanoseconds: 50000000_u64);
  let bound = Some<Instant>(value: soon);
  let destination = &bytes[0_u64..1_u64];
  match read_next(factory: &handles, input: &input, destination: destination, start: 0_u64, end: 1_u64, deadline: bound) {
    Ok(value: received) => {
      return exit_status(code: 10_u8);
    }
    Err(error: stop) => {
      let passed = read_stop_deadline(stop: &stop);
      if passed {
      } else {
        return exit_status(code: 11_u8);
      }
    }
  }
  let after = now(clock: &clock);
  let reached = instant_reached(deadline: soon, instant: after);
  if reached {
  } else {
    return exit_status(code: 12_u8);
  }
  let no_deadline = None<Instant>();
  let again = &bytes[0_u64..1_u64];
  match read_next(factory: &handles, input: &input, destination: again, start: 0_u64, end: 1_u64, deadline: no_deadline) {
    Ok(value: received) => {
      if received != 1_u64 {
        return exit_status(code: 13_u8);
      }
    }
    Err(error: stop) => {
      return exit_status(code: 14_u8);
    }
  }
  if bytes[0_u64] != 122_u8 {
    return exit_status(code: 15_u8);
  }
  return exit_status(code: 0_u8);
}
