alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Account {
  id: u64;
  balance: u64;
  limit: u64;
  owner: u64;
}

struct Ledger {
  serial: u64;
  head: Account;
}

fn account_at(accounts: &Box<Slots<Account>>, index: u64) -> account: Account reads(accounts) contract {
  requires index < accounts^.inner.len;
} {
  doc "The account stored at one index of the table.";
  let account = accounts^.inner[index];
  return account;
}

fn account_or_closed(accounts: &Box<Slots<Account>>, index: u64) -> account: Account reads(accounts) {
  doc "The account at one index, or a closed account past the end of the table.";
  if index < accounts^.inner.len {
    let account = accounts^.inner[index];
    return account;
  }
  return Account(id: 0_u64, balance: 0_u64, limit: 0_u64, owner: 0_u64);
}

fn checked_account(accounts: &Box<Slots<Account>>, index: u64) -> account: Account reads(accounts) contract {
  requires index < accounts^.inner.len;
} {
  doc "The account at one index, found through the plain lookup.";
  let account = account_at(accounts: accounts, index: index);
  return account;
}

fn head_account(ledger: &Ledger) -> account: Account reads(ledger) {
  doc "The account stored inline in a ledger.";
  let account = ledger^.head;
  return account;
}

fn headroom(accounts: &Box<Slots<Account>>, index: u64) -> room: u64 reads(accounts) contract {
  requires index < accounts^.inner.len;
} {
  doc "How far an account's balance is below its limit, read from two fields of the element.";
  let account = account_at(accounts: accounts, index: index);
  let balance = account.balance;
  let limit = account.limit;
  if balance < limit {
    return limit -wrap balance;
  }
  return 0_u64;
}

fn owner_and_id(accounts: &Box<Slots<Account>>, index: u64) -> pair: u64 reads(accounts) contract {
  requires index < accounts^.inner.len;
} {
  doc "An account's owner times a thousand plus its id, read through the forwarding lookup.";
  let account = checked_account(accounts: accounts, index: index);
  let owner = account.owner;
  let id = account.id;
  let scaled = owner *wrap 1000_u64;
  return scaled +wrap id;
}

fn balance_before_deposit(accounts: &Box<Slots<Account>>, index: u64, amount: u64) -> before: u64 writes(accounts) contract {
  requires index < accounts^.inner.len;
} {
  doc "Reads an account, then replaces it with a deposited copy before reading its balance: the balance read is the old one.";
  let account = account_at(accounts: accounts, index: index);
  let id = account.id;
  let balance = account.balance;
  let limit = account.limit;
  let owner = account.owner;
  let raised = balance +wrap amount;
  set accounts^.inner[index] = Account(id: id, balance: raised, limit: limit, owner: owner);
  let before = account.balance;
  return before;
}

fn ledger_owner_balance(ledger: &Ledger) -> sum: u64 reads(ledger) {
  doc "The inline head account's owner plus its balance.";
  let account = head_account(ledger: ledger);
  let owner = account.owner;
  let balance = account.balance;
  return owner +wrap balance;
}

fn sum_fields(accounts: &Box<Slots<Account>>, index: u64) -> sum: u64 reads(accounts) {
  doc "The sum of all four fields of an account, zero past the end of the table.";
  if index < accounts^.inner.len {
    let account = accounts^.inner[index];
    let id = account.id;
    let balance = account.balance;
    let limit = account.limit;
    let owner = account.owner;
    let first = id +wrap balance;
    let second = limit +wrap owner;
    return first +wrap second;
  }
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  let accounts = box_slots_new::<Account>(capacity: 3_u64);
  if accounts.inner.len < accounts.inner.cap {
    let first = Account(id: 1_u64, balance: 40_u64, limit: 100_u64, owner: 7_u64);
    place_back(window: &accounts.inner, value: first);
  }
  if accounts.inner.len < accounts.inner.cap {
    let second = Account(id: 2_u64, balance: 250_u64, limit: 200_u64, owner: 8_u64);
    place_back(window: &accounts.inner, value: second);
  }
  if accounts.inner.len < accounts.inner.cap {
    let third = Account(id: 3_u64, balance: 5_u64, limit: 90_u64, owner: 9_u64);
    place_back(window: &accounts.inner, value: third);
  }
  if 2_u64 < accounts.inner.len {
    let room_first = headroom(accounts: &accounts, index: 0_u64);
    if room_first != 60_u64 {
      return exit_status(code: 1_u8);
    }
    let room_second = headroom(accounts: &accounts, index: 1_u64);
    if room_second != 0_u64 {
      return exit_status(code: 2_u8);
    }
    let room_third = headroom(accounts: &accounts, index: 2_u64);
    if room_third != 85_u64 {
      return exit_status(code: 3_u8);
    }
    let pair = owner_and_id(accounts: &accounts, index: 2_u64);
    if pair != 9003_u64 {
      return exit_status(code: 4_u8);
    }
    let found = account_or_closed(accounts: &accounts, index: 1_u64);
    let found_owner = found.owner;
    let found_limit = found.limit;
    if found_owner != 8_u64 {
      return exit_status(code: 5_u8);
    }
    if found_limit != 200_u64 {
      return exit_status(code: 6_u8);
    }
    let closed = account_or_closed(accounts: &accounts, index: 9_u64);
    let closed_id = closed.id;
    let closed_balance = closed.balance;
    if closed_id != 0_u64 {
      return exit_status(code: 7_u8);
    }
    if closed_balance != 0_u64 {
      return exit_status(code: 8_u8);
    }
    let before = balance_before_deposit(accounts: &accounts, index: 0_u64, amount: 15_u64);
    if before != 40_u64 {
      return exit_status(code: 9_u8);
    }
    let deposited = sum_fields(accounts: &accounts, index: 0_u64);
    if deposited != 163_u64 {
      return exit_status(code: 10_u8);
    }
    let inline = Account(id: 4_u64, balance: 70_u64, limit: 80_u64, owner: 11_u64);
    let ledger = Ledger(serial: 12_u64, head: inline);
    let ledger_sum = ledger_owner_balance(ledger: &ledger);
    if ledger_sum != 81_u64 {
      return exit_status(code: 11_u8);
    }
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 12_u8);
}
