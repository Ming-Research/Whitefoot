const driver_count_digits: Array<u8, 10> =[48_u8, 49_u8, 50_u8, 51_u8, 52_u8, 53_u8, 54_u8, 55_u8, 56_u8, 57_u8];

fn publish_driver_count(factory: &std::io::HandleFactory, output: &std::io::OutputStream, count: u64) -> result: u8 writes(factory), writes(output) waits {
  doc "Prints the runtime driver count as two decimal digits and a newline. A count above this fixture's decimal window fails explicitly.";
  if count > 99_u64 {
    return 11_u8;
  }
  let quotient = count / 10_u64;
  let tens = quotient % 10_u64;
  let ones = count % 10_u64;
  let first = driver_count_digits[tens];
  let second = driver_count_digits[ones];
  let bytes = slots_new::<u8, 3>();
  place_back(window: &bytes, value: first);
  place_back(window: &bytes, value: second);
  place_back(window: &bytes, value: 10_u8);
  let source = &bytes[0_u64..3_u64];
  let sent = 0_u64;
  let unbounded = None<std::time::Instant>();
  let cancel = std::time::cancel_never();
  loop @publish {
    if sent < 3_u64 {
    } else {
      break @publish;
    }
    match std::io::write_once(factory: factory, output: output, source: source, start: sent, end: 3_u64, deadline: unbounded, cancel: &cancel) {
      Ok(value: endpoint) => {
        set sent = endpoint;
      }
      Err(error: failure) => {
        std::time::close_cancel_watch(watch: move cancel);
        return 12_u8;
      }
    }
  }
  std::time::close_cancel_watch(watch: move cancel);
  return 0_u8;
}

fn driver_count_child() -> result: unit pure waits {
  doc "Starts a waiting context so the runtime must start its selected drivers.";
  return unit;
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  doc "Reads and prints Inputs.drivers before the first spawn and after its join. The host test independently counts successfully published driver roles.";
  let selected = inputs.drivers;
  let std::process::Inputs(cwd: directory, stdout: output, handles: factory, ..) = move inputs;
  let std::fs::Directory(read: read_directory, write: write_directory) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move write_directory);
  std::fs::close_directory(factory: &factory, directory: move read_directory);
  if selected == 0_u64 {
    return std::process::exit_status(code: 10_u8);
  }
  let before = publish_driver_count(factory: &factory, output: &output, count: selected);
  if before != 0_u8 {
    return std::process::exit_status(code: before);
  }
  let pending = spawn driver_count_child();
  let joined = pending;
  let after = publish_driver_count(factory: &factory, output: &output, count: selected);
  return std::process::exit_status(code: after);
}
