alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn pair() -> result: Ring<u8, 4> pure contract {
  ensures result.len >= 2_u64;
  ensures result.len <= 2_u64;
  ensures result.head <= 0_u64;
} {
  doc "Builds a run of two values and publishes what its window then holds.";
  let empty = ring_new::<u8, 4>();
  place_back(window: &empty, value: 7_u8);
  let one = move empty;
  place_back(window: &one, value: 9_u8);
  let two = move one;
  return move two;
}

fn enqueue(vector: &Ring<u8, 4>, value: u8) -> result: unit writes(vector) contract {
  requires deref(vector).len < deref(vector).cap;
  ensures deref(vector).len >= deref(entry(vector)).len + 1_u64;
} {
  doc "Places one value at the back boundary of a run.";
  place_back(window: vector, value: value);
  return unit;
}

fn pass_window(values: Ring<u8, 4>) -> result: Ring<u8, 4> pure contract {
  ensures result.len == values.len;
  ensures result.head == values.head;
} {
  return move values;
}

fn main() -> status: ExitStatus pure {
  doc "Runs a queue over one four-slot Ring: the window wraps, and every element comes back in the order it went in.";
  let built = pair();
  let first_of_two = built[0_u64];
  if first_of_two == 7_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  enqueue(vector: &built, value: 8_u8);
  let grown = move built;
  let third = grown[2_u64];
  if third == 8_u8 {
  } else {
    return exit_status(code: 9_u8);
  }
  let empty = ring_new::<u8, 4>();
  place_back(window: &empty, value: 1_u8);
  let one = move empty;
  place_back(window: &one, value: 2_u8);
  let two = move one;
  place_back(window: &two, value: 3_u8);
  let three = move two;
  let taken1 = take_front(window: &three);
  let rest0 = move three;
  if taken1 == 1_u8 {
  } else {
    return exit_status(code: 2_u8);
  }
  let taken2 = take_front(window: &rest0);
  let rest1 = move rest0;
  if taken2 == 2_u8 {
  } else {
    return exit_status(code: 3_u8);
  }
  place_back(window: &rest1, value: 4_u8);
  let four = move rest1;
  place_back(window: &four, value: 5_u8);
  let five = pass_window(values: move four);
  let wrapped = five[1_u64];
  if wrapped == 4_u8 {
  } else {
    return exit_status(code: 4_u8);
  }
  let taken3 = take_front(window: &five);
  let rest2 = move five;
  if taken3 == 3_u8 {
  } else {
    return exit_status(code: 5_u8);
  }
  let taken4 = take_front(window: &rest2);
  let rest3 = move rest2;
  if taken4 == 4_u8 {
  } else {
    return exit_status(code: 6_u8);
  }
  let taken5 = take_front(window: &rest3);
  let rest4 = move rest3;
  if taken5 == 5_u8 {
  } else {
    return exit_status(code: 7_u8);
  }
  let left = rest4.len;
  if left == 0_u64 {
  } else {
    return exit_status(code: 8_u8);
  }
  return exit_status(code: 0_u8);
}
