fn store_dynamic_length(literal_lengths: &[u8], distance_lengths: &[u8], literal_count: u64, position: u64, value: u8) -> result: Result<unit, InflateError> writes(literal_lengths), writes(distance_lengths) contract {
  define literal_room = deref(literal_lengths).len;
  define enough_literals = literal_count <= literal_room;
  requires enough_literals;
} {
  doc "The two length runs are two range references over two distinct windows, so the call site proves the substituted write paths disjoint by their different roots [EFF-5, OWN-7].";
  let is_literal = position < literal_count;
  if is_literal {
    set deref(literal_lengths)[position] = value;
  } else {
    let distance_index = position -wrap literal_count;
    let distance_room = deref(distance_lengths).len;
    let distance_ok = distance_index < distance_room;
    if distance_ok {
    } else {
      let error = InflateError::InvalidHuffmanTree();
      return Err<unit, InflateError>(error: error);
    }
    set deref(distance_lengths)[distance_index] = value;
  }
  return Ok<unit, InflateError>(value: unit);
}

fn ordered_code_symbol(index: u64) -> result: Result<u64, InflateError> pure {
  let bounded = index % 19_u64;
  let unchanged = bounded == index;
  if unchanged {
  } else {
    let error = InflateError::InvalidHuffmanTree();
    return Err<u64, InflateError>(error: error);
  }
  let ordered_symbol_byte = code_length_order[bounded];
  let ordered_symbol = cvt::<u8, u64>(ordered_symbol_byte);
  return Ok<u64, InflateError>(value: ordered_symbol);
}

fn read_dynamic_code_lengths(state: &InflateState, input: &[u8], code_lengths: &[u8], code_count: u64) -> result: Result<unit, InflateError> reads(input), writes(state.input_offset), writes(state.hold), writes(state.bits), writes(code_lengths) contract {
  define code_count_fits = code_count <= 19_u64;
  define code_room = deref(code_lengths).len;
  define order_fits = 19_u64 <= code_room;
  requires code_count_fits;
  requires order_fits;
} {
  let code_index = 0_u64;
  loop @read_code_lengths {
    let codes_done = code_index == code_count;
    if codes_done {
      break @read_code_lengths;
    } else {
      let ordered_symbol = 0_u64;
      match ordered_code_symbol(index: code_index) {
        Ok(value: symbol) => {
          set ordered_symbol = symbol;
        }
        Err(error: order_error) => {
          return Err<unit, InflateError>(error: order_error);
        }
      }
      let length_bits = 0_u64;
      match read_bits(state: state, input: input, count: 3_u32, mask: 7_u64) {
        Ok(value: read_length) => {
          set length_bits = read_length;
        }
        Err(error: length_error) => {
          return Err<unit, InflateError>(error: length_error);
        }
      }
      let length = cvt::<u64, u8>(length_bits);
      let code_room = deref(code_lengths).len;
      let ordered_ok = ordered_symbol < code_room;
      if ordered_ok {
        set deref(code_lengths)[ordered_symbol] = length;
      } else {
        let error = InflateError::InvalidHuffmanTree();
        return Err<unit, InflateError>(error: error);
      }
      set code_index = code_index +wrap 1_u64;
    }
  }
  return Ok<unit, InflateError>(value: unit);
}

fn decode_dynamic(state: &InflateState, input: &[u8], out: &[u8]) -> result: Result<unit, InflateError> reads(input), writes(state.input_offset), writes(state.output_offset), writes(state.hold), writes(state.bits), writes(out) {
  doc "The three code-length runs are inline Slots windows of this frame and the decoder reaches each through one range reference; the frame's release reclaims them, so the block needs no arena and no allocation [TYPE-9, STOR-1, REF-4].";
  let literal_count_bits = 0_u64;
  match read_bits(state: state, input: input, count: 5_u32, mask: 31_u64) {
    Ok(value: read_count) => {
      set literal_count_bits = read_count;
    }
    Err(error: count_error) => {
      return Err<unit, InflateError>(error: count_error);
    }
  }
  let literal_count = literal_count_bits +wrap 257_u64;
  let too_many_literals = literal_count > 286_u64;
  if too_many_literals {
    let error = InflateError::InvalidHuffmanTree();
    return Err<unit, InflateError>(error: error);
  }
  let distance_count_bits = 0_u64;
  match read_bits(state: state, input: input, count: 5_u32, mask: 31_u64) {
    Ok(value: read_count) => {
      set distance_count_bits = read_count;
    }
    Err(error: count_error) => {
      return Err<unit, InflateError>(error: count_error);
    }
  }
  let distance_count = distance_count_bits +wrap 1_u64;
  let code_count_bits = 0_u64;
  match read_bits(state: state, input: input, count: 4_u32, mask: 15_u64) {
    Ok(value: read_count) => {
      set code_count_bits = read_count;
    }
    Err(error: count_error) => {
      return Err<unit, InflateError>(error: count_error);
    }
  }
  let code_count = code_count_bits +wrap 4_u64;
  let code_lengths = slots_new::<u8, 19>();
  for @reserve_code_lengths (
    at in 0_u64..19_u64,
    invariant grown: code_lengths.len == at
  ) {
    place_back(window: &code_lengths, value: 0_u8);
  }
  let code_window = &code_lengths[0_u64..19_u64];
  let filled = propagate read_dynamic_code_lengths(state: state, input: input, code_lengths: code_window, code_count: code_count);
  let code_tree_allow_single = False();
  let code_tree_allow_empty = False();
  let code_table = propagate build_huffman_table(lengths: code_window, symbol_count: 19_u64, max_bits: 7_u32, allow_single: code_tree_allow_single, allow_empty: code_tree_allow_empty);
  let literal_lengths = slots_new::<u8, 286>();
  for @reserve_literal_lengths (
    at in 0_u64..286_u64,
    invariant grown: literal_lengths.len == at
  ) {
    place_back(window: &literal_lengths, value: 0_u8);
  }
  let distance_lengths = slots_new::<u8, 32>();
  for @reserve_distance_lengths (
    at in 0_u64..32_u64,
    invariant grown: distance_lengths.len == at
  ) {
    place_back(window: &distance_lengths, value: 0_u8);
  }
  let literal_window = &literal_lengths[0_u64..286_u64];
  let distance_window = &distance_lengths[0_u64..32_u64];
  let total_lengths = literal_count +wrap distance_count;
  let position = 0_u64;
  let previous_length = 0_u8;
  loop @expand_lengths {
    let lengths_done = position == total_lengths;
    if lengths_done {
      break @expand_lengths;
    } else {
      let length_symbol = 0_u64;
      match decode_table_symbol(state: state, input: input, table: &code_table) {
        Ok(value: decoded_symbol) => {
          set length_symbol = decoded_symbol;
        }
        Err(error: symbol_error) => {
          return Err<unit, InflateError>(error: symbol_error);
        }
      }
      let direct_length = length_symbol <= 15_u64;
      if direct_length {
        let length = cvt::<u64, u8>(length_symbol);
        let stored = propagate store_dynamic_length(literal_lengths: literal_window, distance_lengths: distance_window, literal_count: literal_count, position: position, value: length);
        set previous_length = length;
        set position = position +wrap 1_u64;
      } else {
        let repeat_previous = length_symbol == 16_u64;
        if repeat_previous {
          let no_previous = position == 0_u64;
          if no_previous {
            let error = InflateError::InvalidHuffmanTree();
            return Err<unit, InflateError>(error: error);
          }
          let repeat_bits = 0_u64;
          match read_bits(state: state, input: input, count: 2_u32, mask: 3_u64) {
            Ok(value: read_repeat) => {
              set repeat_bits = read_repeat;
            }
            Err(error: repeat_error) => {
              return Err<unit, InflateError>(error: repeat_error);
            }
          }
          let repeat_count = repeat_bits +wrap 3_u64;
          let remaining = total_lengths -wrap position;
          let overrun = repeat_count > remaining;
          if overrun {
            let error = InflateError::InvalidHuffmanTree();
            return Err<unit, InflateError>(error: error);
          }
          let repeated = 0_u64;
          loop @repeat_previous_length {
            let repeated_all = repeated == repeat_count;
            if repeated_all {
              break @repeat_previous_length;
            } else {
              let stored = propagate store_dynamic_length(literal_lengths: literal_window, distance_lengths: distance_window, literal_count: literal_count, position: position, value: previous_length);
              set position = position +wrap 1_u64;
              set repeated = repeated +wrap 1_u64;
            }
          }
        } else {
          let short_zero = length_symbol == 17_u64;
          let repeat_bits = 0_u64;
          let repeat_base = 0_u64;
          if short_zero {
            match read_bits(state: state, input: input, count: 3_u32, mask: 7_u64) {
              Ok(value: read_repeat) => {
                set repeat_bits = read_repeat;
              }
              Err(error: repeat_error) => {
                return Err<unit, InflateError>(error: repeat_error);
              }
            }
            set repeat_base = 3_u64;
          } else {
            let long_zero = length_symbol == 18_u64;
            if long_zero {
            } else {
              let error = InflateError::InvalidHuffmanTree();
              return Err<unit, InflateError>(error: error);
            }
            match read_bits(state: state, input: input, count: 7_u32, mask: 127_u64) {
              Ok(value: read_repeat) => {
                set repeat_bits = read_repeat;
              }
              Err(error: repeat_error) => {
                return Err<unit, InflateError>(error: repeat_error);
              }
            }
            set repeat_base = 11_u64;
          }
          let repeat_count = repeat_bits +wrap repeat_base;
          let remaining = total_lengths -wrap position;
          let overrun = repeat_count > remaining;
          if overrun {
            let error = InflateError::InvalidHuffmanTree();
            return Err<unit, InflateError>(error: error);
          }
          let repeated = 0_u64;
          loop @repeat_zero_length {
            let repeated_all = repeated == repeat_count;
            if repeated_all {
              break @repeat_zero_length;
            } else {
              let stored = propagate store_dynamic_length(literal_lengths: literal_window, distance_lengths: distance_window, literal_count: literal_count, position: position, value: 0_u8);
              set position = position +wrap 1_u64;
              set repeated = repeated +wrap 1_u64;
            }
          }
          set previous_length = 0_u8;
        }
      }
    }
  }
  let end_room = deref(literal_window).len;
  let end_ok = 256_u64 < end_room;
  let end_length = deref(literal_window)[256_u64];
  let missing_end = end_length == 0_u8;
  if missing_end {
    let error = InflateError::InvalidHuffmanTree();
    return Err<unit, InflateError>(error: error);
  }
  let literal_distance_allow_single = True();
  let literal_table = propagate build_huffman_table(lengths: literal_window, symbol_count: literal_count, max_bits: 15_u32, allow_single: literal_distance_allow_single, allow_empty: code_tree_allow_empty);
  let distance_allow_empty = True();
  let distance_table = propagate build_huffman_table(lengths: distance_window, symbol_count: distance_count, max_bits: 15_u32, allow_single: literal_distance_allow_single, allow_empty: distance_allow_empty);
  loop @dynamic_codes {
    let symbol = 0_u64;
    match decode_table_symbol(state: state, input: input, table: &literal_table) {
      Ok(value: decoded_symbol) => {
        set symbol = decoded_symbol;
      }
      Err(error: symbol_error) => {
        return Err<unit, InflateError>(error: symbol_error);
      }
    }
    let literal = symbol <= 255_u64;
    if literal {
      let byte = cvt::<u64, u8>(symbol);
      match emit_byte(state: state, out: out, value: byte) {
        Ok(value: emitted) => {
        }
        Err(error: emit_error) => {
          return Err<unit, InflateError>(error: emit_error);
        }
      }
    } else {
      let end_of_block = symbol == 256_u64;
      if end_of_block {
        break @dynamic_codes;
      } else {
        let copy_length = 0_u64;
        match decode_length(state: state, input: input, symbol: symbol) {
          Ok(value: decoded_length) => {
            set copy_length = decoded_length;
          }
          Err(error: length_error) => {
            return Err<unit, InflateError>(error: length_error);
          }
        }
        let distance_symbol = 0_u64;
        let distance_tree_empty = distance_table.used_symbols == 0_u64;
        if distance_tree_empty {
          let error = InflateError::InvalidDistance();
          return Err<unit, InflateError>(error: error);
        }
        match decode_table_symbol(state: state, input: input, table: &distance_table) {
          Ok(value: decoded_distance) => {
            set distance_symbol = decoded_distance;
          }
          Err(error: distance_error) => {
            return Err<unit, InflateError>(error: distance_error);
          }
        }
        match copy_distance(state: state, input: input, out: out, copy_length: copy_length, distance_symbol: distance_symbol) {
          Ok(value: copied) => {
          }
          Err(error: copy_error) => {
            return Err<unit, InflateError>(error: copy_error);
          }
        }
      }
    }
  }
  return Ok<unit, InflateError>(value: unit);
}
