alias DirectoryRead = std::fs::DirectoryRead;
alias HandleFactory = std::io::HandleFactory;
alias HostPaths = std::fs::HostPaths;
alias PathEncoding = std::fs::PathEncoding;
alias ReadFile = std::fs::ReadFile;

const utf8_config: Array<u8, 9> =[117_u8, 116_u8, 102_u8, 56_u8, 46_u8, 112_u8, 97_u8, 116_u8, 104_u8];

const native_config: Array<u8, 11> =[110_u8, 97_u8, 116_u8, 105_u8, 118_u8, 101_u8, 46_u8, 112_u8, 97_u8, 116_u8, 104_u8];

const invalid_config: Array<u8, 12> =[105_u8, 110_u8, 118_u8, 97_u8, 108_u8, 105_u8, 100_u8, 46_u8, 112_u8, 97_u8, 116_u8, 104_u8];

const marker: Array<u8, 6> =[109_u8, 97_u8, 114_u8, 107_u8, 101_u8, 114_u8];

const not_utf8: Array<u8, 1> =[255_u8];

fn invalid_path(error: &std::io::IoError) -> invalid: Bool reads(error) {
  match error^ {
    NotFound(code: c, origin: o) => {
      return False();
    }
    PermissionDenied(code: c, origin: o) => {
      return False();
    }
    AlreadyExists(code: c, origin: o) => {
      return False();
    }
    NotDirectory(code: c, origin: o) => {
      return False();
    }
    IsDirectory(code: c, origin: o) => {
      return False();
    }
    DirectoryNotEmpty(code: c, origin: o) => {
      return False();
    }
    ReadOnly(code: c, origin: o) => {
      return False();
    }
    ResourceBusy(code: c, origin: o) => {
      return False();
    }
    InvalidInput(code: c, origin: o) => {
      return False();
    }
    InvalidPath(code: c, origin: o) => {
      return True();
    }
    Unsupported(code: c, origin: o) => {
      return False();
    }
    TimedOut(code: c, origin: o) => {
      return False();
    }
    DeadlinePassed() => {
      return False();
    }
    Cancelled() => {
      return False();
    }
    BrokenPipe(code: c, origin: o) => {
      return False();
    }
    WriteZero(code: c, origin: o) => {
      return False();
    }
    UnexpectedEnd(code: c, origin: o) => {
      return False();
    }
    ConnectionRefused(code: c, origin: o) => {
      return False();
    }
    ConnectionReset(code: c, origin: o) => {
      return False();
    }
    ConnectionAborted(code: c, origin: o) => {
      return False();
    }
    NotConnected(code: c, origin: o) => {
      return False();
    }
    AddressInUse(code: c, origin: o) => {
      return False();
    }
    AddressUnavailable(code: c, origin: o) => {
      return False();
    }
    ResourceExhausted(code: c, origin: o) => {
      return False();
    }
    FileTooLarge(code: c, origin: o) => {
      return False();
    }
    NoSpace(code: c, origin: o) => {
      return False();
    }
    QuotaExceeded(code: c, origin: o) => {
      return False();
    }
    CrossDevice(code: c, origin: o) => {
      return False();
    }
    DeviceFailure(code: c, origin: o) => {
      return False();
    }
    Other(code: c, origin: o) => {
      return False();
    }
  }
}

fn holds_byte(factory: &HandleFactory, file: &ReadFile, expected: u8) -> result: Bool writes(factory), writes(file) waits {
  let bytes = array_filled::<u8, 2>(value: 0_u8);
  match std::fs::read_at(factory: factory, file: file, destination: &bytes[0_u64..2_u64], file_offset: 0_u64, start: 0_u64, end: 2_u64) {
    Ok(value: next) => {
      if next != 1_u64 {
        return False();
      }
    }
    Err(error: problem) => {
      return False();
    }
  }
  let same = bytes[0_u64] == expected;
  return same;
}

fn read_config(factory: &HandleFactory, root: &DirectoryRead, name: &[u8], destination: &[u8]) -> next: u64 reads(root), reads(name), writes(factory), writes(destination) waits contract {
  ensures next <= destination^.len;
} {
  match std::fs::open_file(factory: factory, root: root, name: name, start: 0_u64, end: name^.len) {
    Ok(value: file) => {
      let length = destination^.len;
      match std::fs::read_at(factory: factory, file: &file, destination: destination, file_offset: 0_u64, start: 0_u64, end: length) {
        Ok(value: read) => {
          std::fs::close_read(factory: factory, file: move file);
          return read;
        }
        Err(error: problem) => {
          std::fs::close_read(factory: factory, file: move file);
          return 0_u64;
        }
      }
    }
    Err(error: problem) => {
      return 0_u64;
    }
  }
}

fn open_utf8_file(factory: &HandleFactory, paths: &HostPaths, base: &DirectoryRead, path: &[u8]) -> result: u8 reads(paths), reads(base), reads(path), writes(factory) waits {
  let encoding = PathEncoding::Utf8();
  match std::fs::open_host_read_bytes(factory: factory, paths: paths, base: base, path: path, start: 0_u64, end: path^.len, encoding: encoding) {
    Ok(value: file) => {
      let right = holds_byte(factory: factory, file: &file, expected: 67_u8);
      std::fs::close_read(factory: factory, file: move file);
      if right {
        return 0_u8;
      }
      return 3_u8;
    }
    Err(error: problem) => {
      return 4_u8;
    }
  }
}

fn open_native_directory(factory: &HandleFactory, paths: &HostPaths, base: &DirectoryRead, path: &[u8]) -> result: u8 reads(paths), reads(base), reads(path), writes(factory) waits {
  let encoding = PathEncoding::NativeBytes();
  match std::fs::open_host_directory_read_bytes(factory: factory, paths: paths, base: base, path: path, start: 0_u64, end: path^.len, encoding: encoding) {
    Ok(value: directory) => {
      let outcome = 0_u8;
      match std::fs::open_file(factory: factory, root: &directory, name: &marker[0_u64..6_u64], start: 0_u64, end: 6_u64) {
        Ok(value: file) => {
          let right = holds_byte(factory: factory, file: &file, expected: 67_u8);
          std::fs::close_read(factory: factory, file: move file);
          if right {
          } else {
            set outcome = 7_u8;
          }
        }
        Err(error: problem) => {
          set outcome = 8_u8;
        }
      }
      std::fs::close_directory(factory: factory, directory: move directory);
      return outcome;
    }
    Err(error: problem) => {
      return 6_u8;
    }
  }
}

fn refuses(factory: &HandleFactory, paths: &HostPaths, base: &DirectoryRead, path: &[u8], encoding: PathEncoding) -> refused: Bool reads(paths), reads(base), reads(path), writes(factory) waits {
  match std::fs::open_host_read_bytes(factory: factory, paths: paths, base: base, path: path, start: 0_u64, end: path^.len, encoding: encoding) {
    Ok(value: file) => {
      std::fs::close_read(factory: factory, file: move file);
      return False();
    }
    Err(error: problem) => {
      let matched = invalid_path(error: &problem);
      return matched;
    }
  }
}

fn refuse_both(factory: &HandleFactory, paths: &HostPaths, base: &DirectoryRead, path: &[u8]) -> result: u8 reads(paths), reads(base), reads(path), writes(factory) waits {
  let native = PathEncoding::NativeBytes();
  let native_refused = refuses(factory: factory, paths: paths, base: base, path: path, encoding: native);
  if native_refused {
  } else {
    return 10_u8;
  }
  let text = PathEncoding::Utf8();
  let text_refused = refuses(factory: factory, paths: paths, base: base, path: &not_utf8[0_u64..1_u64], encoding: text);
  if text_refused {
  } else {
    return 11_u8;
  }
  return 0_u8;
}

fn open_both(factory: &HandleFactory, paths: &HostPaths, base: &DirectoryRead, file_path: &[u8], directory_path: &[u8]) -> result: u8 reads(paths), reads(base), reads(file_path), reads(directory_path), writes(factory) waits {
  let opened = open_utf8_file(factory: factory, paths: paths, base: base, path: file_path);
  if opened != 0_u8 {
    return opened;
  }
  let listed = open_native_directory(factory: factory, paths: paths, base: base, path: directory_path);
  return listed;
}

fn exercise(factory: &HandleFactory, paths: &HostPaths, base: &DirectoryRead) -> result: u8 reads(paths), reads(base), writes(factory) waits {
  let first = array_filled::<u8, 1024>(value: 0_u8);
  let first_end = read_config(factory: factory, root: base, name: &utf8_config[0_u64..9_u64], destination: &first[0_u64..1024_u64]);
  let second = array_filled::<u8, 1024>(value: 0_u8);
  let second_end = read_config(factory: factory, root: base, name: &native_config[0_u64..11_u64], destination: &second[0_u64..1024_u64]);
  let third = array_filled::<u8, 1024>(value: 0_u8);
  let third_end = read_config(factory: factory, root: base, name: &invalid_config[0_u64..12_u64], destination: &third[0_u64..1024_u64]);
  if first_end == 0_u64 {
    return 40_u8;
  }
  if second_end == 0_u64 {
    return 41_u8;
  }
  if third_end == 0_u64 {
    return 42_u8;
  }
  if first_end > 0_u64 {
    if first_end <= 1024_u64 {
      if second_end > 0_u64 {
        if second_end <= 1024_u64 {
          if third_end > 0_u64 {
            if third_end <= 1024_u64 {
              let opened = open_both(factory: factory, paths: paths, base: base, file_path: &first[0_u64..first_end], directory_path: &second[0_u64..second_end]);
              if opened != 0_u8 {
                return opened;
              }
              return refuse_both(factory: factory, paths: paths, base: base, path: &third[0_u64..third_end]);
            }
          }
        }
      }
    }
  }
  return 2_u8;
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  doc "Opens the paths three files in its working directory hold: utf8.path names a file holding C through a UTF-8 window, native.path names a directory through a native window, below which marker holds C, and invalid.path holds a native window the host refuses. A window that is not UTF-8 is refused too. A missing file exits 2, a refused open 4 or 6, other bytes 3, 7 or 8, an accepted invalid native window 10, an accepted invalid UTF-8 window 11, and an invocation without the authority 9.";
  let std::process::Inputs(cwd: directory, handles: factory, host_paths: host_paths, ..) = move inputs;
  let std::fs::Directory(read: reader, write: writer) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move writer);
  let outcome = 9_u8;
  match move host_paths {
    Some(value: paths) => {
      set outcome = exercise(factory: &factory, paths: &paths, base: &reader);
    }
    None() => {
    }
  }
  std::fs::close_directory(factory: &factory, directory: move reader);
  return std::process::exit_status(code: outcome);
}
