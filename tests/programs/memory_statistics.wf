alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias MemoryMeter = std::process::MemoryMeter;
alias exit_status = std::process::exit_status;

fn measure_box(meter: &MemoryMeter) -> result: u64 writes(meter) {
  let cell = box_new::<u64>(value: 73_u64);
  let held = std::process::heap_in_use(meter: meter);
  if cell.inner == 73_u64 {
    return held;
  } else {
    return 0_u64;
  }
}

fn measure_grow(meter: &MemoryMeter) -> result: u64 writes(meter) {
  let before = std::process::heap_in_use(meter: meter);
  let cell = box_slots_new::<u64>(capacity: 3_u64);
  place_back(window: &cell.inner, value: 73_u64);
  let initial = std::process::heap_in_use(meter: meter);
  if initial >= before {
    let bytes = initial - before;
    if bytes != 40_u64 {
      return 1_u64;
    }
  } else {
    return 1_u64;
  }
  grow(cell: &cell, capacity: 9_u64);
  let grown = std::process::heap_in_use(meter: meter);
  if grown >= before {
    let bytes = grown - before;
    if bytes != 88_u64 {
      return 1_u64;
    }
  } else {
    return 1_u64;
  }
  grow(cell: &cell, capacity: 17_u64);
  let regrown = std::process::heap_in_use(meter: meter);
  if regrown >= before {
    let bytes = regrown - before;
    if bytes != 152_u64 {
      return 1_u64;
    }
  } else {
    return 1_u64;
  }
  if cell.inner.len == 1_u64 {
    let held = take_back(window: &cell.inner);
    if held != 73_u64 {
      return 1_u64;
    }
    return 0_u64;
  } else {
    return 1_u64;
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: directory, handles: factory, memory_meter: meter, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let before = std::process::heap_in_use(meter: &meter);
  let during = measure_box(meter: &meter);
  let after = std::process::heap_in_use(meter: &meter);
  if during >= before {
    let growth = during - before;
    if growth < 8_u64 {
      return exit_status(code: 1_u8);
    }
  } else {
    return exit_status(code: 2_u8);
  }
  if after != before {
    return exit_status(code: 3_u8);
  }
  let growth = measure_grow(meter: &meter);
  if growth != 0_u64 {
    return exit_status(code: 6_u8);
  }
  let after_grow = std::process::heap_in_use(meter: &meter);
  if after_grow != before {
    return exit_status(code: 7_u8);
  }
  let shared_meter = std::process::meter_share(meter: &meter);
  let same = std::process::heap_in_use(meter: &shared_meter);
  if same != after {
    return exit_status(code: 4_u8);
  }
  let resident = std::process::resident_bytes(meter: &meter);
  match resident {
    Some(value: bytes) => {
      if bytes == 0_u64 {
        return exit_status(code: 5_u8);
      }
    }
    None() => {
      return exit_status(code: 0_u8);
    }
  }
  return exit_status(code: 0_u8);
}
