alias Args = std::text::Args;
alias DirectoryRead = std::fs::DirectoryRead;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;
alias ReadFile = std::fs::ReadFile;
alias arg_get = std::text::arg_get;
alias close_directory = std::fs::close_directory;
alias close_read = std::fs::close_read;
alias exit_status = std::process::exit_status;
alias host_bytes_len = std::text::host_bytes_len;
alias host_copy_bytes = std::text::host_copy_bytes;
alias open_file = std::fs::open_file;
alias read_at = std::fs::read_at;
alias write_once = std::io::write_once;

fn factory_refusal(error: &IoError) -> result: Bool reads(error) {
  match deref(error) {
    NotFound(code: native_code, origin: native_origin) => {
      return False();
    }
    PermissionDenied(code: native_code, origin: native_origin) => {
      return False();
    }
    AlreadyExists(code: native_code, origin: native_origin) => {
      return False();
    }
    NotDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    IsDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    DirectoryNotEmpty(code: native_code, origin: native_origin) => {
      return False();
    }
    ReadOnly(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceBusy(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidInput(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidPath(code: native_code, origin: native_origin) => {
      return False();
    }
    Unsupported(code: native_code, origin: native_origin) => {
      return False();
    }
    TimedOut(code: native_code, origin: native_origin) => {
      return False();
    }
    BrokenPipe(code: native_code, origin: native_origin) => {
      return False();
    }
    WriteZero(code: native_code, origin: native_origin) => {
      return False();
    }
    UnexpectedEnd(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionRefused(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionReset(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionAborted(code: native_code, origin: native_origin) => {
      return False();
    }
    NotConnected(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressInUse(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressUnavailable(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceExhausted(code: native_code, origin: native_origin) => {
      return deref(native_origin) == 0_u8;
    }
    FileTooLarge(code: native_code, origin: native_origin) => {
      return False();
    }
    NoSpace(code: native_code, origin: native_origin) => {
      return False();
    }
    QuotaExceeded(code: native_code, origin: native_origin) => {
      return False();
    }
    CrossDevice(code: native_code, origin: native_origin) => {
      return False();
    }
    DeviceFailure(code: native_code, origin: native_origin) => {
      return False();
    }
    Other(code: native_code, origin: native_origin) => {
      return False();
    }
  }
}

fn discard_open_result(factory: &HandleFactory, outcome: Result<ReadFile, IoError>) -> result: unit writes(factory) {
  doc "Consumes an open result the program will not use, closing the handle it may carry.";
  match move outcome {
    Ok(value: file) => {
      close_read(factory: factory, file: move file);
    }
    Err(error: problem) => {
    }
  }
  return unit;
}

fn exercise(args: &Args, cwd: &DirectoryRead, out: &OutputStream, files: &HandleFactory) -> status: ExitStatus reads(args), reads(cwd), writes(out), writes(files) {
  doc "Copies two target-native argument names into frame-resident byte runs, opens them without following terminal links, and publishes their first bytes.";
  let name_a = array_filled::<u8, 8>(value: 125_u8);
  let name_b = array_filled::<u8, 8>(value: 125_u8);
  let data_a = array_filled::<u8, 1>(value: 0_u8);
  let data_b = array_filled::<u8, 1>(value: 0_u8);
  let pair = array_filled::<u8, 2>(value: 0_u8);
  match arg_get(args: args, position: 1_u64) {
    Ok(value: text_a) => {
      let native_length_a = host_bytes_len(value: &text_a);
      if native_length_a == 2_u64 {
      } else {
        return exit_status(code: 20_u8);
      }
      let name_window_a = &name_a[0_u64..8_u64];
      match host_copy_bytes(value: &text_a, destination: name_window_a, start: 0_u64, end: 2_u64) {
        Ok(value: name_end_a) => {
          if name_end_a == 2_u64 {
          } else {
            return exit_status(code: 21_u8);
          }
          let first_a = deref(name_window_a)[0_u64];
          if first_a == 65_u8 {
          } else {
            return exit_status(code: 22_u8);
          }
          let second_a = deref(name_window_a)[1_u64];
          if second_a == 66_u8 {
          } else {
            return exit_status(code: 23_u8);
          }
          let after_a = deref(name_window_a)[2_u64];
          if after_a == 125_u8 {
          } else {
            return exit_status(code: 24_u8);
          }
          match arg_get(args: args, position: 2_u64) {
            Ok(value: text_b) => {
              let native_length_b = host_bytes_len(value: &text_b);
              if native_length_b == 2_u64 {
              } else {
                return exit_status(code: 20_u8);
              }
              let name_window_b = &name_b[0_u64..8_u64];
              match host_copy_bytes(value: &text_b, destination: name_window_b, start: 0_u64, end: 2_u64) {
                Ok(value: name_end_b) => {
                  if name_end_b == 2_u64 {
                  } else {
                    return exit_status(code: 21_u8);
                  }
                  let first_b = deref(name_window_b)[0_u64];
                  if first_b == 66_u8 {
                  } else {
                    return exit_status(code: 22_u8);
                  }
                  let second_b = deref(name_window_b)[1_u64];
                  if second_b == 66_u8 {
                  } else {
                    return exit_status(code: 23_u8);
                  }
                  let after_b = deref(name_window_b)[2_u64];
                  if after_b == 125_u8 {
                  } else {
                    return exit_status(code: 24_u8);
                  }
                  let opened_a = open_file(factory: files, root: cwd, name: name_window_a, start: 0_u64, end: name_end_a);
                  let opened_b = open_file(factory: files, root: cwd, name: name_window_b, start: 0_u64, end: name_end_b);
                  match move opened_a {
                    Ok(value: file_a) => {
                      match move opened_b {
                        Ok(value: file_b) => {
                          let data_window_a = &data_a[0_u64..1_u64];
                          let read_a = read_at(factory: files, file: &file_a, destination: data_window_a, file_offset: 0_u64, start: 0_u64, end: 1_u64);
                          let data_window_b = &data_b[0_u64..1_u64];
                          let read_b = read_at(factory: files, file: &file_b, destination: data_window_b, file_offset: 0_u64, start: 0_u64, end: 1_u64);
                          match read_a {
                            Ok(value: reached_a) => {
                              if reached_a == 1_u64 {
                              } else {
                                close_read(factory: files, file: move file_b);
                                close_read(factory: files, file: move file_a);
                                return exit_status(code: 9_u8);
                              }
                            }
                            Err(error: read_stop_a) => {
                              match read_stop_a {
                                ReadEnd() => {
                                  close_read(factory: files, file: move file_b);
                                  close_read(factory: files, file: move file_a);
                                  return exit_status(code: 10_u8);
                                }
                                ReadFailed(error: problem_a) => {
                                  close_read(factory: files, file: move file_b);
                                  close_read(factory: files, file: move file_a);
                                  return exit_status(code: 11_u8);
                                }
                              }
                            }
                          }
                          match read_b {
                            Ok(value: reached_b) => {
                              if reached_b == 1_u64 {
                              } else {
                                close_read(factory: files, file: move file_b);
                                close_read(factory: files, file: move file_a);
                                return exit_status(code: 12_u8);
                              }
                            }
                            Err(error: read_stop_b) => {
                              match read_stop_b {
                                ReadEnd() => {
                                  close_read(factory: files, file: move file_b);
                                  close_read(factory: files, file: move file_a);
                                  return exit_status(code: 13_u8);
                                }
                                ReadFailed(error: problem_b) => {
                                  close_read(factory: files, file: move file_b);
                                  close_read(factory: files, file: move file_a);
                                  return exit_status(code: 14_u8);
                                }
                              }
                            }
                          }
                          set pair[0_u64] = data_a[0_u64];
                          set pair[1_u64] = data_b[0_u64];
                          let published_window = &pair[0_u64..2_u64];
                          match write_once(factory: files, output: out, source: published_window, start: 0_u64, end: 2_u64) {
                            Ok(value: published) => {
                              if published == 2_u64 {
                                close_read(factory: files, file: move file_b);
                                close_read(factory: files, file: move file_a);
                                return exit_status(code: 0_u8);
                              }
                              close_read(factory: files, file: move file_b);
                              close_read(factory: files, file: move file_a);
                              return exit_status(code: 15_u8);
                            }
                            Err(error: output_problem) => {
                              close_read(factory: files, file: move file_b);
                              close_read(factory: files, file: move file_a);
                              return exit_status(code: 16_u8);
                            }
                          }
                        }
                        Err(error: problem_b) => {
                          let failure_status = if factory_refusal(error: &problem_b) {
                            give 18_u8;
                          } else {
                            give 8_u8;
                          }
                          close_read(factory: files, file: move file_a);
                          return exit_status(code: failure_status);
                        }
                      }
                    }
                    Err(error: problem_a) => {
                      let failure_status = if factory_refusal(error: &problem_a) {
                        give 17_u8;
                      } else {
                        give 7_u8;
                      }
                      discard_open_result(factory: files, outcome: move opened_b);
                      return exit_status(code: failure_status);
                    }
                  }
                }
                Err(error: too_small_b) => {
                  return exit_status(code: 6_u8);
                }
              }
            }
            Err(error: absent_b) => {
              return exit_status(code: 5_u8);
            }
          }
        }
        Err(error: too_small_a) => {
          return exit_status(code: 4_u8);
        }
      }
    }
    Err(error: absent_a) => {
      return exit_status(code: 3_u8);
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "PRE-1 ordinary Inputs are destructured once; the referenced operation chain returns before the initial directory is explicitly closed on every exit.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: unused_stderr, handles: files, stdin: unused_stdin) = move inputs;
  let outcome = exercise(args: &args, cwd: &cwd, out: &out, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return move outcome;
}
