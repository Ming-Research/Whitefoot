alias AcceptedConnection = std::net::AcceptedConnection;
alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias IoError = std::io::IoError;
alias TcpConnection = std::net::TcpConnection;
alias TcpSend = std::net::TcpSend;
alias arg_get = std::text::arg_get;
alias args_count = std::text::args_count;
alias close_directory = std::fs::close_directory;
alias close_listener = std::net::close_listener;
alias close_receive = std::net::close_receive;
alias close_send = std::net::close_send;
alias exit_status = std::process::exit_status;
alias host_copy_utf8 = std::text::host_copy_utf8;
alias receive_next = std::net::receive_next;
alias send_once = std::net::send_once;
alias socket_address_v4 = std::net::socket_address_v4;
alias tcp_accept = std::net::tcp_accept;
alias tcp_listen = std::net::tcp_listen;

fn factory_refusal(error: &IoError) -> result: Bool reads(error) {
  match deref(error) {
    NotFound(code: native_code, origin: native_origin) => {
      return False();
    }
    PermissionDenied(code: native_code, origin: native_origin) => {
      return False();
    }
    AlreadyExists(code: native_code, origin: native_origin) => {
      return False();
    }
    NotDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    IsDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    DirectoryNotEmpty(code: native_code, origin: native_origin) => {
      return False();
    }
    ReadOnly(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceBusy(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidInput(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidPath(code: native_code, origin: native_origin) => {
      return False();
    }
    Unsupported(code: native_code, origin: native_origin) => {
      return False();
    }
    TimedOut(code: native_code, origin: native_origin) => {
      return False();
    }
    BrokenPipe(code: native_code, origin: native_origin) => {
      return False();
    }
    WriteZero(code: native_code, origin: native_origin) => {
      return False();
    }
    UnexpectedEnd(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionRefused(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionReset(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionAborted(code: native_code, origin: native_origin) => {
      return False();
    }
    NotConnected(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressInUse(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressUnavailable(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceExhausted(code: native_code, origin: native_origin) => {
      return deref(native_origin) == 0_u8;
    }
    FileTooLarge(code: native_code, origin: native_origin) => {
      return False();
    }
    NoSpace(code: native_code, origin: native_origin) => {
      return False();
    }
    QuotaExceeded(code: native_code, origin: native_origin) => {
      return False();
    }
    CrossDevice(code: native_code, origin: native_origin) => {
      return False();
    }
    DeviceFailure(code: native_code, origin: native_origin) => {
      return False();
    }
    Other(code: native_code, origin: native_origin) => {
      return False();
    }
  }
}

fn socket_class(error: IoError) -> result: u8 pure {
  doc "Matches an ordinary IoError value to the distinctions a loopback program reports [PRE-1, ERR-2].";
  match error {
    NotFound(code: c, origin: o) => {
      return 9_u8;
    }
    PermissionDenied(code: c, origin: o) => {
      return 9_u8;
    }
    AlreadyExists(code: c, origin: o) => {
      return 9_u8;
    }
    NotDirectory(code: c, origin: o) => {
      return 9_u8;
    }
    IsDirectory(code: c, origin: o) => {
      return 9_u8;
    }
    DirectoryNotEmpty(code: c, origin: o) => {
      return 9_u8;
    }
    ReadOnly(code: c, origin: o) => {
      return 9_u8;
    }
    ResourceBusy(code: c, origin: o) => {
      return 9_u8;
    }
    InvalidInput(code: c, origin: o) => {
      return 9_u8;
    }
    InvalidPath(code: c, origin: o) => {
      return 9_u8;
    }
    Unsupported(code: c, origin: o) => {
      return 9_u8;
    }
    TimedOut(code: c, origin: o) => {
      return 9_u8;
    }
    BrokenPipe(code: c, origin: o) => {
      return 4_u8;
    }
    WriteZero(code: c, origin: o) => {
      return 9_u8;
    }
    UnexpectedEnd(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionRefused(code: c, origin: o) => {
      return 1_u8;
    }
    ConnectionReset(code: c, origin: o) => {
      return 2_u8;
    }
    ConnectionAborted(code: c, origin: o) => {
      return 3_u8;
    }
    NotConnected(code: c, origin: o) => {
      return 5_u8;
    }
    AddressInUse(code: c, origin: o) => {
      return 6_u8;
    }
    AddressUnavailable(code: c, origin: o) => {
      return 7_u8;
    }
    ResourceExhausted(code: c, origin: o) => {
      return 9_u8;
    }
    FileTooLarge(code: c, origin: o) => {
      return 9_u8;
    }
    NoSpace(code: c, origin: o) => {
      return 9_u8;
    }
    QuotaExceeded(code: c, origin: o) => {
      return 9_u8;
    }
    CrossDevice(code: c, origin: o) => {
      return 9_u8;
    }
    DeviceFailure(code: c, origin: o) => {
      return 9_u8;
    }
    Other(code: c, origin: o) => {
      return 9_u8;
    }
  }
}

fn byte_at(store: &[u8], index: u64) -> result: u8 reads(store) {
  doc "Reads one stored byte, delivering zero for a position the range reference does not hold.";
  let room = deref(store).len;
  let inside = index < room;
  if inside {
    let value = deref(store)[index];
    return value;
  }
  return 0_u8;
}

fn parse_port(digits: &[u8], length: u64) -> result: u16 reads(digits) {
  doc "Reads one decimal port out of the argument bytes the invocation supplied; a byte that is not a digit ends the number.";
  let port = 0_u16;
  let ended = 0_u8;
  let index = 0_u64;
  loop @scan {
    let more = index < length;
    if more {
    } else {
      break @scan;
    }
    let byte = byte_at(store: digits, index: index);
    let low = byte >= 48_u8;
    let high = byte <= 57_u8;
    let digit = band(low, high);
    if digit {
      let value = byte -wrap 48_u8;
      let widened = cvt::<u8, u16>(value);
      let scaled = port *wrap 10_u16;
      set port = scaled +wrap widened;
    } else {
      set ended = 1_u8;
    }
    if ended == 0_u8 {
      set index = index +wrap 1_u64;
    } else {
      break @scan;
    }
  }
  return port;
}

fn send_all(send: &TcpSend, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(send) contract {
  define source_length = deref(source).len;
  requires length <= source_length;
} {
  doc "Sends one prefix of the source range, reattempting until the connection has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @sending {
    let pending = sent < length;
    if pending {
    } else {
      break @sending;
    }
    match send_once(send: send, source: source, start: sent, end: length) {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "Listens on the loopback port named by the invocation, takes one connection, and returns every byte the peer sends until the peer stops sending through ordinary prelude calls [PRE-1]. The prelude declares no operation reporting a listener's own local address, so the port is the caller's choice and arrives as an argument. The argument scratch and the echo chunk are two inline Slots windows of this frame, each reached through one range reference [TYPE-9, REF-4].";
  let Inputs(args: args, cwd: unused_cwd, stdout: unused_stdout, stderr: unused_stderr, handles: handles, stdin: unused_stdin) = move inputs;
  close_directory(factory: &handles, directory: move unused_cwd);
  let digits = slots_new::<u8, 16>();
  for @fill_digits (
    at in 0_u64..16_u64,
    invariant grown_digits: digits.len == at
  ) {
    place_back(window: &digits, value: 0_u8);
  }
  let chunk = slots_new::<u8, 4096>();
  for @fill_chunk (
    at in 0_u64..4096_u64,
    invariant grown_chunk: chunk.len == at
  ) {
    place_back(window: &chunk, value: 0_u8);
  }
  let room = 16_u64;
  let held = 4096_u64;
  let window = &digits[0_u64..16_u64];
  let sink = &chunk[0_u64..4096_u64];
  let port = 0_u16;
  let arguments = args_count(args: &args);
  let named = arguments >= 2_u64;
  if named {
  } else {
    return exit_status(code: 1_u8);
  }
  let carried = 0_u64;
  match arg_get(args: &args, position: 1_u64) {
    Ok(value: text) => {
      match host_copy_utf8(value: &text, destination: window, start: 0_u64, end: room) {
        Ok(value: written) => {
          set carried = written;
        }
        Err(error: problem) => {
          set carried = 0_u64;
        }
      }
    }
    Err(error: problem) => {
      set carried = 0_u64;
    }
  }
  if carried == 0_u64 {
    return exit_status(code: 2_u8);
  }
  set port = parse_port(digits: window, length: carried);
  let address = socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: port);
  let outcome = 0_u8;
  match tcp_listen(factory: &handles, address: &address) {
    Ok(value: bound) => {
      match tcp_accept(factory: &handles, listener: &bound) {
        Ok(value: accepted_link) => {
          let AcceptedConnection(connection: link, peer: from) = move accepted_link;
          loop @chunks {
            let available = 0_u64;
            let ended = 0_u8;
            match receive_next(receive: &link.receive, destination: sink, start: 0_u64, end: held) {
              Ok(value: endpoint) => {
                set available = endpoint;
              }
              Err(error: read_stop_1) => {
                match read_stop_1 {
                  ReadEnd() => {
                    set ended = 1_u8;
                  }
                  ReadFailed(error: problem) => {
                    let reported = socket_class(error: problem);
                    set outcome = 20_u8 +wrap reported;
                    set ended = 2_u8;
                  }
                }
              }
            }
            if ended == 0_u8 {
              match send_all(send: &link.send, source: sink, length: available) {
                Ok(value: delivered) => {
                }
                Err(error: problem) => {
                  let reported = socket_class(error: problem);
                  set outcome = 30_u8 +wrap reported;
                  set ended = 2_u8;
                }
              }
            }
            if ended == 0_u8 {
            } else {
              break @chunks;
            }
          }
          let TcpConnection(receive: close_receive_2, send: close_send_2) = move link;
          close_receive(factory: &handles, receive: move close_receive_2);
          close_send(factory: &handles, send: move close_send_2);
        }
        Err(error: problem) => {
          if factory_refusal(error: &problem) {
            set outcome = 8_u8;
          } else {
            set outcome = 7_u8;
          }
        }
      }
      let listener_credit = close_listener(factory: &handles, listener: move bound);
    }
    Err(error: problem) => {
      if factory_refusal(error: &problem) {
        set outcome = 10_u8;
      } else {
        set outcome = 9_u8;
      }
    }
  }
  return exit_status(code: outcome);
}
