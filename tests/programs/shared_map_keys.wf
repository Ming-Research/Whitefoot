alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const names: Array<u8, 8> =[97_u8, 98_u8, 99_u8, 100_u8, 101_u8, 102_u8, 103_u8, 104_u8];

fn bump(map: &SharedMap<u64>, total: &Shared<u64>, key: &[u8]) -> result: unit reads(map), reads(total), reads(key) waits {
  for @round (index in 0_u64..5000_u64) {
    atomic state = &map^ {
      atomic slot = &state^[key] {
        match slot^ {
          Some(value: seen) => {
            let next = seen^ +wrap 1_u64;
            set slot^ = Some<u64>(value: next);
          }
          None() => {
            set slot^ = Some<u64>(value: 1_u64);
          }
        }
      }
      atomic sum = &total^ {
        set sum^ = sum^ +wrap 1_u64;
      }
    }
  }
  return unit;
}

fn watch(map: &SharedMap<u64>, total: &Shared<u64>, mismatches: &Shared<u64>, key: &[u8]) -> result: unit reads(map), reads(total), reads(mismatches), reads(key) waits {
  for @look (index in 0_u64..5000_u64) {
    let sum = 0_u64;
    let counted = 0_u64;
    atomic state = &map^ {
      for @each (at in 0_u64..key^.len) {
        atomic slot = &state^[&key^[0_u64..at]] {
          match slot^ {
            Some(value: seen) => {
              set sum = sum +wrap seen^;
            }
            None() => {
            }
          }
        }
      }
      atomic seen = &total^ {
        set counted = seen^;
      }
    }
    if sum != counted {
      atomic wrong = &mismatches^ {
        set wrong^ = wrong^ +wrap 1_u64;
      }
    }
  }
  return unit;
}

fn worker_1(map: SharedMap<u64>, total: Shared<u64>) -> result: unit pure waits {
  bump(map: &map, total: &total, key: &names[0_u64..1_u64]);
  return unit;
}

fn worker_2(map: SharedMap<u64>, total: Shared<u64>) -> result: unit pure waits {
  bump(map: &map, total: &total, key: &names[0_u64..2_u64]);
  return unit;
}

fn worker_3(map: SharedMap<u64>, total: Shared<u64>) -> result: unit pure waits {
  bump(map: &map, total: &total, key: &names[0_u64..3_u64]);
  return unit;
}

fn watcher(map: SharedMap<u64>, total: Shared<u64>, mismatches: Shared<u64>) -> result: unit pure waits {
  watch(map: &map, total: &total, mismatches: &mismatches, key: &names[0_u64..5_u64]);
  return unit;
}

fn run(map: &SharedMap<u64>, total: &Shared<u64>, mismatches: &Shared<u64>) -> result: unit reads(map), reads(total), reads(mismatches) waits {
  let handle_1 = shared_map_share::<u64>(shared: map);
  let summed_1 = shared_share::<u64>(shared: total);
  spawn worker_1(map: move handle_1, total: move summed_1);
  let handle_2 = shared_map_share::<u64>(shared: map);
  let summed_2 = shared_share::<u64>(shared: total);
  spawn worker_2(map: move handle_2, total: move summed_2);
  let handle_3 = shared_map_share::<u64>(shared: map);
  let summed_3 = shared_share::<u64>(shared: total);
  spawn worker_3(map: move handle_3, total: move summed_3);
  for @watch (index in 0_u64..2_u64) {
    let handle = shared_map_share::<u64>(shared: map);
    let summed = shared_share::<u64>(shared: total);
    let seen = shared_share::<u64>(shared: mismatches);
    spawn watcher(map: move handle, total: move summed, mismatches: move seen);
  }
  return unit;
}

fn main() -> status: ExitStatus pure waits {
  let map = shared_map_new::<u64>(capacity: 0_u64);
  let total = shared_new::<u64>(value: 0_u64);
  let mismatches = shared_new::<u64>(value: 0_u64);
  run(map: &map, total: &total, mismatches: &mismatches);
  let missed = 0_u64;
  atomic noted = &mismatches {
    set missed = noted^;
  }
  if missed != 0_u64 {
    return exit_status(code: 5_u8);
  }
  let sum = 0_u64;
  atomic seen = &total {
    set sum = seen^;
  }
  if sum != 15000_u64 {
    return exit_status(code: 4_u8);
  }
  return exit_status(code: 0_u8);
}
