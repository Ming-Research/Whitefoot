alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn mandelbrot_escapes(cx: f64, cy: f64) -> result: Bool pure {
  let real = 0.0_f64;
  let imaginary = 0.0_f64;
  let iteration = 0_u32;
  let escaped = False();
  loop @orbit {
    let exhausted = iteration == 64_u32;
    if exhausted {
      break @orbit;
    }
    let real_squared = fmul.strict(real, real);
    let imaginary_squared = fmul.strict(imaginary, imaginary);
    let difference = fsub.strict(real_squared, imaginary_squared);
    let next_real = fadd.strict(difference, cx);
    let product = fmul.strict(real, imaginary);
    let doubled_product = fmul.strict(2.0_f64, product);
    let next_imaginary = fadd.strict(doubled_product, cy);
    set real = next_real;
    set imaginary = next_imaginary;
    let next_real_squared = fmul.strict(real, real);
    let next_imaginary_squared = fmul.strict(imaginary, imaginary);
    let magnitude_squared = fadd.strict(next_real_squared, next_imaginary_squared);
    let outside = fgt(magnitude_squared, 4.0_f64);
    if outside {
      set escaped = True();
      break @orbit;
    }
    set iteration = iteration +wrap 1_u32;
  }
  return escaped;
}

fn main() -> status: ExitStatus pure {
  let y = 0_u32;
  let escaped_points = 0_u32;
  loop @rows {
    let rows_done = y == 48_u32;
    if rows_done {
      break @rows;
    }
    let x = 0_u32;
    loop @columns {
      let columns_done = x == 64_u32;
      if columns_done {
        break @columns;
      }
      let x_float = cvt::<u32, f64>(x);
      let y_float = cvt::<u32, f64>(y);
      let scaled_x = fmul.strict(x_float, 0.05_f64);
      let scaled_y = fmul.strict(y_float, 0.05_f64);
      let cx = fsub.strict(scaled_x, 2.0_f64);
      let cy = fsub.strict(scaled_y, 1.2_f64);
      let escaped = mandelbrot_escapes(cx: cx, cy: cy);
      if escaped {
        set escaped_points = escaped_points +wrap 1_u32;
      }
      set x = x +wrap 1_u32;
    }
    set y = y +wrap 1_u32;
  }
  if escaped_points == 2437_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
