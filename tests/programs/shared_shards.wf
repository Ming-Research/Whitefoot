struct Counts {
  a: u64;
  b: u64;
}

fn empty_counts() -> made: Counts pure {
  return Counts(a: 0_u64, b: 0_u64);
}

fn count_many(stats: Shared<Shards<Counts>>) -> result: unit pure waits {
  let mine = any_shard();
  for @round (index in 0_u64..20000_u64) {
    atomic part = &stats[mine] {
      set part^.a = part^.a +wrap 1_u64;
      set part^.b = part^.b +wrap 1_u64;
    }
  }
  return unit;
}

fn watch_counts(stats: Shared<Shards<Counts>>, mismatches: Shared<u64>) -> result: unit pure waits {
  for @look (index in 0_u64..10000_u64) {
    let sum_a = 0_u64;
    let sum_b = 0_u64;
    atomic all = &stats {
      for @first (at in 0_u64..all^.len) {
        set sum_a = sum_a +wrap all^[at].a;
      }
      for @second (at in 0_u64..all^.len) {
        set sum_b = sum_b +wrap all^[at].b;
      }
    }
    if sum_a != sum_b {
      atomic wrong = &mismatches {
        set wrong^ = wrong^ +wrap 1_u64;
      }
    }
  }
  return unit;
}

fn count_together(stats: &Shared<Shards<Counts>>, mismatches: &Shared<u64>) -> result: unit reads(stats), reads(mismatches) waits {
  for @first (index in 0_u64..8_u64) {
    let handle = shared_share::<Shards<Counts>>(shared: stats);
    spawn count_many(stats: move handle);
  }
  let watched = shared_share::<Shards<Counts>>(shared: stats);
  let seen = shared_share::<u64>(shared: mismatches);
  spawn watch_counts(stats: move watched, mismatches: move seen);
  for @second (index in 0_u64..8_u64) {
    let handle = shared_share::<Shards<Counts>>(shared: stats);
    spawn count_many(stats: move handle);
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let stats = shared_shards_new::<Counts, fn empty_counts>();
  let mismatches = shared_new::<u64>(value: 0_u64);
  count_together(stats: &stats, mismatches: &mismatches);
  let missed = 0_u64;
  atomic wrong = &mismatches {
    set missed = wrong^;
  }
  if missed != 0_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  let sum_a = 0_u64;
  let sum_b = 0_u64;
  atomic all = &stats {
    for @shard (at in 0_u64..all^.len) {
      set sum_a = sum_a +wrap all^[at].a;
      set sum_b = sum_b +wrap all^[at].b;
    }
  }
  if sum_a != 320000_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  if sum_b != 320000_u64 {
    return std::process::exit_status(code: 3_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
