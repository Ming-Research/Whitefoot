alias Clock = std::time::Clock;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias Instant = std::time::Instant;
alias OutputStream = std::io::OutputStream;
alias ProcessExit = std::process::ProcessExit;

fn wait_forever(cell: Shared<u64>) -> result: unit pure waits {
  doc "Waits for a value that no context ever writes.";
  atomic value = &cell when value^ != 0_u64 {
  }
  return unit;
}

fn sleep_an_hour(clock: Clock) -> result: unit pure waits {
  doc "Keeps a host operation outstanding for an hour.";
  let never = std::time::cancel_never();
  let start = std::time::now(clock: &clock);
  let wake = std::time::instant_after(instant: start, nanoseconds: 3600000000000_u64);
  std::time::sleep_until(deadline: wake, cancel: &never);
  std::time::close_cancel_watch(watch: move never);
  return unit;
}

fn write_ending(factory: &HandleFactory, output: &OutputStream) -> result: unit writes(factory), writes(output) waits {
  doc "Writes the line that marks the point where the exit is called.";
  let bytes = array_filled::<u8, 7>(value: 10_u8);
  set bytes[0_u64] = 101_u8;
  set bytes[1_u64] = 110_u8;
  set bytes[2_u64] = 100_u8;
  set bytes[3_u64] = 105_u8;
  set bytes[4_u64] = 110_u8;
  set bytes[5_u64] = 103_u8;
  let unlimited = None<Instant>();
  let never = std::time::cancel_never();
  std::io::write_once(factory: factory, output: output, source: &bytes[0_u64..7_u64], start: 0_u64, end: 7_u64, deadline: unlimited, cancel: &never);
  std::time::close_cancel_watch(watch: move never);
  return unit;
}

fn end_now(exit: ProcessExit, factory: HandleFactory, output: OutputStream, leave: Bool) -> result: unit pure waits {
  doc "Writes the line, then ends the program with status 1 when leave holds.";
  write_ending(factory: &factory, output: &output);
  if leave {
    let failed = std::process::exit_status(code: 1_u8);
    std::process::exit_now(exit: &exit, status: move failed);
  }
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Starts the three contexts; given an argument, the program does not end by itself.";
  let Inputs(args: args, cwd: directory, stdout: output, handles: factory, clock: clock, exit: exit, ..) = move inputs;
  let std::fs::Directory(read: readable, write: writable) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move writable);
  std::fs::close_directory(factory: &factory, directory: move readable);
  let count = std::text::args_count(args: &args);
  let leave = count == 1_u64;
  let cell = shared_new::<u64>(value: 0_u64);
  let waiting = shared_share::<u64>(shared: &cell);
  spawn wait_forever(cell: move waiting);
  spawn sleep_an_hour(clock: move clock);
  let ending = std::process::exit_share(exit: &exit);
  let ending_factory = std::io::factory_share(factory: &factory);
  spawn end_now(exit: move ending, factory: move ending_factory, output: move output, leave: leave);
  return std::process::exit_status(code: 0_u8);
}
