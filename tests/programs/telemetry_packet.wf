alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn store_u32_be(out: &[u8], offset: u64, value: u32) -> result: Result<unit, NarrowError> writes(out) {
  doc "Four big-endian bytes land in the caller's range reference; its len is the range's own measure [REF-4, MSR-1].";
  let first_word = ishr.wrap(value, 24_u32);
  let second_shifted = ishr.wrap(value, 16_u32);
  let second_word = iand(second_shifted, 255_u32);
  let third_shifted = ishr.wrap(value, 8_u32);
  let third_word = iand(third_shifted, 255_u32);
  let fourth_word = iand(value, 255_u32);
  let first = cvt::<u32, u8>(first_word);
  let second = cvt::<u32, u8>(second_word);
  let third = cvt::<u32, u8>(third_word);
  let fourth = cvt::<u32, u8>(fourth_word);
  let second_offset = offset +wrap 1_u64;
  let third_offset = offset +wrap 2_u64;
  let fourth_offset = offset +wrap 3_u64;
  let store_room = deref(out).len;
  if offset < store_room {
  } else {
    let error = NarrowError();
    return Err<unit, NarrowError>(error: error);
  }
  set deref(out)[offset] = first;
  if second_offset < store_room {
  } else {
    let error = NarrowError();
    return Err<unit, NarrowError>(error: error);
  }
  set deref(out)[second_offset] = second;
  if third_offset < store_room {
  } else {
    let error = NarrowError();
    return Err<unit, NarrowError>(error: error);
  }
  set deref(out)[third_offset] = third;
  if fourth_offset < store_room {
  } else {
    let error = NarrowError();
    return Err<unit, NarrowError>(error: error);
  }
  set deref(out)[fourth_offset] = fourth;
  return Ok<unit, NarrowError>(value: unit);
}

fn load_u32_be(input: &[u8], offset: u64) -> result: u32 reads(input) {
  let second_offset = offset +wrap 1_u64;
  let third_offset = offset +wrap 2_u64;
  let fourth_offset = offset +wrap 3_u64;
  let load_room = deref(input).len;
  if offset < load_room {
  } else {
    return 0_u32;
  }
  let first_byte = deref(input)[offset];
  if second_offset < load_room {
  } else {
    return 0_u32;
  }
  let second_byte = deref(input)[second_offset];
  if third_offset < load_room {
  } else {
    return 0_u32;
  }
  let third_byte = deref(input)[third_offset];
  if fourth_offset < load_room {
  } else {
    return 0_u32;
  }
  let fourth_byte = deref(input)[fourth_offset];
  let first = cvt::<u8, u32>(first_byte);
  let second = cvt::<u8, u32>(second_byte);
  let third = cvt::<u8, u32>(third_byte);
  let fourth = cvt::<u8, u32>(fourth_byte);
  let first_shifted = ishl.wrap(first, 24_u32);
  let second_shifted = ishl.wrap(second, 16_u32);
  let third_shifted = ishl.wrap(third, 8_u32);
  let first_second = ior(first_shifted, second_shifted);
  let first_third = ior(first_second, third_shifted);
  return ior(first_third, fourth);
}

fn main() -> status: ExitStatus pure {
  doc "The packet is one inline Slots window of this frame, reached by one range reference for both the stores and the loads [TYPE-9, REF-4].";
  let packet = slots_new::<u8, 12>();
  for @fill_packet (
    at in 0_u64..12_u64,
    invariant grown: packet.len == at
  ) {
    place_back(window: &packet, value: 0_u8);
  }
  let window = &packet[0_u64..12_u64];
  let temperature = 36.5_f32;
  let temperature_bits = reinterpret::<f32, u32>(temperature);
  let stored_temperature = store_u32_be(out: window, offset: 0_u64, value: temperature_bits);
  match stored_temperature {
    Ok(value: success) => {
    }
    Err(error: narrow) => {
      return exit_status(code: 1_u8);
    }
  }
  let negative_zero = -0.0_f32;
  let negative_zero_bits = reinterpret::<f32, u32>(negative_zero);
  let stored_zero = store_u32_be(out: window, offset: 4_u64, value: negative_zero_bits);
  match stored_zero {
    Ok(value: success) => {
    }
    Err(error: narrow) => {
      return exit_status(code: 1_u8);
    }
  }
  let nan = fnan::<f32>();
  let nan_bits = reinterpret::<f32, u32>(nan);
  let stored_nan = store_u32_be(out: window, offset: 8_u64, value: nan_bits);
  match stored_nan {
    Ok(value: success) => {
    }
    Err(error: narrow) => {
      return exit_status(code: 1_u8);
    }
  }
  let temperature_read = load_u32_be(input: window, offset: 0_u64);
  let temperature_decoded = reinterpret::<u32, f32>(temperature_read);
  if feq(temperature_decoded, temperature) {
  } else {
    return exit_status(code: 1_u8);
  }
  let zero_read = load_u32_be(input: window, offset: 4_u64);
  let zero_decoded = reinterpret::<u32, f32>(zero_read);
  let reciprocal = fdiv.strict(1.0_f32, zero_decoded);
  let infinity = finf::<f32>();
  let negative_infinity = fneg(infinity);
  if feq(reciprocal, negative_infinity) {
  } else {
    return exit_status(code: 1_u8);
  }
  let nan_read = load_u32_be(input: window, offset: 8_u64);
  let nan_decoded = reinterpret::<u32, f32>(nan_read);
  if fne(nan_decoded, nan_decoded) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
