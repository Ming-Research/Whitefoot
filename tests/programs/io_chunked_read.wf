alias Args = std::text::Args;
alias DirectoryRead = std::fs::DirectoryRead;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias arg_get = std::text::arg_get;
alias close_directory = std::fs::close_directory;
alias close_read = std::fs::close_read;
alias exit_status = std::process::exit_status;
alias open_read = std::fs::open_read;
alias read_at = std::fs::read_at;
alias relative_path = std::fs::relative_path;

fn exercise(args: &Args, cwd: &DirectoryRead, files: &HandleFactory) -> status: ExitStatus reads(args), reads(cwd), writes(files) {
  doc "A short success is progress, not end of input, so the drain keeps requesting until the host reports the end; the destination range reference is formed again for each request [REF-2].";
  match arg_get(args: args, position: 1_u64) {
    Ok(value: text) => {
      match relative_path(value: move text) {
        Ok(value: path) => {
          match open_read(factory: files, root: cwd, path: &path) {
            Ok(value: file) => {
              let bytes = array_filled::<u8, 3>(value: 0_u8);
              let total = 0_u64;
              let chunks = 0_u64;
              let failed = False();
              loop @drain {
                let window = &bytes[0_u64..3_u64];
                match read_at(factory: files, file: &file, destination: window, file_offset: total, start: 0_u64, end: 3_u64) {
                  Ok(value: n) => {
                    set total = total +wrap n;
                    set chunks = chunks +wrap 1_u64;
                  }
                  Err(error: read_stop) => {
                    match read_stop {
                      ReadEnd() => {
                        break @drain;
                      }
                      ReadFailed(error: problem) => {
                        set failed = True();
                        break @drain;
                      }
                    }
                  }
                }
              }
              if failed {
                close_read(factory: files, file: move file);
                return exit_status(code: 202_u8);
              }
              let scaled = total *wrap 10_u64;
              let mixed = scaled +wrap chunks;
              let narrowed = cvt.checked::<u64, u8>(mixed);
              match narrowed {
                Ok(value: code) => {
                  close_read(factory: files, file: move file);
                  return exit_status(code: code);
                }
                Err(error: overflowed) => {
                  close_read(factory: files, file: move file);
                  return exit_status(code: 200_u8);
                }
              }
            }
            Err(error: problem) => {
              return exit_status(code: 203_u8);
            }
          }
        }
        Err(error: rejected) => {
          return exit_status(code: 204_u8);
        }
      }
    }
    Err(error: absent) => {
      return exit_status(code: 205_u8);
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "PRE-1 ordinary Inputs are destructured once; the referenced operation chain returns before the initial directory is explicitly closed on every exit.";
  let Inputs(args: args, cwd: cwd, stdout: unused_stdout, stderr: unused_stderr, handles: files, stdin: unused_stdin) = move inputs;
  let outcome = exercise(args: &args, cwd: &cwd, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return move outcome;
}
