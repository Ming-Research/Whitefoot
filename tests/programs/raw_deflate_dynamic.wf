struct HuffmanTable {
  counts: Slots<u64, 16>;
  symbols: Slots<u64, 286>;
  max_bits: u32;
  used_symbols: u64;
}

const code_length_order: Array<u8, 19> =[16_u8, 17_u8, 18_u8, 0_u8, 8_u8, 7_u8, 9_u8, 6_u8, 10_u8, 5_u8, 11_u8, 4_u8, 12_u8, 3_u8, 13_u8, 2_u8, 14_u8, 1_u8, 15_u8];

fn decode_length(state: &InflateState, input: &[u8], symbol: u64) -> result: Result<u64, InflateError> reads(input), writes(state.input_offset), writes(state.hold), writes(state.bits) {
  let before_lengths = symbol < 257_u64;
  let after_lengths = symbol >= 286_u64;
  let invalid_symbol = bor(before_lengths, after_lengths);
  if invalid_symbol {
    let error = InflateError::InvalidHuffmanCode();
    return Err<u64, InflateError>(error: error);
  }
  let length_index = symbol -wrap 257_u64;
  let length_in_tables = length_index < 29_u64;
  if length_in_tables {
  } else {
    let error = InflateError::InvalidHuffmanCode();
    return Err<u64, InflateError>(error: error);
  }
  let length_base_word = length_bases[length_index];
  let length_base = cvt::<u16, u64>(length_base_word);
  let length_extra_byte = length_extras[length_index];
  let length_extra_count = cvt::<u8, u32>(length_extra_byte);
  let length_extra_high = ishl.wrap(1_u64, length_extra_count);
  let length_extra_mask = length_extra_high -wrap 1_u64;
  let length_extra = 0_u64;
  match read_bits(state: state, input: input, count: length_extra_count, mask: length_extra_mask) {
    Ok(value: extra) => {
      set length_extra = extra;
    }
    Err(error: length_error) => {
      return Err<u64, InflateError>(error: length_error);
    }
  }
  let copy_length = length_base +wrap length_extra;
  return Ok<u64, InflateError>(value: copy_length);
}

fn copy_distance(state: &InflateState, input: &[u8], out: &[u8], copy_length: u64, distance_symbol: u64) -> result: Result<unit, InflateError> reads(input), writes(state.input_offset), writes(state.output_offset), writes(state.hold), writes(state.bits), writes(out) {
  let invalid_distance_symbol = distance_symbol >= 30_u64;
  if invalid_distance_symbol {
    let error = InflateError::InvalidDistance();
    return Err<unit, InflateError>(error: error);
  }
  let distance_base_word = distance_bases[distance_symbol];
  let distance_base = cvt::<u16, u64>(distance_base_word);
  let distance_extra_byte = distance_extras[distance_symbol];
  let distance_extra_count = cvt::<u8, u32>(distance_extra_byte);
  let distance_extra_high = ishl.wrap(1_u64, distance_extra_count);
  let distance_extra_mask = distance_extra_high -wrap 1_u64;
  let distance_extra = 0_u64;
  match read_bits(state: state, input: input, count: distance_extra_count, mask: distance_extra_mask) {
    Ok(value: extra) => {
      set distance_extra = extra;
    }
    Err(error: distance_error) => {
      return Err<unit, InflateError>(error: distance_error);
    }
  }
  let distance = distance_base +wrap distance_extra;
  let before_history = deref(state).output_offset < distance;
  if before_history {
    let error = InflateError::InvalidDistance();
    return Err<unit, InflateError>(error: error);
  }
  let copied = 0_u64;
  loop @copy_match {
    let copy_done = copied == copy_length;
    if copy_done {
      break @copy_match;
    } else {
      let source_index = deref(state).output_offset -wrap distance;
      let history_room = deref(out).len;
      let source_in_history = source_index < history_room;
      if source_in_history {
      } else {
        let error = InflateError::InvalidDistance();
        return Err<unit, InflateError>(error: error);
      }
      let byte = deref(out)[source_index];
      match emit_byte(state: state, out: out, value: byte) {
        Ok(value: emitted) => {
        }
        Err(error: emit_error) => {
          return Err<unit, InflateError>(error: emit_error);
        }
      }
      set copied = copied +wrap 1_u64;
    }
  }
  return Ok<unit, InflateError>(value: unit);
}

fn build_huffman_table(lengths: &[u8], symbol_count: u64, max_bits: u32, allow_single: Bool, allow_empty: Bool) -> result: Result<HuffmanTable, InflateError> reads(lengths) contract {
  define lengths_room = deref(lengths).len;
  define symbol_limit = symbol_count <= 286_u64;
  requires symbol_count <= lengths_room;
  requires symbol_limit;
} {
  doc "The two columns are inline Slots windows of this frame, so the table needs no heap cell [TYPE-9, STOR-1].";
  let count_slots_word = cvt::<u32, u64>(max_bits);
  let count_slots = count_slots_word +wrap 1_u64;
  let count_slots_fit = count_slots <= 16_u64;
  if count_slots_fit {
  } else {
    let error = InflateError::InvalidHuffmanTree();
    return Err<HuffmanTable, InflateError>(error: error);
  }
  let counts = slots_new::<u64, 16>();
  for @reserve_counts (
    at in 0_u64..count_slots,
    invariant made_lo: counts.len >= at,
    invariant made_hi: counts.len <= at,
    invariant spare_lo: counts.cap - counts.len + at >= 16_u64,
    invariant spare_hi: counts.cap - counts.len + at <= 16_u64
  ) {
    place_back(window: &counts, value: 0_u64);
  }
  let symbols = slots_new::<u64, 286>();
  for @reserve_symbols (
    at in 0_u64..symbol_count,
    invariant made_lo: symbols.len >= at,
    invariant made_hi: symbols.len <= at,
    invariant spare_lo: symbols.cap - symbols.len + at >= 286_u64,
    invariant spare_hi: symbols.cap - symbols.len + at <= 286_u64
  ) {
    place_back(window: &symbols, value: 0_u64);
  }
  let nonzero = 0_u64;
  let sole_length = 0_u32;
  for @count_lengths (symbol in 0_u64..symbol_count) {
    let length_byte = deref(lengths)[symbol];
    let length = cvt::<u8, u32>(length_byte);
    let too_long = length > max_bits;
    if too_long {
      let error = InflateError::InvalidHuffmanTree();
      return Err<HuffmanTable, InflateError>(error: error);
    }
    let present = length > 0_u32;
    if present {
      let count_index = cvt::<u32, u64>(length);
      let previous_count = counts[count_index];
      set counts[count_index] = previous_count +wrap 1_u64;
      set nonzero = nonzero +wrap 1_u64;
      set sole_length = length;
    }
  }
  let left = 1_u64;
  let length = 1_u32;
  loop @validate_lengths {
    let validation_done = length > max_bits;
    if validation_done {
      break @validate_lengths;
    } else {
      set left = ishl.wrap(left, 1_u32);
      let count_index = cvt::<u32, u64>(length);
      let count = counts[count_index];
      let oversubscribed = count > left;
      if oversubscribed {
        let error = InflateError::InvalidHuffmanTree();
        return Err<HuffmanTable, InflateError>(error: error);
      }
      set left = left -wrap count;
      set length = length +wrap 1_u32;
    }
  }
  let incomplete = left > 0_u64;
  if incomplete {
    let one_symbol = nonzero == 1_u64;
    let one_bit = sole_length == 1_u32;
    let permitted_single = band(allow_single, one_symbol);
    let permitted_one_bit = band(permitted_single, one_bit);
    let no_symbols = nonzero == 0_u64;
    let permitted_empty = band(allow_empty, no_symbols);
    let permitted_incomplete = bor(permitted_one_bit, permitted_empty);
    if permitted_incomplete {
    } else {
      let error = InflateError::InvalidHuffmanTree();
      return Err<HuffmanTable, InflateError>(error: error);
    }
  }
  let offsets = slots_new::<u64, 16>();
  for @reserve_offsets (
    at in 0_u64..count_slots,
    invariant made_lo: offsets.len >= at,
    invariant made_hi: offsets.len <= at,
    invariant spare_lo: offsets.cap - offsets.len + at >= 16_u64,
    invariant spare_hi: offsets.cap - offsets.len + at <= 16_u64
  ) {
    place_back(window: &offsets, value: 0_u64);
  }
  let offset = 0_u64;
  set length = 1_u32;
  loop @build_offsets {
    let offsets_done = length > max_bits;
    if offsets_done {
      break @build_offsets;
    } else {
      let count_index = cvt::<u32, u64>(length);
      set offsets[count_index] = offset;
      let count = counts[count_index];
      set offset = offset +wrap count;
      set length = length +wrap 1_u32;
    }
  }
  for @order_symbols (symbol in 0_u64..symbol_count) {
    let length_byte = deref(lengths)[symbol];
    let symbol_length = cvt::<u8, u32>(length_byte);
    let present = symbol_length > 0_u32;
    if present {
      let count_index = cvt::<u32, u64>(symbol_length);
      let order_offsets_room = offsets.len;
      let order_slot_ok = count_index < order_offsets_room;
      if order_slot_ok {
      } else {
        let error = InflateError::InvalidHuffmanTree();
        return Err<HuffmanTable, InflateError>(error: error);
      }
      let destination = offsets[count_index];
      let order_symbols_room = symbols.len;
      let destination_ok = destination < order_symbols_room;
      if destination_ok {
      } else {
        let error = InflateError::InvalidHuffmanTree();
        return Err<HuffmanTable, InflateError>(error: error);
      }
      set symbols[destination] = symbol;
      set offsets[count_index] = destination +wrap 1_u64;
    }
  }
  let table = HuffmanTable(counts: move counts, symbols: move symbols, max_bits: max_bits, used_symbols: nonzero);
  return Ok<HuffmanTable, InflateError>(value: move table);
}

fn decode_table_symbol(state: &InflateState, input: &[u8], table: &HuffmanTable) -> result: Result<u64, InflateError> reads(input), reads(table.counts), reads(table.symbols), reads(table.max_bits), reads(table.used_symbols), writes(state.input_offset), writes(state.hold), writes(state.bits) {
  let empty = deref(table).used_symbols == 0_u64;
  if empty {
    let error = InflateError::InvalidHuffmanCode();
    return Err<u64, InflateError>(error: error);
  }
  let code = 0_u64;
  let first = 0_u64;
  let symbol_index = 0_u64;
  let bit_length = 1_u32;
  let decoded = 0_u64;
  loop @table_code_lengths {
    let bit = 0_u64;
    match read_bits(state: state, input: input, count: 1_u32, mask: 1_u64) {
      Ok(value: read_bit) => {
        set bit = read_bit;
      }
      Err(error: read_error) => {
        return Err<u64, InflateError>(error: read_error);
      }
    }
    set code = ior(code, bit);
    let count_index = cvt::<u32, u64>(bit_length);
    let table_counts_room = deref(table).counts.len;
    let table_count_ok = count_index < table_counts_room;
    if table_count_ok {
    } else {
      let error = InflateError::InvalidHuffmanTree();
      return Err<u64, InflateError>(error: error);
    }
    let count = deref(table).counts[count_index];
    let first_after_count = first +wrap count;
    let at_or_after_first = code >= first;
    let before_end = code < first_after_count;
    let found = band(at_or_after_first, before_end);
    if found {
      let offset = code -wrap first;
      let ordered = symbol_index +wrap offset;
      let table_symbols_room = deref(table).symbols.len;
      let ordered_ok = ordered < table_symbols_room;
      if ordered_ok {
      } else {
        let error = InflateError::InvalidHuffmanTree();
        return Err<u64, InflateError>(error: error);
      }
      set decoded = deref(table).symbols[ordered];
      break @table_code_lengths;
    }
    set symbol_index = symbol_index +wrap count;
    set first = ishl.wrap(first_after_count, 1_u32);
    set code = ishl.wrap(code, 1_u32);
    let last_length = bit_length == deref(table).max_bits;
    if last_length {
      let error = InflateError::InvalidHuffmanCode();
      return Err<u64, InflateError>(error: error);
    }
    set bit_length = bit_length +wrap 1_u32;
  }
  return Ok<u64, InflateError>(value: decoded);
}
