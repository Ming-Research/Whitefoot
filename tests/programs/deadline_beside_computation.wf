alias Clock = std::time::Clock;
alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias Instant = std::time::Instant;
alias exit_status = std::process::exit_status;
alias instant_after = std::time::instant_after;
alias instant_reached = std::time::instant_reached;
alias nanoseconds_from = std::time::nanoseconds_from;
alias now = std::time::now;
alias read_next = std::io::read_next;
alias write_once = std::io::write_once;

fn compute(clock: Clock, stop: DecisionCell) -> result: unit pure waits {
  doc "Sleeps 20 ms, so that the reader has begun its read, then computes without waiting until stop is decided or two seconds have passed, reading the cell and the clock between batches of arithmetic; it reaches no wait, so it hands its driver to no other context.";
  let begun = now(clock: &clock);
  let wake = instant_after(instant: begun, nanoseconds: 20000000_u64);
  let never = std::time::cancel_never();
  let slept = std::time::sleep_until(deadline: wake, cancel: &never);
  std::time::close_cancel_watch(watch: move never);
  let started = now(clock: &clock);
  let limit = instant_after(instant: started, nanoseconds: 2000000000_u64);
  let open = Open();
  let state = 1_u64;
  loop @run {
    for @batch (turn in 0_u64..65536_u64) {
      let scaled = state *wrap 6364136223846793005_u64;
      set state = scaled +wrap 1442695040888963407_u64;
    }
    let verdict = decision_cell_read(cell: &stop);
    if verdict != open {
      break @run;
    }
    let at = now(clock: &clock);
    if instant_reached(deadline: limit, instant: at) {
      break @run;
    }
  }
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Reports on standard output that it is about to read, starts a context that computes without waiting once the read has begun, then reads standard input with a deadline 50 ms away while its writer stays silent and the other context computes; once that read has ended it reports so on standard output and reads the byte the writer then sends. The exit status is the bounded read's duration in milliseconds, 250 for 250 ms or more, and 251 to 254 for an outcome other than the expected one, so the case can tell a deadline that ended the read on time from one held until the computation ended [WAIT-2, PRE-2].";
  let Inputs(args: unused_args, drivers: unused_driver_count, cwd: cwd_directory, stdout: output, stderr: unused_stderr, handles: handles, stdin: input, clock: clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter, host_paths: unused_host_paths, process_id: unused_process_id) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  std::fs::close_directory_write(factory: &handles, directory: move cwd_write);
  std::fs::close_directory(factory: &handles, directory: move cwd);
  let bytes = slots_new::<u8, 1>();
  place_back(window: &bytes, value: 0_u8);
  let marker = array_filled::<u8, 1>(value: 46_u8);
  let unbounded = None<Instant>();
  let wait_cancel_1 = std::time::cancel_never();
  let wait_outcome_1 = write_once(factory: &handles, output: &output, source: &marker[0_u64..1_u64], start: 0_u64, end: 1_u64, deadline: unbounded, cancel: &wait_cancel_1);
  std::time::close_cancel_watch(watch: move wait_cancel_1);
  let code = 0_u8;
  match wait_outcome_1 {
    Ok(value: written) => {
      if written != 1_u64 {
        set code = 251_u8;
      }
    }
    Err(error: problem) => {
      set code = 251_u8;
    }
  }
  let stop = decision_cell_new();
  let worker_stop = decision_cell_share(cell: &stop);
  let worker_clock = std::time::clock_share(clock: &clock);
  spawn compute(clock: move worker_clock, stop: move worker_stop);
  let started = now(clock: &clock);
  let soon = instant_after(instant: started, nanoseconds: 50000000_u64);
  let bound = Some<Instant>(value: soon);
  let destination = &bytes[0_u64..1_u64];
  let wait_cancel_2 = std::time::cancel_never();
  let wait_outcome_2 = read_next(factory: &handles, input: &input, destination: destination, start: 0_u64, end: 1_u64, deadline: bound, cancel: &wait_cancel_2);
  std::time::close_cancel_watch(watch: move wait_cancel_2);
  let after = now(clock: &clock);
  let winner = claim_written(cell: &stop);
  match wait_outcome_2 {
    Ok(value: received) => {
      set code = 252_u8;
    }
    Err(error: stop_reason) => {
      match stop_reason {
        ReadEnd() => {
          set code = 253_u8;
        }
        ReadFailed(error: failure) => {
          let unused = 0_u64;
        }
      }
    }
  }
  let ended_bound = None<Instant>();
  let ended_cancel = std::time::cancel_never();
  let ended_outcome = write_once(factory: &handles, output: &output, source: &marker[0_u64..1_u64], start: 0_u64, end: 1_u64, deadline: ended_bound, cancel: &ended_cancel);
  std::time::close_cancel_watch(watch: move ended_cancel);
  match ended_outcome {
    Ok(value: written) => {
      if written != 1_u64 {
        set code = 251_u8;
      }
    }
    Err(error: problem) => {
      set code = 251_u8;
    }
  }
  let later = &bytes[0_u64..1_u64];
  let no_deadline = None<Instant>();
  let wait_cancel_3 = std::time::cancel_never();
  let wait_outcome_3 = read_next(factory: &handles, input: &input, destination: later, start: 0_u64, end: 1_u64, deadline: no_deadline, cancel: &wait_cancel_3);
  std::time::close_cancel_watch(watch: move wait_cancel_3);
  match wait_outcome_3 {
    Ok(value: received) => {
      let unused = received;
    }
    Err(error: problem) => {
      set code = 254_u8;
    }
  }
  if code != 0_u8 {
    return exit_status(code: code);
  }
  let elapsed = nanoseconds_from(earlier: started, later: after);
  let millis = elapsed / 1000000_u64;
  if millis >= 250_u64 {
    return exit_status(code: 250_u8);
  }
  let narrowed = cvt.checked::<u64, u8>(millis);
  match narrowed {
    Ok(value: small) => {
      return exit_status(code: small);
    }
    Err(error: overflowed) => {
      return exit_status(code: 250_u8);
    }
  }
}
