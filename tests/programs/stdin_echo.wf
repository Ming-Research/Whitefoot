alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias read_next = std::io::read_next;
alias write_once = std::io::write_once;

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) contract {
  define source_length = deref(source).len;
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source range, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    match write_once(factory: factory, output: output, source: source, start: sent, end: length) {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "Reads the invocation's standard input to its end with read_next and publishes every byte it observed to standard output through ordinary prelude calls [PRE-1]. The chunk is one inline Slots window of this frame and both halves reach it through the same range reference, because a reference carries no permission marker and the call site decides interference from the declared rows alone [TYPE-9, REF-4, EFF-5].";
  let Inputs(args: unused_args, cwd: unused_cwd, stdout: out, stderr: unused_stderr, handles: entry_factory, stdin: input) = move inputs;
  close_directory(factory: &entry_factory, directory: move unused_cwd);
  let chunk = slots_new::<u8, 4096>();
  for @fill (
    at in 0_u64..4096_u64,
    invariant grown: chunk.len == at
  ) {
    place_back(window: &chunk, value: 0_u8);
  }
  let held = 4096_u64;
  let sink = &chunk[0_u64..4096_u64];
  let outcome = 0_u8;
  loop @chunks {
    let available = 0_u64;
    let ended = 0_u8;
    match read_next(factory: &entry_factory, input: &input, destination: sink, start: 0_u64, end: held) {
      Ok(value: endpoint) => {
        set available = endpoint;
      }
      Err(error: read_stop_14) => {
        match read_stop_14 {
          ReadEnd() => {
            set ended = 1_u8;
          }
          ReadFailed(error: problem) => {
            set outcome = 3_u8;
            set ended = 2_u8;
          }
        }
      }
    }
    if ended == 0_u8 {
      match publish_all(factory: &entry_factory, output: &out, source: sink, length: available) {
        Ok(value: published) => {
        }
        Err(error: problem) => {
          set outcome = 4_u8;
          set ended = 2_u8;
        }
      }
    }
    if ended == 0_u8 {
    } else {
      break @chunks;
    }
  }
  return exit_status(code: outcome);
}
