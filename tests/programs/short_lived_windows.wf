alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;

struct Holder {
  before: u64;
  slots: Slots<Box<u64>, 64>;
  ring: Ring<Box<u64>, 4>;
  after: Array<u64, 3>;
}

enum Held {
  Windows(value: Holder);
  Cell(value: Box<u64>);
}

fn inspect(observed: Held, expected: u64) -> result: Bool pure {
  doc "Whole-value transfers preserve live elements; scope cleanup must ignore the stale Box pointers left by takes.";
  match move observed {
    Windows(value: holder) => {
      if holder.before != expected {
        return False();
      }
      if holder.slots.len != 1_u64 {
        return False();
      }
      if holder.ring.len != 1_u64 {
        return False();
      }
      if holder.ring.head != 3_u64 {
        return False();
      }
      if holder.slots[0_u64].inner != expected {
        return False();
      }
      if holder.ring[0_u64].inner != expected {
        return False();
      }
      for (i in 0_u64..3_u64) {
        if holder.after[i] != expected {
          return False();
        }
      }
      return True();
    }
    Cell(value: cell) => {
      return False();
    }
  }
}

fn holder_of(seed: u64) -> result: Holder pure {
  doc "A holder with one live element in each window.";
  let slots = slots_new::<Box<u64>, 64>();
  let first = box_new::<u64>(value: seed);
  place_back(window: &slots, value: move first);
  let ring = ring_new::<Box<u64>, 4>();
  let back = box_new::<u64>(value: seed);
  place_back(window: &ring, value: move back);
  let after = array_filled::<u64, 3>(value: seed);
  return Holder(before: seed, slots: move slots, ring: move ring, after: after);
}

fn holds(observed: &Held, windows: Bool, expected: u64) -> result: Bool reads(observed) {
  doc "Whether a held value is the expected variant carrying the expected value, read through a reference.";
  match observed^ {
    Windows(value: holder) => {
      if windows {
      } else {
        return False();
      }
      if holder^.before != expected {
        return False();
      }
      if holder^.slots.len != 1_u64 {
        return False();
      }
      if holder^.ring.len != 1_u64 {
        return False();
      }
      if holder^.slots[0_u64].inner != expected {
        return False();
      }
      if holder^.ring[0_u64].inner != expected {
        return False();
      }
      return True();
    }
    Cell(value: cell) => {
      if windows {
        return False();
      }
      if cell^.inner != expected {
        return False();
      }
      return True();
    }
  }
}

fn exchange_held(seed: u64) -> result: Bool pure {
  doc "Held is larger than 128 bytes, so building its Cell variant leaves the Windows view's storage unwritten, holding whatever the reused frame held before. Overwrites, an exchange, a take and scope cleanup of such values must each release every Box once and read only the held variant.";
  let yes = True();
  let no = False();
  let next = seed +wrap 1_u64;
  let third = seed +wrap 2_u64;
  let held = slots_new::<Held, 2>();
  let first = box_new::<u64>(value: next);
  let cell = Held::Cell(value: move first);
  place_back(window: &held, value: move cell);
  let built = holder_of(seed: seed);
  let windows = Held::Windows(value: move built);
  place_back(window: &held, value: move windows);
  let second = box_new::<u64>(value: third);
  let replacing = Held::Cell(value: move second);
  set held[1_u64] = move replacing;
  let rebuilt = holder_of(seed: seed);
  let wide = Held::Windows(value: move rebuilt);
  set held[0_u64] = move wide;
  let overwritten = holds(observed: &held[1_u64], windows: no, expected: third);
  let overwrite_failed = bnot(overwritten);
  if overwrite_failed {
    return False();
  }
  let exchanged_box = box_new::<u64>(value: next);
  let exchanged = Held::Cell(value: move exchanged_box);
  swap(first: &held[0_u64], second: &exchanged);
  let moved_out = holds(observed: &exchanged, windows: yes, expected: seed);
  let out_failed = bnot(moved_out);
  if out_failed {
    return False();
  }
  let moved_in = holds(observed: &held[0_u64], windows: no, expected: next);
  let into_failed = bnot(moved_in);
  if into_failed {
    return False();
  }
  let last = take_back(window: &held);
  match move last {
    Windows(value: lost) => {
      return False();
    }
    Cell(value: taken) => {
      if taken.inner != third {
        return False();
      }
    }
  }
  let leftover = box_new::<u64>(value: third);
  let left = Held::Cell(value: move leftover);
  return holds(observed: &left, windows: no, expected: third);
}

fn churn(seed: u64) -> result: Bool pure {
  doc "Reuse short-lived frame storage, including empty windows, partial windows and a wrapped Ring with releasing elements.";
  let empty = slots_new::<Box<u64>, 64>();
  let zero = ring_new::<Box<u64>, 0>();
  let slots = slots_new::<Box<u64>, 64>();
  let first = box_new::<u64>(value: seed);
  let next = seed +wrap 1_u64;
  let second = box_new::<u64>(value: next);
  place_back(window: &slots, value: move first);
  place_back(window: &slots, value: move second);
  let taken = take_back(window: &slots);
  if taken.inner != next {
    return False();
  }
  place_back(window: &slots, value: move taken);
  let again = take_back(window: &slots);
  if again.inner != next {
    return False();
  }
  let ring = ring_new::<Box<u64>, 4>();
  let front = box_new::<u64>(value: seed);
  let back = box_new::<u64>(value: next);
  place_front(window: &ring, value: move front);
  place_back(window: &ring, value: move back);
  let last = take_back(window: &ring);
  if last.inner != next {
    return False();
  }
  let after = array_filled::<u64, 3>(value: seed);
  let holder = Holder(before: seed, slots: move slots, ring: move ring, after: after);
  let observed = Held::Windows(value: move holder);
  let inspected = inspect(observed: move observed, expected: seed);
  let inspect_failed = bnot(inspected);
  if inspect_failed {
    return False();
  }
  return exchange_held(seed: seed);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: directory, handles: factory, memory_meter: meter, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let baseline = std::process::heap_in_use(meter: &meter);
  for (seed in 0_u64..256_u64) {
    let correct = churn(seed: seed);
    let failed = bnot(correct);
    if failed {
      return exit_status(code: 1_u8);
    }
    let after = std::process::heap_in_use(meter: &meter);
    if after != baseline {
      return exit_status(code: 2_u8);
    }
  }
  return exit_status(code: 0_u8);
}
