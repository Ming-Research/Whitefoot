alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn maximum<T: Int>(left: T, right: T) -> result: T pure {
  return imax(left, right);
}

fn preserve<const n: u64>(value: Slots<u8, n>) -> result: Slots<u8, n> pure {
  doc "A by-value parameter has no effect entry at all, so a function that only measures and hands back its operand has the empty row [EFF-1].";
  let size = value.len;
  return move value;
}

fn forward<const n: u64>(value: Slots<u8, n>) -> result: Slots<u8, n> pure {
  return preserve::<n>(value: move value);
}

fn filled_array<T: Int, const n: u64>(value: T) -> result: Slots<T, n> pure contract {
  ensures result.len >= n;
} {
  doc "One constant-capacity window whose every slot holds a copy of value.";
  let built = slots_new::<T, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: built.len >= at,
    invariant bounded: built.len <= at,
    invariant spare: built.cap - built.len + at >= n
  ) {
    place_back(window: &built, value: value);
  }
  return move built;
}

fn filled_buffer<T: Int>(length: u64, value: T) -> result: Box<Slots<T>> pure contract {
  requires length <= 1152921504606846975_u64;
  ensures result.inner.len >= length;
} {
  doc "One heap cell holding a runtime-capacity window of length slots; allocation is total, so there is no failure arm, and the written bound is what discharges the static allocation-size obligation [STOR-8, OP-9].";
  let built = box_slots_new::<T>(capacity: length);
  for @fill (
    at in 0_u64..length,
    invariant grown: built.inner.len >= at,
    invariant bounded: built.inner.len <= at,
    invariant spare: built.inner.cap - built.inner.len + at >= length
  ) {
    place_back(window: &built.inner, value: value);
  }
  return move built;
}

fn main() -> status: ExitStatus pure {
  doc "Two concrete instances of each generic: two element types, two written capacities, and one runtime-capacity cell.";
  let small_maximum = maximum::<u8>(left: 4_u8, right: 9_u8);
  let signed_maximum = maximum::<i64>(left: -7_i64, right: -2_i64);
  let short_input = slots_new::<u8, 2>();
  place_back(window: &short_input, value: 7_u8);
  place_back(window: &short_input, value: 7_u8);
  let short = forward::<2>(value: move short_input);
  let long_input = slots_new::<u8, 5>();
  place_back(window: &long_input, value: 11_u8);
  place_back(window: &long_input, value: 11_u8);
  place_back(window: &long_input, value: 11_u8);
  place_back(window: &long_input, value: 11_u8);
  place_back(window: &long_input, value: 11_u8);
  let long = forward::<5>(value: move long_input);
  let short_room = short.len;
  let short_ok = 1_u64 < short_room;
  if short_ok {
  } else {
    return exit_status(code: 1_u8);
  }
  let short_value = short[1_u64];
  let long_room = long.len;
  let long_ok = 4_u64 < long_room;
  if long_ok {
  } else {
    return exit_status(code: 1_u8);
  }
  let long_value = long[4_u64];
  let typed_bytes = filled_array::<u8, 2>(value: 13_u8);
  let typed_words = filled_array::<i64, 3>(value: -17_i64);
  let typed_bytes_room = typed_bytes.len;
  let typed_bytes_ok = 1_u64 < typed_bytes_room;
  if typed_bytes_ok {
  } else {
    return exit_status(code: 1_u8);
  }
  let typed_byte = typed_bytes[1_u64];
  let typed_words_room = typed_words.len;
  let typed_words_ok = 2_u64 < typed_words_room;
  if typed_words_ok {
  } else {
    return exit_status(code: 1_u8);
  }
  let typed_word = typed_words[2_u64];
  let storage = filled_buffer::<u16>(length: 2_u64, value: 19_u16);
  let storage_room = storage.inner.len;
  let storage_ok = 1_u64 < storage_room;
  if storage_ok {
  } else {
    return exit_status(code: 1_u8);
  }
  let stored = storage.inner[1_u64];
  if small_maximum == 9_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if signed_maximum == -2_i64 {
  } else {
    return exit_status(code: 1_u8);
  }
  if short_value == 7_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if long_value == 11_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if typed_byte == 13_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if typed_word == -17_i64 {
  } else {
    return exit_status(code: 1_u8);
  }
  if stored == 19_u16 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
