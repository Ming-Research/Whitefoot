alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn view_total(window: &[u8]) -> total: u64 reads(window) {
  doc "The run is reached through one range reference, whose one measure is len [REF-4, MSR-1].";
  let width = deref(window).len;
  let sum = 0_u64;
  let at = 0_u64;
  loop @add {
    let done = at == width;
    if done {
      break @add;
    }
    let inside = at < width;
    if inside {
      let slot = deref(window)[at];
      let widened = cvt::<u8, u64>(slot);
      set sum = sum +wrap widened;
      set at = at +wrap 1_u64;
    } else {
      return 0_u64;
    }
  }
  return sum;
}

fn main() -> status: ExitStatus pure {
  doc "Range references over a Slots window replace the retired view values: one reference is passed twice with no move, the window is appended to after that reference's last use, it is drained to empty from the front by remove_at, and a second reference reads back what a write through the first one left.";
  let empty = slots_new::<u8, 4>();
  place_back(window: &empty, value: 3_u8);
  let one = move empty;
  place_back(window: &one, value: 4_u8);
  let two = move one;
  let window = &two[0_u64..two.len];
  let width = deref(window).len;
  if width == 2_u64 {
  } else {
    return exit_status(code: 21_u8);
  }
  let total = view_total(window: window);
  let again = view_total(window: window);
  if total == 7_u64 {
  } else {
    return exit_status(code: 22_u8);
  }
  if again == total {
  } else {
    return exit_status(code: 23_u8);
  }
  place_back(window: &two, value: 5_u8);
  let three = move two;
  let after = &three[0_u64..three.len];
  let extended = view_total(window: after);
  if extended == 12_u64 {
  } else {
    return exit_status(code: 24_u8);
  }
  let taken = remove_at(window: &three, index: 0_u64);
  let rest = move three;
  let next = remove_at(window: &rest, index: 0_u64);
  let shorter = move rest;
  let last = remove_at(window: &shorter, index: 0_u64);
  let drained = move shorter;
  let nothing = &drained[0_u64..drained.len];
  let empty_width = deref(nothing).len;
  if empty_width == 0_u64 {
  } else {
    return exit_status(code: 25_u8);
  }
  let table = slots_new::<u8, 3>();
  for @fill_table (
    at in 0_u64..3_u64,
    invariant grown: table.len == at
  ) {
    place_back(window: &table, value: 7_u8);
  }
  let writer = &table[0_u64..3_u64];
  set deref(writer)[0_u64] = 9_u8;
  let reader = &table[0_u64..3_u64];
  let seen = deref(reader)[0_u64];
  if seen == 9_u8 {
  } else {
    return exit_status(code: 26_u8);
  }
  set deref(writer)[1_u64] = 11_u8;
  let written = deref(writer)[1_u64];
  if written == 11_u8 {
  } else {
    return exit_status(code: 27_u8);
  }
  return exit_status(code: 0_u8);
}
