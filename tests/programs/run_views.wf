alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn view_total(window: &[u8]) -> total: u64 reads(window) {
  doc "The run is reached through one range reference, whose one measure is len [REF-4, MSR-1].";
  let width = window^.len;
  let sum = 0_u64;
  let at = 0_u64;
  loop @add {
    let done = at == width;
    if done {
      break @add;
    }
    let inside = at < width;
    if inside {
      let slot = window^[at];
      let widened = cvt::<u8, u64>(slot);
      set sum = sum +wrap widened;
      set at = at +wrap 1_u64;
    } else {
      return 0_u64;
    }
  }
  return sum;
}

fn publish_report(factory: &std::io::HandleFactory, output: &std::io::OutputStream, source: &[u8], length: u64) -> result: Result<unit, std::io::IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  doc "Publishes one prefix of the report, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let wait_cancel = std::time::cancel_never();
    let wait_outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &wait_cancel);
    std::time::close_cancel_watch(watch: move wait_cancel);
    match wait_outcome {
      Ok(value: accepted) => {
        set sent = accepted;
      }
      Err(error: problem) => {
        return Err<unit, std::io::IoError>(error: problem);
      }
    }
  }
  return Ok<unit, std::io::IoError>(value: unit);
}

fn main(inputs: std::process::Inputs) -> status: ExitStatus pure waits {
  doc "Range references over a Slots window replace the retired view values: one reference is passed twice with no move, the window is appended to after that reference's last use, it is drained to empty from the front by remove_at, and a second reference reads back what a write through the first one left. The two references' lengths are published one byte each for the harness to compare.";
  let std::process::Inputs(args: unused_args, drivers: unused_driver_count, cwd: unused_cwd_directory, stdout: out, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter, process_id: unused_process_id) = move inputs;
  let std::fs::Directory(read: unused_cwd, write: unused_cwd_write) = move unused_cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move unused_cwd_write);
  std::fs::close_directory(factory: &factory, directory: move unused_cwd);
  let report = array_filled::<u8, 2>(value: 0_u8);
  let empty = slots_new::<u8, 4>();
  place_back(window: &empty, value: 3_u8);
  let one = move empty;
  place_back(window: &one, value: 4_u8);
  let two = move one;
  let window = &two[0_u64..two.len];
  let width = window^.len;
  set report[0_u64] = cvt::<u64, u8>(width);
  let total = view_total(window: window);
  let again = view_total(window: window);
  if total == 7_u64 {
  } else {
    return exit_status(code: 22_u8);
  }
  if again == total {
  } else {
    return exit_status(code: 23_u8);
  }
  place_back(window: &two, value: 5_u8);
  let three = move two;
  let after = &three[0_u64..three.len];
  let extended = view_total(window: after);
  if extended == 12_u64 {
  } else {
    return exit_status(code: 24_u8);
  }
  let taken = remove_at(window: &three, index: 0_u64);
  let rest = move three;
  let next = remove_at(window: &rest, index: 0_u64);
  let shorter = move rest;
  let last = remove_at(window: &shorter, index: 0_u64);
  let drained = move shorter;
  let nothing = &drained[0_u64..drained.len];
  let empty_width = nothing^.len;
  set report[1_u64] = cvt::<u64, u8>(empty_width);
  let table = slots_new::<u8, 3>();
  for @fill_table (
    at in 0_u64..3_u64,
    invariant grown: table.len == at
  ) {
    place_back(window: &table, value: 7_u8);
  }
  let writer = &table[0_u64..3_u64];
  set writer^[0_u64] = 9_u8;
  let reader = &table[0_u64..3_u64];
  let seen = reader^[0_u64];
  if seen == 9_u8 {
  } else {
    return exit_status(code: 26_u8);
  }
  set writer^[1_u64] = 11_u8;
  let written = writer^[1_u64];
  if written == 11_u8 {
  } else {
    return exit_status(code: 27_u8);
  }
  let report_window = &report[0_u64..2_u64];
  match publish_report(factory: &factory, output: &out, source: report_window, length: 2_u64) {
    Ok(value: published) => {
    }
    Err(error: problem) => {
      return exit_status(code: 28_u8);
    }
  }
  return exit_status(code: 0_u8);
}
