alias Args = std::text::Args;
alias DirectoryRead = std::fs::DirectoryRead;
alias DirectorySource = std::fs::DirectorySource;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias IoError = std::io::IoError;
alias OutputStream = std::io::OutputStream;
alias close_directory = std::fs::close_directory;
alias close_directory_source = std::fs::close_directory_source;
alias directory_next = std::fs::directory_next;
alias exit_status = std::process::exit_status;
alias open_directory = std::fs::open_directory;
alias open_directory_source = std::fs::open_directory_source;
alias write_once = std::io::write_once;

const empty_prefix: Array<u8, 1> =[0_u8];

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) contract {
  define source_length = deref(source).len;
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source range, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    match write_once(factory: factory, output: output, source: source, start: sent, end: length) {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn stored_byte(records: &Slots<u8, 8192>, index: u64) -> result: u8 reads(records) {
  doc "Reads one record byte, delivering zero for a position the record table does not hold.";
  let held = deref(records).len;
  let inside = index < held;
  if inside {
    let value = deref(records)[index];
    return value;
  }
  return 0_u8;
}

fn record_before(records: &Slots<u8, 8192>, left: u64, right: u64) -> result: Bool reads(records) {
  doc "Orders two fixed-stride records by their stored path bytes, a shorter prefix first.";
  let left_base = left *wrap 128_u64;
  let right_base = right *wrap 128_u64;
  let left_length_at = left_base +wrap 1_u64;
  let left_length = stored_byte(records: records, index: left_length_at);
  let right_length_at = right_base +wrap 1_u64;
  let right_length = stored_byte(records: records, index: right_length_at);
  let left_count = cvt::<u8, u64>(left_length);
  let right_count = cvt::<u8, u64>(right_length);
  let shared = if left_count < right_count {
    give left_count;
  } else {
    give right_count;
  }
  let left_start = left_base +wrap 2_u64;
  let right_start = right_base +wrap 2_u64;
  let at = 0_u64;
  loop @compare {
    let done = at >= shared;
    if done {
      break @compare;
    }
    let left_at = left_start +wrap at;
    let right_at = right_start +wrap at;
    let left_byte = stored_byte(records: records, index: left_at);
    let right_byte = stored_byte(records: records, index: right_at);
    if left_byte < right_byte {
      return True();
    }
    if left_byte > right_byte {
      return False();
    }
    set at = at +wrap 1_u64;
  }
  return left_count < right_count;
}

fn record_line(records: &Slots<u8, 8192>, index: u64, destination: &[u8], at: u64) -> result: u64 reads(records), writes(destination) {
  doc "Renders one record as its kind glyph, one space, its relative path, and one newline. Whether this callee may write through the destination range reference is stated by this row and by no marker on the reference [EFF-1].";
  let base = index *wrap 128_u64;
  let kind = stored_byte(records: records, index: base);
  let length_at = base +wrap 1_u64;
  let length = stored_byte(records: records, index: length_at);
  let count = cvt::<u8, u64>(length);
  let spare = deref(destination).len;
  let cursor = at;
  let glyph = 48_u8 +wrap kind;
  let kind_fits = cursor < spare;
  if kind_fits {
    set deref(destination)[cursor] = glyph;
    set cursor = cursor +wrap 1_u64;
  }
  let space_fits = cursor < spare;
  if space_fits {
    set deref(destination)[cursor] = 32_u8;
    set cursor = cursor +wrap 1_u64;
  }
  let path_start = base +wrap 2_u64;
  let taken = 0_u64;
  loop @path {
    let done = taken >= count;
    if done {
      break @path;
    }
    let path_at = path_start +wrap taken;
    let byte = stored_byte(records: records, index: path_at);
    let body_fits = cursor < spare;
    if body_fits {
    } else {
      break @path;
    }
    set deref(destination)[cursor] = byte;
    set cursor = cursor +wrap 1_u64;
    set taken = taken +wrap 1_u64;
  }
  let end_fits = cursor < spare;
  if end_fits {
    set deref(destination)[cursor] = 10_u8;
    set cursor = cursor +wrap 1_u64;
  }
  return cursor;
}

fn open_source_from_factory(factory: &HandleFactory, directory: &DirectoryRead) -> result: Result<DirectorySource, IoError> reads(directory), writes(factory) {
  doc "One independent enumeration handle for one directory value.";
  return open_directory_source(factory: factory, directory: directory);
}

fn open_directory_from_factory(factory: &HandleFactory, root: &DirectoryRead, name: &[u8], start: u64, end: u64) -> result: Result<DirectoryRead, IoError> reads(root), reads(name), writes(factory) contract {
  define ordered = start <= end;
  define capacity = deref(name).len;
  define within = end <= capacity;
  requires ordered;
  requires within;
} {
  doc "Opens one child directory by the name bytes a range reference names, with no path value ever formed.";
  return open_directory(factory: factory, root: root, name: name, start: start, end: end);
}

fn walk(factory: &HandleFactory, dir: &DirectoryRead, prefix: &[u8], prefix_length: u64, records: &Slots<u8, 8192>, used: u64, depth: u64) -> count: u64 reads(dir), reads(prefix), writes(factory), writes(records) {
  doc "Enumerates one directory, records every entry's relative path, and descends into every subdirectory it names. The record table stays in its caller and is reached through one reference parameter whose row declares the write; the two scratch runs are frame-resident arrays of this activation [STOR-1].";
  let total = used;
  let too_deep = depth >= 8_u64;
  if too_deep {
    return total;
  }
  let entries = array_filled::<u8, 4096>(value: 0_u8);
  let child = array_filled::<u8, 256>(value: 0_u8);
  match open_source_from_factory(factory: factory, directory: dir) {
    Ok(value: list) => {
      loop @batches {
        let produced = 0_u64;
        let ended = 0_u8;
        let window_room = entries.len;
        let window = &entries[0_u64..4096_u64];
        let (batch_result, endpoint, reported) = directory_next(source: &list, destination: window, start: 0_u64, end: window_room);
        match batch_result {
          Ok(value: completed) => {
            set produced = endpoint;
          }
          Err(error: batch_stop) => {
            match batch_stop {
              ListEnd() => {
                set ended = 1_u8;
              }
              ListFailed(error: problem) => {
                set ended = 2_u8;
              }
            }
          }
        }
        if ended == 0_u8 {
        } else {
          break @batches;
        }
        let empty_batch = produced == 0_u64;
        if empty_batch {
          break @batches;
        }
        let at = 0_u64;
        loop @stored_entry {
          let entries_room = entries.len;
          let child_room = child.len;
          let prefix_room = deref(prefix).len;
          let header_end = at +wrap 3_u64;
          let complete = header_end <= produced;
          if complete {
          } else {
            break @stored_entry;
          }
          let kind_readable = at < entries_room;
          if kind_readable {
          } else {
            break @stored_entry;
          }
          let kind = entries[at];
          let length_low_at = at +wrap 1_u64;
          let length_low_readable = length_low_at < entries_room;
          if length_low_readable {
          } else {
            break @stored_entry;
          }
          let length_high_at = at +wrap 2_u64;
          let length_high_readable = length_high_at < entries_room;
          if length_high_readable {
          } else {
            break @stored_entry;
          }
          let name_length_low = entries[length_low_at];
          let name_length_high = entries[length_high_at];
          let name_count_low = cvt::<u8, u64>(name_length_low);
          let name_count_high = cvt::<u8, u64>(name_length_high);
          let name_count_high_shifted = ishl.wrap(name_count_high, 8_u32);
          let name_count = ior(name_count_low, name_count_high_shifted);
          let name_at = at +wrap 3_u64;
          let name_end = name_at +wrap name_count;
          let bounded = name_end <= produced;
          if bounded {
          } else {
            break @stored_entry;
          }
          let addressable = name_end <= entries_room;
          if addressable {
          } else {
            break @stored_entry;
          }
          set at = name_end;
          let dotted = 0_u8;
          let single = name_count == 1_u64;
          if single {
            let first_readable = name_at < entries_room;
            if first_readable {
              let first = entries[name_at];
              if first == 46_u8 {
                set dotted = 1_u8;
              }
            }
          }
          let paired = name_count == 2_u64;
          if paired {
            let second_at = name_at +wrap 1_u64;
            let first_readable = name_at < entries_room;
            let second_readable = second_at < entries_room;
            if first_readable {
              if second_readable {
                let first = entries[name_at];
                let second = entries[second_at];
                if first == 46_u8 {
                  if second == 46_u8 {
                    set dotted = 1_u8;
                  }
                }
              }
            }
          }
          let separated = prefix_length > 0_u64;
          let separated_length = prefix_length +wrap 1_u64;
          let child_length = if separated {
            give separated_length +wrap name_count;
          } else {
            give name_count;
          }
          let fits = child_length <= 126_u64;
          let usable = dotted == 0_u8;
          if usable {
            if fits {
              let cursor = 0_u64;
              loop @prefix_copy {
                let done = cursor >= prefix_length;
                if done {
                  break @prefix_copy;
                }
                let readable = cursor < prefix_room;
                if readable {
                } else {
                  break @prefix_copy;
                }
                let writable = cursor < child_room;
                if writable {
                } else {
                  break @prefix_copy;
                }
                let byte = deref(prefix)[cursor];
                set child[cursor] = byte;
                set cursor = cursor +wrap 1_u64;
              }
              if separated {
                let separator_fits = cursor < child_room;
                if separator_fits {
                  set child[cursor] = 47_u8;
                  set cursor = cursor +wrap 1_u64;
                }
              }
              let taken = 0_u64;
              loop @name_copy {
                let done = taken >= name_count;
                if done {
                  break @name_copy;
                }
                let source_at = name_at +wrap taken;
                let readable = source_at < entries_room;
                if readable {
                } else {
                  break @name_copy;
                }
                let writable = cursor < child_room;
                if writable {
                } else {
                  break @name_copy;
                }
                let byte = entries[source_at];
                set child[cursor] = byte;
                set cursor = cursor +wrap 1_u64;
                set taken = taken +wrap 1_u64;
              }
              let room_left = total < 64_u64;
              if room_left {
                let stored = imin(cursor, 126_u64);
                let byte_length = cvt::<u64, u8>(stored);
                let start = deref(records).len;
                let record_fits = start <= 8064_u64;
                if record_fits {
                  for @record (
                    slot in 0_u64..128_u64,
                    invariant filled: deref(records).len == start + slot,
                    invariant fits: start <= 8064_u64
                  ) {
                    let byte = 0_u8;
                    let heading = slot < 2_u64;
                    if heading {
                      if slot == 0_u64 {
                        set byte = kind;
                      } else {
                        set byte = byte_length;
                      }
                    } else {
                      let body_at = slot -wrap 2_u64;
                      let inside = body_at < stored;
                      if inside {
                        let room_now = child.len;
                        let readable = body_at < room_now;
                        if readable {
                          set byte = child[body_at];
                        }
                      }
                    }
                    place_back(window: records, value: byte);
                  }
                }
                set total = total +wrap 1_u64;
              }
              let descending = kind == 2_u8;
              if descending {
                let name_view = &entries[0_u64..4096_u64];
                match open_directory_from_factory(factory: factory, root: dir, name: name_view, start: name_at, end: name_end) {
                  Ok(value: opened) => {
                    let deeper = depth +wrap 1_u64;
                    let child_view = &child[0_u64..256_u64];
                    set total = walk(factory: factory, dir: &opened, prefix: child_view, prefix_length: cursor, records: records, used: total, depth: deeper);
                    close_directory(factory: factory, directory: move opened);
                  }
                  Err(error: problem) => {
                  }
                }
              }
            }
          }
        }
      }
      close_directory_source(factory: factory, source: move list);
    }
    Err(error: problem) => {
    }
  }
  return total;
}

fn exercise(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> status: ExitStatus reads(cwd), writes(out), writes(files) {
  doc "Walks the invocation directory recursively and publishes every entry's kind and relative path in sorted order.";
  let status = 0_u8;
  let records = slots_new::<u8, 8192>();
  let line = array_filled::<u8, 256>(value: 0_u8);
  let order = array_filled::<u64, 64>(value: 0_u64);
  let root_view = &empty_prefix[0_u64..1_u64];
  let stored = walk(factory: files, dir: cwd, prefix: root_view, prefix_length: 0_u64, records: &records, used: 0_u64, depth: 0_u64);
  let seed = 0_u64;
  loop @seed_order {
    let order_room = order.len;
    let done = seed >= stored;
    if done {
      break @seed_order;
    }
    let writable = seed < order_room;
    if writable {
    } else {
      break @seed_order;
    }
    set order[seed] = seed;
    set seed = seed +wrap 1_u64;
  }
  let selected = 0_u64;
  loop @sort {
    let order_room = order.len;
    let done = selected >= stored;
    if done {
      break @sort;
    }
    let selected_readable = selected < order_room;
    if selected_readable {
    } else {
      break @sort;
    }
    let best = selected;
    let probe = selected +wrap 1_u64;
    loop @scan {
      let scan_room = order.len;
      let scanned = probe >= stored;
      if scanned {
        break @scan;
      }
      let probe_readable = probe < scan_room;
      if probe_readable {
      } else {
        break @scan;
      }
      let best_readable = best < scan_room;
      if best_readable {
      } else {
        break @scan;
      }
      let candidate = order[probe];
      let incumbent = order[best];
      let earlier = 0_u8;
      let closer = record_before(records: &records, left: candidate, right: incumbent);
      if closer {
        set earlier = 1_u8;
      }
      if earlier == 1_u8 {
        set best = probe;
      }
      set probe = probe +wrap 1_u64;
    }
    let swap_room = order.len;
    let best_readable = best < swap_room;
    let selected_writable = selected < swap_room;
    if best_readable {
      if selected_writable {
        let standing = order[selected];
        let winner = order[best];
        set order[best] = standing;
        set order[selected] = winner;
      }
    }
    set selected = selected +wrap 1_u64;
  }
  let emitted = 0_u64;
  loop @emit {
    let order_room = order.len;
    let done = emitted >= stored;
    if done {
      break @emit;
    }
    let readable = emitted < order_room;
    if readable {
    } else {
      break @emit;
    }
    let index = order[emitted];
    let line_window = &line[0_u64..256_u64];
    let length = record_line(records: &records, index: index, destination: line_window, at: 0_u64);
    let payload = &line[0_u64..256_u64];
    let payload_length = deref(payload).len;
    let length_fits = length <= payload_length;
    if length_fits {
      match publish_all(factory: files, output: out, source: payload, length: length) {
        Ok(value: published) => {
        }
        Err(error: problem) => {
          set status = 2_u8;
        }
      }
    } else {
      set status = 2_u8;
    }
    if status == 0_u8 {
    } else {
      break @emit;
    }
    set emitted = emitted +wrap 1_u64;
  }
  return exit_status(code: status);
}

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "PRE-1 ordinary Inputs are destructured once; the referenced operation chain returns before the initial directory is explicitly closed on every exit.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: files, stdin: unused_stdin) = move inputs;
  let outcome = exercise(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return move outcome;
}
