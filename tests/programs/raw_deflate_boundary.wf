fn append_slice(destination: &[u8], capacity: u64, filled: u64, text: &[u8]) -> result: u64 reads(text), writes(destination) contract {
  requires capacity == deref(destination).len;
  requires filled <= capacity;
  ensures result <= capacity;
} {
  doc "Appends as much of one static message as the destination range reference still holds.";
  let spare = deref(destination).len;
  let admitted = filled <= spare;
  let length = deref(text).len;
  if admitted {
    for @append (at in filled..spare) {
      let taken = at -wrap filled;
      let done = taken >= length;
      if done {
        return at;
      }
      let byte = deref(text)[taken];
      set deref(destination)[at] = byte;
    }
    return spare;
  } else {
    return filled;
  }
}

fn copy_range(destination: &[u8], at: u64, source: &[u8], from: u64, to: u64) -> result: u64 reads(source), writes(destination) {
  doc "Copies one half-open source range into the destination at one offset.";
  let source_room = deref(source).len;
  let destination_room = deref(destination).len;
  let target = at;
  let cursor = from;
  loop @copy {
    let done = cursor >= to;
    if done {
      break @copy;
    }
    let read_ok = cursor < source_room;
    if read_ok {
    } else {
      return target;
    }
    let byte = deref(source)[cursor];
    let write_ok = target < destination_room;
    if write_ok {
    } else {
      return target;
    }
    set deref(destination)[target] = byte;
    set target = target +wrap 1_u64;
    set cursor = cursor +wrap 1_u64;
  }
  return target;
}

fn inflate_status(error: InflateError) -> result: u8 pure {
  doc "Reduces one decode failure to the status the driver reports for it: 5 an early end of stream, 6 a malformed stream, 7 an output buffer too small.";
  match error {
    Truncated() => {
      return 5_u8;
    }
    InvalidStoredLength() => {
      return 6_u8;
    }
    InvalidHuffmanTree() => {
      return 6_u8;
    }
    InvalidHuffmanCode() => {
      return 6_u8;
    }
    InvalidDistance() => {
      return 6_u8;
    }
    InvalidBlockType() => {
      return 6_u8;
    }
    OutputFull() => {
      return 7_u8;
    }
  }
}

fn publish_all(factory: &HandleFactory, output: &OutputStream, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(factory), writes(output) contract {
  define source_length = deref(source).len;
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source range, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    match write_once(factory: factory, output: output, source: source, start: sent, end: length) {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn assemble_reason(report: &[u8], capacity: u64, reason: u8) -> result: u64 writes(report) contract {
  requires capacity == deref(report).len;
  ensures result <= capacity;
} {
  doc "Assembles the static diagnostic that names one boundary outcome and hands its length back; the caller publishes it from the same range reference it handed in [REF-4].";
  let length = 0_u64;
  let report_capacity = capacity;
  if reason == 1_u8 {
    let view = &usage_text[0_u64..33_u64];
    set length = append_slice(destination: report, capacity: report_capacity, filled: length, text: view);
  }
  if reason == 2_u8 {
    let view = &reason_unreadable[0_u64..55_u64];
    set length = append_slice(destination: report, capacity: report_capacity, filled: length, text: view);
  }
  if reason == 3_u8 {
    let view = &reason_empty[0_u64..45_u64];
    set length = append_slice(destination: report, capacity: report_capacity, filled: length, text: view);
  }
  if reason == 4_u8 {
    let view = &reason_too_large[0_u64..64_u64];
    set length = append_slice(destination: report, capacity: report_capacity, filled: length, text: view);
  }
  if reason == 5_u8 {
    let view = &reason_truncated[0_u64..51_u64];
    set length = append_slice(destination: report, capacity: report_capacity, filled: length, text: view);
  }
  if reason == 6_u8 {
    let view = &reason_malformed[0_u64..50_u64];
    set length = append_slice(destination: report, capacity: report_capacity, filled: length, text: view);
  }
  if reason == 7_u8 {
    let view = &reason_output_full[0_u64..63_u64];
    set length = append_slice(destination: report, capacity: report_capacity, filled: length, text: view);
  }
  if reason == 8_u8 {
    let view = &reason_write_failed[0_u64..56_u64];
    set length = append_slice(destination: report, capacity: report_capacity, filled: length, text: view);
  }
  return length;
}

fn exercise(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> status: ExitStatus reads(args), reads(cwd), writes(out), writes(err), writes(files) {
  doc "Reads one raw DEFLATE file named on the command line through ordinary read_at calls; every boundary outcome reaches its own status. The four runs are inline Slots windows of this frame, so the boundary needs no arena [TYPE-9, STOR-1].";
  let scratch = slots_new::<u8, 4097>();
  for @reserve_scratch (
    at in 0_u64..4097_u64,
    invariant grown: scratch.len == at
  ) {
    place_back(window: &scratch, value: 0_u8);
  }
  let report = slots_new::<u8, 128>();
  for @reserve_report (
    at in 0_u64..128_u64,
    invariant grown: report.len == at
  ) {
    place_back(window: &report, value: 0_u8);
  }
  let scratch_window = &scratch[0_u64..4097_u64];
  let report_window = &report[0_u64..128_u64];
  let report_room = 128_u64;
  let arguments = args_count(args: args);
  let named = arguments >= 2_u64;
  if named {
  } else {
    let assembled = assemble_reason(report: report_window, capacity: report_room, reason: 1_u8);
    match publish_all(factory: files, output: err, source: report_window, length: assembled) {
      Ok(value: published) => {
      }
      Err(error: problem) => {
      }
    }
    return exit_status(code: 1_u8);
  }
  let status = 0_u8;
  let filled = 0_u64;
  let file_offset = 0_u64;
  match arg_get(args: args, position: 1_u64) {
    Ok(value: text) => {
      match relative_path(value: move text) {
        Ok(value: path) => {
          match open_read(factory: files, root: cwd, path: &path) {
            Ok(value: file) => {
              let ended = 0_u8;
              loop @chunks {
                let within_scratch = filled <= 4097_u64;
                if within_scratch {
                } else {
                  set ended = 2_u8;
                  break @chunks;
                }
                let spare = 4097_u64 -wrap filled;
                let full = spare == 0_u64;
                if full {
                  break @chunks;
                }
                match read_at(factory: files, file: &file, destination: scratch_window, file_offset: file_offset, start: filled, end: 4097_u64) {
                  Ok(value: endpoint) => {
                    let received = endpoint -wrap filled;
                    set file_offset = file_offset +wrap received;
                    set filled = endpoint;
                  }
                  Err(error: read_stop_15) => {
                    match read_stop_15 {
                      ReadEnd() => {
                        set ended = 1_u8;
                      }
                      ReadFailed(error: problem) => {
                        set ended = 2_u8;
                      }
                    }
                  }
                }
                if ended != 0_u8 {
                  break @chunks;
                }
              }
              if ended == 2_u8 {
                set status = 2_u8;
              }
              close_read(factory: files, file: move file);
            }
            Err(error: problem) => {
              set status = 2_u8;
            }
          }
        }
        Err(error: rejected) => {
          set status = 2_u8;
        }
      }
    }
    Err(error: absent) => {
      set status = 1_u8;
    }
  }
  if status != 0_u8 {
    let assembled = assemble_reason(report: report_window, capacity: report_room, reason: status);
    match publish_all(factory: files, output: err, source: report_window, length: assembled) {
      Ok(value: published) => {
      }
      Err(error: problem) => {
      }
    }
    return exit_status(code: status);
  }
  let empty = filled == 0_u64;
  if empty {
    let assembled = assemble_reason(report: report_window, capacity: report_room, reason: 3_u8);
    match publish_all(factory: files, output: err, source: report_window, length: assembled) {
      Ok(value: published) => {
      }
      Err(error: problem) => {
      }
    }
    return exit_status(code: 3_u8);
  }
  let too_large = filled > 4096_u64;
  if too_large {
    let assembled = assemble_reason(report: report_window, capacity: report_room, reason: 4_u8);
    match publish_all(factory: files, output: err, source: report_window, length: assembled) {
      Ok(value: published) => {
      }
      Err(error: problem) => {
      }
    }
    return exit_status(code: 4_u8);
  }
  let stream = slots_new::<u8, 4096>();
  for @reserve_stream (
    at in 0_u64..4096_u64,
    invariant grown: stream.len == at
  ) {
    place_back(window: &stream, value: 0_u8);
  }
  let stream_window = &stream[0_u64..4096_u64];
  let copied = copy_range(destination: stream_window, at: 0_u64, source: scratch_window, from: 0_u64, to: filled);
  let decoded = slots_new::<u8, 65536>();
  for @reserve_decoded (
    at in 0_u64..65536_u64,
    invariant grown: decoded.len == at
  ) {
    place_back(window: &decoded, value: 0_u8);
  }
  let decoded_window = &decoded[0_u64..65536_u64];
  let stream_view = &stream[0_u64..filled];
  let decoded_length = 0_u64;
  match inflate(out: decoded_window, input: stream_view) {
    Ok(value: produced) => {
      set decoded_length = produced;
    }
    Err(error: failure) => {
      set status = inflate_status(error: failure);
    }
  }
  if status != 0_u8 {
    let assembled = assemble_reason(report: report_window, capacity: report_room, reason: status);
    match publish_all(factory: files, output: err, source: report_window, length: assembled) {
      Ok(value: published) => {
      }
      Err(error: problem) => {
      }
    }
    return exit_status(code: status);
  }
  let decoded_room = 65536_u64;
  let decoded_fits = decoded_length <= decoded_room;
  if decoded_fits {
  } else {
    let assembled = assemble_reason(report: report_window, capacity: report_room, reason: 7_u8);
    match publish_all(factory: files, output: err, source: report_window, length: assembled) {
      Ok(value: published) => {
      }
      Err(error: problem) => {
      }
    }
    return exit_status(code: 7_u8);
  }
  match publish_all(factory: files, output: out, source: decoded_window, length: decoded_length) {
    Ok(value: published) => {
    }
    Err(error: problem) => {
      set status = 8_u8;
    }
  }
  if status != 0_u8 {
    let assembled = assemble_reason(report: report_window, capacity: report_room, reason: status);
    match publish_all(factory: files, output: err, source: report_window, length: assembled) {
      Ok(value: published) => {
      }
      Err(error: problem) => {
      }
    }
    return exit_status(code: status);
  }
  return exit_status(code: 0_u8);
}

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "PRE-1 ordinary Inputs are destructured once; the borrowed operation chain returns before the initial directory is explicitly closed on every exit.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: files, stdin: unused_stdin) = move inputs;
  let outcome = exercise(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return move outcome;
}
