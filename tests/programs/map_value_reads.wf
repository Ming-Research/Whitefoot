const key_bytes: Array<u8, 2> =[97_u8, 98_u8];

fn main() -> status: std::process::ExitStatus pure waits {
  doc "Whole-map value reads, each a statement that also counts the map and so holds it whole, release a present entry before the next read or keyed update, and an absent entry stays absent.";
  let table = map_new::<u64>(capacity: 2_u64);
  let map = shared_new::<ConcurrentHashMap<u64>>(value: move table);
  let present_key = &key_bytes[0_u64..1_u64];
  let absent_key = &key_bytes[1_u64..2_u64];
  atomic t = &map {
    set t^[present_key] = Some<u64>(value: 17_u64);
  }
  let first = None<u64>();
  let counted = 0_u64;
  atomic t = &map {
    let copied = t^[present_key];
    set first = copied;
    set counted = map_count::<u64>(map: t);
  }
  if counted != 1_u64 {
    return std::process::exit_status(code: 8_u8);
  }
  let second = None<u64>();
  atomic t = &map {
    set second = t^[present_key];
    set counted = map_count::<u64>(map: t);
  }
  match first {
    Some(value: found) => {
      if found != 17_u64 {
        return std::process::exit_status(code: 1_u8);
      }
    }
    None() => {
      return std::process::exit_status(code: 2_u8);
    }
  }
  match second {
    Some(value: found) => {
      if found != 17_u64 {
        return std::process::exit_status(code: 3_u8);
      }
    }
    None() => {
      return std::process::exit_status(code: 4_u8);
    }
  }
  atomic t = &map {
    set t^[present_key] = Some<u64>(value: 23_u64);
  }
  let updated = None<u64>();
  atomic t = &map {
    set updated = t^[present_key];
    set counted = map_count::<u64>(map: t);
  }
  match updated {
    Some(value: found) => {
      if found != 23_u64 {
        return std::process::exit_status(code: 5_u8);
      }
    }
    None() => {
      return std::process::exit_status(code: 6_u8);
    }
  }
  let missing = Some<u64>(value: 99_u64);
  atomic t = &map {
    set missing = t^[absent_key];
    set counted = map_count::<u64>(map: t);
  }
  match missing {
    Some(value: unexpected) => {
      return std::process::exit_status(code: 7_u8);
    }
    None() => {
    }
  }
  return std::process::exit_status(code: 0_u8);
}
