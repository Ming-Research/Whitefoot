alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy enum Cell<T> {
  EmptyCell();
  Filled(value: T);
}

struct OptVec {
  buf: Slots<Cell<u32>, 4>;
  fill: u64;
}

fn vacant<T: drop, const n: u64>() -> result: Slots<Cell<T>, n> pure contract {
  ensures result.len >= n;
  ensures result.cap <= result.len;
} {
  doc "Builds a window of n slots, every one holding None.";
  let built = slots_new::<Cell<T>, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: built.len == at
  ) {
    let empty = Cell<T>::EmptyCell();
    place_back(window: &built, value: move empty);
  }
  return move built;
}

fn optvec_new() -> result: OptVec pure {
  let empty = vacant::<u32, 4>();
  return OptVec(buf: move empty, fill: 0_u64);
}

fn optvec_push(v: OptVec, x: u32) -> result: OptVec pure {
  doc "A by-value parameter carries no effect entry [EFF-1], so the container is taken by value and handed back. The element exchange is the built-in swap, which needs no hole [OP-11, WIN-3].";
  let count = v.fill;
  let limit = v.buf.len;
  let has_room = count < limit;
  if has_room {
  } else {
    return move v;
  }
  let filled = Cell<u32>::Filled(value: x);
  swap(first: &v.buf[count], second: &filled);
  match filled {
    EmptyCell() => {
    }
    Filled(value: stray) => {
      return move v;
    }
  }
  let bumped = count + 1_u64;
  set v.fill = bumped;
  return move v;
}

fn optvec_pop(v: OptVec) -> (rest: OptVec, taken: u32) pure {
  doc "The same hand-back, with the removed element beside the container.";
  let count = v.fill;
  let nonempty = count > 0_u64;
  if nonempty {
  } else {
    return move v, 0_u32;
  }
  let last = count - 1_u64;
  let limit = v.buf.len;
  let in_range = last < limit;
  if in_range {
  } else {
    return move v, 0_u32;
  }
  let hole = Cell<u32>::EmptyCell();
  swap(first: &v.buf[last], second: &hole);
  set v.fill = last;
  match hole {
    EmptyCell() => {
      return move v, 0_u32;
    }
    Filled(value: w) => {
      return move v, w;
    }
  }
}

struct Entry {
  key: u64;
  payload: Box<u64>;
}

fn allocate_four() -> (first: Box<u64>, second: Box<u64>, replacement: Box<u64>, inserted: Box<u64>) pure {
  doc "Four heap cells. There is one heap and allocation is total, so none of the four has a refusal arm [STOR-8].";
  let one = box_new::<u64>(value: 10_u64);
  let two = box_new::<u64>(value: 20_u64);
  let three = box_new::<u64>(value: 11_u64);
  let four = box_new::<u64>(value: 30_u64);
  return move one, move two, move three, move four;
}

enum BoxSlotView {
  Occupied(key: u64, value: u64);
  Empty();
}

fn view_box_entry(stored_entry: &Option<Entry>, same: &Option<Entry>) -> result: BoxSlotView reads(stored_entry) {
  doc "Two reference arguments may name one place when both only read it: the call site admits read/read overlap [EFF-5].";
  match deref(stored_entry) {
    Some(value: present) => {
      return BoxSlotView::Occupied(key: deref(present).key, value: deref(present).payload.inner);
    }
    None() => {
      return BoxSlotView::Empty();
    }
  }
}

fn run_boxes(first: Box<u64>, second: Box<u64>, replacement: Box<u64>, inserted: Box<u64>) -> code: u8 pure {
  doc "A pool is a Slots window plus indices used as handles [OP-13]. Every exchange is the built-in swap, and every cell content is reached by the field step inner [OP-11, TYPE-9].";
  let empty0 = None<Entry>();
  let first_entry = Entry(key: 1_u64, payload: move first);
  let first_slot = Some<Entry>(value: move first_entry);
  let second_entry = Entry(key: 5_u64, payload: move second);
  let second_slot = Some<Entry>(value: move second_entry);
  let inserted_entry = Entry(key: 9_u64, payload: move inserted);
  let inserted_slot = Some<Entry>(value: move inserted_entry);
  let entries = slots_new::<Option<Entry>, 4>();
  place_back(window: &entries, value: move empty0);
  place_back(window: &entries, value: move first_slot);
  place_back(window: &entries, value: move second_slot);
  place_back(window: &entries, value: move inserted_slot);
  let states = slots_new::<u64, 4>();
  place_back(window: &states, value: 0_u64);
  place_back(window: &states, value: 1_u64);
  place_back(window: &states, value: 1_u64);
  place_back(window: &states, value: 1_u64);
  let replacement_entry = Entry(key: 5_u64, payload: move replacement);
  let replacement_slot = Some<Entry>(value: move replacement_entry);
  swap(first: &entries[2_u64], second: &replacement_slot);
  match replacement_slot {
    None() => {
      return 10_u8;
    }
    Some(value: previous_entry) => {
      let Entry(key: previous_key, payload: previous_payload) = move previous_entry;
      if previous_key == 5_u64 {
      } else {
        return 11_u8;
      }
      if previous_payload.inner == 20_u64 {
      } else {
        return 12_u8;
      }
    }
  }
  let delete_empty = None<Entry>();
  swap(first: &entries[1_u64], second: &delete_empty);
  let old_state = states[1_u64];
  set states[1_u64] = 2_u64;
  let recycled = match delete_empty {
    None() => {
      return 20_u8;
    }
    Some(value: removed_entry) => {
      let Entry(key: removed_key, payload: removed_payload) = move removed_entry;
      if removed_key == 1_u64 {
      } else {
        return 21_u8;
      }
      if removed_payload.inner == 10_u64 {
        give move removed_payload;
      }
      return 22_u8;
    }
  }
  if states[1_u64] == 2_u64 {
  } else {
    return 30_u8;
  }
  let through_first_collision = view_box_entry(stored_entry: &entries[2_u64], same: &entries[2_u64]);
  match through_first_collision {
    Empty() => {
      return 31_u8;
    }
    Occupied(key: found_five_key, value: found_five_value) => {
      if found_five_key == 5_u64 {
      } else {
        return 32_u8;
      }
      if found_five_value == 11_u64 {
      } else {
        return 33_u8;
      }
    }
  }
  let through_second_collision = view_box_entry(stored_entry: &entries[3_u64], same: &entries[3_u64]);
  match through_second_collision {
    Empty() => {
      return 34_u8;
    }
    Occupied(key: found_nine_key, value: found_nine_value) => {
      if found_nine_key == 9_u64 {
      } else {
        return 35_u8;
      }
      if found_nine_value == 30_u64 {
      } else {
        return 36_u8;
      }
    }
  }
  let reused_entry = Entry(key: 13_u64, payload: move recycled);
  let reused_slot = Some<Entry>(value: move reused_entry);
  swap(first: &entries[1_u64], second: &reused_slot);
  let tombstone_state = states[1_u64];
  set states[1_u64] = 1_u64;
  match reused_slot {
    Some(value: unexpected_tombstone_entry) => {
      return 40_u8;
    }
    None() => {
    }
  }
  let target = slots_new::<Option<Entry>, 8>();
  for @fill_target (
    at in 0_u64..8_u64,
    invariant grown_target: target.len == at
  ) {
    let target_empty = None<Entry>();
    place_back(window: &target, value: move target_empty);
  }
  let target_states = slots_new::<u64, 8>();
  for @fill_target_states (
    at in 0_u64..8_u64,
    invariant grown_target_states: target_states.len == at
  ) {
    place_back(window: &target_states, value: 0_u64);
  }
  let observe_after = 2_u64;
  let visited = 0_u64;
  let observed_prefix = False();
  for (
    at in 0_u64..4_u64,
    invariant source_full: entries.len >= 4_u64,
    invariant source_states_full: states.len >= 4_u64,
    invariant target_full: target.len >= 8_u64,
    invariant target_states_full: target_states.len >= 8_u64
  ) {
    if visited == observe_after {
      if states[2_u64] == 1_u64 {
      } else {
        return 50_u8;
      }
      let observed_prefix_source = view_box_entry(stored_entry: &entries[2_u64], same: &entries[2_u64]);
      match observed_prefix_source {
        Empty() => {
          return 51_u8;
        }
        Occupied(key: remaining_key, value: remaining_value) => {
          if remaining_key == 5_u64 {
          } else {
            return 52_u8;
          }
          if remaining_value == 11_u64 {
          } else {
            return 53_u8;
          }
        }
      }
      if target_states[5_u64] == 1_u64 {
      } else {
        return 54_u8;
      }
      let observed_prefix_target = view_box_entry(stored_entry: &target[5_u64], same: &target[5_u64]);
      match observed_prefix_target {
        Empty() => {
          return 55_u8;
        }
        Occupied(key: observed_prefix_key, value: observed_prefix_value) => {
          if observed_prefix_key == 13_u64 {
          } else {
            return 56_u8;
          }
          if observed_prefix_value == 10_u64 {
          } else {
            return 57_u8;
          }
        }
      }
      set observed_prefix = True();
    }
    if states[at] == 1_u64 {
      let source_empty = None<Entry>();
      swap(first: &entries[at], second: &source_empty);
      match source_empty {
        None() => {
          set states[at] = 0_u64;
        }
        Some(value: moved_entry) => {
          let key = moved_entry.key;
          let pending = Some<Entry>(value: move moved_entry);
          for (
            step in 0_u64..8_u64,
            invariant target_inner_full: target.len >= 8_u64,
            invariant target_states_inner_full: target_states.len >= 8_u64
          ) {
            let advanced = key +wrap step;
            let destination = advanced % 8_u64;
            if target_states[destination] == 0_u64 {
              swap(first: &target[destination], second: &pending);
              set target_states[destination] = 1_u64;
              break;
            }
          }
          match pending {
            Some(value: unplaced_entry) => {
              let unplaced = Some<Entry>(value: move unplaced_entry);
              swap(first: &entries[at], second: &unplaced);
              return 90_u8;
            }
            None() => {
              set states[at] = 0_u64;
            }
          }
        }
      }
    }
    set visited = visited +wrap 1_u64;
  }
  if observed_prefix {
  } else {
    return 55_u8;
  }
  if states[1_u64] == 0_u64 {
  } else {
    return 60_u8;
  }
  if states[2_u64] == 0_u64 {
  } else {
    return 61_u8;
  }
  if states[3_u64] == 0_u64 {
  } else {
    return 62_u8;
  }
  if target_states[1_u64] == 1_u64 {
  } else {
    return 63_u8;
  }
  if target_states[5_u64] == 1_u64 {
  } else {
    return 64_u8;
  }
  if target_states[6_u64] == 1_u64 {
  } else {
    return 65_u8;
  }
  let final_empty1 = None<Entry>();
  swap(first: &target[1_u64], second: &final_empty1);
  match final_empty1 {
    None() => {
      return 70_u8;
    }
    Some(value: final_entry9) => {
      let Entry(key: final_key9, payload: final_payload9) = move final_entry9;
      if final_key9 == 9_u64 {
      } else {
        return 71_u8;
      }
      if final_payload9.inner == 30_u64 {
      } else {
        return 72_u8;
      }
    }
  }
  let final_empty5 = None<Entry>();
  swap(first: &target[5_u64], second: &final_empty5);
  match final_empty5 {
    None() => {
      return 73_u8;
    }
    Some(value: final_entry13) => {
      let Entry(key: final_key13, payload: final_payload13) = move final_entry13;
      if final_key13 == 13_u64 {
      } else {
        return 74_u8;
      }
      if final_payload13.inner == 10_u64 {
      } else {
        return 75_u8;
      }
    }
  }
  let final_empty6 = None<Entry>();
  swap(first: &target[6_u64], second: &final_empty6);
  match final_empty6 {
    None() => {
      return 76_u8;
    }
    Some(value: final_entry5) => {
      let Entry(key: final_key5, payload: final_payload5) = move final_entry5;
      if final_key5 == 5_u64 {
      } else {
        return 77_u8;
      }
      if final_payload5.inner == 11_u64 {
        return 0_u8;
      }
      return 78_u8;
    }
  }
}

fn boxed_migration() -> code: u8 pure {
  let (box_first, box_second, box_replacement, box_inserted) = allocate_four();
  let code = run_boxes(first: move box_first, second: move box_second, replacement: move box_replacement, inserted: move box_inserted);
  return code;
}

fn main() -> status: ExitStatus pure {
  let v = optvec_new();
  set v = optvec_push(v: move v, x: 10_u32);
  set v = optvec_push(v: move v, x: 20_u32);
  set v = optvec_push(v: move v, x: 30_u32);
  let (rest, top) = optvec_pop(v: move v);
  if top == 30_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  let remaining = rest.fill;
  if remaining == 2_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let code = boxed_migration();
  if code != 0_u8 {
    return exit_status(code: code);
  }
  return exit_status(code: 0_u8);
}
