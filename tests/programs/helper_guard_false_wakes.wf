struct CountedProgress {
  written: u64;
  unrelated: u64;
  notice: Option<u64>;
}

fn counted_ready(progress: &CountedProgress, sequence: u64) -> ready: Bool reads(progress.written), reads(progress.notice) {
  let reached = progress^.written >= sequence;
  if reached {
    return True();
  }
  match progress^.notice {
    None() => {
      return False();
    }
    Some(..) => {
      return True();
    }
  }
}

fn counted_waiter(state: Shared<CountedProgress>, direct: Bool, sequence: u64) -> result: u8 pure waits {
  let observed = 0_u64;
  if direct {
    atomic progress = &state when progress^.written >= sequence {
      set observed = progress^.written;
    }
  } else {
    atomic progress = &state when counted_ready(progress: progress, sequence: sequence) {
      set observed = progress^.written;
    }
  }
  if observed != sequence {
    return 1_u8;
  }
  return 0_u8;
}

fn counted_writer(state: Shared<CountedProgress>) -> result: unit pure waits {
  for @write (index in 0_u64..8_u64) {
    atomic progress = &state {
      set progress^.unrelated = index + 1_u64;
    }
  }
  atomic progress = &state {
    set progress^.written = 1_u64;
  }
  return unit;
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  let argument_count = std::text::args_count(args: &inputs.args);
  let std::process::Inputs(cwd: directory, handles: factory, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let clear = None<u64>();
  let initial = CountedProgress(written: 0_u64, unrelated: 0_u64, notice: clear);
  let state = shared_new::<CountedProgress>(value: initial);
  let waiting = shared_share::<CountedProgress>(shared: &state);
  let writing = shared_share::<CountedProgress>(shared: &state);
  let direct = argument_count > 1_u64;
  let sequence = 1_u64;
  let waiter = spawn counted_waiter(state: move waiting, direct: direct, sequence: sequence);
  spawn counted_writer(state: move writing);
  let result = waiter;
  if result != 0_u8 {
    return std::process::exit_status(code: result);
  }
  let final_written = 0_u64;
  let final_unrelated = 0_u64;
  atomic progress = &state {
    set final_written = progress^.written;
    set final_unrelated = progress^.unrelated;
  }
  if final_written != 1_u64 {
    return std::process::exit_status(code: 2_u8);
  }
  if final_unrelated != 8_u64 {
    return std::process::exit_status(code: 3_u8);
  }
  if direct {
    return std::process::exit_status(code: 4_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
