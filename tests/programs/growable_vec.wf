alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const appended_bytes: Array<u8, 5> =[33_u8, 33_u8, 33_u8, 33_u8, 33_u8];

fn release_run(run: Box<Slots<u8>>) -> result: unit pure {
  doc "There is no release operation: an affine value is released early by moving it into a function that consumes it and ends, which frees this cell here rather than at the caller's scope exit [PROV-6, STOR-3].";
  return unit;
}

fn bs_new() -> made: Box<Slots<u8>> pure contract {
  ensures made.inner.len == 0_u64;
  ensures made.inner.cap == 0_u64;
} {
  doc "One empty byte string over a zero-capacity backing window; a runtime-capacity shape exists only as the content of a cell [TYPE-9].";
  let made = box_slots_new::<u8>(capacity: 0_u64);
  return move made;
}

fn bs_reserve(s: &Box<Slots<u8>>, total: u64) -> result: unit writes(s) contract {
  requires total >= s^.inner.cap;
  requires total <= 9223372036854775791_u64;
  ensures s^.inner.cap == total;
  ensures s^.inner.len == entry(s)^.inner.len;
} {
  doc "Grows the backing window to total slots, preserving element order. The native fixture's total bound leaves 16 descriptor bytes in the signed 64-bit allocation/address domain [STOR-6]. grow is defined on Box<Slots<T>> alone, remakes the cell's content whole, may reallocate in place, and computes its new size as [OP-9] states, so there is no superseded run to release and no refusal arm [OP-10, STOR-8].";
  grow(cell: s, capacity: total);
  return unit;
}

fn digest(run: &Box<Slots<u8>>, status: u64) -> result: u64 reads(run) {
  doc "Folds the window into one word, most significant byte first.";
  let result = status;
  let length = run^.inner.len;
  for (index in 0_u64..length) {
    let byte = run^.inner[index];
    let word = cvt::<u8, u64>(byte);
    let prefix = result *wrap 131_u64;
    set result = prefix +wrap word;
  }
  return result;
}

fn growth_trace(seed: u8, initial: u64, count: u64, limit: u64) -> result: u64 pure contract {
  requires initial >= 1_u64;
  requires initial <= count;
  requires count <= 1048576_u64;
  requires limit <= 1048576_u64;
} {
  doc "Fills one window from a byte recurrence, then either reports it as it stands or moves it into a wider one and continues the recurrence.";
  let original = box_slots_new::<u8>(capacity: initial);
  let state = seed;
  for (
    index in 0_u64..initial,
    invariant filled: original.inner.len >= index,
    invariant bound: original.inner.len <= index,
    invariant spare: original.inner.cap - original.inner.len + index >= initial
  ) {
    let product = state *wrap 73_u8;
    set state = product +wrap 41_u8;
    place_back(window: &original.inner, value: state);
  }
  if count == initial {
    return digest(run: &original, status: 1_u64);
  }
  if count > limit {
    return digest(run: &original, status: 2_u64);
  }
  let grown = box_slots_new::<u8>(capacity: count);
  for (
    index in 0_u64..initial,
    invariant filled: grown.inner.len >= index,
    invariant bound: grown.inner.len <= index,
    invariant spare: grown.inner.cap - grown.inner.len + index >= count
  ) {
    let byte = original.inner[index];
    place_back(window: &grown.inner, value: byte);
  }
  release_run(run: move original);
  for (
    index in initial..count,
    invariant filled: grown.inner.len >= index,
    invariant bound: grown.inner.len <= index,
    invariant spare: grown.inner.cap - grown.inner.len + index >= count
  ) {
    let product = state *wrap 73_u8;
    set state = product +wrap 41_u8;
    place_back(window: &grown.inner, value: state);
  }
  return digest(run: &grown, status: 1_u64);
}

fn growth_cases() -> code: u8 pure {
  doc "Three traces: one that grows, one the limit refuses to grow, and one already at its target.";
  let result = growth_trace(seed: 19_u8, initial: 16_u64, count: 32_u64, limit: 64_u64);
  if result == 0_u64 {
    return 70_u8;
  }
  if result == 8731451624484636299_u64 {
    return 70_u8;
  }
  if result != 15918187348717743889_u64 {
    return 1_u8;
  }
  let refused = growth_trace(seed: 19_u8, initial: 16_u64, count: 32_u64, limit: 16_u64);
  if refused == 0_u64 {
    return 70_u8;
  }
  if refused != 9302688228678555466_u64 {
    return 2_u8;
  }
  let retained = growth_trace(seed: 19_u8, initial: 16_u64, count: 16_u64, limit: 16_u64);
  if retained == 0_u64 {
    return 70_u8;
  }
  if retained != 9873924832872474633_u64 {
    return 3_u8;
  }
  return 0_u8;
}

fn publish_report(factory: &std::io::HandleFactory, output: &std::io::OutputStream, source: &[u8], length: u64) -> result: Result<unit, std::io::IoError> reads(source), writes(factory), writes(output) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  doc "Publishes one prefix of the report, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @publish {
    let pending = sent < length;
    if pending {
    } else {
      break @publish;
    }
    let no_deadline = None<std::time::Instant>();
    let wait_cancel = std::time::cancel_never();
    let wait_outcome = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: length, deadline: no_deadline, cancel: &wait_cancel);
    std::time::close_cancel_watch(watch: move wait_cancel);
    match wait_outcome {
      Ok(value: accepted) => {
        set sent = accepted;
      }
      Err(error: problem) => {
        return Err<unit, std::io::IoError>(error: problem);
      }
    }
  }
  return Ok<unit, std::io::IoError>(value: unit);
}

fn main(inputs: std::process::Inputs) -> status: ExitStatus pure waits {
  doc "The growth policy exercised twice: one string grown to twenty-four slots and filled with twenty bytes, and one grown to eight and filled from a const run through a range reference. The lengths and free slots each reservation leaves are published one byte each for the harness to compare.";
  let std::process::Inputs(args: unused_args, drivers: unused_driver_count, cwd: unused_cwd_directory, stdout: out, stderr: unused_stderr, handles: factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter, host_paths: unused_host_paths) = move inputs;
  let std::fs::Directory(read: unused_cwd, write: unused_cwd_write) = move unused_cwd_directory;
  std::fs::close_directory_write(factory: &factory, directory: move unused_cwd_write);
  std::fs::close_directory(factory: &factory, directory: move unused_cwd);
  let report = array_filled::<u8, 5>(value: 0_u8);
  let growth_code = growth_cases();
  if growth_code != 0_u8 {
    return exit_status(code: growth_code);
  }
  let s = bs_new();
  bs_reserve(s: &s, total: 24_u64);
  let opening = s.inner.len;
  let spare = s.inner.cap - s.inner.len;
  set report[0_u64] = cvt::<u64, u8>(opening);
  set report[1_u64] = cvt::<u64, u8>(spare);
  let b = 7_u8;
  for @seed (
    at in 0_u64..20_u64,
    invariant grown_lo: s.inner.len >= at,
    invariant grown_hi: s.inner.len <= at,
    invariant spare_left: s.inner.cap - s.inner.len + at >= 24_u64
  ) {
    place_back(window: &s.inner, value: b);
    set b = b +wrap 7_u8;
  }
  let total = s.inner.len;
  if total == 20_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let cap_now = s.inner.cap;
  set report[2_u64] = cvt::<u64, u8>(cap_now);
  let third = s.inner[3_u64];
  if third == 28_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  let observed = bs_new();
  bs_reserve(s: &observed, total: 8_u64);
  let second_opening = observed.inner.len;
  let second_spare = observed.inner.cap - observed.inner.len;
  set report[3_u64] = cvt::<u64, u8>(second_opening);
  set report[4_u64] = cvt::<u64, u8>(second_spare);
  place_back(window: &observed.inner, value: 65_u8);
  let source = &appended_bytes[0_u64..5_u64];
  for @append (
    at in 0_u64..5_u64,
    invariant held_lo: observed.inner.len >= at + 1_u64,
    invariant held_hi: observed.inner.len <= at + 1_u64,
    invariant spare_left: observed.inner.cap - observed.inner.len + at + 1_u64 >= 8_u64
  ) {
    let byte = source^[at];
    place_back(window: &observed.inner, value: byte);
  }
  let stored = observed.inner.len;
  if stored == 6_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let last = observed.inner[5_u64];
  if last == 33_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  let front = observed.inner[0_u64];
  if front == 65_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  let report_window = &report[0_u64..5_u64];
  match publish_report(factory: &factory, output: &out, source: report_window, length: 5_u64) {
    Ok(value: published) => {
    }
    Err(error: problem) => {
      return exit_status(code: 4_u8);
    }
  }
  return exit_status(code: 0_u8);
}
