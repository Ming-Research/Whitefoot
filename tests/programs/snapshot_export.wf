alias Inputs = std::process::Inputs;
alias ExitStatus = std::process::ExitStatus;
alias Job = std::snapshot::Job;
alias HandleFactory = std::io::HandleFactory;
alias OutputStream = std::io::OutputStream;

fn capture(reserve: std::snapshot::Reserve, table: &Shared<ConcurrentHashMap<u64>>, journal: &Shared<u64>) -> result: Result<Job, std::snapshot::CreateError> reads(table), reads(journal) waits {
  atomic map = &table^, cut = &journal^ {
    return std::snapshot::capture_export::<u64>(reserve: move reserve, map: map, cut: cut);
  }
}

fn collect(job: Job, factory: &HandleFactory, output: &OutputStream, publish: Bool) -> result: u8 writes(factory), writes(output) waits {
  let bytes = array_filled::<u8, 256>(value: 0_u8);
  let used = 0_u64;
  let cancel = std::time::cancel_never();
  let deadline = None<std::time::Instant>();
  loop @collect (
    invariant bounded: used <= 256_u64
  ) {
    if used < 256_u64 {
      let remaining = &bytes[used..256_u64];
      let next = std::snapshot::read(job: &job, out: remaining, deadline: deadline, cancel: &cancel);
      match next {
        Ok(value: count) => {
          if count == 0_u64 {
            break @collect;
          }
          set used = used + count;
        }
        Err(error: problem) => {
          let cleanup = std::snapshot::abort(job: move job);
          return 3_u8;
        }
      }
    } else {
      let cleanup = std::snapshot::abort(job: move job);
      return 4_u8;
    }
  }
  let outcome = std::snapshot::finish(job: move job);
  match outcome.child {
    SnapshotExportComplete(bytes: total, records: records) => {
      if total != used {
        return 5_u8;
      }
      if records != 2_u64 {
        return 6_u8;
      }
    }
    SnapshotExportFailed(error: problem) => {
      return 7_u8;
    }
    SnapshotChildExited(code: code) => {
      return 8_u8;
    }
    SnapshotChildSignalled(signal: signal) => {
      return 9_u8;
    }
    SnapshotProtocolFailed(error: problem) => {
      return 10_u8;
    }
  }
  match outcome.collection {
    SnapshotCollected(bytes: delivered) => {
      if delivered != used {
        return 11_u8;
      }
    }
    SnapshotDiscarded(delivered: delivered, discarded: discarded) => {
      return 12_u8;
    }
    SnapshotCollectionFailed(error: problem, delivered: delivered) => {
      return 13_u8;
    }
  }
  if outcome.abort_requested {
    return 14_u8;
  }
  if publish {
    let sent = 0_u64;
    let source = &bytes[0_u64..used];
    loop @publish (
      invariant sent_bound: sent <= used
    ) {
      if sent < used {
        let written = std::io::write_once(factory: factory, output: output, source: source, start: sent, end: used, deadline: deadline, cancel: &cancel);
        match written {
          Ok(value: next) => {
            if next == sent {
              return 15_u8;
            }
            set sent = next;
          }
          Err(error: problem) => {
            return 16_u8;
          }
        }
      } else {
        break @publish;
      }
    }
  }
  std::time::close_cancel_watch(watch: move cancel);
  return 0_u8;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: arguments, cwd: directory, stdout: output, handles: factory, ..) = move inputs;
  let std::fs::Directory(read: reader, write: writer) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move writer);
  std::fs::close_directory(factory: &factory, directory: move reader);
  let argument_count = std::text::args_count(args: &arguments);
  let live_control = argument_count > 1_u64;
  let table = shared_map_new::<u64>(capacity: 2_u64);
  let journal = shared_new::<u64>(value: 7_u64);
  let key_a_bytes = array_filled::<u8, 1>(value: 97_u8);
  let key_b_bytes = array_filled::<u8, 1>(value: 98_u8);
  let key_a = &key_a_bytes[0_u64..1_u64];
  let key_b = &key_b_bytes[0_u64..1_u64];
  atomic entry = &table[key_a] {
    set entry^ = Some<u64>(value: 11_u64);
  }
  atomic entry = &table[key_b] {
    set entry^ = Some<u64>(value: 22_u64);
  }
  let prepared = std::snapshot::prepare(scratch_bytes: 65536_u64, output_bytes: 4096_u64);
  match prepared {
    Ok(value: reserve) => {
      let captured = capture(reserve: move reserve, table: &table, journal: &journal);
      atomic entry = &table[key_a], sequence = &journal {
        set entry^ = Some<u64>(value: 99_u64);
        set sequence^ = 8_u64;
      }
      match captured {
        Ok(value: job) => {
          let publish = argument_count == 1_u64;
          let result = collect(job: move job, factory: &factory, output: &output, publish: publish);
          if result != 0_u8 {
            return std::process::exit_status(code: result);
          }
        }
        Err(error: problem) => {
          return std::process::exit_status(code: 2_u8);
        }
      }
    }
    Err(error: problem) => {
      return std::process::exit_status(code: 1_u8);
    }
  }
  if live_control {
    let replay_cut = shared_new::<u64>(value: 7_u64);
    let prepared = std::snapshot::prepare(scratch_bytes: 65536_u64, output_bytes: 4096_u64);
    match prepared {
      Ok(value: reserve) => {
        let captured = capture(reserve: move reserve, table: &table, journal: &replay_cut);
        match captured {
          Ok(value: job) => {
            let result = collect(job: move job, factory: &factory, output: &output, publish: True());
            return std::process::exit_status(code: result);
          }
          Err(error: problem) => {
            return std::process::exit_status(code: 2_u8);
          }
        }
      }
      Err(error: problem) => {
        return std::process::exit_status(code: 1_u8);
      }
    }
  } else {
    return std::process::exit_status(code: 0_u8);
  }
}
