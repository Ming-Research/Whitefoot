alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn vacant<T: drop, const n: u64>() -> result: Ring<Option<T>, n> pure contract {
  ensures result.len >= n;
  ensures result.cap <= result.len;
} {
  doc "Builds a window of n slots, every one holding None.";
  let built = ring_new::<Option<T>, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: built.len >= at,
    invariant bounded: built.len <= at,
    invariant spare: built.cap - built.len + at >= n
  ) {
    let empty = None<T>();
    place_back(window: &built, value: move empty);
  }
  return move built;
}

fn filled<T: copy, const n: u64>(value: T) -> result: Ring<T, n> pure contract {
  ensures result.len >= n;
  ensures result.cap <= result.len;
} {
  doc "Builds a window of n slots, every one holding a copy of value; the copy bound is what admits the bare repeated use.";
  let built = ring_new::<T, n>();
  for @fill (
    at in 0_u64..n,
    invariant grown: built.len >= at,
    invariant bounded: built.len <= at,
    invariant spare: built.cap - built.len + at >= n
  ) {
    place_back(window: &built, value: value);
  }
  return move built;
}

fn take_at<T: drop, const n: u64>(window: &Ring<T, n>, at: u64) -> taken: T writes(window) contract {
  requires at + 2_u64 <= deref(window).len;
  ensures deref(window).len + 1_u64 == deref(entry(window)).len;
} {
  doc "Removes the element at at, moving the last element into its place. The exchange is the built-in swap, which no source body could write without a hole [OP-11, WIN-3].";
  let endv = take_back(window: window);
  swap(first: &deref(window)[at], second: &endv);
  return move endv;
}

fn try_place<T: drop, const n: u64>(window: &Ring<T, n>, value: T) -> unplaced: Option<T> writes(window.next), writes(window.len) contract {
  ensures deref(window).len <= deref(entry(window)).len + 1_u64;
  ensures deref(window).len >= deref(entry(window)).len;
} {
  doc "Appends one value, handing it back when the window is full; the fullness test is the length against the written capacity, and the standing identity len + (cap - len) = cap turns it into place_back's requirement [MSR-2].";
  let held = deref(window).len;
  let fits = held < n;
  if fits {
    place_back(window: window, value: move value);
    return None<T>();
  }
  return Some<T>(value: move value);
}

fn try_take<T: drop, const n: u64>(window: &Ring<T, n>) -> taken: Option<T> writes(window.last), writes(window.len) contract {
  ensures deref(window).len <= deref(entry(window)).len;
  ensures deref(window).len + 1_u64 >= deref(entry(window)).len;
} {
  doc "Removes one value from the end, or reports that the window is empty.";
  let held = deref(window).len;
  let any = held > 0_u64;
  if any {
    let one = take_back(window: window);
    return Some<T>(value: move one);
  }
  return None<T>();
}

fn rebase<T: drop, const n: u64>(window: Ring<T, n>, spare: Ring<T, n>) -> rebased: Ring<T, n> pure contract {
  requires spare.len <= 0_u64;
  ensures rebased.len >= window.len;
  ensures rebased.len <= window.len;
} {
  doc "Moves every element of a wrapped window into a fresh one, in order, so the result does not wrap. Both operands arrive by value, so every access is rooted in local storage and the row is empty [EFF-1, EFF-2].";
  let count = window.len;
  let built = move spare;
  for @rot (
    at in 0_u64..count,
    invariant left: window.len + at >= count,
    invariant gone: window.len + at <= count,
    invariant made_lo: built.len >= at,
    invariant made_hi: built.len <= at,
    invariant spare_lo: built.cap - built.len + at >= n,
    invariant spare_hi: built.cap - built.len + at <= n
  ) {
    let one = take_front(window: &window);
    place_back(window: &built, value: move one);
  }
  return move built;
}

fn main() -> status: ExitStatus pure {
  doc "Runs all six fixed-window library functions at copy element types, then separately instantiates the transposing removal at an affine Box element type: the two constructions, the removal built on swap, the two checked boundary forms, and the drain that returns a wrapped window to its origin.";
  let slots = vacant::<u8, 4>();
  let vacant_held = slots.len;
  if vacant_held == 4_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let nested = vacant::<Option<u8>, 4>();
  let nested_held = nested.len;
  if nested_held == 4_u64 {
  } else {
    return exit_status(code: 19_u8);
  }
  let bytes = filled::<u8, 4>(value: 7_u8);
  let filled_held = bytes.len;
  if filled_held == 4_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  let wide = filled::<u64, 4>(value: 9_u64);
  let wide_first = wide[0_u64];
  if wide_first == 9_u64 {
  } else {
    return exit_status(code: 20_u8);
  }
  let first = bytes[0_u64];
  let last = bytes[3_u64];
  if first == 7_u8 {
  } else {
    return exit_status(code: 3_u8);
  }
  if last == 7_u8 {
  } else {
    return exit_status(code: 4_u8);
  }
  let three = ring_new::<Option<u8>, 4>();
  let a = Some<u8>(value: 1_u8);
  place_back(window: &three, value: a);
  let b = Some<u8>(value: 2_u8);
  place_back(window: &three, value: b);
  let c = Some<u8>(value: 3_u8);
  place_back(window: &three, value: c);
  let pulled = take_at::<Option<u8>, 4>(window: &three, at: 0_u64);
  let rest_held = three.len;
  if rest_held == 2_u64 {
  } else {
    return exit_status(code: 5_u8);
  }
  match pulled {
    Some(value: got) => {
      if got == 1_u8 {
      } else {
        return exit_status(code: 6_u8);
      }
    }
    None() => {
      return exit_status(code: 7_u8);
    }
  }
  let plain_three = ring_new::<u8, 4>();
  place_back(window: &plain_three, value: 21_u8);
  place_back(window: &plain_three, value: 22_u8);
  place_back(window: &plain_three, value: 23_u8);
  let plain_pulled = take_at::<u8, 4>(window: &plain_three, at: 0_u64);
  if plain_pulled == 21_u8 {
  } else {
    return exit_status(code: 21_u8);
  }
  let probe = None<u8>();
  let previous_probe = three[0_u64];
  set three[0_u64] = probe;
  set probe = previous_probe;
  match probe {
    Some(value: at_front) => {
      if at_front == 3_u8 {
      } else {
        return exit_status(code: 8_u8);
      }
    }
    None() => {
      return exit_status(code: 9_u8);
    }
  }
  let hole = None<u8>();
  let unplaced = try_place::<Option<u8>, 4>(window: &three, value: hole);
  let grown_held = three.len;
  if grown_held == 3_u64 {
  } else {
    return exit_status(code: 10_u8);
  }
  match unplaced {
    None() => {
    }
    Some(value: handed_back) => {
      return exit_status(code: 11_u8);
    }
  }
  let plain_unplaced = try_place::<u8, 4>(window: &plain_three, value: 24_u8);
  match plain_unplaced {
    None() => {
    }
    Some(value: plain_handed_back) => {
      return exit_status(code: 22_u8);
    }
  }
  let pulled_back = try_take::<Option<u8>, 4>(window: &three);
  let shrunk_held = three.len;
  if shrunk_held == 2_u64 {
  } else {
    return exit_status(code: 12_u8);
  }
  match pulled_back {
    Some(value: taken_back) => {
    }
    None() => {
      return exit_status(code: 13_u8);
    }
  }
  let plain_back = try_take::<u8, 4>(window: &plain_three);
  match plain_back {
    Some(value: plain_taken_back) => {
      if plain_taken_back == 24_u8 {
      } else {
        return exit_status(code: 23_u8);
      }
    }
    None() => {
      return exit_status(code: 24_u8);
    }
  }
  let s3 = ring_new::<u8, 4>();
  place_back(window: &s3, value: 11_u8);
  place_back(window: &s3, value: 12_u8);
  place_back(window: &s3, value: 13_u8);
  let dropped = take_front(window: &s3);
  place_back(window: &s3, value: 14_u8);
  let fresh = ring_new::<u8, 4>();
  let flat = rebase::<u8, 4>(window: move s3, spare: move fresh);
  let flat_held = flat.len;
  if flat_held == 3_u64 {
  } else {
    return exit_status(code: 14_u8);
  }
  let flat_head = flat.head;
  if flat_head == 0_u64 {
  } else {
    return exit_status(code: 15_u8);
  }
  let f0 = flat[0_u64];
  let f1 = flat[1_u64];
  let f2 = flat[2_u64];
  if f0 == 12_u8 {
  } else {
    return exit_status(code: 16_u8);
  }
  if f1 == 13_u8 {
  } else {
    return exit_status(code: 17_u8);
  }
  if f2 == 14_u8 {
  } else {
    return exit_status(code: 18_u8);
  }
  let r3 = ring_new::<Option<u8>, 4>();
  let r1v = Some<u8>(value: 31_u8);
  place_back(window: &r3, value: r1v);
  let r2v = Some<u8>(value: 32_u8);
  place_back(window: &r3, value: r2v);
  let r3v = Some<u8>(value: 33_u8);
  place_back(window: &r3, value: r3v);
  let ring_dropped = take_front(window: &r3);
  let r4v = Some<u8>(value: 34_u8);
  place_back(window: &r3, value: r4v);
  let ring_fresh = ring_new::<Option<u8>, 4>();
  let ring_flat = rebase::<Option<u8>, 4>(window: move r3, spare: move ring_fresh);
  let ring_head = ring_flat.head;
  if ring_head == 0_u64 {
  } else {
    return exit_status(code: 25_u8);
  }
  let ring_probe = None<u8>();
  let previous_ring_probe = ring_flat[0_u64];
  set ring_flat[0_u64] = ring_probe;
  set ring_probe = previous_ring_probe;
  match ring_probe {
    Some(value: ring_got) => {
      if ring_got == 32_u8 {
      } else {
        return exit_status(code: 26_u8);
      }
    }
    None() => {
      return exit_status(code: 27_u8);
    }
  }
  let owners = ring_new::<Box<u64>, 2>();
  let owner_first = box_new::<u64>(value: 41_u64);
  place_back(window: &owners, value: move owner_first);
  let owner_second = box_new::<u64>(value: 42_u64);
  place_back(window: &owners, value: move owner_second);
  let owner_pulled = take_at::<Box<u64>, 2>(window: &owners, at: 0_u64);
  let owner_value = owner_pulled.inner;
  if owner_value == 41_u64 {
  } else {
    return exit_status(code: 28_u8);
  }
  let survivor_value = owners[0_u64].inner;
  if survivor_value == 42_u64 {
  } else {
    return exit_status(code: 29_u8);
  }
  return exit_status(code: 0_u8);
}
