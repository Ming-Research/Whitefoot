alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn total(run: Box<Slots<u8>>) -> sum: u8 pure contract {
  requires run.inner.len >= 4_u64;
} {
  doc "Adds the run's first four bytes and takes the cell's compiler-derived release here: the boxed runtime-capacity window reaches this scope's exit, so the one heap object is freed on the return edge [STOR-1, STOR-3, TYPE-9].";
  let a = run.inner[0_u64];
  let b = run.inner[1_u64];
  let c = run.inner[2_u64];
  let d = run.inner[3_u64];
  let ab = a +wrap b;
  let cd = c +wrap d;
  let all = ab +wrap cd;
  return all;
}

fn main() -> status: ExitStatus pure {
  doc "The ambient heap hands out one cell holding a runtime-capacity window of four slots, a counted loop fills it through place_back, and a helper adds the bytes and takes the derived release. Allocation is total, so the construction has no failure arm [STOR-8, OP-13].";
  let built = box_slots_new::<u8>(capacity: 4_u64);
  for @fill (
    at in 0_u64..4_u64,
    invariant grown: built.inner.len == at
  ) {
    place_back(window: &built.inner, value: 3_u8);
  }
  invariant complete: built.inner.len >= 4_u64;
  let sum = total(run: move built);
  return exit_status(code: sum);
}
