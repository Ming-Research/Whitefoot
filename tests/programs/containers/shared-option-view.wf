alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

nocopy struct Entry {
  value: u64;
}

struct Slot {
  stored_entry: Option<Entry>;
}

fn view(stored_entry: &Option<Entry>) -> result: u64 reads(stored_entry) {
  match deref(stored_entry) {
    Some(value: present) => {
      return deref(present).value;
    }
    None() => {
      return 0_u64;
    }
  }
}

fn lookup(slots: &Slots<Slot, 1>) -> result: u64 reads(slots) contract {
  requires 1_u64 <= deref(slots).len;
} {
  let found = view(stored_entry: &deref(slots)[0_u64].stored_entry);
  return found;
}

fn main() -> status: ExitStatus pure {
  doc "Exercise a shared enum view without copying its payload. Entry is explicitly affine under OWN-1; a scalar-only struct would otherwise be copy in this version.";
  let present = Entry(value: 37_u64);
  let some = Some<Entry>(value: move present);
  let none = None<Entry>();
  let occupied = Slot(stored_entry: move some);
  let vacant = Slot(stored_entry: move none);
  let first = slots_new::<Slot, 1>();
  place_back(window: &first, value: move occupied);
  let with_value = move first;
  let second = slots_new::<Slot, 1>();
  place_back(window: &second, value: move vacant);
  let without_value = move second;
  let found = lookup(slots: &with_value);
  if found != 37_u64 {
    return exit_status(code: 1_u8);
  }
  let absent = lookup(slots: &without_value);
  if absent != 0_u64 {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
