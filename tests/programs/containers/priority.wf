alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn push(heap: &Slots<u64, 16>, value: u64) -> result: unit writes(heap) contract {
  requires 1_u64 <= deref(heap).cap - deref(heap).len;
  ensures deref(heap).len == deref(entry(heap)).len + 1_u64;
} {
  let at = deref(heap).len;
  place_back(window: heap, value: value);
  loop @rise (
    invariant live: at < deref(heap).len
  ) {
    if at == 0_u64 {
      break @rise;
    }
    let before = at - 1_u64;
    let parent = before / 2_u64;
    let lower = deref(heap)[at];
    let upper = deref(heap)[parent];
    if upper <= lower {
      break @rise;
    }
    set deref(heap)[parent] = lower;
    set deref(heap)[at] = upper;
    set at = parent;
  }
  return unit;
}

fn pop(heap: &Slots<u64, 16>) -> minimum: u64 writes(heap) contract {
  requires deref(heap).len >= 1_u64;
  ensures deref(heap).len == deref(entry(heap)).len - 1_u64;
} {
  let minimum = deref(heap)[0_u64];
  let last = take_back(window: heap);
  let count = deref(heap).len;
  if count == 0_u64 {
    return minimum;
  }
  set deref(heap)[0_u64] = last;
  let at = 0_u64;
  loop @sink (
    invariant live: at < deref(heap).len
  ) {
    let doubled = at * 2_u64;
    let left = doubled + 1_u64;
    if left >= count {
      break @sink;
    }
    let best = left;
    let right = left + 1_u64;
    if right < count {
      let left_value = deref(heap)[left];
      let right_value = deref(heap)[right];
      if right_value < left_value {
        set best = right;
      }
    }
    let lower = deref(heap)[best];
    let upper = deref(heap)[at];
    if upper <= lower {
      break @sink;
    }
    set deref(heap)[at] = lower;
    set deref(heap)[best] = upper;
    set at = best;
  }
  return minimum;
}

fn empty_heap() -> heap: Slots<u64, 16> pure contract {
  ensures heap.len == 0_u64;
} {
  let made = slots_new::<u64, 16>();
  return move made;
}

fn priority_round(seed: u64, entering: u64) -> (checksum: u64, next_state: u64) pure {
  let checksum = entering;
  let state = seed;
  let heap = empty_heap();
  for (
    index in 0_u64..16_u64,
    invariant grown: heap.len >= index,
    invariant spare: heap.cap - heap.len + index >= 16_u64
  ) {
    let product = state *wrap 6364136223846793005_u64;
    set state = product +wrap 1442695040888963407_u64;
    let value = state % 97_u64;
    push(heap: &heap, value: value);
  }
  for (
    index in 0_u64..16_u64,
    invariant remaining: heap.len + index >= 16_u64
  ) {
    let value = pop(heap: &heap);
    let product = checksum *wrap 1099511628211_u64;
    set checksum = product +wrap value;
  }
  return checksum, state;
}

fn priority_trace(seed: u64, rounds: u64) -> checksum: u64 pure {
  let checksum = 0_u64;
  let state = seed;
  for (round in 0_u64..rounds) {
    let (produced, advanced) = priority_round(seed: state, entering: checksum);
    set checksum = produced;
    set state = advanced;
  }
  return checksum;
}

fn main() -> status: ExitStatus pure {
  let heap = slots_new::<u64, 16>();
  push(heap: &heap, value: 9_u64);
  push(heap: &heap, value: 2_u64);
  push(heap: &heap, value: 7_u64);
  push(heap: &heap, value: 2_u64);
  push(heap: &heap, value: 0_u64);
  push(heap: &heap, value: 8_u64);
  push(heap: &heap, value: 1_u64);
  let v0 = pop(heap: &heap);
  let v1 = pop(heap: &heap);
  let v2 = pop(heap: &heap);
  let v3 = pop(heap: &heap);
  let v4 = pop(heap: &heap);
  let v5 = pop(heap: &heap);
  let v6 = pop(heap: &heap);
  if v0 != 0_u64 {
    return exit_status(code: 1_u8);
  }
  if v1 != 1_u64 {
    return exit_status(code: 2_u8);
  }
  if v2 != 2_u64 {
    return exit_status(code: 3_u8);
  }
  if v3 != 2_u64 {
    return exit_status(code: 4_u8);
  }
  if v4 != 7_u64 {
    return exit_status(code: 5_u8);
  }
  if v5 != 8_u64 {
    return exit_status(code: 6_u8);
  }
  if v6 != 9_u64 {
    return exit_status(code: 7_u8);
  }
  push(heap: &heap, value: 5_u64);
  let value = pop(heap: &heap);
  if value != 5_u64 {
    return exit_status(code: 8_u8);
  }
  return exit_status(code: 0_u8);
}
