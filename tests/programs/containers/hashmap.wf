alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum PutResult {
  Inserted();
  Replaced();
  Full();
}

enum SlotView {
  Occupied(key: u64, value: u64);
  Tombstone();
  Empty();
}

struct Entry {
  key: u64;
  value: u64;
}

struct Slot {
  stored_entry: Option<Entry>;
  tombstone: Bool;
}

fn vacant_slot(tombstone: Bool) -> slot: Slot pure {
  let no_entry = None<Entry>();
  return Slot(stored_entry: no_entry, tombstone: tombstone);
}

fn occupied_slot(key: u64, value: u64) -> slot: Slot pure {
  let stored_entry = Entry(key: key, value: value);
  let present = Some<Entry>(value: stored_entry);
  let clear = False();
  return Slot(stored_entry: present, tombstone: clear);
}

fn view_entry(stored_entry: &Option<Entry>, tombstone: Bool) -> view: SlotView reads(stored_entry) {
  match deref(stored_entry) {
    Some(value: present) => {
      return SlotView::Occupied(key: deref(present).key, value: deref(present).value);
    }
    None() => {
      if tombstone {
        return SlotView::Tombstone();
      }
      return SlotView::Empty();
    }
  }
}

fn empty_slots() -> slots: Slots<Slot, 8> pure contract {
  ensures slots.len == 8_u64;
} {
  let slots = slots_new::<Slot, 8>();
  let clear0 = False();
  let vacant0 = vacant_slot(tombstone: clear0);
  place_back(window: &slots, value: vacant0);
  let clear1 = False();
  let vacant1 = vacant_slot(tombstone: clear1);
  place_back(window: &slots, value: vacant1);
  let clear2 = False();
  let vacant2 = vacant_slot(tombstone: clear2);
  place_back(window: &slots, value: vacant2);
  let clear3 = False();
  let vacant3 = vacant_slot(tombstone: clear3);
  place_back(window: &slots, value: vacant3);
  let clear4 = False();
  let vacant4 = vacant_slot(tombstone: clear4);
  place_back(window: &slots, value: vacant4);
  let clear5 = False();
  let vacant5 = vacant_slot(tombstone: clear5);
  place_back(window: &slots, value: vacant5);
  let clear6 = False();
  let vacant6 = vacant_slot(tombstone: clear6);
  place_back(window: &slots, value: vacant6);
  let clear7 = False();
  let vacant7 = vacant_slot(tombstone: clear7);
  place_back(window: &slots, value: vacant7);
  return move slots;
}

fn insert(slots: &Slots<Slot, 8>, size: u64, key: u64, value: u64) -> (updated_size: u64, result: PutResult) writes(slots) contract {
  requires 8_u64 <= deref(slots).len;
  ensures deref(slots).len == deref(entry(slots)).len;
  ensures 8_u64 <= deref(slots).len;
} {
  let home = key % 8_u64;
  let first_tombstone = 8_u64;
  for (step in 0_u64..8_u64) {
    let advanced = home +wrap step;
    let at = advanced % 8_u64;
    let was_tombstone = deref(slots)[at].tombstone;
    let view = view_entry(stored_entry: &deref(slots)[at].stored_entry, tombstone: was_tombstone);
    match view {
      Occupied(key: current_key, value: current_value) => {
        if current_key == key {
          let replacement = occupied_slot(key: key, value: value);
          set deref(slots)[at] = replacement;
          return size, PutResult::Replaced();
        }
      }
      Tombstone() => {
        if first_tombstone == 8_u64 {
          set first_tombstone = at;
        }
      }
      Empty() => {
        if first_tombstone < 8_u64 {
          let replacement = occupied_slot(key: key, value: value);
          set deref(slots)[first_tombstone] = replacement;
        } else {
          let replacement = occupied_slot(key: key, value: value);
          set deref(slots)[at] = replacement;
        }
        let larger = size +wrap 1_u64;
        return larger, PutResult::Inserted();
      }
    }
  }
  if first_tombstone < 8_u64 {
    let replacement = occupied_slot(key: key, value: value);
    set deref(slots)[first_tombstone] = replacement;
    let larger = size +wrap 1_u64;
    return larger, PutResult::Inserted();
  }
  return size, PutResult::Full();
}

fn find(slots: &Slots<Slot, 8>, key: u64) -> result: Option<u64> reads(slots) contract {
  requires 8_u64 <= deref(slots).len;
} {
  let home = key % 8_u64;
  for (step in 0_u64..8_u64) {
    let advanced = home +wrap step;
    let at = advanced % 8_u64;
    let was_tombstone = deref(slots)[at].tombstone;
    let view = view_entry(stored_entry: &deref(slots)[at].stored_entry, tombstone: was_tombstone);
    match view {
      Occupied(key: current_key, value: current_value) => {
        if current_key == key {
          return Some<u64>(value: current_value);
        }
      }
      Tombstone() => {
      }
      Empty() => {
        return None<u64>();
      }
    }
  }
  return None<u64>();
}

fn remove(slots: &Slots<Slot, 8>, size: u64, key: u64) -> (updated_size: u64, removed: Option<u64>) writes(slots) contract {
  requires 8_u64 <= deref(slots).len;
  ensures deref(slots).len == deref(entry(slots)).len;
} {
  let home = key % 8_u64;
  for (step in 0_u64..8_u64) {
    let advanced = home +wrap step;
    let at = advanced % 8_u64;
    let was_tombstone = deref(slots)[at].tombstone;
    let view = view_entry(stored_entry: &deref(slots)[at].stored_entry, tombstone: was_tombstone);
    match view {
      Occupied(key: current_key, value: current_value) => {
        if current_key == key {
          let tombstone = True();
          let removed_slot = vacant_slot(tombstone: tombstone);
          set deref(slots)[at] = removed_slot;
          let smaller = size -wrap 1_u64;
          return smaller, Some<u64>(value: current_value);
        }
      }
      Tombstone() => {
      }
      Empty() => {
        return size, None<u64>();
      }
    }
  }
  return size, None<u64>();
}

fn put_code(result: PutResult) -> code: u64 pure {
  match result {
    Inserted() => {
      return 1_u64;
    }
    Replaced() => {
      return 2_u64;
    }
    Full() => {
      return 3_u64;
    }
  }
}

fn option_code(value: Option<u64>) -> code: u64 pure {
  match value {
    None() => {
      return 0_u64;
    }
    Some(value: present) => {
      return present;
    }
  }
}

fn mix(checksum: u64, value: u64) -> result: u64 pure {
  let scaled = checksum *wrap 131_u64;
  return scaled +wrap value;
}

fn map_trace(seed: u64, repetitions: u64) -> checksum: u64 pure {
  let checksum = 0_u64;
  for (round in 0_u64..repetitions) {
    let key_a = seed +wrap round;
    let key_b = key_a +wrap 8_u64;
    let key_c = key_a +wrap 16_u64;
    let key_d = key_a +wrap 24_u64;
    let missing_key = key_a +wrap 32_u64;
    let slots = empty_slots();
    let (size1, put_a) = insert(slots: &slots, size: 0_u64, key: key_a, value: 11_u64);
    let put_a_code = put_code(result: put_a);
    set checksum = mix(checksum: checksum, value: put_a_code);
    let (size2, put_b) = insert(slots: &slots, size: size1, key: key_b, value: 22_u64);
    let put_b_code = put_code(result: put_b);
    set checksum = mix(checksum: checksum, value: put_b_code);
    let (size3, put_c) = insert(slots: &slots, size: size2, key: key_c, value: 33_u64);
    let put_c_code = put_code(result: put_c);
    set checksum = mix(checksum: checksum, value: put_c_code);
    let (size4, replace_b) = insert(slots: &slots, size: size3, key: key_b, value: 44_u64);
    let replace_b_code = put_code(result: replace_b);
    set checksum = mix(checksum: checksum, value: replace_b_code);
    let found_a = find(slots: &slots, key: key_a);
    let found_a_code = option_code(value: found_a);
    set checksum = mix(checksum: checksum, value: found_a_code);
    let found_b = find(slots: &slots, key: key_b);
    let found_b_code = option_code(value: found_b);
    set checksum = mix(checksum: checksum, value: found_b_code);
    let found_c = find(slots: &slots, key: key_c);
    let found_c_code = option_code(value: found_c);
    set checksum = mix(checksum: checksum, value: found_c_code);
    let (size5, removed_a) = remove(slots: &slots, size: size4, key: key_a);
    let removed_a_code = option_code(value: removed_a);
    set checksum = mix(checksum: checksum, value: removed_a_code);
    let found_past_tombstone = find(slots: &slots, key: key_c);
    let found_past_tombstone_code = option_code(value: found_past_tombstone);
    set checksum = mix(checksum: checksum, value: found_past_tombstone_code);
    let (size6, put_d) = insert(slots: &slots, size: size5, key: key_d, value: 55_u64);
    let put_d_code = put_code(result: put_d);
    set checksum = mix(checksum: checksum, value: put_d_code);
    let (size7, removed_b) = remove(slots: &slots, size: size6, key: key_b);
    let removed_b_code = option_code(value: removed_b);
    set checksum = mix(checksum: checksum, value: removed_b_code);
    let (size8, removed_missing) = remove(slots: &slots, size: size7, key: missing_key);
    let removed_missing_code = option_code(value: removed_missing);
    set checksum = mix(checksum: checksum, value: removed_missing_code);
    let found_c_after_reuse = find(slots: &slots, key: key_c);
    let found_c_after_reuse_code = option_code(value: found_c_after_reuse);
    set checksum = mix(checksum: checksum, value: found_c_after_reuse_code);
    let found_d_after_reuse = find(slots: &slots, key: key_d);
    let found_d_after_reuse_code = option_code(value: found_d_after_reuse);
    set checksum = mix(checksum: checksum, value: found_d_after_reuse_code);
    let absent_b_after_remove = find(slots: &slots, key: key_b);
    let absent_b_after_remove_code = option_code(value: absent_b_after_remove);
    set checksum = mix(checksum: checksum, value: absent_b_after_remove_code);
    set checksum = mix(checksum: checksum, value: size8);
  }
  return checksum;
}

fn main() -> status: ExitStatus pure {
  let observed = map_trace(seed: 5_u64, repetitions: 3_u64);
  if observed == 15521492327637928880_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
