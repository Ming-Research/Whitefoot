alias HashMap = std::collections::hash_map::HashMap;
alias HashMapKey = std::collections::hash_map::HashMapKey;
alias PriorityOrder = std::collections::priority_queue::PriorityOrder;
alias PriorityQueue = std::collections::priority_queue::PriorityQueue;
alias Slab = std::collections::slab::Slab;
alias SlabHandle = std::collections::slab::SlabHandle;
alias hash_map_free = std::collections::hash_map::hash_map_free;
alias hash_map_lookup = std::collections::hash_map::hash_map_lookup;
alias hash_map_new = std::collections::hash_map::hash_map_new;
alias hash_map_put = std::collections::hash_map::hash_map_put;
alias hash_map_remove = std::collections::hash_map::hash_map_remove;
alias priority_queue_free = std::collections::priority_queue::priority_queue_free;
alias priority_queue_heapify = std::collections::priority_queue::priority_queue_heapify;
alias priority_queue_len = std::collections::priority_queue::priority_queue_len;
alias priority_queue_peek = std::collections::priority_queue::priority_queue_peek;
alias priority_queue_peek_at = std::collections::priority_queue::priority_queue_peek_at;
alias priority_queue_push_indexed = std::collections::priority_queue::priority_queue_push_indexed;
alias priority_queue_remove_at_indexed = std::collections::priority_queue::priority_queue_remove_at_indexed;
alias priority_queue_replace_at_indexed = std::collections::priority_queue::priority_queue_replace_at_indexed;
alias slab_edit = std::collections::slab::slab_edit;
alias slab_find_index = std::collections::slab::slab_find_index;
alias slab_free = std::collections::slab::slab_free;
alias slab_insert = std::collections::slab::slab_insert;
alias slab_new = std::collections::slab::slab_new;
alias slab_remove = std::collections::slab::slab_remove;
alias slab_visit = std::collections::slab::slab_visit;

struct Record<T> {
  id: u64;
  payload: T;
  id_member: Bool;
  position: u64;
}

struct RecordHandle {
  store_id: u64;
  object: SlabHandle;
}

struct RecordDue {
  deadline: u64;
  id: u64;
  handle: SlabHandle;
}

struct RecordInfo {
  id: u64;
  id_member: Bool;
  position: u64;
}

struct RecordEmpty {
}

struct RecordHash {
  modulus: u64;
}

enum RecordStatus {
  RecordDone();
  RecordAlready();
  RecordMissing();
  RecordExpired();
  RecordWrongStore();
  RecordConflict();
  RecordFull();
  RecordUnscheduled();
  RecordInvalidPosition();
  RecordBusy();
}

struct RecordReplacement<T> {
  status: RecordStatus;
  payload: T;
}

struct RecordStore<T, const ceiling: u64, const generation_limit: u64> {
  store_id: u64;
  retained: Bool;
  objects: Slab<Record<T>, ceiling, generation_limit>;
  by_id: HashMap<u64, SlabHandle, ceiling>;
  due: PriorityQueue<RecordDue, ceiling>;
  id_hash: RecordHash;
}

fn record_id_hash(env: &RecordHash, key: &u64) -> hash: u64 reads(env), reads(key) {
  let modulus = deref(env).modulus;
  if modulus == 0_u64 {
    return 0_u64;
  }
  return deref(key) % modulus;
}

fn record_id_equal(env: &RecordHash, left: &u64, right: &u64) -> equal: Bool reads(left), reads(right) {
  return deref(left) == deref(right);
}

binding RecordIdKey : HashMapKey<u64, RecordHash> {
  hash = record_id_hash;
  equal = record_id_equal;
}

fn record_due_compare(env: &RecordEmpty, left: &RecordDue, right: &RecordDue) -> order: i32 reads(left), reads(right) {
  if deref(left).deadline < deref(right).deadline {
    return -1_i32;
  }
  if deref(left).deadline > deref(right).deadline {
    return 1_i32;
  }
  if deref(left).id < deref(right).id {
    return -1_i32;
  }
  if deref(left).id > deref(right).id {
    return 1_i32;
  }
  if deref(left).handle.index < deref(right).handle.index {
    return -1_i32;
  }
  if deref(left).handle.index > deref(right).handle.index {
    return 1_i32;
  }
  if deref(left).handle.generation < deref(right).handle.generation {
    return -1_i32;
  }
  if deref(left).handle.generation > deref(right).handle.generation {
    return 1_i32;
  }
  return 0_i32;
}

binding RecordDueOrder : PriorityOrder<RecordDue, RecordEmpty> {
  compare = record_due_compare;
}

fn record_handle_equal(left: SlabHandle, right: SlabHandle) -> equal: Bool pure {
  if left.index != right.index {
    return False();
  }
  return left.generation == right.generation;
}

fn record_read_info<T>(env: &RecordEmpty, value: &Record<T>) -> result: RecordInfo reads(value.id), reads(value.id_member), reads(value.position) {
  return RecordInfo(id: deref(value).id, id_member: deref(value).id_member, position: deref(value).position);
}

fn record_set_position<T>(env: &u64, value: &Record<T>) -> result: unit reads(env), writes(value.position) {
  set deref(value).position = deref(env);
  return unit;
}

fn record_set_id_member<T>(env: &Bool, value: &Record<T>) -> result: unit reads(env), writes(value.id_member) {
  set deref(value).id_member = deref(env);
  return unit;
}

fn record_swap_payload<T>(env: &T, value: &Record<T>) -> result: unit writes(env), writes(value.payload) {
  swap(first: env, second: &deref(value).payload);
  return unit;
}

fn record_report_position<T, const ceiling: u64, const generation_limit: u64>(env: &Slab<Record<T>, ceiling, generation_limit>, value: &RecordDue, index: u64) -> result: unit reads(value.handle), writes(env.cells) {
  doc "Only a live matching generation receives a position. An old weak entry may share its slot with a replacement without writing the replacement's bookkeeping.";
  let changed = slab_edit::<Record<T>, u64, unit, fn record_set_position::<T>, ceiling, generation_limit>(slab: env, handle: deref(value).handle, env: &index);
  return unit;
}

fn record_read_handle(env: &RecordEmpty, key: &u64, value: &SlabHandle) -> result: SlabHandle reads(value) {
  return deref(value);
}

fn record_read_due(env: &RecordEmpty, value: &RecordDue) -> result: RecordDue reads(value) {
  return deref(value);
}

fn record_discard_id(env: &RecordEmpty, key: u64, value: SlabHandle) -> result: unit pure {
  return unit;
}

fn record_discard_due(env: &RecordEmpty, value: RecordDue) -> result: unit pure {
  return unit;
}

fn record_store_new<T, const ceiling: u64, const generation_limit: u64>(store_id: u64, retained: Bool, record_capacity: u64, index_capacity: u64, heap_capacity: u64, hash_modulus: u64) -> result: RecordStore<T, ceiling, generation_limit> pure contract {
  requires record_capacity <= ceiling;
  requires index_capacity <= ceiling;
  requires heap_capacity <= ceiling;
  requires heap_capacity <= 576460752303423487_u64;
} {
  doc "One application store owns each payload in a stable Slab slot. Its ID map and expiry heap hold copyable handles. Initial capacities may differ; later index growth uses the shared ceiling. RecordDue has four u64 fields, so OP-9 fixes its allocation-count limit at floor(u64::MAX / 32); allocation headers and pointer extents remain separate STOR-6 target checks. Caller-chosen store IDs distinguish cooperating instances without claiming authentication or global uniqueness.";
  let objects = slab_new::<Record<T>, ceiling, generation_limit>(capacity: record_capacity);
  let by_id = hash_map_new::<u64, SlabHandle, ceiling>(capacity: index_capacity);
  let storage = box_slots_new::<RecordDue>(capacity: heap_capacity);
  let empty = RecordEmpty();
  let due = priority_queue_heapify::<RecordDueOrder, ceiling>(storage: move storage, env: &empty);
  let id_hash = RecordHash(modulus: hash_modulus);
  return RecordStore<T, ceiling, generation_limit>(store_id: store_id, retained: retained, objects: move objects, by_id: move by_id, due: move due, id_hash: id_hash);
}

fn record_store_insert<T, const ceiling: u64, const generation_limit: u64>(store: &RecordStore<T, ceiling, generation_limit>, id: u64, payload: T) -> result: Result<RecordHandle, T> reads(store.store_id), writes(store.objects) {
  doc "Insertion creates no index membership. A later attachment or schedule refusal leaves this owner reachable through the returned handle; the application promises no atomic three-container insertion.";
  let absent = False();
  let record = Record<T>(id: id, payload: move payload, id_member: absent, position: ceiling);
  let inserted = slab_insert::<Record<T>, ceiling, generation_limit>(slab: &deref(store).objects, value: move record);
  match inserted {
    Ok(value: object) => {
      let handle = RecordHandle(store_id: deref(store).store_id, object: object);
      return Ok<RecordHandle, T>(value: handle);
    }
    Err(error: returned) => {
      let Record(id: old_id, payload: offered, id_member: old_member, position: old_position) = move returned;
      return Err<RecordHandle, T>(error: move offered);
    }
  }
}

fn record_store_info<T, const ceiling: u64, const generation_limit: u64>(store: &RecordStore<T, ceiling, generation_limit>, handle: RecordHandle) -> result: Result<RecordInfo, RecordStatus> reads(store.store_id), reads(store.objects) {
  if handle.store_id != deref(store).store_id {
    let reason = RecordStatus::RecordWrongStore();
    return Err<RecordInfo, RecordStatus>(error: reason);
  }
  let empty = RecordEmpty();
  let found = slab_visit::<Record<T>, RecordEmpty, RecordInfo, fn record_read_info::<T>, ceiling, generation_limit>(slab: &deref(store).objects, handle: handle.object, env: &empty);
  match found {
    Ok(value: info) => {
      return Ok<RecordInfo, RecordStatus>(value: info);
    }
    Err(error: missing) => {
      let reason = RecordStatus::RecordExpired();
      return Err<RecordInfo, RecordStatus>(error: reason);
    }
  }
}

fn record_store_visit<T, E, R, fn observe(env: &E, value: &Record<T>) -> result: R reads(value), writes(env), const ceiling: u64, const generation_limit: u64>(store: &RecordStore<T, ceiling, generation_limit>, handle: RecordHandle, env: &E) -> result: Result<R, RecordStatus> reads(store.store_id), reads(store.objects), writes(env) {
  if handle.store_id != deref(store).store_id {
    let reason = RecordStatus::RecordWrongStore();
    return Err<R, RecordStatus>(error: reason);
  }
  let found = slab_visit::<Record<T>, E, R, fn observe, ceiling, generation_limit>(slab: &deref(store).objects, handle: handle.object, env: env);
  match found {
    Ok(value: observed) => {
      return Ok<R, RecordStatus>(value: move observed);
    }
    Err(error: missing) => {
      let reason = RecordStatus::RecordExpired();
      return Err<R, RecordStatus>(error: reason);
    }
  }
}

fn record_store_lookup<T, const ceiling: u64, const generation_limit: u64>(store: &RecordStore<T, ceiling, generation_limit>, id: u64) -> result: Result<RecordHandle, RecordStatus> reads(store.store_id), reads(store.objects), reads(store.by_id), reads(store.id_hash) {
  let empty = RecordEmpty();
  let found = hash_map_lookup::<RecordIdKey, SlabHandle, RecordEmpty, SlabHandle, fn record_read_handle, ceiling>(map: &deref(store).by_id, key: &id, key_env: &deref(store).id_hash, visit_env: &empty);
  match found {
    Ok(value: object) => {
      let handle = RecordHandle(store_id: deref(store).store_id, object: object);
      let validated = record_store_info::<T, ceiling, generation_limit>(store: store, handle: handle);
      match validated {
        Ok(value: info) => {
          if info.id == id {
            return Ok<RecordHandle, RecordStatus>(value: handle);
          }
          let reason = RecordStatus::RecordConflict();
          return Err<RecordHandle, RecordStatus>(error: reason);
        }
        Err(error: reason) => {
          return Err<RecordHandle, RecordStatus>(error: reason);
        }
      }
    }
    Err(error: missing) => {
      let reason = RecordStatus::RecordMissing();
      return Err<RecordHandle, RecordStatus>(error: reason);
    }
  }
}

fn record_store_attach<T, const ceiling: u64, const generation_limit: u64>(store: &RecordStore<T, ceiling, generation_limit>, handle: RecordHandle) -> result: RecordStatus reads(store.store_id), reads(store.retained), reads(store.id_hash), writes(store.objects), writes(store.by_id) {
  let validated = record_store_info::<T, ceiling, generation_limit>(store: store, handle: handle);
  let info = match validated {
    Ok(value: found) => {
      give found;
    }
    Err(error: reason) => {
      return reason;
    }
  }
  if info.id_member {
    return RecordStatus::RecordAlready();
  }
  let empty = RecordEmpty();
  let old = hash_map_lookup::<RecordIdKey, SlabHandle, RecordEmpty, SlabHandle, fn record_read_handle, ceiling>(map: &deref(store).by_id, key: &info.id, key_env: &deref(store).id_hash, visit_env: &empty);
  match old {
    Ok(value: previous) => {
      let same = record_handle_equal(left: previous, right: handle.object);
      if same {
        return RecordStatus::RecordAlready();
      }
      let present = slab_find_index::<Record<T>, ceiling, generation_limit>(slab: &deref(store).objects, handle: previous);
      match present {
        Ok(value: index) => {
          return RecordStatus::RecordConflict();
        }
        Err(error: expired) => {
          if deref(store).retained {
            return RecordStatus::RecordConflict();
          }
        }
      }
    }
    Err(error: missing) => {
    }
  }
  let inserted = hash_map_put::<RecordIdKey, SlabHandle, ceiling>(map: &deref(store).by_id, key: info.id, value: handle.object, env: &deref(store).id_hash);
  match inserted {
    HashMapInserted() => {
    }
    HashMapReturned(reason: returned_reason, pair: returned_pair) => {
      match returned_reason {
        HashMapReplaced() => {
        }
        HashMapFull() => {
          return RecordStatus::RecordFull();
        }
      }
    }
  }
  let member = True();
  let changed = slab_edit::<Record<T>, Bool, unit, fn record_set_id_member::<T>, ceiling, generation_limit>(slab: &deref(store).objects, handle: handle.object, env: &member);
  match changed {
    Ok(value: done) => {
      return RecordStatus::RecordDone();
    }
    Err(error: expired) => {
      return RecordStatus::RecordExpired();
    }
  }
}

fn record_store_detach<T, const ceiling: u64, const generation_limit: u64>(store: &RecordStore<T, ceiling, generation_limit>, id: u64, handle: RecordHandle) -> result: RecordStatus reads(store.store_id), reads(store.id_hash), writes(store.objects), writes(store.by_id) {
  doc "The explicit ID lets a weak caller retire an association after its object expires. A same-ID replacement is protected by comparing the full stored handle before removal.";
  if handle.store_id != deref(store).store_id {
    return RecordStatus::RecordWrongStore();
  }
  let empty = RecordEmpty();
  let found = hash_map_lookup::<RecordIdKey, SlabHandle, RecordEmpty, SlabHandle, fn record_read_handle, ceiling>(map: &deref(store).by_id, key: &id, key_env: &deref(store).id_hash, visit_env: &empty);
  match found {
    Ok(value: stored) => {
      let same = record_handle_equal(left: stored, right: handle.object);
      if same {
        let removed = hash_map_remove::<RecordIdKey, SlabHandle, ceiling>(map: &deref(store).by_id, key: &id, env: &deref(store).id_hash);
        match removed {
          Some(value: pair) => {
            let absent = False();
            let changed = slab_edit::<Record<T>, Bool, unit, fn record_set_id_member::<T>, ceiling, generation_limit>(slab: &deref(store).objects, handle: handle.object, env: &absent);
            return RecordStatus::RecordDone();
          }
          None() => {
            return RecordStatus::RecordMissing();
          }
        }
      }
      return RecordStatus::RecordConflict();
    }
    Err(error: missing) => {
      return RecordStatus::RecordMissing();
    }
  }
}

fn record_store_position<T, const ceiling: u64, const generation_limit: u64>(store: &RecordStore<T, ceiling, generation_limit>, handle: RecordHandle) -> result: Result<u64, RecordStatus> reads(store.store_id), reads(store.objects), reads(store.due.storage) contract {
  ensures when Ok(value: index): index < deref(store).due.storage.inner.len;
} {
  doc "A saved position is a hint until its current bound and complete entry identity have both been checked. An in-bounds position left by another removal cannot authorize changing that other record.";
  let validated = record_store_info::<T, ceiling, generation_limit>(store: store, handle: handle);
  let info = match validated {
    Ok(value: found) => {
      give found;
    }
    Err(error: reason) => {
      return Err<u64, RecordStatus>(error: reason);
    }
  }
  if info.position == ceiling {
    let reason = RecordStatus::RecordUnscheduled();
    return Err<u64, RecordStatus>(error: reason);
  }
  let length = priority_queue_len::<RecordDue, ceiling>(queue: &deref(store).due);
  if info.position < length {
    let empty = RecordEmpty();
    let due_item = priority_queue_peek_at::<RecordDue, RecordEmpty, RecordDue, fn record_read_due, ceiling>(queue: &deref(store).due, index: info.position, env: &empty);
    let same = record_handle_equal(left: due_item.handle, right: handle.object);
    if same {
      if due_item.id == info.id {
        return Ok<u64, RecordStatus>(value: info.position);
      }
    }
  }
  let reason = RecordStatus::RecordInvalidPosition();
  return Err<u64, RecordStatus>(error: reason);
}

fn record_store_schedule<T, const ceiling: u64, const generation_limit: u64>(store: &RecordStore<T, ceiling, generation_limit>, handle: RecordHandle, deadline: u64) -> result: RecordStatus reads(store.store_id), writes(store.objects), writes(store.due.storage) {
  let validated = record_store_info::<T, ceiling, generation_limit>(store: store, handle: handle);
  let info = match validated {
    Ok(value: found) => {
      give found;
    }
    Err(error: reason) => {
      return reason;
    }
  }
  if info.position != ceiling {
    let member = record_store_position::<T, ceiling, generation_limit>(store: store, handle: handle);
    match member {
      Ok(value: position) => {
        return RecordStatus::RecordAlready();
      }
      Err(error: reason) => {
        return reason;
      }
    }
  }
  let due_item = RecordDue(deadline: deadline, id: info.id, handle: handle.object);
  let empty = RecordEmpty();
  let pushed = priority_queue_push_indexed::<RecordDueOrder, Slab<Record<T>, ceiling, generation_limit>, fn record_report_position::<T, ceiling, generation_limit>, ceiling>(queue: &deref(store).due, value: due_item, order_env: &empty, position_env: &deref(store).objects);
  match pushed {
    Ok(value: done) => {
      return RecordStatus::RecordDone();
    }
    Err(error: returned) => {
      return RecordStatus::RecordFull();
    }
  }
}

fn record_store_reschedule<T, const ceiling: u64, const generation_limit: u64>(store: &RecordStore<T, ceiling, generation_limit>, handle: RecordHandle, deadline: u64) -> result: RecordStatus reads(store.store_id), writes(store.objects), writes(store.due.storage) {
  let validated = record_store_position::<T, ceiling, generation_limit>(store: store, handle: handle);
  let position = match validated {
    Ok(value: index) => {
      give index;
    }
    Err(error: reason) => {
      return reason;
    }
  }
  let empty = RecordEmpty();
  let due_item = priority_queue_peek_at::<RecordDue, RecordEmpty, RecordDue, fn record_read_due, ceiling>(queue: &deref(store).due, index: position, env: &empty);
  let replacement = RecordDue(deadline: deadline, id: due_item.id, handle: due_item.handle);
  let previous = priority_queue_replace_at_indexed::<RecordDueOrder, Slab<Record<T>, ceiling, generation_limit>, fn record_report_position::<T, ceiling, generation_limit>, ceiling>(queue: &deref(store).due, index: position, value: replacement, order_env: &empty, position_env: &deref(store).objects);
  return RecordStatus::RecordDone();
}

fn record_store_cancel<T, const ceiling: u64, const generation_limit: u64>(store: &RecordStore<T, ceiling, generation_limit>, handle: RecordHandle) -> result: RecordStatus reads(store.store_id), writes(store.objects), writes(store.due.storage) {
  let validated = record_store_position::<T, ceiling, generation_limit>(store: store, handle: handle);
  let position = match validated {
    Ok(value: index) => {
      give index;
    }
    Err(error: reason) => {
      return reason;
    }
  }
  let empty = RecordEmpty();
  let removed = priority_queue_remove_at_indexed::<RecordDueOrder, Slab<Record<T>, ceiling, generation_limit>, fn record_report_position::<T, ceiling, generation_limit>, ceiling>(queue: &deref(store).due, index: position, order_env: &empty, position_env: &deref(store).objects);
  let absent = ceiling;
  let cleared = slab_edit::<Record<T>, u64, unit, fn record_set_position::<T>, ceiling, generation_limit>(slab: &deref(store).objects, handle: handle.object, env: &absent);
  match cleared {
    Ok(value: done) => {
      return RecordStatus::RecordDone();
    }
    Err(error: expired) => {
      return RecordStatus::RecordExpired();
    }
  }
}

fn record_store_replace<T, const ceiling: u64, const generation_limit: u64>(store: &RecordStore<T, ceiling, generation_limit>, id: u64, payload: T) -> result: RecordReplacement<T> reads(store.store_id), reads(store.by_id), reads(store.id_hash), writes(store.objects) {
  doc "The result holds one owner: the previous payload after success, or the offered payload on a miss. Replacement preserves record ID, generation and memberships.";
  let found = record_store_lookup::<T, ceiling, generation_limit>(store: store, id: id);
  let handle = match found {
    Ok(value: present) => {
      give present;
    }
    Err(error: reason) => {
      return RecordReplacement<T>(status: reason, payload: move payload);
    }
  }
  let changed = slab_edit::<Record<T>, T, unit, fn record_swap_payload::<T>, ceiling, generation_limit>(slab: &deref(store).objects, handle: handle.object, env: &payload);
  match changed {
    Ok(value: done) => {
      let status = RecordStatus::RecordDone();
      return RecordReplacement<T>(status: status, payload: move payload);
    }
    Err(error: expired) => {
      let status = RecordStatus::RecordExpired();
      return RecordReplacement<T>(status: status, payload: move payload);
    }
  }
}

fn record_store_delete<T, const ceiling: u64, const generation_limit: u64>(store: &RecordStore<T, ceiling, generation_limit>, handle: RecordHandle) -> result: Result<Record<T>, RecordStatus> reads(store.store_id), reads(store.retained), writes(store.objects) {
  let validated = record_store_info::<T, ceiling, generation_limit>(store: store, handle: handle);
  let info = match validated {
    Ok(value: found) => {
      give found;
    }
    Err(error: reason) => {
      return Err<Record<T>, RecordStatus>(error: reason);
    }
  }
  if deref(store).retained {
    if info.id_member {
      let reason = RecordStatus::RecordBusy();
      return Err<Record<T>, RecordStatus>(error: reason);
    }
    if info.position != ceiling {
      let reason = RecordStatus::RecordBusy();
      return Err<Record<T>, RecordStatus>(error: reason);
    }
  }
  let removed = slab_remove::<Record<T>, ceiling, generation_limit>(slab: &deref(store).objects, handle: handle.object);
  match removed {
    Some(value: owner) => {
      return Ok<Record<T>, RecordStatus>(value: move owner);
    }
    None() => {
      let reason = RecordStatus::RecordExpired();
      return Err<Record<T>, RecordStatus>(error: reason);
    }
  }
}

fn record_store_expire<T, E, fn consume(env: &E, value: Record<T>) -> result: unit writes(env), const ceiling: u64, const generation_limit: u64>(store: &RecordStore<T, ceiling, generation_limit>, now: u64, env: &E) -> count: u64 reads(store.store_id), reads(store.retained), reads(store.id_hash), writes(store.objects), writes(store.by_id), writes(store.due.storage), writes(env) {
  doc "Due entries leave the heap in deadline order. Old generations consume no replacement payload and cannot detach a replacement's ID mapping. The live target's memberships retire before deletion; each returned owner reaches the callback once.";
  let count = 0_u64;
  let empty = RecordEmpty();
  loop @expire {
    let length = priority_queue_len::<RecordDue, ceiling>(queue: &deref(store).due);
    if length == 0_u64 {
      break @expire;
    }
    let first = priority_queue_peek::<RecordDue, RecordEmpty, RecordDue, fn record_read_due, ceiling>(queue: &deref(store).due, env: &empty);
    if first.deadline > now {
      break @expire;
    }
    let removed = priority_queue_remove_at_indexed::<RecordDueOrder, Slab<Record<T>, ceiling, generation_limit>, fn record_report_position::<T, ceiling, generation_limit>, ceiling>(queue: &deref(store).due, index: 0_u64, order_env: &empty, position_env: &deref(store).objects);
    let absent = ceiling;
    let cleared = slab_edit::<Record<T>, u64, unit, fn record_set_position::<T>, ceiling, generation_limit>(slab: &deref(store).objects, handle: removed.handle, env: &absent);
    let handle = RecordHandle(store_id: deref(store).store_id, object: removed.handle);
    let detached = record_store_detach::<T, ceiling, generation_limit>(store: store, id: removed.id, handle: handle);
    let deleted = record_store_delete::<T, ceiling, generation_limit>(store: store, handle: handle);
    match deleted {
      Ok(value: owner) => {
        consume(env: env, value: move owner);
        set count = count +wrap 1_u64;
      }
      Err(error: reason) => {
      }
    }
  }
  return count;
}

fn record_store_free<T, E, fn consume(env: &E, value: Record<T>) -> result: unit writes(env), const ceiling: u64, const generation_limit: u64>(store: RecordStore<T, ceiling, generation_limit>, env: &E) -> result: unit writes(env) {
  doc "Index owners retire before any remaining payload reaches final consumption. Both membership policies use this consuming boundary; no externally retained reference or ticket is claimed.";
  let RecordStore(store_id: old_store_id, retained: old_policy, objects: objects, by_id: by_id, due: due, id_hash: old_hash) = move store;
  let empty = RecordEmpty();
  hash_map_free::<u64, SlabHandle, RecordEmpty, fn record_discard_id, ceiling>(map: move by_id, env: &empty);
  priority_queue_free::<RecordDue, RecordEmpty, fn record_discard_due, ceiling>(queue: move due, env: &empty);
  slab_free::<Record<T>, E, fn consume, ceiling, generation_limit>(slab: move objects, env: env);
  return unit;
}
