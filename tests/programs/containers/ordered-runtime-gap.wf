alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum RuntimeGapNode {
  Empty();
  Entry(left: Box<RuntimeGapNode>, right: Box<RuntimeGapNode>);
}

fn boxed_empty() -> made: Box<RuntimeGapNode> pure {
  let empty = RuntimeGapNode::Empty();
  let cell = box_new::<RuntimeGapNode>(value: move empty);
  return move cell;
}

fn insert_once(tree: &Box<RuntimeGapNode>) -> inserted: Bool writes(tree) {
  doc "Minimal valid-source trigger: allocate a replacement recursive node and commit it over the caller's cell, so the ordinary assignment releases the displaced Empty cell and scope exit releases the resulting tree.";
  match deref(tree).inner {
    Empty() => {
      let left_child = boxed_empty();
      let right_child = boxed_empty();
      let stored_entry = RuntimeGapNode::Entry(left: move left_child, right: move right_child);
      let replacement = box_new::<RuntimeGapNode>(value: move stored_entry);
      set deref(tree) = move replacement;
      return True();
    }
    Entry(left: existing_left, right: existing_right) => {
      return True();
    }
  }
}

fn main() -> status: ExitStatus pure {
  doc "Expected success is exit 0; allocation is total, so there is no refusal path to report.";
  let root = boxed_empty();
  let inserted = insert_once(tree: &root);
  if inserted {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 70_u8);
}
