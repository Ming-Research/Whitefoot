alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Entry {
  payload: Box<u64>;
}

fn build(first: Box<u64>, replacement: Box<u64>) -> (slots: Slots<Option<Entry>, 1>, returned: Box<u64>) pure contract {
  ensures slots.len == 1_u64;
} {
  let stored_entry = Entry(payload: move first);
  let occupied = Some<Entry>(value: move stored_entry);
  let slots = slots_new::<Option<Entry>, 1>();
  place_back(window: &slots, value: move occupied);
  return move slots, move replacement;
}

fn replace_one(slots: &Slots<Option<Entry>, 1>, replacement: Entry) -> previous: Option<Entry> writes(slots) contract {
  requires 1_u64 <= deref(slots).len;
  ensures deref(slots).len == deref(entry(slots)).len;
} {
  doc "The exchange is swap: the offered occupant goes into the slot and the binding comes back holding the slot's previous value, with no hole at any program point.";
  let offered = Some<Entry>(value: move replacement);
  swap(first: &deref(slots)[0_u64], second: &offered);
  return move offered;
}

fn compose(first: Box<u64>, replacement: Box<u64>) -> (updated: Slots<Option<Entry>, 1>, previous: Option<Entry>) pure contract {
  ensures updated.len == 1_u64;
} {
  let (slots, returned) = build(first: move first, replacement: move replacement);
  let stored_entry = Entry(payload: move returned);
  let previous = replace_one(slots: &slots, replacement: move stored_entry);
  return move slots, move previous;
}

fn main() -> status: ExitStatus pure {
  doc "Allocation is total, so the cells are built without a failure arm and the program either reports the observed contents or exits zero.";
  let first = box_new::<u64>(value: 11_u64);
  let replacement = box_new::<u64>(value: 22_u64);
  let (updated, previous) = compose(first: move first, replacement: move replacement);
  match move previous {
    None() => {
      return exit_status(code: 1_u8);
    }
    Some(value: old_entry) => {
      if old_entry.payload.inner != 11_u64 {
        return exit_status(code: 2_u8);
      }
    }
  }
  let occupied = take_back(window: &updated);
  let empty = move updated;
  match move occupied {
    None() => {
      return exit_status(code: 4_u8);
    }
    Some(value: new_entry) => {
      if new_entry.payload.inner != 22_u64 {
        return exit_status(code: 5_u8);
      }
    }
  }
  return exit_status(code: 0_u8);
}
