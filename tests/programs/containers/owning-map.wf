alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Slot {
  Vacant();
  Deleted();
  Occupied(key: u64, payload: Box<u64>);
}

enum Probe {
  Stop();
  Skip();
  Miss();
  Match();
}

enum PutOutcome {
  Inserted();
  Replaced(previous: Box<u64>);
  Full(offered: Box<u64>);
}

enum SearchStep {
  SearchStop();
  SearchContinue();
  Found(value: u64);
}

fn probe(slot: &Slot, key: u64) -> result: Probe reads(slot) {
  match deref(slot) {
    Vacant() => {
      return Probe::Stop();
    }
    Deleted() => {
      return Probe::Skip();
    }
    Occupied(key: present_key, payload: present_payload) => {
      if deref(present_key) == key {
        return Probe::Match();
      }
      return Probe::Miss();
    }
  }
}

fn search_step(slot: &Slot, key: u64) -> result: SearchStep reads(slot) {
  match deref(slot) {
    Vacant() => {
      return SearchStep::SearchStop();
    }
    Deleted() => {
      return SearchStep::SearchContinue();
    }
    Occupied(key: present_key, payload: present_payload) => {
      if deref(present_key) == key {
        return SearchStep::Found(value: deref(present_payload).inner);
      }
      return SearchStep::SearchContinue();
    }
  }
}

fn empty_slots() -> result: Array<Slot, 8> pure {
  doc "Eight vacant slots enter a constant-capacity window, which is then consumed into the full array the map owns.";
  let slots = slots_new::<Slot, 8>();
  let empty0 = Slot::Vacant();
  place_back(window: &slots, value: move empty0);
  let empty1 = Slot::Vacant();
  place_back(window: &slots, value: move empty1);
  let empty2 = Slot::Vacant();
  place_back(window: &slots, value: move empty2);
  let empty3 = Slot::Vacant();
  place_back(window: &slots, value: move empty3);
  let empty4 = Slot::Vacant();
  place_back(window: &slots, value: move empty4);
  let empty5 = Slot::Vacant();
  place_back(window: &slots, value: move empty5);
  let empty6 = Slot::Vacant();
  place_back(window: &slots, value: move empty6);
  let empty7 = Slot::Vacant();
  place_back(window: &slots, value: move empty7);
  let complete = slots_into_array::<Slot, 8>(values: move slots);
  return move complete;
}

fn put(slots: Array<Slot, 8>, key: u64, payload: Box<u64>) -> (updated: Array<Slot, 8>, outcome: PutOutcome) pure {
  doc "The installation is swap: the offered occupant goes into the slot and the binding comes back holding the slot's previous value.";
  let home = key % 8_u64;
  let first_deleted = 8_u64;
  for (step in 0_u64..8_u64) {
    let advanced = home +wrap step;
    let index = advanced % 8_u64;
    let action = probe(slot: &slots[index], key: key);
    match action {
      Match() => {
        let offered = Slot::Occupied(key: key, payload: move payload);
        swap(first: &slots[index], second: &offered);
        match move offered {
          Occupied(key: old_key, payload: old_payload) => {
            return move slots, PutOutcome::Replaced(previous: move old_payload);
          }
          Vacant() => {
            return move slots, PutOutcome::Inserted();
          }
          Deleted() => {
            return move slots, PutOutcome::Inserted();
          }
        }
      }
      Skip() => {
        if first_deleted == 8_u64 {
          set first_deleted = index;
        }
      }
      Stop() => {
        let destination = index;
        if first_deleted < 8_u64 {
          set destination = first_deleted;
        }
        let offered = Slot::Occupied(key: key, payload: move payload);
        swap(first: &slots[destination], second: &offered);
        match move offered {
          Vacant() => {
            return move slots, PutOutcome::Inserted();
          }
          Deleted() => {
            return move slots, PutOutcome::Inserted();
          }
          Occupied(key: old_key, payload: old_payload) => {
            return move slots, PutOutcome::Replaced(previous: move old_payload);
          }
        }
      }
      Miss() => {
      }
    }
  }
  if first_deleted < 8_u64 {
    let offered = Slot::Occupied(key: key, payload: move payload);
    swap(first: &slots[first_deleted], second: &offered);
    match move offered {
      Vacant() => {
        return move slots, PutOutcome::Inserted();
      }
      Deleted() => {
        return move slots, PutOutcome::Inserted();
      }
      Occupied(key: old_key, payload: old_payload) => {
        return move slots, PutOutcome::Replaced(previous: move old_payload);
      }
    }
  }
  return move slots, PutOutcome::Full(offered: move payload);
}

fn find(slots: &Array<Slot, 8>, key: u64) -> result: Option<u64> reads(slots) {
  let home = key % 8_u64;
  for (step in 0_u64..8_u64) {
    let advanced = home +wrap step;
    let index = advanced % 8_u64;
    let action = search_step(slot: &deref(slots)[index], key: key);
    match action {
      SearchStop() => {
        return None<u64>();
      }
      SearchContinue() => {
      }
      Found(value: present) => {
        return Some<u64>(value: present);
      }
    }
  }
  return None<u64>();
}

fn remove(slots: Array<Slot, 8>, key: u64) -> (updated: Array<Slot, 8>, removed: Option<Box<u64>>) pure {
  let home = key % 8_u64;
  for (step in 0_u64..8_u64) {
    let advanced = home +wrap step;
    let index = advanced % 8_u64;
    let action = probe(slot: &slots[index], key: key);
    match action {
      Stop() => {
        return move slots, None<Box<u64>>();
      }
      Skip() => {
      }
      Miss() => {
      }
      Match() => {
        let deleted = Slot::Deleted();
        swap(first: &slots[index], second: &deleted);
        match move deleted {
          Vacant() => {
            return move slots, None<Box<u64>>();
          }
          Deleted() => {
            return move slots, None<Box<u64>>();
          }
          Occupied(key: old_key, payload: old_payload) => {
            return move slots, Some<Box<u64>>(value: move old_payload);
          }
        }
      }
    }
  }
  return move slots, None<Box<u64>>();
}

fn allocate_put(slots: Array<Slot, 8>, key: u64, value: u64) -> (updated: Array<Slot, 8>, outcome: PutOutcome) pure {
  doc "Allocation is total, so the owner is built without a failure arm and every put carries one cell.";
  let offered = box_new::<u64>(value: value);
  let (updated, outcome) = put(slots: move slots, key: key, payload: move offered);
  return move updated, move outcome;
}

fn check_put(outcome: PutOutcome, kind: u64, expected: u64) -> code: u8 pure {
  match move outcome {
    Inserted() => {
      if kind != 1_u64 {
        return 1_u8;
      }
      return 0_u8;
    }
    Replaced(previous: old) => {
      if kind != 2_u64 {
        return 2_u8;
      }
      if old.inner != expected {
        return 3_u8;
      }
      return 0_u8;
    }
    Full(offered: back) => {
      if kind != 3_u64 {
        return 4_u8;
      }
      if back.inner != expected {
        return 5_u8;
      }
      return 0_u8;
    }
  }
}

fn check_removed(removed: Option<Box<u64>>, present: Bool, expected: u64) -> code: u8 pure {
  match move removed {
    None() => {
      if present {
        return 6_u8;
      }
      return 0_u8;
    }
    Some(value: old) => {
      if bnot(present) {
        return 7_u8;
      }
      if old.inner != expected {
        return 8_u8;
      }
      return 0_u8;
    }
  }
}

fn check_found(found: Option<u64>, present: Bool, expected: u64) -> code: u8 pure {
  match found {
    None() => {
      if present {
        return 9_u8;
      }
      return 0_u8;
    }
    Some(value: observed) => {
      if bnot(present) {
        return 10_u8;
      }
      if observed != expected {
        return 11_u8;
      }
      return 0_u8;
    }
  }
}

fn exercise(seed: u64) -> code: u8 pure {
  doc "One complete map trace: insertions, a tombstone, a replacement, lookups past the tombstone, a genuinely full table, and the recycling of a removed owner into a new key.";
  let slots0 = empty_slots();
  let yes = True();
  let no = False();
  let key1 = seed +wrap 0_u64;
  let (slots1, outcome1) = allocate_put(slots: move slots0, key: key1, value: 11_u64);
  let checked1 = check_put(outcome: move outcome1, kind: 1_u64, expected: 0_u64);
  if checked1 != 0_u8 {
    return checked1;
  }
  let key2 = seed +wrap 8_u64;
  let (slots2, outcome2) = allocate_put(slots: move slots1, key: key2, value: 22_u64);
  let checked2 = check_put(outcome: move outcome2, kind: 1_u64, expected: 0_u64);
  if checked2 != 0_u8 {
    return checked2;
  }
  let key3 = seed +wrap 16_u64;
  let (slots3, outcome3) = allocate_put(slots: move slots2, key: key3, value: 33_u64);
  let checked3 = check_put(outcome: move outcome3, kind: 1_u64, expected: 0_u64);
  if checked3 != 0_u8 {
    return checked3;
  }
  let key4 = seed +wrap 0_u64;
  let (slots4, removed4) = remove(slots: move slots3, key: key4);
  let checked4 = check_removed(removed: move removed4, present: yes, expected: 11_u64);
  if checked4 != 0_u8 {
    return checked4;
  }
  let key5 = seed +wrap 16_u64;
  let (slots5, outcome5) = allocate_put(slots: move slots4, key: key5, value: 44_u64);
  let checked5 = check_put(outcome: move outcome5, kind: 2_u64, expected: 33_u64);
  if checked5 != 0_u8 {
    return checked5;
  }
  let query1 = seed +wrap 8_u64;
  let found1 = find(slots: &slots5, key: query1);
  let checked_query1 = check_found(found: found1, present: yes, expected: 22_u64);
  if checked_query1 != 0_u8 {
    return checked_query1;
  }
  let query2 = seed +wrap 16_u64;
  let found2 = find(slots: &slots5, key: query2);
  let checked_query2 = check_found(found: found2, present: yes, expected: 44_u64);
  if checked_query2 != 0_u8 {
    return checked_query2;
  }
  let query3 = seed +wrap 24_u64;
  let found3 = find(slots: &slots5, key: query3);
  let checked_query3 = check_found(found: found3, present: no, expected: 0_u64);
  if checked_query3 != 0_u8 {
    return checked_query3;
  }
  let key6 = seed +wrap 24_u64;
  let (slots6, outcome6) = allocate_put(slots: move slots5, key: key6, value: 55_u64);
  let checked6 = check_put(outcome: move outcome6, kind: 1_u64, expected: 0_u64);
  if checked6 != 0_u8 {
    return checked6;
  }
  let key7 = seed +wrap 8_u64;
  let (slots7, removed7) = remove(slots: move slots6, key: key7);
  let checked7 = check_removed(removed: move removed7, present: yes, expected: 22_u64);
  if checked7 != 0_u8 {
    return checked7;
  }
  let key8 = seed +wrap 32_u64;
  let (slots8, outcome8) = allocate_put(slots: move slots7, key: key8, value: 66_u64);
  let checked8 = check_put(outcome: move outcome8, kind: 1_u64, expected: 0_u64);
  if checked8 != 0_u8 {
    return checked8;
  }
  let key9 = seed +wrap 40_u64;
  let (slots9, outcome9) = allocate_put(slots: move slots8, key: key9, value: 100_u64);
  let checked9 = check_put(outcome: move outcome9, kind: 1_u64, expected: 0_u64);
  if checked9 != 0_u8 {
    return checked9;
  }
  let key10 = seed +wrap 48_u64;
  let (slots10, outcome10) = allocate_put(slots: move slots9, key: key10, value: 101_u64);
  let checked10 = check_put(outcome: move outcome10, kind: 1_u64, expected: 0_u64);
  if checked10 != 0_u8 {
    return checked10;
  }
  let key11 = seed +wrap 56_u64;
  let (slots11, outcome11) = allocate_put(slots: move slots10, key: key11, value: 102_u64);
  let checked11 = check_put(outcome: move outcome11, kind: 1_u64, expected: 0_u64);
  if checked11 != 0_u8 {
    return checked11;
  }
  let key12 = seed +wrap 64_u64;
  let (slots12, outcome12) = allocate_put(slots: move slots11, key: key12, value: 103_u64);
  let checked12 = check_put(outcome: move outcome12, kind: 1_u64, expected: 0_u64);
  if checked12 != 0_u8 {
    return checked12;
  }
  let key13 = seed +wrap 72_u64;
  let (slots13, outcome13) = allocate_put(slots: move slots12, key: key13, value: 104_u64);
  let checked13 = check_put(outcome: move outcome13, kind: 1_u64, expected: 0_u64);
  if checked13 != 0_u8 {
    return checked13;
  }
  let key14 = seed +wrap 80_u64;
  let (slots14, outcome14) = allocate_put(slots: move slots13, key: key14, value: 999_u64);
  let checked14 = check_put(outcome: move outcome14, kind: 3_u64, expected: 999_u64);
  if checked14 != 0_u8 {
    return checked14;
  }
  let query4 = seed +wrap 16_u64;
  let found4 = find(slots: &slots14, key: query4);
  let checked_query4 = check_found(found: found4, present: yes, expected: 44_u64);
  if checked_query4 != 0_u8 {
    return checked_query4;
  }
  let query5 = seed +wrap 24_u64;
  let found5 = find(slots: &slots14, key: query5);
  let checked_query5 = check_found(found: found5, present: yes, expected: 55_u64);
  if checked_query5 != 0_u8 {
    return checked_query5;
  }
  let query6 = seed +wrap 32_u64;
  let found6 = find(slots: &slots14, key: query6);
  let checked_query6 = check_found(found: found6, present: yes, expected: 66_u64);
  if checked_query6 != 0_u8 {
    return checked_query6;
  }
  let query7 = seed +wrap 40_u64;
  let found7 = find(slots: &slots14, key: query7);
  let checked_query7 = check_found(found: found7, present: yes, expected: 100_u64);
  if checked_query7 != 0_u8 {
    return checked_query7;
  }
  let query8 = seed +wrap 48_u64;
  let found8 = find(slots: &slots14, key: query8);
  let checked_query8 = check_found(found: found8, present: yes, expected: 101_u64);
  if checked_query8 != 0_u8 {
    return checked_query8;
  }
  let query9 = seed +wrap 56_u64;
  let found9 = find(slots: &slots14, key: query9);
  let checked_query9 = check_found(found: found9, present: yes, expected: 102_u64);
  if checked_query9 != 0_u8 {
    return checked_query9;
  }
  let query10 = seed +wrap 64_u64;
  let found10 = find(slots: &slots14, key: query10);
  let checked_query10 = check_found(found: found10, present: yes, expected: 103_u64);
  if checked_query10 != 0_u8 {
    return checked_query10;
  }
  let query11 = seed +wrap 72_u64;
  let found11 = find(slots: &slots14, key: query11);
  let checked_query11 = check_found(found: found11, present: yes, expected: 104_u64);
  if checked_query11 != 0_u8 {
    return checked_query11;
  }
  let query12 = seed +wrap 80_u64;
  let found12 = find(slots: &slots14, key: query12);
  let checked_query12 = check_found(found: found12, present: no, expected: 0_u64);
  if checked_query12 != 0_u8 {
    return checked_query12;
  }
  let key15 = seed +wrap 88_u64;
  let (slots15, removed15) = remove(slots: move slots14, key: key15);
  let checked15 = check_removed(removed: move removed15, present: no, expected: 0_u64);
  if checked15 != 0_u8 {
    return checked15;
  }
  let key16 = seed +wrap 24_u64;
  let (slots16, removed16) = remove(slots: move slots15, key: key16);
  match move removed16 {
    None() => {
      return 12_u8;
    }
    Some(value: recycled) => {
      if recycled.inner != 55_u64 {
        return 13_u8;
      }
      let key17 = seed +wrap 88_u64;
      let (slots17, outcome17) = put(slots: move slots16, key: key17, payload: move recycled);
      let checked17 = check_put(outcome: move outcome17, kind: 1_u64, expected: 0_u64);
      if checked17 != 0_u8 {
        return checked17;
      }
      let found13 = find(slots: &slots17, key: key17);
      let checked_query13 = check_found(found: found13, present: yes, expected: 55_u64);
      if checked_query13 != 0_u8 {
        return checked_query13;
      }
      let found14 = find(slots: &slots17, key: key16);
      let checked_query14 = check_found(found: found14, present: no, expected: 0_u64);
      if checked_query14 != 0_u8 {
        return checked_query14;
      }
      return 0_u8;
    }
  }
}

fn main() -> status: ExitStatus pure {
  for (seed in 0_u64..16_u64) {
    let code = exercise(seed: seed);
    if code != 0_u8 {
      return exit_status(code: code);
    }
  }
  return exit_status(code: 0_u8);
}
