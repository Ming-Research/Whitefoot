alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct LeafPair {
  low: u64;
  high: u64;
}

enum SplitResult {
  Split(separator: u64, left: Box<LeafPair>, right: Box<LeafPair>);
  Duplicate();
}

fn allocate_split(first: u64, second: u64, third: u64, fourth: u64) -> result: SplitResult pure {
  doc "Allocates both children of a B+ tree leaf split before publishing the result. Allocation is total, so neither cell has a failure arm and the result carries the two owners it built.";
  let left_leaf = LeafPair(low: first, high: second);
  let left = box_new::<LeafPair>(value: left_leaf);
  let right_leaf = LeafPair(low: third, high: fourth);
  let right = box_new::<LeafPair>(value: right_leaf);
  return SplitResult::Split(separator: third, left: move left, right: move right);
}

fn split_full_leaf(first: u64, second: u64, third: u64, candidate: u64) -> result: SplitResult pure contract {
  requires first < second;
  requires second < third;
} {
  doc "One actual ordered-node component: insert a distinct key into a full three-key B+ tree leaf, split the sorted four keys into two owning heap cells, and copy the right minimum into the separator. Duplicate input performs no allocation. This is a node primitive, not a complete ordered map or a capacity claim about one.";
  if candidate == first {
    return SplitResult::Duplicate();
  }
  if candidate == second {
    return SplitResult::Duplicate();
  }
  if candidate == third {
    return SplitResult::Duplicate();
  }
  if candidate < first {
    return allocate_split(first: candidate, second: first, third: second, fourth: third);
  }
  if candidate < second {
    return allocate_split(first: first, second: candidate, third: second, fourth: third);
  }
  if candidate < third {
    return allocate_split(first: first, second: second, third: candidate, fourth: third);
  }
  return allocate_split(first: first, second: second, third: third, fourth: candidate);
}

fn main() -> status: ExitStatus pure {
  doc "Independent expected behavior: inserting 25 into [10,20,30] yields owning leaves [10,20] and [25,30] with separator 25; inserting 5 exercises the leading position and yields [5,10] and [20,30] with separator 20; inserting duplicate 20 returns Duplicate without allocation.";
  match split_full_leaf(first: 10_u64, second: 20_u64, third: 30_u64, candidate: 25_u64) {
    Duplicate() => {
      return exit_status(code: 10_u8);
    }
    Split(separator: promoted, left: left_child, right: right_child) => {
      if promoted == 25_u64 {
      } else {
        return exit_status(code: 11_u8);
      }
      if left_child.inner.low == 10_u64 {
      } else {
        return exit_status(code: 12_u8);
      }
      if left_child.inner.high == 20_u64 {
      } else {
        return exit_status(code: 13_u8);
      }
      if right_child.inner.low == 25_u64 {
      } else {
        return exit_status(code: 14_u8);
      }
      if right_child.inner.high == 30_u64 {
      } else {
        return exit_status(code: 15_u8);
      }
    }
  }
  match split_full_leaf(first: 10_u64, second: 20_u64, third: 30_u64, candidate: 5_u64) {
    Duplicate() => {
      return exit_status(code: 20_u8);
    }
    Split(separator: leading_separator, left: leading_left, right: leading_right) => {
      if leading_separator == 20_u64 {
      } else {
        return exit_status(code: 21_u8);
      }
      if leading_left.inner.low == 5_u64 {
      } else {
        return exit_status(code: 22_u8);
      }
      if leading_left.inner.high == 10_u64 {
      } else {
        return exit_status(code: 23_u8);
      }
      if leading_right.inner.low == 20_u64 {
      } else {
        return exit_status(code: 24_u8);
      }
      if leading_right.inner.high == 30_u64 {
      } else {
        return exit_status(code: 25_u8);
      }
    }
  }
  match split_full_leaf(first: 10_u64, second: 20_u64, third: 30_u64, candidate: 20_u64) {
    Duplicate() => {
      return exit_status(code: 0_u8);
    }
    Split(separator: unexpected_separator, left: unexpected_left, right: unexpected_right) => {
      return exit_status(code: 31_u8);
    }
  }
}
