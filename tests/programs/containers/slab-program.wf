alias ExitStatus = std::process::ExitStatus;
alias Slab = std::collections::slab::Slab;
alias SlabConsume = std::collections::slab::SlabConsume;
alias SlabHandle = std::collections::slab::SlabHandle;
alias SlabVisit = std::collections::slab::SlabVisit;
alias exit_status = std::process::exit_status;
alias slab_find_index = std::collections::slab::slab_find_index;
alias slab_free = std::collections::slab::slab_free;
alias slab_insert = std::collections::slab::slab_insert;
alias slab_new = std::collections::slab::slab_new;
alias slab_remove = std::collections::slab::slab_remove;
alias slab_visit = std::collections::slab::slab_visit;

struct SlabTestSeen {
  sum: u64;
  count: u64;
  sequence: u64;
  visits: u64;
  last: u64;
}

struct SlabTestItem {
  id: u64;
}

nodrop struct SlabTestTicket {
  payload: Box<SlabTestItem>;
}

fn slab_test_record(env: &SlabTestSeen, value: u64) -> result: unit writes(env) {
  set deref(env).sum = deref(env).sum +wrap value;
  set deref(env).count = deref(env).count +wrap 1_u64;
  let prefix = deref(env).sequence *wrap 257_u64;
  set deref(env).sequence = prefix +wrap value;
  return unit;
}

fn slab_test_read_scalar(env: &SlabTestSeen, value: &u64) -> result: u64 reads(value), writes(env) {
  set deref(env).visits = deref(env).visits +wrap 1_u64;
  set deref(env).last = deref(value);
  return deref(value);
}

binding SlabTestScalarVisit : SlabVisit<u64, SlabTestSeen, u64> {
  visit = slab_test_read_scalar;
}

binding SlabTestScalarConsume : SlabConsume<u64, SlabTestSeen> {
  consume = slab_test_record;
}

fn slab_test_read_box(env: &SlabTestSeen, value: &Box<SlabTestItem>) -> result: u64 reads(value), writes(env) {
  set deref(env).visits = deref(env).visits +wrap 1_u64;
  set deref(env).last = deref(value).inner.id;
  return deref(value).inner.id;
}

fn slab_test_consume_box(env: &SlabTestSeen, value: Box<SlabTestItem>) -> result: unit writes(env) {
  slab_test_record(env: env, value: value.inner.id);
  return unit;
}

binding SlabTestBoxVisit : SlabVisit<Box<SlabTestItem>, SlabTestSeen, u64> {
  visit = slab_test_read_box;
}

binding SlabTestBoxConsume : SlabConsume<Box<SlabTestItem>, SlabTestSeen> {
  consume = slab_test_consume_box;
}

fn slab_test_ticket(id: u64) -> result: SlabTestTicket pure {
  let item = SlabTestItem(id: id);
  let payload = box_new::<SlabTestItem>(value: item);
  return SlabTestTicket(payload: move payload);
}

fn slab_test_read_ticket(env: &SlabTestSeen, value: &SlabTestTicket) -> result: u64 reads(value), writes(env) {
  set deref(env).visits = deref(env).visits +wrap 1_u64;
  set deref(env).last = deref(value).payload.inner.id;
  return deref(value).payload.inner.id;
}

fn slab_test_consume_ticket(env: &SlabTestSeen, value: SlabTestTicket) -> result: unit writes(env) {
  let SlabTestTicket(payload: payload) = move value;
  slab_test_consume_box(env: env, value: move payload);
  return unit;
}

binding SlabTestTicketVisit : SlabVisit<SlabTestTicket, SlabTestSeen, u64> {
  visit = slab_test_read_ticket;
}

binding SlabTestTicketConsume : SlabConsume<SlabTestTicket, SlabTestSeen> {
  consume = slab_test_consume_ticket;
}

fn slab_test_scalars() -> failures: u64 pure {
  doc "Checks lazy materialization, the runtime capacity below its static ceiling, returned owners on exhaustion, checked wrong handles, a returned-index bound, stale handles after reuse, and retirement at generation one.";
  let failed = 0_u64;
  let seen = SlabTestSeen(sum: 0_u64, count: 0_u64, sequence: 0_u64, visits: 0_u64, last: 0_u64);
  let slab = slab_new::<u64, 3, 1>(capacity: 2_u64);
  if slab.cells.inner.len != 0_u64 {
    set failed = failed +wrap 1_u64;
  }
  if slab.cells.inner.cap != 2_u64 {
    set failed = failed +wrap 1_u64;
  }
  let first = match slab_insert::<u64, 3, 1>(slab: &slab, value: 11_u64) {
    Ok(value: handle) => {
      give handle;
    }
    Err(error: uninserted) => {
      slab_free::<SlabTestScalarConsume, 3, 1>(slab: move slab, env: &seen);
      return 1_u64;
    }
  }
  let second = match slab_insert::<u64, 3, 1>(slab: &slab, value: 22_u64) {
    Ok(value: handle) => {
      give handle;
    }
    Err(error: uninserted) => {
      slab_free::<SlabTestScalarConsume, 3, 1>(slab: move slab, env: &seen);
      return 1_u64;
    }
  }
  if first.index != 0_u64 {
    set failed = failed +wrap 1_u64;
  }
  if first.generation != 0_u64 {
    set failed = failed +wrap 1_u64;
  }
  if second.index != 1_u64 {
    set failed = failed +wrap 1_u64;
  }
  match slab_insert::<u64, 3, 1>(slab: &slab, value: 33_u64) {
    Ok(value: unexpected) => {
      set failed = failed +wrap 1_u64;
    }
    Err(error: uninserted) => {
      if uninserted != 33_u64 {
        set failed = failed +wrap 1_u64;
      }
    }
  }
  match slab_find_index::<u64, 3, 1>(slab: &slab, handle: first) {
    Ok(value: index) => {
      invariant published_bound: index < slab.cells.inner.len;
      if slab.cells.inner[index].generation != first.generation {
        set failed = failed +wrap 1_u64;
      }
    }
    Err(error: expired) => {
      set failed = failed +wrap 1_u64;
    }
  }
  match slab_visit::<SlabTestScalarVisit, 3, 1>(slab: &slab, handle: first, env: &seen) {
    Ok(value: observed) => {
      if observed != 11_u64 {
        set failed = failed +wrap 1_u64;
      }
    }
    Err(error: expired) => {
      set failed = failed +wrap 1_u64;
    }
  }
  let wrong_index = SlabHandle(index: 18446744073709551615_u64, generation: 0_u64);
  let wrong_generation = SlabHandle(index: first.index, generation: 18446744073709551615_u64);
  match slab_visit::<SlabTestScalarVisit, 3, 1>(slab: &slab, handle: wrong_index, env: &seen) {
    Ok(value: unexpected) => {
      set failed = failed +wrap 1_u64;
    }
    Err(error: expired) => {
    }
  }
  match slab_remove::<u64, 3, 1>(slab: &slab, handle: wrong_generation) {
    Some(value: unexpected) => {
      set failed = failed +wrap 1_u64;
    }
    None() => {
    }
  }
  match slab_remove::<u64, 3, 1>(slab: &slab, handle: first) {
    Some(value: removed) => {
      if removed != 11_u64 {
        set failed = failed +wrap 1_u64;
      }
      slab_test_record(env: &seen, value: removed);
    }
    None() => {
      set failed = failed +wrap 1_u64;
    }
  }
  match slab_find_index::<u64, 3, 1>(slab: &slab, handle: first) {
    Ok(value: unexpected) => {
      set failed = failed +wrap 1_u64;
    }
    Err(error: expired) => {
    }
  }
  let reused = match slab_insert::<u64, 3, 1>(slab: &slab, value: 33_u64) {
    Ok(value: handle) => {
      give handle;
    }
    Err(error: uninserted) => {
      slab_free::<SlabTestScalarConsume, 3, 1>(slab: move slab, env: &seen);
      return 1_u64;
    }
  }
  if reused.index != first.index {
    set failed = failed +wrap 1_u64;
  }
  if reused.generation != 1_u64 {
    set failed = failed +wrap 1_u64;
  }
  match slab_remove::<u64, 3, 1>(slab: &slab, handle: first) {
    Some(value: unexpected) => {
      set failed = failed +wrap 1_u64;
    }
    None() => {
    }
  }
  match slab_remove::<u64, 3, 1>(slab: &slab, handle: reused) {
    Some(value: removed) => {
      if removed != 33_u64 {
        set failed = failed +wrap 1_u64;
      }
      slab_test_record(env: &seen, value: removed);
    }
    None() => {
      set failed = failed +wrap 1_u64;
    }
  }
  match slab_insert::<u64, 3, 1>(slab: &slab, value: 44_u64) {
    Ok(value: unexpected) => {
      set failed = failed +wrap 1_u64;
    }
    Err(error: uninserted) => {
      if uninserted != 44_u64 {
        set failed = failed +wrap 1_u64;
      }
    }
  }
  match slab_remove::<u64, 3, 1>(slab: &slab, handle: reused) {
    Some(value: unexpected) => {
      set failed = failed +wrap 1_u64;
    }
    None() => {
    }
  }
  if slab.cells.inner.len != 2_u64 {
    set failed = failed +wrap 1_u64;
  }
  slab_free::<SlabTestScalarConsume, 3, 1>(slab: move slab, env: &seen);
  if seen.sum != 66_u64 {
    set failed = failed +wrap 1_u64;
  }
  if seen.count != 3_u64 {
    set failed = failed +wrap 1_u64;
  }
  if seen.visits != 1_u64 {
    set failed = failed +wrap 1_u64;
  }
  return failed;
}

fn slab_test_zero_capacity() -> failures: u64 pure {
  let failed = 0_u64;
  let seen = SlabTestSeen(sum: 0_u64, count: 0_u64, sequence: 0_u64, visits: 0_u64, last: 0_u64);
  let slab = slab_new::<u64, 3, 0>(capacity: 0_u64);
  match slab_insert::<u64, 3, 0>(slab: &slab, value: 77_u64) {
    Ok(value: unexpected) => {
      set failed = failed +wrap 1_u64;
    }
    Err(error: uninserted) => {
      if uninserted != 77_u64 {
        set failed = failed +wrap 1_u64;
      }
    }
  }
  let absent = SlabHandle(index: 0_u64, generation: 0_u64);
  match slab_visit::<SlabTestScalarVisit, 3, 0>(slab: &slab, handle: absent, env: &seen) {
    Ok(value: unexpected) => {
      set failed = failed +wrap 1_u64;
    }
    Err(error: expired) => {
    }
  }
  match slab_remove::<u64, 3, 0>(slab: &slab, handle: absent) {
    Some(value: unexpected) => {
      set failed = failed +wrap 1_u64;
    }
    None() => {
    }
  }
  slab_free::<SlabTestScalarConsume, 3, 0>(slab: move slab, env: &seen);
  if seen.count != 0_u64 {
    set failed = failed +wrap 1_u64;
  }
  if seen.visits != 0_u64 {
    set failed = failed +wrap 1_u64;
  }
  return failed;
}

fn slab_test_boxes() -> failures: u64 pure {
  doc "A full backing keeps one payload live while two removed Box owners create a two-cell free list. Both are reinserted through that list in reverse removal order, with new generations and expired original handles. Refusal returns the fourth Box unchanged, reuse allocates nothing, and reverse-slot teardown consumes the remaining owners; the observer checks the exact allocation ledger.";
  let failed = 0_u64;
  let seen = SlabTestSeen(sum: 0_u64, count: 0_u64, sequence: 0_u64, visits: 0_u64, last: 0_u64);
  let slab = slab_new::<Box<SlabTestItem>, 4, 18446744073709551615>(capacity: 3_u64);
  for (id in 1_u64..4_u64) {
    let item_value = SlabTestItem(id: id);
    let item = box_new::<SlabTestItem>(value: item_value);
    match slab_insert::<Box<SlabTestItem>, 4, 18446744073709551615>(slab: &slab, value: move item) {
      Ok(value: handle) => {
        let expected_index = id - 1_u64;
        if handle.index != expected_index {
          set failed = failed +wrap 1_u64;
        }
        if handle.generation != 0_u64 {
          set failed = failed +wrap 1_u64;
        }
      }
      Err(error: uninserted) => {
        slab_test_consume_box(env: &seen, value: move uninserted);
        set failed = failed +wrap 1_u64;
      }
    }
  }
  let fourth_item = SlabTestItem(id: 4_u64);
  let fourth = box_new::<SlabTestItem>(value: fourth_item);
  match slab_insert::<Box<SlabTestItem>, 4, 18446744073709551615>(slab: &slab, value: move fourth) {
    Ok(value: unexpected) => {
      set failed = failed +wrap 1_u64;
    }
    Err(error: uninserted) => {
      if uninserted.inner.id != 4_u64 {
        set failed = failed +wrap 1_u64;
      }
      slab_test_consume_box(env: &seen, value: move uninserted);
    }
  }
  let first = SlabHandle(index: 0_u64, generation: 0_u64);
  let second = SlabHandle(index: 1_u64, generation: 0_u64);
  let retained = SlabHandle(index: 2_u64, generation: 0_u64);
  match slab_visit::<SlabTestBoxVisit, 4, 18446744073709551615>(slab: &slab, handle: first, env: &seen) {
    Ok(value: observed) => {
      if observed != 1_u64 {
        set failed = failed +wrap 1_u64;
      }
    }
    Err(error: expired) => {
      set failed = failed +wrap 1_u64;
    }
  }
  let removed_first = match slab_remove::<Box<SlabTestItem>, 4, 18446744073709551615>(slab: &slab, handle: first) {
    Some(value: removed) => {
      if removed.inner.id != 1_u64 {
        set failed = failed +wrap 1_u64;
      }
      give move removed;
    }
    None() => {
      slab_free::<SlabTestBoxConsume, 4, 18446744073709551615>(slab: move slab, env: &seen);
      return 1_u64;
    }
  }
  let removed_second = match slab_remove::<Box<SlabTestItem>, 4, 18446744073709551615>(slab: &slab, handle: second) {
    Some(value: removed) => {
      if removed.inner.id != 2_u64 {
        set failed = failed +wrap 1_u64;
      }
      give move removed;
    }
    None() => {
      slab_free::<SlabTestBoxConsume, 4, 18446744073709551615>(slab: move slab, env: &seen);
      return 1_u64;
    }
  }
  match slab_visit::<SlabTestBoxVisit, 4, 18446744073709551615>(slab: &slab, handle: retained, env: &seen) {
    Ok(value: observed) => {
      if observed != 3_u64 {
        set failed = failed +wrap 1_u64;
      }
    }
    Err(error: expired) => {
      set failed = failed +wrap 1_u64;
    }
  }
  let reused_first = match slab_insert::<Box<SlabTestItem>, 4, 18446744073709551615>(slab: &slab, value: move removed_first) {
    Ok(value: handle) => {
      give handle;
    }
    Err(error: uninserted) => {
      slab_test_consume_box(env: &seen, value: move uninserted);
      slab_free::<SlabTestBoxConsume, 4, 18446744073709551615>(slab: move slab, env: &seen);
      return 1_u64;
    }
  }
  let reused_second = match slab_insert::<Box<SlabTestItem>, 4, 18446744073709551615>(slab: &slab, value: move removed_second) {
    Ok(value: handle) => {
      give handle;
    }
    Err(error: uninserted) => {
      slab_test_consume_box(env: &seen, value: move uninserted);
      slab_free::<SlabTestBoxConsume, 4, 18446744073709551615>(slab: move slab, env: &seen);
      return 1_u64;
    }
  }
  if reused_first.index != second.index {
    set failed = failed +wrap 1_u64;
  }
  if reused_first.generation != 1_u64 {
    set failed = failed +wrap 1_u64;
  }
  if reused_second.index != first.index {
    set failed = failed +wrap 1_u64;
  }
  if reused_second.generation != 1_u64 {
    set failed = failed +wrap 1_u64;
  }
  match slab_find_index::<Box<SlabTestItem>, 4, 18446744073709551615>(slab: &slab, handle: first) {
    Ok(value: unexpected) => {
      set failed = failed +wrap 1_u64;
    }
    Err(error: expired) => {
    }
  }
  match slab_visit::<SlabTestBoxVisit, 4, 18446744073709551615>(slab: &slab, handle: second, env: &seen) {
    Ok(value: unexpected) => {
      set failed = failed +wrap 1_u64;
    }
    Err(error: expired) => {
    }
  }
  match slab_visit::<SlabTestBoxVisit, 4, 18446744073709551615>(slab: &slab, handle: reused_first, env: &seen) {
    Ok(value: observed) => {
      if observed != 1_u64 {
        set failed = failed +wrap 1_u64;
      }
    }
    Err(error: expired) => {
      set failed = failed +wrap 1_u64;
    }
  }
  match slab_visit::<SlabTestBoxVisit, 4, 18446744073709551615>(slab: &slab, handle: reused_second, env: &seen) {
    Ok(value: observed) => {
      if observed != 2_u64 {
        set failed = failed +wrap 1_u64;
      }
    }
    Err(error: expired) => {
      set failed = failed +wrap 1_u64;
    }
  }
  match slab_visit::<SlabTestBoxVisit, 4, 18446744073709551615>(slab: &slab, handle: retained, env: &seen) {
    Ok(value: observed) => {
      if observed != 3_u64 {
        set failed = failed +wrap 1_u64;
      }
    }
    Err(error: expired) => {
      set failed = failed +wrap 1_u64;
    }
  }
  if slab.cells.inner.len != 3_u64 {
    set failed = failed +wrap 1_u64;
  }
  slab_free::<SlabTestBoxConsume, 4, 18446744073709551615>(slab: move slab, env: &seen);
  if seen.sum != 10_u64 {
    set failed = failed +wrap 1_u64;
  }
  if seen.sequence != 68096778_u64 {
    set failed = failed +wrap 1_u64;
  }
  if seen.count != 4_u64 {
    set failed = failed +wrap 1_u64;
  }
  if seen.visits != 5_u64 {
    set failed = failed +wrap 1_u64;
  }
  return failed;
}

fn slab_test_tickets() -> failures: u64 pure {
  doc "A nodrop Box-owning payload reaches either insertion, the refusal caller, a successful removal, or the final consuming callback. Generation zero retires on the first removal, so the full retirement path is exercised without a wrap or artificial exhaustion.";
  let failed = 0_u64;
  let seen = SlabTestSeen(sum: 0_u64, count: 0_u64, sequence: 0_u64, visits: 0_u64, last: 0_u64);
  let slab = slab_new::<SlabTestTicket, 1, 0>(capacity: 1_u64);
  let first = slab_test_ticket(id: 7_u64);
  match slab_insert::<SlabTestTicket, 1, 0>(slab: &slab, value: move first) {
    Ok(value: handle) => {
    }
    Err(error: uninserted) => {
      slab_test_consume_ticket(env: &seen, value: move uninserted);
      set failed = failed +wrap 1_u64;
    }
  }
  let second = slab_test_ticket(id: 8_u64);
  match slab_insert::<SlabTestTicket, 1, 0>(slab: &slab, value: move second) {
    Ok(value: handle) => {
      set failed = failed +wrap 1_u64;
    }
    Err(error: uninserted) => {
      if uninserted.payload.inner.id != 8_u64 {
        set failed = failed +wrap 1_u64;
      }
      slab_test_consume_ticket(env: &seen, value: move uninserted);
    }
  }
  let handle = SlabHandle(index: 0_u64, generation: 0_u64);
  let wrong = SlabHandle(index: 0_u64, generation: 1_u64);
  match slab_remove::<SlabTestTicket, 1, 0>(slab: &slab, handle: wrong) {
    Some(value: unexpected) => {
      slab_test_consume_ticket(env: &seen, value: move unexpected);
      set failed = failed +wrap 1_u64;
    }
    None() => {
    }
  }
  match slab_visit::<SlabTestTicketVisit, 1, 0>(slab: &slab, handle: handle, env: &seen) {
    Ok(value: observed) => {
      if observed != 7_u64 {
        set failed = failed +wrap 1_u64;
      }
    }
    Err(error: expired) => {
      set failed = failed +wrap 1_u64;
    }
  }
  match slab_remove::<SlabTestTicket, 1, 0>(slab: &slab, handle: handle) {
    Some(value: removed) => {
      if removed.payload.inner.id != 7_u64 {
        set failed = failed +wrap 1_u64;
      }
      slab_test_consume_ticket(env: &seen, value: move removed);
    }
    None() => {
      set failed = failed +wrap 1_u64;
    }
  }
  let third = slab_test_ticket(id: 9_u64);
  match slab_insert::<SlabTestTicket, 1, 0>(slab: &slab, value: move third) {
    Ok(value: unexpected) => {
      set failed = failed +wrap 1_u64;
    }
    Err(error: uninserted) => {
      if uninserted.payload.inner.id != 9_u64 {
        set failed = failed +wrap 1_u64;
      }
      slab_test_consume_ticket(env: &seen, value: move uninserted);
    }
  }
  slab_free::<SlabTestTicketConsume, 1, 0>(slab: move slab, env: &seen);
  let cleanup = slab_new::<SlabTestTicket, 2, 1>(capacity: 2_u64);
  for (id in 10_u64..12_u64) {
    let value = slab_test_ticket(id: id);
    match slab_insert::<SlabTestTicket, 2, 1>(slab: &cleanup, value: move value) {
      Ok(value: cleanup_handle) => {
      }
      Err(error: uninserted) => {
        slab_test_consume_ticket(env: &seen, value: move uninserted);
        set failed = failed +wrap 1_u64;
      }
    }
  }
  slab_free::<SlabTestTicketConsume, 2, 1>(slab: move cleanup, env: &seen);
  if seen.sum != 45_u64 {
    set failed = failed +wrap 1_u64;
  }
  if seen.count != 5_u64 {
    set failed = failed +wrap 1_u64;
  }
  if seen.visits != 1_u64 {
    set failed = failed +wrap 1_u64;
  }
  return failed;
}

fn main() -> status: ExitStatus pure {
  doc "The complete bounded Slab chain covers scalar, affine Box and nodrop owners, empty and full capacity, checked expiry, reuse, finite-generation retirement, borrowed visitation, and cleanup. The separately bundled membership witness adds weak and composite retained indexes. A native observer checks every backing and payload allocation is released once.";
  let scalar_failures = slab_test_scalars();
  let zero_failures = slab_test_zero_capacity();
  let box_failures = slab_test_boxes();
  let ticket_failures = slab_test_tickets();
  let membership_failures = slab_membership_checks();
  if scalar_failures != 0_u64 {
    return exit_status(code: 1_u8);
  }
  if zero_failures != 0_u64 {
    return exit_status(code: 2_u8);
  }
  if box_failures != 0_u64 {
    return exit_status(code: 3_u8);
  }
  if ticket_failures != 0_u64 {
    return exit_status(code: 4_u8);
  }
  if membership_failures != 0_u64 {
    return exit_status(code: 5_u8);
  }
  return exit_status(code: 0_u8);
}
