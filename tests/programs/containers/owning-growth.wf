alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Resource {
  id: u64;
  data0: u64;
  data1: u64;
  data2: u64;
  data3: u64;
}

enum Slot {
  Vacant();
  Deleted();
  Occupied(fingerprint: u8, key: u64, payload: Box<Resource>);
}

enum Probe {
  Stop();
  Skip();
  Miss();
  Match();
}

enum PutOutcome {
  Inserted();
  Replaced(previous: Box<Resource>);
  Full(offered: Box<Resource>);
}

struct Progress {
  held: Slot;
  source_next: u64;
  next_probe: u64;
  phase: u8;
}

struct Rehash {
  source: Box<Slots<Slot>>;
  target: Box<Slots<Slot>>;
  progress: Progress;
}

fn occupied(slot: &Slot) -> full: Bool reads(slot) {
  match deref(slot) {
    Occupied(fingerprint: tag, key: present, payload: owner) => {
      return True();
    }
    Vacant() => {
      return False();
    }
    Deleted() => {
      return False();
    }
  }
}

fn slot_key(slot: &Slot) -> key: u64 reads(slot) {
  match deref(slot) {
    Occupied(fingerprint: tag, key: present, payload: owner) => {
      return deref(present);
    }
    Vacant() => {
      return 0_u64;
    }
    Deleted() => {
      return 0_u64;
    }
  }
}

fn fingerprint(key: u64) -> result: u8 pure {
  let tag = 0_u8;
  let bit0 = iand(key, 1_u64);
  if bit0 != 0_u64 {
    set tag = ior(tag, 1_u8);
  }
  let bit1 = iand(key, 2_u64);
  if bit1 != 0_u64 {
    set tag = ior(tag, 2_u8);
  }
  let bit2 = iand(key, 4_u64);
  if bit2 != 0_u64 {
    set tag = ior(tag, 4_u8);
  }
  let bit3 = iand(key, 8_u64);
  if bit3 != 0_u64 {
    set tag = ior(tag, 8_u8);
  }
  let bit4 = iand(key, 16_u64);
  if bit4 != 0_u64 {
    set tag = ior(tag, 16_u8);
  }
  let bit5 = iand(key, 32_u64);
  if bit5 != 0_u64 {
    set tag = ior(tag, 32_u8);
  }
  let bit6 = iand(key, 64_u64);
  if bit6 != 0_u64 {
    set tag = ior(tag, 64_u8);
  }
  return tag;
}

fn probe_index(home: u64, step: u64, count: u64) -> index: u64 pure contract {
  requires home < count;
  requires step < count;
  ensures index < count;
} {
  let until_end = count - home;
  if step >= until_end {
    let wrapped = step - until_end;
    return wrapped;
  }
  let straight = home + step;
  return straight;
}

fn probe(slot: &Slot, key: u64) -> result: Probe reads(slot) {
  match deref(slot) {
    Vacant() => {
      return Probe::Stop();
    }
    Deleted() => {
      return Probe::Skip();
    }
    Occupied(fingerprint: saved, key: present, payload: owner) => {
      if deref(present) == key {
        return Probe::Match();
      }
      return Probe::Miss();
    }
  }
}

fn fill_slots(slots: &Box<Slots<Slot>>, count: u64) -> result: unit writes(slots) contract {
  requires deref(slots).inner.len == 0_u64;
  requires count <= deref(slots).inner.cap - deref(slots).inner.len;
  ensures deref(slots).inner.len == count;
} {
  doc "One vacant slot per position, under a counted header that carries the length and the remaining free slots.";
  for (
    index in 0_u64..count,
    invariant filled: deref(slots).inner.len >= index,
    invariant bounded: deref(slots).inner.len <= index,
    invariant spare: deref(slots).inner.cap - deref(slots).inner.len + index >= count
  ) {
    let vacant = Slot::Vacant();
    place_back(window: &deref(slots).inner, value: move vacant);
  }
  invariant complete_min: deref(slots).inner.len >= count;
  invariant complete_max: deref(slots).inner.len <= count;
  return unit;
}

fn put(slots: &Box<Slots<Slot>>, key: u64, payload: Box<Resource>) -> outcome: PutOutcome writes(slots) contract {
  ensures deref(slots).inner.len == deref(entry(slots)).inner.len;
} {
  doc "The installation is swap: the offered occupant goes into the slot and the binding comes back holding the slot's previous value, so no program point sees a hole.";
  let count = deref(slots).inner.len;
  let first_deleted = count;
  for (step in 0_u64..count) {
    let home = key % count;
    let index = probe_index(home: home, step: step, count: count);
    let action = probe(slot: &deref(slots).inner[index], key: key);
    match action {
      Match() => {
        let tag = fingerprint(key: key);
        let offered = Slot::Occupied(fingerprint: tag, key: key, payload: move payload);
        swap(first: &deref(slots).inner[index], second: &offered);
        match move offered {
          Occupied(fingerprint: old_tag, key: old_key, payload: old_payload) => {
            return PutOutcome::Replaced(previous: move old_payload);
          }
          Vacant() => {
            return PutOutcome::Inserted();
          }
          Deleted() => {
            return PutOutcome::Inserted();
          }
        }
      }
      Skip() => {
        if first_deleted == count {
          set first_deleted = index;
        }
      }
      Stop() => {
        let destination = index;
        if first_deleted < count {
          set destination = first_deleted;
        }
        let tag = fingerprint(key: key);
        let offered = Slot::Occupied(fingerprint: tag, key: key, payload: move payload);
        swap(first: &deref(slots).inner[destination], second: &offered);
        match move offered {
          Vacant() => {
            return PutOutcome::Inserted();
          }
          Deleted() => {
            return PutOutcome::Inserted();
          }
          Occupied(fingerprint: old_tag, key: old_key, payload: old_payload) => {
            return PutOutcome::Replaced(previous: move old_payload);
          }
        }
      }
      Miss() => {
      }
    }
  }
  if first_deleted < count {
    let tag = fingerprint(key: key);
    let offered = Slot::Occupied(fingerprint: tag, key: key, payload: move payload);
    swap(first: &deref(slots).inner[first_deleted], second: &offered);
    match move offered {
      Vacant() => {
        return PutOutcome::Inserted();
      }
      Deleted() => {
        return PutOutcome::Inserted();
      }
      Occupied(fingerprint: old_tag, key: old_key, payload: old_payload) => {
        return PutOutcome::Replaced(previous: move old_payload);
      }
    }
  }
  return PutOutcome::Full(offered: move payload);
}

fn begin(source: Box<Slots<Slot>>, count: u64) -> result: Rehash pure contract {
  requires count <= 2097152_u64;
} {
  doc "Allocation is total, so the migration state is built without a refusal arm; the source cell moves into the state unchanged.";
  let spare = box_slots_new::<Slot>(capacity: count);
  fill_slots(slots: &spare, count: count);
  let held = Slot::Vacant();
  let progress = Progress(held: move held, source_next: 0_u64, next_probe: 0_u64, phase: 0_u8);
  let state = Rehash(source: move source, target: move spare, progress: move progress);
  return move state;
}

fn read_slot(slot: &Slot) -> (control: u8, key: u64, id: u64) reads(slot) {
  match deref(slot) {
    Vacant() => {
      return 128_u8, 0_u64, 0_u64;
    }
    Deleted() => {
      return 254_u8, 0_u64, 0_u64;
    }
    Occupied(fingerprint: saved_tag, key: saved_key, payload: owner) => {
      return deref(saved_tag), deref(saved_key), deref(owner).inner.id;
    }
  }
}

fn find(slots: &Box<Slots<Slot>>, key: u64) -> (found: Option<u64>, examined: u64) reads(slots) {
  let count = deref(slots).inner.len;
  let tag = fingerprint(key: key);
  for (offset in 0_u64..count) {
    let home = key % count;
    let index = probe_index(home: home, step: offset, count: count);
    let work = offset + 1_u64;
    let (control, present_key, present_id) = read_slot(slot: &deref(slots).inner[index]);
    if control == 128_u8 {
      return None<u64>(), work;
    }
    if control == tag {
      if present_key == key {
        return Some<u64>(value: present_id), work;
      }
    }
  }
  return None<u64>(), count;
}

fn remove(slots: &Box<Slots<Slot>>, key: u64) -> removed: Option<Box<Resource>> writes(slots) contract {
  ensures deref(slots).inner.len == deref(entry(slots)).inner.len;
} {
  let count = deref(slots).inner.len;
  let tag = fingerprint(key: key);
  for (offset in 0_u64..count) {
    let home = key % count;
    let index = probe_index(home: home, step: offset, count: count);
    let (control, present_key, present_id) = read_slot(slot: &deref(slots).inner[index]);
    if control == 128_u8 {
      return None<Box<Resource>>();
    }
    if control == tag {
      if present_key == key {
        let deleted = Slot::Deleted();
        swap(first: &deref(slots).inner[index], second: &deleted);
        match move deleted {
          Vacant() => {
            return None<Box<Resource>>();
          }
          Deleted() => {
            return None<Box<Resource>>();
          }
          Occupied(fingerprint: old_tag, key: old_key, payload: old_payload) => {
            return Some<Box<Resource>>(value: move old_payload);
          }
        }
      }
    }
  }
  return None<Box<Resource>>();
}

fn allocate_put(slots: &Box<Slots<Slot>>, key: u64, id: u64) -> outcome: PutOutcome writes(slots) contract {
  ensures deref(slots).inner.len == deref(entry(slots)).inner.len;
} {
  doc "Allocation is total, so one owner is built for every offered insertion.";
  let data0 = id *wrap 17_u64;
  let data1 = data0 +wrap 1_u64;
  let data2 = data0 +wrap 2_u64;
  let data3 = data0 +wrap 3_u64;
  let resource = Resource(id: id, data0: data0, data1: data1, data2: data2, data3: data3);
  let owner = box_new::<Resource>(value: resource);
  let result = put(slots: slots, key: key, payload: move owner);
  return move result;
}

fn check_put(outcome: PutOutcome, kind: u64, expected: u64) -> code: u8 pure {
  match move outcome {
    Inserted() => {
      if kind != 1_u64 {
        return 1_u8;
      }
      return 0_u8;
    }
    Replaced(previous: old) => {
      if kind != 2_u64 {
        return 2_u8;
      }
      if old.inner.id != expected {
        return 3_u8;
      }
      return 0_u8;
    }
    Full(offered: back) => {
      if kind != 3_u64 {
        return 4_u8;
      }
      if back.inner.id != expected {
        return 5_u8;
      }
      return 0_u8;
    }
  }
}

fn digest(slots: &Box<Slots<Slot>>) -> result: u64 reads(slots) {
  let count = deref(slots).inner.len;
  let start = ixor(1469598103934665603_u64, count);
  let hash = start *wrap 1099511628211_u64;
  for (index in 0_u64..count) {
    let (control, key, id) = read_slot(slot: &deref(slots).inner[index]);
    let wide = cvt::<u8, u64>(control);
    let with_tag = ixor(hash, wide);
    set hash = with_tag *wrap 1099511628211_u64;
    if control <= 127_u8 {
      let with_key = ixor(hash, key);
      let keyed = with_key *wrap 1099511628211_u64;
      let with_id = ixor(keyed, id);
      set hash = with_id *wrap 1099511628211_u64;
    }
  }
  return hash;
}

fn cleanup(state: Rehash) -> result: unit pure {
  doc "Early release of an affine value is a move into a consuming function: the state enters by value and its compiler-derived release runs at this scope's exit.";
  return unit;
}

fn advance(source: &Box<Slots<Slot>>, target: &Box<Slots<Slot>>, progress: &Progress, budget: u64) -> (examined: u64, moved: u64) writes(source), writes(target), writes(progress.held), writes(progress.source_next), writes(progress.next_probe), writes(progress.phase) {
  doc "Each transfer is two exchanges: the source slot's occupant goes into the held field and the held occupant goes into its target slot, so the displaced vacant value is released by the ordinary scope exit.";
  let source_cursor = deref(progress).source_next;
  let probe_cursor = deref(progress).next_probe;
  let phase = deref(progress).phase;
  let inspected = 0_u64;
  let transfers = 0_u64;
  if phase < 2_u8 {
    for (
      tick in 0_u64..budget,
      invariant work_min: inspected >= tick,
      invariant work_max: inspected <= tick,
      invariant moved_bound: transfers <= inspected
    ) {
      if phase == 0_u8 {
        let count = deref(source).inner.len;
        if source_cursor >= count {
          set phase = 3_u8;
          break;
        }
        let index = source_cursor;
        set source_cursor = source_cursor + 1_u64;
        let full = occupied(slot: &deref(source).inner[index]);
        if full {
          let held_slot = Slot::Deleted();
          swap(first: &deref(source).inner[index], second: &held_slot);
          swap(first: &deref(progress).held, second: &held_slot);
          set probe_cursor = 0_u64;
          set phase = 1_u8;
        }
      } else {
        let count = deref(target).inner.len;
        if probe_cursor >= count {
          set phase = 2_u8;
          break;
        }
        let key = slot_key(slot: &deref(progress).held);
        let home = key % count;
        let index = probe_index(home: home, step: probe_cursor, count: count);
        set probe_cursor = probe_cursor + 1_u64;
        let full = occupied(slot: &deref(target).inner[index]);
        if full {
        } else {
          let held_slot = Slot::Vacant();
          swap(first: &deref(progress).held, second: &held_slot);
          swap(first: &deref(target).inner[index], second: &held_slot);
          set transfers = transfers + 1_u64;
          set phase = 0_u8;
        }
      }
      set inspected = inspected + 1_u64;
    }
    if phase == 0_u8 {
      let source_count = deref(source).inner.len;
      if source_cursor == source_count {
        set phase = 3_u8;
      }
    }
  }
  set deref(progress).source_next = source_cursor;
  set deref(progress).next_probe = probe_cursor;
  set deref(progress).phase = phase;
  return inspected, transfers;
}

fn rehash_all(slots: &Box<Slots<Slot>>, count: u64) -> (code: u8, examined: u64, moved: u64) writes(slots) contract {
  requires deref(slots).inner.len <= 1048576_u64;
  requires count >= deref(slots).inner.len;
  requires count <= 2097152_u64;
} {
  doc "A complete migration into a fresh cell, committed over the caller's cell so the ordinary assignment releases the emptied source.";
  let target = box_slots_new::<Slot>(capacity: count);
  let held = Slot::Vacant();
  let progress = Progress(held: move held, source_next: 0_u64, next_probe: 0_u64, phase: 0_u8);
  fill_slots(slots: &target, count: count);
  let (work, moved) = advance(source: slots, target: &target, progress: &progress, budget: 18446744073709551615_u64);
  let phase = progress.phase;
  set deref(slots) = move target;
  return phase, work, moved;
}

fn create_table(count: u64) -> result: Box<Slots<Slot>> pure contract {
  requires count <= 2097152_u64;
  ensures result.inner.len == count;
} {
  let spare = box_slots_new::<Slot>(capacity: count);
  fill_slots(slots: &spare, count: count);
  return move spare;
}

fn checked_insert(slots: &Box<Slots<Slot>>, key: u64, id: u64, kind: u64, expected: u64) -> code: u8 writes(slots) {
  let outcome = allocate_put(slots: slots, key: key, id: id);
  let verdict = check_put(outcome: move outcome, kind: kind, expected: expected);
  return verdict;
}

fn state_hash(state: &Rehash) -> result: u64 reads(state.source), reads(state.target), reads(state.progress.held), reads(state.progress.source_next), reads(state.progress.next_probe), reads(state.progress.phase) {
  let source = digest(slots: &deref(state).source);
  let target = digest(slots: &deref(state).target);
  let (control, key, id) = read_slot(slot: &deref(state).progress.held);
  let first = source *wrap 131_u64;
  let second = first +wrap target;
  let third = second *wrap 131_u64;
  let fourth = third +wrap deref(state).progress.source_next;
  let fifth = fourth *wrap 131_u64;
  let sixth = fifth +wrap deref(state).progress.next_probe;
  let phase = cvt::<u8, u64>(deref(state).progress.phase);
  let seventh = sixth *wrap 131_u64;
  let eighth = seventh +wrap phase;
  let ninth = eighth *wrap 131_u64;
  if control <= 127_u8 {
    let tenth = ninth +wrap key;
    let eleventh = tenth *wrap 131_u64;
    return eleventh +wrap id;
  }
  return ninth *wrap 131_u64;
}

fn check_lookup(slots: &Box<Slots<Slot>>, key: u64, expected: u64, work: u64) -> code: u8 reads(slots) {
  let (found, examined) = find(slots: slots, key: key);
  if examined != work {
    return 11_u8;
  }
  match found {
    None() => {
      return 12_u8;
    }
    Some(value: present) => {
      if present != expected {
        return 13_u8;
      }
      return 0_u8;
    }
  }
}

fn map_contract(seed: u64, scenario: u64, budget: u64) -> result: u64 pure {
  doc "One scenario of the incremental migration contract: fill a table, exercise removal and replacement, begin a migration into a fresh cell, and step it under a budget.";
  let initial = 8_u64;
  let entries = 3_u64;
  if scenario == 0_u64 {
    set entries = 5_u64;
  }
  if scenario >= 3_u64 {
    set initial = 1_u64;
    set entries = 1_u64;
  }
  let base = seed *wrap 100_u64;
  let slots = create_table(count: initial);
  for (ordinal in 0_u64..entries) {
    let key_offset = ordinal *wrap 8_u64;
    let kind = 1_u64;
    let expected = 0_u64;
    if scenario == 0_u64 {
      if ordinal == 2_u64 {
        set key_offset = 8_u64;
        set kind = 2_u64;
        set expected = base +wrap 2_u64;
      }
      if ordinal == 3_u64 {
        let removed = remove(slots: &slots, key: seed);
        match move removed {
          None() => {
            return 14_u64;
          }
          Some(value: owner) => {
            let expected_removed = base +wrap 1_u64;
            if owner.inner.id != expected_removed {
              return 15_u64;
            }
          }
        }
        set key_offset = 8_u64;
        set kind = 2_u64;
        set expected = base +wrap 3_u64;
        let query = seed +wrap 8_u64;
        let query_id = base +wrap 3_u64;
        let checked_lookup = check_lookup(slots: &slots, key: query, expected: query_id, work: 2_u64);
        if checked_lookup != 0_u8 {
          return cvt::<u8, u64>(checked_lookup);
        }
      }
      if ordinal == 4_u64 {
        set key_offset = 16_u64;
      }
    }
    let key = seed +wrap key_offset;
    let index_id = base +wrap ordinal;
    let id = index_id +wrap 1_u64;
    let checked_put = checked_insert(slots: &slots, key: key, id: id, kind: kind, expected: expected);
    if checked_put != 0_u8 {
      return cvt::<u8, u64>(checked_put);
    }
  }
  if scenario == 4_u64 {
    let key = seed +wrap 1_u64;
    let id = base +wrap 2_u64;
    let checked_full = checked_insert(slots: &slots, key: key, id: id, kind: 3_u64, expected: id);
    if checked_full != 0_u8 {
      return cvt::<u8, u64>(checked_full);
    }
    return digest(slots: &slots);
  }
  let target_capacity = 8_u64;
  if scenario == 0_u64 {
    set target_capacity = 16_u64;
  }
  if scenario == 3_u64 {
    set target_capacity = 1_u64;
  }
  let migration = begin(source: move slots, count: target_capacity);
  let total_work = 0_u64;
  let total_moved = 0_u64;
  if scenario == 3_u64 {
    let key = seed +wrap 1_u64;
    let id = base +wrap 2_u64;
    let checked_target = checked_insert(slots: &migration.target, key: key, id: id, kind: 1_u64, expected: 0_u64);
    if checked_target != 0_u8 {
      return cvt::<u8, u64>(checked_target);
    }
  }
  if scenario == 2_u64 {
    for (round in 0_u64..14_u64) {
      let unchanged = state_hash(state: &migration);
      let (idle_work, idle_moved) = advance(source: &migration.source, target: &migration.target, progress: &migration.progress, budget: 0_u64);
      let after_idle = state_hash(state: &migration);
      if unchanged != after_idle {
        return 17_u64;
      }
      if idle_work != 0_u64 {
        return 18_u64;
      }
      if idle_moved != 0_u64 {
        return 19_u64;
      }
      let (work, moved) = advance(source: &migration.source, target: &migration.target, progress: &migration.progress, budget: 1_u64);
      set total_work = total_work +wrap work;
      set total_moved = total_moved +wrap moved;
      if work != 1_u64 {
        return 20_u64;
      }
    }
  } else {
    let (work, moved) = advance(source: &migration.source, target: &migration.target, progress: &migration.progress, budget: budget);
    set total_work = work;
    set total_moved = moved;
    if work > budget {
      return 21_u64;
    }
    if scenario == 3_u64 {
      let unchanged = state_hash(state: &migration);
      let (retry_work, retry_moved) = advance(source: &migration.source, target: &migration.target, progress: &migration.progress, budget: 99_u64);
      let after_retry = state_hash(state: &migration);
      if unchanged != after_retry {
        return 22_u64;
      }
      if retry_work != 0_u64 {
        return 23_u64;
      }
      if retry_moved != 0_u64 {
        return 24_u64;
      }
    }
  }
  let hash = state_hash(state: &migration);
  cleanup(state: move migration);
  let first = hash *wrap 131_u64;
  let second = first +wrap total_work;
  let third = second *wrap 131_u64;
  return third +wrap total_moved;
}

fn main() -> status: ExitStatus pure {
  let observed = map_contract(seed: 0_u64, scenario: 0_u64, budget: 100_u64);
  if observed <= 70_u64 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
