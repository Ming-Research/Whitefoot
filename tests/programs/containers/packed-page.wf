alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn blank_page() -> page: Slots<u8, 32> pure contract {
  ensures page.len >= 32_u64;
} {
  let page = slots_new::<u8, 32>();
  for (
    index in 0_u64..32_u64,
    invariant grown: page.len >= index,
    invariant bound: page.len <= index,
    invariant spare: page.cap - page.len + index >= 32_u64
  ) {
    place_back(window: &page, value: 0_u8);
  }
  return move page;
}

fn checksum(page: &Slots<u8, 32>, used: u64) -> result: Option<u64> reads(page) contract {
  requires deref(page).len >= 32_u64;
} {
  if used > 32_u64 {
    return None<u64>();
  }
  let at = 0_u64;
  let sum = 0_u64;
  loop @records (
    invariant within: at <= used,
    invariant extent: used <= deref(page).len,
    invariant small: used <= 32_u64
  ) {
    if at >= used {
      break @records;
    }
    let width_byte = deref(page)[at];
    let width = cvt::<u8, u64>(width_byte);
    let start = at + 1_u64;
    let remaining = used - start;
    if width > remaining {
      return None<u64>();
    }
    let end = start + width;
    let header_hash = sum *wrap 131_u64;
    set sum = header_hash +wrap width;
    for (
      offset in start..end,
      invariant contained: end <= used
    ) {
      let byte = deref(page)[offset];
      let word = cvt::<u8, u64>(byte);
      let prefix = sum *wrap 131_u64;
      set sum = prefix +wrap word;
    }
    set at = end;
  }
  return Some<u64>(value: sum);
}

fn remove_first(page: &Slots<u8, 32>, used: u64) -> (remaining: u64, removed: Bool) writes(page) contract {
  requires deref(page).len >= 32_u64;
  ensures deref(page).len == deref(entry(page)).len;
} {
  if used == 0_u64 {
    return used, False();
  }
  if used > 32_u64 {
    return used, False();
  }
  let width_byte = deref(page)[0_u64];
  let width = cvt::<u8, u64>(width_byte);
  let after_header = used - 1_u64;
  if width > after_header {
    return used, False();
  }
  let start = width + 1_u64;
  let remaining = used - start;
  for (destination in 0_u64..remaining) {
    let source = destination + start;
    let byte = deref(page)[source];
    set deref(page)[destination] = byte;
  }
  return remaining, True();
}

fn prepend(page: &Slots<u8, 32>, used: u64, payload: &Slots<u8, 8>, width_byte: u8) -> (occupied: u64, inserted: Bool) reads(payload), writes(page) contract {
  requires deref(page).len >= 32_u64;
  ensures deref(page).len == deref(entry(page)).len;
} {
  if used > 32_u64 {
    return used, False();
  }
  let width = cvt::<u8, u64>(width_byte);
  let available = deref(payload).len;
  if width > available {
    return used, False();
  }
  let record_width = width + 1_u64;
  let spare = 32_u64 - used;
  if record_width > spare {
    return used, False();
  }
  let occupied = used + record_width;
  for (
    step in 0_u64..used,
    invariant size: used + record_width <= deref(page).len,
    invariant payload_size: width <= deref(payload).len,
    invariant result_size: occupied <= 32_u64
  ) {
    let end = used - step;
    let source = end - 1_u64;
    let destination = source + record_width;
    let byte = deref(page)[source];
    set deref(page)[destination] = byte;
  }
  for (offset in 0_u64..width) {
    let byte = deref(payload)[offset];
    let destination = offset + 1_u64;
    set deref(page)[destination] = byte;
  }
  set deref(page)[0_u64] = width_byte;
  return occupied, True();
}

fn is_sum(value: Option<u64>, expected: u64) -> result: Bool pure {
  match value {
    Some(value: sum) => {
      return sum == expected;
    }
    None() => {
      return False();
    }
  }
}

fn is_invalid(value: Option<u64>) -> result: Bool pure {
  match value {
    Some(value: sum) => {
      return False();
    }
    None() => {
      return True();
    }
  }
}

fn main() -> status: ExitStatus pure {
  let page = blank_page();
  set page[0_u64] = 2_u8;
  set page[1_u64] = 10_u8;
  set page[2_u64] = 20_u8;
  set page[3_u64] = 1_u8;
  set page[4_u64] = 30_u8;
  set page[5_u64] = 3_u8;
  set page[6_u64] = 40_u8;
  set page[7_u64] = 50_u8;
  set page[8_u64] = 60_u8;
  let before = checksum(page: &page, used: 9_u64);
  let before_ok = is_sum(value: before, expected: 180182158841830816_u64);
  if bnot(before_ok) {
    return exit_status(code: 1_u8);
  }
  let (remaining, removed) = remove_first(page: &page, used: 9_u64);
  if bnot(removed) {
    return exit_status(code: 2_u8);
  }
  if remaining != 6_u64 {
    return exit_status(code: 3_u8);
  }
  let after = checksum(page: &page, used: remaining);
  let after_ok = is_sum(value: after, expected: 47421924604_u64);
  if bnot(after_ok) {
    return exit_status(code: 4_u8);
  }
  set page[0_u64] = 255_u8;
  let malformed = checksum(page: &page, used: remaining);
  let malformed_ok = is_invalid(value: malformed);
  if bnot(malformed_ok) {
    return exit_status(code: 5_u8);
  }
  let oversized = checksum(page: &page, used: 33_u64);
  let oversized_ok = is_invalid(value: oversized);
  if bnot(oversized_ok) {
    return exit_status(code: 6_u8);
  }
  let (same_length, refused) = remove_first(page: &page, used: remaining);
  if refused {
    return exit_status(code: 7_u8);
  }
  if same_length != remaining {
    return exit_status(code: 8_u8);
  }
  if page[0_u64] != 255_u8 {
    return exit_status(code: 9_u8);
  }
  if page[1_u64] != 30_u8 {
    return exit_status(code: 10_u8);
  }
  let payload = slots_new::<u8, 8>();
  place_back(window: &payload, value: 5_u8);
  place_back(window: &payload, value: 6_u8);
  place_back(window: &payload, value: 7_u8);
  let empty = blank_page();
  let (first_used, first_inserted) = prepend(page: &empty, used: 0_u64, payload: &payload, width_byte: 3_u8);
  if bnot(first_inserted) {
    return exit_status(code: 11_u8);
  }
  let (second_used, second_inserted) = prepend(page: &empty, used: first_used, payload: &payload, width_byte: 2_u8);
  if bnot(second_inserted) {
    return exit_status(code: 12_u8);
  }
  if second_used != 7_u64 {
    return exit_status(code: 13_u8);
  }
  let inserted_sum = checksum(page: &empty, used: second_used);
  let inserted_ok = is_sum(value: inserted_sum, expected: 10302497567214_u64);
  if bnot(inserted_ok) {
    return exit_status(code: 14_u8);
  }
  let (full_used, full_inserted) = prepend(page: &empty, used: 31_u64, payload: &payload, width_byte: 1_u8);
  if full_inserted {
    return exit_status(code: 15_u8);
  }
  if full_used != 31_u64 {
    return exit_status(code: 16_u8);
  }
  if empty[0_u64] != 2_u8 {
    return exit_status(code: 17_u8);
  }
  let (invalid_used, invalid_inserted) = prepend(page: &empty, used: 7_u64, payload: &payload, width_byte: 4_u8);
  if invalid_inserted {
    return exit_status(code: 18_u8);
  }
  if invalid_used != 7_u64 {
    return exit_status(code: 19_u8);
  }
  let (zero, did_remove) = remove_first(page: &empty, used: 0_u64);
  if did_remove {
    return exit_status(code: 20_u8);
  }
  if zero != 0_u64 {
    return exit_status(code: 21_u8);
  }
  return exit_status(code: 0_u8);
}
