alias ExitStatus = std::process::ExitStatus;
alias Slab = std::collections::slab::Slab;
alias SlabHandle = std::collections::slab::SlabHandle;
alias exit_status = std::process::exit_status;
alias priority_queue_free = std::collections::priority_queue::priority_queue_free;
alias priority_queue_heapify_indexed = std::collections::priority_queue::priority_queue_heapify_indexed;
alias priority_queue_len = std::collections::priority_queue::priority_queue_len;
alias priority_queue_peek_at = std::collections::priority_queue::priority_queue_peek_at;
alias priority_queue_remove_at_indexed = std::collections::priority_queue::priority_queue_remove_at_indexed;
alias slab_edit = std::collections::slab::slab_edit;
alias slab_free = std::collections::slab::slab_free;
alias slab_insert = std::collections::slab::slab_insert;
alias slab_new = std::collections::slab::slab_new;
alias slab_remove = std::collections::slab::slab_remove;

interface IndexedPayload<T> {
  fn make(serial: u64) -> value: T pure;
  fn read(value: &T) -> serial: u64 reads(value);
  fn consume(value: T) -> result: unit pure;
}

struct IndexedChild {
  serial: u64;
  check: u64;
}

nodrop struct IndexedWide {
  child: Box<IndexedChild>;
  a: u64;
  b: u64;
  c: u64;
  d: u64;
  e: u64;
  f: u64;
  g: u64;
}

fn indexed_child(serial: u64) -> value: Box<IndexedChild> pure {
  let check = serial +wrap 101_u64;
  let child = IndexedChild(serial: serial, check: check);
  return box_new::<IndexedChild>(value: child);
}

fn indexed_child_read(value: &Box<IndexedChild>) -> serial: u64 reads(value) {
  let serial = deref(value).inner.serial;
  let expected = serial +wrap 101_u64;
  if deref(value).inner.check != expected {
    return 18446744073709551615_u64;
  }
  return serial;
}

fn indexed_child_consume(value: Box<IndexedChild>) -> result: unit pure {
  return unit;
}

binding IndexedDropPayload : IndexedPayload<Box<IndexedChild>> {
  make = indexed_child;
  read = indexed_child_read;
  consume = indexed_child_consume;
}

fn indexed_wide(serial: u64) -> value: IndexedWide pure {
  let child = indexed_child(serial: serial);
  let a = serial +wrap 11_u64;
  let b = serial +wrap 22_u64;
  let c = serial +wrap 33_u64;
  let d = serial +wrap 44_u64;
  let e = serial +wrap 55_u64;
  let f = serial +wrap 66_u64;
  let g = serial +wrap 77_u64;
  return IndexedWide(child: move child, a: a, b: b, c: c, d: d, e: e, f: f, g: g);
}

fn indexed_wide_read(value: &IndexedWide) -> serial: u64 reads(value) {
  let serial = indexed_child_read(value: &deref(value).child);
  let a = serial +wrap 11_u64;
  let b = serial +wrap 22_u64;
  let c = serial +wrap 33_u64;
  let d = serial +wrap 44_u64;
  let e = serial +wrap 55_u64;
  let f = serial +wrap 66_u64;
  let g = serial +wrap 77_u64;
  if deref(value).a != a {
    return 18446744073709551615_u64;
  }
  if deref(value).b != b {
    return 18446744073709551615_u64;
  }
  if deref(value).c != c {
    return 18446744073709551615_u64;
  }
  if deref(value).d != d {
    return 18446744073709551615_u64;
  }
  if deref(value).e != e {
    return 18446744073709551615_u64;
  }
  if deref(value).f != f {
    return 18446744073709551615_u64;
  }
  if deref(value).g != g {
    return 18446744073709551615_u64;
  }
  return serial;
}

fn indexed_wide_consume(value: IndexedWide) -> result: unit pure {
  let IndexedWide(child: child, a: a, b: b, c: c, d: d, e: e, f: f, g: g) = move value;
  return unit;
}

binding IndexedWidePayload : IndexedPayload<IndexedWide> {
  make = indexed_wide;
  read = indexed_wide_read;
  consume = indexed_wide_consume;
}

struct IndexedRow {
  live: Bool;
  id: u64;
  serial: u64;
  member: Bool;
  scheduled: Bool;
  deadline: u64;
  handle: RecordHandle;
}

struct IndexedOracle {
  rows: Array<IndexedRow, 32>;
}

struct IndexedLedger {
  ids: Array<u64, 64>;
  released: Array<u64, 64>;
  sequence: Array<u64, 32>;
  count: u64;
  next: u64;
  ordered: Bool;
  failures: u64;
}

fn indexed_ledger() -> result: IndexedLedger pure {
  let ids = array_filled::<u64, 64>(value: 0_u64);
  let released = array_filled::<u64, 64>(value: 0_u64);
  let sequence = array_filled::<u64, 32>(value: 0_u64);
  let ordered = False();
  return IndexedLedger(ids: ids, released: released, sequence: sequence, count: 0_u64, next: 0_u64, ordered: ordered, failures: 0_u64);
}

fn indexed_oracle() -> result: IndexedOracle pure {
  let absent = False();
  let object = SlabHandle(index: 18446744073709551615_u64, generation: 0_u64);
  let handle = RecordHandle(store_id: 0_u64, object: object);
  let row = IndexedRow(live: absent, id: 0_u64, serial: 0_u64, member: absent, scheduled: absent, deadline: 0_u64, handle: handle);
  let rows = array_filled::<IndexedRow, 32>(value: row);
  return IndexedOracle(rows: rows);
}

fn indexed_fail(ledger: &IndexedLedger) -> result: unit writes(ledger.failures) {
  set deref(ledger).failures = deref(ledger).failures +wrap 1_u64;
  return unit;
}

fn indexed_status(ledger: &IndexedLedger, actual: RecordStatus, expected: u64) -> result: unit writes(ledger.failures) {
  let code = match actual {
    RecordDone() => {
      give 0_u64;
    }
    RecordAlready() => {
      give 1_u64;
    }
    RecordMissing() => {
      give 2_u64;
    }
    RecordExpired() => {
      give 3_u64;
    }
    RecordWrongStore() => {
      give 4_u64;
    }
    RecordConflict() => {
      give 5_u64;
    }
    RecordFull() => {
      give 6_u64;
    }
    RecordUnscheduled() => {
      give 7_u64;
    }
    RecordInvalidPosition() => {
      give 8_u64;
    }
    RecordBusy() => {
      give 9_u64;
    }
  }
  if code != expected {
    indexed_fail(ledger: ledger);
  }
  return unit;
}

fn indexed_release<T, fn read(value: &T) -> serial: u64 reads(value), fn consume(value: T) -> result: unit pure>(env: &IndexedLedger, value: Record<T>) -> result: unit writes(env) {
  let Record(id: id, payload: payload, id_member: old_member, position: old_position) = move value;
  let serial = read(value: &payload);
  if serial < 64_u64 {
    if deref(env).ids[serial] != id {
      indexed_fail(ledger: env);
    }
    set deref(env).released[serial] = deref(env).released[serial] +wrap 1_u64;
  } else {
    indexed_fail(ledger: env);
  }
  if deref(env).ordered {
    if old_member {
      indexed_fail(ledger: env);
    }
    if old_position != 8_u64 {
      indexed_fail(ledger: env);
    }
    let at = deref(env).next;
    if at < deref(env).count {
      if at < 32_u64 {
        if deref(env).sequence[at] != serial {
          indexed_fail(ledger: env);
        }
      } else {
        indexed_fail(ledger: env);
      }
    } else {
      indexed_fail(ledger: env);
    }
    set deref(env).next = at +wrap 1_u64;
  }
  consume(value: move payload);
  return unit;
}

fn indexed_release_payload<T, fn read(value: &T) -> serial: u64 reads(value), fn consume(value: T) -> result: unit pure>(ledger: &IndexedLedger, id: u64, payload: T) -> result: unit writes(ledger) {
  let absent = False();
  let record = Record<T>(id: id, payload: move payload, id_member: absent, position: 8_u64);
  indexed_release::<T, fn read, fn consume>(env: ledger, value: move record);
  return unit;
}

fn indexed_read<T, fn read(value: &T) -> serial: u64 reads(value)>(env: &RecordEmpty, value: &Record<T>) -> result: u64 reads(value) {
  return read(value: &deref(value).payload);
}

fn indexed_accept<interface IndexedPayload<T>>(store: &RecordStore<T, 8, 2>, oracle: &IndexedOracle, ledger: &IndexedLedger, row: u64, id: u64, serial: u64, payload: T) -> result: unit writes(store), writes(oracle), writes(ledger) contract {
  requires row < 32_u64;
  requires serial < 64_u64;
} {
  set deref(ledger).ids[serial] = id;
  let inserted = record_store_insert::<T, 8, 2>(store: store, id: id, payload: move payload);
  match move inserted {
    Ok(value: handle) => {
      let present = True();
      let absent = False();
      let expected = IndexedRow(live: present, id: id, serial: serial, member: absent, scheduled: absent, deadline: 0_u64, handle: handle);
      set deref(oracle).rows[row] = expected;
    }
    Err(error: returned) => {
      indexed_fail(ledger: ledger);
      indexed_release_payload::<T, fn IndexedPayload::read, fn IndexedPayload::consume>(ledger: ledger, id: id, payload: move returned);
    }
  }
  return unit;
}

fn indexed_attach<T>(store: &RecordStore<T, 8, 2>, oracle: &IndexedOracle, ledger: &IndexedLedger, row: u64) -> result: unit writes(store), writes(oracle), writes(ledger) contract {
  requires row < 32_u64;
} {
  let expected = deref(oracle).rows[row];
  let status = record_store_attach::<T, 8, 2>(store: store, handle: expected.handle);
  indexed_status(ledger: ledger, actual: status, expected: 0_u64);
  for (index in 0_u64..32_u64) {
    if deref(oracle).rows[index].id == expected.id {
      set deref(oracle).rows[index].member = False();
    }
  }
  set deref(oracle).rows[row].member = True();
  return unit;
}

fn indexed_schedule<T>(store: &RecordStore<T, 8, 2>, oracle: &IndexedOracle, ledger: &IndexedLedger, row: u64, deadline: u64) -> result: unit writes(store), writes(oracle), writes(ledger) contract {
  requires row < 32_u64;
} {
  let status = record_store_schedule::<T, 8, 2>(store: store, handle: deref(oracle).rows[row].handle, deadline: deadline);
  indexed_status(ledger: ledger, actual: status, expected: 0_u64);
  set deref(oracle).rows[row].scheduled = True();
  set deref(oracle).rows[row].deadline = deadline;
  return unit;
}

fn indexed_cancel<T>(store: &RecordStore<T, 8, 2>, oracle: &IndexedOracle, ledger: &IndexedLedger, row: u64) -> result: unit writes(store), writes(oracle), writes(ledger) contract {
  requires row < 32_u64;
} {
  let status = record_store_cancel::<T, 8, 2>(store: store, handle: deref(oracle).rows[row].handle);
  indexed_status(ledger: ledger, actual: status, expected: 0_u64);
  set deref(oracle).rows[row].scheduled = False();
  return unit;
}

fn indexed_detach<T>(store: &RecordStore<T, 8, 2>, oracle: &IndexedOracle, ledger: &IndexedLedger, row: u64) -> result: unit writes(store), writes(oracle), writes(ledger) contract {
  requires row < 32_u64;
} {
  let expected = deref(oracle).rows[row];
  let status = record_store_detach::<T, 8, 2>(store: store, id: expected.id, handle: expected.handle);
  indexed_status(ledger: ledger, actual: status, expected: 0_u64);
  set deref(oracle).rows[row].member = False();
  return unit;
}

fn indexed_delete<interface IndexedPayload<T>>(store: &RecordStore<T, 8, 2>, oracle: &IndexedOracle, ledger: &IndexedLedger, row: u64, expected_status: u64) -> result: unit writes(store), writes(oracle), writes(ledger) contract {
  requires row < 32_u64;
} {
  let removed = record_store_delete::<T, 8, 2>(store: store, handle: deref(oracle).rows[row].handle);
  match move removed {
    Ok(value: record) => {
      if expected_status != 0_u64 {
        indexed_fail(ledger: ledger);
      }
      let serial = IndexedPayload::read(value: &record.payload);
      if serial != deref(oracle).rows[row].serial {
        indexed_fail(ledger: ledger);
      }
      indexed_release::<T, fn IndexedPayload::read, fn IndexedPayload::consume>(env: ledger, value: move record);
      set deref(oracle).rows[row].live = False();
    }
    Err(error: reason) => {
      indexed_status(ledger: ledger, actual: reason, expected: expected_status);
    }
  }
  return unit;
}

fn indexed_check<interface IndexedPayload<T>>(store: &RecordStore<T, 8, 2>, oracle: &IndexedOracle, ledger: &IndexedLedger) -> result: unit reads(store), reads(oracle), writes(ledger) {
  doc "The dictionary model is a flat array keyed by external ID and insertion identity. It never reads the map's buckets or the heap's entries. Every live record is checked through borrowed application APIs, and each scheduled reverse position must validate against its own complete identity.";
  let empty = RecordEmpty();
  for (index in 0_u64..32_u64) {
    let expected = deref(oracle).rows[index];
    if expected.serial > 0_u64 {
      let info = record_store_info::<T, 8, 2>(store: store, handle: expected.handle);
      match info {
        Ok(value: present) => {
          if expected.live {
            if present.id != expected.id {
              indexed_fail(ledger: ledger);
            }
            if present.id_member {
              if expected.member {
              } else {
                indexed_fail(ledger: ledger);
              }
            } else if expected.member {
              indexed_fail(ledger: ledger);
            }
            let readback = record_store_visit::<T, RecordEmpty, u64, fn indexed_read::<T, fn IndexedPayload::read>, 8, 2>(store: store, handle: expected.handle, env: &empty);
            match readback {
              Ok(value: serial) => {
                if serial != expected.serial {
                  indexed_fail(ledger: ledger);
                }
              }
              Err(error: reason) => {
                indexed_fail(ledger: ledger);
              }
            }
            let position = record_store_position::<T, 8, 2>(store: store, handle: expected.handle);
            match position {
              Ok(value: at) => {
                if expected.scheduled {
                } else {
                  indexed_fail(ledger: ledger);
                }
              }
              Err(error: reason) => {
                if expected.scheduled {
                  indexed_fail(ledger: ledger);
                } else {
                  indexed_status(ledger: ledger, actual: reason, expected: 7_u64);
                }
              }
            }
          } else {
            indexed_fail(ledger: ledger);
          }
        }
        Err(error: reason) => {
          if expected.live {
            indexed_fail(ledger: ledger);
          } else {
            indexed_status(ledger: ledger, actual: reason, expected: 3_u64);
          }
        }
      }
      let member = 32_u64;
      for (other in 0_u64..32_u64) {
        if deref(oracle).rows[other].id == expected.id {
          if deref(oracle).rows[other].member {
            set member = other;
          }
        }
      }
      let lookup = record_store_lookup::<T, 8, 2>(store: store, id: expected.id);
      match lookup {
        Ok(value: handle) => {
          if member < 32_u64 {
            let desired = deref(oracle).rows[member];
            if desired.handle.object.index != handle.object.index {
              indexed_fail(ledger: ledger);
            }
            if desired.handle.object.generation != handle.object.generation {
              indexed_fail(ledger: ledger);
            }
            if desired.handle.store_id != handle.store_id {
              indexed_fail(ledger: ledger);
            }
            if desired.live {
            } else {
              indexed_fail(ledger: ledger);
            }
          } else {
            indexed_fail(ledger: ledger);
          }
        }
        Err(error: reason) => {
          if member < 32_u64 {
            if deref(oracle).rows[member].live {
              indexed_fail(ledger: ledger);
            } else {
              indexed_status(ledger: ledger, actual: reason, expected: 3_u64);
            }
          } else {
            indexed_status(ledger: ledger, actual: reason, expected: 2_u64);
          }
        }
      }
    }
  }
  return unit;
}

fn indexed_before(left: IndexedRow, right: IndexedRow) -> before: Bool pure {
  if left.deadline != right.deadline {
    return left.deadline < right.deadline;
  }
  if left.id != right.id {
    return left.id < right.id;
  }
  if left.handle.object.index != right.handle.object.index {
    return left.handle.object.index < right.handle.object.index;
  }
  return left.handle.object.generation < right.handle.object.generation;
}

fn indexed_expire<interface IndexedPayload<T>>(store: &RecordStore<T, 8, 2>, oracle: &IndexedOracle, ledger: &IndexedLedger, now: u64) -> result: unit writes(store), writes(oracle), writes(ledger) {
  doc "An independent insertion sort orders the flat model's due entries, including stale generations. Only live model rows enter the expected consume sequence. This oracle calls neither the shared comparator nor a heap operation.";
  let order = array_filled::<u64, 32>(value: 0_u64);
  for (index in 0_u64..32_u64) {
    set order[index] = index;
    let at = index;
    loop @sort (
      invariant bounded: at < 32_u64
    ) {
      if at == 0_u64 {
        break @sort;
      }
      let previous = at - 1_u64;
      let left = order[at];
      let right = order[previous];
      if left < 32_u64 {
        if right < 32_u64 {
          let before = indexed_before(left: deref(oracle).rows[left], right: deref(oracle).rows[right]);
          if before {
            set order[previous] = left;
            set order[at] = right;
            set at = previous;
          } else {
            break @sort;
          }
        } else {
          indexed_fail(ledger: ledger);
          break @sort;
        }
      } else {
        indexed_fail(ledger: ledger);
        break @sort;
      }
    }
  }
  set deref(ledger).count = 0_u64;
  set deref(ledger).next = 0_u64;
  for (index in 0_u64..32_u64) {
    let row = order[index];
    if row < 32_u64 {
      let expected = deref(oracle).rows[row];
      if expected.scheduled {
        if expected.deadline <= now {
          set deref(oracle).rows[row].scheduled = False();
          set deref(oracle).rows[row].member = False();
          if expected.live {
            let at = deref(ledger).count;
            if at < 32_u64 {
              set deref(ledger).sequence[at] = expected.serial;
              set deref(ledger).count = at + 1_u64;
            } else {
              indexed_fail(ledger: ledger);
            }
            set deref(oracle).rows[row].live = False();
          }
        }
      }
    } else {
      indexed_fail(ledger: ledger);
    }
  }
  set deref(ledger).ordered = True();
  let count = record_store_expire::<T, IndexedLedger, fn indexed_release::<T, fn IndexedPayload::read, fn IndexedPayload::consume>, 8, 2>(store: store, now: now, env: ledger);
  if count != deref(ledger).count {
    indexed_fail(ledger: ledger);
  }
  if deref(ledger).next != deref(ledger).count {
    indexed_fail(ledger: ledger);
  }
  set deref(ledger).ordered = False();
  indexed_check::<IndexedPayload<T>>(store: store, oracle: oracle, ledger: ledger);
  return unit;
}

fn indexed_cancel_position<interface IndexedPayload<T>>(store: &RecordStore<T, 8, 2>, oracle: &IndexedOracle, ledger: &IndexedLedger, position: u64) -> result: unit writes(store), writes(oracle), writes(ledger) {
  let selected = 32_u64;
  for (index in 0_u64..32_u64) {
    if deref(oracle).rows[index].live {
      let found = record_store_info::<T, 8, 2>(store: store, handle: deref(oracle).rows[index].handle);
      match found {
        Ok(value: info) => {
          if info.position == position {
            set selected = index;
          }
        }
        Err(error: reason) => {
          indexed_fail(ledger: ledger);
        }
      }
    }
  }
  if selected < 32_u64 {
    let deadline = deref(oracle).rows[selected].deadline;
    indexed_cancel::<T>(store: store, oracle: oracle, ledger: ledger, row: selected);
    indexed_check::<IndexedPayload<T>>(store: store, oracle: oracle, ledger: ledger);
    indexed_schedule::<T>(store: store, oracle: oracle, ledger: ledger, row: selected, deadline: deadline);
  } else {
    indexed_fail(ledger: ledger);
  }
  return unit;
}

fn indexed_trace<interface IndexedPayload<T>>(retained: Bool) -> failures: u64 pure {
  doc "Eight simultaneous owners use one collision chain. Both payload kinds run both policies through public store operations. The model advances from requested successful transitions, independently of the implementation's map and heap representation. Deliberately corrupted reverse positions must be refused before access; retained deletion remains Busy with an invalid non-sentinel position even after ID detachment.";
  let ledger = indexed_ledger();
  let oracle = indexed_oracle();
  let store = record_store_new::<T, 8, 2>(store_id: 71_u64, retained: retained, record_capacity: 8_u64, index_capacity: 0_u64, heap_capacity: 0_u64, hash_modulus: 0_u64);
  for (index in 0_u64..8_u64) {
    let id = index + 10_u64;
    let serial = index + 1_u64;
    let payload = IndexedPayload::make(serial: serial);
    indexed_accept::<IndexedPayload<T>>(store: &store, oracle: &oracle, ledger: &ledger, row: index, id: id, serial: serial, payload: move payload);
    indexed_attach::<T>(store: &store, oracle: &oracle, ledger: &ledger, row: index);
    let shifted = index * 10_u64;
    let deadline = shifted + 100_u64;
    indexed_schedule::<T>(store: &store, oracle: &oracle, ledger: &ledger, row: index, deadline: deadline);
  }
  indexed_check::<IndexedPayload<T>>(store: &store, oracle: &oracle, ledger: &ledger);
  let again_id = record_store_attach::<T, 8, 2>(store: &store, handle: oracle.rows[0_u64].handle);
  indexed_status(ledger: &ledger, actual: again_id, expected: 1_u64);
  let again_due = record_store_schedule::<T, 8, 2>(store: &store, handle: oracle.rows[0_u64].handle, deadline: 99_u64);
  indexed_status(ledger: &ledger, actual: again_due, expected: 1_u64);
  indexed_cancel_position::<IndexedPayload<T>>(store: &store, oracle: &oracle, ledger: &ledger, position: 0_u64);
  indexed_check::<IndexedPayload<T>>(store: &store, oracle: &oracle, ledger: &ledger);
  indexed_cancel_position::<IndexedPayload<T>>(store: &store, oracle: &oracle, ledger: &ledger, position: 4_u64);
  indexed_check::<IndexedPayload<T>>(store: &store, oracle: &oracle, ledger: &ledger);
  indexed_cancel_position::<IndexedPayload<T>>(store: &store, oracle: &oracle, ledger: &ledger, position: 7_u64);
  indexed_check::<IndexedPayload<T>>(store: &store, oracle: &oracle, ledger: &ledger);
  let other = record_store_new::<T, 8, 2>(store_id: 72_u64, retained: retained, record_capacity: 1_u64, index_capacity: 0_u64, heap_capacity: 0_u64, hash_modulus: 0_u64);
  let empty = RecordEmpty();
  let foreign_payload = IndexedPayload::make(serial: 15_u64);
  set ledger.ids[15_u64] = 901_u64;
  let foreign_insert = record_store_insert::<T, 8, 2>(store: &other, id: 901_u64, payload: move foreign_payload);
  match move foreign_insert {
    Ok(value: foreign_handle) => {
      if foreign_handle.object.index != oracle.rows[0_u64].handle.object.index {
        indexed_fail(ledger: &ledger);
      }
      if foreign_handle.object.generation != oracle.rows[0_u64].handle.object.generation {
        indexed_fail(ledger: &ledger);
      }
      let wrong_attach = record_store_attach::<T, 8, 2>(store: &store, handle: foreign_handle);
      indexed_status(ledger: &ledger, actual: wrong_attach, expected: 4_u64);
