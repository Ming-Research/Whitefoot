struct IndexedWords {
  count: u64;
  sum: u64;
}

fn indexed_word_consume(env: &IndexedWords, value: Record<u64>) -> result: unit writes(env) {
  set deref(env).count = deref(env).count +wrap 1_u64;
  set deref(env).sum = deref(env).sum +wrap value.payload;
  return unit;
}

fn indexed_word_insert<const ceiling: u64, const generation_limit: u64>(store: &RecordStore<u64, ceiling, generation_limit>, ledger: &IndexedLedger, id: u64, value: u64) -> handle: RecordHandle writes(store), writes(ledger) {
  let inserted = record_store_insert::<u64, ceiling, generation_limit>(store: store, id: id, payload: value);
  match inserted {
    Ok(value: handle) => {
      return handle;
    }
    Err(error: returned) => {
      indexed_fail(ledger: ledger);
      let object = SlabHandle(index: ceiling, generation: 0_u64);
      return RecordHandle(store_id: deref(store).store_id, object: object);
    }
  }
}

fn indexed_capacity_and_retirement() -> failures: u64 pure {
  doc "Stale weak memberships independently fill the ID map and expiry heap while the Slab has room. Explicit detach and stale expiry release that capacity, so the same live owner can retry. A separate generation-limited store retires its exhausted slot, and a zero-ceiling store admits no owner.";
  let ledger = indexed_ledger();
  let weak = False();
  let store = record_store_new::<u64, 2, 1>(store_id: 81_u64, retained: weak, record_capacity: 2_u64, index_capacity: 2_u64, heap_capacity: 2_u64, hash_modulus: 0_u64);
  let first = indexed_word_insert::<2, 1>(store: &store, ledger: &ledger, id: 10_u64, value: 11_u64);
  let second = indexed_word_insert::<2, 1>(store: &store, ledger: &ledger, id: 20_u64, value: 22_u64);
  let first_id = record_store_attach::<u64, 2, 1>(store: &store, handle: first);
  indexed_status(ledger: &ledger, actual: first_id, expected: 0_u64);
  let second_id = record_store_attach::<u64, 2, 1>(store: &store, handle: second);
  indexed_status(ledger: &ledger, actual: second_id, expected: 0_u64);
  let first_due = record_store_schedule::<u64, 2, 1>(store: &store, handle: first, deadline: 10_u64);
  indexed_status(ledger: &ledger, actual: first_due, expected: 0_u64);
  let second_due = record_store_schedule::<u64, 2, 1>(store: &store, handle: second, deadline: 20_u64);
  indexed_status(ledger: &ledger, actual: second_due, expected: 0_u64);
  let removed = record_store_delete::<u64, 2, 1>(store: &store, handle: first);
  match removed {
    Ok(value: owner) => {
      if owner.payload != 11_u64 {
        indexed_fail(ledger: &ledger);
      }
    }
    Err(error: reason) => {
      indexed_fail(ledger: &ledger);
    }
  }
  let replacement = indexed_word_insert::<2, 1>(store: &store, ledger: &ledger, id: 30_u64, value: 33_u64);
  let id_full = record_store_attach::<u64, 2, 1>(store: &store, handle: replacement);
  indexed_status(ledger: &ledger, actual: id_full, expected: 6_u64);
  let due_full = record_store_schedule::<u64, 2, 1>(store: &store, handle: replacement, deadline: 30_u64);
  indexed_status(ledger: &ledger, actual: due_full, expected: 6_u64);
  let info = record_store_info::<u64, 2, 1>(store: &store, handle: replacement);
  match info {
    Ok(value: present) => {
      if present.id_member {
        indexed_fail(ledger: &ledger);
      }
      if present.position != 2_u64 {
        indexed_fail(ledger: &ledger);
      }
    }
    Err(error: reason) => {
      indexed_fail(ledger: &ledger);
    }
  }
  let stale_detach = record_store_detach::<u64, 2, 1>(store: &store, id: 10_u64, handle: first);
  indexed_status(ledger: &ledger, actual: stale_detach, expected: 0_u64);
  let id_retry = record_store_attach::<u64, 2, 1>(store: &store, handle: replacement);
  indexed_status(ledger: &ledger, actual: id_retry, expected: 0_u64);
  let words = IndexedWords(count: 0_u64, sum: 0_u64);
  let stale_expiry = record_store_expire::<u64, IndexedWords, fn indexed_word_consume, 2, 1>(store: &store, now: 10_u64, env: &words);
  if stale_expiry != 0_u64 {
    indexed_fail(ledger: &ledger);
  }
  if words.count != 0_u64 {
    indexed_fail(ledger: &ledger);
  }
  let due_retry = record_store_schedule::<u64, 2, 1>(store: &store, handle: replacement, deadline: 30_u64);
  indexed_status(ledger: &ledger, actual: due_retry, expected: 0_u64);
  record_store_free::<u64, IndexedWords, fn indexed_word_consume, 2, 1>(store: move store, env: &words);
  if words.count != 2_u64 {
    indexed_fail(ledger: &ledger);
  }
  if words.sum != 55_u64 {
    indexed_fail(ledger: &ledger);
  }
  let limited = record_store_new::<u64, 1, 1>(store_id: 82_u64, retained: weak, record_capacity: 1_u64, index_capacity: 0_u64, heap_capacity: 0_u64, hash_modulus: 0_u64);
  let old = indexed_word_insert::<1, 1>(store: &limited, ledger: &ledger, id: 1_u64, value: 111_u64);
  let removed_old = record_store_delete::<u64, 1, 1>(store: &limited, handle: old);
  match removed_old {
    Ok(value: owner) => {
      if owner.payload != 111_u64 {
        indexed_fail(ledger: &ledger);
      }
    }
    Err(error: reason) => {
      indexed_fail(ledger: &ledger);
    }
  }
  let last = indexed_word_insert::<1, 1>(store: &limited, ledger: &ledger, id: 2_u64, value: 222_u64);
  if last.object.index != old.object.index {
    indexed_fail(ledger: &ledger);
  }
  if last.object.generation != 1_u64 {
    indexed_fail(ledger: &ledger);
  }
  let removed_last = record_store_delete::<u64, 1, 1>(store: &limited, handle: last);
  match removed_last {
    Ok(value: owner) => {
      if owner.payload != 222_u64 {
        indexed_fail(ledger: &ledger);
      }
    }
    Err(error: reason) => {
      indexed_fail(ledger: &ledger);
    }
  }
  let retired = record_store_insert::<u64, 1, 1>(store: &limited, id: 3_u64, payload: 333_u64);
  match retired {
    Ok(value: handle) => {
      indexed_fail(ledger: &ledger);
    }
    Err(error: owner) => {
      if owner != 333_u64 {
        indexed_fail(ledger: &ledger);
      }
    }
  }
  let expired = record_store_schedule::<u64, 1, 1>(store: &limited, handle: old, deadline: 1_u64);
  indexed_status(ledger: &ledger, actual: expired, expected: 3_u64);
  record_store_free::<u64, IndexedWords, fn indexed_word_consume, 1, 1>(store: move limited, env: &words);
  let zero = record_store_new::<u64, 0, 0>(store_id: 83_u64, retained: weak, record_capacity: 0_u64, index_capacity: 0_u64, heap_capacity: 0_u64, hash_modulus: 0_u64);
  let refused = record_store_insert::<u64, 0, 0>(store: &zero, id: 4_u64, payload: 444_u64);
  match refused {
    Ok(value: handle) => {
      indexed_fail(ledger: &ledger);
    }
    Err(error: owner) => {
      if owner != 444_u64 {
        indexed_fail(ledger: &ledger);
      }
    }
  }
  let empty_count = record_store_expire::<u64, IndexedWords, fn indexed_word_consume, 0, 0>(store: &zero, now: 18446744073709551615_u64, env: &words);
  if empty_count != 0_u64 {
    indexed_fail(ledger: &ledger);
  }
  record_store_free::<u64, IndexedWords, fn indexed_word_consume, 0, 0>(store: move zero, env: &words);
  if words.count != 2_u64 {
    indexed_fail(ledger: &ledger);
  }
  return ledger.failures;
}

struct IndexedPositions {
  positions: Array<u64, 8>;
  calls: Array<u64, 8>;
  failures: u64;
}

fn indexed_placed(env: &IndexedPositions, value: &RecordDue, index: u64) -> result: unit reads(value), writes(env) {
  let id = deref(value).id;
  if id < 8_u64 {
    set deref(env).positions[id] = index;
    set deref(env).calls[id] = deref(env).calls[id] +wrap 1_u64;
  } else {
    set deref(env).failures = deref(env).failures +wrap 1_u64;
  }
  return unit;
}

fn indexed_heapify_reports() -> failures: u64 pure {
  doc "Nonempty heapify reports every initial identity, even the untouched final leaf. A subsequent last-entry removal makes no placement call. After repair, all remaining reverse positions name their actual current heap entry.";
  let storage = box_slots_new::<RecordDue>(capacity: 7_u64);
  for (index in 0_u64..7_u64) {
    let deadline = 6_u64 - index;
    if index == 6_u64 {
      set deadline = 1000_u64;
    }
    let handle = SlabHandle(index: index, generation: 0_u64);
    let due_item = RecordDue(deadline: deadline, id: index, handle: handle);
    if storage.inner.len < storage.inner.cap {
      place_back(window: &storage.inner, value: due_item);
    }
  }
  let positions = array_filled::<u64, 8>(value: 8_u64);
  let calls = array_filled::<u64, 8>(value: 0_u64);
  let log = IndexedPositions(positions: positions, calls: calls, failures: 0_u64);
  let empty = RecordEmpty();
  let queue = priority_queue_heapify_indexed::<RecordDueOrder, IndexedPositions, fn indexed_placed, 7>(storage: move storage, order_env: &empty, position_env: &log);
  let length = priority_queue_len::<RecordDue, 7>(queue: &queue);
  if length != 7_u64 {
    set log.failures = log.failures +wrap 1_u64;
  }
  for (index in 0_u64..length) {
    let due_item = priority_queue_peek_at::<RecordDue, RecordEmpty, RecordDue, fn record_read_due, 7>(queue: &queue, index: index, env: &empty);
    if due_item.id < 8_u64 {
      if log.positions[due_item.id] != index {
        set log.failures = log.failures +wrap 1_u64;
      }
      if log.calls[due_item.id] == 0_u64 {
        set log.failures = log.failures +wrap 1_u64;
      }
    } else {
      set log.failures = log.failures +wrap 1_u64;
    }
  }
  if log.positions[6_u64] != 6_u64 {
    set log.failures = log.failures +wrap 1_u64;
  }
  if log.calls[6_u64] != 1_u64 {
    set log.failures = log.failures +wrap 1_u64;
  }
  let before = log.calls;
  if length > 0_u64 {
    let last = length - 1_u64;
    let removed = priority_queue_remove_at_indexed::<RecordDueOrder, IndexedPositions, fn indexed_placed, 7>(queue: &queue, index: last, order_env: &empty, position_env: &log);
    if removed.id != 6_u64 {
      set log.failures = log.failures +wrap 1_u64;
    }
  }
  for (index in 0_u64..8_u64) {
    if log.calls[index] != before[index] {
      set log.failures = log.failures +wrap 1_u64;
    }
  }
  loop @remove {
    let remaining = priority_queue_len::<RecordDue, 7>(queue: &queue);
    if remaining == 0_u64 {
      break @remove;
    }
    let removed = priority_queue_remove_at_indexed::<RecordDueOrder, IndexedPositions, fn indexed_placed, 7>(queue: &queue, index: 0_u64, order_env: &empty, position_env: &log);
    let after = priority_queue_len::<RecordDue, 7>(queue: &queue);
    for (index in 0_u64..after) {
      let due_item = priority_queue_peek_at::<RecordDue, RecordEmpty, RecordDue, fn record_read_due, 7>(queue: &queue, index: index, env: &empty);
      if due_item.id < 8_u64 {
        if log.positions[due_item.id] != index {
          set log.failures = log.failures +wrap 1_u64;
        }
      } else {
        set log.failures = log.failures +wrap 1_u64;
      }
    }
  }
  priority_queue_free::<RecordDue, RecordEmpty, fn record_discard_due, 7>(queue: move queue, env: &empty);
  return log.failures;
}

struct IndexedEdit {
  calls: u64;
}

fn indexed_edit_owner(env: &IndexedEdit, value: &IndexedWide) -> result: IndexedWide writes(env), writes(value) {
  set deref(env).calls = deref(env).calls +wrap 1_u64;
  let replacement = indexed_wide(serial: 41_u64);
  swap(first: &replacement, second: value);
  return move replacement;
}

fn indexed_edit_consume(env: &IndexedWords, value: IndexedWide) -> result: unit writes(env) {
  let serial = indexed_wide_read(value: &value);
  set deref(env).count = deref(env).count +wrap 1_u64;
  set deref(env).sum = deref(env).sum +wrap serial;
  indexed_wide_consume(value: move value);
  return unit;
}

fn indexed_edit_result() -> failures: u64 pure {
  doc "The borrowed Slab editor replaces a nodrop payload and returns the previous nodrop owner. Once removed, an expired handle invokes no callback and therefore creates no replacement allocation or result owner.";
  let ledger = indexed_ledger();
  let slab = slab_new::<IndexedWide, 1, 0>(capacity: 1_u64);
  let payload = indexed_wide(serial: 40_u64);
  let inserted = slab_insert::<IndexedWide, 1, 0>(slab: &slab, value: move payload);
  let edit = IndexedEdit(calls: 0_u64);
  let consumed = IndexedWords(count: 0_u64, sum: 0_u64);
  match move inserted {
    Ok(value: handle) => {
      let changed = slab_edit::<IndexedWide, IndexedEdit, IndexedWide, fn indexed_edit_owner, 1, 0>(slab: &slab, handle: handle, env: &edit);
      match move changed {
        Ok(value: previous) => {
          let serial = indexed_wide_read(value: &previous);
          if serial != 40_u64 {
            indexed_fail(ledger: &ledger);
          }
          indexed_edit_consume(env: &consumed, value: move previous);
        }
        Err(error: missing) => {
          indexed_fail(ledger: &ledger);
        }
      }
      let removed = slab_remove::<IndexedWide, 1, 0>(slab: &slab, handle: handle);
      match move removed {
        Some(value: previous) => {
          let serial = indexed_wide_read(value: &previous);
          if serial != 41_u64 {
            indexed_fail(ledger: &ledger);
          }
          indexed_edit_consume(env: &consumed, value: move previous);
        }
        None() => {
          indexed_fail(ledger: &ledger);
        }
      }
      let expired = slab_edit::<IndexedWide, IndexedEdit, IndexedWide, fn indexed_edit_owner, 1, 0>(slab: &slab, handle: handle, env: &edit);
      match move expired {
        Ok(value: unexpected) => {
          indexed_fail(ledger: &ledger);
          indexed_edit_consume(env: &consumed, value: move unexpected);
        }
        Err(error: missing) => {
        }
      }
    }
    Err(error: returned) => {
      indexed_fail(ledger: &ledger);
      indexed_edit_consume(env: &consumed, value: move returned);
    }
  }
  slab_free::<IndexedWide, IndexedWords, fn indexed_edit_consume, 1, 0>(slab: move slab, env: &consumed);
  if edit.calls != 1_u64 {
    indexed_fail(ledger: &ledger);
  }
  if consumed.count != 2_u64 {
    indexed_fail(ledger: &ledger);
  }
  if consumed.sum != 81_u64 {
    indexed_fail(ledger: &ledger);
  }
  return ledger.failures;
}

fn main() -> status: ExitStatus pure {
  let weak = False();
  let retained = True();
  let drop_weak = indexed_trace::<IndexedDropPayload>(retained: weak);
  if drop_weak != 0_u64 {
    return exit_status(code: 1_u8);
  }
  let drop_retained = indexed_trace::<IndexedDropPayload>(retained: retained);
  if drop_retained != 0_u64 {
    return exit_status(code: 2_u8);
  }
  let wide_weak = indexed_trace::<IndexedWidePayload>(retained: weak);
  if wide_weak != 0_u64 {
    return exit_status(code: 3_u8);
  }
  let wide_retained = indexed_trace::<IndexedWidePayload>(retained: retained);
  if wide_retained != 0_u64 {
    return exit_status(code: 4_u8);
  }
  let capacity = indexed_capacity_and_retirement();
  if capacity != 0_u64 {
    return exit_status(code: 5_u8);
  }
  let positions = indexed_heapify_reports();
  if positions != 0_u64 {
    return exit_status(code: 6_u8);
  }
  let edited = indexed_edit_result();
  if edited != 0_u64 {
    return exit_status(code: 7_u8);
  }
  return exit_status(code: 0_u8);
}
