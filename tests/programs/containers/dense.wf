alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Wide {
  a: u64;
  b: u64;
  c: u64;
  d: u64;
}

fn build_scalar16(seed: u64) -> result: Slots<u64, 16> pure contract {
  ensures result.len >= 16_u64;
  ensures result.len <= 16_u64;
} {
  let values = slots_new::<u64, 16>();
  let state = seed;
  for @fill (
    at in 0_u64..16_u64,
    invariant filled_lo: values.len >= at,
    invariant filled_hi: values.len <= at,
    invariant spare: values.cap - values.len + at >= 16_u64
  ) {
    let product_a = state *wrap 6364136223846793005_u64;
    set state = product_a +wrap 1442695040888963407_u64;
    let a = state;
    place_back(window: &values, value: a);
  }
  return move values;
}

fn dense_scalar16(seed: u64, rounds: u64) -> result: u64 pure {
  let values = build_scalar16(seed: seed);
  let state = seed;
  for (pass in 0_u64..rounds) {
    for (at in 0_u64..16_u64) {
      let previous = values[at];
      let product_a = state *wrap 2862933555777941757_u64;
      set state = product_a +wrap previous;
      let a = state;
      set values[at] = a;
    }
  }
  let checksum = 0_u64;
  for (at in 0_u64..16_u64) {
    let value = values[at];
    let product_a = checksum *wrap 1099511628211_u64;
    set checksum = product_a +wrap value;
  }
  return checksum;
}

fn build_scalar256(seed: u64) -> result: Slots<u64, 256> pure contract {
  ensures result.len >= 256_u64;
  ensures result.len <= 256_u64;
} {
  let values = slots_new::<u64, 256>();
  let state = seed;
  for @fill (
    at in 0_u64..256_u64,
    invariant filled_lo: values.len >= at,
    invariant filled_hi: values.len <= at,
    invariant spare: values.cap - values.len + at >= 256_u64
  ) {
    let product_a = state *wrap 6364136223846793005_u64;
    set state = product_a +wrap 1442695040888963407_u64;
    let a = state;
    place_back(window: &values, value: a);
  }
  return move values;
}

fn dense_scalar256(seed: u64, rounds: u64) -> result: u64 pure {
  let values = build_scalar256(seed: seed);
  let state = seed;
  for (pass in 0_u64..rounds) {
    for (at in 0_u64..256_u64) {
      let previous = values[at];
      let product_a = state *wrap 2862933555777941757_u64;
      set state = product_a +wrap previous;
      let a = state;
      set values[at] = a;
    }
  }
  let checksum = 0_u64;
  for (at in 0_u64..256_u64) {
    let value = values[at];
    let product_a = checksum *wrap 1099511628211_u64;
    set checksum = product_a +wrap value;
  }
  return checksum;
}

fn build_wide16(seed: u64) -> result: Slots<Wide, 16> pure contract {
  ensures result.len >= 16_u64;
  ensures result.len <= 16_u64;
} {
  let values = slots_new::<Wide, 16>();
  let state = seed;
  for @fill (
    at in 0_u64..16_u64,
    invariant filled_lo: values.len >= at,
    invariant filled_hi: values.len <= at,
    invariant spare: values.cap - values.len + at >= 16_u64
  ) {
    let product_a = state *wrap 6364136223846793005_u64;
    set state = product_a +wrap 1442695040888963407_u64;
    let a = state;
    let product_b = state *wrap 6364136223846793005_u64;
    set state = product_b +wrap 1442695040888963407_u64;
    let b = state;
    let product_c = state *wrap 6364136223846793005_u64;
    set state = product_c +wrap 1442695040888963407_u64;
    let c = state;
    let product_d = state *wrap 6364136223846793005_u64;
    set state = product_d +wrap 1442695040888963407_u64;
    let d = state;
    let stored_entry = Wide(a: a, b: b, c: c, d: d);
    place_back(window: &values, value: stored_entry);
  }
  return move values;
}

fn dense_wide16(seed: u64, rounds: u64) -> result: u64 pure {
  let values = build_wide16(seed: seed);
  let state = seed;
  for (pass in 0_u64..rounds) {
    for (at in 0_u64..16_u64) {
      let previous = &values[at];
      let product_a = state *wrap 2862933555777941757_u64;
      set state = product_a +wrap deref(previous).a;
      let a = state;
      let product_b = state *wrap 2862933555777941757_u64;
      set state = product_b +wrap deref(previous).b;
      let b = state;
      let product_c = state *wrap 2862933555777941757_u64;
      set state = product_c +wrap deref(previous).c;
      let c = state;
      let product_d = state *wrap 2862933555777941757_u64;
      set state = product_d +wrap deref(previous).d;
      let d = state;
      let stored_entry = Wide(a: a, b: b, c: c, d: d);
      set values[at] = stored_entry;
    }
  }
  let checksum = 0_u64;
  for (at in 0_u64..16_u64) {
    let value = &values[at];
    let product_a = checksum *wrap 1099511628211_u64;
    set checksum = product_a +wrap deref(value).a;
    let product_b = checksum *wrap 1099511628211_u64;
    set checksum = product_b +wrap deref(value).b;
    let product_c = checksum *wrap 1099511628211_u64;
    set checksum = product_c +wrap deref(value).c;
    let product_d = checksum *wrap 1099511628211_u64;
    set checksum = product_d +wrap deref(value).d;
  }
  return checksum;
}

fn main() -> status: ExitStatus pure {
  let scalar16 = dense_scalar16(seed: 19_u64, rounds: 3_u64);
  if scalar16 != 4763845653406266228_u64 {
    return exit_status(code: 1_u8);
  }
  let scalar256 = dense_scalar256(seed: 19_u64, rounds: 3_u64);
  if scalar256 != 11283685405996036416_u64 {
    return exit_status(code: 1_u8);
  }
  let wide16 = dense_wide16(seed: 19_u64, rounds: 3_u64);
  if wide16 != 1947278976193780304_u64 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
