alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Quad {
  a: u64;
  b: u64;
  c: u64;
  d: u64;
}

fn start(seed: u64) -> result: Quad pure {
  doc "Four words, more than the return registers hold, so the result is constructed through the caller's destination.";
  let second = seed +wrap 1_u64;
  let third = seed +wrap 2_u64;
  let fourth = seed +wrap 3_u64;
  return Quad(a: seed, b: second, c: third, d: fourth);
}

fn mix(value: Quad, amount: u64) -> result: Quad pure {
  doc "Writes a reversed copy of value as a candidate result, then reads value again: a result destination shared with value must not change what those later reads see.";
  let reversed = Quad(a: value.d, b: value.c, c: value.b, d: value.a);
  if amount == 0_u64 {
    return reversed;
  }
  let total = value.a +wrap amount;
  let kept = reversed.a;
  return Quad(a: total, b: kept, c: value.c, d: value.b);
}

fn advance(seed: u64, amount: u64) -> result: Quad pure {
  doc "A copied result is kept, then replaced by a call that reads the copy for the last time, so the call's result may take the copy's storage.";
  let entered = start(seed: seed);
  let step = entered;
  if amount != 0_u64 {
    set step = mix(value: entered, amount: amount);
  }
  return step;
}

fn advance_set(seed: u64, amount: u64, direct: Bool) -> result: Quad pure {
  doc "The same replacement written without a separate binding, under an outer branch whose other arm also sets the place, as an interpreter step is kept and then conditionally charged.";
  let step = Quad(a: 0_u64, b: 0_u64, c: 0_u64, d: 0_u64);
  if direct {
    set step = start(seed: seed);
    if amount != 0_u64 {
      set step = mix(value: step, amount: amount);
    }
  } else {
    set step = start(seed: amount);
  }
  return step;
}

fn main() -> status: ExitStatus pure {
  let mixed = advance(seed: 10_u64, amount: 5_u64);
  if mixed.a != 15_u64 {
    return exit_status(code: 1_u8);
  }
  if mixed.b != 13_u64 {
    return exit_status(code: 2_u8);
  }
  if mixed.c != 12_u64 {
    return exit_status(code: 3_u8);
  }
  if mixed.d != 11_u64 {
    return exit_status(code: 4_u8);
  }
  let plain = advance(seed: 10_u64, amount: 0_u64);
  if plain.a != 10_u64 {
    return exit_status(code: 5_u8);
  }
  if plain.d != 13_u64 {
    return exit_status(code: 6_u8);
  }
  let direct = True();
  let set_mixed = advance_set(seed: 10_u64, amount: 5_u64, direct: direct);
  if set_mixed.a != 15_u64 {
    return exit_status(code: 7_u8);
  }
  if set_mixed.b != 13_u64 {
    return exit_status(code: 8_u8);
  }
  if set_mixed.c != 12_u64 {
    return exit_status(code: 9_u8);
  }
  if set_mixed.d != 11_u64 {
    return exit_status(code: 10_u8);
  }
  let indirect = False();
  let fallback = advance_set(seed: 10_u64, amount: 5_u64, direct: indirect);
  if fallback.a != 5_u64 {
    return exit_status(code: 11_u8);
  }
  return exit_status(code: 0_u8);
}
