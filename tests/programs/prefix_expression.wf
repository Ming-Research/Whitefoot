alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const prefix_input: Array<u8, 5> =[43_u8, 50_u8, 43_u8, 51_u8, 52_u8];

const prefix_incomplete: Array<u8, 2> =[43_u8, 50_u8];

enum Expression {
  Literal(value: u64);
  Add(left: Box<Expression>, right: Box<Expression>);
}

enum ParseError {
  Truncated();
  InvalidToken();
}

struct ParseOutput {
  node: Box<Expression>;
  next: u64;
}

fn parse_expression(input: &[u8], offset: u64) -> result: Result<ParseOutput, ParseError> reads(input) {
  doc "There is one heap and allocation is total, so a cell formation has no refusal arm and the parser carries only the two errors its own grammar can produce [STOR-8, TYPE-9].";
  let size = deref(input).len;
  let available = offset < size;
  if available {
  } else {
    let truncated_error = ParseError::Truncated();
    return Err<ParseOutput, ParseError>(error: truncated_error);
  }
  let token = deref(input)[offset];
  let next = offset + 1_u64;
  let is_add = token == 43_u8;
  if is_add {
    match parse_expression(input: input, offset: next) {
      Err(error: left_error) => {
        return Err<ParseOutput, ParseError>(error: left_error);
      }
      Ok(value: left_output) => {
        let right_offset = left_output.next;
        match parse_expression(input: input, offset: right_offset) {
          Err(error: right_error) => {
            return Err<ParseOutput, ParseError>(error: right_error);
          }
          Ok(value: right_output) => {
            let final_offset = right_output.next;
            let left_node = move left_output.node;
            let right_node = move right_output.node;
            let expression = Expression::Add(left: move left_node, right: move right_node);
            let node = box_new::<Expression>(value: move expression);
            let output = ParseOutput(node: move node, next: final_offset);
            return Ok<ParseOutput, ParseError>(value: move output);
          }
        }
      }
    }
  } else {
    let below_digit = token < 48_u8;
    if below_digit {
      let low_error = ParseError::InvalidToken();
      return Err<ParseOutput, ParseError>(error: low_error);
    }
    let above_digit = token > 57_u8;
    if above_digit {
      let high_error = ParseError::InvalidToken();
      return Err<ParseOutput, ParseError>(error: high_error);
    }
    let digit_byte = token -wrap 48_u8;
    let digit = cvt::<u8, u64>(digit_byte);
    let expression = Expression::Literal(value: digit);
    let node = box_new::<Expression>(value: move expression);
    let output = ParseOutput(node: move node, next: next);
    return Ok<ParseOutput, ParseError>(value: move output);
  }
}

fn evaluate(expression: &Box<Expression>) -> result: Result<u64, Overflow> reads(expression) {
  doc "A Box's content is its field inner, and matching through a reference binds each payload as a reference naming the scrutinee path [TYPE-9, OWN-13].";
  match deref(expression).inner {
    Literal(value: literal_value) => {
      return Ok<u64, Overflow>(value: deref(literal_value));
    }
    Add(left: node_left, right: node_right) => {
      let left_value = propagate evaluate(expression: node_left);
      let right_value = propagate evaluate(expression: node_right);
      return left_value +checked right_value;
    }
  }
}

fn main() -> status: ExitStatus pure {
  doc "Parses one prefix expression from a const table read through a range reference, evaluates it, and checks that a truncated input is refused.";
  let input = &prefix_input[0_u64..5_u64];
  let parsed = parse_expression(input: input, offset: 0_u64);
  match parsed {
    Ok(value: output) => {
      let consumed = output.next;
      if consumed == 5_u64 {
      } else {
        return exit_status(code: 1_u8);
      }
      let root = move output.node;
      match evaluate(expression: &root) {
        Ok(value: evaluated) => {
          if evaluated == 9_u64 {
          } else {
            return exit_status(code: 1_u8);
          }
        }
        Err(error: overflow) => {
          return exit_status(code: 1_u8);
        }
      }
    }
    Err(error: parse_error) => {
      return exit_status(code: 1_u8);
    }
  }
  let incomplete = &prefix_incomplete[0_u64..2_u64];
  let incomplete_result = parse_expression(input: incomplete, offset: 0_u64);
  match incomplete_result {
    Ok(value: unexpected_output) => {
      return exit_status(code: 1_u8);
    }
    Err(error: expected_error) => {
    }
  }
  return exit_status(code: 0_u8);
}
