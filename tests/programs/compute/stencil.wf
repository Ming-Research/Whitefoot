alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn stencil_row(top: &[f64], middle: &[f64], bottom: &[f64], output: &[f64]) -> result: u64 reads(top), reads(middle), reads(bottom), writes(output) contract {
  define width = deref(output).len;
  requires 3_u64 <= width;
  requires width <= deref(top).len;
  requires width <= deref(middle).len;
  requires width <= deref(bottom).len;
} {
  let width = deref(output).len;
  let end = width - 1_u64;
  for (x in 1_u64..end) {
    let left = x - 1_u64;
    let right = x + 1_u64;
    let vertical = fadd.strict(deref(top)[x], deref(bottom)[x]);
    let horizontal = fadd.strict(deref(middle)[left], deref(middle)[right]);
    let total = fadd.strict(vertical, horizontal);
    set deref(output)[x] = fmul.strict(total, 0.25_f64);
  }
  return width;
}

fn stencil(width: u64, height: u64, steps: u64) -> result: Box<Array<f64>> pure contract {
  requires 3_u64 <= width;
  requires width <= 4096_u64;
  requires 3_u64 <= height;
  requires height <= 4096_u64;
  requires steps <= 1024_u64;
} {
  doc "Runs a five-point Jacobi update from distinct positive finite bit patterns derived from squared positions, preserving the initial boundary values. Runtime dimensions determine the contiguous grids; alternating source and destination range references retain source order for each strict floating-point operation.";
  let cells = width * height;
  let current = box_array_filled::<f64>(count: cells, value: 0.0_f64);
  let next = box_array_filled::<f64>(count: cells, value: 0.0_f64);
  for (cell in 0_u64..cells) {
    let position = cell + 1_u64;
    let square = position * position;
    let fraction = square * 256_u64;
    let encoded = 4607182418800017408_u64 + fraction;
    let value = reinterpret::<u64, f64>(encoded);
    set current.inner[cell] = value;
    set next.inner[cell] = value;
  }
  let last_row = height - 1_u64;
  for (t in 0_u64..steps) {
    let parity = t % 2_u64;
    if parity == 0_u64 {
      for (y in 1_u64..last_row) {
        let first = y * width;
        invariant before_row: width <= first {
          use width times (1_u64 <= y);
        }
        let before = first - width;
        let end = first + width;
        let after = end + width;
        invariant after_row: after <= cells {
          use width times (y + 2_u64 <= height);
        }
        let top = &current.inner[before..first];
        let middle = &current.inner[first..end];
        let bottom = &current.inner[end..after];
        let row = &next.inner[first..end];
        let written = stencil_row(top: top, middle: middle, bottom: bottom, output: row);
      }
    } else {
      for (y in 1_u64..last_row) {
        let first = y * width;
        invariant before_row: width <= first {
          use width times (1_u64 <= y);
        }
        let before = first - width;
        let end = first + width;
        let after = end + width;
        invariant after_row: after <= cells {
          use width times (y + 2_u64 <= height);
        }
        let top = &next.inner[before..first];
        let middle = &next.inner[first..end];
        let bottom = &next.inner[end..after];
        let row = &current.inner[first..end];
        let written = stencil_row(top: top, middle: middle, bottom: bottom, output: row);
      }
    }
  }
  let parity = steps % 2_u64;
  if parity == 0_u64 {
    return move current;
  } else {
    return move next;
  }
}

fn release_stencil(output: Box<Array<f64>>) -> result: u64 pure {
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  let output = stencil(width: 5_u64, height: 5_u64, steps: 2_u64);
  let count = output.inner.len;
  if count != 25_u64 {
    return exit_status(code: 1_u8);
  }
  let first = reinterpret::<f64, u64>(output.inner[6_u64]);
  if first != 4607182418800034944_u64 {
    return exit_status(code: 2_u8);
  }
  let center = reinterpret::<f64, u64>(output.inner[12_u64]);
  if center != 4607182418800067328_u64 {
    return exit_status(code: 3_u8);
  }
  let edge = reinterpret::<f64, u64>(output.inner[8_u64]);
  if edge != 4607182418800043136_u64 {
    return exit_status(code: 4_u8);
  }
  let boundary = reinterpret::<f64, u64>(output.inner[0_u64]);
  if boundary != 4607182418800017664_u64 {
    return exit_status(code: 5_u8);
  }
  return exit_status(code: 0_u8);
}
