alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn filter(input: &[f64], taps: &[f64], first: u64, end: u64, last_tap: u64) -> result: Box<Array<f64>> reads(input), reads(taps) contract {
  define input_count = deref(input).len;
  define tap_count = deref(taps).len;
  requires last_tap < tap_count;
  requires last_tap <= 63_u64;
  requires last_tap <= first;
  requires first <= end;
  requires end <= input_count;
  requires end <= 16777216_u64;
} {
  doc "Computes each causal FIR output from the shared history-prefixed input, in ascending tap order with separate strict multiplication and addition. This is the flat form: one independent output position per input position, written directly into the single result cell the map owns.";
  let count = end - first;
  invariant bounded: count <= 16777216_u64;
  let samples = box_array_filled::<f64>(count: count, value: 0.0_f64);
  let tap_count = last_tap + 1_u64;
  for (target in 0_u64..count) {
    let position = first + target;
    let sum = 0.0_f64;
    for (k in 0_u64..tap_count) {
      let source = position - k;
      let coefficient = deref(taps)[k];
      let sample = deref(input)[source];
      let product = fmul.strict(coefficient, sample);
      set sum = fadd.strict(sum, product);
    }
    set samples.inner[target] = sum;
  }
  return move samples;
}

fn release_samples(output: Box<Array<f64>>) -> result: u64 pure {
  return 0_u64;
}

fn command_smoke() -> status: ExitStatus pure {
  let input = array_filled::<f64, 6>(value: 0.0_f64);
  let taps = array_filled::<f64, 3>(value: 0.0_f64);
  set input[0_u64] = 2.0_f64;
  set input[1_u64] = -4.0_f64;
  set input[2_u64] = 8.0_f64;
  set input[3_u64] = 0.0_f64;
  set input[4_u64] = -8.0_f64;
  set input[5_u64] = 4.0_f64;
  set taps[0_u64] = 0.5_f64;
  set taps[1_u64] = -0.25_f64;
  set taps[2_u64] = 0.125_f64;
  let results = filter(input: &input[0_u64..6_u64], taps: &taps[0_u64..3_u64], first: 2_u64, end: 6_u64, last_tap: 2_u64);
  let count = results.inner.len;
  if count != 4_u64 {
    return exit_status(code: 1_u8);
  }
  if feq(results.inner[0_u64], 5.25_f64) {
  } else {
    return exit_status(code: 1_u8);
  }
  if feq(results.inner[1_u64], -2.5_f64) {
  } else {
    return exit_status(code: 1_u8);
  }
  if feq(results.inner[2_u64], -3.0_f64) {
  } else {
    return exit_status(code: 1_u8);
  }
  if feq(results.inner[3_u64], 4.0_f64) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}

fn main() -> status: ExitStatus pure {
  return command_smoke();
}
