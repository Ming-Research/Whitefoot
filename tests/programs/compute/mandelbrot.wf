alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn escape_count(real: f64, imaginary: f64, limit: u64) -> result: u64 pure contract {
  requires limit <= 65536_u64;
} {
  doc "Returns the first iteration whose squared magnitude exceeds four, or the iteration limit. Iteration zero tests z=0; arithmetic uses separate strict binary64 operations.";
  let x = 0.0_f64;
  let y = 0.0_f64;
  for (iteration in 0_u64..limit) {
    let xx = fmul.strict(x, x);
    let yy = fmul.strict(y, y);
    let magnitude = fadd.strict(xx, yy);
    if fgt(magnitude, 4.0_f64) {
      return iteration;
    }
    let xy = fmul.strict(x, y);
    let twice_xy = fadd.strict(xy, xy);
    let difference = fsub.strict(xx, yy);
    set y = fadd.strict(twice_xy, imaginary);
    set x = fadd.strict(difference, real);
  }
  return limit;
}

fn render_points(real: &[f64], imaginary: &[f64], first: u64, end: u64, limit: u64) -> result: Box<Array<u64>> reads(real), reads(imaginary) contract {
  define real_count = deref(real).len;
  define imaginary_count = deref(imaginary).len;
  requires first <= end;
  requires end <= real_count;
  requires end <= imaginary_count;
  requires end <= 1048576_u64;
  requires limit <= 65536_u64;
} {
  doc "Renders independently supplied complex coordinates in input order. The sequential map owns its result cell; iteration counts vary with each point, not its index.";
  let count = end - first;
  let output = box_array_filled::<u64>(count: count, value: 0_u64);
  for (target in 0_u64..count) {
    let point = first + target;
    let value = escape_count(real: deref(real)[point], imaginary: deref(imaginary)[point], limit: limit);
    set output.inner[target] = value;
  }
  return move output;
}

fn release_points(output: Box<Array<u64>>) -> result: u64 pure {
  return 0_u64;
}

fn command_smoke() -> status: ExitStatus pure {
  let real = array_filled::<f64, 3>(value: 0.0_f64);
  let imaginary = array_filled::<f64, 3>(value: 0.0_f64);
  set real[1_u64] = 2.0_f64;
  set real[2_u64] = 3.0_f64;
  let results = render_points(real: &real[0_u64..3_u64], imaginary: &imaginary[0_u64..3_u64], first: 0_u64, end: 3_u64, limit: 16_u64);
  let count = results.inner.len;
  if count != 3_u64 {
    return exit_status(code: 1_u8);
  }
  if results.inner[0_u64] != 16_u64 {
    return exit_status(code: 1_u8);
  }
  if results.inner[1_u64] != 2_u64 {
    return exit_status(code: 1_u8);
  }
  if results.inner[2_u64] != 1_u64 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}

fn main() -> status: ExitStatus pure {
  return command_smoke();
}
