alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct RecordCheck {
  valid: Bool;
  scalars: u64;
}

fn validate_record(input: &[u8], first: u64, end: u64) -> result: RecordCheck reads(input) contract {
  define input_count = deref(input).len;
  requires first <= end;
  requires end <= input_count;
  requires end <= 16777216_u64;
} {
  doc "Validates one complete UTF-8 record and counts Unicode scalar values. Invalid input returns false and zero; empty records, NUL and noncharacters are valid. Records do not share continuation state.";
  let valid = True();
  let invalid = False();
  let scalars = 0_u64;
  let remaining = 0_u8;
  let lower = 128_u8;
  let upper = 191_u8;
  for (
    i in first..end,
    invariant counted: scalars <= i - first
  ) {
    let byte = deref(input)[i];
    if remaining == 0_u8 {
      set scalars = scalars + 1_u64;
      if byte <= 127_u8 {
      } else {
        if byte < 194_u8 {
          return RecordCheck(valid: invalid, scalars: 0_u64);
        }
        if byte <= 223_u8 {
          set remaining = 1_u8;
        } else if byte <= 239_u8 {
          set remaining = 2_u8;
          if byte == 224_u8 {
            set lower = 160_u8;
          }
          if byte == 237_u8 {
            set upper = 159_u8;
          }
        } else if byte <= 244_u8 {
          set remaining = 3_u8;
          if byte == 240_u8 {
            set lower = 144_u8;
          }
          if byte == 244_u8 {
            set upper = 143_u8;
          }
        } else {
          return RecordCheck(valid: invalid, scalars: 0_u64);
        }
      }
    } else {
      if byte < lower {
        return RecordCheck(valid: invalid, scalars: 0_u64);
      }
      if byte > upper {
        return RecordCheck(valid: invalid, scalars: 0_u64);
      }
      set remaining = remaining - 1_u8;
      set lower = 128_u8;
      set upper = 191_u8;
    }
  }
  if remaining != 0_u8 {
    return RecordCheck(valid: invalid, scalars: 0_u64);
  }
  return RecordCheck(valid: valid, scalars: scalars);
}

fn record_summary(input: &[u8], first: u64, end: u64) -> result: u64 reads(input) contract {
  define input_count = deref(input).len;
  requires first <= end;
  requires end <= input_count;
  requires end <= 16777216_u64;
} {
  let verdict = validate_record(input: input, first: first, end: end);
  if verdict.valid {
    return verdict.scalars;
  }
  return 18446744073709551615_u64;
}

fn summarize_records(input: &[u8], offsets: &[u64], first: u64, end: u64) -> result: Box<Array<u64>> reads(input), reads(offsets) contract {
  define input_count = deref(input).len;
  define offset_count = deref(offsets).len;
  requires input_count <= 16777216_u64;
  requires first <= end;
  requires end < offset_count;
  requires end <= 1048576_u64;
} {
  doc "Validates and counts complete independently framed UTF-8 records. Adjacent offsets supply each half-open range; descending or out-of-input offsets produce a distinct malformed-range result for that record. Valid records return their scalar count, invalid UTF-8 returns UINT64_MAX, and malformed ranges return UINT64_MAX-1. Results retain input order.";
  let count = end - first;
  let output = box_array_filled::<u64>(count: count, value: 0_u64);
  for (target in 0_u64..count) {
    let record = first + target;
    let next = record + 1_u64;
    let lower = deref(offsets)[record];
    let upper = deref(offsets)[next];
    let size = deref(input).len;
    let value = if lower > upper {
      give 18446744073709551614_u64;
    } else if upper > size {
      give 18446744073709551614_u64;
    } else {
      let summary = record_summary(input: input, first: lower, end: upper);
      give summary;
    }
    set output.inner[target] = value;
  }
  return move output;
}

fn record_result_release(output: Box<Array<u64>>) -> result: u64 pure {
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  let input = array_filled::<u8, 4>(value: 0_u8);
  set input[0_u64] = 240_u8;
  set input[1_u64] = 144_u8;
  set input[2_u64] = 128_u8;
  set input[3_u64] = 128_u8;
  let offsets = array_filled::<u64, 3>(value: 4_u64);
  set offsets[0_u64] = 0_u64;
  let results = summarize_records(input: &input[0_u64..4_u64], offsets: &offsets[0_u64..3_u64], first: 0_u64, end: 2_u64);
  let count = results.inner.len;
  if count != 2_u64 {
    return exit_status(code: 1_u8);
  }
  let first_count = results.inner[0_u64];
  let second_count = results.inner[1_u64];
  if first_count != 1_u64 {
    return exit_status(code: 1_u8);
  }
  if second_count != 0_u64 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
