alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn sum_block(input: &[u64]) -> result: u64 reads(input) {
  let count = deref(input).len;
  let total = 0_u64;
  for (i in 0_u64..count) {
    set total = total +wrap deref(input)[i];
  }
  return total;
}

fn scan_block(input: &[u64], output: &[u64], base: u64) -> result: u64 reads(input), writes(output) contract {
  requires deref(input).len <= deref(output).len;
} {
  let count = deref(input).len;
  let total = base;
  for (i in 0_u64..count) {
    set deref(output)[i] = total;
    set total = total +wrap deref(input)[i];
  }
  return total;
}

fn prefix(input: &[u64], block_size: u64) -> result: Box<Array<u64>> reads(input) contract {
  requires deref(input).len <= 16777216_u64;
  requires 1_u64 <= block_size;
  requires block_size <= 65536_u64;
} {
  doc "Exclusive scan modulo 2^64. Complete blocks use ordinary range references; the final partial block follows the same scan with the preceding blocks' total.";
  let count = deref(input).len;
  let blocks = count / block_size;
  let covered = blocks * block_size;
  invariant covered_input: covered <= count;
  let sums = box_array_filled::<u64>(count: blocks, value: 0_u64);
  let output = box_array_filled::<u64>(count: count, value: 0_u64);
  for (block in 0_u64..blocks) {
    let first = block * block_size;
    let end = first + block_size;
    invariant block_end: end <= covered {
      use block_size times (block + 1_u64 <= blocks);
    }
    let part = &deref(input)[first..end];
    set sums.inner[block] = sum_block(input: part);
  }
  let total = 0_u64;
  for (block in 0_u64..blocks) {
    let value = sums.inner[block];
    set sums.inner[block] = total;
    set total = total +wrap value;
  }
  for (block in 0_u64..blocks) {
    let first = block * block_size;
    let end = first + block_size;
    invariant block_end: end <= covered {
      use block_size times (block + 1_u64 <= blocks);
    }
    let part = &deref(input)[first..end];
    let destination = &output.inner[first..end];
    let base = sums.inner[block];
    let scanned = scan_block(input: part, output: destination, base: base);
  }
  let tail = &deref(input)[covered..count];
  let tail_destination = &output.inner[covered..count];
  let scanned = scan_block(input: tail, output: tail_destination, base: total);
  return move output;
}

fn release_prefix(output: Box<Array<u64>>) -> result: u64 pure {
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  let input = array_filled::<u64, 17>(value: 0_u64);
  for (i in 0_u64..17_u64) {
    set input[i] = i + 1_u64;
  }
  let output = prefix(input: &input[0_u64..17_u64], block_size: 4_u64);
  let length = output.inner.len;
  if length != 17_u64 {
    return exit_status(code: 1_u8);
  }
  let last = output.inner[16_u64];
  if last != 136_u64 {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
