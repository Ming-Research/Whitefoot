alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn pull_distance(neighbors: &[u64], previous: &[u64], level: u64) -> result: u64 reads(neighbors), reads(previous) contract {
  requires level < previous^.len;
  requires previous^.len <= 67108864_u64;
} {
  let count = previous^.len;
  let slots = neighbors^.len;
  for (slot in 0_u64..slots) {
    let neighbor = neighbors^[slot];
    if neighbor < count {
      if previous^[neighbor] == level {
        return level + 1_u64;
      }
    }
  }
  return count;
}

fn pull_level(edges: &[u64], previous: &[u64], output: &[u64], count: u64, level: u64) -> result: u64 reads(edges), reads(previous), writes(output) contract {
  requires count <= 67108864_u64;
  requires count <= previous^.len;
  requires previous^.len <= count;
  requires count <= output^.len;
  requires 4_u64 * count <= edges^.len;
  requires level < count;
} {
  let covered = count * 4_u64;
  invariant complete_rows: covered <= edges^.len;
  let changed = 0_u64;
  for (vertex in 0_u64..count) {
    let distance = previous^[vertex];
    let result = distance;
    let added = 0_u64;
    if distance == count {
      let first = vertex * 4_u64;
      let end = first + 4_u64;
      invariant row_end: end <= covered {
        use 4 times (vertex + 1_u64 <= count);
      }
      let neighbors = &edges^[first..end];
      let found = pull_distance(neighbors: neighbors, previous: previous, level: level);
      set result = found;
      if found != count {
        set added = 1_u64;
      }
    }
    set output^[vertex] = result;
    set changed = changed +wrap added;
  }
  return changed;
}

fn bfs_pull(edges: &[u64]) -> result: Box<Array<u64>> reads(edges) contract {
  requires edges^.len <= 67108864_u64;
} {
  let slots = edges^.len;
  let count = slots / 4_u64;
  let covered = count * 4_u64;
  invariant complete_rows: covered <= slots;
  let current = box_array_filled::<u64>(count: count, value: count);
  let next = box_array_filled::<u64>(count: count, value: count);
  if count == 0_u64 {
    return move current;
  }
  set current.inner[0_u64] = 0_u64;
  for (level in 0_u64..count) {
    let parity = level % 2_u64;
    if parity == 0_u64 {
      let previous = &current.inner[0_u64..count];
      let output = &next.inner[0_u64..count];
      let changed = pull_level(edges: edges, previous: previous, output: output, count: count, level: level);
      if changed == 0_u64 {
        return move next;
      }
    } else {
      let previous = &next.inner[0_u64..count];
      let output = &current.inner[0_u64..count];
      let changed = pull_level(edges: edges, previous: previous, output: output, count: count, level: level);
      if changed == 0_u64 {
        return move current;
      }
    }
  }
  let parity = count % 2_u64;
  if parity == 0_u64 {
    return move current;
  }
  return move next;
}

fn bfs_sparse(edges: &[u64]) -> result: Box<Array<u64>> reads(edges) contract {
  requires edges^.len <= 67108864_u64;
} {
  doc "Sparse level traversal. Each vertex owns one intrusive frontier link, so no queue-capacity theorem or per-vertex allocation is needed. The count sentinel denotes both an absent edge and an undiscovered distance. A vertex joins a frontier only when its distance leaves the sentinel, so a frontier links at most count vertices and its walk is a counted loop of count steps.";
  let slots = edges^.len;
  let count = slots / 4_u64;
  let distance = box_array_filled::<u64>(count: count, value: count);
  let covered = count * 4_u64;
  invariant complete_rows: covered <= slots;
  let links = box_array_filled::<u64>(count: count, value: count);
  if count == 0_u64 {
    return move distance;
  }
  set distance.inner[0_u64] = 0_u64;
  let frontier = 0_u64;
  for (level in 0_u64..count) {
    if frontier >= count {
      break;
    }
    let next = count;
    let vertex = frontier;
    for (linked in 0_u64..count) {
      if vertex >= count {
        break;
      }
      let first = vertex * 4_u64;
      let end = first + 4_u64;
      invariant row_end: end <= covered {
        use 4 times (vertex + 1_u64 <= count);
      }
      for (slot in first..end) {
        let neighbor = edges^[slot];
        if neighbor < count {
          if distance.inner[neighbor] == count {
            set distance.inner[neighbor] = level + 1_u64;
            set links.inner[neighbor] = next;
            set next = neighbor;
          }
        }
      }
      set vertex = links.inner[vertex];
    }
    set frontier = next;
  }
  return move distance;
}

fn bfs(edges: &[u64], pull: u64) -> result: Box<Array<u64>> reads(edges) contract {
  requires edges^.len <= 67108864_u64;
} {
  doc "Distances from vertex zero in a graph with four adjacency slots per vertex. Out-of-range slots are absent edges; trailing incomplete rows are ignored. Pull traverses the reverse graph, so the comparison fixtures are undirected.";
  if pull != 0_u64 {
    return bfs_pull(edges: edges);
  }
  return bfs_sparse(edges: edges);
}

fn release_bfs(output: Box<Array<u64>>) -> result: u64 pure {
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  let edges = array_filled::<u64, 12>(value: 3_u64);
  set edges[0_u64] = 1_u64;
  set edges[4_u64] = 0_u64;
  set edges[5_u64] = 2_u64;
  set edges[8_u64] = 1_u64;
  let output = bfs(edges: &edges[0_u64..12_u64], pull: 0_u64);
  let count = output.inner.len;
  if count != 3_u64 {
    return exit_status(code: 1_u8);
  }
  if output.inner[2_u64] != 2_u64 {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
