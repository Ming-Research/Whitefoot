alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn count_block(input: &[u64], counters: &[u64]) -> result: u64 reads(input), writes(counters) contract {
  requires 1_u64 <= deref(counters).len;
} {
  let count = deref(input).len;
  let buckets = deref(counters).len;
  for (i in 0_u64..count) {
    let key = deref(input)[i];
    let bucket = key % buckets;
    let previous = deref(counters)[bucket];
    set deref(counters)[bucket] = previous +wrap 1_u64;
  }
  return count;
}

fn merge_bucket(counters: &[u64], bucket: u64, buckets: u64) -> result: u64 reads(counters) contract {
  requires 1_u64 <= buckets;
  requires buckets <= 256_u64;
  requires deref(counters).len <= 4294967552_u64;
  requires bucket < buckets;
} {
  let count = deref(counters).len;
  let rows = count / buckets;
  let covered = rows * buckets;
  invariant covered_counters: covered <= count;
  let total = 0_u64;
  for (row in 0_u64..rows) {
    let start = row * buckets;
    let end = start + buckets;
    invariant row_end: end <= covered {
      use buckets times (row + 1_u64 <= rows);
    }
    let at = start + bucket;
    set total = total +wrap deref(counters)[at];
  }
  return total;
}

fn histogram(input: &[u64], block_size: u64, buckets: u64) -> result: Box<Array<u64>> reads(input) contract {
  requires deref(input).len <= 16777216_u64;
  requires 1_u64 <= block_size;
  requires block_size <= 65536_u64;
  requires 1_u64 <= buckets;
  requires buckets <= 256_u64;
} {
  doc "Counts keys modulo the runtime bucket count. Each input block scatters into its own counter range, and a separate phase merges the private counters.";
  let count = deref(input).len;
  let blocks = count / block_size;
  let covered = blocks * block_size;
  invariant covered_input: covered <= count;
  let full_cells = blocks * buckets;
  let cells = full_cells + buckets;
  let counters = box_array_filled::<u64>(count: cells, value: 0_u64);
  let output = box_array_filled::<u64>(count: buckets, value: 0_u64);
  for (block in 0_u64..blocks) {
    let first = block * block_size;
    let end = first + block_size;
    invariant input_end: end <= covered {
      use block_size times (block + 1_u64 <= blocks);
    }
    let row_start = block * buckets;
    let row_end = row_start + buckets;
    invariant workspace_end: row_end <= cells {
      use buckets times (block <= blocks);
    }
    let part = &deref(input)[first..end];
    let workspace = &counters.inner[row_start..row_end];
    let counted = count_block(input: part, counters: workspace);
  }
  let tail = &deref(input)[covered..count];
  let spare = &counters.inner[full_cells..cells];
  let counted = count_block(input: tail, counters: spare);
  for (bucket in 0_u64..buckets) {
    let all = &counters.inner[0_u64..cells];
    set output.inner[bucket] = merge_bucket(counters: all, bucket: bucket, buckets: buckets);
  }
  return move output;
}

fn release_histogram(output: Box<Array<u64>>) -> result: u64 pure {
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  let input = array_filled::<u64, 17>(value: 0_u64);
  for (i in 0_u64..17_u64) {
    set input[i] = i;
  }
  let output = histogram(input: &input[0_u64..17_u64], block_size: 4_u64, buckets: 3_u64);
  let length = output.inner.len;
  if length != 3_u64 {
    return exit_status(code: 1_u8);
  }
  let first = output.inner[0_u64];
  let second = output.inner[1_u64];
  let third = output.inner[2_u64];
  if first != 6_u64 {
    return exit_status(code: 2_u8);
  }
  if second != 6_u64 {
    return exit_status(code: 3_u8);
  }
  if third != 5_u64 {
    return exit_status(code: 4_u8);
  }
  return exit_status(code: 0_u8);
}
