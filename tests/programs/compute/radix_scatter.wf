alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Chunk {
  low: Slots<u64, 256>;
  high: Slots<u64, 256>;
}

fn append_selected(values: &Slots<u64, 256>, value: u64, selected: Bool) -> result: unit writes(values) contract {
  requires values^.len < 256_u64;
  ensures values^.len <= entry(values)^.len + 1_u64;
} {
  if selected {
    place_back(window: values, value: value);
    return unit;
  }
  return unit;
}

fn partition_block(input: &[u64], bit: u32) -> (low: Slots<u64, 256>, high: Slots<u64, 256>) reads(input) contract {
  requires input^.len <= 256_u64;
  requires bit < 64_u32;
  ensures low.len <= input^.len;
  ensures high.len <= input^.len;
} {
  let count = input^.len;
  let lows = slots_new::<u64, 256>();
  let highs = slots_new::<u64, 256>();
  for (
    i in 0_u64..count,
    invariant low_count: lows.len <= i,
    invariant high_count: highs.len <= i
  ) {
    let key = input^[i];
    let shifted = ishr(key, bit);
    let digit = shifted % 2_u64;
    let is_low = digit == 0_u64;
    let is_high = digit != 0_u64;
    append_selected(values: &lows, value: key, selected: is_low);
    append_selected(values: &highs, value: key, selected: is_high);
  }
  return move lows, move highs;
}

fn write_chunk(input: &[u64], bit: u32, output: &[Option<Chunk>]) -> result: u64 reads(input), writes(output) contract {
  requires input^.len <= 256_u64;
  requires bit < 64_u32;
  requires 1_u64 <= output^.len;
} {
  let (low, high) = partition_block(input: input, bit: bit);
  let chunk = Chunk(low: move low, high: move high);
  set output^[0_u64] = Some<Chunk>(value: move chunk);
  return input^.len;
}

fn tally(chunk: &Option<Chunk>, previous_low: u64, previous_high: u64) -> (low: u64, high: u64) reads(chunk) contract {
  requires previous_low <= 16777472_u64;
  requires previous_high <= 16777472_u64;
  ensures low <= previous_low + 256_u64;
  ensures high <= previous_high + 256_u64;
} {
  match chunk^ {
    None() => {
      return previous_low, previous_high;
    }
    Some(value: payload) => {
      let low_count = payload^.low.len;
      let high_count = payload^.high.len;
      let low_sum = previous_low + low_count;
      let high_sum = previous_high + high_count;
      return low_sum, high_sum;
    }
  }
}

fn copy_run(values: &Slots<u64, 256>, output: &[u64]) -> result: u64 reads(values), writes(output) contract {
  requires values^.len <= output^.len;
} {
  let count = values^.len;
  for (i in 0_u64..count) {
    set output^[i] = values^[i];
  }
  return count;
}

fn copy_values(input: &[u64], output: &[u64]) -> result: u64 reads(input), writes(output) contract {
  requires input^.len <= output^.len;
} {
  let count = input^.len;
  for (i in 0_u64..count) {
    set output^[i] = input^[i];
  }
  return count;
}

fn pack_payload(payload: &Chunk, chunks: &Box<Slots<Option<Chunk>>>, first: u64, lows: &[u64], highs: &[u64]) -> result: u64 reads(payload), reads(chunks), writes(lows), writes(highs) contract {
  requires chunks^.inner.len <= 16777217_u64;
  requires first < chunks^.inner.len;
  requires 256_u64 * chunks^.inner.len <= lows^.len + 256_u64 * first;
  requires 256_u64 * chunks^.inner.len <= highs^.len + 256_u64 * first;
} {
  let blocks = chunks^.inner.len;
  let low_capacity = lows^.len;
  let high_capacity = highs^.len;
  invariant low_room: 256_u64 <= low_capacity {
    use 256 times (first + 1_u64 <= blocks);
    use (256_u64 * blocks <= low_capacity + 256_u64 * first);
  }
  invariant high_room: 256_u64 <= high_capacity {
    use 256 times (first + 1_u64 <= blocks);
    use (256_u64 * blocks <= high_capacity + 256_u64 * first);
  }
  let after = first + 1_u64;
  let low_count = payload^.low.len;
  let high_count = payload^.high.len;
  let first_low = &lows^[0_u64..low_count];
  let rest_low = &lows^[low_count..low_capacity];
  let first_high = &highs^[0_u64..high_count];
  let rest_high = &highs^[high_count..high_capacity];
  let copied_low = copy_run(values: &payload^.low, output: first_low);
  let copied_high = copy_run(values: &payload^.high, output: first_high);
  let remaining = pack_chunks(chunks: chunks, first: after, lows: rest_low, highs: rest_high);
  return 0_u64;
}

fn pack_chunks(chunks: &Box<Slots<Option<Chunk>>>, first: u64, lows: &[u64], highs: &[u64]) -> result: u64 reads(chunks), writes(lows), writes(highs) contract {
  requires chunks^.inner.len <= 16777217_u64;
  requires first <= chunks^.inner.len;
  requires 256_u64 * chunks^.inner.len <= lows^.len + 256_u64 * first;
  requires 256_u64 * chunks^.inner.len <= highs^.len + 256_u64 * first;
} {
  let blocks = chunks^.inner.len;
  if first == blocks {
    return 0_u64;
  }
  let chunk = &chunks^.inner[first];
  let after = first + 1_u64;
  match chunk^ {
    None() => {
      return pack_chunks(chunks: chunks, first: after, lows: lows, highs: highs);
    }
    Some(value: payload) => {
      return pack_payload(payload: payload, chunks: chunks, first: first, lows: lows, highs: highs);
    }
  }
}

fn radix_scatter(input: &[u64], bit: u32) -> result: Box<Array<u64>> reads(input) contract {
  requires input^.len <= 16777216_u64;
  requires bit < 64_u32;
} {
  doc "Stable distribution by one runtime-selected bit. Fixed-capacity local runs carry bounded lengths; a recursive chain packs each digit through disjoint output ranges. Chunk storage, chain depth, and final copies are measured costs.";
  let count = input^.len;
  let full_blocks = count / 256_u64;
  let covered = full_blocks * 256_u64;
  let blocks = full_blocks + 1_u64;
  let capacity = covered + 256_u64;
  invariant capacity_limit: capacity <= 16777472_u64;
  let chunks = box_slots_new::<Option<Chunk>>(capacity: blocks);
  for (
    index in 0_u64..blocks,
    invariant filled: chunks.inner.len >= index,
    invariant bounded: chunks.inner.len <= index,
    invariant spare: chunks.inner.cap - chunks.inner.len + index >= blocks
  ) {
    let vacant = None<Chunk>();
    place_back(window: &chunks.inner, value: move vacant);
  }
  invariant complete_min: chunks.inner.len >= blocks;
  invariant complete_max: chunks.inner.len <= blocks;
  for (block in 0_u64..blocks) {
    let first = block * 256_u64;
    let end = first + 256_u64;
    invariant block_start: first <= covered {
      use 256 times (block <= full_blocks);
    }
    if end <= count {
      let source = &input^[first..end];
      let after = block + 1_u64;
      let destination = &chunks.inner[block..after];
      let wrote = write_chunk(input: source, bit: bit, output: destination);
    } else {
      let source = &input^[first..count];
      let after = block + 1_u64;
      let destination = &chunks.inner[block..after];
      let wrote = write_chunk(input: source, bit: bit, output: destination);
    }
  }
  let low_total = 0_u64;
  let high_total = 0_u64;
  for (
    block in 0_u64..blocks,
    invariant low_bound: low_total <= block * 256_u64,
    invariant high_bound: high_total <= block * 256_u64
  ) {
    invariant low_capacity: low_total <= capacity {
      use low_bound;
      use 256 times (block <= blocks);
    }
    invariant high_capacity: high_total <= capacity {
      use high_bound;
      use 256 times (block <= blocks);
    }
    let (next_low, next_high) = tally(chunk: &chunks.inner[block], previous_low: low_total, previous_high: high_total);
    invariant next_low_bound: next_low <= 256_u64 * block + 256_u64;
    invariant next_high_bound: next_high <= 256_u64 * block + 256_u64;
    set low_total = next_low;
    set high_total = next_high;
  }
  invariant full_low_bound: low_total <= capacity;
  invariant full_high_bound: high_total <= capacity;
  let lows = box_array_filled::<u64>(count: capacity, value: 0_u64);
  let highs = box_array_filled::<u64>(count: capacity, value: 0_u64);
  invariant chunks_fit_capacity: 256_u64 * chunks.inner.len <= capacity {
    use 256 times (chunks.inner.len <= blocks);
  }
  let source = &chunks;
  let low_output = &lows.inner[0_u64..capacity];
  let high_output = &highs.inner[0_u64..capacity];
  let packed = pack_chunks(chunks: source, first: 0_u64, lows: low_output, highs: high_output);
  let output_count = low_total + high_total;
  invariant output_limit: output_count <= 33554944_u64;
  let output = box_array_filled::<u64>(count: output_count, value: 0_u64);
  let low_source = &lows.inner[0_u64..low_total];
  let high_source = &highs.inner[0_u64..high_total];
  let low_destination = &output.inner[0_u64..low_total];
  let high_destination = &output.inner[low_total..output_count];
  let copied_low = copy_values(input: low_source, output: low_destination);
  let copied_high = copy_values(input: high_source, output: high_destination);
  return move output;
}

fn release_radix_scatter(output: Box<Array<u64>>) -> result: u64 pure {
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  let input = box_array_filled::<u64>(count: 8209_u64, value: 0_u64);
  for (i in 0_u64..8209_u64) {
    set input.inner[i] = i;
  }
  let result = radix_scatter(input: &input.inner[0_u64..8209_u64], bit: 0_u32);
  let length = result.inner.len;
  if length != 8209_u64 {
    return exit_status(code: 3_u8);
  }
  for (i in 0_u64..4105_u64) {
    let expected = i * 2_u64;
    if result.inner[i] != expected {
      return exit_status(code: 1_u8);
    }
  }
  for (i in 0_u64..4104_u64) {
    let at = i + 4105_u64;
    let even = i * 2_u64;
    let expected = even + 1_u64;
    if result.inner[at] != expected {
      return exit_status(code: 2_u8);
    }
  }
  return exit_status(code: 0_u8);
}
