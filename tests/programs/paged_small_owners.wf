alias MemoryMeter = std::process::MemoryMeter;

fn counted(meter: &MemoryMeter, before: u64, expected: u64) -> result: Bool writes(meter) {
  let observed = std::process::heap_in_use(meter: meter);
  if observed >= before {
    let bytes = observed - before;
    if bytes == expected {
      return True();
    } else {
      return False();
    }
  } else {
    return False();
  }
}

fn small_owners(meter: &MemoryMeter, before: u64) -> result: u8 writes(meter) {
  doc "A zero-capacity Paged allocates nothing; its first page grows through powers of two until B and releases every counted byte.";
  let p = box_paged_new::<u64>(capacity: 0_u64);
  let empty = counted(meter: meter, before: before, expected: 0_u64);
  if bnot(empty) {
    return 1_u8;
  }
  grow_paged(cell: &p, capacity: 0_u64);
  let kept = counted(meter: meter, before: before, expected: 0_u64);
  if bnot(kept) {
    return 2_u8;
  }
  let empty_owner = box_paged_new::<u64>(capacity: 0_u64);
  release::<Box<Paged<u64>>>(value: move empty_owner);
  let empty_released = counted(meter: meter, before: before, expected: 0_u64);
  if bnot(empty_released) {
    return 17_u8;
  }
  grow_paged(cell: &p, capacity: 1_u64);
  place_back(window: &p.inner, value: 73_u64);
  let one = counted(meter: meter, before: before, expected: 40_u64);
  if bnot(one) {
    return 3_u8;
  }
  grow_paged(cell: &p, capacity: 2_u64);
  place_back(window: &p.inner, value: 1_u64);
  let two = counted(meter: meter, before: before, expected: 48_u64);
  if bnot(two) {
    return 4_u8;
  }
  grow_paged(cell: &p, capacity: 3_u64);
  place_back(window: &p.inner, value: 2_u64);
  let rounded = counted(meter: meter, before: before, expected: 64_u64);
  if bnot(rounded) {
    return 5_u8;
  }
  grow_paged(cell: &p, capacity: 4_u64);
  let same_page = counted(meter: meter, before: before, expected: 64_u64);
  if bnot(same_page) {
    return 14_u8;
  }
  grow_paged(cell: &p, capacity: 512_u64);
  for (
    i in 3_u64..512_u64,
    invariant length: p.inner.len == i
  ) {
    place_back(window: &p.inner, value: i);
  }
  let full = counted(meter: meter, before: before, expected: 4128_u64);
  if bnot(full) {
    return 7_u8;
  }
  grow_paged(cell: &p, capacity: 513_u64);
  place_back(window: &p.inner, value: 512_u64);
  let second_page = counted(meter: meter, before: before, expected: 8232_u64);
  if bnot(second_page) {
    return 8_u8;
  }
  if p.inner[0_u64] != 73_u64 {
    return 9_u8;
  }
  for (i in 1_u64..513_u64) {
    if p.inner[i] != i {
      return 10_u8;
    }
  }
  release::<Box<Paged<u64>>>(value: move p);
  let released = counted(meter: meter, before: before, expected: 0_u64);
  if bnot(released) {
    return 11_u8;
  }
  let small = box_paged_new::<u64>(capacity: 3_u64);
  place_back(window: &small.inner, value: 19_u64);
  let constructed = counted(meter: meter, before: before, expected: 64_u64);
  if bnot(constructed) {
    return 12_u8;
  }
  release::<Box<Paged<u64>>>(value: move small);
  let small_released = counted(meter: meter, before: before, expected: 0_u64);
  if bnot(small_released) {
    return 13_u8;
  }
  let zero_stride = box_paged_new::<Array<u8, 0>>(capacity: 1_u64);
  let value = array_filled::<u8, 0>(value: 0_u8);
  place_back(window: &zero_stride.inner, value: value);
  grow_paged(cell: &zero_stride, capacity: 3_u64);
  let zero_stride_held = counted(meter: meter, before: before, expected: 33_u64);
  if bnot(zero_stride_held) {
    return 15_u8;
  }
  release::<Box<Paged<Array<u8, 0>>>>(value: move zero_stride);
  let zero_stride_released = counted(meter: meter, before: before, expected: 0_u64);
  if bnot(zero_stride_released) {
    return 16_u8;
  }
  return 0_u8;
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  let std::process::Inputs(cwd: directory, handles: factory, memory_meter: meter, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let before = std::process::heap_in_use(meter: &meter);
  let code = small_owners(meter: &meter, before: before);
  return std::process::exit_status(code: code);
}
