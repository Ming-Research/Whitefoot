alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const names: Array<u8, 4> =[97_u8, 98_u8, 99_u8, 100_u8];

struct Mail {
  boxes: KeyedTable<u64>;
  closed: u64;
  received: u64;
}

fn empty(held: &Option<u64>) -> result: Bool reads(held) {
  match held^ {
    Some(value: unused) => {
      return False();
    }
    None() => {
      return True();
    }
  }
}

fn full(held: &Option<u64>) -> result: Bool reads(held) {
  match held^ {
    Some(value: unused) => {
      return True();
    }
    None() => {
      return False();
    }
  }
}

fn ready(closed: &u64, held: &Option<u64>) -> result: Bool reads(closed), reads(held) {
  if closed^ == 1_u64 {
    return True();
  }
  return full(held: held);
}

fn post(mail: Shared<Mail>, at: u64) -> result: unit pure waits contract {
  requires at < 4_u64;
} {
  doc "Puts the values 1 to 500 into one box, each once the box is empty.";
  let names_end = at + 1_u64;
  let key = &names[at..names_end];
  for @send (value in 1_u64..501_u64) {
    atomic m = &mail, slot = &m^.boxes[key] when empty(held: slot) {
      set slot^ = Some<u64>(value: value);
    }
  }
  return unit;
}

fn fetch(mail: Shared<Mail>, at: u64) -> result: unit pure waits contract {
  requires at < 4_u64;
} {
  doc "Takes 500 values out of one box, each once the box holds one, and adds them to the state's total.";
  let names_end = at + 1_u64;
  let key = &names[at..names_end];
  for @take (count in 0_u64..500_u64) {
    atomic m = &mail, slot = &m^.boxes[key] when full(held: slot) {
      match slot^ {
        Some(value: seen) => {
          set m^.received = m^.received +wrap seen^;
        }
        None() => {
        }
      }
      set slot^ = None<u64>();
    }
  }
  return unit;
}

fn wait_ready(mail: Shared<Mail>, waited: Shared<u64>) -> result: unit pure waits {
  doc "Waits until the first box holds a value or the mail is closed, then counts its wake.";
  let key = &names[0_u64..1_u64];
  atomic m = &mail, slot = &m^.boxes[key] when ready(closed: &m^.closed, held: slot) {
    let unused = full(held: slot);
  }
  atomic count = &waited {
    set count^ = count^ +wrap 1_u64;
  }
  return unit;
}

fn close(mail: Shared<Mail>) -> result: unit pure waits {
  atomic m = &mail {
    set m^.closed = 1_u64;
  }
  return unit;
}

fn exchange(mail: &Shared<Mail>, waited: &Shared<u64>) -> result: unit reads(mail), reads(waited) waits {
  for @pair (at in 0_u64..4_u64) {
    let sender = shared_share::<Mail>(shared: mail);
    let taker = shared_share::<Mail>(shared: mail);
    spawn post(mail: move sender, at: at);
    spawn fetch(mail: move taker, at: at);
  }
  for @watcher (index in 0_u64..2_u64) {
    let watching = shared_share::<Mail>(shared: mail);
    let counting = shared_share::<u64>(shared: waited);
    spawn wait_ready(mail: move watching, waited: move counting);
  }
  let closer = shared_share::<Mail>(shared: mail);
  spawn close(mail: move closer);
  return unit;
}

fn main() -> status: ExitStatus pure waits {
  doc "Four pairs of contexts pass 500 values each through one entry of a table, a sender waiting for its box to be empty and a taker for it to hold a value, so each guard reads an entry and every wake comes from a write to the table. Two more contexts wait on a guard that reads an entry and the state's own field together, which a closing context sets. The total is the sum of 1 to 500 four times, every box ends empty and both waiters wake, on any number of drivers; the status names the first wrong count.";
  let table = keyed_table_new::<u64>(capacity: 0_u64);
  let state = Mail(boxes: move table, closed: 0_u64, received: 0_u64);
  let mail = shared_new::<Mail>(value: move state);
  let waited = shared_new::<u64>(value: 0_u64);
  exchange(mail: &mail, waited: &waited);
  let total = 0_u64;
  let left = 1_u64;
  atomic m = &mail, t = &m^.boxes {
    set total = m^.received;
    set left = keyed_table_count::<u64>(table: t);
  }
  if total != 501000_u64 {
    return exit_status(code: 1_u8);
  }
  if left != 0_u64 {
    return exit_status(code: 2_u8);
  }
  let woken = 0_u64;
  atomic count = &waited {
    set woken = count^;
  }
  if woken != 2_u64 {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
