alias Args = std::text::Args;
alias DirectoryRead = std::fs::DirectoryRead;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias OutputStream = std::io::OutputStream;
alias arg_get = std::text::arg_get;
alias args_count = std::text::args_count;
alias close_directory = std::fs::close_directory;
alias close_read = std::fs::close_read;
alias exit_status = std::process::exit_status;
alias host_bytes_len = std::text::host_bytes_len;
alias host_copy_bytes = std::text::host_copy_bytes;
alias host_copy_utf8 = std::text::host_copy_utf8;
alias host_utf8_len = std::text::host_utf8_len;
alias open_read = std::fs::open_read;
alias read_at = std::fs::read_at;
alias relative_path = std::fs::relative_path;
alias write_once = std::io::write_once;

fn exercise(args: &Args, cwd: &DirectoryRead, out: &OutputStream, err: &OutputStream, files: &HandleFactory) -> status: ExitStatus reads(args), reads(cwd), writes(out), writes(err), writes(files) {
  doc "The argument bytes, their UTF-8 encoding, the file pages and both output channels all travel through caller-formed range references over two frame-resident arrays; writes subsumes the read of the same path, so no path is named twice [EFF-1].";
  let echo = array_filled::<u8, 64>(value: 0_u8);
  let name_length = 0_u64;
  let arguments = args_count(args: args);
  if arguments == 2_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  match arg_get(args: args, position: 1_u64) {
    Ok(value: text) => {
      set name_length = host_bytes_len(value: &text);
      let name_window = &echo[0_u64..64_u64];
      match host_copy_bytes(value: &text, destination: name_window, start: 0_u64, end: 64_u64) {
        Ok(value: copied) => {
        }
        Err(error: problem) => {
          return exit_status(code: 3_u8);
        }
      }
      match host_utf8_len(value: &text) {
        Ok(value: measured) => {
          if measured == name_length {
          } else {
            return exit_status(code: 14_u8);
          }
        }
        Err(error: invalid) => {
          return exit_status(code: 4_u8);
        }
      }
      let utf8_window = &echo[0_u64..64_u64];
      match host_copy_utf8(value: &text, destination: utf8_window, start: 0_u64, end: 64_u64) {
        Ok(value: encoded) => {
        }
        Err(error: problem) => {
          return exit_status(code: 5_u8);
        }
      }
      match relative_path(value: move text) {
        Ok(value: path) => {
          match open_read(factory: files, root: cwd, path: &path) {
            Ok(value: file) => {
              let page = array_filled::<u8, 16>(value: 0_u8);
              let total = 0_u64;
              let file_offset = 0_u64;
              let failed = 0_u8;
              loop @copy {
                let chunk = 0_u64;
                let page_window = &page[0_u64..16_u64];
                match read_at(factory: files, file: &file, destination: page_window, file_offset: file_offset, start: 0_u64, end: 16_u64) {
                  Ok(value: n) => {
                    set chunk = n;
                    set file_offset = file_offset +wrap n;
                  }
                  Err(error: read_stop) => {
                    match read_stop {
                      ReadEnd() => {
                        break @copy;
                      }
                      ReadFailed(error: problem) => {
                        set failed = 8_u8;
                        break @copy;
                      }
                    }
                  }
                }
                let page_length = page.len;
                let chunk_fits = chunk <= page_length;
                if chunk_fits {
                } else {
                  close_read(factory: files, file: move file);
                  return exit_status(code: 12_u8);
                }
                match write_once(factory: files, output: out, source: page_window, start: 0_u64, end: chunk) {
                  Ok(value: written) => {
                    set total = total +wrap written;
                  }
                  Err(error: problem) => {
                    set failed = 9_u8;
                    break @copy;
                  }
                }
              }
              if failed == 0_u8 {
              } else {
                close_read(factory: files, file: move file);
                return exit_status(code: failed);
              }
              let echo_length = echo.len;
              let name_fits = name_length <= echo_length;
              if name_fits {
              } else {
                close_read(factory: files, file: move file);
                return exit_status(code: 13_u8);
              }
              let echo_window = &echo[0_u64..64_u64];
              match write_once(factory: files, output: err, source: echo_window, start: 0_u64, end: name_length) {
                Ok(value: written) => {
                  let masked = iand(total, 255_u64);
                  let code = cvt::<u64, u8>(masked);
                  close_read(factory: files, file: move file);
                  return exit_status(code: code);
                }
                Err(error: problem) => {
                  close_read(factory: files, file: move file);
                  return exit_status(code: 10_u8);
                }
              }
            }
            Err(error: problem) => {
              return exit_status(code: 6_u8);
            }
          }
        }
        Err(error: rejected) => {
          return exit_status(code: 7_u8);
        }
      }
    }
    Err(error: absent) => {
      return exit_status(code: 11_u8);
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "PRE-1 ordinary Inputs are destructured once; the referenced operation chain returns before the initial directory is explicitly closed on every exit.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: files, stdin: unused_stdin) = move inputs;
  let outcome = exercise(args: &args, cwd: &cwd, out: &out, err: &err, files: &files);
  close_directory(factory: &files, directory: move cwd);
  return move outcome;
}
