alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn decode_case(input: &[u8], out: &[u8]) -> result: u64 reads(input), writes(out) {
  doc "The probe driver hands the decoder two range references and reads back one status word per case [REF-4].";
  match inflate(out: out, input: input) {
    Ok(value: written) => {
      return written;
    }
    Err(error: reason) => {
      match reason {
        Truncated() => {
          return 18446744073709551615_u64;
        }
        InvalidStoredLength() => {
          return 18446744073709551614_u64;
        }
        InvalidHuffmanTree() => {
          return 18446744073709551613_u64;
        }
        InvalidHuffmanCode() => {
          return 18446744073709551612_u64;
        }
        InvalidDistance() => {
          return 18446744073709551611_u64;
        }
        InvalidBlockType() => {
          return 18446744073709551610_u64;
        }
        OutputFull() => {
          return 18446744073709551609_u64;
        }
      }
    }
  }
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
