alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;

fn low_byte(v: u64) -> result: u8 pure {
  let low = iand(v, 255_u64);
  match cvt.checked::<u64, u8>(low) {
    Ok(value: byte) => {
      return byte;
    }
    Err(error: problem) => {
      return 0_u8;
    }
  }
}

fn spell(destination: &[u8], value: u64) -> result: unit writes(destination) {
  let cursor = 0_u64;
  let rest = value;
  loop @octets {
    if cursor >= 8_u64 {
      break @octets;
    }
    let room = destination^.len;
    if cursor < room {
      let byte = low_byte(v: rest);
      set destination^[cursor] = byte;
    }
    set rest = irotr(rest, 8_u32);
    set cursor = cursor +wrap 1_u64;
  }
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(cwd: directory, handles: factory, memory_meter: meter, ..) = move inputs;
  let store = shared_map_new::<u64>(capacity: 0_u64);
  let name = array_filled::<u8, 8>(value: 0_u8);
  let live = 2000_u64;
  let next = 0_u64;
  loop @churn {
    if next == 42000_u64 {
      break @churn;
    }
    let key = &name[0_u64..8_u64];
    spell(destination: key, value: next);
    atomic t = &store {
      set t^[key] = Some<u64>(value: next);
    }
    if next >= live {
      let old = next -wrap live;
      spell(destination: key, value: old);
      atomic t = &store {
        set t^[key] = None<u64>();
      }
    }
    set next = next +wrap 1_u64;
  }
  let before = std::process::heap_in_use(meter: &meter);
  let freed = shared_map_release_reserve::<u64>(map: &store);
  let after = std::process::heap_in_use(meter: &meter);
  let again = shared_map_release_reserve::<u64>(map: &store);
  let count = 0_u64;
  atomic t = &store {
    set count = map_count::<u64>(map: t);
  }
  if freed == 0_u64 {
    return exit_status(code: 1_u8);
  }
  if after > before {
    return exit_status(code: 2_u8);
  }
  if before -wrap after != freed {
    return exit_status(code: 3_u8);
  }
  if again != 0_u64 {
    return exit_status(code: 4_u8);
  }
  if count != live {
    return exit_status(code: 5_u8);
  }
  return exit_status(code: 0_u8);
}
