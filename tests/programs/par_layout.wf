alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias args_count = std::text::args_count;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias write_once = std::io::write_once;

enum LNode {
  Leaf(w: f64, h: f64, out: f64);
  Branch(left: Box<LNode>, right: Box<LNode>, w: f64, h: f64, out: f64);
}

fn boxed_leaf(w: f64) -> result: Box<LNode> pure {
  doc "One leaf in its own heap cell. There is one heap and allocation is total, so the construction has no refusal arm [STOR-8, TYPE-9].";
  let leaf = LNode::Leaf(w: w, h: 0.5_f64, out: 0.0_f64);
  let cell = box_new::<LNode>(value: move leaf);
  return move cell;
}

fn build(depth: u64, w: f64) -> result: Box<LNode> pure {
  doc "Builds the complete tree bottom-up.";
  let done = depth == 0_u64;
  if done {
    return boxed_leaf(w: w);
  }
  let next = depth -wrap 1_u64;
  let wl = fmul.strict(w, 1.0009765625_f64);
  let wr = fmul.strict(w, 0.9990234375_f64);
  let l = build(depth: next, w: wl);
  let r = build(depth: next, w: wr);
  let branch = LNode::Branch(left: move l, right: move r, w: w, h: 0.25_f64, out: 0.0_f64);
  let cell = box_new::<LNode>(value: move branch);
  return move cell;
}

fn cascade(inh: f64, w: f64, h: f64) -> result: f64 pure {
  let pad_l = fmul.strict(w, 0.0625_f64);
  let pad_r = fmul.strict(w, 0.03125_f64);
  let border = fmul.strict(h, 0.125_f64);
  let lr = fadd.strict(pad_l, pad_r);
  let lrb = ffma.strict(border, 2.0_f64, lr);
  let content = fsub.strict(w, lrb);
  let clamped_lo = fmax(content, 0.0_f64);
  let font = ffma.strict(inh, 0.5_f64, 8.0_f64);
  let line = fmul.strict(font, 1.25_f64);
  let words = fdiv.strict(clamped_lo, font);
  let lines_raw = fdiv.strict(words, 16.0_f64);
  let lines = fceil(lines_raw);
  let height = fmul.strict(lines, line);
  let margin = fmul.strict(h, 0.5_f64);
  let outer = fadd.strict(height, margin);
  let scaled = ffma.strict(outer, 1.0625_f64, border);
  let abs_scaled = fabs(scaled);
  let root = fsqrt.strict(abs_scaled);
  let mixed = ffma.strict(root, 3.25_f64, clamped_lo);
  let capped = fmin(mixed, 4096.0_f64);
  let floored = fmax(capped, 0.0625_f64);
  let rounded = ffloor(floored);
  let frac = fsub.strict(floored, rounded);
  let adj = ffma.strict(frac, 0.5_f64, rounded);
  let final_h = fadd.strict(adj, lrb);
  return final_h;
}

fn measure_words(words: &[f64], font: f64) -> result: f64 reads(words) {
  doc "Measures every word of the shared metric table at one font size. The walk is bounded by the range reference's own length, so its index obligation is discharged directly [REF-4, MSR-1].";
  let widest = 0.0_f64;
  let total = 0.0_f64;
  let spare = deref(words).len;
  let k = 0_u64;
  loop @scan {
    let done = k >= spare;
    if done {
      break @scan;
    }
    let raw = deref(words)[k];
    let scaled = fmul.strict(raw, font);
    let above = fgt(scaled, widest);
    if above {
      set widest = scaled;
    }
    set total = fadd.strict(total, scaled);
    set k = k +wrap 1_u64;
  }
  return fadd.strict(total, widest);
}

fn measure_band(words: &[f64], count: u64, font: f64) -> result: f64 reads(words) {
  doc "The same walk over a caller-supplied prefix, clamped to the range it reads.";
  let widest = 0.0_f64;
  let total = 0.0_f64;
  let spare = deref(words).len;
  let bounded_count = spare;
  let count_fits = count <= spare;
  if count_fits {
    set bounded_count = count;
  }
  for (k in 0_u64..bounded_count) {
    let raw = deref(words)[k];
    let scaled = fmul.strict(raw, font);
    let above = fgt(scaled, widest);
    if above {
      set widest = scaled;
    }
    set total = fadd.strict(total, scaled);
  }
  return fadd.strict(total, widest);
}

fn layout(node: &Box<LNode>, words: &[f64], inh: f64) -> result: f64 reads(words), writes(node) {
  doc "Folds the box tree, writing each node's resolved height into its own slot. The two child calls are the permitted and overlappable pair: neither reads what the other defines, their substituted write paths are the two disjoint payload fields of one variant, and no exit of the first skips the second [OWN-7, EFF-5, PAR-1].";
  match deref(node).inner {
    Leaf(w: lw, h: lh, out: lslot) => {
      let v = cascade(inh: inh, w: deref(lw), h: deref(lh));
      let m = measure_words(words: words, font: v);
      let total = fadd.strict(v, m);
      set deref(lslot) = total;
      return total;
    }
    Branch(left: l, right: r, w: bw, h: bh, out: bslot) => {
      let own_h = cascade(inh: inh, w: deref(bw), h: deref(bh));
      let m = measure_words(words: words, font: own_h);
      let child_inh = fmul.strict(own_h, 0.5_f64);
      let a = layout(node: l, words: words, inh: child_inh);
      let b = layout(node: r, words: words, inh: child_inh);
      let kids = fadd.strict(a, b);
      let mine = fadd.strict(own_h, m);
      let total = fadd.strict(kids, mine);
      set deref(bslot) = total;
      return total;
    }
  }
}

fn layout_banded(node: &Box<LNode>, words: &[f64], count: u64, inh: f64) -> result: f64 reads(words), writes(node) {
  doc "The same fold whose per-node measure takes a caller-supplied band.";
  match deref(node).inner {
    Leaf(w: lw, h: lh, out: lslot) => {
      let v = cascade(inh: inh, w: deref(lw), h: deref(lh));
      let m = measure_band(words: words, count: count, font: v);
      let total = fadd.strict(v, m);
      set deref(lslot) = total;
      return total;
    }
    Branch(left: l, right: r, w: bw, h: bh, out: bslot) => {
      let own_h = cascade(inh: inh, w: deref(bw), h: deref(bh));
      let m = measure_band(words: words, count: count, font: own_h);
      let child_inh = fmul.strict(own_h, 0.5_f64);
      let a = layout_banded(node: l, words: words, count: count, inh: child_inh);
      let b = layout_banded(node: r, words: words, count: count, inh: child_inh);
      let kids = fadd.strict(a, b);
      let mine = fadd.strict(own_h, m);
      let total = fadd.strict(kids, mine);
      set deref(bslot) = total;
      return total;
    }
  }
}

fn hex_digit(v: u64) -> result: u8 pure {
  let nibble = iand(v, 15_u64);
  let small = nibble < 10_u64;
  let byte = cvt::<u64, u8>(nibble);
  if small {
    return byte +wrap 48_u8;
  }
  return byte +wrap 87_u8;
}

fn spell_hex(destination: &[u8], at: u64, value: u64) -> result: u64 writes(destination) {
  doc "Writes one 64-bit value as sixteen lowercase hexadecimal digits, most significant first.";
  let cursor = at;
  let rest = value;
  let limit = at +wrap 16_u64;
  loop @digits {
    let done = cursor >= limit;
    if done {
      break @digits;
    }
    let shifted = irotl(rest, 4_u32);
    let digit = hex_digit(v: shifted);
    let spare = deref(destination).len;
    let writable = cursor < spare;
    if writable {
      set deref(destination)[cursor] = digit;
    }
    set rest = shifted;
    set cursor = cursor +wrap 1_u64;
  }
  return limit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure {
  doc "Publishes both layout results once for correctness. Explicit extra arguments select 800 repetitions per batch for manual benchmarks; the complete invocation count selects the batch count. Both forms finish at the same seed and publish the same bits. The metric table is one boxed runtime-capacity window and the report is one inline window of this frame [TYPE-9].";
  let Inputs(args: args, cwd: unused_cwd, stdout: out, stderr: unused_stderr, handles: entry_factory, stdin: unused_stdin) = move inputs;
  close_directory(factory: &entry_factory, directory: move unused_cwd);
  let batches = 1_u64;
  let repetitions = 1_u64;
  let initial_seed = 65.9375_f64;
  let invocation_count = args_count(args: &args);
  set batches = invocation_count;
  let benchmark = invocation_count > 1_u64;
  if benchmark {
    set repetitions = 800_u64;
    set initial_seed = 16.0_f64;
  }
  let tree = build(depth: 6_u64, w: 512.0_f64);
  let words_cell = box_slots_new::<f64>(capacity: 8192_u64);
  let width = 6.5_f64;
  for @fill (
    at in 0_u64..8192_u64,
    invariant grown: words_cell.inner.len == at
  ) {
    place_back(window: &words_cell.inner, value: width);
    set width = fmul.strict(width, 1.0625_f64);
    let too_wide = fgt(width, 64.0_f64);
    if too_wide {
      set width = 6.5_f64;
    }
  }
  let words = &words_cell.inner[0_u64..8192_u64];
  let last = 0.0_f64;
  let batch = 0_u64;
  loop @layout_batches {
    let all_batches_done = batch >= batches;
    if all_batches_done {
      break @layout_batches;
    }
    let i = 0_u64;
    let seed = initial_seed;
    loop @reps {
      let done = i == repetitions;
      if done {
        break @reps;
      }
      let total = layout(node: &tree, words: words, inh: seed);
      set last = total;
      set seed = fadd.strict(seed, 0.0625_f64);
      set i = i +wrap 1_u64;
    }
    set batch = batch +wrap 1_u64;
  }
  let banded = 0.0_f64;
  let band_batch = 0_u64;
  loop @band_batches {
    let all_batches_done = band_batch >= batches;
    if all_batches_done {
      break @band_batches;
    }
    let j = 0_u64;
    let band_seed = initial_seed;
    loop @band_reps {
      let done = j == repetitions;
      if done {
        break @band_reps;
      }
      let total = layout_banded(node: &tree, words: words, count: 4096_u64, inh: band_seed);
      set banded = total;
      set band_seed = fadd.strict(band_seed, 0.0625_f64);
      set j = j +wrap 1_u64;
    }
    set band_batch = band_batch +wrap 1_u64;
  }
  let last_bits = reinterpret::<f64, u64>(last);
  let banded_bits = reinterpret::<f64, u64>(banded);
  let report = slots_new::<u8, 34>();
  for @fill_report (
    at in 0_u64..34_u64,
    invariant grown_report: report.len == at
  ) {
    place_back(window: &report, value: 10_u8);
  }
  set report[16_u64] = 32_u8;
  let window = &report[0_u64..34_u64];
  let first = spell_hex(destination: window, at: 0_u64, value: last_bits);
  let second = spell_hex(destination: window, at: 17_u64, value: banded_bits);
  match write_once(factory: &entry_factory, output: &out, source: window, start: 0_u64, end: 34_u64) {
    Ok(value: next) => {
      return exit_status(code: 0_u8);
    }
    Err(error: problem) => {
      return exit_status(code: 1_u8);
    }
  }
}
