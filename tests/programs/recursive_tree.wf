alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

enum Tree {
  Leaf();
  Branch(left: Box<Tree>, right: Box<Tree>);
}

fn boxed_leaf() -> made: Box<Tree> pure {
  doc "One leaf in its own heap cell. There is one heap, allocation is total, and the cell carries no brand, so the construction has no failure arm [STOR-8, TYPE-9].";
  let leaf = Tree::Leaf();
  let cell = box_new::<Tree>(value: move leaf);
  return move cell;
}

fn boxed_branch(left: Box<Tree>, right: Box<Tree>) -> made: Box<Tree> pure {
  doc "A branch owning two children. Dropping it releases both: the release walk visits a cell's content before the cell itself [PROV-6, STOR-3].";
  let branch = Tree::Branch(left: move left, right: move right);
  let cell = box_new::<Tree>(value: move branch);
  return move cell;
}

fn count(tree: &Box<Tree>) -> result: Result<u64, Overflow> reads(tree) {
  doc "The recursive walk over a cell-linked tree. A Box's content is its field inner, and matching through a reference binds each payload as a reference naming the scrutinee path [TYPE-9, OWN-13]. PROV-6 admits a release graph with a cycle, and this is the type whose release is one action per node entering itself.";
  match deref(tree).inner {
    Leaf() => {
      return Ok<u64, Overflow>(value: 1_u64);
    }
    Branch(left: l, right: r) => {
      let left_count = propagate count(tree: l);
      let right_count = propagate count(tree: r);
      let children = propagate left_count +checked right_count;
      return children +checked 1_u64;
    }
  }
}

fn main() -> status: ExitStatus pure {
  doc "Two leaves under one branch, counted by the recursive walk; the root's release reclaims the whole tree.";
  let leaf0 = boxed_leaf();
  let leaf1 = boxed_leaf();
  let root = boxed_branch(left: move leaf0, right: move leaf1);
  match count(tree: &root) {
    Ok(value: nodes) => {
      if nodes == 3_u64 {
        return exit_status(code: 0_u8);
      }
      return exit_status(code: 1_u8);
    }
    Err(error: overflow) => {
      return exit_status(code: 1_u8);
    }
  }
}
