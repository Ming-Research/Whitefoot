alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const names: Array<u8, 2> =[97_u8, 98_u8];

struct Ledger {
  entries: ConcurrentHashMap<u64>;
  count: u64;
}

struct Store {
  entries: ConcurrentHashMap<u64>;
  log: u64;
}

struct Pair {
  left: ConcurrentHashMap<u64>;
  right: ConcurrentHashMap<u64>;
}

fn add_one(slot: &Option<u64>) -> result: unit writes(slot) {
  match slot^ {
    Some(value: seen) => {
      let next = seen^ +wrap 1_u64;
      set slot^ = Some<u64>(value: next);
    }
    None() => {
      set slot^ = Some<u64>(value: 1_u64);
    }
  }
  return unit;
}

fn entry_then_count(ledger: Shared<Ledger>) -> result: unit pure waits {
  doc "Adds to an entry and then to the count, in that order in its block.";
  let key = &names[0_u64..1_u64];
  for @round (index in 0_u64..2000_u64) {
    atomic l = &ledger {
      add_one(slot: &l^.entries[key]);
      set l^.count = l^.count +wrap 1_u64;
    }
  }
  return unit;
}

fn count_then_entry(ledger: Shared<Ledger>) -> result: unit pure waits {
  doc "Adds to the count and then to the same entry, the other order.";
  let key = &names[0_u64..1_u64];
  for @round (index in 0_u64..2000_u64) {
    atomic l = &ledger {
      set l^.count = l^.count +wrap 1_u64;
      add_one(slot: &l^.entries[key]);
    }
  }
  return unit;
}

fn logged(store: Shared<Store>, logging: Bool) -> result: unit pure waits {
  doc "Adds to an entry and, when logging, to the log after it: the log part is reached only on that path.";
  let key = &names[1_u64..2_u64];
  for @round (index in 0_u64..2000_u64) {
    atomic s = &store {
      add_one(slot: &s^.entries[key]);
      if logging {
        set s^.log = s^.log +wrap 1_u64;
      }
    }
  }
  return unit;
}

fn run(ledger: &Shared<Ledger>, store: &Shared<Store>) -> result: unit reads(ledger), reads(store) waits {
  for @start (index in 0_u64..3_u64) {
    let first = shared_share::<Ledger>(shared: ledger);
    spawn entry_then_count(ledger: move first);
    let second = shared_share::<Ledger>(shared: ledger);
    spawn count_then_entry(ledger: move second);
    let writer = shared_share::<Store>(shared: store);
    let on = True();
    spawn logged(store: move writer, logging: on);
    let quiet = shared_share::<Store>(shared: store);
    let off = False();
    spawn logged(store: move quiet, logging: off);
  }
  return unit;
}

fn count_pair(pair: Shared<Pair>, backwards: Bool) -> result: unit pure waits {
  doc "Adds to the same entry of each of a state's two maps, the right map first when backwards and the left map first otherwise.";
  let key = &names[0_u64..1_u64];
  for @round (index in 0_u64..2000_u64) {
    if backwards {
      atomic p = &pair {
        add_one(slot: &p^.right[key]);
        add_one(slot: &p^.left[key]);
      }
    } else {
      atomic p = &pair {
        add_one(slot: &p^.left[key]);
        add_one(slot: &p^.right[key]);
      }
    }
  }
  return unit;
}

fn count_pairs(pair: &Shared<Pair>) -> result: unit reads(pair) waits {
  let a = shared_share::<Pair>(shared: pair);
  let b = shared_share::<Pair>(shared: pair);
  let forwards = False();
  let backwards = True();
  spawn count_pair(pair: move a, backwards: forwards);
  spawn count_pair(pair: move b, backwards: backwards);
  return unit;
}

fn main() -> status: ExitStatus pure waits {
  doc "Contexts reach the parts of a shared state in opposite block orders: a map and a separate count of one state, and two maps of another. A statement takes the parts it reaches in field order, each at its first use together with the parts before it, whichever order its block meets them in, and the log part is reached only on the logging tail. Every driver count must observe equal entry and count totals, exactly the logging statements in the log, and equal totals in the two maps.";
  let ledger_entries = map_new::<u64>(capacity: 0_u64);
  let ledger_state = Ledger(entries: move ledger_entries, count: 0_u64);
  let ledger = shared_new::<Ledger>(value: move ledger_state);
  let store_entries = map_new::<u64>(capacity: 0_u64);
  let store_state = Store(entries: move store_entries, log: 0_u64);
  let store = shared_new::<Store>(value: move store_state);
  run(ledger: &ledger, store: &store);
  let first = &names[0_u64..1_u64];
  let value = 0_u64;
  let count = 1_u64;
  atomic l = &ledger {
    match l^.entries[first] {
      Some(value: seen) => {
        set value = seen^;
      }
      None() => {
      }
    }
    set count = l^.count;
  }
  if value != 12000_u64 {
    return exit_status(code: 1_u8);
  }
  if count != value {
    return exit_status(code: 2_u8);
  }
  let second = &names[1_u64..2_u64];
  let added = 0_u64;
  let logs = 0_u64;
  atomic s = &store {
    match s^.entries[second] {
      Some(value: seen) => {
        set added = seen^;
      }
      None() => {
      }
    }
    set logs = s^.log;
  }
  if added != 12000_u64 {
    return exit_status(code: 3_u8);
  }
  if logs != 6000_u64 {
    return exit_status(code: 4_u8);
  }
  let left_entries = map_new::<u64>(capacity: 0_u64);
  let right_entries = map_new::<u64>(capacity: 0_u64);
  let pair_state = Pair(left: move left_entries, right: move right_entries);
  let pair = shared_new::<Pair>(value: move pair_state);
  count_pairs(pair: &pair);
  let av = 0_u64;
  let bv = 0_u64;
  atomic p = &pair {
    match p^.left[first] {
      Some(value: seen) => {
        set av = seen^;
      }
      None() => {
      }
    }
    match p^.right[first] {
      Some(value: seen) => {
        set bv = seen^;
      }
      None() => {
      }
    }
  }
  if av != 4000_u64 {
    return exit_status(code: 5_u8);
  }
  if bv != 4000_u64 {
    return exit_status(code: 6_u8);
  }
  return exit_status(code: 0_u8);
}
