alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  doc "A bump allocator is one window used with place_back as allocation and a range reference as the run it hands out [OP-13]. One constant-capacity Slots of 256 slots lives in this activation's frame, two runs are carved off its back, one of them is filled and read back, and the take the window has no free slots for is refused by its own free-slots measure.";
  let workspace = slots_new::<u64, 256>();
  let opened = workspace.cap - workspace.len;
  if opened == 256_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  for @carve (
    at in 0_u64..8_u64,
    invariant grown: workspace.len >= at,
    invariant bounded: workspace.len <= at,
    invariant spare: workspace.cap - workspace.len + at >= 256_u64
  ) {
    place_back(window: &workspace, value: 0_u64);
  }
  let taken = workspace.len;
  if taken == 8_u64 {
  } else {
    return exit_status(code: 2_u8);
  }
  let built = &workspace[0_u64..8_u64];
  let capacity = deref(built).len;
  if capacity == 8_u64 {
  } else {
    return exit_status(code: 3_u8);
  }
  for @fill (
    at in 0_u64..8_u64,
    invariant sized: deref(built).len >= 8_u64
  ) {
    set deref(built)[at] = at;
  }
  let held = workspace.len;
  if held == 8_u64 {
  } else {
    return exit_status(code: 4_u8);
  }
  let last = deref(built)[7_u64];
  if last == 7_u64 {
  } else {
    return exit_status(code: 5_u8);
  }
  let offered = workspace.cap - workspace.len;
  if offered >= 4_u64 {
  } else {
    return exit_status(code: 8_u8);
  }
  for @second (
    at in 0_u64..4_u64,
    invariant grown: workspace.len >= 8_u64 + at,
    invariant bounded: workspace.len <= 8_u64 + at,
    invariant spare: workspace.cap - workspace.len + at >= 248_u64
  ) {
    place_back(window: &workspace, value: 0_u64);
  }
  let scratch = &workspace[8_u64..12_u64];
  let spare = deref(scratch).len;
  if spare == 4_u64 {
  } else {
    return exit_status(code: 6_u8);
  }
  set deref(scratch)[0_u64] = 99_u64;
  let front = deref(scratch)[0_u64];
  if front == 99_u64 {
  } else {
    return exit_status(code: 7_u8);
  }
  let after = workspace.len;
  if after == 12_u64 {
  } else {
    return exit_status(code: 9_u8);
  }
  let impossible = workspace.cap - workspace.len;
  if impossible >= 1024_u64 {
    return exit_status(code: 10_u8);
  }
  let unmoved = workspace.len;
  if unmoved == 12_u64 {
  } else {
    return exit_status(code: 11_u8);
  }
  let first = deref(built)[0_u64];
  if first == 0_u64 {
  } else {
    return exit_status(code: 12_u8);
  }
  return exit_status(code: 0_u8);
}
