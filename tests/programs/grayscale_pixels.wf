alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const pixel_input: Array<u8, 24> =[0_u8, 0_u8, 0_u8, 255_u8, 255_u8, 255_u8, 255_u8, 0_u8, 0_u8, 0_u8, 255_u8, 0_u8, 0_u8, 0_u8, 255_u8, 255_u8, 255_u8, 0_u8, 1_u8, 2_u8, 3_u8, 254_u8, 253_u8, 252_u8];

fn grayscale_value(red: u8, green: u8, blue: u8) -> result: Result<u8, NarrowError> pure {
  doc "One pixel averaged in binary32 and converted back by the value-preserving cvt, which reports a non-representable result rather than rounding it [OP-6].";
  let red_float = cvt::<u8, f32>(red);
  let green_float = cvt::<u8, f32>(green);
  let blue_float = cvt::<u8, f32>(blue);
  let red_green = fadd.strict(red_float, green_float);
  let total = fadd.strict(red_green, blue_float);
  let average = fdiv.strict(total, 3.0_f32);
  let rounded = froundeven(average);
  return cvt.checked::<f32, u8>(rounded);
}

fn grayscale(input: &[u8], output: &[u8]) -> result: Result<unit, NarrowError> reads(input), writes(output) contract {
  define input_length = deref(input).len;
  define output_length = deref(output).len;
  requires input_length >= 24_u64;
  requires output_length >= 8_u64;
} {
  doc "Both operands are range references, whose one measure is len; whether the callee may write through one is stated by this row and by nothing on the reference itself [REF-4, EFF-1].";
  let pixel = 0_u64;
  loop @pixels {
    let done = pixel == 8_u64;
    if done {
      break @pixels;
    }
    let base = pixel *wrap 3_u64;
    let green_offset = base +wrap 1_u64;
    let blue_offset = base +wrap 2_u64;
    let input_room = deref(input).len;
    let red_ok = base < input_room;
    if red_ok {
    } else {
      let error = NarrowError();
      return Err<unit, NarrowError>(error: error);
    }
    let red = deref(input)[base];
    let green_ok = green_offset < input_room;
    if green_ok {
    } else {
      let error = NarrowError();
      return Err<unit, NarrowError>(error: error);
    }
    let green = deref(input)[green_offset];
    let blue_ok = blue_offset < input_room;
    if blue_ok {
    } else {
      let error = NarrowError();
      return Err<unit, NarrowError>(error: error);
    }
    let blue = deref(input)[blue_offset];
    let value = propagate grayscale_value(red: red, green: green, blue: blue);
    let output_room = deref(output).len;
    let pixel_ok = pixel < output_room;
    if pixel_ok {
    } else {
      let error = NarrowError();
      return Err<unit, NarrowError>(error: error);
    }
    set deref(output)[pixel] = value;
    set pixel = pixel +wrap 1_u64;
  }
  return Ok<unit, NarrowError>(value: unit);
}

fn main() -> status: ExitStatus pure {
  doc "Eight pixels are read from a const run and written into a frame-resident array, both reached by the caller-formed range references the callee's row governs.";
  let output = array_filled::<u8, 8>(value: 0_u8);
  let window = &output[0_u64..8_u64];
  let view = &pixel_input[0_u64..24_u64];
  let result = grayscale(input: view, output: window);
  match result {
    Ok(value: success) => {
    }
    Err(error: failure) => {
      return exit_status(code: 1_u8);
    }
  }
  if output[0_u64] == 0_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output[1_u64] == 255_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output[2_u64] == 85_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output[3_u64] == 85_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output[4_u64] == 85_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output[5_u64] == 170_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output[6_u64] == 2_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  if output[7_u64] == 253_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
