alias MemoryMeter = std::process::MemoryMeter;

fn byte_reuse(meter: &MemoryMeter) -> code: u8 writes(meter) {
  doc "The program heap after a 64 KiB byte buffer is built stays the same through filling, clear and refilling it: clear keeps the storage and the refill places into it.";
  let bytes = box_slots_new::<u8>(capacity: 65536_u64);
  let built = std::process::heap_in_use(meter: meter);
  for (
    i in 0_u64..65536_u64,
    invariant filling: bytes.inner.len == i
  ) {
    place_back(window: &bytes.inner, value: 1_u8);
  }
  clear(window: &bytes.inner);
  invariant empty: bytes.inner.len == 0_u64;
  invariant retained: bytes.inner.cap == 65536_u64;
  let cleared = std::process::heap_in_use(meter: meter);
  if cleared != built {
    return 1_u8;
  }
  for (
    i in 0_u64..65536_u64,
    invariant refilling: bytes.inner.len == i
  ) {
    place_back(window: &bytes.inner, value: 2_u8);
  }
  let refilled = std::process::heap_in_use(meter: meter);
  if refilled != built {
    return 2_u8;
  }
  invariant still_retained: bytes.inner.cap == 65536_u64;
  return 0_u8;
}

fn element_release(meter: &MemoryMeter) -> code: u8 writes(meter) {
  doc "Clearing a boxed Slots of 32 boxed bytes returns the program heap to its value before the fill: clear releases every element and keeps the backing.";
  let cells = box_slots_new::<Box<u8>>(capacity: 32_u64);
  let empty_backing = std::process::heap_in_use(meter: meter);
  for (
    i in 0_u64..32_u64,
    invariant filling: cells.inner.len == i
  ) {
    let cell = box_new::<u8>(value: 5_u8);
    place_back(window: &cells.inner, value: move cell);
  }
  let filled = std::process::heap_in_use(meter: meter);
  if filled <= empty_backing {
    return 11_u8;
  }
  clear(window: &cells.inner);
  invariant empty: cells.inner.len == 0_u64;
  let cleared = std::process::heap_in_use(meter: meter);
  if cleared != empty_backing {
    return 12_u8;
  }
  let again = box_new::<u8>(value: 6_u8);
  place_back(window: &cells.inner, value: move again);
  if cells.inner[0_u64].inner != 6_u8 {
    return 13_u8;
  }
  return 0_u8;
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  let std::process::Inputs(cwd: directory, handles: factory, memory_meter: meter, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let before = std::process::heap_in_use(meter: &meter);
  let bytes = byte_reuse(meter: &meter);
  if bytes != 0_u8 {
    return std::process::exit_status(code: bytes);
  }
  let elements = element_release(meter: &meter);
  if elements != 0_u8 {
    return std::process::exit_status(code: elements);
  }
  let after = std::process::heap_in_use(meter: &meter);
  if after != before {
    return std::process::exit_status(code: 21_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
