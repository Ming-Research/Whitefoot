alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias Instant = std::time::Instant;
alias close_directory = std::fs::close_directory;
alias close_directory_write = std::fs::close_directory_write;
alias exit_status = std::process::exit_status;
alias instant_after = std::time::instant_after;
alias instant_reached = std::time::instant_reached;
alias now = std::time::now;
alias read_next = std::io::read_next;

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Reads standard input with a deadline ten seconds away while its writer sends a byte after a tenth of a second: the read completes with the byte, well before its deadline [PRE-2].";
  let Inputs(args: unused_args, cwd: cwd_directory, stdout: unused_stdout, stderr: unused_stderr, handles: handles, stdin: input, clock: clock, wall_clock: unused_wall_clock, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  close_directory_write(factory: &handles, directory: move cwd_write);
  close_directory(factory: &handles, directory: move cwd);
  let bytes = slots_new::<u8, 1>();
  place_back(window: &bytes, value: 0_u8);
  let started = now(clock: &clock);
  let far = instant_after(instant: started, nanoseconds: 10000000000_u64);
  let bound = Some<Instant>(value: far);
  let destination = &bytes[0_u64..1_u64];
  let wait_cancel_1 = std::time::cancel_never();
  let wait_outcome_1 = read_next(factory: &handles, input: &input, destination: destination, start: 0_u64, end: 1_u64, deadline: bound, cancel: &wait_cancel_1);
  std::time::close_cancel_watch(watch: move wait_cancel_1);
  match wait_outcome_1 {
    Ok(value: received) => {
      if received != 1_u64 {
        return exit_status(code: 10_u8);
      }
    }
    Err(error: stop) => {
      return exit_status(code: 11_u8);
    }
  }
  let after = now(clock: &clock);
  let reached = instant_reached(deadline: far, instant: after);
  if reached {
    return exit_status(code: 12_u8);
  }
  if bytes[0_u64] != 122_u8 {
    return exit_status(code: 13_u8);
  }
  return exit_status(code: 0_u8);
}
