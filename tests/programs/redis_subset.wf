struct Key {
  bytes: Array<u8, 48>;
  length: u64;
}

struct KeyEnv {
  seed: u64;
}

struct Entry {
  bytes: Box<Slots<u8>>;
  expires: u64;
}

struct Due {
  key: Key;
  at: u64;
}

struct Store {
  map: HashMap<Key, Entry, 4194304>;
  due: PriorityQueue<Due, 4194304>;
  log: Box<Slots<u8>>;
  logging: Bool;
  clients: u64;
  stopping: Bool;
}

struct Time {
  now: u64;
  unix_ms: u64;
  check: u64;
  loading: Bool;
}

struct Copied {
  bytes: Array<u8, 1024>;
  length: u64;
  now: u64;
  expired: Bool;
}

struct Counted {
  value: u64;
  now: u64;
  state: u64;
}

struct Expiry {
  at: u64;
  now: u64;
  state: u64;
}

struct Remaining {
  left: u64;
  now: u64;
  state: u64;
}

struct Probe {
  at: u64;
}

struct Number {
  value: u64;
  next: u64;
  state: u64;
}

struct Command {
  state: u64;
  count: u64;
  next: u64;
  first_start: u64;
  first_length: u64;
  second_start: u64;
  second_length: u64;
  third_start: u64;
  third_length: u64;
  fourth_start: u64;
  fourth_length: u64;
  fifth_start: u64;
  fifth_length: u64;
}

fn byte_at(input: &[u8], index: u64) -> result: u8 reads(input) {
  doc "Reads one byte, or zero at a position the range does not hold.";
  if index < input^.len {
    let value = input^[index];
    return value;
  }
  return 0_u8;
}

fn put_byte(output: &[u8], at: u64, value: u8) -> result: u64 writes(output) {
  doc "Writes one byte at a position and returns the position after it; a position the range does not hold keeps the byte out.";
  if at < output^.len {
    set output^[at] = value;
    let after = at +wrap 1_u64;
    return after;
  }
  return at;
}

fn put_word(output: &[u8], at: u64, word: &[u8]) -> result: u64 reads(word), writes(output) {
  doc "Writes every byte of a constant word from a position and returns the position after it.";
  let position = at;
  let count = word^.len;
  for @word (offset in 0_u64..count) {
    let byte = word^[offset];
    set position = put_byte(output: output, at: position, value: byte);
  }
  return position;
}

fn put_decimal(output: &[u8], at: u64, value: u64) -> result: u64 writes(output) {
  doc "Writes a number in decimal from a position and returns the position after it.";
  let digits = array_filled::<u8, 20>(value: 0_u8);
  let count = 0_u64;
  let rest = value;
  loop @digits (
    decreases rest
  ) {
    let low = rest % 10_u64;
    let narrow = cvt.wrap::<u64, u8>(low);
    let glyph = narrow +wrap 48_u8;
    if count < 20_u64 {
      set digits[count] = glyph;
      set count = count +wrap 1_u64;
    }
    set rest = rest / 10_u64;
    if rest == 0_u64 {
      break @digits;
    }
  }
  let position = at;
  for @emit (index in 0_u64..count) {
    let back = count -wrap index;
    let from = back -wrap 1_u64;
    let glyph = 48_u8;
    if from < 20_u64 {
      set glyph = digits[from];
    }
    set position = put_byte(output: output, at: position, value: glyph);
  }
  return position;
}

fn put_integer(output: &[u8], at: u64, value: u64) -> result: u64 writes(output) {
  doc "Writes a RESP integer reply holding a number that is not negative.";
  let position = put_byte(output: output, at: at, value: 58_u8);
  set position = put_decimal(output: output, at: position, value: value);
  set position = put_word(output: output, at: position, word: &reply_crlf[0_u64..2_u64]);
  return position;
}

fn read_number(input: &[u8], start: u64, held: u64) -> result: Number reads(input) {
  doc "Reads a decimal number ended by CR LF from a position. State 1 is a number, 0 means the bytes held end before it does, and 2 is a malformed one.";
  let value = 0_u64;
  let index = start;
  let digits = 0_u64;
  loop @digits {
    if index >= held {
      return Number(value: 0_u64, next: index, state: 0_u64);
    }
    let byte = byte_at(input: input, index: index);
    if byte == 13_u8 {
      break @digits;
    }
    let low = byte >= 48_u8;
    let high = byte <= 57_u8;
    let digit = band(low, high);
    if digit {
    } else {
      return Number(value: 0_u64, next: index, state: 2_u64);
    }
    if digits >= 18_u64 {
      return Number(value: 0_u64, next: index, state: 2_u64);
    }
    let offset = byte -wrap 48_u8;
    let wide = cvt::<u8, u64>(offset);
    let scaled = value *wrap 10_u64;
    set value = scaled +wrap wide;
    set digits = digits +wrap 1_u64;
    set index = index +wrap 1_u64;
  }
  let after = index +wrap 1_u64;
  if after >= held {
    return Number(value: 0_u64, next: index, state: 0_u64);
  }
  let feed = byte_at(input: input, index: after);
  if feed != 10_u8 {
    return Number(value: 0_u64, next: index, state: 2_u64);
  }
  if digits == 0_u64 {
    return Number(value: 0_u64, next: index, state: 2_u64);
  }
  let next = after +wrap 1_u64;
  return Number(value: value, next: next, state: 1_u64);
}

fn arg_number(input: &[u8], start: u64, length: u64) -> result: Number reads(input) {
  doc "Reads a command argument as a decimal number of one to 18 digits. State 1 is a number and 2 is an argument that is not one.";
  let few = length < 1_u64;
  let many = length > 18_u64;
  let outside = bor(few, many);
  if outside {
    return Number(value: 0_u64, next: start, state: 2_u64);
  }
  let value = 0_u64;
  for @digits (offset in 0_u64..length) {
    let position = start +wrap offset;
    let byte = byte_at(input: input, index: position);
    let low = byte >= 48_u8;
    let high = byte <= 57_u8;
    let digit = band(low, high);
    if digit {
    } else {
      return Number(value: 0_u64, next: start, state: 2_u64);
    }
    let face = byte -wrap 48_u8;
    let wide = cvt::<u8, u64>(face);
    let scaled = value *wrap 10_u64;
    set value = scaled +wrap wide;
  }
  let next = start +wrap length;
  return Number(value: value, next: next, state: 1_u64);
}

fn unfinished(state: u64) -> result: Command pure {
  doc "A command that is not complete in the bytes held (state 0) or is malformed (state 2).";
  return Command(state: state, count: 0_u64, next: 0_u64, first_start: 0_u64, first_length: 0_u64, second_start: 0_u64, second_length: 0_u64, third_start: 0_u64, third_length: 0_u64, fourth_start: 0_u64, fourth_length: 0_u64, fifth_start: 0_u64, fifth_length: 0_u64);
}

fn parse_command(input: &[u8], start: u64, held: u64) -> result: Command reads(input) {
  doc "Parses one RESP2 array of one to five bulk strings from a position. State 1 is a complete command whose arguments are positions in the input, 0 means the bytes held end before it does, and 2 is a malformed one.";
  if start >= held {
    return unfinished(state: 0_u64);
  }
  let marker = byte_at(input: input, index: start);
  if marker != 42_u8 {
    return unfinished(state: 2_u64);
  }
  let header_start = start +wrap 1_u64;
  let header = read_number(input: input, start: header_start, held: held);
  if header.state != 1_u64 {
    return unfinished(state: header.state);
  }
  let count = header.value;
  let few = count < 1_u64;
  let many = count > 5_u64;
  let outside = bor(few, many);
  if outside {
    return unfinished(state: 2_u64);
  }
  let position = header.next;
  let first_start = 0_u64;
  let first_length = 0_u64;
  let second_start = 0_u64;
  let second_length = 0_u64;
  let third_start = 0_u64;
  let third_length = 0_u64;
  let fourth_start = 0_u64;
  let fourth_length = 0_u64;
  let fifth_start = 0_u64;
  let fifth_length = 0_u64;
  for @arguments (ordinal in 0_u64..count) {
    if position >= held {
      return unfinished(state: 0_u64);
    }
    let dollar = byte_at(input: input, index: position);
    if dollar != 36_u8 {
      return unfinished(state: 2_u64);
    }
    let length_start = position +wrap 1_u64;
    let length = read_number(input: input, start: length_start, held: held);
    if length.state != 1_u64 {
      return unfinished(state: length.state);
    }
    if length.value > 16384_u64 {
      return unfinished(state: 2_u64);
    }
    let data_start = length.next;
    let data_end = data_start +wrap length.value;
    let closed = data_end +wrap 2_u64;
    if closed > held {
      return unfinished(state: 0_u64);
    }
    let carriage = byte_at(input: input, index: data_end);
    let after_data = data_end +wrap 1_u64;
    let feed = byte_at(input: input, index: after_data);
    let carriage_bad = carriage != 13_u8;
    let feed_bad = feed != 10_u8;
    let bad = bor(carriage_bad, feed_bad);
    if bad {
      return unfinished(state: 2_u64);
    }
    if ordinal == 0_u64 {
      set first_start = data_start;
      set first_length = length.value;
    } else if ordinal == 1_u64 {
      set second_start = data_start;
      set second_length = length.value;
    } else if ordinal == 2_u64 {
      set third_start = data_start;
      set third_length = length.value;
    } else if ordinal == 3_u64 {
      set fourth_start = data_start;
      set fourth_length = length.value;
    } else {
      set fifth_start = data_start;
      set fifth_length = length.value;
    }
    set position = closed;
  }
  return Command(state: 1_u64, count: count, next: position, first_start: first_start, first_length: first_length, second_start: second_start, second_length: second_length, third_start: third_start, third_length: third_length, fourth_start: fourth_start, fourth_length: fourth_length, fifth_start: fifth_start, fifth_length: fifth_length);
}

fn name_is(input: &[u8], start: u64, length: u64, word: &[u8]) -> result: Bool reads(input), reads(word) {
  doc "Whether the argument at a position spells a command word, letters in either case.";
  if length != word^.len {
    return False();
  }
  for @compare (offset in 0_u64..length) {
    let position = start +wrap offset;
    let byte = byte_at(input: input, index: position);
    let upper = iand(byte, 223_u8);
    let expected = word^[offset];
    if upper != expected {
      return False();
    }
  }
  return True();
}

fn key_hash(env: &KeyEnv, key: &Key) -> result: u64 reads(env), reads(key) {
  doc "FNV-1a over the key's length and its 48 byte positions, which hold zero past its length.";
  let hash = ixor(14695981039346656037_u64, env^.seed);
  let mixed = ixor(hash, key^.length);
  set hash = mixed *wrap 1099511628211_u64;
  for @bytes (index in 0_u64..48_u64) {
    let byte = key^.bytes[index];
    let wide = cvt::<u8, u64>(byte);
    let folded = ixor(hash, wide);
    set hash = folded *wrap 1099511628211_u64;
  }
  return hash;
}

fn key_equal(env: &KeyEnv, left: &Key, right: &Key) -> result: Bool reads(left), reads(right) {
  doc "Two keys are equal when their lengths and every byte position are.";
  if left^.length != right^.length {
    return False();
  }
  for @bytes (index in 0_u64..48_u64) {
    let first = left^.bytes[index];
    let second = right^.bytes[index];
    if first != second {
      return False();
    }
  }
  return True();
}

binding KeyBytes : HashMapKey<Key, KeyEnv> {
  hash = key_hash;
  equal = key_equal;
}

fn due_order(env: &KeyEnv, left: &Due, right: &Due) -> result: i32 reads(left), reads(right) {
  doc "Orders queued expiries by their instant, the earliest first.";
  if left^.at < right^.at {
    return -1_i32;
  }
  if left^.at > right^.at {
    return 1_i32;
  }
  return 0_i32;
}

binding DueOrder : PriorityOrder<Due, KeyEnv> {
  compare = due_order;
}

fn make_key(input: &[u8], start: u64, length: u64) -> result: Key reads(input) {
  doc "Copies a key of at most 48 bytes out of the input, zero past its length.";
  let bytes = array_filled::<u8, 48>(value: 0_u8);
  for @copy (offset in 0_u64..48_u64) {
    if offset < length {
      let position = start +wrap offset;
      let byte = byte_at(input: input, index: position);
      set bytes[offset] = byte;
    }
  }
  return Key(bytes: bytes, length: length);
}

fn make_value(input: &[u8], start: u64, length: u64) -> made: Box<Slots<u8>> reads(input) contract {
  requires length <= 1024_u64;
} {
  doc "Copies a value of at most 1024 bytes out of the input into a string of its own.";
  let made = box_slots_new::<u8>(capacity: length);
  for @copy (offset in 0_u64..length) {
    let position = start +wrap offset;
    let byte = byte_at(input: input, index: position);
    if made.inner.len < made.inner.cap {
      place_back(window: &made.inner, value: byte);
    }
  }
  return move made;
}

fn decimal_value(value: u64) -> made: Box<Slots<u8>> pure {
  doc "A string holding a number in decimal.";
  let digits = array_filled::<u8, 20>(value: 0_u8);
  let count = 0_u64;
  let rest = value;
  loop @digits (
    decreases rest
  ) {
    let low = rest % 10_u64;
    let narrow = cvt.wrap::<u64, u8>(low);
    let glyph = narrow +wrap 48_u8;
    if count < 20_u64 {
      set digits[count] = glyph;
      set count = count +wrap 1_u64;
    }
    set rest = rest / 10_u64;
    if rest == 0_u64 {
      break @digits;
    }
  }
  let made = box_slots_new::<u8>(capacity: 20_u64);
  for @emit (index in 0_u64..count) {
    let back = count -wrap index;
    let from = back -wrap 1_u64;
    let glyph = 48_u8;
    if from < 20_u64 {
      set glyph = digits[from];
    }
    if made.inner.len < made.inner.cap {
      place_back(window: &made.inner, value: glyph);
    }
  }
  return move made;
}

fn expired(expires: u64, now: u64) -> result: Bool pure {
  doc "Whether an expiry, zero for none, has been reached at now; both count nanoseconds from the program's origin.";
  if expires == 0_u64 {
    return False();
  }
  let reached = expires <= now;
  return reached;
}

fn copy_value(env: &Copied, key: &Key, value: &Entry) -> result: u64 reads(value), writes(env) {
  doc "Copies a live stored value of at most 1024 bytes out of the keyspace and returns its length; an expired one is marked instead.";
  let reached = expired(expires: value^.expires, now: env^.now);
  if reached {
    set env^.expired = True();
    set env^.length = 0_u64;
    return 0_u64;
  }
  let length = value^.bytes.inner.len;
  if length > 1024_u64 {
    set env^.length = 0_u64;
    return length;
  }
  for @copy (index in 0_u64..length) {
    let byte = value^.bytes.inner[index];
    set env^.bytes[index] = byte;
  }
  set env^.length = length;
  return length;
}

fn bump_value(env: &Counted, key: &Key, value: &Entry) -> result: u64 writes(env), writes(value) {
  doc "Adds one to a live stored decimal number in place, keeping its expiry. State 1 is done, 0 leaves a value that is not a number unchanged, and 2 marks an expired entry.";
  let reached = expired(expires: value^.expires, now: env^.now);
  if reached {
    set env^.state = 2_u64;
    return 2_u64;
  }
  let length = value^.bytes.inner.len;
  let few = length < 1_u64;
  let many = length > 18_u64;
  let outside = bor(few, many);
  if outside {
    set env^.state = 0_u64;
    return 0_u64;
  }
  let number = 0_u64;
  for @digits (index in 0_u64..length) {
    let byte = value^.bytes.inner[index];
    let low = byte >= 48_u8;
    let high = byte <= 57_u8;
    let digit = band(low, high);
    if digit {
    } else {
      set env^.state = 0_u64;
      return 0_u64;
    }
    let offset = byte -wrap 48_u8;
    let wide = cvt::<u8, u64>(offset);
    let scaled = number *wrap 10_u64;
    set number = scaled +wrap wide;
  }
  let bumped = number +wrap 1_u64;
  let fresh = decimal_value(value: bumped);
  set value^.bytes = move fresh;
  set env^.value = bumped;
  set env^.state = 1_u64;
  return 1_u64;
}

fn set_expiry(env: &Expiry, key: &Key, value: &Entry) -> result: u64 writes(env), writes(value) {
  doc "Gives a live entry the expiry env carries. State 1 is done and 2 marks an expired entry.";
  let reached = expired(expires: value^.expires, now: env^.now);
  if reached {
    set env^.state = 2_u64;
    return 2_u64;
  }
  set value^.expires = env^.at;
  set env^.state = 1_u64;
  return 1_u64;
}

fn clear_expiry(env: &Expiry, key: &Key, value: &Entry) -> result: u64 writes(env), writes(value) {
  doc "Removes a live entry's expiry. State 1 removed one, 0 found none, and 2 marks an expired entry.";
  let reached = expired(expires: value^.expires, now: env^.now);
  if reached {
    set env^.state = 2_u64;
    return 2_u64;
  }
  if value^.expires == 0_u64 {
    set env^.state = 0_u64;
    return 0_u64;
  }
  set value^.expires = 0_u64;
  set env^.state = 1_u64;
  return 1_u64;
}

fn read_expiry(env: &Remaining, key: &Key, value: &Entry) -> result: u64 reads(value), writes(env) {
  doc "Reads how long a live entry has left. State 2 has an expiry and its nanoseconds left, 1 has none, and 0 marks an expired entry.";
  let reached = expired(expires: value^.expires, now: env^.now);
  if reached {
    set env^.state = 0_u64;
    return 0_u64;
  }
  if value^.expires == 0_u64 {
    set env^.state = 1_u64;
    return 1_u64;
  }
  set env^.left = value^.expires -wrap env^.now;
  set env^.state = 2_u64;
  return 2_u64;
}

fn entry_expiry(env: &Probe, key: &Key, value: &Entry) -> result: u64 reads(value), writes(env) {
  doc "Reads an entry's expiry, zero for none.";
  set env^.at = value^.expires;
  return value^.expires;
}

fn due_at(env: &Probe, value: &Due) -> result: u64 reads(value), writes(env) {
  doc "Reads a queued expiry's instant.";
  set env^.at = value^.at;
  return value^.at;
}

fn log_reserve(log: &Box<Slots<u8>>, needed: u64) -> result: unit writes(log) {
  doc "Grows the append-only file's buffer, at least doubling it, until it has room for needed more bytes. No host allocates the 2^62 bytes the growth stops at; a host that cannot allocate less stops the program [SCOPE-3], as Redis stops when its buffer exhausts memory.";
  let length = log^.inner.len;
  let capacity = log^.inner.cap;
  let wanted = length +wrap needed;
  if wanted > capacity {
    let doubled = capacity +wrap capacity;
    let target = wanted;
    if doubled > wanted {
      set target = doubled;
    }
    let fits = target <= 4611686018427387904_u64;
    if fits {
      if target >= log^.inner.cap {
        grow(cell: log, capacity: target);
      }
    }
  }
  return unit;
}

fn log_byte(log: &Box<Slots<u8>>, value: u8) -> result: unit writes(log) {
  doc "Appends one byte to the buffer, which log_reserve gave room.";
  if log^.inner.len < log^.inner.cap {
    place_back(window: &log^.inner, value: value);
  }
  return unit;
}

fn log_crlf(log: &Box<Slots<u8>>) -> result: unit writes(log) {
  doc "Appends CR LF.";
  log_byte(log: log, value: 13_u8);
  log_byte(log: log, value: 10_u8);
  return unit;
}

fn log_decimal(log: &Box<Slots<u8>>, value: u64) -> result: unit writes(log) {
  doc "Appends a number in decimal.";
  let digits = array_filled::<u8, 20>(value: 0_u8);
  let count = 0_u64;
  let rest = value;
  loop @digits (
    decreases rest
  ) {
    let low = rest % 10_u64;
    let narrow = cvt.wrap::<u64, u8>(low);
    let glyph = narrow +wrap 48_u8;
    if count < 20_u64 {
      set digits[count] = glyph;
      set count = count +wrap 1_u64;
    }
    set rest = rest / 10_u64;
    if rest == 0_u64 {
      break @digits;
    }
  }
  for @emit (index in 0_u64..count) {
    let back = count -wrap index;
    let from = back -wrap 1_u64;
    let glyph = 48_u8;
    if from < 20_u64 {
      set glyph = digits[from];
    }
    log_byte(log: log, value: glyph);
  }
  return unit;
}

fn decimal_length(value: u64) -> result: u64 pure {
  doc "The number of decimal digits of a number.";
  let count = 0_u64;
  let rest = value;
  loop @digits (
    decreases rest
  ) {
    set count = count +wrap 1_u64;
    set rest = rest / 10_u64;
    if rest == 0_u64 {
      break @digits;
    }
  }
  return count;
}

fn log_count(log: &Box<Slots<u8>>, count: u64) -> result: unit writes(log) {
  doc "Appends a RESP array header of count elements.";
  log_byte(log: log, value: 42_u8);
  log_decimal(log: log, value: count);
  log_crlf(log: log);
  return unit;
}

fn log_length(log: &Box<Slots<u8>>, length: u64) -> result: unit writes(log) {
  doc "Appends a RESP bulk string header of length bytes.";
  log_byte(log: log, value: 36_u8);
  log_decimal(log: log, value: length);
  log_crlf(log: log);
  return unit;
}

fn log_bulk_word(log: &Box<Slots<u8>>, word: &[u8]) -> result: unit reads(word), writes(log) {
  doc "Appends a constant word as a RESP bulk string.";
  let count = word^.len;
  log_length(log: log, length: count);
  for @word (offset in 0_u64..count) {
    let byte = word^[offset];
    log_byte(log: log, value: byte);
  }
  log_crlf(log: log);
  return unit;
}

fn log_bulk_input(log: &Box<Slots<u8>>, input: &[u8], start: u64, length: u64) -> result: unit reads(input), writes(log) {
  doc "Appends an argument of the input as a RESP bulk string.";
  log_length(log: log, length: length);
  for @copy (offset in 0_u64..length) {
    let position = start +wrap offset;
    let byte = byte_at(input: input, index: position);
    log_byte(log: log, value: byte);
  }
  log_crlf(log: log);
  return unit;
}

fn log_bulk_decimal(log: &Box<Slots<u8>>, value: u64) -> result: unit writes(log) {
  doc "Appends a number as a RESP bulk string of its decimal digits.";
  let digits = decimal_length(value: value);
  log_length(log: log, length: digits);
  log_decimal(log: log, value: value);
  log_crlf(log: log);
  return unit;
}

fn log_set(log: &Box<Slots<u8>>, input: &[u8], command: &Command) -> result: unit reads(input), reads(command), writes(log) {
  doc "Appends SET key value.";
  let sizes = command^.second_length +wrap command^.third_length;
  let needed = sizes +wrap 96_u64;
  log_reserve(log: log, needed: needed);
  log_count(log: log, count: 3_u64);
  log_bulk_word(log: log, word: &word_set[0_u64..3_u64]);
  log_bulk_input(log: log, input: input, start: command^.second_start, length: command^.second_length);
  log_bulk_input(log: log, input: input, start: command^.third_start, length: command^.third_length);
  return unit;
}

fn log_key_command(log: &Box<Slots<u8>>, word: &[u8], input: &[u8], command: &Command) -> result: unit reads(word), reads(input), reads(command), writes(log) {
  doc "Appends a command of one word and the key.";
  let needed = command^.second_length +wrap 64_u64;
  log_reserve(log: log, needed: needed);
  log_count(log: log, count: 2_u64);
  log_bulk_word(log: log, word: word);
  log_bulk_input(log: log, input: input, start: command^.second_start, length: command^.second_length);
  return unit;
}

fn log_expire_at(log: &Box<Slots<u8>>, input: &[u8], command: &Command, at_ms: u64) -> result: unit reads(input), reads(command), writes(log) {
  doc "Appends PEXPIREAT key with the expiry as calendar milliseconds, as Redis 7 writes an expiry EXPIRE, PEXPIRE or PEXPIREAT sets; Redis writes a SET with an expiry as one SET with PXAT, which this subset writes as SET followed by PEXPIREAT.";
  let needed = command^.second_length +wrap 96_u64;
  log_reserve(log: log, needed: needed);
  log_count(log: log, count: 3_u64);
  log_bulk_word(log: log, word: &word_pexpireat[0_u64..9_u64]);
  log_bulk_input(log: log, input: input, start: command^.second_start, length: command^.second_length);
  log_bulk_decimal(log: log, value: at_ms);
  return unit;
}

fn run_set(store: &Shared<Store>, input: &[u8], command: &Command, output: &[u8], at: u64, env: &KeyEnv, time: &Time) -> result: u64 reads(store), reads(input), reads(command), reads(env), reads(time), writes(output) waits {
  doc "SET key value [EX seconds | PX milliseconds]: stores the value with the expiry the option gives, or none, in one atomic statement that also appends the change to the append-only file's buffer.";
  let key_long = command^.second_length > 48_u64;
  let value_long = command^.third_length > 1024_u64;
  let long = bor(key_long, value_long);
  if long {
    let after = put_word(output: output, at: at, word: &reply_long[0_u64..44_u64]);
    return after;
  }
  let ttl_ms = 0_u64;
  if command^.count == 5_u64 {
    let in_seconds = name_is(input: input, start: command^.fourth_start, length: command^.fourth_length, word: &word_ex[0_u64..2_u64]);
    let in_milliseconds = name_is(input: input, start: command^.fourth_start, length: command^.fourth_length, word: &word_px[0_u64..2_u64]);
    let known = bor(in_seconds, in_milliseconds);
    if known {
    } else {
      let after = put_word(output: output, at: at, word: &reply_syntax[0_u64..19_u64]);
      return after;
    }
    let number = arg_number(input: input, start: command^.fifth_start, length: command^.fifth_length);
    if number.state != 1_u64 {
      let after = put_word(output: output, at: at, word: &reply_integer[0_u64..46_u64]);
      return after;
    }
    let zero = number.value == 0_u64;
    let beyond = number.value > 1000000000000_u64;
    if in_seconds {
      set beyond = number.value > 1000000000_u64;
    }
    let invalid = bor(zero, beyond);
    if invalid {
      let after = put_word(output: output, at: at, word: &reply_expire_set[0_u64..43_u64]);
      return after;
    }
    set ttl_ms = number.value;
    if in_seconds {
      set ttl_ms = number.value *wrap 1000_u64;
    }
  } else if command^.count != 3_u64 {
    let after = put_word(output: output, at: at, word: &reply_syntax[0_u64..19_u64]);
    return after;
  }
  let key = make_key(input: input, start: command^.second_start, length: command^.second_length);
  let value = make_value(input: input, start: command^.third_start, length: command^.third_length);
  let expires = 0_u64;
  if ttl_ms != 0_u64 {
    let ttl_ns = ttl_ms *wrap 1000000_u64;
    set expires = time^.now +wrap ttl_ns;
  }
  let at_ms = time^.unix_ms +wrap ttl_ms;
  let held_entry = Entry(bytes: move value, expires: expires);
  let stored = True();
  atomic state = &store^ {
    let put = hash_map_put::<KeyBytes, Entry, 4194304>(map: &state^.map, key: key, value: move held_entry, env: env);
    match move put {
      HashMapInserted() => {
      }
      HashMapReturned(reason: why, pair: returned) => {
        match why {
          HashMapReplaced() => {
          }
          HashMapFull() => {
            set stored = False();
          }
        }
      }
    }
    if stored {
      if expires != 0_u64 {
        let due = Due(key: key, at: expires);
        let queued = priority_queue_push::<DueOrder, 4194304>(queue: &state^.due, value: due, env: env);
      }
      if state^.logging {
        log_set(log: &state^.log, input: input, command: command);
        if expires != 0_u64 {
          log_expire_at(log: &state^.log, input: input, command: command, at_ms: at_ms);
        }
      }
    }
  }
  if stored {
    let after = put_word(output: output, at: at, word: &reply_ok[0_u64..5_u64]);
    return after;
  }
  let after = put_word(output: output, at: at, word: &reply_full[0_u64..20_u64]);
  return after;
}

fn run_get(store: &Shared<Store>, input: &[u8], command: &Command, output: &[u8], at: u64, env: &KeyEnv, copied: &Copied, time: &Time) -> result: u64 reads(store), reads(input), reads(command), reads(env), reads(time), writes(output), writes(copied) waits {
  doc "GET key: copies a live value out in one atomic statement, which removes the key instead when its expiry has been reached, then encodes it as a bulk string.";
  if command^.second_length > 48_u64 {
    let after = put_word(output: output, at: at, word: &reply_nil[0_u64..5_u64]);
    return after;
  }
  let key = make_key(input: input, start: command^.second_start, length: command^.second_length);
  set copied^.now = time^.check;
  set copied^.expired = False();
  let found = Err<u64, unit>(error: unit);
  atomic state = &store^ {
    set found = hash_map_lookup::<KeyBytes, Entry, Copied, u64, fn copy_value, 4194304>(map: &state^.map, key: &key, key_env: env, visit_env: copied);
    if copied^.expired {
      let gone = hash_map_remove::<KeyBytes, Entry, 4194304>(map: &state^.map, key: &key, env: env);
    }
  }
  if copied^.expired {
    let after = put_word(output: output, at: at, word: &reply_nil[0_u64..5_u64]);
    return after;
  }
  match found {
    Ok(value: length) => {
      let position = put_byte(output: output, at: at, value: 36_u8);
      set position = put_decimal(output: output, at: position, value: length);
      set position = put_word(output: output, at: position, word: &reply_crlf[0_u64..2_u64]);
      let copied_length = copied^.length;
      if copied_length <= 1024_u64 {
        for @bytes (index in 0_u64..copied_length) {
          let byte = copied^.bytes[index];
          set position = put_byte(output: output, at: position, value: byte);
        }
      }
      set position = put_word(output: output, at: position, word: &reply_crlf[0_u64..2_u64]);
      return position;
    }
    Err(error: absent) => {
      let after = put_word(output: output, at: at, word: &reply_nil[0_u64..5_u64]);
      return after;
    }
  }
}

fn run_del(store: &Shared<Store>, input: &[u8], command: &Command, output: &[u8], at: u64, env: &KeyEnv, time: &Time) -> result: u64 reads(store), reads(input), reads(command), reads(env), reads(time), writes(output) waits {
  doc "DEL key: removes the key in one atomic statement and answers how many live keys it removed.";
  let removed = 0_u64;
  if command^.second_length <= 48_u64 {
    let key = make_key(input: input, start: command^.second_start, length: command^.second_length);
    atomic state = &store^ {
      let pair = hash_map_remove::<KeyBytes, Entry, 4194304>(map: &state^.map, key: &key, env: env);
      match move pair {
        Some(value: gone) => {
          let reached = expired(expires: gone.value.expires, now: time^.check);
          if reached {
          } else {
            set removed = 1_u64;
            if state^.logging {
              log_key_command(log: &state^.log, word: &word_del[0_u64..3_u64], input: input, command: command);
            }
          }
        }
        None() => {
        }
      }
    }
  }
  let after = put_integer(output: output, at: at, value: removed);
  return after;
}

fn run_incr(store: &Shared<Store>, input: &[u8], command: &Command, output: &[u8], at: u64, env: &KeyEnv, time: &Time) -> result: u64 reads(store), reads(input), reads(command), reads(env), reads(time), writes(output) waits {
  doc "INCR key: adds one to the stored number, keeping its expiry, or stores 1 without one for an absent or expired key, in one atomic statement.";
  if command^.second_length > 48_u64 {
    let after = put_word(output: output, at: at, word: &reply_long[0_u64..44_u64]);
    return after;
  }
  let key = make_key(input: input, start: command^.second_start, length: command^.second_length);
  let counted = Counted(value: 0_u64, now: time^.check, state: 0_u64);
  atomic state = &store^ {
    let edited = hash_map_edit::<KeyBytes, Entry, Counted, u64, fn bump_value, 4194304>(map: &state^.map, key: &key, key_env: env, edit_env: &counted);
    let fresh_needed = False();
    match edited {
      Ok(value: outcome) => {
        if outcome == 2_u64 {
          let gone = hash_map_remove::<KeyBytes, Entry, 4194304>(map: &state^.map, key: &key, env: env);
          set fresh_needed = True();
        }
      }
      Err(error: absent) => {
        set fresh_needed = True();
      }
    }
    if fresh_needed {
      let fresh = decimal_value(value: 1_u64);
      let held_entry = Entry(bytes: move fresh, expires: 0_u64);
      let put = hash_map_put::<KeyBytes, Entry, 4194304>(map: &state^.map, key: key, value: move held_entry, env: env);
      set counted.value = 1_u64;
      set counted.state = 1_u64;
    }
    if counted.state == 1_u64 {
      if state^.logging {
        log_key_command(log: &state^.log, word: &word_incr[0_u64..4_u64], input: input, command: command);
      }
    }
  }
  if counted.state == 1_u64 {
    let after = put_integer(output: output, at: at, value: counted.value);
    return after;
  }
  let after = put_word(output: output, at: at, word: &reply_integer[0_u64..46_u64]);
  return after;
}

fn run_expire(store: &Shared<Store>, input: &[u8], command: &Command, output: &[u8], at: u64, env: &KeyEnv, time: &Time, scale: u64, absolute: Bool, invalid: &[u8]) -> result: u64 reads(store), reads(input), reads(command), reads(env), reads(time), reads(invalid), writes(output) waits {
  doc "EXPIRE key seconds (scale 1000), PEXPIRE key milliseconds (scale 1) and PEXPIREAT key calendar-milliseconds (absolute): gives a live key an expiry, or removes it when the expiry is zero or already past, and answers 1 when the key was live and 0 otherwise. While the file is replayed an expiry already past is kept as one already reached, as Redis keeps it while loading, so a later PERSIST in the file still finds the key; invalid is the reply to an expiry out of range.";
  if command^.second_length > 48_u64 {
    let after = put_word(output: output, at: at, word: &reply_zero[0_u64..4_u64]);
    return after;
  }
  let number = arg_number(input: input, start: command^.third_start, length: command^.third_length);
  if number.state != 1_u64 {
    let after = put_word(output: output, at: at, word: &reply_integer[0_u64..46_u64]);
    return after;
  }
  let ttl_ms = 0_u64;
  let remove_now = False();
  if absolute {
    if number.value <= time^.unix_ms {
      set remove_now = True();
    } else {
      set ttl_ms = number.value -wrap time^.unix_ms;
    }
  } else if number.value == 0_u64 {
    set remove_now = True();
  } else {
    let limit = 1000000000000_u64;
    if scale == 1000_u64 {
      set limit = 1000000000_u64;
    }
    if number.value > limit {
      let after = put_word(output: output, at: at, word: invalid);
      return after;
    }
    set ttl_ms = number.value *wrap scale;
  }
  if ttl_ms > 1000000000000_u64 {
    let after = put_word(output: output, at: at, word: invalid);
    return after;
  }
  let key = make_key(input: input, start: command^.second_start, length: command^.second_length);
  let ttl_ns = ttl_ms *wrap 1000000_u64;
  let expires = time^.now +wrap ttl_ns;
  if remove_now {
    if time^.loading {
      set remove_now = False();
      set expires = 1_u64;
    }
  }
  let at_ms = time^.unix_ms +wrap ttl_ms;
  let expiry = Expiry(at: expires, now: time^.check, state: 0_u64);
  atomic state = &store^ {
    if remove_now {
      let pair = hash_map_remove::<KeyBytes, Entry, 4194304>(map: &state^.map, key: &key, env: env);
      match move pair {
        Some(value: gone) => {
          let reached = expired(expires: gone.value.expires, now: time^.check);
          if reached {
          } else {
            set expiry.state = 1_u64;
            if state^.logging {
              log_key_command(log: &state^.log, word: &word_del[0_u64..3_u64], input: input, command: command);
            }
          }
        }
        None() => {
        }
      }
    } else {
      let edited = hash_map_edit::<KeyBytes, Entry, Expiry, u64, fn set_expiry, 4194304>(map: &state^.map, key: &key, key_env: env, edit_env: &expiry);
      match edited {
        Ok(value: outcome) => {
          if outcome == 2_u64 {
            let gone = hash_map_remove::<KeyBytes, Entry, 4194304>(map: &state^.map, key: &key, env: env);
          }
        }
        Err(error: absent) => {
        }
      }
      if expiry.state == 1_u64 {
        let due = Due(key: key, at: expires);
        let queued = priority_queue_push::<DueOrder, 4194304>(queue: &state^.due, value: due, env: env);
        if state^.logging {
          log_expire_at(log: &state^.log, input: input, command: command, at_ms: at_ms);
        }
      }
    }
  }
  if expiry.state == 1_u64 {
    let after = put_word(output: output, at: at, word: &reply_one[0_u64..4_u64]);
    return after;
  }
  let after = put_word(output: output, at: at, word: &reply_zero[0_u64..4_u64]);
  return after;
}

fn run_ttl(store: &Shared<Store>, input: &[u8], command: &Command, output: &[u8], at: u64, env: &KeyEnv, time: &Time, in_seconds: Bool) -> result: u64 reads(store), reads(input), reads(command), reads(env), reads(time), writes(output) waits {
  doc "TTL key and PTTL key: answers the time a live key has left, in seconds rounded as Redis rounds them or in milliseconds, -1 for a key without an expiry and -2 for an absent or expired one.";
  let remaining = Remaining(left: 0_u64, now: time^.check, state: 3_u64);
  if command^.second_length <= 48_u64 {
    let key = make_key(input: input, start: command^.second_start, length: command^.second_length);
    atomic state = &store^ {
      let found = hash_map_lookup::<KeyBytes, Entry, Remaining, u64, fn read_expiry, 4194304>(map: &state^.map, key: &key, key_env: env, visit_env: &remaining);
      if remaining.state == 0_u64 {
        let gone = hash_map_remove::<KeyBytes, Entry, 4194304>(map: &state^.map, key: &key, env: env);
      }
    }
  }
  if remaining.state == 1_u64 {
    let after = put_word(output: output, at: at, word: &reply_no_expiry[0_u64..5_u64]);
    return after;
  }
  if remaining.state == 2_u64 {
    let milliseconds = remaining.left / 1000000_u64;
    let answer = milliseconds;
    if in_seconds {
      let rounded = milliseconds +wrap 500_u64;
      set answer = rounded / 1000_u64;
    }
    let after = put_integer(output: output, at: at, value: answer);
    return after;
  }
  let after = put_word(output: output, at: at, word: &reply_no_key[0_u64..5_u64]);
  return after;
}

fn run_persist(store: &Shared<Store>, input: &[u8], command: &Command, output: &[u8], at: u64, env: &KeyEnv, time: &Time) -> result: u64 reads(store), reads(input), reads(command), reads(env), reads(time), writes(output) waits {
  doc "PERSIST key: removes a live key's expiry and answers 1 when it had one, 0 otherwise.";
  let expiry = Expiry(at: 0_u64, now: time^.check, state: 0_u64);
  if command^.second_length <= 48_u64 {
    let key = make_key(input: input, start: command^.second_start, length: command^.second_length);
    atomic state = &store^ {
      let edited = hash_map_edit::<KeyBytes, Entry, Expiry, u64, fn clear_expiry, 4194304>(map: &state^.map, key: &key, key_env: env, edit_env: &expiry);
      match edited {
        Ok(value: outcome) => {
          if outcome == 2_u64 {
            let gone = hash_map_remove::<KeyBytes, Entry, 4194304>(map: &state^.map, key: &key, env: env);
          }
        }
        Err(error: absent) => {
        }
      }
      if expiry.state == 1_u64 {
        if state^.logging {
          log_key_command(log: &state^.log, word: &word_persist[0_u64..7_u64], input: input, command: command);
        }
      }
    }
  }
  if expiry.state == 1_u64 {
    let after = put_word(output: output, at: at, word: &reply_one[0_u64..4_u64]);
    return after;
  }
  let after = put_word(output: output, at: at, word: &reply_zero[0_u64..4_u64]);
  return after;
}

fn run_dbsize(store: &Shared<Store>, output: &[u8], at: u64) -> result: u64 reads(store), writes(output) waits {
  doc "DBSIZE: answers how many keys the keyspace holds, counting an expired key not yet removed, as Redis does.";
  let size = 0_u64;
  atomic state = &store^ {
    set size = hash_map_len::<Key, Entry, 4194304>(map: &state^.map);
  }
  let after = put_integer(output: output, at: at, value: size);
  return after;
}

fn execute(store: &Shared<Store>, input: &[u8], command: &Command, output: &[u8], at: u64, env: &KeyEnv, copied: &Copied, time: &Time) -> result: u64 reads(store), reads(input), reads(command), reads(env), reads(time), writes(output), writes(copied) waits {
  doc "Answers one parsed command into the output from a position and returns the position after the answer.";
  let start = command^.first_start;
  let length = command^.first_length;
  let count = command^.count;
  let relative = False();
  let calendar = True();
  let whole_seconds = True();
  let milliseconds = False();
  if name_is(input: input, start: start, length: length, word: &word_ping[0_u64..4_u64]) {
    let after = put_word(output: output, at: at, word: &reply_pong[0_u64..7_u64]);
    return after;
  }
  if name_is(input: input, start: start, length: length, word: &word_get[0_u64..3_u64]) {
    if count == 2_u64 {
      let after = run_get(store: store, input: input, command: command, output: output, at: at, env: env, copied: copied, time: time);
      return after;
    }
  } else if name_is(input: input, start: start, length: length, word: &word_set[0_u64..3_u64]) {
    if count >= 3_u64 {
      let after = run_set(store: store, input: input, command: command, output: output, at: at, env: env, time: time);
      return after;
    }
  } else if name_is(input: input, start: start, length: length, word: &word_incr[0_u64..4_u64]) {
    if count == 2_u64 {
      let after = run_incr(store: store, input: input, command: command, output: output, at: at, env: env, time: time);
      return after;
    }
  } else if name_is(input: input, start: start, length: length, word: &word_del[0_u64..3_u64]) {
    if count == 2_u64 {
      let after = run_del(store: store, input: input, command: command, output: output, at: at, env: env, time: time);
      return after;
    }
  } else if name_is(input: input, start: start, length: length, word: &word_expire[0_u64..6_u64]) {
    if count == 3_u64 {
      let after = run_expire(store: store, input: input, command: command, output: output, at: at, env: env, time: time, scale: 1000_u64, absolute: relative, invalid: &reply_expire_expire[0_u64..46_u64]);
      return after;
    }
  } else if name_is(input: input, start: start, length: length, word: &word_pexpire[0_u64..7_u64]) {
    if count == 3_u64 {
      let after = run_expire(store: store, input: input, command: command, output: output, at: at, env: env, time: time, scale: 1_u64, absolute: relative, invalid: &reply_expire_pexpire[0_u64..47_u64]);
      return after;
    }
  } else if name_is(input: input, start: start, length: length, word: &word_pexpireat[0_u64..9_u64]) {
    if count == 3_u64 {
      let after = run_expire(store: store, input: input, command: command, output: output, at: at, env: env, time: time, scale: 1_u64, absolute: calendar, invalid: &reply_expire_pexpireat[0_u64..49_u64]);
      return after;
    }
  } else if name_is(input: input, start: start, length: length, word: &word_ttl[0_u64..3_u64]) {
    if count == 2_u64 {
      let after = run_ttl(store: store, input: input, command: command, output: output, at: at, env: env, time: time, in_seconds: whole_seconds);
      return after;
    }
  } else if name_is(input: input, start: start, length: length, word: &word_pttl[0_u64..4_u64]) {
    if count == 2_u64 {
      let after = run_ttl(store: store, input: input, command: command, output: output, at: at, env: env, time: time, in_seconds: milliseconds);
      return after;
    }
  } else if name_is(input: input, start: start, length: length, word: &word_persist[0_u64..7_u64]) {
    if count == 2_u64 {
      let after = run_persist(store: store, input: input, command: command, output: output, at: at, env: env, time: time);
      return after;
    }
  } else if name_is(input: input, start: start, length: length, word: &word_dbsize[0_u64..6_u64]) {
    if count == 1_u64 {
      let after = run_dbsize(store: store, output: output, at: at);
      return after;
    }
  } else {
    let after = put_word(output: output, at: at, word: &reply_unknown[0_u64..22_u64]);
    return after;
  }
  let after = put_word(output: output, at: at, word: &reply_arguments[0_u64..32_u64]);
  return after;
}

fn send_all(send: &TcpSend, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(send) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  doc "Sends one prefix of the source range, reattempting until the connection has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @sending {
    let pending = sent < length;
    if pending {
    } else {
      break @sending;
    }
    let no_deadline = None<Instant>();
    match send_once(send: send, source: source, start: sent, end: length, deadline: no_deadline) {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn keep_rest(input: &[u8], from: u64, held: u64) -> result: u64 writes(input) {
  doc "Moves the bytes of an incomplete command to the front of the input and returns how many it moved.";
  let kept = 0_u64;
  if from < held {
    set kept = held -wrap from;
  }
  for @move_bytes (offset in 0_u64..kept) {
    let source = from +wrap offset;
    let byte = byte_at(input: input, index: source);
    let unused = put_byte(output: input, at: offset, value: byte);
  }
  return kept;
}

fn read_time(clock: &Clock, wall: &WallClock, origin: Instant) -> result: Time reads(wall), writes(clock) {
  doc "Reads both clocks: the monotonic one as nanoseconds from the program's origin, and the calendar one as milliseconds since 1970.";
  let reading = std::time::now(clock: clock);
  let offset = nanoseconds_from(earlier: origin, later: reading);
  let calendar = unix_nanoseconds(clock: wall);
  let unix_ms = 0_u64;
  if calendar > 0_i64 {
    let wide = cvt.wrap::<i64, u64>(calendar);
    set unix_ms = wide / 1000000_u64;
  }
  let live = False();
  return Time(now: offset, unix_ms: unix_ms, check: offset, loading: live);
}

fn serve(connection: TcpConnection, factory: HandleFactory, store: Shared<Store>, clock: Clock, wall: WallClock, origin: Instant, idle: u64) -> result: unit pure waits {
  doc "Serves one client in a context of its own: reads requests into its input, answers every complete command the input holds with one send, and keeps an incomplete one for the next read. Every command of one read sees the clocks as read once after it, and a client silent for idle seconds, when idle is not zero, is closed.";
  let env = KeyEnv(seed: 0_u64);
  let blank = array_filled::<u8, 1024>(value: 0_u8);
  let fresh = False();
  let copied = Copied(bytes: blank, length: 0_u64, now: 0_u64, expired: fresh);
  let input_window = slots_new::<u8, 16384>();
  for @fill_input (
    at in 0_u64..16384_u64,
    invariant grown_input: input_window.len == at
  ) {
    place_back(window: &input_window, value: 0_u8);
  }
  let output_window = slots_new::<u8, 16384>();
  for @fill_output (
    at in 0_u64..16384_u64,
    invariant grown_output: output_window.len == at
  ) {
    place_back(window: &output_window, value: 0_u8);
  }
  let input = &input_window[0_u64..16384_u64];
  let output = &output_window[0_u64..16384_u64];
  let idle_ns = idle *wrap 1000000000_u64;
  let held = 0_u64;
  loop @requests {
    if held >= 16384_u64 {
      break @requests;
    }
    let ended = False();
    let limit = None<Instant>();
    if idle != 0_u64 {
      let before = std::time::now(clock: &clock);
      let bound = instant_after(instant: before, nanoseconds: idle_ns);
      set limit = Some<Instant>(value: bound);
    }
    match receive_next(receive: &connection.receive, destination: input, start: held, end: 16384_u64, deadline: limit) {
      Ok(value: next) => {
        set held = next;
      }
      Err(error: stop) => {
        set ended = True();
      }
    }
    if ended {
      break @requests;
    }
    let time = read_time(clock: &clock, wall: &wall, origin: origin);
    let consumed = 0_u64;
    let written = 0_u64;
    let broken = False();
    loop @commands {
      let command = parse_command(input: input, start: consumed, held: held);
      if command.state == 0_u64 {
        break @commands;
      }
      if command.state == 2_u64 {
        set broken = True();
        break @commands;
      }
      set written = execute(store: &store, input: input, command: &command, output: output, at: written, env: &env, copied: &copied, time: &time);
      set consumed = command.next;
      if written > 12288_u64 {
        let bounded = written;
        if bounded > 16384_u64 {
          set bounded = 16384_u64;
        }
        match send_all(send: &connection.send, source: output, length: bounded) {
          Ok(value: delivered) => {
          }
          Err(error: problem) => {
            set broken = True();
            break @commands;
          }
        }
        set written = 0_u64;
      }
    }
    if written > 0_u64 {
      let bounded = written;
      if bounded > 16384_u64 {
        set bounded = 16384_u64;
      }
      match send_all(send: &connection.send, source: output, length: bounded) {
        Ok(value: delivered) => {
        }
        Err(error: problem) => {
          set broken = True();
        }
      }
    }
    if broken {
      break @requests;
    }
    set held = keep_rest(input: input, from: consumed, held: held);
  }
  let TcpConnection(receive: closing_receive, send: closing_send) = move connection;
  close_receive(factory: &factory, receive: move closing_receive);
  close_send(factory: &factory, send: move closing_send);
  atomic state = &store {
    set state^.clients = state^.clients -wrap 1_u64;
  }
  return unit;
}

fn expire_batch(store: &Store, now: u64, env: &KeyEnv) -> result: Bool reads(env), writes(store) {
  doc "Removes up to 256 keys whose expiry has been reached, the earliest first, and returns whether more may be due. A queued expiry that no longer matches its key's, because the key was set, given another expiry or removed since, is dropped.";
  for @batch (step in 0_u64..256_u64) {
    let pending = priority_queue_len::<Due, 4194304>(queue: &store^.due);
    if pending > 0_u64 {
      let probe = Probe(at: 0_u64);
      let first = priority_queue_peek::<Due, Probe, u64, fn due_at, 4194304>(queue: &store^.due, env: &probe);
      if first > now {
        return False();
      }
      let due = priority_queue_pop::<DueOrder, 4194304>(queue: &store^.due, env: env);
      let seen = Probe(at: 0_u64);
      let found = hash_map_lookup::<KeyBytes, Entry, Probe, u64, fn entry_expiry, 4194304>(map: &store^.map, key: &due.key, key_env: env, visit_env: &seen);
      match found {
        Ok(value: expires) => {
          if expires == due.at {
            let gone = hash_map_remove::<KeyBytes, Entry, 4194304>(map: &store^.map, key: &due.key, env: env);
          }
        }
        Err(error: absent) => {
        }
      }
    } else {
      return False();
    }
  }
  return True();
}

fn expire_keys(store: Shared<Store>, clock: Clock, origin: Instant) -> result: unit pure waits {
  doc "Wakes ten times a second and removes the keys whose expiry has passed, in batches of atomic statements so that clients proceed between them, until the program stops. One tick runs at most 16,384 batches of 256, enough to empty a full queue; what clients queue meanwhile waits for the next tick. A key whose expiry did not fit the queue, which holds 4,194,304 entries counting those a later command replaced, is removed only when a command finds it expired.";
  let env = KeyEnv(seed: 0_u64);
  loop @ticks {
    let started = std::time::now(clock: &clock);
    let wake = instant_after(instant: started, nanoseconds: 100000000_u64);
    sleep_until(deadline: wake);
    let reading = std::time::now(clock: &clock);
    let current = nanoseconds_from(earlier: origin, later: reading);
    let stop = False();
    for @batches (batch in 0_u64..16384_u64) {
      let more = False();
      atomic state = &store {
        set stop = state^.stopping;
        set more = expire_batch(store: &state^, now: current, env: &env);
      }
      if more {
      } else {
        break @batches;
      }
    }
    if stop {
      break @ticks;
    }
  }
  return unit;
}

fn append_all(factory: &HandleFactory, file: &WriteFile, source: &Box<Slots<u8>>) -> result: Bool reads(source), writes(factory), writes(file) waits {
  doc "Appends every byte the buffer holds to the file, reattempting until the host has taken them all; false reports a refusal or a write that took nothing.";
  let length = source^.inner.len;
  let bytes = &source^.inner[0_u64..length];
  let written = 0_u64;
  loop @appending {
    if written >= length {
      break @appending;
    }
    match append_once(factory: factory, file: file, source: bytes, start: written, end: length) {
      Ok(value: next) => {
        if next == written {
          return False();
        }
        set written = next;
      }
      Err(error: problem) => {
        return False();
      }
    }
  }
  return True();
}

fn write_log(store: Shared<Store>, factory: HandleFactory, file: WriteFile, clock: Clock) -> result: unit pure waits {
  doc "The append-only file's writer: every 10 milliseconds it exchanges the keyspace's buffer for an empty one in one atomic statement and appends what it took to the file, syncing the file once a second has passed since the last sync, as appendfsync everysec does. Once the program stops it writes the last buffer, syncs and closes the file.";
  let spare = box_slots_new::<u8>(capacity: 65536_u64);
  let last_sync = std::time::now(clock: &clock);
  loop @writing {
    let started = std::time::now(clock: &clock);
    let wake = instant_after(instant: started, nanoseconds: 10000000_u64);
    sleep_until(deadline: wake);
    let stop = False();
    atomic state = &store {
      set stop = state^.stopping;
      swap(first: &state^.log, second: &spare);
    }
    let appended = append_all(factory: &factory, file: &file, source: &spare);
    set spare = box_slots_new::<u8>(capacity: 65536_u64);
    let reading = std::time::now(clock: &clock);
    let since = nanoseconds_from(earlier: last_sync, later: reading);
    let second_passed = since >= 1000000000_u64;
    let sync_now = bor(second_passed, stop);
    if sync_now {
      let synced = sync_file(factory: &factory, file: &file);
      set last_sync = reading;
    }
    if stop {
      break @writing;
    }
  }
  let closed = close_write(factory: &factory, file: move file);
  return unit;
}

fn replay(store: &Shared<Store>, factory: &HandleFactory, root: &DirectoryRead, name: &[u8], name_length: u64, time: &Time) -> result: u64 reads(store), reads(root), reads(name), reads(time), writes(factory) waits contract {
  requires name_length <= name^.len;
} {
  doc "Applies every command of the append-only file the name names, when one exists, and returns how many it applied. As Redis does while loading, no key counts as expired during the replay, time's check being zero, and an expiry whose calendar time has passed is kept as one already reached, so the commands after it in the file apply as they did when they were written; lazy and active expiry remove such a key once the subset listens.";
  let applied = 0_u64;
  match open_file(factory: factory, root: root, name: name, start: 0_u64, end: name_length) {
    Ok(value: file) => {
      let env = KeyEnv(seed: 0_u64);
      let blank = array_filled::<u8, 1024>(value: 0_u8);
      let fresh = False();
      let copied = Copied(bytes: blank, length: 0_u64, now: 0_u64, expired: fresh);
      let input_window = slots_new::<u8, 65536>();
      for @fill_input (
        at in 0_u64..65536_u64,
        invariant grown_input: input_window.len == at
      ) {
        place_back(window: &input_window, value: 0_u8);
      }
      let output_window = slots_new::<u8, 16384>();
      for @fill_output (
        at in 0_u64..16384_u64,
        invariant grown_output: output_window.len == at
      ) {
        place_back(window: &output_window, value: 0_u8);
      }
      let input = &input_window[0_u64..65536_u64];
      let output = &output_window[0_u64..16384_u64];
      let held = 0_u64;
      let offset = 0_u64;
      loop @chunks {
        if held >= 65536_u64 {
          break @chunks;
        }
        let ended = False();
        match read_at(factory: factory, file: &file, destination: input, file_offset: offset, start: held, end: 65536_u64) {
          Ok(value: next) => {
            let got = next -wrap held;
            set offset = offset +wrap got;
            set held = next;
            if got == 0_u64 {
              set ended = True();
            }
          }
          Err(error: stop) => {
            set ended = True();
          }
        }
        if ended {
          break @chunks;
        }
        let consumed = 0_u64;
        let broken = False();
        loop @commands {
          let command = parse_command(input: input, start: consumed, held: held);
          if command.state == 0_u64 {
            break @commands;
          }
          if command.state == 2_u64 {
            set broken = True();
            break @commands;
          }
          let answered = execute(store: store, input: input, command: &command, output: output, at: 0_u64, env: &env, copied: &copied, time: time);
          set applied = applied +wrap 1_u64;
          set consumed = command.next;
        }
        if broken {
          break @chunks;
        }
        set held = keep_rest(input: input, from: consumed, held: held);
      }
      let closed = close_read(factory: factory, file: move file);
    }
    Err(error: problem) => {
    }
  }
  return applied;
}

fn parse_port(digits: &[u8], length: u64) -> result: u16 reads(digits) {
  doc "Reads one decimal port out of the argument bytes; a byte that is not a digit ends the number.";
  let port = 0_u16;
  for @scan (index in 0_u64..length) {
    let byte = byte_at(input: digits, index: index);
    let low = byte >= 48_u8;
    let high = byte <= 57_u8;
    let digit = band(low, high);
    if digit {
    } else {
      return port;
    }
    let value = byte -wrap 48_u8;
    let widened = cvt::<u8, u16>(value);
    let scaled = port *wrap 10_u16;
    set port = scaled +wrap widened;
  }
  return port;
}

fn argument(args: &std::text::Args, position: u64, window: &[u8]) -> result: u64 reads(args), writes(window) contract {
  ensures result <= window^.len;
} {
  doc "Copies one invocation argument into the window and returns its length, or zero when it is absent or does not fit.";
  let carried = 0_u64;
  let room = window^.len;
  match arg_get(args: args, position: position) {
    Ok(value: text) => {
      match host_copy_utf8(value: &text, destination: window, start: 0_u64, end: room) {
        Ok(value: written) => {
          set carried = written;
        }
        Err(error: problem) => {
          set carried = 0_u64;
        }
      }
    }
    Err(error: problem) => {
      set carried = 0_u64;
    }
  }
  if carried > room {
    return 0_u64;
  }
  return carried;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "A Redis subset: PING, SET with EX or PX, GET, DEL, INCR, EXPIRE, PEXPIRE, PEXPIREAT, TTL, PTTL, PERSIST and DBSIZE in RESP2 over TCP, with pipelining. It listens on the loopback port the first argument names and serves each accepted client in a context of its own over one keyspace, a shared object every client reaches through atomic statements. The second argument is how many clients to accept; zero accepts until the listener fails. A third argument other than - names an append-only file in the working directory: the subset replays it before it listens and appends every change to it, syncing it once a second. A fourth argument, when not zero, closes a client silent for that many seconds. Expired keys are removed when a command finds them and by a context that wakes ten times a second.";
  let Inputs(args: args, cwd: cwd_directory, stdout: unused_stdout, stderr: unused_stderr, handles: handles, stdin: unused_stdin, clock: clock, wall_clock: wall_clock) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  let digits = slots_new::<u8, 16>();
  for @fill_digits (
    at in 0_u64..16_u64,
    invariant grown_digits: digits.len == at
  ) {
    place_back(window: &digits, value: 0_u8);
  }
  let window = &digits[0_u64..16_u64];
  let names = slots_new::<u8, 256>();
  for @fill_names (
    at in 0_u64..256_u64,
    invariant grown_names: names.len == at
  ) {
    place_back(window: &names, value: 0_u8);
  }
  let name = &names[0_u64..256_u64];
  let arguments = args_count(args: &args);
  let usage = arguments < 3_u64;
  let port_length = 0_u64;
  if usage {
  } else {
    set port_length = argument(args: &args, position: 1_u64, window: window);
  }
  let unnamed = port_length == 0_u64;
  let refused = bor(usage, unnamed);
  if refused {
    close_directory_write(factory: &handles, directory: move cwd_write);
    close_directory(factory: &handles, directory: move cwd);
    if usage {
      return exit_status(code: 1_u8);
    }
    return exit_status(code: 2_u8);
  }
  let port = parse_port(digits: window, length: port_length);
  let count_length = argument(args: &args, position: 2_u64, window: window);
  let written_count = parse_port(digits: window, length: count_length);
  let count = cvt::<u16, u64>(written_count);
  let name_length = 0_u64;
  if arguments > 3_u64 {
    set name_length = argument(args: &args, position: 3_u64, window: name);
    if name_length == 1_u64 {
      if name^[0_u64] == 45_u8 {
        set name_length = 0_u64;
      }
    }
  }
  let idle = 0_u64;
  if arguments > 4_u64 {
    let idle_length = argument(args: &args, position: 4_u64, window: window);
    let written_idle = parse_port(digits: window, length: idle_length);
    set idle = cvt::<u16, u64>(written_idle);
  }
  let origin = std::time::now(clock: &clock);
  let map = hash_map_new::<Key, Entry, 4194304>(capacity: 1024_u64);
  let due = priority_queue_new::<Due, 4194304>();
  let log = box_slots_new::<u8>(capacity: 65536_u64);
  let quiet = False();
  let running = False();
  let initial = Store(map: move map, due: move due, log: move log, logging: quiet, clients: 0_u64, stopping: running);
  let keyspace = shared_new::<Store>(value: move initial);
  let failed = False();
  if name_length > 0_u64 {
    let read = read_time(clock: &clock, wall: &wall_clock, origin: origin);
    let replaying = True();
    let time = Time(now: read.now, unix_ms: read.unix_ms, check: 0_u64, loading: replaying);
    let applied = replay(store: &keyspace, factory: &handles, root: &cwd, name: name, name_length: name_length, time: &time);
    match open_append(factory: &handles, root: &cwd_write, name: name, start: 0_u64, end: name_length) {
      Ok(value: file) => {
        atomic state = &keyspace {
          set state^.logging = True();
        }
        let writer_store = shared_share::<Store>(shared: &keyspace);
        let writer_factory = factory_share(factory: &handles);
        let writer_clock = clock_share(clock: &clock);
        spawn write_log(store: move writer_store, factory: move writer_factory, file: move file, clock: move writer_clock);
      }
      Err(error: problem) => {
        set failed = True();
      }
    }
  }
  close_directory_write(factory: &handles, directory: move cwd_write);
  close_directory(factory: &handles, directory: move cwd);
  if failed {
    return exit_status(code: 4_u8);
  }
  let expiring_store = shared_share::<Store>(shared: &keyspace);
  let expiring_clock = clock_share(clock: &clock);
  spawn expire_keys(store: move expiring_store, clock: move expiring_clock, origin: origin);
  let address = socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: port);
  let listened = True();
  match tcp_listen(factory: &handles, address: &address) {
    Ok(value: listener) => {
      let accepted = 0_u64;
      loop @accepting {
        if count != 0_u64 {
          if accepted >= count {
            break @accepting;
          }
        }
        let no_deadline = None<Instant>();
        match tcp_accept(factory: &handles, listener: &listener, deadline: no_deadline) {
          Ok(value: next) => {
            let AcceptedConnection(connection: connection, peer: unused_peer) = move next;
            let factory = factory_share(factory: &handles);
            let handle = shared_share::<Store>(shared: &keyspace);
            let serving_clock = clock_share(clock: &clock);
            let serving_wall = wall_clock_share(clock: &wall_clock);
            atomic state = &keyspace {
              set state^.clients = state^.clients +wrap 1_u64;
            }
            spawn serve(connection: move connection, factory: move factory, store: move handle, clock: move serving_clock, wall: move serving_wall, origin: origin, idle: idle);
          }
          Err(error: problem) => {
            break @accepting;
          }
        }
        set accepted = accepted +wrap 1_u64;
      }
      close_listener(factory: &handles, listener: move listener);
    }
    Err(error: problem) => {
      set listened = False();
    }
  }
  atomic state = &keyspace when state^.clients == 0_u64 {
    set state^.stopping = True();
  }
  if listened {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 3_u8);
}
