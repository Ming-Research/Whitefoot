fn wait_until_set(cell: Shared<u64>) -> result: unit pure waits {
  doc "Waits for the starter to set the cell before completing.";
  atomic value = &cell when value^ != 0_u64 {
    set value^ = 2_u64;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  doc "Enables a spawned context's guard before joining its unused result at the loop body's end [WAIT-3].";
  let cell = shared_new::<u64>(value: 0_u64);
  for @once (index in 0_u64..1_u64) {
    let handle = shared_share::<u64>(shared: &cell);
    let pending = spawn wait_until_set(cell: move handle);
    atomic value = &cell {
      set value^ = 1_u64;
    }
  }
  return std::process::exit_status(code: 0_u8);
}
