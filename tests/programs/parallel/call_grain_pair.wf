alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias exit_status = std::process::exit_status;
alias write_once = std::io::write_once;

fn mix(seed: u64) -> result: u64 pure {
  doc "A pure mix of twenty-four rounds, the work each word of a range costs.";
  let state = seed;
  let round = 0_u64;
  loop @rounds {
    let done = round == 24_u64;
    if done {
      break @rounds;
    }
    let shifted = irotl(state, 27_u32);
    let scaled = state *wrap 6364136223846793005_u64;
    set state = ixor(shifted, scaled);
    set state = state +wrap 1442695040888963407_u64;
    set round = round +wrap 1_u64;
  }
  return state;
}

fn low_byte(v: u64) -> result: u8 pure {
  let low = iand(v, 255_u64);
  let byte = cvt::<u64, u8>(low);
  return byte;
}

fn spell(destination: &[u8], at: u64, value: u64) -> result: u64 writes(destination) {
  doc "Writes the eight little-endian bytes of value at the given offset, skipping any slot the range does not have.";
  let cursor = at;
  let rest = value;
  loop @octets {
    let limit = at +wrap 8_u64;
    let done = cursor >= limit;
    if done {
      break @octets;
    }
    let spare = destination^.len;
    let writable = cursor < spare;
    if writable {
      let byte = low_byte(v: rest);
      set destination^[cursor] = byte;
    }
    set rest = irotr(rest, 8_u32);
    set cursor = cursor +wrap 1_u64;
  }
  return at +wrap 8_u64;
}

fn mix_words(words: &[u64]) -> result: u64 writes(words) {
  doc "Chains every word of the range through mix, so the work grows with the range and no iteration is independent of the one before it.";
  let count = words^.len;
  let state = 0_u64;
  for (i in 0_u64..count) {
    let word = words^[i];
    let input = ixor(state, word);
    let mixed = mix(seed: input);
    set words^[i] = mixed;
    set state = mixed;
  }
  return state;
}

fn mix_both(left: &[u64], right: &[u64]) -> result: u64 writes(left), writes(right) {
  doc "Two adjacent calls over disjoint ranges, which may overlap; whether the first is offered depends on how long its range is.";
  let first = mix_words(words: left);
  let second = mix_words(words: right);
  return first +wrap second;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Mixes two ranges of three words each, or of a million words each when given any argument after the program name, which Args counts, and writes the combined result.";
  let Inputs(args: arguments, cwd: directory, stdout: out, handles: factory, ..) = move inputs;
  let std::fs::Directory(read: directory_read, write: directory_write) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move directory_write);
  std::fs::close_directory(factory: &factory, directory: move directory_read);
  let given = std::text::args_count(args: &arguments);
  let count = 3_u64;
  if given > 1_u64 {
    set count = 1000000_u64;
  }
  let left = box_array_filled::<u64>(count: count, value: 1_u64);
  let right = box_array_filled::<u64>(count: count, value: 2_u64);
  let left_len = left.inner.len;
  let right_len = right.inner.len;
  let left_words = &left.inner[0_u64..left_len];
  let right_words = &right.inner[0_u64..right_len];
  let total = mix_both(left: left_words, right: right_words);
  let report = box_array_filled::<u8>(count: 8_u64, value: 0_u8);
  let window = &report.inner[0_u64..8_u64];
  let filled = spell(destination: window, at: 0_u64, value: total);
  let no_deadline = None<std::time::Instant>();
  let wait_cancel = std::time::cancel_never();
  let outcome = write_once(factory: &factory, output: &out, source: window, start: 0_u64, end: 8_u64, deadline: no_deadline, cancel: &wait_cancel);
  std::time::close_cancel_watch(watch: move wait_cancel);
  match outcome {
    Ok(value: next) => {
      return exit_status(code: 0_u8);
    }
    Err(error: problem) => {
      return exit_status(code: 1_u8);
    }
  }
}
