const keybytes: Array<u8, 4> =[97_u8, 98_u8, 99_u8, 100_u8];

fn first_payload(i: u64) -> result: u64 pure {
  doc "Builds a set of three keys, each carrying i, and answers the payload of the first key in the set's order.";
  let keys = key_set_new(capacity: 4_u64);
  key_set_put(keys: &keys, key: &keybytes[2_u64..4_u64], payload: i);
  key_set_put(keys: &keys, key: &keybytes[0_u64..2_u64], payload: i);
  key_set_put(keys: &keys, key: &keybytes[1_u64..3_u64], payload: i);
  let payload = 0_u64;
  if keys.len > 0_u64 {
    set payload = key_set_payload(keys: &keys, index: 0_u64);
  }
  return payload;
}

fn main() -> status: std::process::ExitStatus pure {
  let total = 0_u64;
  for @each (i in 0_u64..400000_u64) {
    let got = first_payload(i: i);
    set total = total +wrap got;
  }
  if total == 79999800000_u64 {
    return std::process::exit_status(code: 0_u8);
  }
  return std::process::exit_status(code: 1_u8);
}
