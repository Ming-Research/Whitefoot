const keybytes: Array<u8, 4> =[97_u8, 98_u8, 99_u8, 100_u8];

fn checked_value(i: u64) -> result: u64 pure {
  doc "Builds three keys in first-insertion order, checks their returned indices and a repeated key, and answers i only when the set retains its contents.";
  let keys = key_set_new(capacity: 4_u64);
  let first = key_set_insert(keys: &keys, key: &keybytes[2_u64..4_u64]);
  let second = key_set_insert(keys: &keys, key: &keybytes[0_u64..2_u64]);
  let third = key_set_insert(keys: &keys, key: &keybytes[1_u64..3_u64]);
  let repeated = key_set_insert(keys: &keys, key: &keybytes[2_u64..4_u64]);
  if first != 0_u64 {
    return 0_u64;
  }
  if second != 1_u64 {
    return 0_u64;
  }
  if third != 2_u64 {
    return 0_u64;
  }
  if repeated != 0_u64 {
    return 0_u64;
  }
  if keys.len != 3_u64 {
    return 0_u64;
  }
  return i;
}

fn main() -> status: std::process::ExitStatus pure {
  let total = 0_u64;
  for @each (i in 0_u64..400000_u64) {
    let got = checked_value(i: i);
    set total = total +wrap got;
  }
  if total == 79999800000_u64 {
    return std::process::exit_status(code: 0_u8);
  }
  return std::process::exit_status(code: 1_u8);
}
