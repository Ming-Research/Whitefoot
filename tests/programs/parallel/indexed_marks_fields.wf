struct Row {
  tag: u8;
  count: u64;
  enabled: Bool;
  affine: Bool;
}

fn marks_one() -> result: Bool pure {
  doc "Every private leaf marks all five touched cells; three cells retain the incoming seed.";
  let cells = box_array_filled::<u8>(count: 8_u64, value: 9_u8);
  let wide = box_array_filled::<u64>(count: 8_u64, value: 987654321_u64);
  for (i in 0_u64..262144_u64) {
    let bucket = i % 5_u64;
    set cells.inner[bucket] = 1_u8;
    set wide.inner[bucket] = 123456789_u64;
  }
  for (cell in 0_u64..8_u64) {
    let expected = 9_u8;
    let expected_wide = 987654321_u64;
    if cell < 5_u64 {
      set expected = 1_u8;
      set expected_wide = 123456789_u64;
    }
    if wide.inner[cell] != expected_wide {
      return False();
    }
    if cells.inner[cell] != expected {
      return False();
    }
  }
  return True();
}

fn marks_zero() -> result: Bool pure {
  doc "Every private leaf marks all five touched cells; three cells retain the incoming seed.";
  let cells = box_array_filled::<u8>(count: 8_u64, value: 9_u8);
  for (i in 0_u64..262144_u64) {
    let bucket = i % 5_u64;
    set cells.inner[bucket] = 0_u8;
  }
  for (cell in 0_u64..8_u64) {
    let expected = 9_u8;
    if cell < 5_u64 {
      set expected = 0_u8;
    }
    if cells.inner[cell] != expected {
      return False();
    }
  }
  return True();
}

fn marks_bool() -> result: Bool pure {
  doc "Every private leaf marks all five touched cells; three cells retain the incoming seed.";
  let disabled = False();
  let cells = box_array_filled::<Bool>(count: 8_u64, value: disabled);
  for (i in 0_u64..262144_u64) {
    let bucket = i % 5_u64;
    set cells.inner[bucket] = True();
  }
  for (cell in 0_u64..8_u64) {
    let expected = disabled;
    if cell < 5_u64 {
      set expected = True();
    }
    let wrong = bxor(cells.inner[cell], expected);
    if wrong {
      return False();
    }
  }
  return True();
}

fn field_values() -> result: Bool pure {
  doc "Two families use scalar private strides and distinct byte offsets within each padded record.";
  let disabled = False();
  let seed = Row(tag: 93_u8, count: 7_u64, enabled: disabled, affine: disabled);
  let rows = box_array_filled::<Row>(count: 8_u64, value: seed);
  let enabled = True();
  for (i in 0_u64..262144_u64) {
    let bucket = i % 5_u64;
    let next = 1_u64 +wrap rows.inner[bucket].count;
    set rows.inner[bucket].count = next;
    set rows.inner[bucket].enabled = bor(rows.inner[bucket].enabled, enabled);
  }
  for (cell in 0_u64..8_u64) {
    let expected = 7_u64;
    let expected_flag = False();
    if cell < 4_u64 {
      set expected = 52436_u64;
      set expected_flag = True();
    } else if cell == 4_u64 {
      set expected = 52435_u64;
      set expected_flag = True();
    }
    if rows.inner[cell].count != expected {
      return False();
    }
    let wrong_flag = bxor(rows.inner[cell].enabled, expected_flag);
    if wrong_flag {
      return False();
    }
    if rows.inner[cell].tag != 93_u8 {
      return False();
    }
    if rows.inner[cell].affine {
      return False();
    }
  }
  return True();
}

fn nested_families() -> result: Bool pure {
  doc "An inner split joins marks into the outer mask and field values into the outer dense scalar slab.";
  let disabled = False();
  let seed = Row(tag: 93_u8, count: 7_u64, enabled: disabled, affine: disabled);
  let rows = array_filled::<Row, 4>(value: seed);
  let flags = array_filled::<u8, 4>(value: 9_u8);
  for (outer in 0_u64..4_u64) {
    set rows[outer].affine = True();
    for (inner in 0_u64..65536_u64) {
      set flags[0_u64] = 0_u8;
      set rows[1_u64].count = rows[1_u64].count +wrap 1_u64;
      set rows[1_u64].enabled = True();
    }
  }
  if flags[0_u64] != 0_u8 {
    return False();
  }
  if flags[1_u64] != 9_u8 {
    return False();
  }
  if rows[1_u64].count != 262151_u64 {
    return False();
  }
  if rows[0_u64].count != 7_u64 {
    return False();
  }
  if rows[1_u64].tag != 93_u8 {
    return False();
  }
  let missing_mark = bnot(rows[1_u64].enabled);
  if missing_mark {
    return False();
  }
  if rows[0_u64].enabled {
    return False();
  }
  for (cell in 0_u64..4_u64) {
    let missing_affine = bnot(rows[cell].affine);
    if missing_affine {
      return False();
    }
  }
  return True();
}

fn main() -> status: std::process::ExitStatus pure {
  let one = marks_one();
  let bad_one = bnot(one);
  if bad_one {
    return std::process::exit_status(code: 1_u8);
  }
  let zero = marks_zero();
  let bad_zero = bnot(zero);
  if bad_zero {
    return std::process::exit_status(code: 2_u8);
  }
  let boolean = marks_bool();
  let bad_boolean = bnot(boolean);
  if bad_boolean {
    return std::process::exit_status(code: 3_u8);
  }
  let fields = field_values();
  let bad_fields = bnot(fields);
  if bad_fields {
    return std::process::exit_status(code: 4_u8);
  }
  let nested = nested_families();
  let bad_nested = bnot(nested);
  if bad_nested {
    return std::process::exit_status(code: 5_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
