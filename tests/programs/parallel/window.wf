alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias write_once = std::io::write_once;

enum Node {
  Leaf(w: u64);
  Branch(left: Box<Node>, right: Box<Node>, w: u64);
}

fn leaf(w: u64) -> result: Box<Node> pure {
  let node = Node::Leaf(w: w);
  return box_new::<Node>(value: move node);
}

fn branch(left: Box<Node>, right: Box<Node>) -> result: Box<Node> pure {
  let node = Node::Branch(left: move left, right: move right, w: 0_u64);
  return box_new::<Node>(value: move node);
}

fn pair(a: u64, b: u64) -> result: Box<Node> pure {
  let l = leaf(w: a);
  let r = leaf(w: b);
  return branch(left: move l, right: move r);
}

fn quad(a: u64, b: u64, c: u64, d: u64) -> result: Box<Node> pure {
  let l = pair(a: a, b: b);
  let r = pair(a: c, b: d);
  return branch(left: move l, right: move r);
}

fn oct(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64) -> result: Box<Node> pure {
  let l = quad(a: a, b: b, c: c, d: d);
  let r = quad(a: e, b: f, c: g, d: h);
  return branch(left: move l, right: move r);
}

fn mix(a: u64, b: u64) -> result: u64 pure {
  let spun = irotl(a, 13_u32);
  let scattered = imulhi(b, 2654435761_u64);
  let blended = ixor(spun, b);
  return ixor(blended, scattered);
}

fn fold(node: &Box<Node>) -> result: u64 writes(node) {
  doc "Folds the tree through the cell reference, recording each branch's mix in its own slot.";
  match deref(node).inner {
    Leaf(w: leaf_w) => {
      return deref(leaf_w);
    }
    Branch(left: l, right: r, w: slot) => {
      let seed = irotl(deref(slot), 3_u32);
      let a = fold(node: l);
      let b = fold(node: r);
      let blended = mix(a: a, b: b);
      let mixed = ixor(blended, seed);
      set deref(slot) = mixed;
      return mixed;
    }
  }
}

fn low_byte(v: u64) -> result: u8 pure {
  let low = iand(v, 255_u64);
  let byte = cvt::<u64, u8>(low);
  return byte;
}

fn spell(destination: &[u8], at: u64, value: u64) -> result: u64 writes(destination) {
  doc "Writes the eight little-endian bytes of value at the given offset, skipping any slot the range does not have.";
  let cursor = at;
  let rest = value;
  loop @octets {
    let limit = at +wrap 8_u64;
    let done = cursor >= limit;
    if done {
      break @octets;
    }
    let spare = deref(destination).len;
    let writable = cursor < spare;
    if writable {
      let byte = low_byte(v: rest);
      set deref(destination)[cursor] = byte;
    }
    set rest = irotr(rest, 8_u32);
    set cursor = cursor +wrap 1_u64;
  }
  return at +wrap 8_u64;
}

fn main(inputs: Inputs) -> status: ExitStatus pure {
  let Inputs(args: unused_args, cwd: unused_cwd, stdout: out, stderr: unused_stderr, handles: entry_factory, stdin: unused_stdin) = move inputs;
  close_directory(factory: &entry_factory, directory: move unused_cwd);
  let t0 = oct(a: 1_u64, b: 2_u64, c: 3_u64, d: 4_u64, e: 5_u64, f: 6_u64, g: 7_u64, h: 8_u64);
  let t1 = oct(a: 9_u64, b: 10_u64, c: 11_u64, d: 12_u64, e: 13_u64, f: 14_u64, g: 15_u64, h: 16_u64);
  let t2 = oct(a: 17_u64, b: 18_u64, c: 19_u64, d: 20_u64, e: 21_u64, f: 22_u64, g: 23_u64, h: 24_u64);
  let t3 = oct(a: 25_u64, b: 26_u64, c: 27_u64, d: 28_u64, e: 29_u64, f: 30_u64, g: 31_u64, h: 32_u64);
  let half0 = branch(left: move t0, right: move t1);
  let half1 = branch(left: move t2, right: move t3);
  let root = branch(left: move half0, right: move half1);
  let report = box_array_filled::<u8>(count: 8_u64, value: 0_u8);
  let value = fold(node: &root);
  let window = &report.inner[0_u64..8_u64];
  let filled = spell(destination: window, at: 0_u64, value: value);
  match write_once(factory: &entry_factory, output: &out, source: window, start: 0_u64, end: 8_u64) {
    Ok(value: next) => {
      return exit_status(code: 0_u8);
    }
    Err(error: problem) => {
      return exit_status(code: 1_u8);
    }
  }
}
