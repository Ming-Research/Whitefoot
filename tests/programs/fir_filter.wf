alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct DelayLine {
  samples: Slots<f64, 8>;
  cursor: u64;
}

struct FirFilter {
  taps: Slots<f64, 8>;
  delay: DelayLine;
}

fn main() -> status: ExitStatus pure {
  doc "Two constant-capacity Slots windows are appended to full through place_back and then nested inside two records; the taps are read by subscript and the delay line is written one element at a time by the ordinary assignment set r[k] = x [OP-10, WIN-3].";
  let taps = slots_new::<f64, 8>();
  place_back(window: &taps, value: 0.125_f64);
  place_back(window: &taps, value: 0.125_f64);
  place_back(window: &taps, value: 0.125_f64);
  place_back(window: &taps, value: 0.125_f64);
  place_back(window: &taps, value: 0.125_f64);
  place_back(window: &taps, value: 0.125_f64);
  place_back(window: &taps, value: 0.125_f64);
  place_back(window: &taps, value: 0.125_f64);
  let samples = slots_new::<f64, 8>();
  place_back(window: &samples, value: 0.0_f64);
  place_back(window: &samples, value: 0.0_f64);
  place_back(window: &samples, value: 0.0_f64);
  place_back(window: &samples, value: 0.0_f64);
  place_back(window: &samples, value: 0.0_f64);
  place_back(window: &samples, value: 0.0_f64);
  place_back(window: &samples, value: 0.0_f64);
  place_back(window: &samples, value: 0.0_f64);
  let delay = DelayLine(samples: move samples, cursor: 0_u64);
  let filter = FirFilter(taps: move taps, delay: move delay);
  let tap_count = filter.taps.len;
  let output_sum = 0.0_f64;
  for (frame in 0_u64..64_u64) {
    let first_frame = frame == 0_u64;
    let sample = if first_frame {
      give 8.0_f64;
    } else {
      give 0.0_f64;
    }
    let sample_count = filter.delay.samples.len;
    let write_ok = filter.delay.cursor < sample_count;
    if write_ok {
    } else {
      return exit_status(code: 1_u8);
    }
    set filter.delay.samples[filter.delay.cursor] = sample;
    let read_cursor = filter.delay.cursor;
    let output = 0.0_f64;
    for (tap in 0_u64..tap_count) {
      let coefficient = filter.taps[tap];
      let read_ok = read_cursor < sample_count;
      if read_ok {
      } else {
        return exit_status(code: 1_u8);
      }
      let delayed = filter.delay.samples[read_cursor];
      let contribution = fmul.strict(coefficient, delayed);
      set output = fadd.strict(output, contribution);
      let at_start = read_cursor == 0_u64;
      let previous_cursor = if at_start {
        give 7_u64;
      } else {
        give read_cursor -wrap 1_u64;
      }
      set read_cursor = previous_cursor;
    }
    set output_sum = fadd.strict(output_sum, output);
    let at_end = filter.delay.cursor == 7_u64;
    let next_cursor = if at_end {
      give 0_u64;
    } else {
      give filter.delay.cursor +wrap 1_u64;
    }
    set filter.delay.cursor = next_cursor;
  }
  if feq(output_sum, 8.0_f64) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
