alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const names: Array<u8, 8> =[97_u8, 98_u8, 99_u8, 100_u8, 101_u8, 102_u8, 103_u8, 104_u8];

struct Store {
  map: KeyedTable<u64>;
  total: u64;
  resets: u64;
}

fn prefixes() -> keys: KeySet pure {
  let keys = key_set_new(capacity: 8_u64);
  for @key (at in 1_u64..9_u64) {
    key_set_insert(keys: &keys, key: &names[0_u64..at]);
  }
  return move keys;
}

fn bump_keys(store: Shared<Store>) -> result: unit pure waits {
  doc "Adds one to the entries under the eight prefixes, a thousand times each, and to the total in the same statement.";
  for @round (index in 0_u64..1000_u64) {
    for @key (at in 1_u64..9_u64) {
      let key = &names[0_u64..at];
      atomic s = &store, slot = &s^.map[key] {
        match slot^ {
          Some(value: seen) => {
            let next = seen^ +wrap 1_u64;
            set slot^ = Some<u64>(value: next);
          }
          None() => {
            set slot^ = Some<u64>(value: 1_u64);
          }
        }
        set s^.total = s^.total +wrap 1_u64;
      }
    }
  }
  return unit;
}

fn reset(store: Shared<Store>) -> result: unit pure waits {
  doc "Replaces the table with an empty one and zeroes the total, in one statement, two hundred times.";
  for @again (index in 0_u64..200_u64) {
    let fresh = keyed_table_new::<u64>(capacity: 0_u64);
    atomic s = &store, t = &s^.map {
      set t^ = move fresh;
      set s^.total = 0_u64;
      set s^.resets = s^.resets +wrap 1_u64;
    }
  }
  return unit;
}

fn trade(store: Shared<Store>) -> result: unit pure waits {
  doc "Exchanges the state's table with a table of its own a hundred times, adjusting the total by what each table held, in one statement.";
  let mine = keyed_table_new::<u64>(capacity: 0_u64);
  let held = 0_u64;
  let keys = prefixes();
  for @again (index in 0_u64..100_u64) {
    atomic s = &store, t = &s^.map {
    let all = &t^[keys];
      let sum = 0_u64;
      for @key (at in 0_u64..all^.len) {
        match all^[at] {
          Some(value: seen) => {
            set sum = sum +wrap seen^;
          }
          None() => {
          }
        }
      }
      swap(first: t, second: &mine);
      let lowered = s^.total -wrap sum;
      set s^.total = lowered +wrap held;
      set held = sum;
    }
  }
  free_table(table: move mine);
  return unit;
}

fn free_table(table: KeyedTable<u64>) -> result: unit pure {
  return unit;
}

fn watch_sums(store: Shared<Store>, mismatches: Shared<u64>) -> result: unit pure waits {
  doc "Reads all eight entries and the total in one statement, three hundred times, and counts each time they disagree.";
  let keys = prefixes();
  for @look (index in 0_u64..300_u64) {
    let sum = 0_u64;
    let counted = 0_u64;
    atomic s = &store, all = &s^.map[keys] {
      for @key (at in 0_u64..all^.len) {
        match all^[at] {
          Some(value: seen) => {
            set sum = sum +wrap seen^;
          }
          None() => {
          }
        }
      }
      set counted = s^.total;
    }
    if sum != counted {
      atomic wrong = &mismatches {
        set wrong^ = wrong^ +wrap 1_u64;
      }
    }
  }
  return unit;
}

fn run(store: &Shared<Store>, mismatches: &Shared<u64>) -> result: unit reads(store), reads(mismatches) waits {
  for @start (index in 0_u64..4_u64) {
    let handle = shared_share::<Store>(shared: store);
    spawn bump_keys(store: move handle);
  }
  let resetting = shared_share::<Store>(shared: store);
  spawn reset(store: move resetting);
  let trading = shared_share::<Store>(shared: store);
  spawn trade(store: move trading);
  for @watch (index in 0_u64..2_u64) {
    let handle = shared_share::<Store>(shared: store);
    let seen = shared_share::<u64>(shared: mismatches);
    spawn watch_sums(store: move handle, mismatches: move seen);
  }
  return unit;
}

fn main() -> status: ExitStatus pure waits {
  doc "A table in a shared state is replaced whole and exchanged with another while other contexts lock its entries one key at a time: four contexts add to eight entries and a total, one replaces the table with an empty one and zeroes the total two hundred times, one exchanges it with a table of its own and moves the total by the difference a hundred times, and two compare the entries' sum with the total. A statement that locked the table it read before the replacement or the exchange would add to a table no longer the state's and leave the sum and the total apart. Every order of the statements keeps them equal, so the status is 0 and names the first disagreement otherwise.";
  let table = keyed_table_new::<u64>(capacity: 0_u64);
  let state = Store(map: move table, total: 0_u64, resets: 0_u64);
  let store = shared_new::<Store>(value: move state);
  let mismatches = shared_new::<u64>(value: 0_u64);
  run(store: &store, mismatches: &mismatches);
  let keys = prefixes();
  let sum = 0_u64;
  let total = 1_u64;
  let resets = 0_u64;
  atomic s = &store, all = &s^.map[keys] {
    for @key (at in 0_u64..all^.len) {
      match all^[at] {
        Some(value: seen) => {
          set sum = sum +wrap seen^;
        }
        None() => {
        }
      }
    }
    set total = s^.total;
    set resets = s^.resets;
  }
  if sum != total {
    return exit_status(code: 1_u8);
  }
  if resets != 200_u64 {
    return exit_status(code: 2_u8);
  }
  let missed = 0_u64;
  atomic noted = &mismatches {
    set missed = noted^;
  }
  if missed != 0_u64 {
    return exit_status(code: 3_u8);
  }
  return exit_status(code: 0_u8);
}
