alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const names: Array<u8, 8> =[97_u8, 98_u8, 99_u8, 100_u8, 101_u8, 102_u8, 103_u8, 104_u8];

struct Store {
  map: KeyedTable<u64>;
  total: u64;
}

fn prefixes() -> keys: KeySet pure {
  doc "The eight prefixes of the name in first-insertion order, shortest first.";
  let keys = key_set_new(capacity: 8_u64);
  for @key (at in 1_u64..9_u64) {
    key_set_insert(keys: &keys, key: &names[0_u64..at]);
  }
  return move keys;
}

fn bump_keys(store: Shared<Store>) -> result: unit pure waits {
  for @round (index in 0_u64..2000_u64) {
    for @key (at in 1_u64..9_u64) {
      let key = &names[0_u64..at];
      atomic s = &store, slot = &s^.map[key] {
        match slot^ {
          Some(value: seen) => {
            let next = seen^ +wrap 1_u64;
            set slot^ = Some<u64>(value: next);
          }
          None() => {
            set slot^ = Some<u64>(value: 1_u64);
          }
        }
        set s^.total = s^.total +wrap 1_u64;
      }
    }
  }
  return unit;
}

fn watch_sums(store: Shared<Store>, mismatches: Shared<u64>) -> result: unit pure waits {
  let keys = prefixes();
  for @look (index in 0_u64..300_u64) {
    let sum = 0_u64;
    let counted = 0_u64;
    atomic s = &store, all = &s^.map[keys] {
      for @key (at in 0_u64..all^.len) {
        match all^[at] {
          Some(value: seen) => {
            set sum = sum +wrap seen^;
          }
          None() => {
          }
        }
      }
      set counted = s^.total;
    }
    if sum != counted {
      atomic wrong = &mismatches {
        set wrong^ = wrong^ +wrap 1_u64;
      }
    }
  }
  return unit;
}

fn bump_together(store: &Shared<Store>, mismatches: &Shared<u64>) -> result: unit reads(store), reads(mismatches) waits {
  for @start (index in 0_u64..8_u64) {
    let handle = shared_share::<Store>(shared: store);
    spawn bump_keys(store: move handle);
  }
  for @watch (index in 0_u64..2_u64) {
    let handle = shared_share::<Store>(shared: store);
    let seen = shared_share::<u64>(shared: mismatches);
    spawn watch_sums(store: move handle, mismatches: move seen);
  }
  return unit;
}

fn main() -> status: ExitStatus pure waits {
  doc "One table in a shared state reached from ten contexts at once: eight each add one to the entries under eight keys, the prefixes of one name, two thousand times, and to the state's total in the same statement; two others hold the entries of all eight keys three hundred times each and compare their sum with the total, which agree whenever no other statement is under way. A statement then counts the entries and reads each, another removes one, and a last counts again. Every order of the statements gives the same counts, so the status is 0 on every driver count and names the first wrong one otherwise.";
  let table = keyed_table_new::<u64>(capacity: 0_u64);
  let state = Store(map: move table, total: 0_u64);
  let store = shared_new::<Store>(value: move state);
  let mismatches = shared_new::<u64>(value: 0_u64);
  bump_together(store: &store, mismatches: &mismatches);
  let counted = 0_u64;
  let wrong = 0_u64;
  let keys = prefixes();
  atomic s = &store, all = &s^.map[keys] {
    set counted = keyed_table_count::<u64>(table: &s^.map);
    for @check (at in 0_u64..all^.len) {
      match all^[at] {
        Some(value: seen) => {
          if seen^ != 16000_u64 {
            set wrong = wrong +wrap 1_u64;
          }
        }
        None() => {
          set wrong = wrong +wrap 1_u64;
        }
      }
    }
  }
  if counted != 8_u64 {
    return exit_status(code: 1_u8);
  }
  if wrong != 0_u64 {
    return exit_status(code: 2_u8);
  }
  let first = &names[0_u64..1_u64];
  atomic s = &store, slot = &s^.map[first] {
    set slot^ = None<u64>();
  }
  let left = 0_u64;
  atomic s = &store {
    set left = keyed_table_count::<u64>(table: &s^.map);
  }
  if left != 7_u64 {
    return exit_status(code: 3_u8);
  }
  let sum = 0_u64;
  atomic s = &store {
    set sum = s^.total;
  }
  if sum != 128000_u64 {
    return exit_status(code: 4_u8);
  }
  let missed = 0_u64;
  atomic noted = &mismatches {
    set missed = noted^;
  }
  if missed != 0_u64 {
    return exit_status(code: 5_u8);
  }
  return exit_status(code: 0_u8);
}
