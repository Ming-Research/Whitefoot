const computation_nanoseconds: u64 = 200000000_u64;

struct Record {
  key: u64;
  sequence: u64;
  value: u64;
}

struct Meta {
  next: u64;
  log: Slots<Record, 4>;
}

struct Commits {
  table: ConcurrentHashMap<u64>;
  meta: Meta;
}

fn spin_work(seed: u64, clock: &std::time::Clock, deadline: std::time::Instant) -> result: u64 writes(clock) {
  doc "Pure computation that runs until the monotonic clock reaches the deadline, so its length does not depend on the speed of the host. Each round mixes the state a thousand times and then reads the clock once.";
  let state = seed;
  loop @work {
    for @mix (step in 0_u64..1024_u64) {
      let scaled = state *wrap 6364136223846793005_u64;
      let stepped = scaled +wrap 1442695040888963407_u64;
      let high = ishr.wrap(stepped, 29_u32);
      let folded = ixor(stepped, high);
      set state = folded;
    }
    let at = std::time::now(clock: clock);
    let reached = std::time::instant_reached(deadline: deadline, instant: at);
    if reached {
      break @work;
    }
  }
  return state;
}

fn append_record(meta_state: &Meta, key: u64, sequence: u64, value: u64) -> result: unit writes(meta_state) {
  doc "Appends one log record while the log has room; a record that does not fit is missing from the log, which the entry's count check reports.";
  let record = Record(key: key, sequence: sequence, value: value);
  if meta_state^.log.len < meta_state^.log.cap {
    place_back(window: &meta_state^.log, value: record);
  }
  return unit;
}

fn commit(state: Shared<Commits>, clock: std::time::Clock, letter: u8, index: u64) -> result: unit pure waits {
  doc "One atomic statement on the state: it names its own key of the state's table, computes for the fixed time before it uses any part of the state, and only then stores its entry, takes the next sequence number from the metadata part and appends its log record. The table is the state's first field and the metadata part is reached last, so the statement takes its entry and then the metadata part, and holds the metadata part only for that tail.";
  let bytes = slots_new::<u8, 1>();
  place_back(window: &bytes, value: letter);
  let key = &bytes[0_u64..1_u64];
  let seed = index +wrap 12345_u64;
  atomic s = &state {
    let started = std::time::now(clock: &clock);
    let deadline = std::time::instant_after(instant: started, nanoseconds: computation_nanoseconds);
    let mixed = spin_work(seed: seed, clock: &clock, deadline: deadline);
    let value = ior(mixed, 1_u64);
    set s^.table[key] = Some<u64>(value: value);
    let sequence = s^.meta.next;
    set s^.meta.next = sequence +wrap 1_u64;
    append_record(meta_state: &s^.meta, key: index, sequence: sequence, value: value);
  }
  return unit;
}

fn publish_number(factory: &std::io::HandleFactory, output: &std::io::OutputStream, value: u64) -> result: u8 writes(factory), writes(output) waits {
  doc "Prints value in decimal without leading zeros and a newline. A failed write returns a nonzero code.";
  let text = slots_new::<u8, 21>();
  for @fill (
    at in 0_u64..21_u64,
    invariant grown_text: text.len == at
  ) {
    place_back(window: &text, value: 48_u8);
  }
  let rest = value;
  for @split (at in 0_u64..20_u64) {
    let digit = rest % 10_u64;
    let code = cvt::<u64, u8>(digit);
    let position = 19_u64 - at;
    let character = 48_u8 +wrap code;
    set text[position] = character;
    set rest = rest / 10_u64;
  }
  set text[20_u64] = 10_u8;
  let first = 19_u64;
  for @skip (at in 0_u64..19_u64) {
    let nonzero = text[at] != 48_u8;
    let unset = first == 19_u64;
    let found = band(nonzero, unset);
    if found {
      set first = at;
    }
  }
  let source = &text[0_u64..21_u64];
  let sent = first;
  let unbounded = None<std::time::Instant>();
  let cancel = std::time::cancel_never();
  loop @publish {
    if sent < 21_u64 {
    } else {
      break @publish;
    }
    match std::io::write_once(factory: factory, output: output, source: source, start: sent, end: 21_u64, deadline: unbounded, cancel: &cancel) {
      Ok(value: endpoint) => {
        set sent = endpoint;
      }
      Err(error: failure) => {
        std::time::close_cancel_watch(watch: move cancel);
        return 12_u8;
      }
    }
  }
  std::time::close_cancel_watch(watch: move cancel);
  return 0_u8;
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  doc "Two contexts each run one atomic statement on one shared state, naming their own key of its map, which computes for two hundred milliseconds and then takes a sequence number from the state's metadata part and logs its record. The status is 0 when the log holds two records with sequence numbers 0 and 1 in log order, replaying the log gives the final table, and the whole run took at least one computation. Statuses 1 to 3 name the first failed state check and status 5 a run shorter than one computation, which means the computation did not run. The run's nanoseconds are printed and then the runtime's driver count, and the caller judges the nanoseconds against the control that holds the metadata part through the computation, because how long the run took beyond the computation depends on the host's load, and only when the count is two, because one driver runs the two statements one after the other whatever their locks.";
  let std::process::Inputs(drivers: driver_count, cwd: directory, stdout: output, handles: factory, clock: clock, ..) = move inputs;
  let std::fs::Directory(read: read_directory, write: write_directory) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move write_directory);
  std::fs::close_directory(factory: &factory, directory: move read_directory);
  let table = map_new::<u64>(capacity: 0_u64);
  let log = slots_new::<Record, 4>();
  let meta = Meta(next: 0_u64, log: move log);
  let initial = Commits(table: move table, meta: move meta);
  let state = shared_new::<Commits>(value: move initial);
  let first_state = shared_share::<Commits>(shared: &state);
  let first_clock = std::time::clock_share(clock: &clock);
  let second_state = shared_share::<Commits>(shared: &state);
  let second_clock = std::time::clock_share(clock: &clock);
  let started = std::time::now(clock: &clock);
  let first_run = spawn commit(state: move first_state, clock: move first_clock, letter: 97_u8, index: 0_u64);
  let second_run = spawn commit(state: move second_state, clock: move second_clock, letter: 98_u8, index: 1_u64);
  let first_done = first_run;
  let second_done = second_run;
  let finished = std::time::now(clock: &clock);
  let elapsed = std::time::nanoseconds_from(earlier: started, later: finished);
  let letters = slots_new::<u8, 2>();
  place_back(window: &letters, value: 97_u8);
  place_back(window: &letters, value: 98_u8);
  let key_a = &letters[0_u64..1_u64];
  let key_b = &letters[1_u64..2_u64];
  let table_a = 0_u64;
  let table_b = 0_u64;
  atomic s = &state {
    match s^.table[key_a] {
      Some(value: seen) => {
        set table_a = seen^;
      }
      None() => {
      }
    }
  }
  atomic s = &state {
    match s^.table[key_b] {
      Some(value: seen) => {
        set table_b = seen^;
      }
      None() => {
      }
    }
  }
  let logged = 0_u64;
  let issued = 0_u64;
  let ordered = 0_u64;
  let replay_a = 0_u64;
  let replay_b = 0_u64;
  atomic s = &state {
    set logged = s^.meta.log.len;
    set issued = s^.meta.next;
    for @replay (at in 0_u64..s^.meta.log.len) {
      let position_ok = s^.meta.log[at].sequence == at;
      if position_ok {
        set ordered = ordered +wrap 1_u64;
      }
      let for_a = s^.meta.log[at].key == 0_u64;
      if for_a {
        set replay_a = s^.meta.log[at].value;
      } else {
        set replay_b = s^.meta.log[at].value;
      }
    }
  }
  let verdict = 0_u8;
  let all_logged = logged == 2_u64;
  let all_issued = issued == 2_u64;
  let all_ordered = ordered == 2_u64;
  let issued_and_ordered = band(all_issued, all_ordered);
  let replay_a_matches = replay_a == table_a;
  let replay_b_matches = replay_b == table_b;
  let replays = band(replay_a_matches, replay_b_matches);
  let sustained = elapsed >= computation_nanoseconds;
  if all_logged {
    if issued_and_ordered {
      if replays {
        if sustained {
        } else {
          set verdict = 5_u8;
        }
      } else {
        set verdict = 3_u8;
      }
    } else {
      set verdict = 2_u8;
    }
  } else {
    set verdict = 1_u8;
  }
  let printed = publish_number(factory: &factory, output: &output, value: elapsed);
  if printed != 0_u8 {
    return std::process::exit_status(code: printed);
  }
  let counted = publish_number(factory: &factory, output: &output, value: driver_count);
  if counted != 0_u8 {
    return std::process::exit_status(code: counted);
  }
  return std::process::exit_status(code: verdict);
}
