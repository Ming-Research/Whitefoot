alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const sha256_abc_block: Array<u32, 16> =[1633837952_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 0_u32, 24_u32];

const sha256_round_constants: Array<u32, 64> =[1116352408_u32, 1899447441_u32, 3049323471_u32, 3921009573_u32, 961987163_u32, 1508970993_u32, 2453635748_u32, 2870763221_u32, 3624381080_u32, 310598401_u32, 607225278_u32, 1426881987_u32, 1925078388_u32, 2162078206_u32, 2614888103_u32, 3248222580_u32, 3835390401_u32, 4022224774_u32, 264347078_u32, 604807628_u32, 770255983_u32, 1249150122_u32, 1555081692_u32, 1996064986_u32, 2554220882_u32, 2821834349_u32, 2952996808_u32, 3210313671_u32, 3336571891_u32, 3584528711_u32, 113926993_u32, 338241895_u32, 666307205_u32, 773529912_u32, 1294757372_u32, 1396182291_u32, 1695183700_u32, 1986661051_u32, 2177026350_u32, 2456956037_u32, 2730485921_u32, 2820302411_u32, 3259730800_u32, 3345764771_u32, 3516065817_u32, 3600352804_u32, 4094571909_u32, 275423344_u32, 430227734_u32, 506948616_u32, 659060556_u32, 883997877_u32, 958139571_u32, 1322822218_u32, 1537002063_u32, 1747873779_u32, 1955562222_u32, 2024104815_u32, 2227730452_u32, 2361852424_u32, 2428436474_u32, 2756734187_u32, 3204031479_u32, 3329325298_u32];

fn xor_three(x: u32, y: u32, z: u32) -> result: u32 pure {
  let first = ixor(x, y);
  return ixor(first, z);
}

fn sha256_small_zero(word: u32) -> result: u32 pure {
  let rotate_seven = irotr(word, 7_u32);
  let rotate_eighteen = irotr(word, 18_u32);
  let shift_three = ishr.wrap(word, 3_u32);
  return xor_three(x: rotate_seven, y: rotate_eighteen, z: shift_three);
}

fn sha256_small_one(word: u32) -> result: u32 pure {
  let rotate_seventeen = irotr(word, 17_u32);
  let rotate_nineteen = irotr(word, 19_u32);
  let shift_ten = ishr.wrap(word, 10_u32);
  return xor_three(x: rotate_seventeen, y: rotate_nineteen, z: shift_ten);
}

fn sha256_big_zero(word: u32) -> result: u32 pure {
  let rotate_two = irotr(word, 2_u32);
  let rotate_thirteen = irotr(word, 13_u32);
  let rotate_twenty_two = irotr(word, 22_u32);
  return xor_three(x: rotate_two, y: rotate_thirteen, z: rotate_twenty_two);
}

fn sha256_big_one(word: u32) -> result: u32 pure {
  let rotate_six = irotr(word, 6_u32);
  let rotate_eleven = irotr(word, 11_u32);
  let rotate_twenty_five = irotr(word, 25_u32);
  return xor_three(x: rotate_six, y: rotate_eleven, z: rotate_twenty_five);
}

fn sha256_choose(x: u32, y: u32, z: u32) -> result: u32 pure {
  let selected = iand(x, y);
  let inverted = inot(x);
  let rejected = iand(inverted, z);
  return ixor(selected, rejected);
}

fn sha256_majority(x: u32, y: u32, z: u32) -> result: u32 pure {
  let xy = iand(x, y);
  let xz = iand(x, z);
  let yz = iand(y, z);
  return xor_three(x: xy, y: xz, z: yz);
}

fn sha256_abc_word_zero() -> result: u32 pure {
  let schedule = array_filled::<u32, 64>(value: 0_u32);
  for @copy_block (copy_index in 0_u64..16_u64) {
    let source_word = sha256_abc_block[copy_index];
    set schedule[copy_index] = source_word;
  }
  for @extend_schedule (extend_index in 16_u64..64_u64) {
    let index_minus_two = extend_index -wrap 2_u64;
    let word_minus_two = schedule[index_minus_two];
    let sigma_one = sha256_small_one(word: word_minus_two);
    let index_minus_seven = extend_index -wrap 7_u64;
    let word_minus_seven = schedule[index_minus_seven];
    let index_minus_fifteen = extend_index -wrap 15_u64;
    let word_minus_fifteen = schedule[index_minus_fifteen];
    let sigma_zero = sha256_small_zero(word: word_minus_fifteen);
    let index_minus_sixteen = extend_index -wrap 16_u64;
    let word_minus_sixteen = schedule[index_minus_sixteen];
    let first_sum = word_minus_sixteen +wrap sigma_zero;
    let second_sum = first_sum +wrap word_minus_seven;
    let extended_word = second_sum +wrap sigma_one;
    set schedule[extend_index] = extended_word;
  }
  let a = 1779033703_u32;
  let b = 3144134277_u32;
  let c = 1013904242_u32;
  let d = 2773480762_u32;
  let e = 1359893119_u32;
  let f = 2600822924_u32;
  let g = 528734635_u32;
  let h = 1541459225_u32;
  for @compression_rounds (round in 0_u64..64_u64) {
    let big_one = sha256_big_one(word: e);
    let choose = sha256_choose(x: e, y: f, z: g);
    let constant = sha256_round_constants[round];
    let schedule_word = schedule[round];
    let temp_one_a = h +wrap big_one;
    let temp_one_b = temp_one_a +wrap choose;
    let temp_one_c = temp_one_b +wrap constant;
    let temp_one = temp_one_c +wrap schedule_word;
    let big_zero = sha256_big_zero(word: a);
    let majority = sha256_majority(x: a, y: b, z: c);
    let temp_two = big_zero +wrap majority;
    let next_e = d +wrap temp_one;
    let next_a = temp_one +wrap temp_two;
    set h = g;
    set g = f;
    set f = e;
    set e = next_e;
    set d = c;
    set c = b;
    set b = a;
    set a = next_a;
  }
  return a +wrap 1779033703_u32;
}

fn main() -> status: ExitStatus pure {
  let direct_digest_word = sha256_abc_word_zero();
  if direct_digest_word == 3128432319_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  let iteration = 0_u64;
  let accumulated = 0_u32;
  loop @sustained_hashing {
    let finished = iteration == 1024_u64;
    if finished {
      break @sustained_hashing;
    }
    let digest_word = sha256_abc_word_zero();
    set accumulated = accumulated +wrap digest_word;
    set iteration = iteration +wrap 1_u64;
  }
  if accumulated == 3764059136_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
