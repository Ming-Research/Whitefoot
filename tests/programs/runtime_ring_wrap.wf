alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn read_and_release(cell: Box<u64>) -> value: u64 pure {
  return cell.inner;
}

fn main() -> status: ExitStatus pure {
  doc "Executes a wrapped runtime-capacity Ring of Box owners. Logical reads and take_front must follow the initialized wrapped window; each inner Box is consumed and the empty outer cell is explicitly released.";
  let ring = box_ring_new::<Box<u64>>(capacity: 3_u64);
  let ten = box_new::<u64>(value: 10_u64);
  let twenty = box_new::<u64>(value: 20_u64);
  let thirty = box_new::<u64>(value: 30_u64);
  place_back(window: &ring.inner, value: move ten);
  place_back(window: &ring.inner, value: move twenty);
  place_back(window: &ring.inner, value: move thirty);
  let removed = take_front(window: &ring.inner);
  let removed_value = read_and_release(cell: move removed);
  if removed_value != 10_u64 {
    return exit_status(code: 1_u8);
  }
  let forty = box_new::<u64>(value: 40_u64);
  place_back(window: &ring.inner, value: move forty);
  if ring.inner.head != 1_u64 {
    return exit_status(code: 2_u8);
  }
  if ring.inner.len != 3_u64 {
    return exit_status(code: 3_u8);
  }
  if ring.inner.cap != 3_u64 {
    return exit_status(code: 4_u8);
  }
  let first = ring.inner[0_u64].inner;
  let second = ring.inner[1_u64].inner;
  let third = ring.inner[2_u64].inner;
  if first != 20_u64 {
    return exit_status(code: 5_u8);
  }
  if second != 30_u64 {
    return exit_status(code: 6_u8);
  }
  if third != 40_u64 {
    return exit_status(code: 7_u8);
  }
  let first_owner = take_front(window: &ring.inner);
  let first_value = read_and_release(cell: move first_owner);
  if first_value != 20_u64 {
    return exit_status(code: 8_u8);
  }
  let second_owner = take_front(window: &ring.inner);
  let second_value = read_and_release(cell: move second_owner);
  if second_value != 30_u64 {
    return exit_status(code: 9_u8);
  }
  let third_owner = take_front(window: &ring.inner);
  let third_value = read_and_release(cell: move third_owner);
  if third_value != 40_u64 {
    return exit_status(code: 10_u8);
  }
  if ring.inner.len != 0_u64 {
    return exit_status(code: 11_u8);
  }
  free_empty(window: move ring);
  return exit_status(code: 0_u8);
}
