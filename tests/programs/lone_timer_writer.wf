fn timer_writer(counter: Shared<u64>, started: Shared<Bool>, stop: DecisionCell) -> result: unit pure waits {
  doc "Counts up in an atomic statement on every turn until stop is decided, reaching no other wait.";
  atomic value = &counter {
    set value^ = 1_u64;
  }
  atomic ready = &started {
    set ready^ = True();
  }
  let open = Open();
  loop @write {
    atomic value = &counter {
      set value^ = value^ +sat 1_u64;
    }
    let verdict = decision_cell_read(cell: &stop);
    if verdict != open {
      break @write;
    }
  }
  return unit;
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  doc "Sleeps 1 ms sixteen times beside a context that loops on atomic statements and never otherwise waits, checking each time that the writer has made progress, then reports on standard output that it is about to read and reads one byte of standard input, which the case sends 20 ms after that report. The exit status is the largest lateness in milliseconds of the sleeps past their wake instants and of the read past those 20 ms, 250 for 250 ms or more, and 251 to 253 for an outcome other than the expected one, so the case can tell timers and I/O served beside the writer from ones held behind it [WAIT-2].";
  let std::process::Inputs(cwd: directory, handles: handles, clock: clock, stdout: output, stdin: input, ..) = move inputs;
  let std::fs::Directory(read: readable, write: writable) = move directory;
  std::fs::close_directory_write(factory: &handles, directory: move writable);
  std::fs::close_directory(factory: &handles, directory: move readable);
  let counter = shared_new::<u64>(value: 0_u64);
  let not_started = False();
  let started = shared_new::<Bool>(value: not_started);
  let stop = decision_cell_new();
  let writer_counter = shared_share::<u64>(shared: &counter);
  let writer_started = shared_share::<Bool>(shared: &started);
  let writer_stop = decision_cell_share(cell: &stop);
  spawn timer_writer(counter: move writer_counter, started: move writer_started, stop: move writer_stop);
  atomic ready = &started when ready^ {
  }
  let never = std::time::cancel_never();
  let valid = True();
  let previous = 0_u64;
  let latest = 0_u64;
  for @read (turn in 0_u64..16_u64) {
    let before = std::time::now(clock: &clock);
    let wake = std::time::instant_after(instant: before, nanoseconds: 1000000_u64);
    std::time::sleep_until(deadline: wake, cancel: &never);
    let woke = std::time::now(clock: &clock);
    let late = std::time::nanoseconds_from(earlier: wake, later: woke);
    if late > latest {
      set latest = late;
    }
    let seen = 0_u64;
    atomic value = &counter {
      set seen = value^;
    }
    if seen == 0_u64 {
      set valid = False();
    }
    if seen < previous {
      set valid = False();
    }
    set previous = seen;
  }
  let code = 0_u8;
  let marker = array_filled::<u8, 1>(value: 46_u8);
  let unbounded_write = None<std::time::Instant>();
  let wrote = std::io::write_once(factory: &handles, output: &output, source: &marker[0_u64..1_u64], start: 0_u64, end: 1_u64, deadline: unbounded_write, cancel: &never);
  match wrote {
    Ok(value: written) => {
      if written != 1_u64 {
        set code = 252_u8;
      }
    }
    Err(error: problem) => {
      set code = 252_u8;
    }
  }
  let bytes = slots_new::<u8, 1>();
  place_back(window: &bytes, value: 0_u8);
  let destination = &bytes[0_u64..1_u64];
  let unbounded_read = None<std::time::Instant>();
  let reading = std::time::now(clock: &clock);
  let got = std::io::read_next(factory: &handles, input: &input, destination: destination, start: 0_u64, end: 1_u64, deadline: unbounded_read, cancel: &never);
  let read = std::time::now(clock: &clock);
  std::time::close_cancel_watch(watch: move never);
  match got {
    Ok(value: received) => {
      if received != 1_u64 {
        set code = 253_u8;
      }
    }
    Err(error: problem) => {
      set code = 253_u8;
    }
  }
  atomic ready = &started {
    set ready^ = True();
    let winner = claim_written(cell: &stop);
  }
  if bnot(valid) {
    return std::process::exit_status(code: 251_u8);
  }
  if code != 0_u8 {
    return std::process::exit_status(code: code);
  }
  let waited = std::time::nanoseconds_from(earlier: reading, later: read);
  let read_late = waited -sat 20000000_u64;
  if read_late > latest {
    set latest = read_late;
  }
  let millis = latest / 1000000_u64;
  if millis >= 250_u64 {
    return std::process::exit_status(code: 250_u8);
  }
  let narrowed = cvt.checked::<u64, u8>(millis);
  match narrowed {
    Ok(value: small) => {
      return std::process::exit_status(code: small);
    }
    Err(error: overflowed) => {
      return std::process::exit_status(code: 250_u8);
    }
  }
}
