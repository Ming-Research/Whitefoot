struct AtomicRecord {
  key: u64;
  value: u64;
  number: u64;
  before: u64;
  after: u64;
}

struct AtomicLog {
  records: Slots<AtomicRecord, 256>;
  failed: Bool;
}

struct AtomicGate {
  open: Bool;
  base: std::time::Instant;
}

fn atomic_writer(table: Shared<ConcurrentHashMap<u64>>, sequence: Shared<AtomicValue>, collected: Shared<AtomicLog>, gate: Shared<AtomicGate>, clock: std::time::Clock, index: u64) -> result: unit pure waits {
  doc "Sixty-four commits per writer, with ordinary map-entry writes and one atomic add in the same statement. Clock readings bracket each statement; private records are merged after the loop so the log's lock cannot serialize commits.";
  let base = std::time::now(clock: &clock);
  atomic g = &gate when g^.open {
    set base = g^.base;
  }
  let mine = slots_new::<AtomicRecord, 64>();
  let failed = False();
  for @commit (turn in 0_u64..64_u64) {
    let key = turn % 8_u64;
    let byte = cvt.wrap::<u64, u8>(key);
    let bytes = array_filled::<u8, 1>(value: byte);
    let view = &bytes[0_u64..1_u64];
    let origin = index *wrap 64_u64;
    let stored = origin +wrap turn;
    let number = 0_u64;
    let first = std::time::now(clock: &clock);
    atomic slot = &table[view], s = &sequence {
      match atomic_add(cell: s, value: 1_u64) {
        Some(value: current) => {
          set number = current;
          set slot^ = Some<u64>(value: stored);
        }
        None() => {
          set failed = True();
        }
      }
    }
    let last = std::time::now(clock: &clock);
    let before = std::time::nanoseconds_from(earlier: base, later: first);
    let after = std::time::nanoseconds_from(earlier: base, later: last);
    let record = AtomicRecord(key: key, value: stored, number: number, before: before, after: after);
    if mine.len < mine.cap {
      place_back(window: &mine, value: record);
    }
  }
  atomic log = &collected {
    if failed {
      set log^.failed = True();
    }
    for @merge (at in 0_u64..mine.len) {
      if log^.records.len < log^.records.cap {
        place_back(window: &log^.records, value: mine[at]);
      } else {
        set log^.failed = True();
      }
    }
  }
  return unit;
}

fn atomic_verify(records: &Slots<AtomicRecord, 256>, final: &Array<u64, 8>) -> result: u8 reads(records), reads(final) {
  doc "Independent bounded replay oracle: N1 requires every number below the record count and no duplicates; N2 requires each key's greatest-numbered record to equal the final table; N3 compares every pair's before/after clocks. Bits one, two and four identify those failures.";
  let code = 0_u8;
  let saw_order = False();
  if records^.len == 0_u64 {
    set code = ior(code, 1_u8);
  }
  for @outer (i in 0_u64..records^.len) {
    let current = records^[i];
    if current.number >= records^.len {
      set code = ior(code, 1_u8);
    }
    let latest = True();
    for @inner (j in 0_u64..records^.len) {
      let other = records^[j];
      if i != j {
        if current.number == other.number {
          set code = ior(code, 1_u8);
        }
      }
      if current.after < other.before {
        set saw_order = True();
        if current.number >= other.number {
          set code = ior(code, 4_u8);
        }
      }
      if current.key == other.key {
        if current.number < other.number {
          set latest = False();
        }
      }
    }
    if latest {
      if current.key < 8_u64 {
        if final^[current.key] != current.value {
          set code = ior(code, 2_u8);
        }
      } else {
        set code = ior(code, 2_u8);
      }
    }
  }
  if saw_order {
  } else {
    set code = ior(code, 4_u8);
  }
  return code;
}

fn atomic_oracle_controls() -> result: Bool pure {
  doc "The verifier must detect a missing number, duplicated numbers, a replay inversion on one key and a real-time inversion on separate keys. Separate keys deliberately let N2 pass while N3 fails.";
  let final = array_filled::<u64, 8>(value: 0_u64);
  set final[0_u64] = 20_u64;
  let log = slots_new::<AtomicRecord, 256>();
  let first = AtomicRecord(key: 0_u64, value: 10_u64, number: 0_u64, before: 0_u64, after: 1_u64);
  let second = AtomicRecord(key: 0_u64, value: 20_u64, number: 1_u64, before: 2_u64, after: 3_u64);
  place_back(window: &log, value: first);
  place_back(window: &log, value: second);
  let comparison_1 = atomic_verify(records: &log, final: &final);
  if comparison_1 != 0_u8 {
    return False();
  }
  set log[1_u64].number = 2_u64;
  let missing = atomic_verify(records: &log, final: &final);
  let comparison_2 = iand(missing, 1_u8);
  if comparison_2 != 1_u8 {
    return False();
  }
  set log[1_u64].number = 0_u64;
  let duplicate = atomic_verify(records: &log, final: &final);
  let comparison_3 = iand(duplicate, 1_u8);
  if comparison_3 != 1_u8 {
    return False();
  }
  set log[0_u64].number = 1_u64;
  let wrong_replay = atomic_verify(records: &log, final: &final);
  let comparison_4 = iand(wrong_replay, 2_u8);
  if comparison_4 != 2_u8 {
    return False();
  }
  set log[1_u64].key = 1_u64;
  set final[0_u64] = 10_u64;
  set final[1_u64] = 20_u64;
  let wrong_time = atomic_verify(records: &log, final: &final);
  if wrong_time != 4_u8 {
    return False();
  }
  return True();
}

fn atomic_near_cap(sequence: Shared<AtomicValue>, gate: Shared<AtomicGate>) -> result: u64 pure waits {
  doc "One contender performs a single-target add near saturation. Its result contributes one for the sole admitted value, sixteen for exhaustion, or 128 for any other returned value; no ordinary lock serializes the add with other contenders.";
  atomic g = &gate when g^.open {
  }
  let outcome = 16_u64;
  atomic s = &sequence {
    match atomic_add(cell: s, value: 1_u64) {
      Some(value: old) => {
        if old == 9223372036854775806_u64 {
          set outcome = 1_u64;
        } else {
          set outcome = 128_u64;
        }
      }
      None() => {
      }
    }
  }
  return outcome;
}

fn atomic_saturation(clock: &std::time::Clock) -> result: Bool writes(clock) waits {
  doc "Four contexts race from 2^63-2. Exactly one gets Some(2^63-2), three get None, and the joined state is exactly 2^63; the gate releases all contenders after they were spawned.";
  let sequence = shared_atomic_new(value: 9223372036854775806_u64);
  let now = std::time::now(clock: clock);
  let no = False();
  let closed = AtomicGate(open: no, base: now);
  let gate = shared_new::<AtomicGate>(value: closed);
  let a_seq = shared_share::<AtomicValue>(shared: &sequence);
  let a_gate = shared_share::<AtomicGate>(shared: &gate);
  let b_seq = shared_share::<AtomicValue>(shared: &sequence);
  let b_gate = shared_share::<AtomicGate>(shared: &gate);
  let c_seq = shared_share::<AtomicValue>(shared: &sequence);
  let c_gate = shared_share::<AtomicGate>(shared: &gate);
  let d_seq = shared_share::<AtomicValue>(shared: &sequence);
  let d_gate = shared_share::<AtomicGate>(shared: &gate);
  let a = spawn atomic_near_cap(sequence: move a_seq, gate: move a_gate);
  let b = spawn atomic_near_cap(sequence: move b_seq, gate: move b_gate);
  let c = spawn atomic_near_cap(sequence: move c_seq, gate: move c_gate);
  let d = spawn atomic_near_cap(sequence: move d_seq, gate: move d_gate);
  atomic g = &gate {
    set g^.open = True();
  }
  let aa = a;
  let bb = b;
  let cc = c;
  let dd = d;
  let ab = aa +wrap bb;
  let cd = cc +wrap dd;
  let count = ab +wrap cd;
  if count != 49_u64 {
    return False();
  }
  let final = 0_u64;
  atomic s = &sequence {
    set final = atomic_load(cell: s);
  }
  return final == 9223372036854775808_u64;
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  doc "Four concurrent writers issue exactly 256 dense numbers and update eight contended keys; replay and real-time order are checked after joining. A subsequent commit proves the completed wave precedes the next statement. Oracle controls show that each required property can fail independently.";
  let std::process::Inputs(cwd: directory, handles: factory, clock: clock, ..) = move inputs;
  let std::fs::Directory(read: read_directory, write: write_directory) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move write_directory);
  std::fs::close_directory(factory: &factory, directory: move read_directory);
  if atomic_saturation(clock: &clock) {
  } else {
    return std::process::exit_status(code: 128_u8);
  }
  if atomic_oracle_controls() {
  } else {
    return std::process::exit_status(code: 8_u8);
  }
  let table = shared_map_new::<u64>(capacity: 8_u64);
  let sequence = shared_atomic_new(value: 0_u64);
  let records = slots_new::<AtomicRecord, 256>();
  let no = False();
  let initial = AtomicLog(records: move records, failed: no);
  let collected = shared_new::<AtomicLog>(value: move initial);
  let base = std::time::now(clock: &clock);
  let shut = False();
  let closed = AtomicGate(open: shut, base: base);
  let gate = shared_new::<AtomicGate>(value: closed);
  let first_table = shared_share::<ConcurrentHashMap<u64>>(shared: &table);
  let first_seq = shared_share::<AtomicValue>(shared: &sequence);
  let first_log = shared_share::<AtomicLog>(shared: &collected);
  let first_gate = shared_share::<AtomicGate>(shared: &gate);
  let first_clock = std::time::clock_share(clock: &clock);
  let second_table = shared_share::<ConcurrentHashMap<u64>>(shared: &table);
  let second_seq = shared_share::<AtomicValue>(shared: &sequence);
  let second_log = shared_share::<AtomicLog>(shared: &collected);
  let second_gate = shared_share::<AtomicGate>(shared: &gate);
  let second_clock = std::time::clock_share(clock: &clock);
  let third_table = shared_share::<ConcurrentHashMap<u64>>(shared: &table);
  let third_seq = shared_share::<AtomicValue>(shared: &sequence);
  let third_log = shared_share::<AtomicLog>(shared: &collected);
  let third_gate = shared_share::<AtomicGate>(shared: &gate);
  let third_clock = std::time::clock_share(clock: &clock);
  let fourth_table = shared_share::<ConcurrentHashMap<u64>>(shared: &table);
  let fourth_seq = shared_share::<AtomicValue>(shared: &sequence);
  let fourth_log = shared_share::<AtomicLog>(shared: &collected);
  let fourth_gate = shared_share::<AtomicGate>(shared: &gate);
  let fourth_clock = std::time::clock_share(clock: &clock);
  let first = spawn atomic_writer(table: move first_table, sequence: move first_seq, collected: move first_log, gate: move first_gate, clock: move first_clock, index: 0_u64);
  let second = spawn atomic_writer(table: move second_table, sequence: move second_seq, collected: move second_log, gate: move second_gate, clock: move second_clock, index: 1_u64);
  let third = spawn atomic_writer(table: move third_table, sequence: move third_seq, collected: move third_log, gate: move third_gate, clock: move third_clock, index: 2_u64);
  let fourth = spawn atomic_writer(table: move fourth_table, sequence: move fourth_seq, collected: move fourth_log, gate: move fourth_gate, clock: move fourth_clock, index: 3_u64);
  atomic g = &gate {
    set g^.base = std::time::now(clock: &clock);
    set g^.open = True();
  }
  let first_done = first;
  let second_done = second;
  let third_done = third;
  let fourth_done = fourth;
  let final = array_filled::<u64, 8>(value: 0_u64);
  for @read (key in 0_u64..8_u64) {
    let byte = cvt.wrap::<u64, u8>(key);
    let bytes = array_filled::<u8, 1>(value: byte);
    let view = &bytes[0_u64..1_u64];
    let found = False();
    atomic slot = &table[view] {
      match slot^ {
        Some(value: stored) => {
          set final[key] = stored^;
          set found = True();
        }
        None() => {
        }
      }
    }
    if found {
    } else {
      return std::process::exit_status(code: 16_u8);
    }
  }
  let code = 0_u8;
  atomic log = &collected {
    if log^.failed {
      set code = 32_u8;
    }
    if log^.records.len != 256_u64 {
      set code = 32_u8;
    } else {
      let verdict = atomic_verify(records: &log^.records, final: &final);
      set code = ior(code, verdict);
    }
  }
  atomic s = &sequence {
    match atomic_add(cell: s, value: 1_u64) {
      Some(value: old) => {
        if old != 256_u64 {
          set code = 64_u8;
        }
      }
      None() => {
        set code = 64_u8;
      }
    }
  }
  return std::process::exit_status(code: code);
}
