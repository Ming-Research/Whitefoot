alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias Instant = std::time::Instant;
alias OutputStream = std::io::OutputStream;
alias ProcessExit = std::process::ProcessExit;

fn wait_forever(cell: Shared<u64>) -> result: unit pure waits {
  doc "Waits for a value that no context ever writes.";
  atomic value = &cell when value^ != 0_u64 {
  }
  return unit;
}

fn race(exit: ProcessExit, gate: Shared<u64>, code: u8) -> result: unit pure waits {
  doc "Waits until the gate opens, then ends the program with status code.";
  atomic value = &gate when value^ != 0_u64 {
  }
  let status = std::process::exit_status(code: code);
  std::process::exit_now(exit: &exit, status: move status);
  return unit;
}

fn write_go(factory: &HandleFactory, output: &OutputStream) -> result: unit writes(factory), writes(output) waits {
  doc "Writes the line that precedes the release of the exits.";
  let bytes = array_filled::<u8, 3>(value: 10_u8);
  set bytes[0_u64] = 103_u8;
  set bytes[1_u64] = 111_u8;
  let unlimited = None<Instant>();
  let never = std::time::cancel_never();
  std::io::write_once(factory: factory, output: output, source: &bytes[0_u64..3_u64], start: 0_u64, end: 3_u64, deadline: unlimited, cancel: &never);
  std::time::close_cancel_watch(watch: move never);
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Writes its line, then releases four exits with statuses 11 to 14 at once.";
  let Inputs(cwd: directory, stdout: output, handles: factory, exit: exit, ..) = move inputs;
  let std::fs::Directory(read: readable, write: writable) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move writable);
  std::fs::close_directory(factory: &factory, directory: move readable);
  let never = shared_new::<u64>(value: 0_u64);
  let waiting = shared_share::<u64>(shared: &never);
  spawn wait_forever(cell: move waiting);
  let gate = shared_new::<u64>(value: 0_u64);
  let first_gate = shared_share::<u64>(shared: &gate);
  let first_exit = std::process::exit_share(exit: &exit);
  spawn race(exit: move first_exit, gate: move first_gate, code: 11_u8);
  let second_gate = shared_share::<u64>(shared: &gate);
  let second_exit = std::process::exit_share(exit: &exit);
  spawn race(exit: move second_exit, gate: move second_gate, code: 12_u8);
  let third_gate = shared_share::<u64>(shared: &gate);
  let third_exit = std::process::exit_share(exit: &exit);
  spawn race(exit: move third_exit, gate: move third_gate, code: 13_u8);
  let fourth_gate = shared_share::<u64>(shared: &gate);
  let fourth_exit = std::process::exit_share(exit: &exit);
  spawn race(exit: move fourth_exit, gate: move fourth_gate, code: 14_u8);
  write_go(factory: &factory, output: &output);
  atomic value = &gate {
    set value^ = 1_u64;
  }
  return std::process::exit_status(code: 0_u8);
}
