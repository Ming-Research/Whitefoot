fn error_code(error: InflateError) -> result: u8 pure {
  match error {
    Truncated() => {
      return 1_u8;
    }
    InvalidStoredLength() => {
      return 2_u8;
    }
    InvalidHuffmanTree() => {
      return 3_u8;
    }
    InvalidHuffmanCode() => {
      return 4_u8;
    }
    InvalidDistance() => {
      return 5_u8;
    }
    InvalidBlockType() => {
      return 6_u8;
    }
    OutputFull() => {
      return 7_u8;
    }
  }
}

fn check_valid() -> result: u8 pure {
  doc "Two stored blocks decode to their five bytes.";
  let valid_output = slots_new::<u8, 5>();
  for @fill_valid_output (
    at in 0_u64..5_u64,
    invariant grown: valid_output.len == at
  ) {
    place_back(window: &valid_output, value: 0_u8);
  }
  let valid_view = &valid_input_bytes[0_u64..15_u64];
  let valid_window = &valid_output[0_u64..5_u64];
  let valid_result = inflate(out: valid_window, input: valid_view);
  match valid_result {
    Ok(value: valid_length) => {
      if valid_length == 5_u64 {
      } else {
        return 1_u8;
      }
    }
    Err(error: valid_error) => {
      if False() {
      } else {
        return 1_u8;
      }
    }
  }
  let valid_output_room = valid_output.len;
  if valid_output_room == 5_u64 {
  } else {
    return 1_u8;
  }
  let valid_zero = valid_output[0_u64];
  let valid_one = valid_output[1_u64];
  let valid_two = valid_output[2_u64];
  let valid_three = valid_output[3_u64];
  let valid_four = valid_output[4_u64];
  if valid_zero == 104_u8 {
  } else {
    return 1_u8;
  }
  if valid_one == 101_u8 {
  } else {
    return 1_u8;
  }
  if valid_two == 108_u8 {
  } else {
    return 1_u8;
  }
  if valid_three == 108_u8 {
  } else {
    return 1_u8;
  }
  if valid_four == 111_u8 {
  } else {
    return 1_u8;
  }
  return 0_u8;
}

