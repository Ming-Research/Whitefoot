      if literal_only_length == 1_u64 {
      } else {
        return 1_u8;
      }
    }
    Err(error: literal_only_error) => {
      if False() {
      } else {
        return 1_u8;
      }
    }
  }
  let literal_only_output_room = literal_only_output.len;
  if literal_only_output_room == 1_u64 {
  } else {
    return 1_u8;
  }
  let literal_only_byte = literal_only_output[0_u64];
  if literal_only_byte == 65_u8 {
  } else {
    return 1_u8;
  }
  return 0_u8;
}

fn check_dynamic_match() -> result: u8 pure {
  doc "A dynamic block whose matches repeat the recorded hundred bytes four times.";
  let dynamic_match_output = slots_new::<u8, 400>();
  for @fill_dynamic_match_output (
    at in 0_u64..400_u64,
    invariant grown: dynamic_match_output.len == at
  ) {
    place_back(window: &dynamic_match_output, value: 0_u8);
  }
  let dynamic_match_view = &dynamic_match_input_bytes[0_u64..82_u64];
  let dynamic_match_window = &dynamic_match_output[0_u64..400_u64];
  let dynamic_match_result = inflate(out: dynamic_match_window, input: dynamic_match_view);
  match dynamic_match_result {
    Ok(value: dynamic_match_length) => {
      if dynamic_match_length == 400_u64 {
      } else {
        return 1_u8;
      }
    }
    Err(error: dynamic_match_error) => {
      if False() {
      } else {
        return 1_u8;
      }
    }
  }
  let dynamic_match_output_room = dynamic_match_output.len;
  if dynamic_match_output_room == 400_u64 {
  } else {
    return 1_u8;
  }
  let dynamic_match_repeat = 0_u64;
  loop @check_dynamic_match_repeats {
    let all_repeats_checked = dynamic_match_repeat == 4_u64;
    if all_repeats_checked {
      break @check_dynamic_match_repeats;
    } else {
      let dynamic_match_base = dynamic_match_repeat *wrap 100_u64;
      let dynamic_match_index = 0_u64;
      loop @check_dynamic_match_chunk {
        let chunk_checked = dynamic_match_index == 100_u64;
        if chunk_checked {
          break @check_dynamic_match_chunk;
        } else {
          let output_index = dynamic_match_base +wrap dynamic_match_index;
          let dynamic_match_room = dynamic_match_output.len;
          let dynamic_match_out_ok = output_index < dynamic_match_room;
          if dynamic_match_out_ok {
          } else {
            return 1_u8;
          }
          let dynamic_match_actual = dynamic_match_output[output_index];
          let dynamic_match_exp_ok = dynamic_match_index < 100_u64;
          if dynamic_match_exp_ok {
          } else {
            return 1_u8;
          }
          let dynamic_match_wanted = dynamic_expected_bytes[dynamic_match_index];
          if dynamic_match_actual == dynamic_match_wanted {
          } else {
            return 1_u8;
          }
          set dynamic_match_index = dynamic_match_index +wrap 1_u64;
        }
      }
      set dynamic_match_repeat = dynamic_match_repeat +wrap 1_u64;
    }
  }
  return 0_u8;
}

fn check_mixed_block() -> result: u8 pure {
  doc "A dynamic block followed by a fixed block decodes to both parts.";
  let mixed_block_output = slots_new::<u8, 105>();
  for @fill_mixed_block_output (
    at in 0_u64..105_u64,
    invariant grown: mixed_block_output.len == at
  ) {
    place_back(window: &mixed_block_output, value: 0_u8);
  }
  let mixed_block_view = &mixed_block_input_bytes[0_u64..78_u64];
  let mixed_block_window = &mixed_block_output[0_u64..105_u64];
  let mixed_block_result = inflate(out: mixed_block_window, input: mixed_block_view);
  match mixed_block_result {
    Ok(value: mixed_block_length) => {
      if mixed_block_length == 105_u64 {
      } else {
        return 1_u8;
      }
    }
    Err(error: mixed_block_error) => {
      if False() {
      } else {
        return 1_u8;
      }
    }
  }
  let mixed_block_output_room = mixed_block_output.len;
  if mixed_block_output_room == 105_u64 {
  } else {
    return 1_u8;
  }
  let mixed_block_index = 0_u64;
  loop @check_mixed_block_prefix {
    let mixed_block_prefix_done = mixed_block_index == 100_u64;
    if mixed_block_prefix_done {
      break @check_mixed_block_prefix;
    } else {
      let mixed_room = mixed_block_output.len;
      let mixed_out_ok = mixed_block_index < mixed_room;
      if mixed_out_ok {
      } else {
        return 1_u8;
      }
      let mixed_block_actual = mixed_block_output[mixed_block_index];
      let mixed_exp_ok = mixed_block_index < 100_u64;
      if mixed_exp_ok {
      } else {
        return 1_u8;
      }
      let mixed_block_wanted = dynamic_expected_bytes[mixed_block_index];
      if mixed_block_actual == mixed_block_wanted {
      } else {
        return 1_u8;
      }
      set mixed_block_index = mixed_block_index +wrap 1_u64;
    }
  }
  let mixed_block_h = mixed_block_output[100_u64];
  let mixed_block_e = mixed_block_output[101_u64];
  let mixed_block_l0 = mixed_block_output[102_u64];
  let mixed_block_l1 = mixed_block_output[103_u64];
  let mixed_block_o = mixed_block_output[104_u64];
  if mixed_block_h == 104_u8 {
  } else {
    return 1_u8;
  }
  if mixed_block_e == 101_u8 {
  } else {
    return 1_u8;
  }
  if mixed_block_l0 == 108_u8 {
  } else {
    return 1_u8;
  }
  if mixed_block_l1 == 108_u8 {
  } else {
    return 1_u8;
  }
  if mixed_block_o == 111_u8 {
  } else {
    return 1_u8;
  }
  return 0_u8;
}

