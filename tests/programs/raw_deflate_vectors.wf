fn main() -> status: ExitStatus pure {
  doc "Runs the recorded raw DEFLATE vectors, one case per function: every compressed input is a const table reached through a range reference, and every destination is one inline Slots window of its own frame, written through a range reference and read back afterwards.";
  let valid_status = check_valid();
  if valid_status == 0_u8 {
  } else {
    return exit_status(code: valid_status);
  }
  let invalid_length_status = check_invalid_length();
  if invalid_length_status == 0_u8 {
  } else {
    return exit_status(code: invalid_length_status);
  }
  let truncated_status = check_truncated();
  if truncated_status == 0_u8 {
  } else {
    return exit_status(code: truncated_status);
  }
  let full_status = check_full();
  if full_status == 0_u8 {
  } else {
    return exit_status(code: full_status);
  }
  let fixed_literal_status = check_fixed_literal();
  if fixed_literal_status == 0_u8 {
  } else {
    return exit_status(code: fixed_literal_status);
  }
  let fixed_match_status = check_fixed_match();
  if fixed_match_status == 0_u8 {
  } else {
    return exit_status(code: fixed_match_status);
  }
  let fixed_phrase_status = check_fixed_phrase();
  if fixed_phrase_status == 0_u8 {
  } else {
    return exit_status(code: fixed_phrase_status);
  }
  let dynamic_status = check_dynamic();
  if dynamic_status == 0_u8 {
  } else {
    return exit_status(code: dynamic_status);
  }
  let literal_only_status = check_literal_only();
  if literal_only_status == 0_u8 {
  } else {
    return exit_status(code: literal_only_status);
  }
  let dynamic_match_status = check_dynamic_match();
  if dynamic_match_status == 0_u8 {
  } else {
    return exit_status(code: dynamic_match_status);
  }
  let mixed_block_status = check_mixed_block();
  if mixed_block_status == 0_u8 {
  } else {
    return exit_status(code: mixed_block_status);
  }
  let invalid_tree_status = check_invalid_tree();
  if invalid_tree_status == 0_u8 {
  } else {
    return exit_status(code: invalid_tree_status);
  }
  let dynamic_truncated_status = check_dynamic_truncated();
  if dynamic_truncated_status == 0_u8 {
  } else {
    return exit_status(code: dynamic_truncated_status);
  }
  let dynamic_full_status = check_dynamic_full();
  if dynamic_full_status == 0_u8 {
  } else {
    return exit_status(code: dynamic_full_status);
  }
  let reserved_block_status = check_reserved_block();
  if reserved_block_status == 0_u8 {
  } else {
    return exit_status(code: reserved_block_status);
  }
  let fixed_truncated_status = check_fixed_truncated();
  if fixed_truncated_status == 0_u8 {
  } else {
    return exit_status(code: fixed_truncated_status);
  }
  let invalid_huffman_status = check_invalid_huffman();
  if invalid_huffman_status == 0_u8 {
  } else {
    return exit_status(code: invalid_huffman_status);
  }
  let invalid_distance_status = check_invalid_distance();
  if invalid_distance_status == 0_u8 {
  } else {
    return exit_status(code: invalid_distance_status);
  }
  let fixed_full_status = check_fixed_full();
  if fixed_full_status == 0_u8 {
  } else {
    return exit_status(code: fixed_full_status);
  }
  return exit_status(code: 0_u8);
}
