alias Inputs = std::process::Inputs;
alias ExitStatus = std::process::ExitStatus;

fn conversion_probe() -> passed: Bool pure {
  doc "A captured range excludes an unrelated reply prefix. Independent expected RESP bytes distinguish offset, truncation, RESP2 null and RESP3 null/boolean conversion failures.";
  let engine = halo::embed::new_engine(limit: 1048576_u64);
  let client = firn::protocol::client_new(capacity: 128_u64);
  let v = firn::scripting::command_reply(vm: &engine.vm, bytes: &capture[0_u64..capture.len], start: 8_u64, end: capture.len, resp: 2_u8);
  firn::scripting::lua_to_protocol(vm: &engine.vm, value: v, client: &client, resp: 2_u8);
  let n = client.at;
  if n != converted.len {
    return False();
  }
  for (i in 0_u64..n) {
    if i < client.bytes.inner.len {
      if i < converted.len {
        if client.bytes.inner[i] != converted[i] {
          return False();
        }
      }
    }
  }
  let third = firn::scripting::num(x: 3.0_f64);
  let error = firn::scripting::get(vm: &engine.vm, table: v, key: third);
  let key = firn::scripting::literal(vm: &engine.vm, text: &stats_field[0_u64..25_u64]);
  let marker = firn::scripting::get(vm: &engine.vm, table: error, key: key);
  set client.at = 0_u64;
  firn::scripting::lua_to_protocol(vm: &engine.vm, value: marker, client: &client, resp: 2_u8);
  if client.at != 4_u64 {
    return False();
  }
  if client.bytes.inner.len < 4_u64 {
    return False();
  }
  for (i in 0_u64..4_u64) {
    if client.bytes.inner[i] != true_reply[i] {
      return False();
    }
  }
  let clipped = firn::scripting::command_reply(vm: &engine.vm, bytes: &clipped_capture[0_u64..clipped_capture.len], start: 0_u64, end: 6_u64, resp: 2_u8);
  let nil = firn::scripting::is_nil(v: clipped);
  if bnot(nil) {
    return False();
  }
  return True();
}

fn registry_probe() -> passed: Bool pure waits {
  doc "Duplicate LOAD must not grow source/hash accounting; FLUSH must release the registry and reset it. Fixed expected sizes come from SHA1's 40 bytes and the nine-byte source, not from the registry's output.";
  let empty = firn::bytes::bytes_new(input: &empty_text[0_u64..0_u64], start: 0_u64, length: 0_u64);
  let no = False();
  let store = firn::store::keyspace_new(seed: 1_u64, logging: no, password: move empty, timeout: 0_u64, started: 0_u64);
  let env = firn::bytes::KeyEnv();
  let time = firn::store::Time(unix_ms: 1234_u64, check: 1234_u64, loading: no);
  let client = firn::protocol::client_new(capacity: 4096_u64);
  let spans = box_slots_new::<firn::protocol::Span>(capacity: 16_u64);
  let load = array_filled::<u8, 41>(value: 0_u8);
  for (i in 0_u64..41_u64) {
    set load[i] = load_request[i];
  }
  let flush = array_filled::<u8, 38>(value: 0_u8);
  for (i in 0_u64..38_u64) {
    set flush[i] = flush_request[i];
  }
  let load_length = load.len;
  let flush_length = flush.len;
  for (i in 0_u64..2_u64) {
    let parsed = firn::protocol::parse_request(input: &load[0_u64..load_length], start: 0_u64, held: load_length, args: &spans, locked: no);
    if parsed.state != 1_u64 {
      return False();
    }
    firn::commands::execute(store: &store, input: &load[0_u64..load_length], args: &spans, client: &client, env: &env, time: &time);
    let valid = False();
    atomic p = &store.scripts {
      let count = p^.registry.inner.len == 1_u64;
      let bytes = p^.source_bytes == 49_u64;
      set valid = band(count, bytes);
    }
    if bnot(valid) {
      return False();
    }
  }
  let parsed = firn::protocol::parse_request(input: &flush[0_u64..flush_length], start: 0_u64, held: flush_length, args: &spans, locked: no);
  if parsed.state != 1_u64 {
    return False();
  }
  firn::commands::execute(store: &store, input: &flush[0_u64..flush_length], args: &spans, client: &client, env: &env, time: &time);
  let valid = False();
  atomic p = &store.scripts {
    let count = p^.registry.inner.len == 0_u64;
    let bytes = p^.source_bytes == 0_u64;
    let capacity = p^.registry.inner.cap == 0_u64;
    set valid = band(count, bytes);
    set valid = band(valid, capacity);
  }
  return valid;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Persistent in-process firn request driver: production parser, dispatch, keyspace and scripting, with stdin/stdout replacing TCP. This keeps cache, pool and generation across requests on hosts without loopback access.";
  let Inputs(args: args, cwd: cwd, stdout: output, stderr: stderr, handles: factory, stdin: input, clock: clock, wall_clock: wall_clock) = move inputs;
  let std::fs::Directory(read: read, write: write) = move cwd;
  std::fs::close_directory(factory: &factory, directory: move read);
  std::fs::close_directory_write(factory: &factory, directory: move write);
  let registry = registry_probe();
  if bnot(registry) {
    return std::process::exit_status(code: 8_u8);
  }
  let passed = conversion_probe();
  if bnot(passed) {
    return std::process::exit_status(code: 7_u8);
  }
  let empty = firn::bytes::bytes_new(input: &empty_text[0_u64..0_u64], start: 0_u64, length: 0_u64);
  let no = False();
  let store = firn::store::keyspace_new(seed: 1_u64, logging: no, password: move empty, timeout: 0_u64, started: 0_u64);
  let env = firn::bytes::KeyEnv();
  let time = firn::store::Time(unix_ms: 1234_u64, check: 1234_u64, loading: no);
  let client = firn::protocol::client_new(capacity: 4096_u64);
  let bytes = firn::protocol::input_new(capacity: 4096_u64);
  let spans = box_slots_new::<firn::protocol::Span>(capacity: 16_u64);
  let held = 0_u64;
  loop {
    let cap = bytes.inner.len;
    if held > cap {
      return std::process::exit_status(code: 5_u8);
    }
    let deadline = None<std::time::Instant>();
    let got = std::io::read_next(factory: &factory, input: &input, destination: &bytes.inner[0_u64..cap], start: held, end: cap, deadline: deadline);
    match got {
      Ok(value: end) => {
        set held = end;
      }
      Err(error: stop) => {
        match stop {
          ReadEnd() => {
            break;
          }
          ReadFailed(..) => {
            return std::process::exit_status(code: 2_u8);
          }
        }
      }
    }
    let at = 0_u64;
    loop {
      let n = bytes.inner.len;
      let parsed = firn::protocol::parse_request(input: &bytes.inner[0_u64..n], start: at, held: held, args: &spans, locked: no);
      if parsed.state == 0_u64 {
        break;
      }
      if parsed.state != 1_u64 {
        return std::process::exit_status(code: 3_u8);
      }
      firn::commands::execute(store: &store, input: &bytes.inner[0_u64..n], args: &spans, client: &client, env: &env, time: &time);
      set at = parsed.next;
      let total = client.at;
      let size = client.bytes.inner.len;
      if total > size {
        return std::process::exit_status(code: 6_u8);
      }
      let sent = 0_u64;
      loop {
        if sent >= total {
          break;
        }
        let send_deadline = None<std::time::Instant>();
        match std::io::write_once(factory: &factory, output: &output, source: &client.bytes.inner[0_u64..size], start: sent, end: total, deadline: send_deadline) {
          Ok(value: end) => {
            set sent = end;
          }
          Err(..) => {
            return std::process::exit_status(code: 4_u8);
          }
        }
      }
      set client.at = 0_u64;
      if at >= held {
        break;
      }
    }
    set held = firn::protocol::keep_rest(input: &bytes, from: at, held: held);
    if held == bytes.inner.len {
      firn::protocol::input_grow(input: &bytes);
    }
  }
  return std::process::exit_status(code: 0_u8);
}

const empty_text: Array<u8, 0> = "";

const capture: Array<u8, 42> = "+prior\r\n*5\r\n:7\r\n+OK\r\n-ERR probe\r\n$-1\r\n#f\r\n";

const converted: Array<u8, 35> = "*5\r\n:7\r\n+OK\r\n-ERR probe\r\n$-1\r\n$-1\r\n";

const clipped_capture: Array<u8, 9> = "$3\r\nabc\r\n";

const load_request: Array<u8, 41> = "*3\r\n$6\r\nSCRIPT\r\n$4\r\nLOAD\r\n$9\r\nreturn 42\r\n";

const flush_request: Array<u8, 38> = "*3\r\n$6\r\nSCRIPT\r\n$5\r\nFLUSH\r\n$5\r\nASYNC\r\n";

const stats_field: Array<u8, 25> = "ignore_error_stats_update";

const true_reply: Array<u8, 4> = ":1\r\n";
