alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn controller_output(error: f64, integral: f64, previous_error: f64, step: f64) -> result: f64 pure {
  let proportional = fmul.strict(0.5_f64, error);
  let integral_term = fmul.strict(0.125_f64, integral);
  let error_change = fsub.strict(error, previous_error);
  let derivative = fdiv.strict(error_change, step);
  let derivative_term = fmul.strict(0.03125_f64, derivative);
  let proportional_integral = fadd.strict(proportional, integral_term);
  let raw_output = fadd.strict(proportional_integral, derivative_term);
  let lower_bounded = fmax(raw_output, -2.0_f64);
  return fmin(lower_bounded, 2.0_f64);
}

fn main() -> status: ExitStatus pure {
  let iteration = 0_u64;
  let measured = 0.0_f64;
  let integral = 0.0_f64;
  let previous_error = 0.0_f64;
  loop @control_samples {
    let finished = iteration == 4096_u64;
    if finished {
      break @control_samples;
    }
    let error = fsub.strict(1.0_f64, measured);
    let next_integral = ffma.strict(error, 0.015625_f64, integral);
    let output = controller_output(error: error, integral: next_integral, previous_error: previous_error, step: 0.015625_f64);
    let next_measured = ffma.strict(output, 0.00390625_f64, measured);
    set measured = next_measured;
    set integral = next_integral;
    set previous_error = error;
    set iteration = iteration +wrap 1_u64;
  }
  let above_floor = fgt(measured, 0.5_f64);
  let below_ceiling = flt(measured, 1.5_f64);
  if band(above_floor, below_ceiling) {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
