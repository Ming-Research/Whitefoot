alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

const utf8_input: Array<u8, 15> =[65_u8, 194_u8, 162_u8, 226_u8, 130_u8, 172_u8, 240_u8, 159_u8, 152_u8, 128_u8, 194_u8, 65_u8, 255_u8, 226_u8, 130_u8];

fn parse(out: &[u32], src: &[u8]) -> result: u64 reads(src), writes(out) contract {
  define source_length = deref(src).len;
  define output_length = deref(out).len;
  define enough_output = output_length >= source_length;
  requires enough_output;
} {
  let source_length = deref(src).len;
  let output_length = deref(out).len;
  let count = 0_u64;
  let state = 0_u8;
  let value = 0_u32;
  for (i in 0_u64..source_length) {
    let output_in_range = count < output_length;
    if output_in_range {
    } else {
      return count;
    }
    let byte = deref(src)[i];
    let in_ground = state == 0_u8;
    if in_ground {
      let ascii = byte <= 127_u8;
      if ascii {
        let event = cvt::<u8, u32>(byte);
        set deref(out)[count] = event;
        set count = count +wrap 1_u64;
      } else {
        let two_low = byte >= 194_u8;
        let two_high = byte <= 223_u8;
        let two = band(two_low, two_high);
        if two {
          let payload = byte -wrap 192_u8;
          set value = cvt::<u8, u32>(payload);
          set state = 1_u8;
        } else {
          let e0 = byte == 224_u8;
          if e0 {
            let payload = byte -wrap 224_u8;
            set value = cvt::<u8, u32>(payload);
            set state = 3_u8;
          } else {
            let e_low = byte >= 225_u8;
            let e_high = byte <= 239_u8;
            let e_range = band(e_low, e_high);
            let not_ed = byte != 237_u8;
            let regular_e = band(e_range, not_ed);
            if regular_e {
              let payload = byte -wrap 224_u8;
              set value = cvt::<u8, u32>(payload);
              set state = 2_u8;
            } else {
              let ed = byte == 237_u8;
              if ed {
                let payload = byte -wrap 224_u8;
                set value = cvt::<u8, u32>(payload);
                set state = 4_u8;
              } else {
                let f0 = byte == 240_u8;
                if f0 {
                  let payload = byte -wrap 240_u8;
                  set value = cvt::<u8, u32>(payload);
                  set state = 6_u8;
                } else {
                  let f_low = byte >= 241_u8;
                  let f_high = byte <= 243_u8;
                  let regular_f = band(f_low, f_high);
                  if regular_f {
                    let payload = byte -wrap 240_u8;
                    set value = cvt::<u8, u32>(payload);
                    set state = 5_u8;
                  } else {
                    let f4 = byte == 244_u8;
                    if f4 {
                      let payload = byte -wrap 240_u8;
                      set value = cvt::<u8, u32>(payload);
                      set state = 7_u8;
                    } else {
                      set deref(out)[count] = 1114112_u32;
                      set count = count +wrap 1_u64;
                    }
                  }
                }
              }
            }
          }
        }
      }
    } else {
      let continuation_low = byte >= 128_u8;
      let continuation_high = byte <= 191_u8;
      let continuation = band(continuation_low, continuation_high);
      let state_one = state == 1_u8;
      if state_one {
        if continuation {
          let payload = byte -wrap 128_u8;
          let payload_wide = cvt::<u8, u32>(payload);
          let shifted = value *wrap 64_u32;
          let event = shifted +wrap payload_wide;
          set deref(out)[count] = event;
          set count = count +wrap 1_u64;
          set state = 0_u8;
        } else {
          set deref(out)[count] = 1114112_u32;
          set count = count +wrap 1_u64;
          set state = 0_u8;
        }
      } else {
        let state_two = state == 2_u8;
        if state_two {
          if continuation {
            let payload = byte -wrap 128_u8;
            let payload_wide = cvt::<u8, u32>(payload);
            let shifted = value *wrap 64_u32;
            set value = shifted +wrap payload_wide;
            set state = 1_u8;
          } else {
            set deref(out)[count] = 1114112_u32;
            set count = count +wrap 1_u64;
            set state = 0_u8;
          }
        } else {
          let state_three = state == 3_u8;
          if state_three {
            let lower = byte >= 160_u8;
            let upper = byte <= 191_u8;
            let valid = band(lower, upper);
            if valid {
              let payload = byte -wrap 128_u8;
              let payload_wide = cvt::<u8, u32>(payload);
              let shifted = value *wrap 64_u32;
              set value = shifted +wrap payload_wide;
              set state = 1_u8;
            } else {
              set deref(out)[count] = 1114112_u32;
              set count = count +wrap 1_u64;
              set state = 0_u8;
            }
          } else {
            let state_four = state == 4_u8;
            if state_four {
              let lower = byte >= 128_u8;
              let upper = byte <= 159_u8;
              let valid = band(lower, upper);
              if valid {
                let payload = byte -wrap 128_u8;
                let payload_wide = cvt::<u8, u32>(payload);
                let shifted = value *wrap 64_u32;
                set value = shifted +wrap payload_wide;
                set state = 1_u8;
              } else {
                set deref(out)[count] = 1114112_u32;
                set count = count +wrap 1_u64;
                set state = 0_u8;
              }
            } else {
              let state_five = state == 5_u8;
              if state_five {
                if continuation {
                  let payload = byte -wrap 128_u8;
                  let payload_wide = cvt::<u8, u32>(payload);
                  let shifted = value *wrap 64_u32;
                  set value = shifted +wrap payload_wide;
                  set state = 2_u8;
                } else {
                  set deref(out)[count] = 1114112_u32;
                  set count = count +wrap 1_u64;
                  set state = 0_u8;
                }
              } else {
                let state_six = state == 6_u8;
                if state_six {
                  let lower = byte >= 144_u8;
                  let upper = byte <= 191_u8;
                  let valid = band(lower, upper);
                  if valid {
                    let payload = byte -wrap 128_u8;
                    let payload_wide = cvt::<u8, u32>(payload);
                    let shifted = value *wrap 64_u32;
                    set value = shifted +wrap payload_wide;
                    set state = 2_u8;
                  } else {
                    set deref(out)[count] = 1114112_u32;
                    set count = count +wrap 1_u64;
                    set state = 0_u8;
                  }
                } else {
                  let lower = byte >= 128_u8;
                  let upper = byte <= 143_u8;
                  let valid = band(lower, upper);
                  if valid {
                    let payload = byte -wrap 128_u8;
                    let payload_wide = cvt::<u8, u32>(payload);
                    let shifted = value *wrap 64_u32;
                    set value = shifted +wrap payload_wide;
                    set state = 2_u8;
                  } else {
                    set deref(out)[count] = 1114112_u32;
                    set count = count +wrap 1_u64;
                    set state = 0_u8;
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  return count;
}

fn main() -> status: ExitStatus pure {
  doc "The event run is one inline Slots window of this frame, and the const input table and that window are reached through range references [TYPE-9, REF-4].";
  let output = slots_new::<u32, 15>();
  for @fill_output (
    at in 0_u64..15_u64,
    invariant grown: output.len == at
  ) {
    place_back(window: &output, value: 99_u32);
  }
  let window = &output[0_u64..15_u64];
  let input = &utf8_input[0_u64..15_u64];
  let window_length = deref(window).len;
  let input_length = deref(input).len;
  if window_length >= input_length {
  } else {
    return exit_status(code: 2_u8);
  }
  let produced = parse(out: window, src: input);
  if produced == 6_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  let event_zero = output[0_u64];
  let event_one = output[1_u64];
  let event_two = output[2_u64];
  let event_three = output[3_u64];
  let event_four = output[4_u64];
  let event_five = output[5_u64];
  let event_tail = output[6_u64];
  if event_zero == 65_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  if event_one == 162_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  if event_two == 8364_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  if event_three == 128512_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  if event_four == 1114112_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  if event_five == 1114112_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  if event_tail == 99_u32 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
