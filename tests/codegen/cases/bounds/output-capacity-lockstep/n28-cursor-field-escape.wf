struct Cursor {
  o: u64;
}

fn probe(out: &uniq buffer<u8>, src: buffer<u8>) -> result: u64 writes(out) {
  let n = len_of(src);
  let i = 0_u64;
  let c = Cursor(o: 0_u64);
  loop @groups {
    let rem = n -wrap i;
    if rem < 3_u64 {
      break @groups;
    }
    set out^[c.o] = 0_u8;
    set i = i +wrap 3_u64;
    set c.o = c.o +wrap 4_u64;
  }
  return c.o;
}
