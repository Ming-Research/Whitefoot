fn ident['r](x: &uniq 'r buffer<u8>) -> result: &uniq 'r buffer<u8> pure {
  return &uniq 'r x^;
}

fn probe(out: &uniq buffer<u8>, src: buffer<u8>) -> result: u64 writes(out) {
  let n = len_of(src);
  let i = 0_u64;
  let o = 0_u64;
  let aliased = ident(x: &uniq 'r out^);
  loop @groups {
    let rem = n -wrap i;
    if rem < 3_u64 {
      break @groups;
    }
    set aliased^[o] = 0_u8;
    set i = i +wrap 3_u64;
    set o = o +wrap 4_u64;
  }
  return o;
}
