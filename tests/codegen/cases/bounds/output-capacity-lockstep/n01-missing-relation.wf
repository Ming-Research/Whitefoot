fn probe(out: &uniq buffer<u8>, src: buffer<u8>) -> result: u64 writes(out) {
  let n = len_of(src);
  let i = 0_u64;
  let o = 0_u64;
  loop @groups {
    let rem = n -wrap i;
    if rem < 3_u64 {
      break @groups;
    }
    set out^[o] = 0_u8;
    set i = i +wrap 3_u64;
    set o = o +wrap 4_u64;
  }
  let tail = n -wrap i;
  if tail == 1_u64 {
    set o = o +wrap 4_u64;
  }
  if tail == 2_u64 {
    set o = o +wrap 4_u64;
  }
  return o;
}
