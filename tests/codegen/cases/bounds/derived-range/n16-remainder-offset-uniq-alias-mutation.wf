fn probe(src: buffer<u8>) -> result: u64 pure {
  let n = len_of(src);
  let i = 0_u64;
  let sum = 0_u64;
  loop @triples {
    let rem = n -wrap i;
    if rem < 3_u64 {
      break @triples;
    }
    let i2 = i +wrap 2_u64;
    region {
      let p = &uniq i2;
      set p^ = i +wrap 3_u64;
    }
    let x = src[i2];
    let wide = cvt::<u8, u64>(x);
    set sum = sum +wrap wide;
    set i = i +wrap 3_u64;
  }
  return sum;
}
