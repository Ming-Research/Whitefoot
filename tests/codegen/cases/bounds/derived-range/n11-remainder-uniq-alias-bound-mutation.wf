fn probe(src: buffer<u8>) -> result: u64 pure {
  let n = len_of(src);
  let i = 0_u64;
  let sum = 0_u64;
  region {
    let p = &uniq n;
    set p^ = 3_u64;
  }
  loop @triples {
    let rem = n -wrap i;
    if rem < 3_u64 {
      break @triples;
    }
    let x = src[i];
    let wide = cvt::<u8, u64>(x);
    set sum = sum +wrap wide;
    set i = i +wrap 3_u64;
  }
  return sum;
}
