fn trick(x: i64) -> result: i64 pure {
  loop (
    invariant big: x < 9223372036854775807_i64 * 9223372036854775807_i64 + 9223372036854775807_i64 * 9223372036854775807_i64 + 9223372036854775807_i64 * 4_i64 + 1_i64
  ) {
    let y = 9223372036854775807_i64 - x;
    return y;
  }
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
