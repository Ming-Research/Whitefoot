const msg_1: Array<u8, 14> = "expected value";

const msg_2: Array<u8, 19> = "expected object key";

const msg_3: Array<u8, 14> = "expected colon";

const msg_4: Array<u8, 21> = "expected comma or end";

const msg_5: Array<u8, 14> = "trailing input";

const msg_6: Array<u8, 22> = "maximum depth exceeded";

const msg_7: Array<u8, 19> = "unterminated string";

const msg_8: Array<u8, 27> = "unescaped control character";

const msg_9: Array<u8, 14> = "invalid escape";

const msg_10: Array<u8, 22> = "invalid unicode escape";

const msg_11: Array<u8, 14> = "lone surrogate";

const msg_12: Array<u8, 13> = "invalid UTF-8";

const msg_13: Array<u8, 14> = "invalid number";

const msg_14: Array<u8, 15> = "invalid literal";

const msg_15: Array<u8, 14> = "decoder failed";

const msg_16: Array<u8, 19> = "writer expected key";

const msg_17: Array<u8, 21> = "writer expected value";

const msg_18: Array<u8, 24> = "mismatched container end";

const msg_19: Array<u8, 17> = "writer incomplete";

const msg_20: Array<u8, 25> = "buffer capacity exhausted";

fn error(code: u8, offset: u64) -> result: Error pure {
  let message = slots_new::<u8, 40>();
  if code == 1_u8 {
    for (i in 0_u64..14_u64) {
      let b = msg_1[i];
      if message.len < message.cap { place_back(window: &message, value: b); }
    }
  }
  if code == 2_u8 {
    for (i in 0_u64..19_u64) {
      let b = msg_2[i];
      if message.len < message.cap { place_back(window: &message, value: b); }
    }
  }
  if code == 3_u8 {
    for (i in 0_u64..14_u64) {
      let b = msg_3[i];
      if message.len < message.cap { place_back(window: &message, value: b); }
    }
  }
  if code == 4_u8 {
    for (i in 0_u64..21_u64) {
      let b = msg_4[i];
      if message.len < message.cap { place_back(window: &message, value: b); }
    }
  }
  if code == 5_u8 {
    for (i in 0_u64..14_u64) {
      let b = msg_5[i];
      if message.len < message.cap { place_back(window: &message, value: b); }
    }
  }
  if code == 6_u8 {
    for (i in 0_u64..22_u64) {
      let b = msg_6[i];
      if message.len < message.cap { place_back(window: &message, value: b); }
    }
  }
  if code == 7_u8 {
    for (i in 0_u64..19_u64) {
      let b = msg_7[i];
      if message.len < message.cap { place_back(window: &message, value: b); }
    }
  }
  if code == 8_u8 {
    for (i in 0_u64..27_u64) {
      let b = msg_8[i];
      if message.len < message.cap { place_back(window: &message, value: b); }
    }
  }
  if code == 9_u8 {
    for (i in 0_u64..14_u64) {
      let b = msg_9[i];
      if message.len < message.cap { place_back(window: &message, value: b); }
    }
  }
  if code == 10_u8 {
    for (i in 0_u64..22_u64) {
      let b = msg_10[i];
      if message.len < message.cap { place_back(window: &message, value: b); }
    }
  }
  if code == 11_u8 {
    for (i in 0_u64..14_u64) {
      let b = msg_11[i];
      if message.len < message.cap { place_back(window: &message, value: b); }
    }
  }
  if code == 12_u8 {
    for (i in 0_u64..13_u64) {
      let b = msg_12[i];
      if message.len < message.cap { place_back(window: &message, value: b); }
    }
  }
  if code == 13_u8 {
    for (i in 0_u64..14_u64) {
      let b = msg_13[i];
      if message.len < message.cap { place_back(window: &message, value: b); }
    }
  }
  if code == 14_u8 {
    for (i in 0_u64..15_u64) {
      let b = msg_14[i];
      if message.len < message.cap { place_back(window: &message, value: b); }
    }
  }
  if code == 15_u8 {
    for (i in 0_u64..14_u64) {
      let b = msg_15[i];
      if message.len < message.cap { place_back(window: &message, value: b); }
    }
  }
  if code == 16_u8 {
    for (i in 0_u64..19_u64) {
      let b = msg_16[i];
      if message.len < message.cap { place_back(window: &message, value: b); }
    }
  }
  if code == 17_u8 {
    for (i in 0_u64..21_u64) {
      let b = msg_17[i];
      if message.len < message.cap { place_back(window: &message, value: b); }
    }
  }
  if code == 18_u8 {
    for (i in 0_u64..24_u64) {
      let b = msg_18[i];
      if message.len < message.cap { place_back(window: &message, value: b); }
    }
  }
  if code == 19_u8 {
    for (i in 0_u64..17_u64) {
      let b = msg_19[i];
      if message.len < message.cap { place_back(window: &message, value: b); }
    }
  }
  if code == 20_u8 {
    for (i in 0_u64..25_u64) {
      let b = msg_20[i];
      if message.len < message.cap { place_back(window: &message, value: b); }
    }
  }
  return Error(offset: offset, code: code, message: move message);
}
