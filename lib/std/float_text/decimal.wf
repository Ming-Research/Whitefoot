struct Decimal {
  doc "A positive decimal of at most 800 significant digits, most significant first: the value is 0.d1d2...dn times ten to the point, for the count n of digits held, each at most nine, with no trailing zero once trimmed. Digits past the 800 held are dropped, and truncated notes that one of them was nonzero.";
  digits: Array<u8, 800>;
  count: u64;
  point: i64;
  truncated: Bool;
  invariant count_ceiling(decimal): decimal.count <= 800_u64;
  invariant(decimal): forall below_ten(k in 0_u64..decimal^.digits.len): decimal^.digits[k] <= 9_u8;
}

fn decimal_new() -> result: Decimal pure {
  doc "An empty decimal, which denotes zero.";
  let digits = array_filled::<u8, 800>(value: 0_u8);
  let clean = False();
  return Decimal(digits: digits, count: 0_u64, point: 0_i64, truncated: clean);
}

fn decimal_trim(decimal: &Decimal) -> result: unit writes(decimal) {
  doc "Drops the trailing zero digits, which do not change the value the decimal denotes.";
  let count = decimal^.count;
  loop @trim (
    invariant within: count <= 800_u64
  ) {
    if 0_u64 < count {
    } else {
      break @trim;
    }
    let last = count - 1_u64;
    let digit = decimal^.digits[last];
    if digit == 0_u8 {
      set count = last;
    } else {
      break @trim;
    }
  }
  set decimal^.count = count;
  return unit;
}

fn decimal_assign(decimal: &Decimal, input: &[u8], first: u64, last: u64) -> result: unit reads(input), writes(decimal) contract {
  requires first <= last;
  requires last <= input^.len;
} {
  doc "Replaces the decimal by the digits of the significand text input[first..last), digits with at most one point as scan_significand read them. Leading zeros are not held; the point is the number of integer digits from the first nonzero one, or minus the number of zeros between the point and the first nonzero digit, and is limited to a billion either way, far past any value binary64 holds.";
  set decimal^.count = 0_u64;
  set decimal^.truncated = False();
  let held = 0_u64;
  let index = first;
  let seen_point = False();
  let before = 0_u64;
  let leading = 0_u64;
  loop @text (
    invariant ahead: first <= index,
    invariant inside: index <= last,
    invariant held_ceiling: held <= 800_u64,
    invariant before_seen: before <= index,
    invariant leading_seen: leading <= index,
    invariant forall small(k in 0_u64..decimal^.digits.len): decimal^.digits[k] <= 9_u8
  ) {
    if index < last {
    } else {
      break @text;
    }
    let byte = input^[index];
    let following = index + 1_u64;
    if byte == 46_u8 {
      set seen_point = True();
      set index = following;
      continue @text;
    }
    if 48_u8 <= byte {
      if byte <= 57_u8 {
        let digit = byte - 48_u8;
        let zero_digit = digit == 0_u8;
        let nothing_held = held == 0_u64;
        let skip = band(zero_digit, nothing_held);
        if skip {
          if seen_point {
            set leading = leading + 1_u64;
          }
        } else {
          if seen_point {
          } else {
            set before = before + 1_u64;
          }
          if held < 800_u64 {
            set decimal^.digits[held] = digit;
            set held = held + 1_u64;
          } else if digit != 0_u8 {
            set decimal^.truncated = True();
          }
        }
        set index = following;
        continue @text;
      }
    }
    break @text;
  }
  set decimal^.count = held;
  let capped_before = imin(before, 1000000000_u64);
  let capped_leading = imin(leading, 1000000000_u64);
  if 0_u64 < before {
    let wide = cvt::<u64, i64>(capped_before);
    set decimal^.point = wide;
  } else {
    let wide = cvt::<u64, i64>(capped_leading);
    let negated = 0_i64 - wide;
    set decimal^.point = negated;
  }
  decimal_trim(decimal: decimal);
  return unit;
}

fn decimal_multiply(decimal: &Decimal, shift: u32) -> result: u64 writes(decimal) contract {
  requires shift <= 60_u32;
} {
  doc "The left shift: multiplies the held integer by two to the shift, in place and from the least significant digit, and returns the carry out of the most significant digit. Each step is at most nine times 2^60 plus a carry of at most 2^60. The digits of the carry belong in front of the held ones, which is the front shift this module does not yet have, so a caller holds the value exactly only while the carry is zero.";
  let multiplier = ishl(1_u64, shift);
  let count = decimal^.count;
  let remaining = count;
  let carry = 0_u64;
  loop @digits (
    invariant within: remaining <= count,
    invariant carry_bound: carry <= 1152921504606846976_u64,
    invariant forall small(k in 0_u64..decimal^.digits.len): decimal^.digits[k] <= 9_u8
  ) {
    if 0_u64 < remaining {
    } else {
      break @digits;
    }
    let index = remaining - 1_u64;
    let digit = decimal^.digits[index];
    invariant digit_small: digit <= 9_u8 {
      use small(index);
    }
    let wide = cvt::<u8, u64>(digit);
    let scaled = wide * multiplier;
    let total = scaled + carry;
    let low = total % 10_u64;
    let high = total / 10_u64;
    let narrow = cvt::<u64, u8>(low);
    set decimal^.digits[index] = narrow;
    set carry = high;
    set remaining = index;
  }
  return carry;
}
