fn grow_vector_new<T, const ceiling: u64>() -> made: GrowVector<T, ceiling> pure {
  doc "One empty vector over a zero-capacity backing window. The caller-selected ceiling is the static capacity domain later reserve, append, and insert calls must prove; zero therefore constructs a useful empty value whose growth operations are unavailable. A runtime-capacity window exists only as the content of a cell [TYPE-9], and allocation is total in the source [STOR-8], so the construction has no refusal arm and hands back no Result.";
  let storage = box_slots_new::<T>(capacity: 0_u64);
  return GrowVector<T, ceiling>(storage: move storage);
}

fn grow_vector_reserve<T, const ceiling: u64>(values: &GrowVector<T, ceiling>, total: u64) -> capacity: u64 writes(values.storage) contract {
  requires total <= ceiling;
  ensures capacity == values^.storage.inner.cap;
  ensures capacity >= total;
  ensures values^.storage.inner.cap >= entry(values)^.storage.inner.cap;
  ensures values^.storage.inner.len == entry(values)^.storage.inner.len;
} {
  doc "Raises capacity to at least total within this vector's caller-selected ceiling, preserving the window. The concrete ceiling gives every monomorphized grow site its OP-9 bound, while target qualification still checks the complete selected layout under STOR-6. grow remakes the cell's content whole and may reallocate in place [OP-10], so there is no superseded backing to release here.";
  let current = values^.storage.inner.cap;
  if current >= total {
    return current;
  }
  grow(cell: &values^.storage, capacity: total);
  return total;
}

fn grow_vector_grow_full<T, const ceiling: u64>(values: &GrowVector<T, ceiling>) -> result: unit writes(values.storage) contract {
  requires values^.storage.inner.len < ceiling;
  requires values^.storage.inner.cap <= values^.storage.inner.len;
  ensures values^.storage.inner.cap > values^.storage.inner.len;
  ensures values^.storage.inner.cap >= entry(values)^.storage.inner.cap;
  ensures values^.storage.inner.len == entry(values)^.storage.inner.len;
} {
  let current = values^.storage.inner.cap;
  if current == 0_u64 {
    let opened = grow_vector_reserve::<T, ceiling>(values: values, total: 1_u64);
    return unit;
  }
  if current <= 9223372036854775807_u64 {
    let doubled = current + current;
    if doubled <= ceiling {
      let widened = grow_vector_reserve::<T, ceiling>(values: values, total: doubled);
      return unit;
    }
  }
  let stretched = grow_vector_reserve::<T, ceiling>(values: values, total: ceiling);
  return unit;
}

fn grow_vector_make_room<T, const ceiling: u64>(values: &GrowVector<T, ceiling>) -> result: unit writes(values.storage) contract {
  requires values^.storage.inner.len < ceiling;
  ensures values^.storage.inner.cap > values^.storage.inner.len;
  ensures values^.storage.inner.cap >= entry(values)^.storage.inner.cap;
  ensures values^.storage.inner.len == entry(values)^.storage.inner.len;
} {
  let spare = values^.storage.inner.cap - values^.storage.inner.len;
  if spare > 0_u64 {
    return unit;
  }
  grow_vector_grow_full::<T, ceiling>(values: values);
  return unit;
}

fn grow_vector_append<T, const ceiling: u64>(values: &GrowVector<T, ceiling>, value: T) -> length: u64 writes(values.storage) contract {
  requires values^.storage.inner.len < ceiling;
  ensures length == values^.storage.inner.len;
  ensures values^.storage.inner.len == entry(values)^.storage.inner.len + 1_u64;
  ensures values^.storage.inner.cap >= entry(values)^.storage.inner.cap;
} {
  doc "Appends one value, doubling full nonempty backing while that total stays within the caller-selected ceiling, saturating at the ceiling otherwise, and taking one slot when the backing is empty. The written length bound and the concrete ceiling discharge each allocation-size obligation [OP-9].";
  grow_vector_make_room::<T, ceiling>(values: values);
  place_back(window: &values^.storage.inner, value: move value);
  let reached = values^.storage.inner.len;
  return reached;
}

fn grow_vector_insert<T, const ceiling: u64>(values: &GrowVector<T, ceiling>, index: u64, value: T) -> length: u64 writes(values.storage) contract {
  requires index <= values^.storage.inner.len;
  requires values^.storage.inner.len < ceiling;
  ensures length == values^.storage.inner.len;
  ensures values^.storage.inner.len == entry(values)^.storage.inner.len + 1_u64;
  ensures values^.storage.inner.cap >= entry(values)^.storage.inner.cap;
} {
  doc "Inserts before a proved index and preserves order. The manual exchange-and-shift loop v0.59 wrote for this retired with [OP-10]'s insert_at, which is the one operation that writes the append slot and the filled run together.";
  grow_vector_make_room::<T, ceiling>(values: values);
  insert_at(window: &values^.storage.inner, index: index, value: move value);
  let reached = values^.storage.inner.len;
  return reached;
}

fn grow_vector_remove<T, const ceiling: u64>(values: &GrowVector<T, ceiling>, index: u64) -> removed: T writes(values.storage) contract {
  requires index < values^.storage.inner.len;
  ensures values^.storage.inner.len + 1_u64 == entry(values)^.storage.inner.len;
  ensures values^.storage.inner.cap == entry(values)^.storage.inner.cap;
} {
  doc "Removes a proved index and preserves order. As with insert, the shift loop retired with [OP-10]'s remove_at.";
  let taken = remove_at(window: &values^.storage.inner, index: index);
  return move taken;
}

fn grow_vector_swap_remove<T, const ceiling: u64>(values: &GrowVector<T, ceiling>, index: u64) -> removed: T writes(values.storage) contract {
  requires index < values^.storage.inner.len;
  ensures values^.storage.inner.len + 1_u64 == entry(values)^.storage.inner.len;
  ensures values^.storage.inner.cap == entry(values)^.storage.inner.cap;
} {
  doc "Returns the selected value and fills its position with the last value, without preserving order. OP-11 admits exchanging a slot with itself, so selecting the last element needs no separate branch. The operation moves a constant number of elements.";
  let count = values^.storage.inner.len;
  let last = count - 1_u64;
  swap(first: &values^.storage.inner[index], second: &values^.storage.inner[last]);
  let removed = take_back(window: &values^.storage.inner);
  return move removed;
}

fn grow_vector_truncate<interface VectorDrain<T, E>, const ceiling: u64>(values: &GrowVector<T, ceiling>, retained: u64, env: &E) -> result: unit writes(values.storage), writes(env) contract {
  requires retained <= values^.storage.inner.len;
  ensures values^.storage.inner.len == retained;
  ensures values^.storage.inner.cap == entry(values)^.storage.inner.cap;
} {
  doc "Preserves the prefix and capacity, consuming the removed suffix in original order through the caller's monomorphized behavior. The member cannot access this backing: EFF-5 requires its environment effect to be disjoint from the vector's write. For each first-half suffix position, take the last element into a local, exchange it with that position, and consume the local. The reversed remainder is then taken directly. This touches only removed elements, uses constant local storage, and allocates no scratch backing.";
  let count = values^.storage.inner.len;
  let removed = count - retained;
  let half = removed / 2_u64;
  for @first_half (
    offset in 0_u64..half,
    invariant length_lo: values^.storage.inner.len >= count - offset,
    invariant length_hi: values^.storage.inner.len <= count - offset
  ) {
    let left = retained + offset;
    invariant pair: values^.storage.inner.len >= retained + offset + 2_u64 {
      use length_lo;
      use (2_u64 * half <= removed);
      use 2 times (offset < half);
    }
    let value = take_back(window: &values^.storage.inner);
    swap(first: &values^.storage.inner[left], second: &value);
    VectorDrain::accept(env: env, value: move value);
  }
  loop @truncate (
    invariant prefix: values^.storage.inner.len >= retained
  ) {
    if values^.storage.inner.len <= retained {
      invariant exhausted: values^.storage.inner.len == retained;
      break @truncate;
    }
    let value = take_back(window: &values^.storage.inner);
    VectorDrain::accept(env: env, value: move value);
  }
  return unit;
}

fn grow_vector_drain<interface VectorDrain<T, E>, const ceiling: u64>(values: &GrowVector<T, ceiling>, env: &E) -> result: unit writes(values.storage), writes(env) contract {
  ensures values^.storage.inner.len == 0_u64;
  ensures values^.storage.inner.cap == entry(values)^.storage.inner.cap;
} {
  doc "Consumes every element in original order with linear element movement, preserving the backing for reuse.";
  grow_vector_truncate::<VectorDrain<T, E>, ceiling>(values: values, retained: 0_u64, env: env);
  return unit;
}

fn grow_vector_free_empty<T, const ceiling: u64>(values: GrowVector<T, ceiling>) -> result: unit pure contract {
  requires values.storage.inner.len <= 0_u64;
} {
  doc "Consumes and frees an empty vector, including a vector of must-consume elements. The caller first returns or consumes every element, then the ordinary OP-14 operation releases the backing.";
  free_empty(window: move values.storage);
  return unit;
}
