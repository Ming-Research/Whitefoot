public struct GrowVector<T, const ceiling: u64> {
  public readonly storage: Box<Slots<T>>;
}

public interface VectorDrain<T, E> {
  fn accept(env: &E, value: T) -> result: unit writes(env);
}

public fn grow_vector_new<T, const ceiling: u64>() -> made: GrowVector<T, ceiling> pure doc "One empty vector over a zero-capacity backing window. The caller-selected ceiling is the static capacity domain later reserve, append, and insert calls must prove; zero therefore constructs a useful empty value whose growth operations are unavailable. A runtime-capacity window exists only as the content of a cell [TYPE-9], and allocation is total in the source [STOR-8], so the construction has no refusal arm and hands back no Result.";

public fn grow_vector_reserve<T, const ceiling: u64>(values: &GrowVector<T, ceiling>, total: u64) -> capacity: u64 writes(values.storage) contract {
  requires total <= ceiling;
  ensures capacity == deref(values).storage.inner.cap;
  ensures capacity >= total;
  ensures deref(values).storage.inner.cap >= deref(entry(values)).storage.inner.cap;
  ensures deref(values).storage.inner.len == deref(entry(values)).storage.inner.len;
} doc "Raises capacity to at least total within this vector's caller-selected ceiling, preserving the window. The concrete ceiling gives every monomorphized grow site its OP-9 bound, while target qualification still checks the complete selected layout under STOR-6. grow remakes the cell's content whole and may reallocate in place [OP-10], so there is no superseded backing to release here.";

public fn grow_vector_append<T, const ceiling: u64>(values: &GrowVector<T, ceiling>, value: T) -> length: u64 writes(values.storage) contract {
  requires deref(values).storage.inner.len < ceiling;
  ensures length == deref(values).storage.inner.len;
  ensures deref(values).storage.inner.len == deref(entry(values)).storage.inner.len + 1_u64;
  ensures deref(values).storage.inner.cap >= deref(entry(values)).storage.inner.cap;
} doc "Appends one value, doubling full nonempty backing while that total stays within the caller-selected ceiling, saturating at the ceiling otherwise, and taking one slot when the backing is empty. The written length bound and the concrete ceiling discharge each allocation-size obligation [OP-9].";

public fn grow_vector_insert<T, const ceiling: u64>(values: &GrowVector<T, ceiling>, index: u64, value: T) -> length: u64 writes(values.storage) contract {
  requires index <= deref(values).storage.inner.len;
  requires deref(values).storage.inner.len < ceiling;
  ensures length == deref(values).storage.inner.len;
  ensures deref(values).storage.inner.len == deref(entry(values)).storage.inner.len + 1_u64;
  ensures deref(values).storage.inner.cap >= deref(entry(values)).storage.inner.cap;
} doc "Inserts before a proved index and preserves order. The manual exchange-and-shift loop v0.59 wrote for this retired with [OP-10]'s insert_at, which is the one operation that writes the append slot and the filled run together.";

public fn grow_vector_remove<T, const ceiling: u64>(values: &GrowVector<T, ceiling>, index: u64) -> removed: T writes(values.storage) contract {
  requires index < deref(values).storage.inner.len;
  ensures deref(values).storage.inner.len + 1_u64 == deref(entry(values)).storage.inner.len;
  ensures deref(values).storage.inner.cap == deref(entry(values)).storage.inner.cap;
} doc "Removes a proved index and preserves order. As with insert, the shift loop retired with [OP-10]'s remove_at.";

public fn grow_vector_swap_remove<T, const ceiling: u64>(values: &GrowVector<T, ceiling>, index: u64) -> removed: T writes(values.storage) contract {
  requires index < deref(values).storage.inner.len;
  ensures deref(values).storage.inner.len + 1_u64 == deref(entry(values)).storage.inner.len;
  ensures deref(values).storage.inner.cap == deref(entry(values)).storage.inner.cap;
} doc "Returns the selected value and fills its position with the last value, without preserving order. OP-11 admits exchanging a slot with itself, so selecting the last element needs no separate branch. The operation moves a constant number of elements.";

public fn grow_vector_truncate<interface VectorDrain<T, E>, const ceiling: u64>(values: &GrowVector<T, ceiling>, retained: u64, env: &E) -> result: unit writes(values.storage), writes(env) contract {
  requires retained <= deref(values).storage.inner.len;
  ensures deref(values).storage.inner.len == retained;
  ensures deref(values).storage.inner.cap == deref(entry(values)).storage.inner.cap;
} doc "Preserves the prefix and capacity, consuming the removed suffix in original order through the caller's monomorphized behavior. The member cannot access this backing: EFF-5 requires its environment effect to be disjoint from the vector's write. For each first-half suffix position, take the last element into a local, exchange it with that position, and consume the local. The reversed remainder is then taken directly. This touches only removed elements, uses constant local storage, and allocates no scratch backing.";

public fn grow_vector_drain<interface VectorDrain<T, E>, const ceiling: u64>(values: &GrowVector<T, ceiling>, env: &E) -> result: unit writes(values.storage), writes(env) contract {
  ensures deref(values).storage.inner.len == 0_u64;
  ensures deref(values).storage.inner.cap == deref(entry(values)).storage.inner.cap;
} doc "Consumes every element in original order with linear element movement, preserving the backing for reuse.";

public fn grow_vector_free_empty<T, const ceiling: u64>(values: GrowVector<T, ceiling>) -> result: unit pure contract {
  requires values.storage.inner.len <= 0_u64;
} doc "Consumes and frees an empty vector, including a vector of must-consume elements. The caller first returns or consumes every element, then the ordinary OP-14 operation releases the backing.";
