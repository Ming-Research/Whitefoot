fn deque_new<T, const ceiling: u64>(capacity: u64) -> made: Box<Ring<T>> pure contract {
  requires capacity <= ceiling;
  ensures made.inner.len == 0_u64;
  ensures made.inner.cap == capacity;
  ensures made.inner.head == 0_u64;
} {
  doc "Constructs an empty ring with the requested capacity. The explicit ceiling bounds this concrete allocation instance under OP-9; it is not a hidden invariant on an owning Box<Ring<T>>. Allocation is total under STOR-8, including zero capacity.";
  let storage = box_ring_new::<T>(capacity: capacity);
  return move storage;
}

fn deque_push_back<T>(values: &Box<Ring<T>>, value: T) -> length: u64 writes(values.inner.next), writes(values.inner.len) contract {
  requires deref(values).inner.len < deref(values).inner.cap;
  ensures length == deref(values).inner.len;
  ensures deref(values).inner.len == deref(entry(values)).inner.len + 1_u64;
  ensures deref(values).inner.cap == deref(entry(values)).inner.cap;
  ensures deref(values).inner.head == deref(entry(values)).inner.head;
} {
  doc "Appends into existing capacity. The caller proves room or explicitly rebases to a newly allocated backing; this operation does not allocate. Its row preserves existing filled-slot references across the length increase.";
  place_back(window: &deref(values).inner, value: move value);
  return deref(values).inner.len;
}

fn deque_push_front<T>(values: &Box<Ring<T>>, value: T) -> length: u64 writes(values.inner) contract {
  requires deref(values).inner.len < deref(values).inner.cap;
  ensures length == deref(values).inner.len;
  ensures deref(values).inner.len == deref(entry(values)).inner.len + 1_u64;
  ensures deref(values).inner.cap == deref(entry(values)).inner.cap;
} {
  doc "Prepends into existing capacity, wrapping the physical head. Logical indexing and the Ring operation own the wrap; every reference into this ring is invalidated by the front operation [REF-2, OP-10].";
  place_front(window: &deref(values).inner, value: move value);
  return deref(values).inner.len;
}

fn deque_pop_back<T>(values: &Box<Ring<T>>) -> removed: T writes(values.inner.last), writes(values.inner.len) contract {
  requires deref(values).inner.len > 0_u64;
  ensures deref(values).inner.len + 1_u64 == deref(entry(values)).inner.len;
  ensures deref(values).inner.cap == deref(entry(values)).inner.cap;
  ensures deref(values).inner.head == deref(entry(values)).inner.head;
} {
  let removed = take_back(window: &deref(values).inner);
  return move removed;
}

fn deque_pop_front<T>(values: &Box<Ring<T>>) -> removed: T writes(values.inner) contract {
  requires deref(values).inner.len > 0_u64;
  ensures deref(values).inner.len + 1_u64 == deref(entry(values)).inner.len;
  ensures deref(values).inner.cap == deref(entry(values)).inner.cap;
} {
  let removed = take_front(window: &deref(values).inner);
  return move removed;
}

fn deque_visit_at<interface DequeVisit<T, E>>(values: &Box<Ring<T>>, index: u64, env: &E) -> result: unit reads(values.inner), writes(env) contract {
  requires index < deref(values).inner.len;
} {
  doc "Borrows one logical element for the supplied direct-call visitor. A returned reference is unavailable under REF-3; callers may also form an element reference themselves after proving its logical index bound.";
  DequeVisit::accept(env: env, value: &deref(values).inner[index]);
  return unit;
}

fn deque_visit<interface DequeVisit<T, E>>(values: &Box<Ring<T>>, env: &E) -> result: unit reads(values.inner), writes(env) {
  doc "Visits every element in logical order without moving an owner. This is per-slot visitation, not a two-span interface: REF-4 refuses range references over Ring. EFF-5 keeps the writable environment disjoint from the storage read through this boundary.";
  let count = deref(values).inner.len;
  for (index in 0_u64..count) {
    DequeVisit::accept(env: env, value: &deref(values).inner[index]);
  }
  return unit;
}

fn deque_rebase<T, const ceiling: u64>(values: Box<Ring<T>>, capacity: u64) -> made: Box<Ring<T>> pure contract {
  requires capacity >= values.inner.len;
  requires capacity <= ceiling;
  ensures made.inner.len == values.inner.len;
  ensures made.inner.cap == capacity;
  ensures made.inner.head == 0_u64;
} {
  doc "Consumes the old owner and produces a newly allocated backing with head zero, preserving logical order and exact length. The operation can grow or shrink to any proved sufficient capacity. Each element is taken from the source once and placed into the destination once; the source is proved empty before free_empty consumes its backing, including a nodrop element instance. This is an explicit conversion, not a by-value mutation round trip or an automatically growing endpoint helper. The per-element loop supplies the exact length relation that append's current lower-bound-only contract does not publish.";
  let built = box_ring_new::<T>(capacity: capacity);
  let count = values.inner.len;
  if count == 0_u64 {
    free_empty(window: move values);
    return move built;
  }
  let done = 0_u64;
  loop @transfer (
    invariant counter: done <= count,
    invariant input_lo: values.inner.len >= count - done,
    invariant input_hi: values.inner.len <= count - done,
    invariant output_lo: built.inner.len >= done,
    invariant output_hi: built.inner.len <= done
  ) {
    if values.inner.len <= 0_u64 {
      invariant complete: built.inner.len == count;
      break @transfer;
    }
    let value = take_front(window: &values.inner);
    place_back(window: &built.inner, value: move value);
    set done = done + 1_u64;
  }
  free_empty(window: move values);
  return move built;
}

fn deque_drain<interface DequeDrain<T, E>>(values: &Box<Ring<T>>, env: &E) -> result: unit writes(values.inner), writes(env) contract {
  ensures deref(values).inner.len == 0_u64;
  ensures deref(values).inner.cap == deref(entry(values)).inner.cap;
} {
  doc "Consumes elements in original logical order, retaining capacity for reuse. The supplied direct-call consumer must consume a nodrop element; its writable environment is disjoint from this backing under EFF-5. No scratch allocation or spare-slot initialization occurs.";
  let capacity = deref(values).inner.cap;
  loop @drain (
    invariant capacity_lo: deref(values).inner.cap >= capacity,
    invariant capacity_hi: deref(values).inner.cap <= capacity
  ) {
    if deref(values).inner.len == 0_u64 {
      invariant kept_capacity: deref(values).inner.cap == capacity;
      break @drain;
    }
    let value = take_front(window: &deref(values).inner);
    DequeDrain::accept(env: env, value: move value);
  }
  return unit;
}

fn deque_free_empty<T>(values: Box<Ring<T>>) -> result: unit pure contract {
  requires values.inner.len == 0_u64;
} {
  doc "Consumes and frees a proved empty deque. Its element type needs no drop bound because OP-14 consumes the empty boxed window explicitly.";
  free_empty(window: move values);
  return unit;
}
