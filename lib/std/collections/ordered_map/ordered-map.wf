fn ordered_map_new<K, V, const ceiling: u64>() -> result: OrderedMap<K, V, ceiling> pure {
  let root = slots_new::<Box<OrderedNode<K, V>>, 1>();
  return OrderedMap<K, V, ceiling>(root: move root, length: 0_u64, version: 0_u64);
}

fn ordered_map_len<K, V, const ceiling: u64>(map: &OrderedMap<K, V, ceiling>) -> length: u64 reads(map) contract {
  ensures length == map^.length;
} {
  return map^.length;
}

fn ordered_map_search<interface OrderedKey<K, E>, V>(node: &OrderedNode<K, V>, key: &K, env: &E) -> position: u64 reads(node), reads(key), reads(env) contract {
  ensures position <= node^.entries.len;
} {
  let count = node^.entries.len;
  for (index in 0_u64..count) {
    let order = OrderedKey<K, E>::compare(env: env, left: key, right: &node^.entries[index].pair.key);
    if order <= 0_i32 {
      return index;
    }
  }
  return count;
}

fn ordered_map_replace_node<interface OrderedKey<K, E>, V>(node: &OrderedNode<K, V>, offered: &OrderedPair<K, V>, env: &E) -> found: Bool reads(env), writes(node), writes(offered) {
  let position = ordered_map_search::<OrderedKey<K, E>, V>(node: node, key: &offered^.key, env: env);
  if position < node^.entries.len {
    let order = OrderedKey<K, E>::compare(env: env, left: &offered^.key, right: &node^.entries[position].pair.key);
    if order == 0_i32 {
      swap(first: &node^.entries[position].pair, second: offered);
      return True();
    }
  }
  if position == 0_u64 {
    if node^.leading.len > 0_u64 {
      return ordered_map_replace_node::<OrderedKey<K, E>, V>(node: &node^.leading[0_u64].inner, offered: offered, env: env);
    }
  } else {
    let previous = position - 1_u64;
    if node^.entries[previous].after.len > 0_u64 {
      return ordered_map_replace_node::<OrderedKey<K, E>, V>(node: &node^.entries[previous].after[0_u64].inner, offered: offered, env: env);
    }
  }
  return False();
}

fn ordered_map_insert_item<K, V>(node: &OrderedNode<K, V>, position: u64, item: OrderedEntry<K, V, OrderedNode<K, V>>) -> promoted: Option<OrderedEntry<K, V, OrderedNode<K, V>>> writes(node) contract {
  requires position <= node^.entries.len;
} {
  doc "A full node transfers seven suffix entries and reverses them in linear fanout work. PRE-1 split_off does not publish the exact destination count needed by this insertion; counted take/place carries that count without repeated shifting.";
  if node^.entries.len < 15_u64 {
    insert_at(window: &node^.entries, index: position, value: move item);
    return None<OrderedEntry<K, V, OrderedNode<K, V>>>();
  }
  let upper = slots_new::<OrderedEntry<K, V, OrderedNode<K, V>>, 15>();
  for (
    offset in 0_u64..7_u64,
    invariant left_low: node^.entries.len >= 15_u64 - offset,
    invariant left_high: node^.entries.len <= 15_u64 - offset,
    invariant upper_low: upper.len >= offset,
    invariant upper_high: upper.len <= offset
  ) {
    let moved = take_back(window: &node^.entries);
    place_back(window: &upper, value: move moved);
  }
  for (offset in 0_u64..3_u64) {
    let other = 6_u64 - offset;
    swap(first: &upper[offset], second: &upper[other]);
  }
  let promoted = take_back(window: &node^.entries);
  if position <= 7_u64 {
    insert_at(window: &node^.entries, index: position, value: move item);
  } else {
    let right_position = position - 8_u64;
    insert_at(window: &upper, index: right_position, value: move item);
  }
  let leading = slots_new::<Box<OrderedNode<K, V>>, 1>();
  append(destination: &leading, source: &promoted.after);
  let right_node = OrderedNode<K, V>(leading: move leading, entries: move upper);
  let right = box_new::<OrderedNode<K, V>>(value: move right_node);
  place_back(window: &promoted.after, value: move right);
  return Some<OrderedEntry<K, V, OrderedNode<K, V>>>(value: move promoted);
}

fn ordered_map_insert_link<interface OrderedKey<K, E>, V>(link: &Slots<Box<OrderedNode<K, V>>, 1>, pair: OrderedPair<K, V>, env: &E) -> promoted: Option<OrderedEntry<K, V, OrderedNode<K, V>>> reads(env), writes(link) {
  if link^.len > 0_u64 {
    return ordered_map_insert_node::<OrderedKey<K, E>, V>(node: &link^[0_u64].inner, pair: move pair, env: env);
  }
  let after = slots_new::<Box<OrderedNode<K, V>>, 1>();
  let item = OrderedEntry<K, V, OrderedNode<K, V>>(pair: move pair, after: move after);
  return Some<OrderedEntry<K, V, OrderedNode<K, V>>>(value: move item);
}

fn ordered_map_insert_node<interface OrderedKey<K, E>, V>(node: &OrderedNode<K, V>, pair: OrderedPair<K, V>, env: &E) -> promoted: Option<OrderedEntry<K, V, OrderedNode<K, V>>> reads(env), writes(node) {
  let position = ordered_map_search::<OrderedKey<K, E>, V>(node: node, key: &pair.key, env: env);
  let outcome = if position == 0_u64 {
    let next = ordered_map_insert_link::<OrderedKey<K, E>, V>(link: &node^.leading, pair: move pair, env: env);
    give move next;
  } else {
    let previous = position - 1_u64;
    let next = ordered_map_insert_link::<OrderedKey<K, E>, V>(link: &node^.entries[previous].after, pair: move pair, env: env);
    give move next;
  }
  match move outcome {
    None() => {
      return None<OrderedEntry<K, V, OrderedNode<K, V>>>();
    }
    Some(value: carry) => {
      return ordered_map_insert_item::<K, V>(node: node, position: position, item: move carry);
    }
  }
}

fn ordered_map_put<interface OrderedKey<K, E>, V, const ceiling: u64>(map: &OrderedMap<K, V, ceiling>, key: K, value: V, env: &E) -> result: OrderedPut<K, V> reads(env), writes(map) {
  let pair = OrderedPair<K, V>(key: move key, value: move value);
  if map^.root.len > 0_u64 {
    let replaced = ordered_map_replace_node::<OrderedKey<K, E>, V>(node: &map^.root[0_u64].inner, offered: &pair, env: env);
    if replaced {
      let reason = OrderedReturnReason::OrderedReplaced();
      return OrderedPut<K, V>::OrderedReturned(reason: reason, pair: move pair);
    }
  }
  if map^.length >= ceiling {
    let reason = OrderedReturnReason::OrderedFull();
    return OrderedPut<K, V>::OrderedReturned(reason: reason, pair: move pair);
  }
  let promoted = ordered_map_insert_link::<OrderedKey<K, E>, V>(link: &map^.root, pair: move pair, env: env);
  match move promoted {
    None() => {
    }
    Some(value: carry) => {
      let leading = slots_new::<Box<OrderedNode<K, V>>, 1>();
      append(destination: &leading, source: &map^.root);
      let entries = slots_new::<OrderedEntry<K, V, OrderedNode<K, V>>, 15>();
      place_back(window: &entries, value: move carry);
      let root_node = OrderedNode<K, V>(leading: move leading, entries: move entries);
      let root = box_new::<OrderedNode<K, V>>(value: move root_node);
      place_back(window: &map^.root, value: move root);
    }
  }
  set map^.length = map^.length + 1_u64;
  set map^.version = map^.version +wrap 1_u64;
  return OrderedPut<K, V>::OrderedInserted();
}

fn ordered_map_borrow_right<K, V>(left: &OrderedNode<K, V>, right: &OrderedNode<K, V>, separator: &OrderedPair<K, V>) -> result: unit writes(left), writes(right), writes(separator) contract {
  requires left^.entries.len <= 7_u64;
  requires right^.entries.len >= 8_u64;
} {
  let first = remove_at(window: &right^.entries, index: 0_u64);
  swap(first: &first.pair, second: separator);
  swap(first: &first.after, second: &right^.leading);
  place_back(window: &left^.entries, value: move first);
  return unit;
}

fn ordered_map_borrow_left<K, V>(left: &OrderedNode<K, V>, right: &OrderedNode<K, V>, separator: &OrderedPair<K, V>) -> result: unit writes(left), writes(right), writes(separator) contract {
  requires left^.entries.len >= 8_u64;
  requires right^.entries.len <= 7_u64;
} {
  let last = take_back(window: &left^.entries);
  swap(first: &last.pair, second: separator);
  swap(first: &last.after, second: &right^.leading);
  insert_at(window: &right^.entries, index: 0_u64, value: move last);
  return unit;
}

fn ordered_map_merge<K, V>(left: &OrderedNode<K, V>, right: Box<OrderedNode<K, V>>, separator: OrderedEntry<K, V, OrderedNode<K, V>>) -> result: unit writes(left) contract {
  requires left^.entries.len <= 7_u64;
  requires right.inner.entries.len <= 7_u64;
  requires separator.after.len <= 0_u64;
} {
  append(destination: &separator.after, source: &right.inner.leading);
  place_back(window: &left^.entries, value: move separator);
  append(destination: &left^.entries, source: &right.inner.entries);
  let OrderedNode(leading: empty_leading, entries: empty_entries) = move right.inner;
  free_empty(window: move empty_leading);
  free_empty(window: move empty_entries);
  return unit;
}

fn ordered_map_repair_separator<K, V>(left: &Slots<Box<OrderedNode<K, V>>, 1>, separator: OrderedEntry<K, V, OrderedNode<K, V>>) -> remaining: Option<OrderedEntry<K, V, OrderedNode<K, V>>> writes(left) {
  doc "The separator owns its right link. Extract that Box before observing its entry count, so the merge can consume its empty fields locally. Empty links are ordinary leaf cases; they return the complete separator for reinstallation.";
  if left^.len == 0_u64 {
    return Some<OrderedEntry<K, V, OrderedNode<K, V>>>(value: move separator);
  }
  if separator.after.len == 0_u64 {
    return Some<OrderedEntry<K, V, OrderedNode<K, V>>>(value: move separator);
  }
  let right = take_back(window: &separator.after);
  if left^[0_u64].inner.entries.len < 7_u64 {
    if right.inner.entries.len > 7_u64 {
      ordered_map_borrow_right::<K, V>(left: &left^[0_u64].inner, right: &right.inner, separator: &separator.pair);
    } else {
      ordered_map_merge::<K, V>(left: &left^[0_u64].inner, right: move right, separator: move separator);
      return None<OrderedEntry<K, V, OrderedNode<K, V>>>();
    }
  } else if right.inner.entries.len < 7_u64 {
    if left^[0_u64].inner.entries.len > 7_u64 {
      ordered_map_borrow_left::<K, V>(left: &left^[0_u64].inner, right: &right.inner, separator: &separator.pair);
    } else {
      ordered_map_merge::<K, V>(left: &left^[0_u64].inner, right: move right, separator: move separator);
      return None<OrderedEntry<K, V, OrderedNode<K, V>>>();
    }
  }
  place_back(window: &separator.after, value: move right);
  return Some<OrderedEntry<K, V, OrderedNode<K, V>>>(value: move separator);
}

fn ordered_map_repair_at<K, V>(node: &OrderedNode<K, V>, position: u64) -> result: unit writes(node) contract {
  requires position < node^.entries.len;
} {
  let separator = remove_at(window: &node^.entries, index: position);
  let outcome = if position == 0_u64 {
    let repaired = ordered_map_repair_separator::<K, V>(left: &node^.leading, separator: move separator);
    give move repaired;
  } else {
    let previous = position - 1_u64;
    let repaired = ordered_map_repair_separator::<K, V>(left: &node^.entries[previous].after, separator: move separator);
    give move repaired;
  }
  match move outcome {
    None() => {
    }
    Some(value: remaining) => {
      insert_at(window: &node^.entries, index: position, value: move remaining);
    }
  }
  return unit;
}

fn ordered_map_repair_child<K, V>(node: &OrderedNode<K, V>, position: u64) -> result: unit writes(node) contract {
  requires position <= node^.entries.len;
} {
  if node^.entries.len == 0_u64 {
    return unit;
  }
  if position == 0_u64 {
    if node^.leading.len > 0_u64 {
      if node^.leading[0_u64].inner.entries.len < 7_u64 {
        ordered_map_repair_at::<K, V>(node: node, position: 0_u64);
      }
    }
  } else {
    let previous = position - 1_u64;
    if node^.entries[previous].after.len > 0_u64 {
      if node^.entries[previous].after[0_u64].inner.entries.len < 7_u64 {
        ordered_map_repair_at::<K, V>(node: node, position: previous);
      }
    }
  }
  return unit;
}

fn ordered_map_contract_root<K, V>(root: &Slots<Box<OrderedNode<K, V>>, 1>) -> result: unit writes(root) {
  doc "Window extraction does not carry descendant measures. Inspect the detached root, then transfer its zero-or-one leading link before consuming the empty node.";
  if root^.len > 0_u64 {
    let old_root = take_back(window: root);
    if old_root.inner.entries.len == 0_u64 {
      let OrderedNode(leading: next_root, entries: empty_entries) = move old_root.inner;
      free_empty(window: move empty_entries);
      append(destination: root, source: &next_root);
      free_empty(window: move next_root);
    } else {
      place_back(window: root, value: move old_root);
    }
  }
  return unit;
}

fn ordered_map_take_min<K, V>(node: &OrderedNode<K, V>) -> pair: OrderedPair<K, V> writes(node) contract {
  requires node^.entries.len > 0_u64;
} {
  doc "A recursive descent follows one owned child. Contracting a zero-entry child removes one Box before retrying this node, independently of key comparisons.";
  if node^.leading.len == 0_u64 {
    let first = remove_at(window: &node^.entries, index: 0_u64);
    let OrderedEntry(pair: pair, after: after) = move first;
    append(destination: &node^.leading, source: &after);
    free_empty(window: move after);
    return move pair;
  }
  if node^.leading[0_u64].inner.entries.len > 0_u64 {
    let pair = ordered_map_take_min::<K, V>(node: &node^.leading[0_u64].inner);
    ordered_map_repair_child::<K, V>(node: node, position: 0_u64);
    return move pair;
  }
  ordered_map_contract_root::<K, V>(root: &node^.leading);
  return ordered_map_take_min::<K, V>(node: node);
}

fn ordered_map_finish_remove<K, V>(node: &OrderedNode<K, V>, position: u64, item: OrderedEntry<K, V, OrderedNode<K, V>>) -> pair: OrderedPair<K, V> writes(node) contract {
  requires position <= node^.entries.len;
  requires node^.entries.len <= 14_u64;
} {
  if item.after.len == 0_u64 {
    let OrderedEntry(pair: pair, after: empty_after) = move item;
    free_empty(window: move empty_after);
    return move pair;
  }
  if item.after[0_u64].inner.entries.len > 0_u64 {
    let removed = ordered_map_take_min::<K, V>(node: &item.after[0_u64].inner);
    swap(first: &removed, second: &item.pair);
    insert_at(window: &node^.entries, index: position, value: move item);
    let child_position = position + 1_u64;
    ordered_map_repair_child::<K, V>(node: node, position: child_position);
    return move removed;
  }
  ordered_map_contract_root::<K, V>(root: &item.after);
  return ordered_map_finish_remove::<K, V>(node: node, position: position, item: move item);
}

fn ordered_map_remove_item<K, V>(node: &OrderedNode<K, V>, position: u64) -> pair: OrderedPair<K, V> writes(node) contract {
  requires position < node^.entries.len;
} {
  let item = remove_at(window: &node^.entries, index: position);
  return ordered_map_finish_remove::<K, V>(node: node, position: position, item: move item);
}

fn ordered_map_remove_node<interface OrderedKey<K, E>, V>(node: &OrderedNode<K, V>, key: &K, env: &E) -> result: Option<OrderedPair<K, V>> reads(key), reads(env), writes(node) {
  let position = ordered_map_search::<OrderedKey<K, E>, V>(node: node, key: key, env: env);
  if position < node^.entries.len {
    let order = OrderedKey<K, E>::compare(env: env, left: key, right: &node^.entries[position].pair.key);
    if order == 0_i32 {
      let pair = ordered_map_remove_item::<K, V>(node: node, position: position);
      return Some<OrderedPair<K, V>>(value: move pair);
    }
  }
  let outcome = if position == 0_u64 {
    let removed = ordered_map_remove_link::<OrderedKey<K, E>, V>(link: &node^.leading, key: key, env: env);
    give move removed;
  } else {
    let previous = position - 1_u64;
    let removed = ordered_map_remove_link::<OrderedKey<K, E>, V>(link: &node^.entries[previous].after, key: key, env: env);
    give move removed;
  }
  match move outcome {
    None() => {
      return None<OrderedPair<K, V>>();
    }
    Some(value: removed_pair) => {
      ordered_map_repair_child::<K, V>(node: node, position: position);
      return Some<OrderedPair<K, V>>(value: move removed_pair);
    }
  }
}

fn ordered_map_remove_link<interface OrderedKey<K, E>, V>(link: &Slots<Box<OrderedNode<K, V>>, 1>, key: &K, env: &E) -> result: Option<OrderedPair<K, V>> reads(key), reads(env), writes(link) {
  if link^.len > 0_u64 {
    return ordered_map_remove_node::<OrderedKey<K, E>, V>(node: &link^[0_u64].inner, key: key, env: env);
  }
  return None<OrderedPair<K, V>>();
}

fn ordered_map_remove<interface OrderedKey<K, E>, V, const ceiling: u64>(map: &OrderedMap<K, V, ceiling>, key: &K, env: &E) -> result: Option<OrderedPair<K, V>> reads(key), reads(env), writes(map) {
  let outcome = ordered_map_remove_link::<OrderedKey<K, E>, V>(link: &map^.root, key: key, env: env);
  match move outcome {
    None() => {
      return None<OrderedPair<K, V>>();
    }
    Some(value: removed_pair) => {
      ordered_map_contract_root::<K, V>(root: &map^.root);
      if map^.length > 0_u64 {
        set map^.length = map^.length - 1_u64;
      }
      set map^.version = map^.version +wrap 1_u64;
      return Some<OrderedPair<K, V>>(value: move removed_pair);
    }
  }
}

fn ordered_map_lookup_node<interface OrderedKey<K, E>, V, F, R, fn observe(env: &F, key: &K, value: &V) -> result: R reads(key), reads(value), writes(env)>(node: &OrderedNode<K, V>, key: &K, key_env: &E, visit_env: &F) -> result: Result<R, unit> reads(node), reads(key), reads(key_env), writes(visit_env) {
  let position = ordered_map_search::<OrderedKey<K, E>, V>(node: node, key: key, env: key_env);
  if position < node^.entries.len {
    let order = OrderedKey<K, E>::compare(env: key_env, left: key, right: &node^.entries[position].pair.key);
    if order == 0_i32 {
      let observed = observe(env: visit_env, key: &node^.entries[position].pair.key, value: &node^.entries[position].pair.value);
      return Ok<R, unit>(value: move observed);
    }
  }
  if position == 0_u64 {
    return ordered_map_lookup_link::<OrderedKey<K, E>, V, F, R, fn observe>(link: &node^.leading, key: key, key_env: key_env, visit_env: visit_env);
  }
  let previous = position - 1_u64;
  return ordered_map_lookup_link::<OrderedKey<K, E>, V, F, R, fn observe>(link: &node^.entries[previous].after, key: key, key_env: key_env, visit_env: visit_env);
}

fn ordered_map_lookup_link<interface OrderedKey<K, E>, V, F, R, fn observe(env: &F, key: &K, value: &V) -> result: R reads(key), reads(value), writes(env)>(link: &Slots<Box<OrderedNode<K, V>>, 1>, key: &K, key_env: &E, visit_env: &F) -> result: Result<R, unit> reads(link), reads(key), reads(key_env), writes(visit_env) {
  if link^.len > 0_u64 {
    return ordered_map_lookup_node::<OrderedKey<K, E>, V, F, R, fn observe>(node: &link^[0_u64].inner, key: key, key_env: key_env, visit_env: visit_env);
  }
  return Err<R, unit>(error: unit);
}

fn ordered_map_lookup<interface OrderedKey<K, E>, V, F, R, fn observe(env: &F, key: &K, value: &V) -> result: R reads(key), reads(value), writes(env), const ceiling: u64>(map: &OrderedMap<K, V, ceiling>, key: &K, key_env: &E, visit_env: &F) -> result: Result<R, unit> reads(map), reads(key), reads(key_env), writes(visit_env) {
  return ordered_map_lookup_link::<OrderedKey<K, E>, V, F, R, fn observe>(link: &map^.root, key: key, key_env: key_env, visit_env: visit_env);
}

fn ordered_map_edit_node<interface OrderedKey<K, E>, V, F, R, fn update(env: &F, key: &K, value: &V) -> result: R reads(key), writes(value), writes(env)>(node: &OrderedNode<K, V>, key: &K, key_env: &E, edit_env: &F) -> result: Result<R, unit> reads(key), reads(key_env), writes(node), writes(edit_env) {
  let position = ordered_map_search::<OrderedKey<K, E>, V>(node: node, key: key, env: key_env);
  if position < node^.entries.len {
    let order = OrderedKey<K, E>::compare(env: key_env, left: key, right: &node^.entries[position].pair.key);
    if order == 0_i32 {
      let edited = update(env: edit_env, key: &node^.entries[position].pair.key, value: &node^.entries[position].pair.value);
      return Ok<R, unit>(value: move edited);
    }
  }
  if position == 0_u64 {
    return ordered_map_edit_link::<OrderedKey<K, E>, V, F, R, fn update>(link: &node^.leading, key: key, key_env: key_env, edit_env: edit_env);
  }
  let previous = position - 1_u64;
  return ordered_map_edit_link::<OrderedKey<K, E>, V, F, R, fn update>(link: &node^.entries[previous].after, key: key, key_env: key_env, edit_env: edit_env);
}

fn ordered_map_edit_link<interface OrderedKey<K, E>, V, F, R, fn update(env: &F, key: &K, value: &V) -> result: R reads(key), writes(value), writes(env)>(link: &Slots<Box<OrderedNode<K, V>>, 1>, key: &K, key_env: &E, edit_env: &F) -> result: Result<R, unit> reads(key), reads(key_env), writes(link), writes(edit_env) {
  if link^.len > 0_u64 {
    return ordered_map_edit_node::<OrderedKey<K, E>, V, F, R, fn update>(node: &link^[0_u64].inner, key: key, key_env: key_env, edit_env: edit_env);
  }
  return Err<R, unit>(error: unit);
}

fn ordered_map_edit<interface OrderedKey<K, E>, V, F, R, fn update(env: &F, key: &K, value: &V) -> result: R reads(key), writes(value), writes(env), const ceiling: u64>(map: &OrderedMap<K, V, ceiling>, key: &K, key_env: &E, edit_env: &F) -> result: Result<R, unit> reads(key), reads(key_env), writes(map), writes(edit_env) {
  return ordered_map_edit_link::<OrderedKey<K, E>, V, F, R, fn update>(link: &map^.root, key: key, key_env: key_env, edit_env: edit_env);
}

fn ordered_map_each_node<K, V, F, fn visit(env: &F, key: &K, value: &V) -> result: unit reads(key), reads(value), writes(env)>(node: &OrderedNode<K, V>, env: &F) -> result: unit reads(node), writes(env) {
  ordered_map_each_link::<K, V, F, fn visit>(link: &node^.leading, env: env);
  let count = node^.entries.len;
  for (index in 0_u64..count) {
    visit(env: env, key: &node^.entries[index].pair.key, value: &node^.entries[index].pair.value);
    ordered_map_each_link::<K, V, F, fn visit>(link: &node^.entries[index].after, env: env);
  }
  return unit;
}

fn ordered_map_each_link<K, V, F, fn visit(env: &F, key: &K, value: &V) -> result: unit reads(key), reads(value), writes(env)>(link: &Slots<Box<OrderedNode<K, V>>, 1>, env: &F) -> result: unit reads(link), writes(env) {
  if link^.len > 0_u64 {
    ordered_map_each_node::<K, V, F, fn visit>(node: &link^[0_u64].inner, env: env);
  }
  return unit;
}

fn ordered_map_each<K, V, F, fn visit(env: &F, key: &K, value: &V) -> result: unit reads(key), reads(value), writes(env), const ceiling: u64>(map: &OrderedMap<K, V, ceiling>, env: &F) -> result: unit reads(map), writes(env) {
  ordered_map_each_link::<K, V, F, fn visit>(link: &map^.root, env: env);
  return unit;
}

fn ordered_map_range_node<interface OrderedKey<K, E>, V, F, fn visit(env: &F, key: &K, value: &V) -> result: unit reads(key), reads(value), writes(env)>(node: &OrderedNode<K, V>, lower: &K, upper: &K, key_env: &E, visit_env: &F) -> result: unit reads(node), reads(lower), reads(upper), reads(key_env), writes(visit_env) {
  let start = ordered_map_search::<OrderedKey<K, E>, V>(node: node, key: lower, env: key_env);
  if start == 0_u64 {
    ordered_map_range_link::<OrderedKey<K, E>, V, F, fn visit>(link: &node^.leading, lower: lower, upper: upper, key_env: key_env, visit_env: visit_env);
  } else {
    let previous = start - 1_u64;
    ordered_map_range_link::<OrderedKey<K, E>, V, F, fn visit>(link: &node^.entries[previous].after, lower: lower, upper: upper, key_env: key_env, visit_env: visit_env);
  }
  let count = node^.entries.len;
  for (index in start..count) {
    let order = OrderedKey<K, E>::compare(env: key_env, left: &node^.entries[index].pair.key, right: upper);
    if order >= 0_i32 {
      return unit;
    }
    visit(env: visit_env, key: &node^.entries[index].pair.key, value: &node^.entries[index].pair.value);
    ordered_map_range_link::<OrderedKey<K, E>, V, F, fn visit>(link: &node^.entries[index].after, lower: lower, upper: upper, key_env: key_env, visit_env: visit_env);
  }
  return unit;
}

fn ordered_map_range_link<interface OrderedKey<K, E>, V, F, fn visit(env: &F, key: &K, value: &V) -> result: unit reads(key), reads(value), writes(env)>(link: &Slots<Box<OrderedNode<K, V>>, 1>, lower: &K, upper: &K, key_env: &E, visit_env: &F) -> result: unit reads(link), reads(lower), reads(upper), reads(key_env), writes(visit_env) {
  if link^.len > 0_u64 {
    ordered_map_range_node::<OrderedKey<K, E>, V, F, fn visit>(node: &link^[0_u64].inner, lower: lower, upper: upper, key_env: key_env, visit_env: visit_env);
  }
  return unit;
}

fn ordered_map_range<interface OrderedKey<K, E>, V, F, fn visit(env: &F, key: &K, value: &V) -> result: unit reads(key), reads(value), writes(env), const ceiling: u64>(map: &OrderedMap<K, V, ceiling>, lower: &K, upper: &K, key_env: &E, visit_env: &F) -> result: unit reads(map), reads(lower), reads(upper), reads(key_env), writes(visit_env) {
  let order = OrderedKey<K, E>::compare(env: key_env, left: lower, right: upper);
  if order < 0_i32 {
    ordered_map_range_link::<OrderedKey<K, E>, V, F, fn visit>(link: &map^.root, lower: lower, upper: upper, key_env: key_env, visit_env: visit_env);
  }
  return unit;
}

enum OrderedMove {
  OrderedMoved();
  OrderedExhausted();
  OrderedLost();
}

fn ordered_map_cursor_at(version: u64) -> cursor: OrderedCursor pure {
  doc "A cursor on no pair. A cursor's path holds, for each level from the root, the child it descends to, a child index from 0 (the leading link) to the entry count, and at its last level, depth minus one, the index of the entry it is on; depth zero is no pair.";
  let path = array_filled::<u8, 32>(value: 0_u8);
  return OrderedCursor(path: path, depth: 0_u64, version: version);
}

fn ordered_map_cursor_mark(cursor: &OrderedCursor, level: u64, index: u64) -> placed: Bool writes(cursor) {
  doc "Records index at level and makes level the cursor's last; a level past the path leaves the cursor on no pair. Fifteen entries a node and at least seven in every node below the root put the 33rd level beyond 10^28 pairs.";
  if level < 32_u64 {
    let narrow = cvt.wrap::<u64, u8>(index);
    set cursor^.path[level] = narrow;
    set cursor^.depth = level + 1_u64;
    return True();
  }
  set cursor^.depth = 0_u64;
  return False();
}

fn ordered_map_edge_node<K, V>(node: &OrderedNode<K, V>, cursor: &OrderedCursor, level: u64, last: Bool) -> result: OrderedMove reads(node), writes(cursor) {
  doc "Places the cursor, from level down, on the first pair of the node's subtree, or its last when last is set.";
  if last {
    let count = node^.entries.len;
    if count == 0_u64 {
      set cursor^.depth = 0_u64;
      return OrderedMove::OrderedLost();
    }
    let final = count - 1_u64;
    if final < node^.entries.len {
      if node^.entries[final].after.len > 0_u64 {
        let marked = ordered_map_cursor_mark(cursor: cursor, level: level, index: count);
        if marked {
          let next = level + 1_u64;
          return ordered_map_edge_node::<K, V>(node: &node^.entries[final].after[0_u64].inner, cursor: cursor, level: next, last: last);
        }
        return OrderedMove::OrderedLost();
      }
    }
    let placed = ordered_map_cursor_mark(cursor: cursor, level: level, index: final);
    if placed {
      return OrderedMove::OrderedMoved();
    }
    return OrderedMove::OrderedLost();
  }
  if node^.leading.len > 0_u64 {
    let marked = ordered_map_cursor_mark(cursor: cursor, level: level, index: 0_u64);
    if marked {
      let next = level + 1_u64;
      return ordered_map_edge_node::<K, V>(node: &node^.leading[0_u64].inner, cursor: cursor, level: next, last: last);
    }
    return OrderedMove::OrderedLost();
  }
  if node^.entries.len == 0_u64 {
    set cursor^.depth = 0_u64;
    return OrderedMove::OrderedLost();
  }
  let placed = ordered_map_cursor_mark(cursor: cursor, level: level, index: 0_u64);
  if placed {
    return OrderedMove::OrderedMoved();
  }
  return OrderedMove::OrderedLost();
}

fn ordered_map_edge<K, V, const ceiling: u64>(map: &OrderedMap<K, V, ceiling>, last: Bool) -> cursor: OrderedCursor reads(map) {
  let cursor = ordered_map_cursor_at(version: map^.version);
  if map^.root.len > 0_u64 {
    let placed = ordered_map_edge_node::<K, V>(node: &map^.root[0_u64].inner, cursor: &cursor, level: 0_u64, last: last);
  }
  return cursor;
}

fn ordered_map_first<K, V, const ceiling: u64>(map: &OrderedMap<K, V, ceiling>) -> cursor: OrderedCursor reads(map) {
  let last = False();
  let first = ordered_map_edge::<K, V, ceiling>(map: map, last: last);
  return first;
}

fn ordered_map_last<K, V, const ceiling: u64>(map: &OrderedMap<K, V, ceiling>) -> cursor: OrderedCursor reads(map) {
  let last = True();
  let found = ordered_map_edge::<K, V, ceiling>(map: map, last: last);
  return found;
}

fn ordered_map_partition<K, V, E, P, fn place(env: &E, left: &K, right: &P) -> order: i32 reads(env), reads(left), reads(right)>(node: &OrderedNode<K, V>, exclusive: Bool, probe: &P, env: &E) -> position: u64 reads(node), reads(probe), reads(env) contract {
  ensures position <= node^.entries.len;
} {
  doc "The number of leading entries whose keys lie before the sought position: ordered before the probe, or at it too when exclusive is set.";
  let count = node^.entries.len;
  for (index in 0_u64..count) {
    let order = place(env: env, left: &node^.entries[index].pair.key, right: probe);
    let beyond = order >= 0_i32;
    if exclusive {
      set beyond = order > 0_i32;
    }
    if beyond {
      return index;
    }
  }
  return count;
}

fn ordered_map_seek_link<K, V, E, P, fn place(env: &E, left: &K, right: &P) -> order: i32 reads(env), reads(left), reads(right)>(link: &Slots<Box<OrderedNode<K, V>>, 1>, cursor: &OrderedCursor, level: u64, exclusive: Bool, upward: Bool, probe: &P, env: &E) -> result: OrderedMove reads(link), reads(probe), reads(env), writes(cursor) {
  if link^.len > 0_u64 {
    return ordered_map_seek_node::<K, V, E, P, fn place>(node: &link^[0_u64].inner, cursor: cursor, level: level, exclusive: exclusive, upward: upward, probe: probe, env: env);
  }
  return OrderedMove::OrderedExhausted();
}

fn ordered_map_seek_node<K, V, E, P, fn place(env: &E, left: &K, right: &P) -> order: i32 reads(env), reads(left), reads(right)>(node: &OrderedNode<K, V>, cursor: &OrderedCursor, level: u64, exclusive: Bool, upward: Bool, probe: &P, env: &E) -> result: OrderedMove reads(node), reads(probe), reads(env), writes(cursor) {
  doc "Places the cursor on the first entry of the subtree past the sought position when upward is set, or the last before it otherwise. The child between the entries on either side of the position is searched first; when it holds no such entry, the entry beside the position in this node is the one, if it exists.";
  let position = ordered_map_partition::<K, V, E, P, fn place>(node: node, exclusive: exclusive, probe: probe, env: env);
  let marked = ordered_map_cursor_mark(cursor: cursor, level: level, index: position);
  if marked {
  } else {
    return OrderedMove::OrderedLost();
  }
  let next = level + 1_u64;
  let below = OrderedMove::OrderedExhausted();
  if position == 0_u64 {
    set below = ordered_map_seek_link::<K, V, E, P, fn place>(link: &node^.leading, cursor: cursor, level: next, exclusive: exclusive, upward: upward, probe: probe, env: env);
  } else {
    let previous = position - 1_u64;
    set below = ordered_map_seek_link::<K, V, E, P, fn place>(link: &node^.entries[previous].after, cursor: cursor, level: next, exclusive: exclusive, upward: upward, probe: probe, env: env);
  }
  match below {
    OrderedMoved() => {
      return OrderedMove::OrderedMoved();
    }
    OrderedLost() => {
      return OrderedMove::OrderedLost();
    }
    OrderedExhausted() => {
    }
  }
  if upward {
    if position < node^.entries.len {
      let placed = ordered_map_cursor_mark(cursor: cursor, level: level, index: position);
      return OrderedMove::OrderedMoved();
    }
    return OrderedMove::OrderedExhausted();
  }
  if position == 0_u64 {
    return OrderedMove::OrderedExhausted();
  }
  let previous = position - 1_u64;
  let placed = ordered_map_cursor_mark(cursor: cursor, level: level, index: previous);
  return OrderedMove::OrderedMoved();
}

fn ordered_map_seek<K, V, E, P, fn place(env: &E, left: &K, right: &P) -> order: i32 reads(env), reads(left), reads(right), const ceiling: u64>(map: &OrderedMap<K, V, ceiling>, seek: OrderedSeek, probe: &P, env: &E) -> cursor: OrderedCursor reads(map), reads(probe), reads(env) {
  doc "Each seek is one monotone split of the keys, before or past a position: at least and at most split after the keys ordered before the probe or at it, respectively; above and below the other way. At least and above take the first key past the split, at most and below the last key before it.";
  let exclusive = False();
  let upward = True();
  match seek {
    OrderedAtLeast() => {
    }
    OrderedAbove() => {
      set exclusive = True();
    }
    OrderedAtMost() => {
      set exclusive = True();
      set upward = False();
    }
    OrderedBelow() => {
      set upward = False();
    }
  }
  let cursor = ordered_map_cursor_at(version: map^.version);
  let found = ordered_map_seek_link::<K, V, E, P, fn place>(link: &map^.root, cursor: &cursor, level: 0_u64, exclusive: exclusive, upward: upward, probe: probe, env: env);
  match found {
    OrderedMoved() => {
    }
    OrderedLost() => {
      set cursor.depth = 0_u64;
    }
    OrderedExhausted() => {
      set cursor.depth = 0_u64;
    }
  }
  return cursor;
}

fn ordered_map_step_link<K, V>(link: &Slots<Box<OrderedNode<K, V>>, 1>, cursor: &OrderedCursor, level: u64, forward: Bool) -> result: OrderedMove reads(link), writes(cursor) {
  if link^.len > 0_u64 {
    return ordered_map_step_node::<K, V>(node: &link^[0_u64].inner, cursor: cursor, level: level, forward: forward);
  }
  return OrderedMove::OrderedLost();
}

fn ordered_map_step_node<K, V>(node: &OrderedNode<K, V>, cursor: &OrderedCursor, level: u64, forward: Bool) -> result: OrderedMove reads(node), writes(cursor) {
  doc "Follows the cursor's path through this node. At its last level the cursor moves into the child beside its entry, to that subtree's nearest pair, or else to the neighbouring entry here; at a level above, a child that has no further pair in the direction hands the move to the entry beside that child.";
  if level < 32_u64 {
  } else {
    return OrderedMove::OrderedLost();
  }
  let index = cvt::<u8, u64>(cursor^.path[level]);
  let next = level + 1_u64;
  if next >= cursor^.depth {
    if index < node^.entries.len {
    } else {
      return OrderedMove::OrderedLost();
    }
    if forward {
      if node^.entries[index].after.len > 0_u64 {
        let child = index + 1_u64;
        let marked = ordered_map_cursor_mark(cursor: cursor, level: level, index: child);
        let first = False();
        return ordered_map_edge_node::<K, V>(node: &node^.entries[index].after[0_u64].inner, cursor: cursor, level: next, last: first);
      }
      let following = index + 1_u64;
      if following < node^.entries.len {
        let placed = ordered_map_cursor_mark(cursor: cursor, level: level, index: following);
        return OrderedMove::OrderedMoved();
      }
      return OrderedMove::OrderedExhausted();
    }
    if index == 0_u64 {
      if node^.leading.len > 0_u64 {
        let marked = ordered_map_cursor_mark(cursor: cursor, level: level, index: 0_u64);
        let last = True();
        return ordered_map_edge_node::<K, V>(node: &node^.leading[0_u64].inner, cursor: cursor, level: next, last: last);
      }
      return OrderedMove::OrderedExhausted();
    }
    let previous = index - 1_u64;
    if node^.entries[previous].after.len > 0_u64 {
      let marked = ordered_map_cursor_mark(cursor: cursor, level: level, index: index);
      let last = True();
      return ordered_map_edge_node::<K, V>(node: &node^.entries[previous].after[0_u64].inner, cursor: cursor, level: next, last: last);
    }
    let placed = ordered_map_cursor_mark(cursor: cursor, level: level, index: previous);
    return OrderedMove::OrderedMoved();
  }
  let below = OrderedMove::OrderedLost();
  if index == 0_u64 {
    set below = ordered_map_step_link::<K, V>(link: &node^.leading, cursor: cursor, level: next, forward: forward);
  } else {
    let previous = index - 1_u64;
    if previous < node^.entries.len {
      set below = ordered_map_step_link::<K, V>(link: &node^.entries[previous].after, cursor: cursor, level: next, forward: forward);
    }
  }
  match below {
    OrderedMoved() => {
      return OrderedMove::OrderedMoved();
    }
    OrderedLost() => {
      return OrderedMove::OrderedLost();
    }
    OrderedExhausted() => {
    }
  }
  if forward {
    if index < node^.entries.len {
      let placed = ordered_map_cursor_mark(cursor: cursor, level: level, index: index);
      return OrderedMove::OrderedMoved();
    }
    return OrderedMove::OrderedExhausted();
  }
  if index == 0_u64 {
    return OrderedMove::OrderedExhausted();
  }
  let previous = index - 1_u64;
  let placed = ordered_map_cursor_mark(cursor: cursor, level: level, index: previous);
  return OrderedMove::OrderedMoved();
}

fn ordered_map_step<K, V, const ceiling: u64>(map: &OrderedMap<K, V, ceiling>, cursor: &OrderedCursor, direction: OrderedDirection) -> moved: Bool reads(map), writes(cursor) {
  if cursor^.version != map^.version {
    set cursor^.depth = 0_u64;
    return False();
  }
  if cursor^.depth == 0_u64 {
    return False();
  }
  let forward = True();
  match direction {
    OrderedForward() => {
    }
    OrderedBackward() => {
      set forward = False();
    }
  }
  let stepped = ordered_map_step_link::<K, V>(link: &map^.root, cursor: cursor, level: 0_u64, forward: forward);
  match stepped {
    OrderedMoved() => {
      return True();
    }
    OrderedLost() => {
      set cursor^.depth = 0_u64;
      return False();
    }
    OrderedExhausted() => {
      set cursor^.depth = 0_u64;
      return False();
    }
  }
}

fn ordered_map_read_link<K, V, F, R, fn observe(env: &F, key: &K, value: &V) -> result: R reads(key), reads(value), writes(env)>(link: &Slots<Box<OrderedNode<K, V>>, 1>, cursor: &OrderedCursor, level: u64, env: &F) -> result: Result<R, unit> reads(link), reads(cursor), writes(env) {
  if link^.len > 0_u64 {
    return ordered_map_read_node::<K, V, F, R, fn observe>(node: &link^[0_u64].inner, cursor: cursor, level: level, env: env);
  }
  return Err<R, unit>(error: unit);
}

fn ordered_map_read_node<K, V, F, R, fn observe(env: &F, key: &K, value: &V) -> result: R reads(key), reads(value), writes(env)>(node: &OrderedNode<K, V>, cursor: &OrderedCursor, level: u64, env: &F) -> result: Result<R, unit> reads(node), reads(cursor), writes(env) {
  if level < 32_u64 {
  } else {
    return Err<R, unit>(error: unit);
  }
  let index = cvt::<u8, u64>(cursor^.path[level]);
  let next = level + 1_u64;
  if next >= cursor^.depth {
    if index < node^.entries.len {
      let observed = observe(env: env, key: &node^.entries[index].pair.key, value: &node^.entries[index].pair.value);
      return Ok<R, unit>(value: move observed);
    }
    return Err<R, unit>(error: unit);
  }
  if index == 0_u64 {
    return ordered_map_read_link::<K, V, F, R, fn observe>(link: &node^.leading, cursor: cursor, level: next, env: env);
  }
  let previous = index - 1_u64;
  if previous < node^.entries.len {
    return ordered_map_read_link::<K, V, F, R, fn observe>(link: &node^.entries[previous].after, cursor: cursor, level: next, env: env);
  }
  return Err<R, unit>(error: unit);
}

fn ordered_map_read<K, V, F, R, fn observe(env: &F, key: &K, value: &V) -> result: R reads(key), reads(value), writes(env), const ceiling: u64>(map: &OrderedMap<K, V, ceiling>, cursor: &OrderedCursor, env: &F) -> result: Result<R, unit> reads(map), reads(cursor), writes(env) {
  if cursor^.version != map^.version {
    return Err<R, unit>(error: unit);
  }
  if cursor^.depth == 0_u64 {
    return Err<R, unit>(error: unit);
  }
  return ordered_map_read_link::<K, V, F, R, fn observe>(link: &map^.root, cursor: cursor, level: 0_u64, env: env);
}

fn ordered_map_free_node<K, V, F, fn consume(env: &F, key: K, value: V) -> result: unit writes(env)>(node: Box<OrderedNode<K, V>>, env: &F) -> result: unit writes(env) {
  loop @entries {
    if node.inner.entries.len == 0_u64 {
      break @entries;
    }
    let item = take_back(window: &node.inner.entries);
    let OrderedEntry(pair: pair, after: after) = move item;
    let OrderedPair(key: key, value: value) = move pair;
    consume(env: env, key: move key, value: move value);
    ordered_map_free_link::<K, V, F, fn consume>(link: move after, env: env);
  }
  let OrderedNode(leading: leading, entries: empty_entries) = move node.inner;
  free_empty(window: move empty_entries);
  ordered_map_free_link::<K, V, F, fn consume>(link: move leading, env: env);
  return unit;
}

fn ordered_map_free_link<K, V, F, fn consume(env: &F, key: K, value: V) -> result: unit writes(env)>(link: Slots<Box<OrderedNode<K, V>>, 1>, env: &F) -> result: unit writes(env) {
  if link.len > 0_u64 {
    let node = take_back(window: &link);
    ordered_map_free_node::<K, V, F, fn consume>(node: move node, env: env);
  }
  free_empty(window: move link);
  return unit;
}

fn ordered_map_free<K, V, F, fn consume(env: &F, key: K, value: V) -> result: unit writes(env), const ceiling: u64>(map: OrderedMap<K, V, ceiling>, env: &F) -> result: unit writes(env) {
  let OrderedMap(root: root, length: length, version: version) = move map;
  ordered_map_free_link::<K, V, F, fn consume>(link: move root, env: env);
  return unit;
}
