fn slab_new<T, const ceiling: u64, const generation_limit: u64>(capacity: u64) -> result: Slab<T, ceiling, generation_limit> pure contract {
  requires capacity <= ceiling;
} {
  doc "Reserves one backing for at most capacity stable slots, materializing each cell only on its first insertion. The ceiling is the caller's allocation-size domain, not an allocation refusal. A handle is relative to this slab; its integers do not authenticate another slab. Allocation is total under STOR-8.";
  let cells = box_slots_new::<SlabCell<T>>(capacity: capacity);
  return Slab<T, ceiling, generation_limit>(cells: move cells, free_head: capacity);
}

fn slab_insert<T, const ceiling: u64, const generation_limit: u64>(slab: &Slab<T, ceiling, generation_limit>, value: T) -> result: Result<SlabHandle, T> writes(slab) contract {
  ensures deref(slab).cells.inner.cap == deref(entry(slab)).cells.inner.cap;
  ensures deref(slab).cells.inner.len >= deref(entry(slab)).cells.inner.len;
  ensures deref(slab).cells.inner.len <= deref(entry(slab)).cells.inner.len + 1_u64;
} {
  doc "Reuses the free-list head, or materializes the next reserved cell, in constant work. The one-slot window is an ordinary ownership-visible vacancy: its empty state never holds a dummy T and its filled state owns exactly one T. Err returns the offered owner unchanged when no available slot remains. Direct mutation of the slab's bookkeeping is outside this library protocol; malformed bookkeeping is still checked before any access.";
  let index = deref(slab).free_head;
  if index < deref(slab).cells.inner.len {
    if deref(slab).cells.inner[index].storage.len == 0_u64 {
      let generation = deref(slab).cells.inner[index].generation;
      if generation <= generation_limit {
        let following = deref(slab).cells.inner[index].next;
        place_back(window: &deref(slab).cells.inner[index].storage, value: move value);
        set deref(slab).free_head = following;
        let handle = SlabHandle(index: index, generation: generation);
        return Ok<SlabHandle, T>(value: handle);
      }
    }
    return Err<SlabHandle, T>(error: move value);
  }
  let materialized = deref(slab).cells.inner.len;
  if materialized < deref(slab).cells.inner.cap {
    let storage = slots_new::<T, 1>();
    place_back(window: &storage, value: move value);
    let cell = SlabCell<T>(storage: move storage, generation: 0_u64, next: deref(slab).free_head);
    place_back(window: &deref(slab).cells.inner, value: move cell);
    let handle = SlabHandle(index: materialized, generation: 0_u64);
    return Ok<SlabHandle, T>(value: handle);
  }
  return Err<SlabHandle, T>(error: move value);
}

fn slab_find_index<T, const ceiling: u64, const generation_limit: u64>(slab: &Slab<T, ceiling, generation_limit>, handle: SlabHandle) -> found: Result<u64, unit> reads(slab) contract {
  ensures when Ok(value: index): index < deref(slab).cells.inner.len;
} {
  doc "Checks materialization, occupancy and generation. The resulting index carries its outer bound; FN-9 does not publish a variant or an indexed cell's occupancy. A caller selecting the payload must re-read that cell's one-slot length, or use slab_visit to perform the complete borrowed access within one helper.";
  let index = handle.index;
  if index < deref(slab).cells.inner.len {
    if deref(slab).cells.inner[index].generation == handle.generation {
      if deref(slab).cells.inner[index].storage.len > 0_u64 {
        return Ok<u64, unit>(value: index);
      }
    }
  }
  return Err<u64, unit>(error: unit);
}

fn slab_visit<interface SlabVisit<T, E, R>, const ceiling: u64, const generation_limit: u64>(slab: &Slab<T, ceiling, generation_limit>, handle: SlabHandle, env: &E) -> result: Result<R, unit> reads(slab), writes(env) {
  doc "Borrows a present value only for the supplied monomorphized member call. REF-3 forbids returning a reference; R is ordinary owned data. A missing, deleted, reused or retired handle returns Err without invoking the member.";
  let index = handle.index;
  if index < deref(slab).cells.inner.len {
    if deref(slab).cells.inner[index].generation == handle.generation {
      if deref(slab).cells.inner[index].storage.len > 0_u64 {
        let observed = SlabVisit::visit(env: env, value: &deref(slab).cells.inner[index].storage[0_u64]);
        return Ok<R, unit>(value: move observed);
      }
    }
  }
  return Err<R, unit>(error: unit);
}

fn slab_edit<interface SlabEdit<T, E, R>, const ceiling: u64, const generation_limit: u64>(slab: &Slab<T, ceiling, generation_limit>, handle: SlabHandle, env: &E) -> result: Result<R, unit> writes(slab.cells), writes(env) contract {
  ensures deref(slab).cells.inner.len == deref(entry(slab)).cells.inner.len;
  ensures deref(slab).cells.inner.cap == deref(entry(slab)).cells.inner.cap;
} {
  doc "Validates materialization, generation and occupancy before lending a writable payload to the supplied member. Missing, deleted, reused and retired handles return Err without invoking it. The payload argument supplies no containing-cell or free-list access. The member preserves ordinary ownership and returns owned data only; its environment must be disjoint from slab.cells. Successful payload edits preserve the outer storage extents and handle generation.";
  let index = handle.index;
  if index < deref(slab).cells.inner.len {
    if deref(slab).cells.inner[index].generation == handle.generation {
      if deref(slab).cells.inner[index].storage.len > 0_u64 {
        let changed = SlabEdit::edit(env: env, value: &deref(slab).cells.inner[index].storage[0_u64]);
        return Ok<R, unit>(value: move changed);
      }
    }
  }
  return Err<R, unit>(error: unit);
}

fn slab_remove<T, const ceiling: u64, const generation_limit: u64>(slab: &Slab<T, ceiling, generation_limit>, handle: SlabHandle) -> result: Option<T> writes(slab) contract {
  ensures deref(slab).cells.inner.cap == deref(entry(slab)).cells.inner.cap;
  ensures deref(slab).cells.inner.len == deref(entry(slab)).cells.inner.len;
} {
  doc "Returns exactly the matching owner. Below generation_limit the empty cell is linked at the free-list head with the next generation; at the limit it is permanently retired instead of wrapping. Retired cells remain materialized, so a handle's index never shifts or moves another payload.";
  let index = handle.index;
  if index < deref(slab).cells.inner.len {
    let generation = deref(slab).cells.inner[index].generation;
    if generation == handle.generation {
      if deref(slab).cells.inner[index].storage.len > 0_u64 {
        let value = take_back(window: &deref(slab).cells.inner[index].storage);
        if generation < generation_limit {
          let following_generation = generation + 1_u64;
          set deref(slab).cells.inner[index].generation = following_generation;
          set deref(slab).cells.inner[index].next = deref(slab).free_head;
          set deref(slab).free_head = index;
        }
        return Some<T>(value: move value);
      }
    }
  }
  return None<T>();
}

fn slab_free<interface SlabConsume<T, E>, const ceiling: u64, const generation_limit: u64>(slab: Slab<T, ceiling, generation_limit>, env: &E) -> result: unit writes(env) {
  doc "Consumes live payloads in reverse materialized-slot order, then releases the backing. Never-materialized capacity holds no cells and needs no cleanup. Every must-consume T reaches the supplied member exactly once; empty one-slot windows and the final outer backing use ordinary free_empty.";
  let Slab(cells: cells, free_head: head) = move slab;
  loop @cleanup {
    if cells.inner.len == 0_u64 {
      break @cleanup;
    }
    let cell = take_back(window: &cells.inner);
    let SlabCell(storage: storage, generation: generation, next: following) = move cell;
    if storage.len > 0_u64 {
      let value = take_back(window: &storage);
      SlabConsume::consume(env: env, value: move value);
    }
    free_empty(window: move storage);
  }
  free_empty(window: move cells);
  return unit;
}
