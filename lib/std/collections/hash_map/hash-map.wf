fn hash_map_extend<K, V, const ceiling: u64>(cells: &Box<Slots<HashMapSlot<K, V>>>, target: u64) -> result: unit writes(cells) contract {
  requires cells^.inner.len <= target;
  ensures cells^.inner.len == target;
  ensures cells^.inner.cap >= target;
} {
  if cells^.inner.cap < target {
    grow(cell: cells, capacity: target);
  }
  let start = cells^.inner.len;
  for @fill (
    index in start..target,
    invariant filled: cells^.inner.len >= index,
    invariant bounded: cells^.inner.len <= index,
    invariant spare: cells^.inner.cap - cells^.inner.len + index >= target
  ) {
    let vacant = HashMapSlot<K, V>::HashMapVacant();
    place_back(window: &cells^.inner, value: move vacant);
  }
  invariant complete_min: cells^.inner.len >= target;
  invariant complete_max: cells^.inner.len <= target;
  return unit;
}

fn hash_map_room(count: u64) -> room: u64 pure {
  doc "The pairs a map with count buckets holds before hash_map_put rebuilds it: count less a quarter of count, rounded down.";
  let quarter = count / 4_u64;
  return count - quarter;
}

fn hash_map_buckets(capacity: u64) -> count: u64 pure {
  doc "The bucket count for a capacity: zero for none, else the least power of two that is at least two and whose room is at least the capacity, saturating at 2^63.";
  if capacity == 0_u64 {
    return 0_u64;
  }
  let buckets = 2_u64;
  for (step in 0_u64..62_u64) {
    let room = hash_map_room(count: buckets);
    if room < capacity {
      set buckets = buckets +wrap buckets;
    }
  }
  return buckets;
}

fn hash_map_shift(count: u64) -> shift: u32 pure {
  doc "The right shift that keeps the top log2(count) bits of a mixed hash, for a power-of-two count of at least two; 63 for any smaller count.";
  let remaining = count;
  let shift = 64_u32;
  for (step in 0_u64..64_u64) {
    if remaining > 1_u64 {
      set remaining = ishr.wrap(remaining, 1_u32);
      set shift = shift -sat 1_u32;
    }
  }
  if shift > 63_u32 {
    set shift = 63_u32;
  }
  return shift;
}

fn hash_map_home(hash: u64, shift: u32, count: u64) -> index: u64 pure contract {
  requires count > 0_u64;
  ensures index < count;
} {
  doc "The home bucket: the top bits of the hash after one odd multiplication, so keys whose hashes differ only in low bits still spread. Each home is a contiguous interval of the mixed hash space and doubling the bucket count splits every interval in two; the scan cursor is a position in that space.";
  let mixed = hash *wrap 11400714819323198485_u64;
  let high = ishr.wrap(mixed, shift);
  if high < count {
    return high;
  }
  return 0_u64;
}

fn hash_map_new<K, V, const ceiling: u64>(capacity: u64) -> result: HashMap<K, V, ceiling> pure contract {
  requires capacity <= ceiling;
} {
  doc "The ceiling is the maximum public capacity and the most pairs the map holds: reserve never exceeds it and put refuses a pair beyond it. The bucket count is zero or a power of two of at least two, and each key's home bucket is the top bits of its hash after one odd multiplication. Capacity counts the pairs the map holds before put rebuilds it: three quarters of the bucket count, rounded up, and at most the ceiling. Rebuild moves pairs between buckets; no stable index or address is promised. Ordinary map semantics require hashing, equality, and their per-call environments to retain one consistent key protocol while entries remain stored, including equal hashes for equivalent keys. These laws are not source-admission prerequisites: ownership safety and finite probe bounds hold even when they are inconsistent, provided callbacks return.";
  let buckets = hash_map_buckets(capacity: capacity);
  let cells = box_slots_new::<HashMapSlot<K, V>>(capacity: buckets);
  hash_map_extend::<K, V, ceiling>(cells: &cells, target: buckets);
  let shift = hash_map_shift(count: buckets);
  return HashMap<K, V, ceiling>(cells: move cells, length: 0_u64, vacated: 0_u64, shift: shift);
}

fn hash_map_len<K, V, const ceiling: u64>(map: &HashMap<K, V, ceiling>) -> length: u64 reads(map) {
  return map^.length;
}

fn hash_map_capacity<K, V, const ceiling: u64>(map: &HashMap<K, V, ceiling>) -> capacity: u64 reads(map) {
  doc "Capacity counts the pairs the map holds before hash_map_put rebuilds it: three quarters of its power-of-two bucket count, rounded up, and at most the ceiling.";
  let room = hash_map_room(count: map^.cells.inner.len);
  if room > ceiling {
    return ceiling;
  }
  return room;
}

fn hash_map_probe(home: u64, step: u64, count: u64) -> index: u64 pure contract {
  requires home < count;
  requires step < count;
  ensures index < count;
} {
  let remaining = count - home;
  if step >= remaining {
    let wrapped = step - remaining;
    return wrapped;
  }
  let straight = home + step;
  return straight;
}

fn hash_map_action<interface HashMapKey<K, E>, V>(slot: &HashMapSlot<K, V>, key: &K, env: &E) -> result: HashMapAction reads(slot), reads(key), reads(env) {
  match slot^ {
    HashMapVacant() => {
      return HashMapAction::HashMapStop();
    }
    HashMapDeleted() => {
      return HashMapAction::HashMapSkip();
    }
    HashMapFilled(key: saved_key, value: saved_value) => {
      let equal = HashMapKey::equal(env: env, left: saved_key, right: key);
      if equal {
        return HashMapAction::HashMapMatch();
      }
      return HashMapAction::HashMapMiss();
    }
  }
}

fn hash_map_find<interface HashMapKey<K, E>, V, const ceiling: u64>(map: &HashMap<K, V, ceiling>, key: &K, env: &E) -> result: Result<u64, unit> reads(map), reads(key), reads(env) contract {
  ensures when Ok(value: index): index < map^.cells.inner.len;
} {
  let hash = HashMapKey::hash(env: env, key: key);
  let count = map^.cells.inner.len;
  for (step in 0_u64..count) {
    let home = hash_map_home(hash: hash, shift: map^.shift, count: count);
    let index = hash_map_probe(home: home, step: step, count: count);
    let action = hash_map_action::<HashMapKey<K, E>, V>(slot: &map^.cells.inner[index], key: key, env: env);
    match action {
      HashMapMatch() => {
        return Ok<u64, unit>(value: index);
      }
      HashMapStop() => {
        return Err<u64, unit>(error: unit);
      }
      HashMapSkip() => {
      }
      HashMapMiss() => {
      }
    }
  }
  return Err<u64, unit>(error: unit);
}

fn hash_map_lookup<interface HashMapKey<K, E>, V, F, R, fn observe(env: &F, key: &K, value: &V) -> result: R reads(key), reads(value), writes(env), const ceiling: u64>(map: &HashMap<K, V, ceiling>, key: &K, key_env: &E, visit_env: &F) -> result: Result<R, unit> reads(map), reads(key), reads(key_env), writes(visit_env) {
  let hash = HashMapKey::hash(env: key_env, key: key);
  let count = map^.cells.inner.len;
  for (step in 0_u64..count) {
    let home = hash_map_home(hash: hash, shift: map^.shift, count: count);
    let index = hash_map_probe(home: home, step: step, count: count);
    let slot = &map^.cells.inner[index];
    match slot^ {
      HashMapFilled(key: saved_key, value: saved_value) => {
        let equal = HashMapKey::equal(env: key_env, left: saved_key, right: key);
        if equal {
          let observed = observe(env: visit_env, key: saved_key, value: saved_value);
          return Ok<R, unit>(value: move observed);
        }
      }
      HashMapVacant() => {
        return Err<R, unit>(error: unit);
      }
      HashMapDeleted() => {
      }
    }
  }
  return Err<R, unit>(error: unit);
}

fn hash_map_edit<interface HashMapKey<K, E>, V, F, R, fn update(env: &F, key: &K, value: &V) -> result: R reads(key), writes(env), writes(value), const ceiling: u64>(map: &HashMap<K, V, ceiling>, key: &K, key_env: &E, edit_env: &F) -> result: Result<R, unit> reads(key), reads(key_env), writes(map), writes(edit_env) contract {
  ensures map^.cells.inner.len == entry(map)^.cells.inner.len;
  ensures map^.cells.inner.cap == entry(map)^.cells.inner.cap;
} {
  let hash = HashMapKey::hash(env: key_env, key: key);
  let count = map^.cells.inner.len;
  for (step in 0_u64..count) {
    let home = hash_map_home(hash: hash, shift: map^.shift, count: count);
    let index = hash_map_probe(home: home, step: step, count: count);
    let slot = &map^.cells.inner[index];
    match slot^ {
      HashMapFilled(key: saved_key, value: saved_value) => {
        let equal = HashMapKey::equal(env: key_env, left: saved_key, right: key);
        if equal {
          let updated = update(env: edit_env, key: saved_key, value: saved_value);
          return Ok<R, unit>(value: move updated);
        }
      }
      HashMapVacant() => {
        return Err<R, unit>(error: unit);
      }
      HashMapDeleted() => {
      }
    }
  }
  return Err<R, unit>(error: unit);
}

fn hash_map_exchange<K, V>(cells: &Box<Slots<HashMapSlot<K, V>>>, index: u64, key: K, value: V) -> result: HashMapPut<K, V> writes(cells) contract {
  requires index < cells^.inner.len;
  ensures cells^.inner.len == entry(cells)^.inner.len;
  ensures cells^.inner.cap == entry(cells)^.inner.cap;
} {
  doc "Every old variant has ordinary useful behavior: vacant and deleted mean insertion, while filled returns the old complete pair. No vacancy proof is needed to consume the exchanged enum.";
  let offered = HashMapSlot<K, V>::HashMapFilled(key: move key, value: move value);
  swap(first: &cells^.inner[index], second: &offered);
  match move offered {
    HashMapVacant() => {
      return HashMapPut<K, V>::HashMapInserted();
    }
    HashMapDeleted() => {
      return HashMapPut<K, V>::HashMapInserted();
    }
    HashMapFilled(key: old_key, value: old_value) => {
      let previous = HashMapPair<K, V>(key: move old_key, value: move old_value);
      let replacement_reason = HashMapReturnReason::HashMapReplaced();
      return HashMapPut<K, V>::HashMapReturned(reason: replacement_reason, pair: move previous);
    }
  }
}

fn hash_map_try_put<interface HashMapKey<K, E>, V, const ceiling: u64>(map: &HashMap<K, V, ceiling>, key: K, value: V, env: &E) -> result: HashMapPut<K, V> reads(env), writes(map) contract {
  ensures map^.cells.inner.len == entry(map)^.cells.inner.len;
  ensures map^.cells.inner.cap == entry(map)^.cells.inner.cap;
} {
  let hash = HashMapKey::hash(env: env, key: &key);
  let count = map^.cells.inner.len;
  let available = count;
  for @probe (step in 0_u64..count) {
    let home = hash_map_home(hash: hash, shift: map^.shift, count: count);
    let index = hash_map_probe(home: home, step: step, count: count);
    let action = hash_map_action::<HashMapKey<K, E>, V>(slot: &map^.cells.inner[index], key: &key, env: env);
    match action {
      HashMapMatch() => {
        let replaced = hash_map_exchange::<K, V>(cells: &map^.cells, index: index, key: move key, value: move value);
        return move replaced;
      }
      HashMapStop() => {
        if available == count {
          set available = index;
        }
        break @probe;
      }
      HashMapSkip() => {
        if available == count {
          set available = index;
        }
      }
      HashMapMiss() => {
      }
    }
  }
  if available < count {
    let before = map^.length;
    if before < ceiling {
      set map^.length = before + 1_u64;
      let reused = hash_map_is_deleted::<K, V>(slot: &map^.cells.inner[available]);
      if reused {
        set map^.vacated = map^.vacated -sat 1_u64;
      }
      let inserted = hash_map_exchange::<K, V>(cells: &map^.cells, index: available, key: move key, value: move value);
      return move inserted;
    }
  }
  let offered = HashMapPair<K, V>(key: move key, value: move value);
  let refusal_reason = HashMapReturnReason::HashMapFull();
  return HashMapPut<K, V>::HashMapReturned(reason: refusal_reason, pair: move offered);
}

fn hash_map_is_deleted<K, V>(slot: &HashMapSlot<K, V>) -> result: Bool reads(slot) {
  match slot^ {
    HashMapDeleted() => {
      return True();
    }
    HashMapVacant() => {
      return False();
    }
    HashMapFilled(key: saved_key, value: saved_value) => {
      return False();
    }
  }
}

fn hash_map_is_available<K, V>(slot: &HashMapSlot<K, V>) -> result: Bool reads(slot) {
  match slot^ {
    HashMapVacant() => {
      return True();
    }
    HashMapDeleted() => {
      return True();
    }
    HashMapFilled(key: saved_key, value: saved_value) => {
      return False();
    }
  }
}

fn hash_map_rebuild<interface HashMapKey<K, E>, V, const ceiling: u64>(map: &HashMap<K, V, ceiling>, buckets: u64, env: &E) -> result: Result<unit, unit> reads(env), writes(map) {
  doc "Moves every pair into a fresh backing of the given bucket count, zero or a power of two of at least two, and releases the old backing before it returns; refuses a count below the length before any pair moves. Reserve, rehash and insertion pass no fewer than the current bucket count, which they derive with hash_map_buckets or keep, and a shrinking removal passes four or more per remaining pair, or zero when none remains. One function serves growth and shrinking: split into a refusing wrapper and a moving helper, the moving loop compiled with two of its three hash constants reloaded for every pair, measurably slower growth of a small map. Direct migration keeps the original enum buckets and uses one temporary inline one-slot window for a pending pair. Every exchange result has useful behavior: Inserted empties the staging window; Replaced and Full restore their complete returned owner for retry. Each attempt hashes the current staged key and probes only occupancy, never equality. While a pair is pending, fewer pairs than the original length fill the new backing, so a scan bounded by its bucket count reaches a vacant bucket without any hash or equality consistency assumption, provided callbacks return. No global occupancy fact authorizes a discard or a partial operation. A zero-bucket target drains only vacant and deleted buckets and allocates nothing. The shift for home positions is set before the first pair moves. The backing swap does not publish an extent relation under the current proof rules, so this function promises no monotone extent postcondition; subsequent operations read their current bounds.";
  let live = map^.length;
  if buckets < live {
    return Err<unit, unit>(error: unit);
  }
  let previous = box_slots_new::<HashMapSlot<K, V>>(capacity: buckets);
  hash_map_extend::<K, V, ceiling>(cells: &previous, target: buckets);
  swap(first: &map^.cells, second: &previous);
  set map^.shift = hash_map_shift(count: buckets);
  loop @old_cells {
    if previous.inner.len == 0_u64 {
      break @old_cells;
    }
    let slot = take_back(window: &previous.inner);
    match move slot {
      HashMapVacant() => {
      }
      HashMapDeleted() => {
      }
      HashMapFilled(key: saved_key, value: saved_value) => {
        let pending = slots_new::<HashMapPair<K, V>, 1>();
        let initial = HashMapPair<K, V>(key: move saved_key, value: move saved_value);
        place_back(window: &pending, value: move initial);
        loop @owner {
          if pending.len == 0_u64 {
            break @owner;
          }
          let hash = HashMapKey::hash(env: env, key: &pending[0_u64].key);
          let count = map^.cells.inner.len;
          for @vacancy (step in 0_u64..count) {
            let home = hash_map_home(hash: hash, shift: map^.shift, count: count);
            let index = hash_map_probe(home: home, step: step, count: count);
            let available = hash_map_is_available::<K, V>(slot: &map^.cells.inner[index]);
            if available {
              let offered = take_back(window: &pending);
              let HashMapPair(key: offered_key, value: offered_value) = move offered;
              let exchanged = hash_map_exchange::<K, V>(cells: &map^.cells, index: index, key: move offered_key, value: move offered_value);
              match move exchanged {
                HashMapInserted() => {
                }
                HashMapReturned(reason: returned_reason, pair: returned_pair) => {
                  place_back(window: &pending, value: move returned_pair);
                }
              }
              break @vacancy;
            }
          }
        }
        free_empty(window: move pending);
      }
    }
  }
  free_empty(window: move previous);
  set map^.vacated = 0_u64;
  return Ok<unit, unit>(value: unit);
}

fn hash_map_reserve<interface HashMapKey<K, E>, V, const ceiling: u64>(map: &HashMap<K, V, ceiling>, capacity: u64, env: &E) -> result: Result<unit, unit> reads(env), writes(map) {
  if capacity > ceiling {
    return Err<unit, unit>(error: unit);
  }
  let room = hash_map_room(count: map^.cells.inner.len);
  if capacity <= room {
    return Ok<unit, unit>(value: unit);
  }
  let buckets = hash_map_buckets(capacity: capacity);
  let rebuilt = hash_map_rebuild::<HashMapKey<K, E>, V, ceiling>(map: map, buckets: buckets, env: env);
  return rebuilt;
}

fn hash_map_rehash<interface HashMapKey<K, E>, V, const ceiling: u64>(map: &HashMap<K, V, ceiling>, env: &E) -> result: Result<unit, unit> reads(env), writes(map) {
  let buckets = map^.cells.inner.len;
  let rebuilt = hash_map_rebuild::<HashMapKey<K, E>, V, ceiling>(map: map, buckets: buckets, env: env);
  return rebuilt;
}

fn hash_map_put<interface HashMapKey<K, E>, V, const ceiling: u64>(map: &HashMap<K, V, ceiling>, key: K, value: V, env: &E) -> result: HashMapPut<K, V> reads(env), writes(map) {
  let buckets = map^.cells.inner.len;
  let used = map^.length +sat map^.vacated;
  let limit = hash_map_room(count: buckets);
  let crowded = used >= limit;
  let below_ceiling = limit < ceiling;
  let rebuild = band(crowded, below_ceiling);
  if rebuild {
    let target = buckets;
    let live = map^.length;
    let half = limit / 2_u64;
    if live < half {
      set target = buckets;
    } else if buckets == 0_u64 {
      set target = 2_u64;
    } else if buckets <= 4611686018427387904_u64 {
      set target = buckets + buckets;
    }
    let grown = hash_map_rebuild::<HashMapKey<K, E>, V, ceiling>(map: map, buckets: target, env: env);
  }
  let attempted = hash_map_try_put::<HashMapKey<K, E>, V, ceiling>(map: map, key: move key, value: move value, env: env);
  return move attempted;
}

fn hash_map_shrunk(live: u64) -> count: u64 pure {
  doc "The bucket count a shrinking removal rebuilds into: the least power of two that is at least eight and holds at least four buckets per pair, saturating at 2^63.";
  let buckets = 8_u64;
  for (step in 0_u64..60_u64) {
    let quarter = buckets / 4_u64;
    if quarter < live {
      set buckets = buckets +wrap buckets;
    }
  }
  return buckets;
}

fn hash_map_shrink<interface HashMapKey<K, E>, V, const ceiling: u64>(map: &HashMap<K, V, ceiling>, env: &E) -> result: unit reads(env), writes(map) {
  doc "After a successful removal: release every bucket when no pair remains, and otherwise rebuild into hash_map_shrunk of the remaining length once eight times that length is below the bucket count. For a power-of-two bucket count of at least sixteen the target is at most half of it, so a shrink always reduces the bucket count, and right after it the bucket count is below eight per pair, so the next removal does not shrink again.";
  let live = map^.length;
  let buckets = map^.cells.inner.len;
  if live == 0_u64 {
    if buckets > 0_u64 {
      let shrunk = hash_map_rebuild::<HashMapKey<K, E>, V, ceiling>(map: map, buckets: 0_u64, env: env);
    }
    return unit;
  }
  let eighth = buckets / 8_u64;
  if live < eighth {
    let target = hash_map_shrunk(live: live);
    let shrunk = hash_map_rebuild::<HashMapKey<K, E>, V, ceiling>(map: map, buckets: target, env: env);
  }
  return unit;
}

fn hash_map_remove<interface HashMapKey<K, E>, V, const ceiling: u64>(map: &HashMap<K, V, ceiling>, key: &K, env: &E) -> result: Option<HashMapPair<K, V>> reads(key), reads(env), writes(map) {
  let before = map^.length;
  if before == 0_u64 {
    return None<HashMapPair<K, V>>();
  }
  let found = hash_map_find::<HashMapKey<K, E>, V, ceiling>(map: map, key: key, env: env);
  match found {
    Ok(value: index) => {
      let removed = HashMapSlot<K, V>::HashMapDeleted();
      swap(first: &map^.cells.inner[index], second: &removed);
      match move removed {
        HashMapFilled(key: saved_key, value: saved_value) => {
          set map^.length = before - 1_u64;
          set map^.vacated = map^.vacated +sat 1_u64;
          let pair = HashMapPair<K, V>(key: move saved_key, value: move saved_value);
          hash_map_shrink::<HashMapKey<K, E>, V, ceiling>(map: map, env: env);
          return Some<HashMapPair<K, V>>(value: move pair);
        }
        HashMapVacant() => {
          return None<HashMapPair<K, V>>();
        }
        HashMapDeleted() => {
          return None<HashMapPair<K, V>>();
        }
      }
    }
    Err(error: missing) => {
      return None<HashMapPair<K, V>>();
    }
  }
}

fn hash_map_each<K, V, E, fn visit(env: &E, key: &K, value: &V) -> result: unit reads(key), reads(value), writes(env), const ceiling: u64>(map: &HashMap<K, V, ceiling>, env: &E) -> result: unit reads(map), writes(env) {
  let count = map^.cells.inner.len;
  for (index in 0_u64..count) {
    let slot = &map^.cells.inner[index];
    match slot^ {
      HashMapFilled(key: saved_key, value: saved_value) => {
        visit(env: env, key: saved_key, value: saved_value);
      }
      HashMapVacant() => {
      }
      HashMapDeleted() => {
      }
    }
  }
  return unit;
}

fn hash_map_pair_consume<interface HashMapConsume<K, V, E>>(pair: HashMapPair<K, V>, env: &E) -> result: unit writes(env) {
  let HashMapPair(key: saved_key, value: saved_value) = move pair;
  HashMapConsume::consume(env: env, key: move saved_key, value: move saved_value);
  return unit;
}

fn hash_map_scan<interface HashMapKey<K, E>, V, F, fn visit(env: &F, key: &K, value: &V) -> result: unit reads(key), reads(value), writes(env), const ceiling: u64>(map: &HashMap<K, V, ceiling>, cursor: u64, limit: u64, key_env: &E, visit_env: &F) -> result: u64 reads(map), reads(key_env), writes(visit_env) contract {
  requires limit > 0_u64;
} {
  doc "Resumable scan. The cursor is a position in the mixed hash space: zero starts a pass, any value is accepted, and the returned cursor continues it, with zero meaning the pass is complete. The call lends to visit every pair whose home is one of up to limit consecutive home buckets, in hash-position order, then returns the position after the last of them. Empty homes count toward the limit, so a call can lend no pair and still advance. A call walks from its first home to the first vacant bucket after its last home, and hashes the pairs of the runs at either end to lend only those whose home it covers; many keys of one home, or keys of adjacent homes that crowd together, lengthen that walk, so the limit is a hint for work, not a cap on pairs. Between calls the map may change in any way: every pair present from the start of a pass to its completion is lent at least once, a pair can be lent again after the bucket count changes or after the map changes, and a pair inserted or removed during the pass may or may not be lent. A pass over an unchanged map lends every pair once. The limit is at least one, so every call that does not finish the pass advances it.";
  let count = map^.cells.inner.len;
  if count == 0_u64 {
    return 0_u64;
  }
  let shift = map^.shift;
  let start = ishr.wrap(cursor, shift);
  if start >= count {
    return 0_u64;
  }
  let rest = count - start;
  let span = rest;
  let end = count;
  if limit < rest {
    set span = limit;
    set end = start + limit;
  }
  let opened = False();
  for @walk (step in 0_u64..count) {
    let index = hash_map_probe(home: start, step: step, count: count);
    let trailing = step >= span;
    let slot = &map^.cells.inner[index];
    match slot^ {
      HashMapVacant() => {
        if trailing {
          break @walk;
        }
        set opened = True();
      }
      HashMapDeleted() => {
      }
      HashMapFilled(key: saved_key, value: saved_value) => {
        let inside = True();
        let leading = bnot(opened);
        let edge = bor(leading, trailing);
        if edge {
          let hash = HashMapKey::hash(env: key_env, key: saved_key);
          let home = hash_map_home(hash: hash, shift: shift, count: count);
          let after_start = home >= start;
          let offset = home -wrap start;
          let before_end = offset < span;
          set inside = band(after_start, before_end);
        }
        if inside {
          visit(env: visit_env, key: saved_key, value: saved_value);
        }
      }
    }
  }
  if end >= count {
    return 0_u64;
  }
  return ishl.wrap(end, shift);
}

fn hash_map_free<interface HashMapConsume<K, V, E>, const ceiling: u64>(map: HashMap<K, V, ceiling>, env: &E) -> result: unit writes(env) {
  let HashMap(cells: storage, length: live, vacated: unused, shift: width) = move map;
  loop @cleanup {
    if storage.inner.len == 0_u64 {
      break @cleanup;
    }
    let slot = take_back(window: &storage.inner);
    match move slot {
      HashMapFilled(key: saved_key, value: saved_value) => {
        HashMapConsume::consume(env: env, key: move saved_key, value: move saved_value);
      }
      HashMapVacant() => {
      }
      HashMapDeleted() => {
      }
    }
  }
  free_empty(window: move storage);
  return unit;
}
