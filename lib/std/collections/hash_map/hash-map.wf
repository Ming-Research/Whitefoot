fn hash_map_extend<K, V, const ceiling: u64>(cells: &Box<Slots<HashMapSlot<K, V>>>, target: u64) -> result: unit writes(cells) contract {
  requires deref(cells).inner.len <= target;
  requires target <= ceiling;
  ensures deref(cells).inner.len == target;
  ensures deref(cells).inner.cap >= target;
} {
  if deref(cells).inner.cap < target {
    grow(cell: cells, capacity: target);
  }
  let start = deref(cells).inner.len;
  for @fill (
    index in start..target,
    invariant filled: deref(cells).inner.len >= index,
    invariant bounded: deref(cells).inner.len <= index,
    invariant spare: deref(cells).inner.cap - deref(cells).inner.len + index >= target
  ) {
    let vacant = HashMapSlot<K, V>::HashMapVacant();
    place_back(window: &deref(cells).inner, value: move vacant);
  }
  invariant complete_min: deref(cells).inner.len >= target;
  invariant complete_max: deref(cells).inner.len <= target;
  return unit;
}

fn hash_map_new<K, V, const ceiling: u64>(capacity: u64) -> result: HashMap<K, V, ceiling> pure contract {
  requires capacity <= ceiling;
} {
  doc "The ceiling is the maximum public capacity: reserve and automatic growth never exceed it. Rebuild can change bucket positions; no stable index or address is promised. Ordinary map semantics require hashing, equality, and their per-call environments to retain one consistent key protocol while entries remain stored, including equal hashes for equivalent keys. These laws are not source-admission prerequisites: ownership safety and finite probe bounds hold even when they are inconsistent, provided callbacks return.";
  let cells = box_slots_new::<HashMapSlot<K, V>>(capacity: capacity);
  hash_map_extend::<K, V, ceiling>(cells: &cells, target: capacity);
  return HashMap<K, V, ceiling>(cells: move cells, length: 0_u64);
}

fn hash_map_len<K, V, const ceiling: u64>(map: &HashMap<K, V, ceiling>) -> length: u64 reads(map) {
  return deref(map).length;
}

fn hash_map_capacity<K, V, const ceiling: u64>(map: &HashMap<K, V, ceiling>) -> capacity: u64 reads(map) {
  doc "Capacity counts the materialized buckets available to probing.";
  return deref(map).cells.inner.len;
}

fn hash_map_probe(home: u64, step: u64, count: u64) -> index: u64 pure contract {
  requires home < count;
  requires step < count;
  ensures index < count;
} {
  let remaining = count - home;
  if step >= remaining {
    let wrapped = step - remaining;
    return wrapped;
  }
  let straight = home + step;
  return straight;
}

fn hash_map_action<interface HashMapKey<K, E>, V>(slot: &HashMapSlot<K, V>, key: &K, env: &E) -> result: HashMapAction reads(slot), reads(key), reads(env) {
  match deref(slot) {
    HashMapVacant() => {
      return HashMapAction::HashMapStop();
    }
    HashMapDeleted() => {
      return HashMapAction::HashMapSkip();
    }
    HashMapFilled(key: saved_key, value: saved_value) => {
      let equal = HashMapKey::equal(env: env, left: saved_key, right: key);
      if equal {
        return HashMapAction::HashMapMatch();
      }
      return HashMapAction::HashMapMiss();
    }
  }
}

fn hash_map_find<interface HashMapKey<K, E>, V, const ceiling: u64>(map: &HashMap<K, V, ceiling>, key: &K, env: &E) -> result: Result<u64, unit> reads(map), reads(key), reads(env) contract {
  ensures when Ok(value: index): index < deref(map).cells.inner.len;
} {
  let hash = HashMapKey::hash(env: env, key: key);
  let count = deref(map).cells.inner.len;
  for (step in 0_u64..count) {
    let home = hash % count;
    let index = hash_map_probe(home: home, step: step, count: count);
    let action = hash_map_action::<HashMapKey<K, E>, V>(slot: &deref(map).cells.inner[index], key: key, env: env);
    match action {
      HashMapMatch() => {
        return Ok<u64, unit>(value: index);
      }
      HashMapStop() => {
        return Err<u64, unit>(error: unit);
      }
      HashMapSkip() => {
      }
      HashMapMiss() => {
      }
    }
  }
  return Err<u64, unit>(error: unit);
}

fn hash_map_lookup<interface HashMapKey<K, E>, V, F, R, fn observe(env: &F, key: &K, value: &V) -> result: R reads(key), reads(value), writes(env), const ceiling: u64>(map: &HashMap<K, V, ceiling>, key: &K, key_env: &E, visit_env: &F) -> result: Result<R, unit> reads(map), reads(key), reads(key_env), writes(visit_env) {
  let hash = HashMapKey::hash(env: key_env, key: key);
  let count = deref(map).cells.inner.len;
  for (step in 0_u64..count) {
    let home = hash % count;
    let index = hash_map_probe(home: home, step: step, count: count);
    let slot = &deref(map).cells.inner[index];
    match deref(slot) {
      HashMapFilled(key: saved_key, value: saved_value) => {
        let equal = HashMapKey::equal(env: key_env, left: saved_key, right: key);
        if equal {
          let observed = observe(env: visit_env, key: saved_key, value: saved_value);
          return Ok<R, unit>(value: move observed);
        }
      }
      HashMapVacant() => {
        return Err<R, unit>(error: unit);
      }
      HashMapDeleted() => {
      }
    }
  }
  return Err<R, unit>(error: unit);
}

fn hash_map_edit<interface HashMapKey<K, E>, V, F, R, fn update(env: &F, key: &K, value: &V) -> result: R reads(key), writes(env), writes(value), const ceiling: u64>(map: &HashMap<K, V, ceiling>, key: &K, key_env: &E, edit_env: &F) -> result: Result<R, unit> reads(key), reads(key_env), writes(map), writes(edit_env) contract {
  ensures deref(map).cells.inner.len == deref(entry(map)).cells.inner.len;
  ensures deref(map).cells.inner.cap == deref(entry(map)).cells.inner.cap;
} {
  let hash = HashMapKey::hash(env: key_env, key: key);
  let count = deref(map).cells.inner.len;
  for (step in 0_u64..count) {
    let home = hash % count;
    let index = hash_map_probe(home: home, step: step, count: count);
    let slot = &deref(map).cells.inner[index];
    match deref(slot) {
      HashMapFilled(key: saved_key, value: saved_value) => {
        let equal = HashMapKey::equal(env: key_env, left: saved_key, right: key);
        if equal {
          let updated = update(env: edit_env, key: saved_key, value: saved_value);
          return Ok<R, unit>(value: move updated);
        }
      }
      HashMapVacant() => {
        return Err<R, unit>(error: unit);
      }
      HashMapDeleted() => {
      }
    }
  }
  return Err<R, unit>(error: unit);
}

fn hash_map_exchange<K, V>(cells: &Box<Slots<HashMapSlot<K, V>>>, index: u64, key: K, value: V) -> result: HashMapPut<K, V> writes(cells) contract {
  requires index < deref(cells).inner.len;
  ensures deref(cells).inner.len == deref(entry(cells)).inner.len;
  ensures deref(cells).inner.cap == deref(entry(cells)).inner.cap;
} {
  doc "Every old variant has ordinary useful behavior: vacant and deleted mean insertion, while filled returns the old complete pair. No vacancy proof is needed to consume the exchanged enum.";
  let offered = HashMapSlot<K, V>::HashMapFilled(key: move key, value: move value);
  swap(first: &deref(cells).inner[index], second: &offered);
  match offered {
    HashMapVacant() => {
      return HashMapPut<K, V>::HashMapInserted();
    }
    HashMapDeleted() => {
      return HashMapPut<K, V>::HashMapInserted();
    }
    HashMapFilled(key: old_key, value: old_value) => {
      let previous = HashMapPair<K, V>(key: move old_key, value: move old_value);
      let replacement_reason = HashMapReturnReason::HashMapReplaced();
      return HashMapPut<K, V>::HashMapReturned(reason: replacement_reason, pair: move previous);
    }
  }
}

fn hash_map_try_put<interface HashMapKey<K, E>, V, const ceiling: u64>(map: &HashMap<K, V, ceiling>, key: K, value: V, env: &E) -> result: HashMapPut<K, V> reads(env), writes(map) contract {
  ensures deref(map).cells.inner.len == deref(entry(map)).cells.inner.len;
  ensures deref(map).cells.inner.cap == deref(entry(map)).cells.inner.cap;
} {
  let hash = HashMapKey::hash(env: env, key: &key);
  let count = deref(map).cells.inner.len;
  let available = count;
  for @probe (step in 0_u64..count) {
    let home = hash % count;
    let index = hash_map_probe(home: home, step: step, count: count);
    let action = hash_map_action::<HashMapKey<K, E>, V>(slot: &deref(map).cells.inner[index], key: &key, env: env);
    match action {
      HashMapMatch() => {
        let replaced = hash_map_exchange::<K, V>(cells: &deref(map).cells, index: index, key: move key, value: move value);
        return move replaced;
      }
      HashMapStop() => {
        if available == count {
          set available = index;
        }
        break @probe;
      }
      HashMapSkip() => {
        if available == count {
          set available = index;
        }
      }
      HashMapMiss() => {
      }
    }
  }
  if available < count {
    let before = deref(map).length;
    if before < ceiling {
      set deref(map).length = before + 1_u64;
      let inserted = hash_map_exchange::<K, V>(cells: &deref(map).cells, index: available, key: move key, value: move value);
      return move inserted;
    }
  }
  let offered = HashMapPair<K, V>(key: move key, value: move value);
  let refusal_reason = HashMapReturnReason::HashMapFull();
  return HashMapPut<K, V>::HashMapReturned(reason: refusal_reason, pair: move offered);
}

fn hash_map_is_available<K, V>(slot: &HashMapSlot<K, V>) -> result: Bool reads(slot) {
  match deref(slot) {
    HashMapVacant() => {
      return True();
    }
    HashMapDeleted() => {
      return True();
    }
    HashMapFilled(key: saved_key, value: saved_value) => {
      return False();
    }
  }
}

fn hash_map_rebuild<interface HashMapKey<K, E>, V, const ceiling: u64>(map: &HashMap<K, V, ceiling>, capacity: u64, env: &E) -> result: Result<unit, unit> reads(env), writes(map) {
  doc "Direct migration keeps the original enum buckets and uses one temporary inline one-slot window for a pending pair. Refusal precedes owner mutation. Every exchange result has useful behavior: Inserted empties the staging window; Replaced and Full restore their complete returned owner for retry. Each attempt hashes the current staged key and probes only occupancy, never equality. With at most the old bucket count of owners and at least that many fresh destinations, each retained owner reaches a vacant bucket in one capacity-bounded scan. No global occupancy fact authorizes a discard or a partial operation. A zero-capacity rebuild is allocation-free. The backing swap does not publish an extent relation under the current proof rules, so this function promises no monotone extent postcondition; subsequent operations read their current bounds.";
  if capacity > ceiling {
    return Err<unit, unit>(error: unit);
  }
  let old_count = deref(map).cells.inner.len;
  if capacity < old_count {
    return Err<unit, unit>(error: unit);
  }
  if capacity == 0_u64 {
    return Ok<unit, unit>(value: unit);
  }
  let previous = box_slots_new::<HashMapSlot<K, V>>(capacity: capacity);
  hash_map_extend::<K, V, ceiling>(cells: &previous, target: capacity);
  swap(first: &deref(map).cells, second: &previous);
  loop @old_cells {
    if previous.inner.len == 0_u64 {
      break @old_cells;
    }
    let slot = take_back(window: &previous.inner);
    match slot {
      HashMapVacant() => {
      }
      HashMapDeleted() => {
      }
      HashMapFilled(key: saved_key, value: saved_value) => {
        let pending = slots_new::<HashMapPair<K, V>, 1>();
        let initial = HashMapPair<K, V>(key: move saved_key, value: move saved_value);
        place_back(window: &pending, value: move initial);
        loop @owner {
          if pending.len == 0_u64 {
            break @owner;
          }
          let hash = HashMapKey::hash(env: env, key: &pending[0_u64].key);
          let count = deref(map).cells.inner.len;
          for @vacancy (step in 0_u64..count) {
            let home = hash % count;
            let index = hash_map_probe(home: home, step: step, count: count);
            let available = hash_map_is_available::<K, V>(slot: &deref(map).cells.inner[index]);
            if available {
              let offered = take_back(window: &pending);
              let HashMapPair(key: offered_key, value: offered_value) = move offered;
              let exchanged = hash_map_exchange::<K, V>(cells: &deref(map).cells, index: index, key: move offered_key, value: move offered_value);
              match exchanged {
                HashMapInserted() => {
                }
                HashMapReturned(reason: returned_reason, pair: returned_pair) => {
                  place_back(window: &pending, value: move returned_pair);
                }
              }
              break @vacancy;
            }
          }
        }
        free_empty(window: move pending);
      }
    }
  }
  free_empty(window: move previous);
  return Ok<unit, unit>(value: unit);
}

fn hash_map_reserve<interface HashMapKey<K, E>, V, const ceiling: u64>(map: &HashMap<K, V, ceiling>, capacity: u64, env: &E) -> result: Result<unit, unit> reads(env), writes(map) {
  if capacity > ceiling {
    return Err<unit, unit>(error: unit);
  }
  if capacity <= deref(map).cells.inner.len {
    return Ok<unit, unit>(value: unit);
  }
  let rebuilt = hash_map_rebuild::<HashMapKey<K, E>, V, ceiling>(map: map, capacity: capacity, env: env);
  return rebuilt;
}

fn hash_map_rehash<interface HashMapKey<K, E>, V, const ceiling: u64>(map: &HashMap<K, V, ceiling>, env: &E) -> result: Result<unit, unit> reads(env), writes(map) {
  let capacity = deref(map).cells.inner.len;
  let rebuilt = hash_map_rebuild::<HashMapKey<K, E>, V, ceiling>(map: map, capacity: capacity, env: env);
  return rebuilt;
}

fn hash_map_put<interface HashMapKey<K, E>, V, const ceiling: u64>(map: &HashMap<K, V, ceiling>, key: K, value: V, env: &E) -> result: HashMapPut<K, V> reads(env), writes(map) {
  let attempted = hash_map_try_put::<HashMapKey<K, E>, V, ceiling>(map: map, key: move key, value: move value, env: env);
  match attempted {
    HashMapInserted() => {
      return HashMapPut<K, V>::HashMapInserted();
    }
    HashMapReturned(reason: returned_reason, pair: returned_pair) => {
      match returned_reason {
        HashMapReplaced() => {
          let replacement_reason = HashMapReturnReason::HashMapReplaced();
          return HashMapPut<K, V>::HashMapReturned(reason: replacement_reason, pair: move returned_pair);
        }
        HashMapFull() => {
          let count = deref(map).cells.inner.len;
          if count >= ceiling {
            let ceiling_reason = HashMapReturnReason::HashMapFull();
            return HashMapPut<K, V>::HashMapReturned(reason: ceiling_reason, pair: move returned_pair);
          }
          let capacity = ceiling;
          if count == 0_u64 {
            set capacity = 1_u64;
          } else if count <= 9223372036854775807_u64 {
            let doubled = count + count;
            if doubled <= ceiling {
              set capacity = doubled;
            }
          }
          let grown = hash_map_reserve::<HashMapKey<K, E>, V, ceiling>(map: map, capacity: capacity, env: env);
          match grown {
            Ok(value: success) => {
              let HashMapPair(key: retry_key, value: retry_value) = move returned_pair;
              let retried = hash_map_try_put::<HashMapKey<K, E>, V, ceiling>(map: map, key: move retry_key, value: move retry_value, env: env);
              return move retried;
            }
            Err(error: refused) => {
              let reserve_reason = HashMapReturnReason::HashMapFull();
              return HashMapPut<K, V>::HashMapReturned(reason: reserve_reason, pair: move returned_pair);
            }
          }
        }
      }
    }
  }
}

fn hash_map_remove<interface HashMapKey<K, E>, V, const ceiling: u64>(map: &HashMap<K, V, ceiling>, key: &K, env: &E) -> result: Option<HashMapPair<K, V>> reads(key), reads(env), writes(map) {
  let before = deref(map).length;
  if before == 0_u64 {
    return None<HashMapPair<K, V>>();
  }
  let found = hash_map_find::<HashMapKey<K, E>, V, ceiling>(map: map, key: key, env: env);
  match found {
    Ok(value: index) => {
      let removed = HashMapSlot<K, V>::HashMapDeleted();
      swap(first: &deref(map).cells.inner[index], second: &removed);
      match removed {
        HashMapFilled(key: saved_key, value: saved_value) => {
          set deref(map).length = before - 1_u64;
          let pair = HashMapPair<K, V>(key: move saved_key, value: move saved_value);
          return Some<HashMapPair<K, V>>(value: move pair);
        }
        HashMapVacant() => {
          return None<HashMapPair<K, V>>();
        }
        HashMapDeleted() => {
          return None<HashMapPair<K, V>>();
        }
      }
    }
    Err(error: missing) => {
      return None<HashMapPair<K, V>>();
    }
  }
}

fn hash_map_each<K, V, E, fn visit(env: &E, key: &K, value: &V) -> result: unit reads(key), reads(value), writes(env), const ceiling: u64>(map: &HashMap<K, V, ceiling>, env: &E) -> result: unit reads(map), writes(env) {
  let count = deref(map).cells.inner.len;
  for (index in 0_u64..count) {
    let slot = &deref(map).cells.inner[index];
    match deref(slot) {
      HashMapFilled(key: saved_key, value: saved_value) => {
        visit(env: env, key: saved_key, value: saved_value);
      }
      HashMapVacant() => {
      }
      HashMapDeleted() => {
      }
    }
  }
  return unit;
}

fn hash_map_pair_consume<interface HashMapConsume<K, V, E>>(pair: HashMapPair<K, V>, env: &E) -> result: unit writes(env) {
  let HashMapPair(key: saved_key, value: saved_value) = move pair;
  HashMapConsume::consume(env: env, key: move saved_key, value: move saved_value);
  return unit;
}

fn hash_map_free<interface HashMapConsume<K, V, E>, const ceiling: u64>(map: HashMap<K, V, ceiling>, env: &E) -> result: unit writes(env) {
  let HashMap(cells: storage, length: live) = move map;
  loop @cleanup {
    if storage.inner.len == 0_u64 {
      break @cleanup;
    }
    let slot = take_back(window: &storage.inner);
    match slot {
      HashMapFilled(key: saved_key, value: saved_value) => {
        HashMapConsume::consume(env: env, key: move saved_key, value: move saved_value);
      }
      HashMapVacant() => {
      }
      HashMapDeleted() => {
      }
    }
  }
  free_empty(window: move storage);
  return unit;
}
