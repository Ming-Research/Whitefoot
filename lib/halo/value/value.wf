  }
}

fn truthy(v: Value) -> r: Bool pure {
  doc "Nil and False are false; every other value is true.";
  match v {
    Nil() => {
      return False();
    }
    False() => {
      return False();
    }
    True() => {
      return True();
    }
    Num(n: x) => {
      return True();
    }
    Str(h: hv) => {
      return True();
    }
    Tab(h: hv) => {
      return True();
    }
    Fun(h: hv) => {
      return True();
    }
    Builtin(id: hid) => {
      return True();
    }
  }
}
