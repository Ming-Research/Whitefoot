  }
  adjustassign(p: p, nvars: nvars, nexps: nexps, e: &e);
  adjustlocals(p: p, n: nvars);
  return unit;
}

fn localfunc(p: &Parser, heap: &Heap) -> result_value: unit writes(p), writes(heap) {
  let h = name(p: p, heap: heap);
