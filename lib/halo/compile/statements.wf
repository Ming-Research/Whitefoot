      set first = nactvar(p: p);
    }
  }
  let arg_171 = nret +wrap 1_i64;
  let i = k_emit(p: p, op: 30_u8, a: first, b: arg_171, c: 0_i64);
  return unit;
}

fn statement(p: &Parser, heap: &Heap) -> result_value: Bool writes(p), writes(heap) {
  let line = p^.lex.line;
  let kind = p^.token.kind;
  if kind == 266_u16 {
    ifstat(p: p, heap: heap, line: line);
  } else if kind == 277_u16 {
    whilestat(p: p, heap: heap, line: line);
  } else if kind == 259_u16 {
    advance(p: p, heap: heap);
    block(p: p, heap: heap);
    match_token(p: p, heap: heap, what: 262_u16, who: 259_u16, where: line);
  } else if kind == 264_u16 {
    forstat(p: p, heap: heap, line: line);
  } else if kind == 272_u16 {
    repeatstat(p: p, heap: heap, line: line);
  } else if kind == 265_u16 {
    funcstat(p: p, heap: heap, line: line);
  } else if kind == 268_u16 {
    advance(p: p, heap: heap);
    if testnext(p: p, heap: heap, kind: 265_u16) {
      localfunc(p: p, heap: heap);
    } else {
      localstat(p: p, heap: heap);
    }
  } else if kind == 273_u16 {
    retstat(p: p, heap: heap);
    return True();
  } else if kind == 258_u16 {
    advance(p: p, heap: heap);
    breakstat(p: p);
    return True();
  } else {
    exprstat(p: p, heap: heap);
  }
  return False();
}

fn chunk(p: &Parser, heap: &Heap) -> result_value: unit writes(p), writes(heap) {
  enterlevel(p: p);
  loop {
    if p^.failed {
      break;
    }
    let arg_172 = p^.token.kind;
    let end = follow(kind: arg_172);
    if end {
      break;
    }
    let last = statement(p: p, heap: heap);
    let semi = testnext(p: p, heap: heap, kind: 59_u16);
    let active = nactvar(p: p);
    set_freereg(p: p, n: active);
    checkbad(p: p);
    if last {
      break;
    }
  }
  leavelevel(p: p);
  return unit;
}
