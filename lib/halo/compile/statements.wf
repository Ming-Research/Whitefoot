fn body(p: &Parser, heap: &Heap, needself: Bool, line: u64) -> result_value: Exp writes(p), writes(heap) {
  doc "CLOSURE captures follow as Move(a: 0, b: local register) or GetUpval(a: 0, u: enclosing upvalue index), in child upvalue order. The VM consumes these pseudo-cells rather than executing them as ordinary register writes.";
  let parent = p^.current;
  let child = p^.funcs.inner.len;
  let fs = new_fs(parent: parent, line: line);
  push_func(buf: &p^.funcs, v: move fs);
  set p^.current = child;
  checknext(p: p, heap: heap, kind: 40_u16);
  if needself {
    literal_local(p: p, heap: heap, word: &local_self[0_u64..4_u64], n: 0_i64);
    adjustlocals(p: p, n: 1_i64);
  }
  let params = 0_i64;
  if p^.token.kind != 41_u16 {
    loop {
      if p^.failed {
        break;
      }
      if p^.token.kind == 285_u16 {
        let h = name(p: p, heap: heap);
        newlocal(p: p, h: h, n: params);
        set params = params +wrap 1_i64;
      } else if p^.token.kind == 279_u16 {
        advance(p: p, heap: heap);
        literal_local(p: p, heap: heap, word: &local_arg[0_u64..3_u64], n: params);
        set params = params +wrap 1_i64;
        let arg_142 = True();
        setvararg(p: p, v: arg_142);
        break;
      } else {
        err_6(p: p);
        break;
      }
      if testnext(p: p, heap: heap, kind: 44_u16) {
      } else {
        break;
      }
    }
  }
  adjustlocals(p: p, n: params);
  let active = nactvar(p: p);
  let var = isvararg(p: p);
  if var {
    let arg_143 = active -wrap 1_i64;
    set_numparams(p: p, n: arg_143);
  } else {
    set_numparams(p: p, n: active);
  }
  k_reserve(p: p, n: active);
  checknext(p: p, heap: heap, kind: 41_u16);
  chunk(p: p, heap: heap);
  match_token(p: p, heap: heap, what: 262_u16, who: 265_u16, where: line);
  let final = k_emit(p: p, op: 30_u8, a: 0_i64, b: 1_i64, c: 0_i64);
  checkbad(p: p);
  set p^.current = parent;
  let arg_144 = cvt.wrap::<u64, i64>(child);
  let i = k_emit(p: p, op: 36_u8, a: 0_i64, b: arg_144, c: 0_i64);
  if child < p^.funcs.inner.len {
    let count = p^.funcs.inner[child].ups.inner.len;
    for (u in 0_u64..count) {
      let d = Up(k: 0_u8, info: 0_i64);
      if child < p^.funcs.inner.len {
        if u < p^.funcs.inner[child].ups.inner.len {
          set d = p^.funcs.inner[child].ups.inner[u];
        }
      }
      let op = 4_u8;
      if d.k == 6_u8 {
        set op = 0_u8;
      }
      let arg_145 = d.info;
      let capture = k_emit(p: p, op: op, a: 0_i64, b: arg_145, c: 0_i64);
    }
  }
  return empty_exp(k: 11_u8, info: i);
}

fn follow(kind: u16) -> result_value: Bool pure {
  if kind == 260_u16 {
    return True();
  }
  if kind == 261_u16 {
    return True();
  }
  if kind == 262_u16 {
    return True();
  }
  if kind == 276_u16 {
    return True();
  }
  return kind == 287_u16;
}

fn block(p: &Parser, heap: &Heap) -> result_value: unit writes(p), writes(heap) {
  let arg_146 = False();
  enterblock(p: p, breakable: arg_146);
  chunk(p: p, heap: heap);
  leaveblock(p: p);
  return unit;
}

fn condition(p: &Parser, heap: &Heap) -> result_value: i64 writes(p), writes(heap) {
  let e = expression(p: p, heap: heap);
  if e.k == 1_u8 {
    set e.k = 3_u8;
  }
  let arg_147 = True();
  k_goif(p: p, e: &e, truth: arg_147);
  return e.f;
}

fn breakstat(p: &Parser) -> result_value: unit writes(p) {
  let id = p^.current;
  let bindex = 0_u64;
  let found = False();
  let upval = False();
  let active = 0_i64;
  if id < p^.funcs.inner.len {
    let n = p^.funcs.inner[id].blocks.inner.len;
    loop {
      if n == 0_u64 {
        break;
      }
      set n = n - 1_u64;
      if n < p^.funcs.inner[id].blocks.inner.len {
        let b = p^.funcs.inner[id].blocks.inner[n];
        if b.breakable {
          set bindex = n;
          set found = True();
          set active = b.nactvar;
          break;
        }
        if b.upval {
          set upval = True();
        }
      }
    }
  }
  if found {
  } else {
    err_5(p: p);
    return unit;
  }
  if upval {
    let i = k_emit(p: p, op: 35_u8, a: active, b: 0_i64, c: 0_i64);
  }
  let j = k_jump(p: p);
  let old = -1_i64;
  if id < p^.funcs.inner.len {
    if bindex < p^.funcs.inner[id].blocks.inner.len {
      set old = p^.funcs.inner[id].blocks.inner[bindex].breaklist;
    }
  }
  let list = k_concat(p: p, l1: old, l2: j);
  if id < p^.funcs.inner.len {
    if bindex < p^.funcs.inner[id].blocks.inner.len {
      set p^.funcs.inner[id].blocks.inner[bindex].breaklist = list;
    }
  }
  return unit;
}

fn whilestat(p: &Parser, heap: &Heap, line: u64) -> result_value: unit writes(p), writes(heap) {
  advance(p: p, heap: heap);
  let start = k_label(p: p);
  let exit = condition(p: p, heap: heap);
  let arg_148 = True();
  enterblock(p: p, breakable: arg_148);
  checknext(p: p, heap: heap, kind: 259_u16);
  block(p: p, heap: heap);
  let j = k_jump(p: p);
  k_patchlist(p: p, list: j, target: start);
  match_token(p: p, heap: heap, what: 262_u16, who: 277_u16, where: line);
  leaveblock(p: p);
  k_patchhere(p: p, list: exit);
  return unit;
}

fn repeatstat(p: &Parser, heap: &Heap, line: u64) -> result_value: unit writes(p), writes(heap) {
  let start = k_label(p: p);
  let arg_149 = True();
  enterblock(p: p, breakable: arg_149);
  let arg_150 = False();
  enterblock(p: p, breakable: arg_150);
  advance(p: p, heap: heap);
  chunk(p: p, heap: heap);
  match_token(p: p, heap: heap, what: 276_u16, who: 272_u16, where: line);
  let exit = condition(p: p, heap: heap);
  let up = False();
  let id = p^.current;
  if id < p^.funcs.inner.len {
    let n = p^.funcs.inner[id].blocks.inner.len;
    if n > 0_u64 {
      let last = n - 1_u64;
      set up = p^.funcs.inner[id].blocks.inner[last].upval;
    }
  }
  if up {
    breakstat(p: p);
    k_patchhere(p: p, list: exit);
    leaveblock(p: p);
    let j = k_jump(p: p);
    k_patchlist(p: p, list: j, target: start);
  } else {
    leaveblock(p: p);
    k_patchlist(p: p, list: exit, target: start);
  }
  leaveblock(p: p);
  return unit;
}

fn exp1(p: &Parser, heap: &Heap) -> result_value: unit writes(p), writes(heap) {
  let e = expression(p: p, heap: heap);
  k_nextreg(p: p, e: &e);
  return unit;
}

fn forbody(p: &Parser, heap: &Heap, base: i64, line: u64, nvars: i64, numeric: Bool) -> result_value: unit writes(p), writes(heap) {
  adjustlocals(p: p, n: 3_i64);
  checknext(p: p, heap: heap, kind: 259_u16);
  let prep = -1_i64;
  if numeric {
    set prep = k_emit(p: p, op: 32_u8, a: base, b: -1_i64, c: 0_i64);
  } else {
    set prep = k_jump(p: p);
  }
  let arg_151 = False();
  enterblock(p: p, breakable: arg_151);
  adjustlocals(p: p, n: nvars);
  k_reserve(p: p, n: nvars);
  block(p: p, heap: heap);
  leaveblock(p: p);
  k_patchhere(p: p, list: prep);
  let endfor = -1_i64;
  if numeric {
    set endfor = k_emit(p: p, op: 31_u8, a: base, b: -1_i64, c: 0_i64);
  } else {
    set endfor = k_emit(p: p, op: 33_u8, a: base, b: 0_i64, c: nvars);
  }
  k_fixline(p: p, line: line);
  if numeric {
    let arg_152 = prep +wrap 1_i64;
    k_patchlist(p: p, list: endfor, target: arg_152);
  } else {
    let j = k_jump(p: p);
    let arg_153 = prep +wrap 1_i64;
    k_patchlist(p: p, list: j, target: arg_153);
  }
  return unit;
}

fn forstat(p: &Parser, heap: &Heap, line: u64) -> result_value: unit writes(p), writes(heap) {
  let arg_154 = True();
  enterblock(p: p, breakable: arg_154);
  advance(p: p, heap: heap);
  let h = name(p: p, heap: heap);
  let base = freereg(p: p);
  let kind = p^.token.kind;
  if kind == 61_u16 {
    literal_local(p: p, heap: heap, word: &local_index[0_u64..11_u64], n: 0_i64);
    literal_local(p: p, heap: heap, word: &local_limit[0_u64..11_u64], n: 1_i64);
    literal_local(p: p, heap: heap, word: &local_step[0_u64..10_u64], n: 2_i64);
    newlocal(p: p, h: h, n: 3_i64);
    checknext(p: p, heap: heap, kind: 61_u16);
    exp1(p: p, heap: heap);
    checknext(p: p, heap: heap, kind: 44_u16);
    exp1(p: p, heap: heap);
    if testnext(p: p, heap: heap, kind: 44_u16) {
      exp1(p: p, heap: heap);
    } else {
      let v = Value::Num(n: 1.0_f64);
      let k = k_addk(p: p, v: v);
      let reg = freereg(p: p);
      let i = k_emit(p: p, op: 1_u8, a: reg, b: k, c: 0_i64);
      k_reserve(p: p, n: 1_i64);
    }
    let arg_155 = True();
    forbody(p: p, heap: heap, base: base, line: line, nvars: 1_i64, numeric: arg_155);
  } else if forlistkind(kind: kind) {
    literal_local(p: p, heap: heap, word: &local_generator[0_u64..15_u64], n: 0_i64);
    literal_local(p: p, heap: heap, word: &local_state[0_u64..11_u64], n: 1_i64);
    literal_local(p: p, heap: heap, word: &local_control[0_u64..13_u64], n: 2_i64);
    newlocal(p: p, h: h, n: 3_i64);
    let nvars = 4_i64;
    loop {
      if testnext(p: p, heap: heap, kind: 44_u16) {
        let next = name(p: p, heap: heap);
        newlocal(p: p, h: next, n: nvars);
        set nvars = nvars +wrap 1_i64;
      } else {
        break;
      }
    }
    checknext(p: p, heap: heap, kind: 267_u16);
    let loopline = p^.lex.line;
    let e = empty_exp(k: 0_u8, info: 0_i64);
    let n = exprlist(p: p, heap: heap, e: &e);
    adjustassign(p: p, nvars: 3_i64, nexps: n, e: &e);
    k_checkstack(p: p, n: 3_i64);
    let arg_156 = nvars -wrap 3_i64;
    let arg_157 = False();
    forbody(p: p, heap: heap, base: base, line: loopline, nvars: arg_156, numeric: arg_157);
  } else {
    err_7(p: p);
  }
  match_token(p: p, heap: heap, what: 262_u16, who: 264_u16, where: line);
  leaveblock(p: p);
  return unit;
}

fn thenblock(p: &Parser, heap: &Heap) -> result_value: i64 writes(p), writes(heap) {
  advance(p: p, heap: heap);
  let exit = condition(p: p, heap: heap);
  checknext(p: p, heap: heap, kind: 274_u16);
  block(p: p, heap: heap);
  return exit;
}

fn ifstat(p: &Parser, heap: &Heap, line: u64) -> result_value: unit writes(p), writes(heap) {
  let escape = -1_i64;
  let flist = thenblock(p: p, heap: heap);
  loop {
    if p^.failed {
      break;
    }
    if p^.token.kind != 261_u16 {
      break;
    }
    let j = k_jump(p: p);
    set escape = k_concat(p: p, l1: escape, l2: j);
    k_patchhere(p: p, list: flist);
    set flist = thenblock(p: p, heap: heap);
  }
  if p^.token.kind == 260_u16 {
    let j = k_jump(p: p);
    set escape = k_concat(p: p, l1: escape, l2: j);
    k_patchhere(p: p, list: flist);
    advance(p: p, heap: heap);
    block(p: p, heap: heap);
  } else {
    set escape = k_concat(p: p, l1: escape, l2: flist);
  }
  k_patchhere(p: p, list: escape);
  match_token(p: p, heap: heap, what: 262_u16, who: 266_u16, where: line);
  return unit;
}

