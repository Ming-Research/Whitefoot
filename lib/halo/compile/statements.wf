fn funcstat(p: &Parser, heap: &Heap, line: u64) -> result_value: unit writes(p), writes(heap) {
  advance(p: p, heap: heap);
  let v = singlevar(p: p, heap: heap);
  loop {
    if p^.failed {
      break;
    }
    if p^.token.kind != 46_u16 {
      break;
    }
    field(p: p, heap: heap, e: &v);
  }
  let self = False();
  if p^.token.kind == 58_u16 {
    set self = True();
    field(p: p, heap: heap, e: &v);
  }
  let b = body(p: p, heap: heap, needself: self, line: line);
  k_store(p: p, var: &v, e: &b);
  k_fixline(p: p, line: line);
  return unit;
}

fn assignment(p: &Parser, heap: &Heap, lhs: &Box<Slots<Exp>>) -> result_value: unit writes(p), writes(heap), writes(lhs) {
  if p^.failed {
    return unit;
  }
  let count = lhs^.inner.len;
  if count == 0_u64 {
    return unit;
  }
  let at = count - 1_u64;
  let v = lhs^.inner[at];
  if v.k < 6_u8 {
    err_4(p: p);
    return unit;
  }
  if v.k > 9_u8 {
    err_4(p: p);
    return unit;
  }
  if testnext(p: p, heap: heap, kind: 44_u16) {
    let next = primary(p: p, heap: heap);
    if next.k == 6_u8 {
      let extra = freereg(p: p);
      let conflict = False();
      for (i in 0_u64..lhs^.inner.len) {
        if lhs^.inner[i].k == 9_u8 {
          if lhs^.inner[i].info == next.info {
            set conflict = True();
            set lhs^.inner[i].info = extra;
          }
          if lhs^.inner[i].aux == next.info {
            set conflict = True();
            set lhs^.inner[i].aux = extra;
          }
        }
      }
      if conflict {
        let arg_161 = next.info;
        let i = k_emit(p: p, op: 0_u8, a: extra, b: arg_161, c: 0_i64);
        k_reserve(p: p, n: 1_i64);
      }
    }
    let limit = 200_u64 -sat p^.depth;
    if count > limit {
      limiterror(p: p, limit: limit, what: 2_u8);
      return unit;
    }
    push_exp(buf: lhs, v: next);
    assignment(p: p, heap: heap, lhs: lhs);
  } else {
    checknext(p: p, heap: heap, kind: 61_u16);
    let e = empty_exp(k: 0_u8, info: 0_i64);
    let nexps = exprlist(p: p, heap: heap, e: &e);
    let nvars = cvt.wrap::<u64, i64>(count);
    if nexps != nvars {
      adjustassign(p: p, nvars: nvars, nexps: nexps, e: &e);
      if nexps > nvars {
        let free = freereg(p: p);
        let arg_162 = free -wrap nexps;
        let arg_163 = arg_162 +wrap nvars;
        set_freereg(p: p, n: arg_163);
      }
    } else {
      k_oneret(p: p, e: &e);
      let var = v;
      if at < lhs^.inner.len {
        set var = lhs^.inner[at];
      }
      k_store(p: p, var: &var, e: &e);
      return unit;
    }
  }
  let reg = freereg(p: p);
  let arg_164 = reg -wrap 1_i64;
  let e = empty_exp(k: 12_u8, info: arg_164);
  let var = v;
  if at < lhs^.inner.len {
    set var = lhs^.inner[at];
  }
  k_store(p: p, var: &var, e: &e);
  return unit;
}

fn exprstat(p: &Parser, heap: &Heap) -> result_value: unit writes(p), writes(heap) {
  let e = primary(p: p, heap: heap);
  if e.k == 13_u8 {
    let arg_165 = e.info;
    let i = k_getins(p: p, pc: arg_165);
    set i.c = 1_i64;
    let arg_166 = e.info;
    k_putins(p: p, pc: arg_166, v: i);
  } else {
    let lhs = box_slots_new::<Exp>(capacity: 0_u64);
    push_exp(buf: &lhs, v: e);
    assignment(p: p, heap: heap, lhs: &lhs);
  }
  return unit;
}

fn retstat(p: &Parser, heap: &Heap) -> result_value: unit writes(p), writes(heap) {
  advance(p: p, heap: heap);
  let first = 0_i64;
  let nret = 0_i64;
  let arg_167 = p^.token.kind;
  let f = follow(kind: arg_167);
  let arg_168 = p^.token.kind == 59_u16;
  if bor(f, arg_168) {
  } else {
    let e = empty_exp(k: 0_u8, info: 0_i64);
    set nret = exprlist(p: p, heap: heap, e: &e);
    let multi = multret(e: &e);
    if multi {
      k_setreturns(p: p, e: &e, n: -1_i64);
      if e.k == 13_u8 {
        if nret == 1_i64 {
          let arg_169 = e.info;
          let i = k_getins(p: p, pc: arg_169);
          set i.op = 29_u8;
          let arg_170 = e.info;
          k_putins(p: p, pc: arg_170, v: i);
        }
      }
      set first = nactvar(p: p);
      set nret = -1_i64;
    } else if nret == 1_i64 {
      set first = k_anyreg(p: p, e: &e);
    } else {
