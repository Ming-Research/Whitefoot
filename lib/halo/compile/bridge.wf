alias Value = pkg::value::Value;
alias Cell = pkg::value::Cell;
alias Proto = pkg::value::Proto;
alias Script = pkg::value::Script;
alias Heap = pkg::heap::Heap;

fn k_getins(p: &Parser, pc: i64) -> result_value: Ins writes(p) {
  let id = p^.current;
  if id < p^.funcs.inner.len {
    set p^.funcs.inner[id].lastline = p^.lastline;
    return getins(s: &p^.funcs.inner[id], pc: pc);
  }
  return Ins(op: 38_u8, a: 0_i64, b: 0_i64, c: 0_i64, line: 0_u64);
}

fn k_putins(p: &Parser, pc: i64, v: Ins) -> result_value: unit writes(p) {
  let id = p^.current;
  if id < p^.funcs.inner.len {
    set p^.funcs.inner[id].lastline = p^.lastline;
    return putins(s: &p^.funcs.inner[id], pc: pc, v: v);
  }
  return unit;
}

fn k_label(p: &Parser) -> result_value: i64 writes(p) {
