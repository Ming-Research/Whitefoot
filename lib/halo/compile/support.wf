alias Value = pkg::value::Value;
alias Cell = pkg::value::Cell;
alias Proto = pkg::value::Proto;
alias Script = pkg::value::Script;
alias Heap = pkg::heap::Heap;

struct Tag {
  tag: u8;
  handle: u32;
  num: f64;
}

struct Exp {
  k: u8;
  info: i64;
  aux: i64;
  num: f64;
  t: i64;
  f: i64;
}

struct Ins {
  op: u8;
  a: i64;
  b: i64;
  c: i64;
  line: u64;
}

struct Up {
  k: u8;
  info: i64;
}

struct Block {
  breaklist: i64;
  nactvar: i64;
  upval: Bool;
  breakable: Bool;
}

struct Fs {
  parent: u64;
  line: u64;
  lastline: u64;
  lasttarget: i64;
  jpc: i64;
  freereg: i64;
  nactvar: i64;
  maxstack: i64;
  numparams: i64;
  nlocals: u64;
  nchildren: u64;
  vararg: Bool;
  code: Box<Slots<Ins>>;
  ks: Box<Slots<Value>>;
  locals: Box<Slots<u32>>;
  ups: Box<Slots<Up>>;
  blocks: Box<Slots<Block>>;
  bad: u8;
}

struct Parser {
  source: Box<Slots<u8>>;
  chunk: Box<Slots<u8>>;
  decoded: Box<Slots<u8>>;
  lookbuf: Box<Slots<u8>>;
  output: Box<Slots<u8>>;
  funcs: Box<Slots<Fs>>;
  current: u64;
  lex: pkg::lex::State;
  token: pkg::lex::Token;
  look: pkg::lex::Token;
  tokenvalue: Value;
  lookvalue: Value;
  haslook: Bool;
  lastline: u64;
  depth: u64;
  failed: Bool;
  errorline: u64;
}

fn push_byte(buf: &Box<Slots<u8>>, v: u8) -> result_value: unit writes(buf) {
  let n = buf^.inner.len;
  let cap = buf^.inner.cap;
  if n == cap {
    let arg_1 = cap +sat cap;
    let target = imax(arg_1, 32_u64);
    grow(cell: buf, capacity: target);
  }
  if buf^.inner.len < buf^.inner.cap {
    place_back(window: &buf^.inner, value: v);
  }
  return unit;
}

