fn push_func(buf: &Box<Slots<Fs>>, v: Fs) -> result_value: unit writes(buf) {
  let n = buf^.inner.len;
  let cap = buf^.inner.cap;
  if n == cap {
    let arg_7 = cap +sat cap;
    let target = imax(arg_7, 32_u64);
    grow(cell: buf, capacity: target);
  }
  if buf^.inner.len < buf^.inner.cap {
    place_back(window: &buf^.inner, value: move v);
  } else {
    let dropped = move v;
  }
  return unit;
}

