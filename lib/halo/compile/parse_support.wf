    text(buf: out, s: &tok_9[0_u64..2_u64]);
    return unit;
  }
  if kind == 267_u16 {
    text(buf: out, s: &tok_10[0_u64..2_u64]);
    return unit;
  }
  if kind == 268_u16 {
    text(buf: out, s: &tok_11[0_u64..5_u64]);
    return unit;
  }
  if kind == 269_u16 {
    text(buf: out, s: &tok_12[0_u64..3_u64]);
    return unit;
  }
  if kind == 270_u16 {
    text(buf: out, s: &tok_13[0_u64..3_u64]);
    return unit;
  }
  if kind == 271_u16 {
    text(buf: out, s: &tok_14[0_u64..2_u64]);
    return unit;
  }
  if kind == 272_u16 {
    text(buf: out, s: &tok_15[0_u64..6_u64]);
    return unit;
  }
  if kind == 273_u16 {
    text(buf: out, s: &tok_16[0_u64..6_u64]);
    return unit;
  }
  if kind == 274_u16 {
    text(buf: out, s: &tok_17[0_u64..4_u64]);
    return unit;
  }
  if kind == 275_u16 {
    text(buf: out, s: &tok_18[0_u64..4_u64]);
    return unit;
  }
  if kind == 276_u16 {
    text(buf: out, s: &tok_19[0_u64..5_u64]);
    return unit;
  }
  if kind == 277_u16 {
    text(buf: out, s: &tok_20[0_u64..5_u64]);
    return unit;
  }
  if kind == 278_u16 {
    text(buf: out, s: &tok_21[0_u64..2_u64]);
    return unit;
  }
  if kind == 279_u16 {
    text(buf: out, s: &tok_22[0_u64..3_u64]);
    return unit;
  }
  if kind == 280_u16 {
    text(buf: out, s: &tok_23[0_u64..2_u64]);
    return unit;
  }
  if kind == 281_u16 {
    text(buf: out, s: &tok_24[0_u64..2_u64]);
