fn clear_bytes(b: &Box<Slots<u8>>) -> result_value: unit writes(b) {
  loop {
    if b^.inner.len == 0_u64 {
      break;
    }
    let v = take_back(window: &b^.inner);
  }
  return unit;
}

fn syntax(p: &Parser, msg: &[u8], near: Bool) -> result_value: unit reads(msg), writes(p) {
  if p^.failed {
    return unit;
  }
  set p^.failed = True();
  set p^.errorline = p^.lex.line;
  let m = slots_new::<u8, 40>();
  let arg_81 = p^.errorline;
  let err = pkg::lex::Error(message: move m, line: arg_81, near_kind: 0_u16, start: 0_u64, end: 0_u64);
  let chunklen = p^.chunk.inner.len;
  pkg::lex::format_error(chunk: &p^.chunk.inner[0_u64..chunklen], error: &err, decoded: &p^.decoded, output: &p^.output);
  let prefix = p^.output.inner.len;
  text(buf: &p^.output, s: msg);
  if near {
    let kind = p^.token.kind;
    if kind == 285_u16 {
      clear_bytes(b: &p^.decoded);
      let start = p^.token.start;
      let end = p^.token.end;
      if start <= end {
        if end <= p^.source.inner.len {
          text(buf: &p^.decoded, s: &p^.source.inner[start..end]);
        }
      }
    } else if kind == 284_u16 {
      clear_bytes(b: &p^.decoded);
      let start = p^.token.start;
      let end = p^.token.end;
      if start <= end {
        if end <= p^.source.inner.len {
          text(buf: &p^.decoded, s: &p^.source.inner[start..end]);
        }
      }
    }
    let m2 = slots_new::<u8, 40>();
    let arg_82 = p^.errorline;
    let arg_83 = p^.token.start;
    let arg_84 = p^.token.end;
    let err2 = pkg::lex::Error(message: move m2, line: arg_82, near_kind: kind, start: arg_83, end: arg_84);
    let suffix = box_slots_new::<u8>(capacity: 0_u64);
    let cn = p^.chunk.inner.len;
    pkg::lex::format_error(chunk: &p^.chunk.inner[0_u64..cn], error: &err2, decoded: &p^.decoded, output: &suffix);
    if prefix <= suffix.inner.len {
      let end = suffix.inner.len;
      text(buf: &p^.output, s: &suffix.inner[prefix..end]);
    }
  }
  return unit;
}

fn err_0(p: &Parser) -> result_value: unit writes(p) {
  let arg_85 = True();
  syntax(p: p, msg: &msg_0[0_u64..17_u64], near: arg_85);
  return unit;
}

