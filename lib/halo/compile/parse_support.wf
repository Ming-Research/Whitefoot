fn expected(p: &Parser, kind: u16) -> result_value: unit writes(p) {
  let out = box_slots_new::<u8>(capacity: 0_u64);
  push_byte(buf: &out, v: 39_u8);
  token_text(kind: kind, out: &out);
  push_byte(buf: &out, v: 39_u8);
  text(buf: &out, s: &str_expected[0_u64..9_u64]);
  let n = out.inner.len;
  let arg_102 = True();
  syntax(p: p, msg: &out.inner[0_u64..n], near: arg_102);
  return unit;
}

fn match_token(p: &Parser, heap: &Heap, what: u16, who: u16, where: u64) -> result_value: unit writes(p), writes(heap) {
  if testnext(p: p, heap: heap, kind: what) {
    return unit;
  }
  if where == p^.lex.line {
    expected(p: p, kind: what);
    return unit;
  }
  let out = box_slots_new::<u8>(capacity: 0_u64);
  push_byte(buf: &out, v: 39_u8);
  token_text(kind: what, out: &out);
  push_byte(buf: &out, v: 39_u8);
  text(buf: &out, s: &str_close[0_u64..20_u64]);
  push_byte(buf: &out, v: 39_u8);
  token_text(kind: who, out: &out);
  push_byte(buf: &out, v: 39_u8);
  text(buf: &out, s: &str_atline[0_u64..9_u64]);
  decimal(buf: &out, n: where);
  push_byte(buf: &out, v: 41_u8);
  let n = out.inner.len;
  let arg_103 = True();
  syntax(p: p, msg: &out.inner[0_u64..n], near: arg_103);
  return unit;
}

fn limiterror(p: &Parser, limit: u64, what: u8) -> result_value: unit writes(p) {
  let out = box_slots_new::<u8>(capacity: 0_u64);
  let l = line(p: p);
  if l == 0_u64 {
    text(buf: &out, s: &str_mainlimit[0_u64..28_u64]);
  } else {
    text(buf: &out, s: &str_funlimit[0_u64..17_u64]);
    decimal(buf: &out, n: l);
    text(buf: &out, s: &str_more[0_u64..15_u64]);
  }
  decimal(buf: &out, n: limit);
  push_byte(buf: &out, v: 32_u8);
  if what == 0_u8 {
    text(buf: &out, s: &str_locals[0_u64..15_u64]);
  } else if what == 1_u8 {
    text(buf: &out, s: &str_upvalues[0_u64..8_u64]);
  } else {
    text(buf: &out, s: &str_assignvars[0_u64..23_u64]);
  }
  let n = out.inner.len;
  let arg_104 = False();
  syntax(p: p, msg: &out.inner[0_u64..n], near: arg_104);
  return unit;
}

fn check_intern(p: &Parser, token: &pkg::lex::Token, v: Value) -> result_value: unit reads(token), writes(p) {
  if token^.kind == 285_u16 {
    let t = tag_value(v: v);
    if t.tag != 4_u8 {
      err_13(p: p);
    }
  } else if token^.kind == 286_u16 {
    let t = tag_value(v: v);
    if t.tag != 4_u8 {
      err_13(p: p);
    }
  }
  return unit;
}

fn token_value(p: &Parser, heap: &Heap, token: &pkg::lex::Token, decoded: &Box<Slots<u8>>) -> result_value: Value reads(p), reads(token), reads(decoded), writes(heap) {
  if token^.kind == 286_u16 {
    let n = decoded^.inner.len;
    return pkg::heap::intern(heap: heap, bytes: &decoded^.inner[0_u64..n]);
  }
  if token^.kind == 285_u16 {
    let start = token^.start;
    let end = token^.end;
    if start <= end {
      if end <= p^.source.inner.len {
        return pkg::heap::intern(heap: heap, bytes: &p^.source.inner[start..end]);
      }
    }
  }
  if token^.kind == 284_u16 {
    let start = token^.start;
    let end = token^.end;
    if start <= end {
      if end <= p^.source.inner.len {
        let number = pkg::number::str2number(bytes: &p^.source.inner[start..end]);
        match number {
          Some(value: x) => {
            return Value::Num(n: x);
          }
          None() => {
          }
        }
      }
    }
  }
  return Value::Nil();
}

fn advance(p: &Parser, heap: &Heap) -> result_value: unit writes(p), writes(heap) {
  checkbad(p: p);
  if p^.failed {
    return unit;
  }
  set p^.lastline = p^.lex.line;
  if p^.haslook {
    set p^.token = p^.look;
    set p^.tokenvalue = p^.lookvalue;
    set p^.haslook = False();
    clear_bytes(b: &p^.decoded);
    let n = p^.lookbuf.inner.len;
    text(buf: &p^.decoded, s: &p^.lookbuf.inner[0_u64..n]);
    return unit;
  }
  let n = p^.source.inner.len;
  let r = pkg::lex::next(source: &p^.source.inner[0_u64..n], state: &p^.lex, decoded: &p^.decoded);
  match move r {
    Ok(value: t) => {
      set p^.token = t;
      let v = token_value(p: p, heap: heap, token: &t, decoded: &p^.decoded);
      set p^.tokenvalue = v;
      check_intern(p: p, token: &t, v: v);
    }
    Err(error: e) => {
      set p^.failed = True();
      set p^.errorline = e.line;
      let cn = p^.chunk.inner.len;
      pkg::lex::format_error(chunk: &p^.chunk.inner[0_u64..cn], error: &e, decoded: &p^.decoded, output: &p^.output);
    }
  }
  return unit;
}

fn lookahead(p: &Parser, heap: &Heap) -> result_value: u16 writes(p), writes(heap) {
  if p^.failed {
    return 287_u16;
  }
  if p^.haslook {
    return p^.look.kind;
  }
  let n = p^.source.inner.len;
  let r = pkg::lex::next(source: &p^.source.inner[0_u64..n], state: &p^.lex, decoded: &p^.lookbuf);
  match move r {
    Ok(value: t) => {
      set p^.look = t;
      let v = token_value(p: p, heap: heap, token: &t, decoded: &p^.lookbuf);
      set p^.lookvalue = v;
      check_intern(p: p, token: &t, v: v);
      set p^.haslook = True();
      return t.kind;
    }
    Err(error: e) => {
      set p^.failed = True();
      set p^.errorline = e.line;
      let cn = p^.chunk.inner.len;
      pkg::lex::format_error(chunk: &p^.chunk.inner[0_u64..cn], error: &e, decoded: &p^.lookbuf, output: &p^.output);
    }
  }
  return 287_u16;
}

fn testnext(p: &Parser, heap: &Heap, kind: u16) -> result_value: Bool writes(p), writes(heap) {
  if p^.failed {
    return False();
  }
  if p^.token.kind == kind {
    advance(p: p, heap: heap);
    return True();
  }
  return False();
}

fn checknext(p: &Parser, heap: &Heap, kind: u16) -> result_value: unit writes(p), writes(heap) {
  if p^.failed {
    return unit;
  }
  if p^.token.kind != kind {
    expected(p: p, kind: kind);
  } else {
    advance(p: p, heap: heap);
  }
  return unit;
}

fn name(p: &Parser, heap: &Heap) -> result_value: u32 writes(p), writes(heap) {
  if p^.token.kind != 285_u16 {
    expected(p: p, kind: 285_u16);
    return 4294967295_u32;
  }
  let arg_105 = p^.tokenvalue;
  let v = tag_value(v: arg_105);
  advance(p: p, heap: heap);
  return v.handle;
}

fn stringexp(p: &Parser, v: Value) -> result_value: Exp writes(p) {
  let k = k_addk(p: p, v: v);
  return empty_exp(k: 4_u8, info: k);
}

fn nameexp(p: &Parser, heap: &Heap) -> result_value: Exp writes(p), writes(heap) {
  let h = name(p: p, heap: heap);
  let v = Value::Str(h: h);
  return stringexp(p: p, v: v);
}

fn newlocal(p: &Parser, h: u32, n: i64) -> result_value: unit writes(p) {
  let active = nactvar(p: p);
  let pos = active +wrap n;
  if pos >= 200_i64 {
    limiterror(p: p, limit: 200_u64, what: 0_u8);
    return unit;
  }
  let owner = p^.current;
  if owner < p^.funcs.inner.len {
    let count = p^.funcs.inner[owner].nlocals;
    if count >= 32767_u64 {
      raw_error(p: p, kind: 12_u8);
      return unit;
    }
    set p^.funcs.inner[owner].nlocals = count + 1_u64;
  }
  if pos < 0_i64 {
    return unit;
  }
  let i = cvt::<i64, u64>(pos);
  let id = p^.current;
  if id < p^.funcs.inner.len {
    let count = p^.funcs.inner[id].locals.inner.len;
    if count == i {
      push_index(buf: &p^.funcs.inner[id].locals, v: h);
    } else if i < count {
      set p^.funcs.inner[id].locals.inner[i] = h;
    }
  }
  return unit;
}

fn literal_local(p: &Parser, heap: &Heap, word: &[u8], n: i64) -> result_value: unit reads(word), writes(p), writes(heap) {
  let v = pkg::heap::intern(heap: heap, bytes: word);
  let t = tag_value(v: v);
  if t.tag != 4_u8 {
    err_13(p: p);
    return unit;
  }
  let arg_106 = t.handle;
  newlocal(p: p, h: arg_106, n: n);
  return unit;
}

fn adjustlocals(p: &Parser, n: i64) -> result_value: unit writes(p) {
  let old = nactvar(p: p);
  let arg_107 = old +wrap n;
  set_nactvar(p: p, n: arg_107);
  return unit;
}

fn enterblock(p: &Parser, breakable: Bool) -> result_value: unit writes(p) {
  let n = nactvar(p: p);
  let arg_108 = False();
  let b = Block(breaklist: -1_i64, nactvar: n, upval: arg_108, breakable: breakable);
  let id = p^.current;
  if id < p^.funcs.inner.len {
    push_block(buf: &p^.funcs.inner[id].blocks, v: b);
  }
  return unit;
}

fn leaveblock(p: &Parser) -> result_value: unit writes(p) {
  let arg_109 = False();
  let arg_110 = False();
  let b = Block(breaklist: -1_i64, nactvar: 0_i64, upval: arg_109, breakable: arg_110);
  let id = p^.current;
  if id < p^.funcs.inner.len {
    if p^.funcs.inner[id].blocks.inner.len > 0_u64 {
      set b = take_back(window: &p^.funcs.inner[id].blocks.inner);
    }
  }
  let arg_111 = b.nactvar;
  set_nactvar(p: p, n: arg_111);
  if b.upval {
    let arg_112 = b.nactvar;
    let i = k_emit(p: p, op: 35_u8, a: arg_112, b: 0_i64, c: 0_i64);
  }
  let arg_113 = b.nactvar;
  set_freereg(p: p, n: arg_113);
  let arg_114 = b.breaklist;
  k_patchhere(p: p, list: arg_114);
  return unit;
}

fn mark_upvalue(p: &Parser, id: u64, level: i64) -> result_value: unit writes(p) {
  if id < p^.funcs.inner.len {
    let n = p^.funcs.inner[id].blocks.inner.len;
    loop {
      if n == 0_u64 {
        break;
      }
      set n = n - 1_u64;
      if n < p^.funcs.inner[id].blocks.inner.len {
        if p^.funcs.inner[id].blocks.inner[n].nactvar <= level {
          set p^.funcs.inner[id].blocks.inner[n].upval = True();
          break;
        }
      }
    }
  }
  return unit;
}

fn resolve(p: &Parser, id: u64, h: u32, base: Bool) -> result_value: Exp writes(p) {
  if id >= p^.funcs.inner.len {
    return empty_exp(k: 8_u8, info: 255_i64);
  }
  let n = p^.funcs.inner[id].nactvar;
  let parent = p^.funcs.inner[id].parent;
  loop {
    if n <= 0_i64 {
      break;
    }
    set n = n -wrap 1_i64;
    let i = cvt.wrap::<i64, u64>(n);
    if id < p^.funcs.inner.len {
      if i < p^.funcs.inner[id].locals.inner.len {
        if p^.funcs.inner[id].locals.inner[i] == h {
          if base {
          } else {
            mark_upvalue(p: p, id: id, level: n);
          }
          return empty_exp(k: 6_u8, info: n);
        }
      }
    }
  }
  let arg_115 = False();
  let v = resolve(p: p, id: parent, h: h, base: arg_115);
  if v.k == 8_u8 {
    return v;
  }
  if id < p^.funcs.inner.len {
    for (i in 0_u64..p^.funcs.inner[id].ups.inner.len) {
      let u = p^.funcs.inner[id].ups.inner[i];
      if u.k == v.k {
        if u.info == v.info {
          let arg_116 = cvt.wrap::<u64, i64>(i);
          return empty_exp(k: 7_u8, info: arg_116);
        }
      }
    }
    let nup = p^.funcs.inner[id].ups.inner.len;
    if nup >= 60_u64 {
      let current = p^.current;
      set p^.current = id;
      limiterror(p: p, limit: 60_u64, what: 1_u8);
      set p^.current = current;
      return empty_exp(k: 7_u8, info: 0_i64);
    }
    let arg_117 = v.k;
    let arg_118 = v.info;
    let u = Up(k: arg_117, info: arg_118);
    push_up(buf: &p^.funcs.inner[id].ups, v: u);
    let arg_119 = cvt.wrap::<u64, i64>(nup);
    return empty_exp(k: 7_u8, info: arg_119);
  }
  return empty_exp(k: 8_u8, info: 255_i64);
}

fn singlevar(p: &Parser, heap: &Heap) -> result_value: Exp writes(p), writes(heap) {
  let h = name(p: p, heap: heap);
  let arg_120 = p^.current;
  let arg_121 = True();
  let e = resolve(p: p, id: arg_120, h: h, base: arg_121);
  if e.k == 8_u8 {
    let v = Value::Str(h: h);
    let k = k_addk(p: p, v: v);
    set e.info = k;
  }
  return e;
}

fn enterlevel(p: &Parser) -> result_value: unit writes(p) {
  set p^.depth = p^.depth +sat 1_u64;
  if p^.depth > 200_u64 {
    err_8(p: p);
  }
  return unit;
}

fn leavelevel(p: &Parser) -> result_value: unit writes(p) {
  if p^.depth > 0_u64 {
    set p^.depth = p^.depth - 1_u64;
  }
  return unit;
}

fn multret(e: &Exp) -> result_value: Bool reads(e) {
  if e^.k == 13_u8 {
    return True();
  }
  return e^.k == 14_u8;
}

fn adjustassign(p: &Parser, nvars: i64, nexps: i64, e: &Exp) -> result_value: unit writes(p), writes(e) {
  let extra = nvars -wrap nexps;
  let multi = multret(e: e);
  if multi {
    set extra = extra +wrap 1_i64;
    if extra < 0_i64 {
      set extra = 0_i64;
    }
    k_setreturns(p: p, e: e, n: extra);
    if extra > 1_i64 {
      let arg_122 = extra -wrap 1_i64;
      k_reserve(p: p, n: arg_122);
    }
  } else {
    if e^.k != 0_u8 {
      k_nextreg(p: p, e: e);
    }
    if extra > 0_i64 {
      let reg = freereg(p: p);
      k_reserve(p: p, n: extra);
      k_nilregs(p: p, from: reg, n: extra);
    }
  }
  return unit;
}
