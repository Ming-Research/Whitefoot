fn raw_error(p: &Parser, kind: u8) -> result_value: unit writes(p) {
  if p^.failed {
    return unit;
  }
  set p^.failed = True();
  set p^.errorline = p^.lex.line;
  clear_bytes(b: &p^.output);
  if kind == 13_u8 {
    text(buf: &p^.output, s: &msg_13[0_u64..17_u64]);
  } else if kind == 12_u8 {
    text(buf: &p^.output, s: &msg_12[0_u64..24_u64]);
  } else {
    text(buf: &p^.output, s: &msg_11[0_u64..23_u64]);
  }
  return unit;
}

fn checkbad(p: &Parser) -> result_value: unit writes(p) {
  let id = p^.current;
  let bad = 0_u8;
  if id < p^.funcs.inner.len {
    set bad = p^.funcs.inner[id].bad;
  }
  if bad == 1_u8 {
    err_9(p: p);
  }
  if bad == 2_u8 {
    err_10(p: p);
  }
  if bad == 3_u8 {
    raw_error(p: p, kind: 11_u8);
  }
  return unit;
}

fn token_text(kind: u16, out: &Box<Slots<u8>>) -> result_value: unit writes(out) {
  if kind < 257_u16 {
    let arg_101 = cvt.wrap::<u16, u8>(kind);
    push_byte(buf: out, v: arg_101);
    return unit;
  }
  if kind == 257_u16 {
    text(buf: out, s: &tok_0[0_u64..3_u64]);
    return unit;
  }
  if kind == 258_u16 {
    text(buf: out, s: &tok_1[0_u64..5_u64]);
    return unit;
  }
