alias Value = pkg::value::Value;

public struct String {
  public readonly hash: u64;
  public readonly bytes: Box<Slots<u8>>;
}

public struct Node {
  doc "PUC Lua 5.1 chained scatter node; next is a node index, or no_handle for NULL.";
  public next: u32;
  public key: Value;
  public val: Value;
}

public struct Table {
  doc "lastfree is the exclusive upper bound of the decreasing free-node scan. An empty node buffer represents PUC's immutable dummy node, with lastfree zero; node_count counts retained keys.";
  public array: Box<Slots<Value>>;
  public nodes: Box<Slots<Node>>;
  public node_count: u32;
  public lastfree: u64;
  public meta: u32;
  public read_only: Bool;
  public flags: u8;
}

public struct Closure {
  public proto: u32;
  public upvals: Box<Slots<u32>>;
}

public enum Upval {
  Open(public slot: u64);
  Closed(public v: Value);
}

public enum TableError {
  NilKey();
  NanKey();
  InvalidNext();
  InvalidTable();
  Overflow();
}

public struct Pair {
  public key: Value;
  public val: Value;
}

public struct StringView {
  public handle: u32;
  public length: u64;
}

public const no_handle: u32 = 4294967295_u32;

public struct StringCell {
  public live: Bool;
  public mark: u32;
  public next_free: u32;
  public payload: String;
}

public struct TableCell {
  public live: Bool;
  public mark: u32;
  public next_free: u32;
  public payload: Table;
}

public struct ClosureCell {
  public live: Bool;
  public mark: u32;
  public next_free: u32;
  public payload: Closure;
}

public struct UpvalCell {
  public live: Bool;
  public mark: u32;
  public next_free: u32;
  public payload: Upval;
}

public struct Heap {
  doc "Slab indices are collector handles; no_handle terminates every free list. Logical accounting estimates: strings 24 plus byte capacity, tables 48 plus 16 per array slot and 32 per node, closures 24 plus 4 per upvalue, upvalues 32. Slab and intern reserve are excluded. limit is retained for the future collector allocation policy.";
  public strings: Box<Slots<StringCell>>;
  public tables: Box<Slots<TableCell>>;
  public closures: Box<Slots<ClosureCell>>;
  public upvalues: Box<Slots<UpvalCell>>;
  public strings_free: u32;
  public tables_free: u32;
  public closures_free: u32;
  public upvalues_free: u32;
  public interned: Box<Slots<u32>>;
  public intern_count: u64;
  public bytes: u64;
  public bytes_since_gc: u64;
  public limit: u64;
}

public fn heap_new(limit: u64) -> r: Heap pure doc "Constructs empty, iteration-friendly slabs and an empty weak intern table.";

public fn alloc_string(heap: &Heap, bytes: &[u8]) -> r: Value reads(bytes), writes(heap) doc "Allocates through canonical interning; equal byte strings retain equal handles. Nil denotes representational exhaustion.";

public fn free_string(heap: &Heap, h: u32) -> r: unit writes(heap) doc "Releases a live string payload, removes its weak intern entry, and links the cell onto strings_free; repeated frees do nothing.";

public fn alloc_table(heap: &Heap, payload: Table) -> r: Option<u32> writes(heap) doc "Allocates a marked, live table cell, resetting its mark to zero; None denotes handle or accounting exhaustion.";

public fn free_table(heap: &Heap, h: u32) -> r: unit writes(heap) doc "Releases table buffers and links a live cell onto tables_free; repeated frees do nothing.";

public fn alloc_closure(heap: &Heap, payload: Closure) -> r: Option<u32> writes(heap) doc "Allocates a closure cell with mark zero; None denotes handle or accounting exhaustion.";

public fn free_closure(heap: &Heap, h: u32) -> r: unit writes(heap) doc "Releases upvalue handles and links a live closure cell onto closures_free; repeated frees do nothing.";

public fn alloc_upvalue(heap: &Heap, payload: Upval) -> r: Option<u32> writes(heap) doc "Allocates an open or closed upvalue with mark zero; None denotes handle or accounting exhaustion.";

public fn free_upvalue(heap: &Heap, h: u32) -> r: unit writes(heap) doc "Replaces a live upvalue with closed Nil and links it onto upvalues_free; repeated frees do nothing.";

public fn new_closure(heap: &Heap, proto: u32, upvals: &[u32]) -> r: Value reads(upvals), writes(heap) doc "Copies the captured handles into a new closure; Nil denotes representational exhaustion.";

public fn new_upvalue(heap: &Heap, value: Upval) -> r: Option<u32> writes(heap) doc "Creates an open or closed upvalue. The VM owns ordering of open upvalues.";

public fn intern(heap: &Heap, bytes: &[u8]) -> r: Value reads(bytes), writes(heap) doc "Returns the canonical Str handle after hash and full byte comparison; Nil denotes representational exhaustion.";

public fn string_of(heap: &Heap, value: Value) -> r: Option<StringView> reads(heap) doc "Returns a live string handle and byte length; readers index the public readonly payload bytes.";

public fn new_table(heap: &Heap, asize: u32, hsize: u32) -> r: Value writes(heap) doc "Allocates a PUC Lua 5.1 array/scatter table, or Nil at representational exhaustion.";

public fn table_get(heap: &Heap, t: Value, key: Value) -> r: Value reads(heap) doc "Raw lookup; absent keys give Nil.";

public fn table_set(heap: &Heap, t: Value, key: Value, val: Value) -> r: Result<unit, TableError> writes(heap) doc "Raw PUC Lua 5.1 assignment, including lookup of retained keys with nil values, Brent relocation and rehash; callers enforce read_only. NilKey, NanKey and InvalidNext mean table index is nil, table index is NaN and invalid key to 'next'.";

public fn table_border(heap: &Heap, t: Value) -> r: u64 reads(heap) doc "Lua 5.1 luaH_getn border.";

public fn table_next(heap: &Heap, t: Value, key: Value) -> r: Result<Option<Pair>, TableError> reads(heap) doc "PUC Lua 5.1 array-index then node-index order. Number, string and boolean keys match Redis Lua; table, closure and builtin keys hash handles instead of PUC addresses. InvalidNext means invalid key to 'next'.";
