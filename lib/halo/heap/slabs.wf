    }
  }
  return None<u32>();
}

fn free_closure(heap: &Heap, h: u32) -> r: unit writes(heap) {
  let i = cvt::<u32, u64>(h);
  if i < heap^.closures.inner.len {
    if heap^.closures.inner[i].live {
      let amount_tail = 4_u64 *sat heap^.closures.inner[i].payload.upvals.inner.cap;
      let amount = 24_u64 +sat amount_tail;
      let b = box_slots_new::<u32>(capacity: 0_u64);
      let empty = Closure(proto: 0_u32, upvals: move b);
      set heap^.closures.inner[i].payload = move empty;
      set heap^.closures.inner[i].live = False();
      set heap^.closures.inner[i].next_free = heap^.closures_free;
      set heap^.closures_free = h;
      uncharge(heap: heap, amount: amount);
    }
  }
  return unit;
}

fn alloc_upvalue(heap: &Heap, payload: Upval) -> r: Option<u32> writes(heap) {
  let amount = 32_u64;
  let h = heap^.upvalues_free;
  let i = cvt::<u32, u64>(h);
  let n = heap^.upvalues.inner.len;
  if i >= n {
    if n >= 4294967295_u64 {
      return None<u32>();
    }
  }
  if charge(heap: heap, amount: amount) {
  } else {
    return None<u32>();
  }
  let live = True();
  let cell = UpvalCell(live: live, mark: 0_u32, next_free: no_handle, payload: payload);
  if i < heap^.upvalues.inner.len {
    let next = heap^.upvalues.inner[i].next_free;
    set heap^.upvalues_free = next;
    set heap^.upvalues.inner[i] = cell;
    return Some<u32>(value: h);
  } else if n < 4294967295_u64 {
    let hnew = cvt::<u64, u32>(n);
    let needed = n + 1_u64;
    let oldcap = heap^.upvalues.inner.cap;
    if needed > oldcap {
      let capacity = needed;
      if oldcap <= 2147483647_u64 {
        let doubled = oldcap * 2_u64;
        if doubled > capacity {
          set capacity = doubled;
        }
      } else {
        set capacity = 4294967295_u64;
      }
      grow(cell: &heap^.upvalues, capacity: capacity);
    }
    if heap^.upvalues.inner.len < heap^.upvalues.inner.cap {
      place_back(window: &heap^.upvalues.inner, value: cell);
      return Some<u32>(value: hnew);
    }
  }
  return None<u32>();
}

fn free_upvalue(heap: &Heap, h: u32) -> r: unit writes(heap) {
  let i = cvt::<u32, u64>(h);
  if i < heap^.upvalues.inner.len {
    if heap^.upvalues.inner[i].live {
      let amount = 32_u64;
      let v = Value::Nil();
      let empty = Upval::Closed(v: v);
      set heap^.upvalues.inner[i].payload = empty;
      set heap^.upvalues.inner[i].live = False();
      set heap^.upvalues.inner[i].next_free = heap^.upvalues_free;
      set heap^.upvalues_free = h;
      uncharge(heap: heap, amount: amount);
    }
  }
  return unit;
}

fn new_closure(heap: &Heap, proto: u32, upvals: &[u32]) -> r: Value reads(upvals), writes(heap) {
  let b = box_slots_new::<u32>(capacity: upvals^.len);
  for (i in 0_u64..upvals^.len) {
    if b.inner.len < b.inner.cap {
      place_back(window: &b.inner, value: upvals^[i]);
    }
  }
  let c = Closure(proto: proto, upvals: move b);
  match alloc_closure(heap: heap, payload: move c) {
    Some(value: h) => {
      return Value::Fun(h: h);
    }
    None() => {
      return Value::Nil();
    }
  }
}

fn new_upvalue(heap: &Heap, value: Upval) -> r: Option<u32> writes(heap) {
  return alloc_upvalue(heap: heap, payload: value);
}

fn table_bytes(array: u64, nodes: u64) -> r: u64 pure {
  let a = 16_u64 *sat array;
  let n = 32_u64 *sat nodes;
  let total = a +sat n;
  return total +sat 48_u64;
}
