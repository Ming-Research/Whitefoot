alias Inputs = std::process::Inputs;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias InputStream = std::io::InputStream;
alias OutputStream = std::io::OutputStream;

fn read_exact(factory: &HandleFactory, input: &InputStream, bytes: &[u8], count: u64) -> complete: Bool writes(factory), writes(input), writes(bytes) waits contract {
  requires count <= bytes^.len;
} {
  let position = 0_u64;
  loop @read {
    if position >= count {
      return True();
    }
    let deadline = None<std::time::Instant>();
    match std::io::read_next(factory: factory, input: input, destination: bytes, start: position, end: count, deadline: deadline) {
      Ok(value: next) => {
        if next == position {
          return False();
        }
        set position = next;
      }
      Err(error: problem) => {
        return False();
      }
    }
  }
  return False();
}

fn word(bytes: &[u8], start: u64) -> value: u64 reads(bytes) {
  let value = 0_u64;
  for (offset in 0_u64..8_u64) {
    let index = start +wrap offset;
    if index < bytes^.len {
      let byte = bytes^[index];
      let wide = cvt::<u8, u64>(byte);
      let distance = offset *wrap 8_u64;
      let shift = cvt.wrap::<u64, u32>(distance);
      let part = ishl.wrap(wide, shift);
      set value = ior(value, part);
    }
  }
  return value;
}

fn bits_text(value: f64, out: &[u8]) -> count: u64 writes(out) contract {
  requires out^.len >= 16_u64;
} {
  let bits = reinterpret::<f64, u64>(value);
  for (index in 0_u64..16_u64) {
    let distance = 15_u64 - index;
    let scaled = distance * 4_u64;
    let shift = cvt.wrap::<u64, u32>(scaled);
    let shifted = ishr.wrap(bits, shift);
    let low = iand(shifted, 15_u64);
    let narrow = cvt.wrap::<u64, u8>(low);
    let glyph = narrow +wrap 48_u8;
    if low >= 10_u64 {
      set glyph = narrow +wrap 87_u8;
    }
    set out^[index] = glyph;
  }
  return 16_u64;
}

fn emit(factory: &HandleFactory, output: &OutputStream, bytes: &[u8], count: u64) -> complete: Bool reads(bytes), writes(factory), writes(output) waits contract {
  requires count <= bytes^.len;
} {
  let position = 0_u64;
  loop @write {
    if position >= count {
      return True();
    }
    let deadline = None<std::time::Instant>();
    match std::io::write_once(factory: factory, output: output, source: bytes, start: position, end: count, deadline: deadline) {
      Ok(value: next) => {
        if next == position {
          return False();
        }
        set position = next;
      }
      Err(error: problem) => {
        return False();
      }
    }
  }
  return False();
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: factory, stdin: input, clock: clock, wall_clock: wall_clock) = move inputs;
  let std::fs::Directory(read: directory, write: writable) = move cwd;
  std::fs::close_directory_write(factory: &factory, directory: move writable);
  std::fs::close_directory(factory: &factory, directory: move directory);
  let header = array_filled::<u8, 17>(value: 0_u8);
  let payload = array_filled::<u8, 2048>(value: 0_u8);
  let text = array_filled::<u8, 64>(value: 0_u8);
  loop @records {
    let received = read_exact(factory: &factory, input: &input, bytes: &header[0_u64..17_u64], count: 17_u64);
    if received {
    } else {
      return std::process::exit_status(code: 1_u8);
    }
    let op = header[0_u64];
    if op == 0_u8 {
      return std::process::exit_status(code: 0_u8);
    }
    let xbits = word(bytes: &header[0_u64..17_u64], start: 1_u64);
    let ybits = word(bytes: &header[0_u64..17_u64], start: 9_u64);
    let x = reinterpret::<u64, f64>(xbits);
    let y = reinterpret::<u64, f64>(ybits);
    let count = 0_u64;
    if op == 1_u8 {
      set count = halo::number::format_number(value: x, out: &text[0_u64..32_u64]);
    } else if op == 2_u8 {
      if xbits > 2048_u64 {
        return std::process::exit_status(code: 2_u8);
      }
      let read = read_exact(factory: &factory, input: &input, bytes: &payload[0_u64..2048_u64], count: xbits);
      if read {
      } else {
        return std::process::exit_status(code: 1_u8);
      }
      match halo::number::str2number(bytes: &payload[0_u64..xbits]) {
        Some(value: number) => {
          set count = bits_text(value: number, out: &text[0_u64..64_u64]);
        }
        None() => {
          set text[0_u64] = 110_u8;
          set text[1_u64] = 105_u8;
          set text[2_u64] = 108_u8;
          set count = 3_u64;
        }
      }
    } else if op == 3_u8 {
      let result = halo::number::pow(a: x, b: y);
      set count = bits_text(value: result, out: &text[0_u64..64_u64]);
    } else if op == 4_u8 {
      let result = halo::number::fmod(a: x, b: y);
      set count = bits_text(value: result, out: &text[0_u64..64_u64]);
    } else if op == 5_u8 {
      let result = halo::number::floor(value: x);
      set count = bits_text(value: result, out: &text[0_u64..64_u64]);
    } else if op == 6_u8 {
      let result = halo::number::ceil(value: x);
      set count = bits_text(value: result, out: &text[0_u64..64_u64]);
    } else {
      return std::process::exit_status(code: 2_u8);
    }
    if count < 64_u64 {
      set text[count] = 10_u8;
      let length = count + 1_u64;
      let sent = emit(factory: &factory, output: &out, bytes: &text[0_u64..64_u64], count: length);
      if sent {
      } else {
        return std::process::exit_status(code: 1_u8);
      }
    } else {
      return std::process::exit_status(code: 2_u8);
    }
  }
  return std::process::exit_status(code: 1_u8);
}
