const format_decimal_shifts: Array<u64, 19> =[0_u64, 3_u64, 6_u64, 9_u64, 13_u64, 16_u64, 19_u64, 23_u64, 26_u64, 29_u64, 33_u64, 36_u64, 39_u64, 43_u64, 46_u64, 49_u64, 53_u64, 56_u64, 59_u64];

const format_infinity_bits: u64 = 9218868437227405312_u64;

const format_hidden_bit: u64 = 4503599627370496_u64;

const format_fraction_mask: u64 = 4503599627370495_u64;

struct FormatDecimal {
  doc "A nonnegative decimal, 0.d1d2d3... times 10^point: count digits, one per byte, most significant first and with no trailing zero. Only the first 800 are held, more than the 768 a double's halfway point needs; truncated records that a nonzero digit past them was dropped, which can only decide a tie.";
  digits: Array<u8, 800>;
  count: u64;
  point: i64;
  truncated: Bool;
}

fn format_digit_at(decimal: &FormatDecimal, index: u64) -> digit: u8 reads(decimal) {
  doc "The digit at a position, or zero past the digits the decimal holds.";
  if index < decimal^.count {
    if index < decimal^.digits.len {
      return decimal^.digits[index];
    }
  }
  return 0_u8;
}

fn format_put_digit(decimal: &FormatDecimal, index: u64, digit: u8) -> result: unit writes(decimal) {
  doc "Writes a digit at a position within the 800 a decimal holds; its count is the caller's to set.";
  if index < decimal^.digits.len {
    set decimal^.digits[index] = digit;
  }
  return unit;
}

fn format_add_digit(decimal: &FormatDecimal, digit: u8) -> result: unit writes(decimal) {
  doc "Appends a digit, or notes a nonzero one past the 800 held as truncated.";
  let count = decimal^.count;
  if count < 800_u64 {
    format_put_digit(decimal: decimal, index: count, digit: digit);
    set decimal^.count = count +wrap 1_u64;
  } else if digit != 0_u8 {
    set decimal^.truncated = True();
  }
  return unit;
}

fn format_trim(decimal: &FormatDecimal) -> result: unit writes(decimal) {
  doc "Drops trailing zero digits.";
  loop @zeros {
    let count = decimal^.count;
    if count == 0_u64 {
      break @zeros;
    }
    let last = count -wrap 1_u64;
    let digit = format_digit_at(decimal: decimal, index: last);
    if digit != 0_u8 {
      break @zeros;
    }
    set decimal^.count = last;
  }
  return unit;
}

fn format_left_shift(decimal: &FormatDecimal, shift: u64) -> result: unit writes(decimal) {
  doc "Multiplies the decimal by 2^shift, for a shift from 1 to 60, exactly but for digits past the 800 held, whose nonzero ones are noted. The digits are multiplied from the last, each product and carry below 10 times 2^60, written out in reverse and then copied back in order.";
  let count = decimal^.count;
  if count == 0_u64 {
    return unit;
  }
  let amount = cvt.wrap::<u64, u32>(shift);
  let reversed = array_filled::<u8, 832>(value: 0_u8);
  let produced = 0_u64;
  let carry = 0_u64;
  for @digits (step in 0_u64..count) {
    let back = count -wrap step;
    let index = back -wrap 1_u64;
    let digit = format_digit_at(decimal: decimal, index: index);
    let wide = cvt::<u8, u64>(digit);
    let scaled = ishl.wrap(wide, amount);
    let sum = carry +wrap scaled;
    let low = sum % 10_u64;
    let narrow = cvt.wrap::<u64, u8>(low);
    if produced < reversed.len {
      set reversed[produced] = narrow;
    }
    set produced = produced +wrap 1_u64;
    set carry = sum / 10_u64;
  }
  loop @carrying {
    if carry == 0_u64 {
      break @carrying;
    }
    let rest = carry % 10_u64;
    let leading = cvt.wrap::<u64, u8>(rest);
    if produced < reversed.len {
      set reversed[produced] = leading;
    }
    set produced = produced +wrap 1_u64;
    set carry = carry / 10_u64;
  }
  let kept = imin(produced, 800_u64);
  for @copying (position in 0_u64..kept) {
    let remaining = produced -wrap position;
    let from = remaining -wrap 1_u64;
    let copied = 0_u8;
    if from < reversed.len {
      set copied = reversed[from];
    }
    format_put_digit(decimal: decimal, index: position, digit: copied);
  }
  let dropped = produced -wrap kept;
  for @dropping (low_index in 0_u64..dropped) {
    if low_index < reversed.len {
      let lost = reversed[low_index];
      if lost != 0_u8 {
        set decimal^.truncated = True();
      }
    }
  }
  let added = produced -wrap count;
  let raise = cvt.wrap::<u64, i64>(added);
  let point = decimal^.point;
  set decimal^.point = point +wrap raise;
  set decimal^.count = kept;
  format_trim(decimal: decimal);
  return unit;
}

fn format_right_shift(decimal: &FormatDecimal, shift: u64) -> result: unit writes(decimal) {
  doc "Divides the decimal by 2^shift, for a shift from 1 to 60, exactly but for digits past the 800 held, whose nonzero ones are noted. Digits are read into a running value below 10 times 2^60 until it reaches 2^shift, then each step writes the value's quotient by 2^shift as a digit, behind the one read, and carries its remainder.";
  let count = decimal^.count;
  let amount = cvt.wrap::<u64, u32>(shift);
  let read = 0_u64;
  let written = 0_u64;
  let value = 0_u64;
  loop @leading {
    let high = ishr.wrap(value, amount);
    if high != 0_u64 {
      break @leading;
    }
    if read < count {
      let digit = format_digit_at(decimal: decimal, index: read);
      let wide = cvt::<u8, u64>(digit);
      let tens = value *wrap 10_u64;
      set value = tens +wrap wide;
      set read = read +wrap 1_u64;
    } else if value == 0_u64 {
      set decimal^.count = 0_u64;
      return unit;
    } else {
      loop @scaling {
        let top = ishr.wrap(value, amount);
        if top != 0_u64 {
          break @scaling;
        }
        set value = value *wrap 10_u64;
        set read = read +wrap 1_u64;
      }
      break @leading;
    }
  }
  let moved = cvt.wrap::<u64, i64>(read);
  let point = decimal^.point;
  let lowered = point -wrap moved;
  set decimal^.point = lowered +wrap 1_i64;
  let unit_bit = ishl.wrap(1_u64, amount);
  let mask = unit_bit -wrap 1_u64;
  loop @middle {
    if read >= count {
      break @middle;
    }
    let quotient = ishr.wrap(value, amount);
    let rest = iand(value, mask);
    let next = format_digit_at(decimal: decimal, index: read);
    let next_wide = cvt::<u8, u64>(next);
    let rest_tens = rest *wrap 10_u64;
    set value = rest_tens +wrap next_wide;
    set read = read +wrap 1_u64;
    let narrow = cvt.wrap::<u64, u8>(quotient);
    format_put_digit(decimal: decimal, index: written, digit: narrow);
    set written = written +wrap 1_u64;
  }
  loop @tail {
    if value == 0_u64 {
      break @tail;
    }
    let tail_quotient = ishr.wrap(value, amount);
    let tail_rest = iand(value, mask);
    set value = tail_rest *wrap 10_u64;
    let tail_digit = cvt.wrap::<u64, u8>(tail_quotient);
    if written < 800_u64 {
      format_put_digit(decimal: decimal, index: written, digit: tail_digit);
      set written = written +wrap 1_u64;
    } else if tail_digit != 0_u8 {
      set decimal^.truncated = True();
    }
  }
  set decimal^.count = written;
  format_trim(decimal: decimal);
  return unit;
}

fn format_decimal_from(value: u64) -> made: FormatDecimal pure {
  doc "A decimal holding a nonzero integer.";
  let digits = array_filled::<u8, 800>(value: 0_u8);
  let exact = False();
  let made = FormatDecimal(digits: digits, count: 0_u64, point: 0_i64, truncated: exact);
  let length = 0_u64;
  let rest = value;
  loop @counting {
    set length = length +wrap 1_u64;
    set rest = rest / 10_u64;
    if rest == 0_u64 {
      break @counting;
    }
  }
  set rest = value;
  for @filling (step in 0_u64..length) {
    let back = length -wrap step;
    let index = back -wrap 1_u64;
    let low = rest % 10_u64;
    let digit = cvt.wrap::<u64, u8>(low);
    format_put_digit(decimal: &made, index: index, digit: digit);
    set rest = rest / 10_u64;
  }
  set made.count = length;
  set made.point = cvt.wrap::<u64, i64>(length);
  format_trim(decimal: &made);
  return made;
}

fn format_round_significant(decimal: &FormatDecimal, kept: u64) -> result: unit writes(decimal) {
  doc "Rounds the decimal to kept significant digits, at least one, with ties to even, as printf rounds an exact value.";
  let count = decimal^.count;
  if count <= kept {
    return unit;
  }
  if kept == 0_u64 {
    return unit;
  }
  let next = format_digit_at(decimal: decimal, index: kept);
  let last_index = kept -wrap 1_u64;
  let last = format_digit_at(decimal: decimal, index: last_index);
  let up = next > 5_u8;
  if next == 5_u8 {
    let after = kept +wrap 1_u64;
    let beyond = count > after;
    let odd_digit = iand(last, 1_u8);
    let odd = odd_digit == 1_u8;
    let tail = bor(beyond, decimal^.truncated);
    set up = bor(tail, odd);
  }
  set decimal^.count = kept;
  if up {
    let index = kept;
    loop @carry {
      if index == 0_u64 {
        format_put_digit(decimal: decimal, index: 0_u64, digit: 1_u8);
        set decimal^.count = 1_u64;
        let point = decimal^.point;
        set decimal^.point = point +wrap 1_i64;
        break @carry;
      }
      set index = index -wrap 1_u64;
      let digit = format_digit_at(decimal: decimal, index: index);
      if digit < 9_u8 {
        let raised = digit +wrap 1_u8;
        format_put_digit(decimal: decimal, index: index, digit: raised);
        break @carry;
      }
      format_put_digit(decimal: decimal, index: index, digit: 0_u8);
    }
  }
  format_trim(decimal: decimal);
  return unit;
}
