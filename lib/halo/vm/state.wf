    }
    if k == 3_u8 {
      return raise_text(vm: vm, text: &state_text_2[0_u64..47_u64]);
    }
    if k == 4_u8 {
      return raise_text(vm: vm, text: &state_text_3[0_u64..46_u64]);
    }
    return raise_text(vm: vm, text: &state_text_4[0_u64..49_u64]);
  }
  if op == 1_u8 {
    if k == 0_u8 {
      return raise_text(vm: vm, text: &state_text_5[0_u64..28_u64]);
    }
    if k == 1_u8 {
      return raise_text(vm: vm, text: &state_text_6[0_u64..32_u64]);
    }
    if k == 2_u8 {
      return raise_text(vm: vm, text: &state_text_7[0_u64..31_u64]);
    }
    if k == 3_u8 {
      return raise_text(vm: vm, text: &state_text_8[0_u64..31_u64]);
    }
    return raise_text(vm: vm, text: &state_text_9[0_u64..33_u64]);
  }
  if op == 2_u8 {
    if k == 0_u8 {
      return raise_text(vm: vm, text: &state_text_10[0_u64..27_u64]);
    }
    if k == 1_u8 {
      return raise_text(vm: vm, text: &state_text_11[0_u64..31_u64]);
    }
    if k == 2_u8 {
      return raise_text(vm: vm, text: &state_text_12[0_u64..30_u64]);
    }
    if k == 3_u8 {
      return raise_text(vm: vm, text: &state_text_13[0_u64..30_u64]);
    }
    return raise_text(vm: vm, text: &state_text_14[0_u64..29_u64]);
  }
  if op == 3_u8 {
    if k == 0_u8 {
      return raise_text(vm: vm, text: &state_text_15[0_u64..34_u64]);
    }
    if k == 1_u8 {
      return raise_text(vm: vm, text: &state_text_16[0_u64..38_u64]);
    }
    if k == 2_u8 {
      return raise_text(vm: vm, text: &state_text_17[0_u64..37_u64]);
    }
    if k == 4_u8 {
      return raise_text(vm: vm, text: &state_text_18[0_u64..36_u64]);
    }
    return raise_text(vm: vm, text: &state_text_19[0_u64..39_u64]);
  }
  if k == 0_u8 {
    return raise_text(vm: vm, text: &state_text_20[0_u64..36_u64]);
  }
  if k == 1_u8 {
    return raise_text(vm: vm, text: &state_text_21[0_u64..40_u64]);
  }
  if k == 2_u8 {
    return raise_text(vm: vm, text: &state_text_22[0_u64..39_u64]);
  }
  return raise_text(vm: vm, text: &state_text_23[0_u64..41_u64]);
}

fn coerce_number(vm: &Vm, v: Value) -> r: pkg::value::NumView reads(vm) {
  match num_of(v: v) {
    Is(x: bound_x_1) => {
      return pkg::value::NumView::Is(x: bound_x_1);
    }
    Not() => {
    }
  }
  match str_of(v: v) {
    Handle(h: bound_h_2) => {
      let i = cvt::<u32, u64>(bound_h_2);
      if i < vm^.heap.strings.inner.len {
        let n = vm^.heap.strings.inner[i].payload.bytes.inner.len;
        match pkg::number::str2number(bytes: &vm^.heap.strings.inner[i].payload.bytes.inner[0_u64..n]) {
          Some(value: x) => {
            return pkg::value::NumView::Is(x: x);
          }
          None() => {
          }
        }
      }
    }
    NoHandle() => {
    }
  }
  return pkg::value::NumView::Not();
}

fn coerce_string(vm: &Vm, v: Value) -> r: Value writes(vm) {
  match num_of(v: v) {
    Is(x: bound_x_3) => {
      let bytes = array_filled::<u8, 32>(value: 0_u8);
      let n = pkg::number::format_number(value: bound_x_3, out: &bytes[0_u64..32_u64]);
      return intern(heap: &vm^.heap, bytes: &bytes[0_u64..n]);
    }
    Not() => {
      return v;
    }
  }
}

fn upvalue_handle(vm: &Vm, u: u8) -> r: Option<u32> reads(vm) {
  let n = vm^.frames.inner.len;
  if n > 0_u64 {
    let f = n - 1_u64;
    let cl = cvt::<u32, u64>(vm^.frames.inner[f].closure);
    if cl < vm^.heap.closures.inner.len {
      let i = cvt::<u8, u64>(u);
      if i < vm^.heap.closures.inner[cl].payload.upvals.inner.len {
        let h = vm^.heap.closures.inner[cl].payload.upvals.inner[i];
        return Some<u32>(value: h);
      }
    }
  }
  return None<u32>();
}

fn read_upvalue(vm: &Vm, stack: &Box<Slots<Value>>, h: u32) -> r: Value reads(vm), reads(stack) {
  let i = cvt::<u32, u64>(h);
  if i < vm^.heap.upvalues.inner.len {
    match vm^.heap.upvalues.inner[i].payload {
      Open(slot: s) => {
        let j = s^;
        if j < stack^.inner.len {
          return stack^.inner[j];
        }
      }
      Closed(v: bound_v_3) => {
        return bound_v_3^;
      }
    }
  }
  return Value::Nil();
}

fn write_upvalue(vm: &Vm, stack: &Box<Slots<Value>>, h: u32, v: Value) -> r: unit writes(vm), writes(stack) contract {
  ensures stack^.inner.len == entry(stack)^.inner.len;
} {
  let i = cvt::<u32, u64>(h);
  if i < vm^.heap.upvalues.inner.len {
    match vm^.heap.upvalues.inner[i].payload {
      Open(slot: s) => {
        let j = s^;
        if j < stack^.inner.len {
          set stack^.inner[j] = v;
        }
      }
      Closed(..) => {
        set vm^.heap.upvalues.inner[i].payload = Upval::Closed(v: v);
      }
    }
  }
  return unit;
}

fn capture(vm: &Vm, slot: u64) -> r: Option<u32> writes(vm) {
  let at = vm^.open_upvalues.inner.len;
  for (i in 0_u64..vm^.open_upvalues.inner.len) {
    if i < vm^.open_upvalues.inner.len {
      let h = vm^.open_upvalues.inner[i];
      let j = cvt::<u32, u64>(h);
      if j < vm^.heap.upvalues.inner.len {
        match vm^.heap.upvalues.inner[j].payload {
          Open(slot: s) => {
            if s^ == slot {
              return Some<u32>(value: h);
            }
            if s^ < slot {
              if i < at {
                set at = i;
              }
            }
          }
          Closed(..) => {
          }
        }
      }
    }
  }
  let uv = Upval::Open(slot: slot);
  match pkg::heap::new_upvalue(heap: &vm^.heap, value: uv) {
    None() => {
      return None<u32>();
    }
    Some(value: h) => {
      let n = vm^.open_upvalues.inner.len;
      if n < unlimited {
        if n == vm^.open_upvalues.inner.cap {
          let cap = n + 1_u64;
          grow(cell: &vm^.open_upvalues, capacity: cap);
        }
        if at <= vm^.open_upvalues.inner.len {
          if vm^.open_upvalues.inner.len < vm^.open_upvalues.inner.cap {
            insert_at(window: &vm^.open_upvalues.inner, index: at, value: h);
            return Some<u32>(value: h);
          }
        }
      }
    }
  }
  return None<u32>();
}

fn close_upvalues(vm: &Vm, stack: &Box<Slots<Value>>, level: u64) -> r: unit reads(stack), writes(vm) {
  loop {
    if vm^.open_upvalues.inner.len == 0_u64 {
      break;
    }
    let h = vm^.open_upvalues.inner[0_u64];
    let i = cvt::<u32, u64>(h);
    if i < vm^.heap.upvalues.inner.len {
      match vm^.heap.upvalues.inner[i].payload {
        Open(slot: s) => {
          let j = s^;
          if j < level {
            break;
          }
          let v = Value::Nil();
          if j < stack^.inner.len {
            set v = stack^.inner[j];
          }
          set vm^.heap.upvalues.inner[i].payload = Upval::Closed(v: v);
        }
        Closed(..) => {
        }
      }
    }
    if vm^.open_upvalues.inner.len > 0_u64 {
      let removed = remove_at(window: &vm^.open_upvalues.inner, index: 0_u64);
    }
  }
  return unit;
}

fn reset(vm: &Vm, stack: &Box<Slots<Value>>) -> r: unit writes(stack), writes(vm) {
  loop {
    if vm^.library_contexts.inner.len == 0_u64 {
      break;
    }
    let discarded = take_back(window: &vm^.library_contexts.inner);
  }
  loop {
    if vm^.sort_frames.inner.len == 0_u64 {
      break;
    }
    let discarded = take_back(window: &vm^.sort_frames.inner);
  }
  if vm^.suspended {
    restore_stopped_stack(vm: vm, stack: stack);
  }
  set vm^.suspended = False();
  loop {
    if vm^.callbacks.inner.len == 0_u64 {
      break;
    }
    let removed = take_back(window: &vm^.callbacks.inner);
  }
  close_upvalues(vm: vm, stack: stack, level: 0_u64);
  loop {
    if vm^.frames.inner.len == 0_u64 {
      break;
    }
    let f = take_back(window: &vm^.frames.inner);
  }
  set vm^.top = 0_u64;
  set vm^.activation = 0_u32;
  set vm^.host_stopped = False();
  set vm^.error = Value::Nil();
  return unit;
}

fn charge_budget(vm: &Vm, pc: u64, base: u64, kbase: u64) -> r: Bool writes(vm) {
  let b = vm^.budget;
  if b == 0_u64 {
    set vm^.saved_pc = pc;
    set vm^.saved_base = base;
    set vm^.saved_kbase = kbase;
    return False();
  }
  if b != unlimited {
    set vm^.budget = b - 1_u64;
  }
  return True();
}

fn register_value(stack: &Box<Slots<Value>>, base: u64, operand: u8) -> r: Value reads(stack) contract {
  requires base + 256_u64 <= stack^.inner.len;
} {
  let offset = cvt::<u8, u64>(operand);
  let index = base + offset;
  return stack^.inner[index];
}

fn constant_value(consts: &Box<Slots<Value>>, kbase: u64, operand: u8) -> r: Value reads(consts) contract {
  requires kbase + 256_u64 <= consts^.inner.len;
} {
  let offset = cvt::<u8, u64>(operand);
  let index = kbase + offset;
  return consts^.inner[index];
}

fn checked_frame(stack: &Box<Slots<Value>>, base: u64) -> r: Result<u64, unit> reads(stack) contract {
  ensures when Ok(value: b): b == base;
  ensures when Ok(value: b): b + 256_u64 <= stack^.inner.len;
} {
  if base <= 18446744073709551359_u64 {
    let limit = base + 256_u64;
    if limit <= stack^.inner.len {
      return Ok<u64, unit>(value: base);
    }
  }
  return Err<u64, unit>(error: unit);
}

fn register_slot(stack: &Box<Slots<Value>>, base: u64, operand: u8) -> r: u64 reads(stack) contract {
  requires base + 256_u64 <= stack^.inner.len;
  ensures r < stack^.inner.len;
} {
  let offset = cvt::<u8, u64>(operand);
  let index = base + offset;
  let extent = stack^.inner.len;
  return index;
}

fn park_stopped_stack(vm: &Vm, stack: &Box<Slots<Value>>) -> r: unit reads(stack), writes(vm) {
  if vm^.host_stopped {
    return unit;
  }
  let count = stack^.inner.len;
  let saved = box_slots_new::<Value>(capacity: count);
  for (i in 0_u64..count) {
    if saved.inner.len < saved.inner.cap {
      let value = stack^.inner[i];
      place_back(window: &saved.inner, value: value);
    }
  }
  set vm^.stopped_stack = move saved;
  set vm^.host_stopped = True();
  return unit;
}

fn restore_stopped_stack(vm: &Vm, stack: &Box<Slots<Value>>) -> r: unit reads(vm), writes(stack) {
  let count = vm^.stopped_stack.inner.len;
  resize_stack(stack: stack, size: count);
  for (i in 0_u64..count) {
    set stack^.inner[i] = vm^.stopped_stack.inner[i];
  }
  return unit;
}
