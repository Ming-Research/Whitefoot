enum Step {
  Jump(pc: u64, base: u64, kbase: u64);
  Done(count: u64);
  Error();
  Stop();
  Budget();
}

enum FuncView {
  Lua(h: u32);
  Native(id: u32);
  Other();
}

fn func_of(v: Value) -> r: FuncView pure {
  match v {
    Fun(h: bound_h_10) => {
      return FuncView::Lua(h: bound_h_10);
