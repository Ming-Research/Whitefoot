      }
    }
  }
  return False();
}

fn stack_new(size: u64) -> r: Box<Slots<Value>> pure contract {
  ensures r.inner.len == size;
} {
  let s = box_slots_new::<Value>(capacity: size);
  resize_stack(stack: &s, size: size);
  return move s;
}

fn resize_stack(stack: &Box<Slots<Value>>, size: u64) -> r: unit writes(stack) contract {
  ensures stack^.inner.len == size;
} {
  if stack^.inner.cap < size {
    grow(cell: stack, capacity: size);
  }
  loop (
    invariant room: stack^.inner.len <= stack^.inner.cap
  ) {
    if stack^.inner.len >= size {
      break;
    }
    if stack^.inner.len < stack^.inner.cap {
      let nil = Value::Nil();
      place_back(window: &stack^.inner, value: nil);
    }
  }
  loop (
    invariant lower: stack^.inner.len >= size
  ) {
    if stack^.inner.len <= size {
      break;
    }
    let discarded = take_back(window: &stack^.inner);
  }
  return unit;
}

fn ensure_stack(stack: &Box<Slots<Value>>, size: u64) -> r: unit writes(stack) contract {
  ensures stack^.inner.len >= size;
  ensures stack^.inner.len >= entry(stack)^.inner.len;
} {
  if stack^.inner.len < size {
    resize_stack(stack: stack, size: size);
  }
  return unit;
}

fn push_frame(vm: &Vm, frame: Frame) -> r: Bool writes(vm) {
  let n = vm^.frames.inner.len;
  if n >= 20000_u64 {
    return raise_text(vm: vm, text: &calls_text_0[0_u64..14_u64]);
  }
  if n < 18446744073709551615_u64 {
    if n == vm^.frames.inner.cap {
      let cap = n * 2_u64;
      if cap < 32_u64 {
        set cap = 32_u64;
      }
      if cap > 20000_u64 {
        set cap = 20000_u64;
      }
      if cap >= vm^.frames.inner.cap {
        grow(cell: &vm^.frames, capacity: cap);
      }
    }
    if vm^.frames.inner.len < vm^.frames.inner.cap {
      place_back(window: &vm^.frames.inner, value: frame);
      return True();
    }
  }
  return False();
}

fn vm_new(limit: u64) -> r: Vm pure {
  let heap = pkg::heap::heap_new(limit: limit);
  let g = new_table(heap: &heap, asize: 0_u32, hsize: 8_u32);
  let gh = no_handle;
  match tab_of(v: g) {
    Handle(h: bound_h_4) => {
      set gh = bound_h_4;
    }
    NoHandle() => {
    }
  }
  let frames = box_slots_new::<Frame>(capacity: 32_u64);
  let opens = box_slots_new::<u32>(capacity: 0_u64);
  let protos = box_slots_new::<Proto>(capacity: 0_u64);
  let lineinfo = box_slots_new::<u32>(capacity: 0_u64);
  let nil = Value::Nil();
  let stopped_stack = box_slots_new::<Value>(capacity: 0_u64);
  let atom3 = False();
  let callbacks = box_slots_new::<CallbackFrame>(capacity: 0_u64);
  let callback_plan = CallbackPlan(pc: 0_u64, base: 0_u64, kbase: 0_u64, kind: 0_u8, dest: 0_u64, first: 0_u64, index: 0_u64, target: 0_u64, expected: atom3);
  let type_metatables = array_filled::<u32, 6>(value: no_handle);
  let library_contexts = box_slots_new::<LibraryContext>(capacity: 0_u64);
  let sort_frames = box_slots_new::<SortFrame>(capacity: 0_u64);
  return Vm(library_contexts: move library_contexts, sort_frames: move sort_frames, random_state: 20017429951246_u64, heap: move heap, frames: move frames, open_upvalues: move opens, protos: move protos, lineinfo: move lineinfo, top: 0_u64, budget: unlimited, saved_pc: 0_u64, saved_base: 0_u64, saved_kbase: 0_u64, error: nil, activation: 0_u32, globals: gh, type_metatables: type_metatables, host_stopped: atom3, stopped_stack: move stopped_stack, callback_plan: callback_plan, callbacks: move callbacks, suspended: atom3);
}

fn raise_text(vm: &Vm, text: &[u8]) -> r: Bool reads(text), writes(vm) {
  let v = intern(heap: &vm^.heap, bytes: text);
  set vm^.error = v;
  return False();
}

fn type_error(vm: &Vm, v: Value, op: u8) -> r: Bool writes(vm) {
  let k = kind(v: v);
