      }
      return False();
    }
    True() => {
      let k = kind(v: b);
      let t = truthy(v: b);
      if k == 1_u8 {
        return t;
      }
      return False();
    }
    Num(n: x) => {
      match num_of(v: b) {
        Is(x: y) => {
          return feq(x, y);
        }
        Not() => {
        }
      }
    }
    Str(h: bound_h_8) => {
      match str_of(v: b) {
        Handle(h: j) => {
