    Str(..) => {
    }
    Tab(..) => {
    }
  }
  return FuncView::Other();
}

fn kind(v: Value) -> r: u8 pure {
  match v {
    Nil() => {
      return 0_u8;
    }
    False() => {
      return 1_u8;
    }
    True() => {
