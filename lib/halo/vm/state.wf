      }
    }
    Tab(h: bound_h_7) => {
      match tab_of(v: b) {
        Handle(h: j) => {
          return bound_h_7 == j;
        }
        NoHandle() => {
        }
      }
    }
    Fun(h: bound_h_6) => {
      match func_of(v: b) {
        Lua(h: j) => {
          return bound_h_6 == j;
        }
        Native(..) => {
