          let key_v14 = intern(heap: &vm^.heap, bytes: &row_v12.name[0_u64..n_v13]);
          let id_v15 = cjson_bound(id: row_v12.id, config: config);
          let v_v16 = Value::Builtin(id: id_v15);
          let ignored_v17 = table_set(heap: &vm^.heap, t: table_v10, key: key_v14, val: v_v16);
        }
