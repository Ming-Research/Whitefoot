  let null_v18 = Value::Builtin(id: 111_u32);
  codec_field(vm: vm, table: table_v10, key: &cj_null[0_u64..4_u64], value: null_v18);
  codec_metadata(vm: vm, table: table_v10, key: &codec_name[0_u64..5_u64], text: &codec_lib_4[0_u64..5_u64]);
  codec_metadata(vm: vm, table: table_v10, key: &codec_version[0_u64..8_u64], text: &cj_version[0_u64..5_u64]);
  return table_v10;
}

fn cjson_isnull(value: Value) -> r: Bool pure {
  match value {
    Builtin(id: id_v19) => {
      return id_v19 == 111_u32;
    }
    Nil() => {
