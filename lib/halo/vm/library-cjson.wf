fn cjson_default() -> r: CjsonConfig pure {
  let settings_v1 = array_filled::<u64, 9>(value: 0_u64);
  set settings_v1[0_u64] = 1000_u64;
  set settings_v1[1_u64] = 1000_u64;
  set settings_v1[2_u64] = 14_u64;
  set settings_v1[3_u64] = 1_u64;
  set settings_v1[5_u64] = 1_u64;
  set settings_v1[7_u64] = 2_u64;
  set settings_v1[8_u64] = 10_u64;
  let buffer_v2 = box_slots_new::<u8>(capacity: 0_u64);
  return CjsonConfig(settings: settings_v1, buffer: move buffer_v2);
}

fn cjson_config(vm: &Vm) -> r: u64 writes(vm) {
  let cap_v3 = vm^.cjson_configs.inner.cap;
  let index_v4 = vm^.cjson_configs.inner.len;
  if index_v4 == cap_v3 {
    let target_v5 = cap_v3 +sat 16_u64;
    grow(cell: &vm^.cjson_configs, capacity: target_v5);
  }
  let config_v6 = cjson_default();
  if vm^.cjson_configs.inner.len < vm^.cjson_configs.inner.cap {
    place_back(window: &vm^.cjson_configs.inner, value: move config_v6);
  }
  return index_v4;
}

fn cjson_bound(id: u32, config: u64) -> r: u32 pure {
  if config == 0_u64 {
    return id;
  }
  let narrow_v7 = cvt.wrap::<u64, u32>(config);
  let shifted_v8 = ishl.wrap(narrow_v7, 8_u32);
  let marked_v9 = ior(shifted_v8, 2147483648_u32);
  return ior(marked_v9, id);
}

fn cjson_table(vm: &Vm, config: u64) -> r: Value writes(vm) {
  let table_v10 = new_table(heap: &vm^.heap, asize: 0_u32, hsize: 16_u32);
  for (i_v11 in 96_u64..106_u64) {
