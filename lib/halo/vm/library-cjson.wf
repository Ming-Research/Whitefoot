const cj_null: Array<u8, 4> = "null";

const cj_version: Array<u8, 5> = "2.1.0";

const cj_serial: Array<u8, 17> = "Cannot serialise ";

const cj_colon: Array<u8, 2> = ": ";

const cj_hex: Array<u8, 4> = "\\u00";

const cj_invalid_number: Array<u8, 22> = "must not be NaN or Inf";

const cj_nan: Array<u8, 3> = "nan";

const cj_unsupported: Array<u8, 18> = "type not supported";

const cj_nesting: Array<u8, 37> = "Cannot serialise, excessive nesting (";

