fn cjson_number(value: f64, precision: u64, out: &Box<Slots<u8>>) -> r: unit writes(out) {
  if precision == 14_u64 {
    let text_v23 = array_filled::<u8, 32>(value: 0_u8);
    let length_v24 = pkg::number::format_number(value: value, out: &text_v23[0_u64..32_u64]);
    bytes_append(bytes: out, text: &text_v23[0_u64..length_v24]);
  } else {
    let bits_v25 = reinterpret::<f64, u64>(value);
    let sign_v26 = ishr.wrap(bits_v25, 63_u32);
    if sign_v26 != 0_u64 {
      bytes_push(bytes: out, byte: 45_u8);
    }
    let magnitude_v27 = fabs(value);
    let p_v28 = cvt.wrap::<u64, i64>(precision);
    let no_v29 = False();
    format_float(bytes: out, x: magnitude_v27, specifier: 103_u8, precision: p_v28, alternate: no_v29);
  }
  return unit;
}

fn cjson_truncate(out: &Box<Slots<u8>>, length: u64) -> r: unit writes(out) {
  loop {
    if out^.inner.len <= length {
      break;
    }
    let ignored_v30 = take_back(window: &out^.inner);
  }
  return unit;
}

fn cjson_quote(writer: &json::encode::Writer, out: &Box<Slots<u8>>, bytes: &[u8], key: Bool) -> r: unit reads(bytes), writes(writer), writes(out) {
  doc "The general writer owns commas and value state. Redis strings preserve arbitrary bytes: write a valid empty placeholder, then replace its two quote bytes with Redis's byte escaping.";
  let empty_v31 = array_filled::<u8, 0>(value: 0_u8);
  if key {
    let ignored_v32 = json::encode::key(writer: writer, output: out, bytes: &empty_v31[0_u64..0_u64]);
  } else {
    let ignored_v33 = json::encode::string(writer: writer, output: out, bytes: &empty_v31[0_u64..0_u64]);
  }
  let remove_v34 = 2_u64;
  if key {
    set remove_v34 = 3_u64;
  }
  let prefix_v35 = out^.inner.len -sat remove_v34;
  cjson_truncate(out: out, length: prefix_v35);
  bytes_push(bytes: out, byte: 34_u8);
  for (i_v36 in 0_u64..bytes^.len) {
    let b_v37 = bytes^[i_v36];
    let escape_v38 = 0_u8;
    if b_v37 == 34_u8 {
      set escape_v38 = 34_u8;
    }
    if b_v37 == 92_u8 {
      set escape_v38 = 92_u8;
    }
    if b_v37 == 47_u8 {
      set escape_v38 = 47_u8;
    }
    if b_v37 == 8_u8 {
      set escape_v38 = 98_u8;
    }
    if b_v37 == 9_u8 {
      set escape_v38 = 116_u8;
    }
    if b_v37 == 10_u8 {
      set escape_v38 = 110_u8;
    }
    if b_v37 == 12_u8 {
      set escape_v38 = 102_u8;
    }
    if b_v37 == 13_u8 {
      set escape_v38 = 114_u8;
    }
    if escape_v38 != 0_u8 {
      bytes_push(bytes: out, byte: 92_u8);
      bytes_push(bytes: out, byte: escape_v38);
    } else if b_v37 < 32_u8 {
      bytes_append(bytes: out, text: &cj_hex[0_u64..4_u64]);
      let hi_v39 = b_v37 / 16_u8;
      let lo_v40 = b_v37 % 16_u8;
      let high_v41 = cvt::<u8, u64>(hi_v39);
      let low_v42 = cvt::<u8, u64>(lo_v40);
      if high_v41 < 16_u64 {
        let digit_v43 = bit_digits[high_v41];
        bytes_push(bytes: out, byte: digit_v43);
      }
      if low_v42 < 16_u64 {
        let digit_v44 = bit_digits[low_v42];
        bytes_push(bytes: out, byte: digit_v44);
      }
    } else {
      bytes_push(bytes: out, byte: b_v37);
    }
  }
  bytes_push(bytes: out, byte: 34_u8);
  if key {
    bytes_push(bytes: out, byte: 58_u8);
  }
  return unit;
}

fn cjson_write(vm: &Vm, writer: &json::encode::Writer, out: &Box<Slots<u8>>, value: Value, settings: &Array<u64, 9>, depth: u64) -> r: Bool reads(settings), writes(vm), writes(writer), writes(out) {
