        let precision_v58 = settings^[2_u64];
        cjson_number(value: n_v51, precision: precision_v58, out: &bytes_v57);
        let length_v59 = bytes_v57.inner.len;
        let ignored_v60 = json::encode::number(writer: writer, output: out, bytes: &bytes_v57.inner[0_u64..length_v59]);
      }
