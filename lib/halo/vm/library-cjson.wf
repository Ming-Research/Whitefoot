const cj_option: Array<u8, 16> = "invalid option '";

const cj_between: Array<u8, 25> = "expected integer between ";

const cj_and: Array<u8, 5> = " and ";

fn cjson_finite(value: f64) -> r: Bool pure {
  let bits = reinterpret::<f64, u64>(value);
  let exp = iand(bits, 9218868437227405312_u64);
  return exp != 9218868437227405312_u64;
}

fn cjson_nan(value: f64) -> r: Bool pure {
  let equal = feq(value, value);
  return bnot(equal);
}
