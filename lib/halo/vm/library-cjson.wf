        let n_v65 = cvt.nearest::<u64, f64>(d_v62);
        let v_v66 = Value::Num(n: n_v65);
        let s_v67 = coerce_string(vm: vm, v: v_v66);
        bytes_string(vm: vm, bytes: &bytes_v64, value: s_v67);
        bytes_push(bytes: &bytes_v64, byte: 41_u8);
        let length_v68 = bytes_v64.inner.len;
        return raise_text(vm: vm, text: &bytes_v64.inner[0_u64..length_v68]);
      }
      let key_v69 = Value::Nil();
      let count_v70 = 0_u64;
      let max_v71 = 0_u64;
      let array_v72 = True();
      loop {
        match pkg::heap::table_next(heap: &vm^.heap, t: value, key: key_v69) {
          Err(..) => {
            break;
