alias Value = pkg::value::Value;
alias Cell = pkg::value::Cell;
alias truthy = pkg::value::truthy;

const concat_range_error: Array<u8, 20> = "invalid concat range";

fn push_callback(vm: &Vm, frame: CallbackFrame) -> r: unit writes(vm.callbacks) {
  let count = vm^.callbacks.inner.len;
  if count < unlimited {
    if count == vm^.callbacks.inner.cap {
      let capacity = count + 1_u64;
      grow(cell: &vm^.callbacks, capacity: capacity);
    }
    if vm^.callbacks.inner.len < vm^.callbacks.inner.cap {
      place_back(window: &vm^.callbacks.inner, value: frame);
    }
  }
  return unit;
}

fn park_suspended_stack(vm: &Vm, stack: &Box<Slots<Value>>) -> r: unit reads(stack), writes(vm) {
  if vm^.suspended {
    return unit;
  }
  let count = stack^.inner.len;
  let saved = box_slots_new::<Value>(capacity: count);
  for (i in 0_u64..count) {
    if saved.inner.len < saved.inner.cap {
      let value = stack^.inner[i];
      place_back(window: &saved.inner, value: value);
    }
  }
  set vm^.stopped_stack = move saved;
  set vm^.suspended = True();
  return unit;
}

fn complete_callback(vm: &Vm, stack: &Box<Slots<Value>>, frame: CallbackFrame, count: u64) -> r: unit writes(vm), writes(stack) {
  library_callback_count(vm: vm, plan: frame.plan, count: count);
  if frame.wanted != 0_i64 {
    let copied = adjust_results(vm: vm, stack: stack, dest: frame.dest, src: frame.scratch, count: count, wanted: frame.wanted);
    if frame.mode != 0_u8 {
      let dest = frame.dest;
      if dest < stack^.inner.len {
        let value = stack^.inner[dest];
        let answer = truthy(v: value);
        if frame.mode == 2_u8 {
          set answer = bnot(answer);
        }
        let result = boolean(v: answer);
        set stack^.inner[dest] = result;
      }
    }
  }
  resize_stack(stack: stack, size: frame.length);
  set vm^.activation = frame.activation;
  set vm^.top = frame.top;
  return unit;
}

fn continue_callback<interface Host<E>>(code: &Box<Slots<Cell>>, consts: &Box<Slots<Value>>, stack: &Box<Slots<Value>>, vm: &Vm, env: &E, plan: CallbackPlan) -> r: Step reads(code), reads(consts), writes(stack), writes(vm), writes(env) {
  if plan.kind == 4_u8 {
    let failed = False();
    return resume_library::<Host<E>>(code: code, consts: consts, stack: stack, vm: vm, env: env, plan: plan, failed: failed);
  }
  let pc = plan.pc;
  if plan.kind == 1_u8 {
    let dest = plan.dest;
    if dest < stack^.inner.len {
      let value = stack^.inner[dest];
      let answer = truthy(v: value);
      if eeq(answer, plan.expected) {
        set pc = plan.target;
      }
    }
  } else if plan.kind == 2_u8 {
    return concat_step::<Host<E>>(code: code, consts: consts, stack: stack, vm: vm, env: env, pc: plan.pc, base: plan.base, kbase: plan.kbase, dest: plan.dest, first: plan.first, last: plan.index);
  } else if plan.kind == 3_u8 {
    let dest = plan.dest;
    let control = plan.first;
    if dest < stack^.inner.len {
      let value = stack^.inner[dest];
      let absent = is_nil(v: value);
      if bnot(absent) {
        if control < stack^.inner.len {
          set stack^.inner[control] = value;
        }
        set pc = plan.target;
      }
    }
  }
  return Step::Jump(pc: pc, base: plan.base, kbase: plan.kbase);
}

fn concat_step<interface Host<E>>(code: &Box<Slots<Cell>>, consts: &Box<Slots<Value>>, stack: &Box<Slots<Value>>, vm: &Vm, env: &E, pc: u64, base: u64, kbase: u64, dest: u64, first: u64, last: u64) -> r: Step reads(code), reads(consts), writes(stack), writes(vm), writes(env) {
  let length = stack^.inner.len;
  let index = last;
  if first > last {
    let ignored = raise_text(vm: vm, text: &concat_range_error[0_u64..20_u64]);
    return unwind(vm: vm, stack: stack);
  }
  loop (
    invariant preserved: stack^.inner.len == length
  ) {
    if index <= first {
      break;
    }
    let previous = index - 1_u64;
    let left = base +sat previous;
    let right = base +sat index;
    if left < stack^.inner.len {
      if right < stack^.inner.len {
        let a = stack^.inner[left];
        let b = stack^.inner[right];
        let operation = SlowOp::Concat();
        let nil = Value::Nil();
        let expect = False();
        set vm^.callback_plan = CallbackPlan(pc: pc, base: base, kbase: kbase, kind: 2_u8, dest: dest, first: first, index: previous, target: 0_u64, expected: expect);
        let ok = slow::<Host<E>>(code: code, consts: consts, stack: stack, vm: vm, env: env, op: operation, dest: left, b: a, c: b, v: nil);
        resize_stack(stack: stack, size: length);
        if vm^.suspended {
          return Step::Budget();
        }
        if bnot(ok) {
          if vm^.host_stopped {
            restore_stopped_stack(vm: vm, stack: stack);
            return Step::Stop();
          }
          return unwind(vm: vm, stack: stack);
        }
      }
    }
    resize_stack(stack: stack, size: length);
    set index = previous;
  }
  let source = base +sat first;
  let target = base +sat dest;
  if source < stack^.inner.len {
    if target < stack^.inner.len {
      let value = stack^.inner[source];
      set stack^.inner[target] = value;
    }
  }
  let next = pc +sat 1_u64;
  return Step::Jump(pc: next, base: base, kbase: kbase);
}
