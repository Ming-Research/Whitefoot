  error: u8;
}

fn struct_byte(bytes: &Box<Slots<u8>>, offset: u64) -> r: u8 reads(bytes) {
  if offset < bytes^.inner.len {
    return bytes^.inner[offset];
  }
  return 0_u8;
}

fn struct_num(bytes: &Box<Slots<u8>>, state: &StructFormat, default_value: u64) -> r: u64 reads(bytes), writes(state) {
  let n_v1 = 0_u64;
