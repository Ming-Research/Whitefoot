    set has_v2 = True();
    let digit_v4 = b_v3 - 48_u8;
    let wide_v5 = cvt::<u8, u64>(digit_v4);
    let scaled_v6 = n_v1 *sat 10_u64;
    set n_v1 = scaled_v6 +sat wide_v5;
    if n_v1 > 2147483647_u64 {
      set state^.error = 1_u8;
    }
    set state^.offset = state^.offset +sat 1_u64;
  }
  if has_v2 {
    return n_v1;
  }
  return default_value;
