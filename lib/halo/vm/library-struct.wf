    bytes_push(bytes: &text_v20, byte: 39_u8);
    let n_v27 = text_v20.inner.len;
    return lib_argtext(vm: vm, id: id, index: 1_u64, text: &text_v20.inner[0_u64..n_v27]);
  }
  let n_v28 = text_v20.inner.len;
  return lib_failure(vm: vm, text: &text_v20.inner[0_u64..n_v28]);
