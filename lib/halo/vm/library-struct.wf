    let n_v21 = cvt.nearest::<u64, f64>(state^.size);
    let v_v22 = Value::Num(n: n_v21);
    let s_v23 = coerce_string(vm: vm, v: v_v22);
    bytes_string(vm: vm, bytes: &text_v20, value: s_v23);
    bytes_append(bytes: &text_v20, text: &struct_limit_b[0_u64..27_u64]);
  } else if state^.error == 3_u8 {
    bytes_append(bytes: &text_v20, text: &struct_align_a[0_u64..10_u64]);
    let n_v24 = cvt.nearest::<u64, f64>(state^.align);
    let v_v25 = Value::Num(n: n_v24);
