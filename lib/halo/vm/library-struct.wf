fn struct_integer(option: u8) -> r: Bool pure {
  if option == 98_u8 {
    return True();
  }
  if option == 66_u8 {
    return True();
  }
  if option == 104_u8 {
    return True();
  }
  if option == 72_u8 {
    return True();
  }
  if option == 108_u8 {
    return True();
  }
  if option == 76_u8 {
    return True();
  }
  if option == 84_u8 {
    return True();
  }
  if option == 105_u8 {
    return True();
  }
  if option == 73_u8 {
    return True();
  }
  return False();
}

fn struct_control(option: u8) -> r: Bool pure {
  if option == 32_u8 {
    return True();
  }
  if option == 62_u8 {
    return True();
  }
  if option == 60_u8 {
    return True();
  }
  if option == 33_u8 {
    return True();
  }
  return False();
}

