fn install_codecs(vm: &Vm) -> r: unit writes(vm) {
  let initial_config_v59 = cjson_config(vm: vm);
  let globals_v60 = Value::Tab(h: vm^.globals);
  for (lib_v61 in 4_u64..8_u64) {
    let t_v62 = new_table(heap: &vm^.heap, asize: 0_u32, hsize: 16_u32);
    if lib_v61 == 4_u64 {
      set t_v62 = cjson_table(vm: vm, config: initial_config_v59);
    }
    let key_v63 = Value::Nil();
    if lib_v61 == 4_u64 {
      set key_v63 = intern(heap: &vm^.heap, bytes: &codec_lib_4[0_u64..5_u64]);
    }
    if lib_v61 == 5_u64 {
      set key_v63 = intern(heap: &vm^.heap, bytes: &codec_lib_5[0_u64..8_u64]);
    }
    if lib_v61 == 6_u64 {
      set key_v63 = intern(heap: &vm^.heap, bytes: &codec_lib_6[0_u64..3_u64]);
    }
    if lib_v61 == 7_u64 {
      set key_v63 = intern(heap: &vm^.heap, bytes: &codec_lib_7[0_u64..6_u64]);
    }
    let ignored_v64 = table_set(heap: &vm^.heap, t: globals_v60, key: key_v63, val: t_v62);
    if lib_v61 == 5_u64 {
      codec_metadata(vm: vm, table: t_v62, key: &codec_name[0_u64..5_u64], text: &codec_lib_5[0_u64..8_u64]);
      codec_metadata(vm: vm, table: t_v62, key: &codec_version[0_u64..8_u64], text: &mp_version[0_u64..18_u64]);
      codec_metadata(vm: vm, table: t_v62, key: &codec_copyright[0_u64..10_u64], text: &mp_copyright[0_u64..40_u64]);
      codec_metadata(vm: vm, table: t_v62, key: &codec_description[0_u64..12_u64], text: &mp_description[0_u64..36_u64]);
    }
    for (i_v65 in 96_u64..144_u64) {
      match codec_builtin(index: i_v65) {
        Some(value: row_v66) => {
          let which_v67 = cvt::<u8, u64>(row_v66.library);
          if which_v67 == lib_v61 {
            let length_v68 = row_v66.length;
            if length_v68 <= 32_u64 {
              let key_v69 = intern(heap: &vm^.heap, bytes: &row_v66.name[0_u64..length_v68]);
              let value_v70 = Value::Builtin(id: row_v66.id);
              let ignored_v71 = table_set(heap: &vm^.heap, t: t_v62, key: key_v69, val: value_v70);
            }
          }
        }
        None() => {
        }
      }
    }
  }
  return unit;
}

fn codec_value_push(values: &Box<Slots<Value>>, value: Value) -> r: unit writes(values) {
  let cap_v72 = values^.inner.cap;
  if values^.inner.len == cap_v72 {
    let target_v73 = cap_v72 +sat 32_u64;
    grow(cell: values, capacity: target_v73);
  }
  if values^.inner.len < values^.inner.cap {
    place_back(window: &values^.inner, value: value);
  }
  return unit;
}

fn codec_results(stack: &Box<Slots<Value>>, func: u64, values: &Box<Slots<Value>>) -> r: HostOutcome reads(values), writes(stack) {
  let count_v74 = values^.inner.len;
  let end_v75 = func +sat count_v74;
  ensure_stack(stack: stack, size: end_v75);
  for (i_v76 in 0_u64..count_v74) {
    let at_v77 = func +sat i_v76;
    if at_v77 < stack^.inner.len {
      if i_v76 < values^.inner.len {
        set stack^.inner[at_v77] = values^.inner[i_v76];
      }
    }
  }
  return HostOutcome::Returned(count: count_v74);
}

fn codec_field(vm: &Vm, table: Value, key: &[u8], value: Value) -> r: unit reads(key), writes(vm) {
  let name_v78 = intern(heap: &vm^.heap, bytes: key);
  let ignored_v79 = table_set(heap: &vm^.heap, t: table, key: name_v78, val: value);
  return unit;
}

fn codec_metadata(vm: &Vm, table: Value, key: &[u8], text: &[u8]) -> r: unit reads(key), reads(text), writes(vm) {
  let value_v80 = intern(heap: &vm^.heap, bytes: text);
  codec_field(vm: vm, table: table, key: key, value: value_v80);
  return unit;
}

const codec_name: Array<u8, 5> = "_NAME";

const codec_version: Array<u8, 8> = "_VERSION";

const codec_copyright: Array<u8, 10> = "_COPYRIGHT";

const codec_description: Array<u8, 12> = "_DESCRIPTION";

const mp_version: Array<u8, 18> = "lua-cmsgpack 0.4.0";

const mp_copyright: Array<u8, 40> = "Copyright (C) 2012, Salvatore Sanfilippo";

const mp_description: Array<u8, 36> = "MessagePack C implementation for Lua";

const cj_userdata: Array<u8, 8> = "userdata";

const cj_nulltext: Array<u8, 15> = "userdata: (nil)";
