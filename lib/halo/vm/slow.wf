fn metatable(vm: &Vm, v: Value) -> r: Value reads(vm) {
  match tab_of(v: v) {
    Handle(h: bound_h_13) => {
      let i = cvt::<u32, u64>(bound_h_13);
      if i < vm^.heap.tables.inner.len {
        if vm^.heap.tables.inner[i].live {
          let m = vm^.heap.tables.inner[i].payload.meta;
          if m != no_handle {
            return Value::Tab(h: m);
          }
        }
      }
    }
    NoHandle() => {
      let tag = kind(v: v);
      let index = cvt::<u8, u64>(tag);
      if index < 6_u64 {
        let h = vm^.type_metatables[index];
        if h != no_handle {
          return Value::Tab(h: h);
        }
      }
    }
  }
  return Value::Nil();
}

fn metamethod(vm: &Vm, v: Value, name: &[u8]) -> r: Value reads(name), writes(vm) {
  let mt = metatable(vm: vm, v: v);
  if is_nil(v: mt) {
    return Value::Nil();
  }
  let key = intern(heap: &vm^.heap, bytes: name);
  return table_get(heap: &vm^.heap, t: mt, key: key);
}

fn is_readonly(vm: &Vm, v: Value) -> r: Bool reads(vm) {
