    Handle(h: bound_h_12) => {
      let i = cvt::<u32, u64>(bound_h_12);
      if i < vm^.heap.tables.inner.len {
        return vm^.heap.tables.inner[i].payload.read_only;
      }
    }
    NoHandle() => {
    }
  }
  return False();
}

fn raw_assign(vm: &Vm, t: Value, key: Value, v: Value) -> r: Bool writes(vm) {
