    let removed = take_back(window: &vm^.callbacks.inner);
  }
  set vm^.activation = depth;
  set vm^.top = oldtop;
  return ok;
}

fn string_order(vm: &Vm, b: u32, c: u32) -> r: i64 reads(vm) {
  let bi = cvt::<u32, u64>(b);
  let ci = cvt::<u32, u64>(c);
  if bi < vm^.heap.strings.inner.len {
    if ci < vm^.heap.strings.inner.len {
      let bn = vm^.heap.strings.inner[bi].payload.bytes.inner.len;
      let cn = vm^.heap.strings.inner[ci].payload.bytes.inner.len;
      for (i in 0_u64..bn) {
        if i >= cn {
          return 1_i64;
        }
        if i < vm^.heap.strings.inner[bi].payload.bytes.inner.len {
          if i < vm^.heap.strings.inner[ci].payload.bytes.inner.len {
            let x = vm^.heap.strings.inner[bi].payload.bytes.inner[i];
            let y = vm^.heap.strings.inner[ci].payload.bytes.inner[i];
            if x < y {
              return -1_i64;
            }
            if x > y {
              return 1_i64;
            }
          }
        }
      }
      if bn < cn {
        return -1_i64;
      }
    }
  }
  return 0_i64;
}

fn concat_strings(vm: &Vm, b: u32, c: u32) -> r: Value writes(vm) {
  let bi = cvt::<u32, u64>(b);
  let ci = cvt::<u32, u64>(c);
  if bi < vm^.heap.strings.inner.len {
    if ci < vm^.heap.strings.inner.len {
      let bn = vm^.heap.strings.inner[bi].payload.bytes.inner.len;
      let cn = vm^.heap.strings.inner[ci].payload.bytes.inner.len;
      let len = bn +sat cn;
      if len < unlimited {
        let bytes = box_slots_new::<u8>(capacity: len);
        for (i in 0_u64..bn) {
          if i < vm^.heap.strings.inner[bi].payload.bytes.inner.len {
            if bytes.inner.len < bytes.inner.cap {
              let v = vm^.heap.strings.inner[bi].payload.bytes.inner[i];
              place_back(window: &bytes.inner, value: v);
            }
          }
        }
        for (i in 0_u64..cn) {
          if i < vm^.heap.strings.inner[ci].payload.bytes.inner.len {
            if bytes.inner.len < bytes.inner.cap {
              let v = vm^.heap.strings.inner[ci].payload.bytes.inner[i];
              place_back(window: &bytes.inner, value: v);
            }
          }
        }
        let n = bytes.inner.len;
        return intern(heap: &vm^.heap, bytes: &bytes.inner[0_u64..n]);
      }
    }
  }
  let ignored = raise_text(vm: vm, text: &slow_text_7[0_u64..22_u64]);
  return Value::Nil();
}

