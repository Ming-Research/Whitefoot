  push_callback(vm: vm, frame: saved);
  ensure_stack(stack: stack, size: needed);
  if scratch < stack^.inner.len {
    set stack^.inner[scratch] = f;
  }
  let s1 = scratch +sat 1_u64;
  let s2 = scratch +sat 2_u64;
  let s3 = scratch +sat 3_u64;
  if s1 < stack^.inner.len {
    set stack^.inner[s1] = b;
  }
  if s2 < stack^.inner.len {
    set stack^.inner[s2] = c;
  }
  if s3 < stack^.inner.len {
    set stack^.inner[s3] = third;
  }
  set vm^.activation = depth + 1_u32;
  let atom4 = False();
