  let out = dispatch_step::<Host<E>>(code: code, consts: consts, stack: stack, vm: vm, env: env, step: step);
  let ok = False();
  match out {
    Done(count: n) => {
      set ok = True();
      if wanted != 0_i64 {
        let copied = adjust_results(vm: vm, stack: stack, dest: dest, src: scratch, count: n, wanted: wanted);
      }
    }
    Error() => {
      let ignored = unwind(vm: vm, stack: stack);
    }
    Budget() => {
      park_suspended_stack(vm: vm, stack: stack);
    }
    HostStopped() => {
      park_stopped_stack(vm: vm, stack: stack);
    }
  }
  resize_stack(stack: stack, size: length);
  if bor(vm^.host_stopped, vm^.suspended) {
    return False();
