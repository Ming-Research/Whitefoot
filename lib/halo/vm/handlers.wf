fn instruction_for_loop<interface Host<E>>(code: &Box<Slots<Cell>>, consts: &Box<Slots<Value>>, stack: &Box<Slots<Value>>, vm: &Vm, env: &E, pc: u64, base: u64, kbase: u64, av: u8, targetv: u32) -> r: Step reads(code), writes(stack), writes(vm) contract {
