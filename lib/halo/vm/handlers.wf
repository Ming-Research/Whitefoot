fn instruction_move<interface Host<E>>(code: &Box<Slots<Cell>>, consts: &Box<Slots<Value>>, stack: &Box<Slots<Value>>, vm: &Vm, env: &E, pc: u64, base: u64, kbase: u64, av: u8, bv: u8) -> r: Step reads(code), writes(stack), writes(vm) contract {
  requires pc < code^.inner.len;
  requires base + 256_u64 <= stack^.inner.len;
  requires kbase + 256_u64 <= consts^.inner.len;
} {
  let n = code^.inner.len;
  let frame_limit = base + 256_u64;
  let next = pc + 1_u64;
  let ok = True();
  let ra = register_slot(stack: stack, base: base, operand: av);
  let v = register_value(stack: stack, base: base, operand: bv);
  set stack^.inner[ra] = v;
  if vm^.suspended {
    return Step::Budget();
  }
  if bnot(ok) {
    if vm^.host_stopped {
      restore_stopped_stack(vm: vm, stack: stack);
      return Step::Stop();
    }
    return unwind(vm: vm, stack: stack);
  }
  if next < n {
    return Step::Jump(pc: next, base: base, kbase: kbase);
  }
  let ignored = raise_text(vm: vm, text: &dispatch_text_0[0_u64..16_u64]);
  return Step::Error();
}

