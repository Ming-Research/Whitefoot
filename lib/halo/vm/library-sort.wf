}

fn sort_start<interface Host<E>>(code: &Box<Slots<Cell>>, consts: &Box<Slots<Value>>, vm: &Vm, stack: &Box<Slots<Value>>, env: &E, table: Value, comparator: Value, func: u64, upper: i64) -> r: Bool reads(code), reads(consts), writes(vm), writes(stack), writes(env) {
  let local_context_14 = vm^.library_contexts.inner.len -sat 1_u64;
  sort_push(vm: vm, context: local_context_14, lower: 1_i64, upper: upper);
  return sort_run::<Host<E>>(code: code, consts: consts, vm: vm, stack: stack, env: env, context: local_context_14);
}

