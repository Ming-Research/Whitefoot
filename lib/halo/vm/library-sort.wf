            NoHandle() => {
            }
          }
        }
        NoHandle() => {
        }
      }
      let local_op_13 = SlowOp::Lt();
      if local_dest_6 < stack^.inner.len {
        return slow::<Host<E>>(code: code, consts: consts, stack: stack, vm: vm, env: env, op: local_op_13, dest: local_dest_6, b: a, c: b, v: local_nil_7);
      }
      return False();
    }
    return callback::<Host<E>>(code: code, consts: consts, stack: stack, vm: vm, env: env, dest: local_dest_6, f: local_call_5.comparator, b: a, c: b, third: local_nil_7, argc: 2_u64, wanted: 1_i64, mode: 0_u8);
