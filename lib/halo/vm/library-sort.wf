const library_sort_sort_order_error: Array<u8, 34> = "invalid order function for sorting";

fn sort_push(vm: &Vm, context: u64, lower: i64, upper: i64) -> r: unit writes(vm) {
  let local_n_1 = vm^.sort_frames.inner.len;
  if local_n_1 == vm^.sort_frames.inner.cap {
    let local_cap_2 = local_n_1 +sat 1_u64;
    grow(cell: &vm^.sort_frames, capacity: local_cap_2);
