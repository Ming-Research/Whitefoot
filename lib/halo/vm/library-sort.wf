  let local_nil_3 = Value::Nil();
  let local_frame_4 = SortFrame(context: context, lower: lower, upper: upper, i: 0_i64, j: 0_i64, phase: 0_u8, a: local_nil_3, b: local_nil_3, pivot: local_nil_3);
  if vm^.sort_frames.inner.len < vm^.sort_frames.inner.cap {
    place_back(window: &vm^.sort_frames.inner, value: local_frame_4);
  }
  return unit;
}

fn sort_store(vm: &Vm, index: u64, frame: SortFrame) -> r: unit writes(vm) {
  if index < vm^.sort_frames.inner.len {
    set vm^.sort_frames.inner[index] = frame;
  }
  return unit;
}

fn sort_compare<interface Host<E>>(code: &Box<Slots<Cell>>, consts: &Box<Slots<Value>>, stack: &Box<Slots<Value>>, vm: &Vm, env: &E, context: u64, a: Value, b: Value) -> r: Bool reads(code), reads(consts), writes(stack), writes(vm), writes(env) {
