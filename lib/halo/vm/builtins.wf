  if kb == kc {
    let p = intern(heap: &vm^.heap, bytes: &builtins_text_6[0_u64..23_u64]);
    let q = intern(heap: &vm^.heap, bytes: &builtins_text_7[0_u64..7_u64]);
    let t = join(vm: vm, b: p, c: bn);
    set text = join(vm: vm, b: t, c: q);
  } else {
    let p = intern(heap: &vm^.heap, bytes: &builtins_text_8[0_u64..19_u64]);
    let q = intern(heap: &vm^.heap, bytes: &builtins_text_9[0_u64..6_u64]);
    let t = join(vm: vm, b: p, c: bn);
    let u = join(vm: vm, b: t, c: q);
