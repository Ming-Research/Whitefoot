fn kind_name(vm: &Vm, v: Value) -> r: Value writes(vm) {
  let k = kind(v: v);
  if k == 0_u8 {
    return intern(heap: &vm^.heap, bytes: &builtins_text_0[0_u64..3_u64]);
  }
  if k == 1_u8 {
    return intern(heap: &vm^.heap, bytes: &builtins_text_1[0_u64..7_u64]);
  }
  if k == 2_u8 {
    return intern(heap: &vm^.heap, bytes: &builtins_text_2[0_u64..6_u64]);
  }
  if k == 3_u8 {
    return intern(heap: &vm^.heap, bytes: &builtins_text_3[0_u64..6_u64]);
  }
  if k == 4_u8 {
    return intern(heap: &vm^.heap, bytes: &builtins_text_4[0_u64..5_u64]);
  }
  return intern(heap: &vm^.heap, bytes: &builtins_text_5[0_u64..8_u64]);
}

fn join(vm: &Vm, b: Value, c: Value) -> r: Value writes(vm) {
  match str_of(v: b) {
    Handle(h: bh) => {
      match str_of(v: c) {
        Handle(h: ch) => {
          return concat_strings(vm: vm, b: bh, c: ch);
        }
        NoHandle() => {
        }
      }
    }
    NoHandle() => {
    }
  }
  return Value::Nil();
}

fn order_error(vm: &Vm, b: Value, c: Value) -> r: Bool writes(vm) {
