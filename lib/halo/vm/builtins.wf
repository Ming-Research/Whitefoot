      if bnot(absent) {
        match coerce_number(vm: vm, v: b) {
          Is(x: number) => {
            let integral = ftrunc(number);
            set level = 0_u64;
            if cvt.defined::<f64, i64>(integral) {
              let integer = cvt::<f64, i64>(integral);
              let narrowed = cvt.wrap::<i64, i32>(integer);
              if narrowed > 0_i32 {
                set level = cvt::<i32, u64>(narrowed);
              }
            }
          }
          Not() => {
            return lib_argerror(vm: vm, id: id, index: 2_u64, argc: argc, value: b, expected: &builtin_expected_2_number[0_u64..6_u64]);
          }
        }
      }
    }
    let message = a;
    if level > 0_u64 {
      set message = coerce_string(vm: vm, v: a);
      match str_of(v: message) {
        Handle(..) => {
          set message = error_location(vm: vm, pc: pc, level: level, message: message);
        }
        NoHandle() => {
        }
      }
    }
    set vm^.error = message;
    return HostOutcome::Raised();
  }
  if id == builtin_select {
    match pkg::heap::string_of(heap: &vm^.heap, value: a) {
      Some(value: s) => {
        let h = cvt::<u32, u64>(s.handle);
        if h < vm^.heap.strings.inner.len {
          if vm^.heap.strings.inner[h].payload.bytes.inner.len > 0_u64 {
            if vm^.heap.strings.inner[h].payload.bytes.inner[0_u64] == 35_u8 {
              let n = argc -sat 1_u64;
              let x = cvt.nearest::<u64, f64>(n);
              set out = Value::Num(n: x);
              if func < stack^.inner.len {
                set stack^.inner[func] = out;
              }
              return HostOutcome::Returned(count: 1_u64);
            }
          }
        }
