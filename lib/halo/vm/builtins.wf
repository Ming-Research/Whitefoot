fn argument(stack: &Box<Slots<Value>>, func: u64, argc: u64, index: u64) -> r: Value reads(stack) {
  if index < argc {
    let first = func +sat 1_u64;
    let i = first +sat index;
    if i < stack^.inner.len {
      return stack^.inner[i];
    }
  }
  return Value::Nil();
}

