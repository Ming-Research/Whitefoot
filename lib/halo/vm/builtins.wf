fn kind_name(vm: &Vm, v: Value) -> r: Value writes(vm) {
  let k = kind(v: v);
  if k == 0_u8 {
    return intern(heap: &vm^.heap, bytes: &builtins_text_0[0_u64..3_u64]);
  }
  if k == 1_u8 {
    return intern(heap: &vm^.heap, bytes: &builtins_text_1[0_u64..7_u64]);
  }
  if k == 2_u8 {
    return intern(heap: &vm^.heap, bytes: &builtins_text_2[0_u64..6_u64]);
  }
  if k == 3_u8 {
    return intern(heap: &vm^.heap, bytes: &builtins_text_3[0_u64..6_u64]);
  }
  if k == 4_u8 {
    return intern(heap: &vm^.heap, bytes: &builtins_text_4[0_u64..5_u64]);
  }
  return intern(heap: &vm^.heap, bytes: &builtins_text_5[0_u64..8_u64]);
}

fn join(vm: &Vm, b: Value, c: Value) -> r: Value writes(vm) {
  match str_of(v: b) {
    Handle(h: bh) => {
      match str_of(v: c) {
        Handle(h: ch) => {
          return concat_strings(vm: vm, b: bh, c: ch);
        }
        NoHandle() => {
        }
      }
    }
    NoHandle() => {
    }
  }
  return Value::Nil();
}

fn order_error(vm: &Vm, b: Value, c: Value) -> r: Bool writes(vm) {
  let kb = kind(v: b);
  let kc = kind(v: c);
  let bn = kind_name(vm: vm, v: b);
  let cn = kind_name(vm: vm, v: c);
  let text = Value::Nil();
  if kb == kc {
    let p = intern(heap: &vm^.heap, bytes: &builtins_text_6[0_u64..23_u64]);
    let q = intern(heap: &vm^.heap, bytes: &builtins_text_7[0_u64..7_u64]);
    let t = join(vm: vm, b: p, c: bn);
    set text = join(vm: vm, b: t, c: q);
  } else {
    let p = intern(heap: &vm^.heap, bytes: &builtins_text_8[0_u64..19_u64]);
    let q = intern(heap: &vm^.heap, bytes: &builtins_text_9[0_u64..6_u64]);
    let t = join(vm: vm, b: p, c: bn);
    let u = join(vm: vm, b: t, c: q);
    set text = join(vm: vm, b: u, c: cn);
  }
  set vm^.error = text;
  return False();
}

fn argument(stack: &Box<Slots<Value>>, func: u64, argc: u64, index: u64) -> r: Value reads(stack) {
  if index < argc {
    let first = func +sat 1_u64;
    let i = first +sat index;
    if i < stack^.inner.len {
      return stack^.inner[i];
    }
  }
  return Value::Nil();
}

const error_source: Array<u8, 12> = "user_script:";

fn error_location(vm: &Vm, pc: u64, level: u64, message: Value) -> r: Value writes(vm) {
  doc "Script has no source-name field; Halo's embedding names its chunk @user_script. Missing line information leaves the original value intact.";
  let remaining = level;
  let index = vm^.frames.inner.len;
  let location = pc;
  loop {
    if index == 0_u64 {
      return message;
    }
    set index = index - 1_u64;
    if index < vm^.frames.inner.len {
      let frame = vm^.frames.inner[index];
      if frame.flags == protected_flag {
        if remaining == 1_u64 {
          return message;
        }
        set remaining = remaining -sat 1_u64;
      } else {
        if remaining == 1_u64 {
          break;
        }
        set remaining = remaining -sat 1_u64;
        set location = frame.return_pc -sat 1_u64;
      }
    }
  }
  if location < vm^.lineinfo.inner.len {
    let line = vm^.lineinfo.inner[location];
    if line > 0_u32 {
      let digits = array_filled::<u8, 10>(value: 0_u8);
      let count = 0_u64;
      let n = line;
      loop {
        if count < 10_u64 {
          let digit = n % 10_u32;
          let digit_byte = cvt::<u32, u8>(digit);
          let byte = digit_byte + 48_u8;
          set digits[count] = byte;
          set count = count + 1_u64;
        }
        set n = n / 10_u32;
        if n == 0_u32 {
          break;
        }
      }
      let bytes = box_slots_new::<u8>(capacity: 24_u64);
      for (i in 0_u64..12_u64) {
        if bytes.inner.len < bytes.inner.cap {
          let byte = error_source[i];
          place_back(window: &bytes.inner, value: byte);
        }
      }
      let i = count;
      loop {
        if i == 0_u64 {
          break;
        }
        set i = i - 1_u64;
        if i < 10_u64 {
          if bytes.inner.len < bytes.inner.cap {
            let byte = digits[i];
            place_back(window: &bytes.inner, value: byte);
          }
        }
      }
      if bytes.inner.len < bytes.inner.cap {
        place_back(window: &bytes.inner, value: 58_u8);
      }
      if bytes.inner.len < bytes.inner.cap {
        place_back(window: &bytes.inner, value: 32_u8);
      }
      let length = bytes.inner.len;
      let prefix = intern(heap: &vm^.heap, bytes: &bytes.inner[0_u64..length]);
      return join(vm: vm, b: prefix, c: message);
    }
  }
  return message;
}

fn builtin<interface Host<E>>(code: &Box<Slots<Cell>>, consts: &Box<Slots<Value>>, env: &E, vm: &Vm, stack: &Box<Slots<Value>>, func: u64, argc: u64, id: u32, pc: u64) -> r: HostOutcome reads(code), reads(consts), writes(env), writes(vm), writes(stack) contract {
  ensures stack^.inner.len == entry(stack)^.inner.len;
} {
  let length = stack^.inner.len;
  if id >= 8_u32 {
