        let integral = ftrunc(bound_x_14);
        if cvt.defined::<f64, i64>(integral) {
          let integer = cvt::<f64, i64>(integral);
          let narrowed = cvt.wrap::<i64, i32>(integer);
          let index = cvt::<i32, i64>(narrowed);
          let total = argc -sat 1_u64;
          if total < 9223372036854775807_u64 {
            let nt = cvt::<u64, i64>(total);
            if index < 0_i64 {
              if index >= -9223372036854775807_i64 {
                set index = nt + index;
