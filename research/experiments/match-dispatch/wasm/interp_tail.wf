                set cursor = next +wrap 1_u64;
              }
              Err(error: small) => {
                set errno = 21_u64;
              }
            }
          } else {
            set errno = 21_u64;
          }
        }
        Err(error: absent) => {
          set errno = 28_u64;
        }
      }
    }
  } else if id == 3_u32 {
    let reading = now(clock: clock);
    let elapsed = nanoseconds_from(earlier: origin, later: reading);
    let stored = store_bytes(mem: mem, at: a2, value: elapsed, count: 8_u64);
    if bnot(stored) {
      set errno = 21_u64;
