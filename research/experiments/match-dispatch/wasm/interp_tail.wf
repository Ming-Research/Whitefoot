    let failed = r^.failed;
    if failed {
      return False();
    }
    if st.failed {
      return False();
    }
    let op = read_byte(r: r, bytes: bytes);
    let process = True();
    if st.dead {
      set process = False();
      let opening = False();
      if op == 2_u8 {
        set opening = True();
      }
      if op == 3_u8 {
        set opening = True();
      }
      if op == 4_u8 {
        set opening = True();
      }
      if opening {
        let (p, q) = block_type(r: r, bytes: bytes, types: types);
        set st.skip = st.skip +wrap 1_u64;
      } else if op == 11_u8 {
        if st.skip > 0_u64 {
          set st.skip = st.skip - 1_u64;
        } else {
          set process = True();
        }
      } else if op == 5_u8 {
        if st.skip == 0_u64 {
          set process = True();
        }
      } else {
        skip_immediates(r: r, bytes: bytes, op: op);
      }
    }
    if process {
      let status = 2_u64;
      if op <= 17_u8 {
        set status = step_control(op: op, st: &st, r: r, bytes: bytes, funcs: funcs, types: types, provs: provs, code: code, brtab: brtab, ctls: ctls, fixes: fixes);
      } else if op <= 68_u8 {
        set status = step_data(op: op, st: &st, r: r, bytes: bytes, consts: consts, provs: provs, code: code);
      } else {
        set status = step_numeric(op: op, st: &st, r: r, bytes: bytes, provs: provs, code: code);
      }
      if status == 1_u64 {
