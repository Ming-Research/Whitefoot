  let nl = 0_u64;
  for (g in 0_u64..groups) {
    let c = read_uleb(r: r, bytes: bytes);
    let t = read_byte(r: r, bytes: bytes);
    set nl = nl +wrap c;
    if nl > 65536_u64 {
      return False();
    }
  }
  let cbase = consts^.inner.len;
  let collected = collect_consts(r: r, bytes: bytes, types: types, consts: consts);
  if bnot(collected) {
