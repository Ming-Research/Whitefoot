  }
  let begin = code^.inner.len;
  if fi < funcs^.inner.len {
    set funcs^.inner[fi].locals = nl;
    set funcs^.inner[fi].start = begin;
    set funcs^.inner[fi].cbase = cbase;
    set funcs^.inner[fi].cn = cn;
  }
  loop @clear_ctls {
    if ctls^.inner.len == 0_u64 {
      break @clear_ctls;
    }
    let gone = take_back(window: &ctls^.inner);
  }
  loop @clear_fixes {
    if fixes^.inner.len == 0_u64 {
      break @clear_fixes;
    }
    let gone = take_back(window: &fixes^.inner);
  }
  loop @clear_provs {
    if provs^.inner.len == 0_u64 {
      break @clear_provs;
    }
    let gone = take_back(window: &provs^.inner);
  }
  let base = l +wrap 2_u64;
  let no = False();
  let st = Trans(dead: no, skip: 0_u64, base: base, l: l, results: f.results, last: 18446744073709551615_u64, last_pos: 0_u64, copy_d: 0_u64, copy_s: 0_u64, failed: no, cslot: pl, cbase: cbase, cn: cn);
