fn grow_memory(mem: Box<Array<u8>>, delta: u64, max_pages: u64) -> (grown: Box<Array<u8>>, old: u64) pure {
  doc "memory.grow: a larger copy of memory and the old size in pages, or the same memory and 2^32 - 1.";
  let len = mem.inner.len;
  let pages = len / 65536_u64;
  let wanted = pages +wrap delta;
  if wanted > max_pages {
    return move mem, 4294967295_u64;
  }
  if wanted > 16384_u64 {
    return move mem, 4294967295_u64;
  }
  if wanted < pages {
    return move mem, 4294967295_u64;
  }
  let bytes = wanted * 65536_u64;
  let fresh = box_array_filled::<u8>(count: bytes, value: 0_u8);
  if len <= fresh.inner.len {
    for (i in 0_u64..len) {
      let b = mem.inner[i];
      set fresh.inner[i] = b;
    }
  }
  return move fresh, pages;
}

fn execute(bytes: &Box<Array<u8>>, size: u64, args: &Args, files: &HandleFactory, out: &OutputStream, err: &OutputStream, clock: &Clock) -> status: u8 reads(bytes), reads(args), writes(files), writes(out), writes(err), writes(clock) waits {
  doc "Loads the module, runs _start and serves its WASI calls; the result is the exit code.";
  let origin = now(clock: clock);
  let types = box_slots_new::<FuncType>(capacity: 64_u64);
  let funcs = box_slots_new::<Func>(capacity: 64_u64);
  let table = box_slots_new::<u64>(capacity: 64_u64);
  let globals = box_slots_new::<u64>(capacity: 64_u64);
  let code = box_slots_new::<Op>(capacity: 65536_u64);
  let brtab = box_slots_new::<Target>(capacity: 1024_u64);
  let info = load(bytes: bytes, size: size, types: &types, funcs: &funcs, table: &table, globals: &globals, code: &code, brtab: &brtab);
  if bnot(info.ok) {
    let r8 = cvt.wrap::<u64, u8>(info.reason);
    let shown = r8 +wrap 30_u8;
    return shown;
  }
  if info.pages > 16384_u64 {
    return 66_u8;
  }
  let mem_bytes = info.pages * 65536_u64;
  let mem = box_array_filled::<u8>(count: mem_bytes, value: 0_u8);
  let false_4 = False();
  let dr = Reader(pos: info.data_at, end: info.data_end, failed: false_4);
  if info.data_at < info.data_end {
    let data_ok = parse_data(r: &dr, bytes: bytes, globals: &globals, mem: &mem);
    if bnot(data_ok) {
      return 67_u8;
    }
  }
  let start = info.start;
  if start >= funcs.inner.len {
    return 68_u8;
  }
  let entry_func = funcs.inner[start];
  if entry_func.params != 0_u64 {
    return 68_u8;
  }
  let stack = box_array_filled::<u64>(count: 4194304_u64, value: 0_u64);
  let l = entry_func.locals;
  let saved_fp = l +wrap 1_u64;
  if saved_fp >= stack.inner.len {
    return 69_u8;
  }
  if l < stack.inner.len {
    set stack.inner[l] = 18446744073709551615_u64;
  }
  set stack.inner[saved_fp] = 0_u64;
  let pc = entry_func.start;
  let sp = saved_fp + 1_u64;
  let fp = 0_u64;
  let max_pages = info.max_pages;
  loop @drive {
    if pc >= code.inner.len {
      return 70_u8;
    }
    if sp > stack.inner.len {
      return 70_u8;
    }
    let outcome = run(code: &code, funcs: &funcs, brtab: &brtab, table: &table, stack: &stack, mem: &mem, globals: &globals, pc: pc, sp: sp, fp: fp);
    match outcome {
      Done(sp: final_sp) => {
        return 0_u8;
      }
      Trap(code: reason, pc: where) => {
        let r8 = cvt.wrap::<u32, u8>(reason);
        let shown = r8 +wrap 100_u8;
        return shown;
      }
      Grow(pc: grow_pc, sp: grow_sp, fp: grow_fp) => {
        if grow_sp == 0_u64 {
          return 70_u8;
        }
        if grow_sp > stack.inner.len {
          return 70_u8;
        }
        let top = grow_sp - 1_u64;
        let delta = stack.inner[top];
        let (grown, old) = grow_memory(mem: move mem, delta: delta, max_pages: max_pages);
        set mem = move grown;
        set stack.inner[top] = old;
        set pc = grow_pc +wrap 1_u64;
        set sp = grow_sp;
        set fp = grow_fp;
      }
      Host(id: host, pc: host_pc, sp: host_sp, fp: host_fp) => {
        let step = host_call(id: host, sp: host_sp, stack: &stack, mem: &mem, args: args, files: files, out: out, err: err, clock: clock, origin: origin);
        if step.exit {
          let c = cvt.wrap::<u64, u8>(step.code);
          return c;
        }
        if step.sp == 18446744073709551615_u64 {
          return 71_u8;
        }
        set pc = host_pc +wrap 1_u64;
        set sp = step.sp;
        set fp = host_fp;
      }
    }
  }
  return 70_u8;
}

fn read_module(args: &Args, cwd: &DirectoryRead, files: &HandleFactory, bytes: &Box<Array<u8>>) -> size: u64 reads(args), reads(cwd), writes(files), writes(bytes) waits {
  doc "Reads the file named by the first argument; the largest u64 reports a failure.";
  match arg_get(args: args, position: 1_u64) {
    Ok(value: text) => {
      match relative_path(value: move text) {
        Ok(value: path) => {
          match open_read(factory: files, root: cwd, path: &path) {
            Ok(value: file) => {
              let total = 0_u64;
              let cap = bytes^.inner.len;
              loop @reading {
                if total >= cap {
                  break @reading;
                }
                match read_at(factory: files, file: &file, destination: &bytes^.inner[0_u64..cap], file_offset: total, start: total, end: cap) {
                  Ok(value: next) => {
                    if next == total {
                      break @reading;
                    }
                    set total = next;
                  }
                  Err(error: stop) => {
                    break @reading;
                  }
                }
              }
              let closed = close_read(factory: files, file: move file);
              return total;
            }
            Err(error: problem) => {
              return 18446744073709551615_u64;
            }
          }
        }
        Err(error: rejected) => {
          return 18446744073709551615_u64;
        }
      }
    }
    Err(error: absent) => {
      return 18446744073709551615_u64;
    }
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "wasm-interp <module.wasm> [arguments...]: runs the module's _start under WASI preview 1; the module sees its own path and the arguments after it.";
  let Inputs(args: args, cwd: cwd_directory, stdout: out, stderr: err, handles: files, stdin: unused_stdin, clock: clock, wall_clock: unused_wall_clock) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  let closed_write = std::fs::close_directory_write(factory: &files, directory: move cwd_write);
  let bytes = box_array_filled::<u8>(count: 16777216_u64, value: 0_u8);
  let size = read_module(args: &args, cwd: &cwd, files: &files, bytes: &bytes);
  let closed = close_directory(factory: &files, directory: move cwd);
  if size == 18446744073709551615_u64 {
    return exit_status(code: 64_u8);
  }
  let code = execute(bytes: &bytes, size: size, args: &args, files: &files, out: &out, err: &err, clock: &clock);
  return exit_status(code: code);
}
