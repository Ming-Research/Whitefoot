  } else if id == 4_u32 {
    set errno = 0_u64;
  } else if id == 5_u32 {
    if a0 <= 2_u64 {
      let s0 = store_bytes(mem: mem, at: a1, value: 2_u64, count: 1_u64);
      let a1_1 = a1 +wrap 1_u64;
      let s1 = store_bytes(mem: mem, at: a1_1, value: 0_u64, count: 7_u64);
      let a1_8 = a1 +wrap 8_u64;
      let s2 = store_bytes(mem: mem, at: a1_8, value: 18446744073709551615_u64, count: 8_u64);
