    set a0 = stack^.inner[base];
  }
  let b1 = base +wrap 1_u64;
  if b1 < sp {
    set a1 = stack^.inner[b1];
  }
  let b2 = base +wrap 2_u64;
  if n > 2_u64 {
    if b2 < sp {
      set a2 = stack^.inner[b2];
    }
  }
  let b3 = base +wrap 3_u64;
  if n > 3_u64 {
    if b3 < sp {
      set a3 = stack^.inner[b3];
    }
  }
  let errno = 0_u64;
  if id == 8_u32 {
    let true_2 = True();
    let finished = HostStep(sp: base, exit: true_2, code: a0);
    return finished;
  }
  let argc = args_count(args: args);
  let wasm_argc = argc -wrap 1_u64;
  if id == 2_u32 {
    let total = 0_u64;
    for (i in 1_u64..argc) {
      match arg_get(args: args, position: i) {
        Ok(value: text) => {
          let length = host_bytes_len(value: &text);
          let with_nul = length +wrap 1_u64;
          set total = total +wrap with_nul;
