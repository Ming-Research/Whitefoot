struct Reader {
  pos: u64;
  end: u64;
  failed: Bool;
}

struct FuncType {
  params: u64;
  results: u64;
  start: u64;
  end: u64;
  canon: u64;
}

struct Ctl {
  kind: u64;
  height: u64;
  params: u64;
  brk: u64;
  results: u64;
  target: u64;
  fixes: u64;
  else_at: u64;
  c: u64;
  cmp: u64;
  fb: u64;
}

struct Trans {
  dead: Bool;
  skip: u64;
  base: u64;
  l: u64;
  results: u64;
  last: u64;
  last_pos: u64;
  copy_d: u64;
  copy_s: u64;
  failed: Bool;
  cslot: u64;
  cbase: u64;
  cn: u64;
}

fn fail(r: &Reader) -> v: u64 writes(r) {
  doc "Marks the reader failed and returns zero.";
  set r^.failed = True();
  return 0_u64;
}

fn read_byte(r: &Reader, bytes: &Box<Array<u8>>) -> b: u8 reads(bytes), writes(r) {
  doc "The next byte below the reader's end, or zero with the reader failed.";
  let p = r^.pos;
  let e = r^.end;
  if p < e {
    if p < bytes^.inner.len {
      let v = bytes^.inner[p];
      set r^.pos = p + 1_u64;
      return v;
    }
  }
  set r^.failed = True();
  return 0_u8;
}

fn read_uleb(r: &Reader, bytes: &Box<Array<u8>>) -> v: u64 reads(bytes), writes(r) {
  doc "An unsigned LEB128 value of at most ten bytes.";
  let value = 0_u64;
  let shift = 0_u32;
  loop @more {
    let b = read_byte(r: r, bytes: bytes);
    let bw = cvt::<u8, u64>(b);
    let low = iand(bw, 127_u64);
    if shift < 64_u32 {
      let part = ishl.wrap(low, shift);
      set value = ior(value, part);
    }
    let cont = iand(bw, 128_u64);
    if cont == 0_u64 {
      break @more;
    }
    if shift >= 63_u32 {
      set r^.failed = True();
      break @more;
    }
    set shift = shift +wrap 7_u32;
  }
  return value;
}

fn read_sleb(r: &Reader, bytes: &Box<Array<u8>>) -> v: u64 reads(bytes), writes(r) {
  doc "A signed LEB128 value of at most ten bytes, sign-extended to 64 bits.";
  let value = 0_u64;
  let shift = 0_u32;
  let last = 0_u64;
  loop @more {
    let b = read_byte(r: r, bytes: bytes);
    let bw = cvt::<u8, u64>(b);
    set last = bw;
    let low = iand(bw, 127_u64);
    if shift < 64_u32 {
      let part = ishl.wrap(low, shift);
      set value = ior(value, part);
    }
    set shift = shift +wrap 7_u32;
    let cont = iand(bw, 128_u64);
    if cont == 0_u64 {
      break @more;
    }
    if shift >= 70_u32 {
      set r^.failed = True();
      break @more;
    }
  }
  let sign = iand(last, 64_u64);
  if sign != 0_u64 {
    if shift < 64_u32 {
      let ones = ishl.wrap(18446744073709551615_u64, shift);
      set value = ior(value, ones);
    }
  }
  return value;
}

fn read_fixed(r: &Reader, bytes: &Box<Array<u8>>, count: u64) -> v: u64 reads(bytes), writes(r) {
  doc "count little-endian bytes, count at most eight.";
  let value = 0_u64;
  for (i in 0_u64..count) {
    let b = read_byte(r: r, bytes: bytes);
    let bw = cvt::<u8, u64>(b);
    let i8w = i *wrap 8_u64;
    let s = cvt.wrap::<u64, u32>(i8w);
    let part = ishl.wrap(bw, s);
    set value = ior(value, part);
  }
  return value;
}

fn read_name(r: &Reader, bytes: &Box<Array<u8>>) -> h: u64 reads(bytes), writes(r) {
  doc "Reads a name and returns its 64-bit FNV-1a hash.";
  let length = read_uleb(r: r, bytes: bytes);
  let hash = 14695981039346656037_u64;
  let p = r^.pos;
  let e = r^.end;
  if p > e {
    return fail(r: r);
  }
  let room = e - p;
  if length > room {
    return fail(r: r);
  }
  for (i in 0_u64..length) {
    let b = read_byte(r: r, bytes: bytes);
    let bw = cvt::<u8, u64>(b);
    set hash = ixor(hash, bw);
    set hash = hash *wrap 1099511628211_u64;
  }
  return hash;
}

fn host_id(name: u64) -> id: u64 pure {
  doc "The WASI function a wasi_snapshot_preview1 import names, 1 through 8, or 9 for any other.";
  if name == 14248422641143363899_u64 {
    return 1_u64;
  }
  if name == 829219124291053014_u64 {
    return 2_u64;
  }
  if name == 4402587025017636220_u64 {
    return 3_u64;
  }
  if name == 12448045297844228476_u64 {
    return 4_u64;
  }
  if name == 17086530971551567055_u64 {
    return 5_u64;
  }
  if name == 3866961118529516736_u64 {
    return 6_u64;
  }
  if name == 10667629758217591639_u64 {
    return 7_u64;
  }
  if name == 9148826187533924178_u64 {
    return 8_u64;
  }
  return 9_u64;
}

fn push_op(code: &Box<Slots<Op>>, op: Op) -> r: unit writes(code) {
  doc "Appends an operation, doubling the store when full.";
  let length = code^.inner.len;
  let capacity = code^.inner.cap;
  if length >= capacity {
    let doubled = capacity +wrap capacity;
    let bigger = imax(doubled, 1024_u64);
    if bigger >= capacity {
      grow(cell: code, capacity: bigger);
    }
  }
  if code^.inner.len < code^.inner.cap {
    place_back(window: &code^.inner, value: op);
  }
  return unit;
}

fn push_target(brtab: &Box<Slots<Target>>, t: Target) -> r: unit writes(brtab) {
  doc "Appends a branch-table entry.";
  let length = brtab^.inner.len;
  let capacity = brtab^.inner.cap;
  if length >= capacity {
    let doubled = capacity +wrap capacity;
    let bigger = imax(doubled, 256_u64);
    if bigger >= capacity {
      grow(cell: brtab, capacity: bigger);
    }
  }
  if brtab^.inner.len < brtab^.inner.cap {
    place_back(window: &brtab^.inner, value: t);
  }
  return unit;
}

fn push_word(cell: &Box<Slots<u64>>, value: u64) -> r: unit writes(cell) {
  doc "Appends a word.";
  let length = cell^.inner.len;
  let capacity = cell^.inner.cap;
  if length >= capacity {
    let doubled = capacity +wrap capacity;
    let bigger = imax(doubled, 64_u64);
    if bigger >= capacity {
      grow(cell: cell, capacity: bigger);
    }
  }
  if cell^.inner.len < cell^.inner.cap {
    place_back(window: &cell^.inner, value: value);
  }
  return unit;
}

fn push_func(cell: &Box<Slots<Func>>, value: Func) -> r: unit writes(cell) {
  doc "Appends a function record.";
  let length = cell^.inner.len;
  let capacity = cell^.inner.cap;
  if length >= capacity {
    let doubled = capacity +wrap capacity;
    let bigger = imax(doubled, 64_u64);
    if bigger >= capacity {
      grow(cell: cell, capacity: bigger);
    }
  }
  if cell^.inner.len < cell^.inner.cap {
    place_back(window: &cell^.inner, value: value);
  }
  return unit;
}

fn push_type(cell: &Box<Slots<FuncType>>, value: FuncType) -> r: unit writes(cell) {
  doc "Appends a function type.";
  let length = cell^.inner.len;
  let capacity = cell^.inner.cap;
  if length >= capacity {
    let doubled = capacity +wrap capacity;
    let bigger = imax(doubled, 64_u64);
    if bigger >= capacity {
      grow(cell: cell, capacity: bigger);
    }
  }
  if cell^.inner.len < cell^.inner.cap {
    place_back(window: &cell^.inner, value: value);
  }
  return unit;
}

fn push_ctl(cell: &Box<Slots<Ctl>>, value: Ctl) -> r: unit writes(cell) {
  doc "Pushes a control frame of the translator.";
  let length = cell^.inner.len;
  let capacity = cell^.inner.cap;
  if length >= capacity {
    let doubled = capacity +wrap capacity;
    let bigger = imax(doubled, 64_u64);
    if bigger >= capacity {
      grow(cell: cell, capacity: bigger);
    }
  }
  if cell^.inner.len < cell^.inner.cap {
    place_back(window: &cell^.inner, value: value);
  }
  return unit;
}

fn same_bytes(bytes: &Box<Array<u8>>, a: u64, b: u64, length: u64) -> same: Bool reads(bytes) {
  doc "Whether the length bytes at a and at b are equal.";
  let len = bytes^.inner.len;
  if length > len {
    return False();
  }
  let room = len - length;
  if a > room {
    return False();
  }
  if b > room {
    return False();
  }
  for (i in 0_u64..length) {
    let x = a + i;
    let y = b + i;
    let bx = bytes^.inner[x];
    let by = bytes^.inner[y];
    if bx != by {
      return False();
    }
  }
  return True();
}

fn parse_types(r: &Reader, bytes: &Box<Array<u8>>, types: &Box<Slots<FuncType>>) -> ok: Bool reads(bytes), writes(r), writes(types) {
  doc "The type section: each function type's arity, its byte span and its canonical index, the first earlier type with the same bytes.";
  let count = read_uleb(r: r, bytes: bytes);
  for (i in 0_u64..count) {
    let form = read_byte(r: r, bytes: bytes);
    if form != 96_u8 {
      return False();
    }
    let start = r^.pos;
    let params = read_uleb(r: r, bytes: bytes);
    for (p in 0_u64..params) {
      let t = read_byte(r: r, bytes: bytes);
    }
    let results = read_uleb(r: r, bytes: bytes);
    for (q in 0_u64..results) {
      let t = read_byte(r: r, bytes: bytes);
    }
    let end = r^.pos;
    let failed = r^.failed;
    if failed {
      return False();
    }
    let span = end -wrap start;
    let canon = types^.inner.len;
    let known = types^.inner.len;
    for (j in 0_u64..known) {
      if j < types^.inner.len {
        let other = types^.inner[j];
        let other_span = other.end -wrap other.start;
        if other_span == span {
          let same = same_bytes(bytes: bytes, a: start, b: other.start, length: span);
          if same {
            if canon == known {
              set canon = other.canon;
            }
          }
        }
      }
    }
    let ft = FuncType(params: params, results: results, start: start, end: end, canon: canon);
    push_type(cell: types, value: ft);
  }
  let failed = r^.failed;
  return bnot(failed);
}

fn parse_imports(r: &Reader, bytes: &Box<Array<u8>>, types: &Box<Slots<FuncType>>, funcs: &Box<Slots<Func>>) -> ok: Bool reads(bytes), reads(types), writes(r), writes(funcs) {
  doc "The import section: function imports become host functions; any other import is refused.";
  let count = read_uleb(r: r, bytes: bytes);
  for (i in 0_u64..count) {
    let module_name = read_name(r: r, bytes: bytes);
    let field = read_name(r: r, bytes: bytes);
    let kind = read_byte(r: r, bytes: bytes);
    if kind != 0_u8 {
      return False();
    }
    let ti = read_uleb(r: r, bytes: bytes);
    if ti >= types^.inner.len {
      return False();
    }
    let ft = types^.inner[ti];
    let id = host_id(name: field);
    if module_name != 5630335187277993924_u64 {
      set id = 9_u64;
    }
    let f = Func(canon: ft.canon, start: 0_u64, params: ft.params, locals: 0_u64, results: ft.results, host: id, cbase: 0_u64, cn: 0_u64);
    push_func(cell: funcs, value: f);
  }
  let failed = r^.failed;
  return bnot(failed);
}

fn parse_functions(r: &Reader, bytes: &Box<Array<u8>>, types: &Box<Slots<FuncType>>, funcs: &Box<Slots<Func>>) -> ok: Bool reads(bytes), reads(types), writes(r), writes(funcs) {
  doc "The function section: one record per defined function, its code filled in by translation.";
  let count = read_uleb(r: r, bytes: bytes);
  for (i in 0_u64..count) {
    let ti = read_uleb(r: r, bytes: bytes);
    if ti >= types^.inner.len {
      return False();
    }
    let ft = types^.inner[ti];
    let f = Func(canon: ft.canon, start: 0_u64, params: ft.params, locals: 0_u64, results: ft.results, host: 0_u64, cbase: 0_u64, cn: 0_u64);
    push_func(cell: funcs, value: f);
  }
  let failed = r^.failed;
  return bnot(failed);
}

fn read_limits(r: &Reader, bytes: &Box<Array<u8>>) -> (min: u64, max: u64) reads(bytes), writes(r) {
  doc "A limits pair; the largest u64 stands for an absent maximum.";
  let flag = read_byte(r: r, bytes: bytes);
  let low = read_uleb(r: r, bytes: bytes);
  let high = 18446744073709551615_u64;
  let bounded = iand(flag, 1_u8);
  if bounded != 0_u8 {
    set high = read_uleb(r: r, bytes: bytes);
  }
  return low, high;
}

fn const_expr(r: &Reader, bytes: &Box<Array<u8>>, globals: &Box<Slots<u64>>) -> v: u64 reads(bytes), reads(globals), writes(r) {
  doc "A constant expression: one constant or global.get, then end.";
  let op = read_byte(r: r, bytes: bytes);
  let value = 0_u64;
  if op == 65_u8 {
    let s = read_sleb(r: r, bytes: bytes);
    set value = iand(s, 4294967295_u64);
  } else if op == 66_u8 {
    set value = read_sleb(r: r, bytes: bytes);
  } else if op == 67_u8 {
    set value = read_fixed(r: r, bytes: bytes, count: 4_u64);
  } else if op == 68_u8 {
    set value = read_fixed(r: r, bytes: bytes, count: 8_u64);
  } else if op == 35_u8 {
    let gi = read_uleb(r: r, bytes: bytes);
    if gi < globals^.inner.len {
      set value = globals^.inner[gi];
    } else {
      return fail(r: r);
    }
  } else {
    return fail(r: r);
  }
  let finish = read_byte(r: r, bytes: bytes);
  if finish != 11_u8 {
    return fail(r: r);
  }
  return value;
}

fn parse_globals(r: &Reader, bytes: &Box<Array<u8>>, globals: &Box<Slots<u64>>) -> ok: Bool reads(bytes), writes(r), writes(globals) {
  doc "The global section: each global's initial value.";
  let count = read_uleb(r: r, bytes: bytes);
  for (i in 0_u64..count) {
    let ty = read_byte(r: r, bytes: bytes);
    let mutable = read_byte(r: r, bytes: bytes);
    let v = const_expr(r: r, bytes: bytes, globals: globals);
    push_word(cell: globals, value: v);
  }
  let failed = r^.failed;
  return bnot(failed);
}

fn parse_exports(r: &Reader, bytes: &Box<Array<u8>>) -> start: u64 reads(bytes), writes(r) {
  doc "The export section: the index of the function exported as _start, or the largest u64.";
  let found = 18446744073709551615_u64;
  let count = read_uleb(r: r, bytes: bytes);
  for (i in 0_u64..count) {
    let name = read_name(r: r, bytes: bytes);
    let kind = read_byte(r: r, bytes: bytes);
    let index = read_uleb(r: r, bytes: bytes);
    if kind == 0_u8 {
      if name == 17613185073616922942_u64 {
        set found = index;
      }
    }
  }
  return found;
}

fn parse_elements(r: &Reader, bytes: &Box<Array<u8>>, globals: &Box<Slots<u64>>, table: &Box<Slots<u64>>) -> ok: Bool reads(bytes), reads(globals), writes(r), writes(table) {
  doc "The element section: active segments of function indices into table 0.";
  let count = read_uleb(r: r, bytes: bytes);
  for (i in 0_u64..count) {
    let flags = read_uleb(r: r, bytes: bytes);
    if flags != 0_u64 {
      return False();
    }
    let offset = const_expr(r: r, bytes: bytes, globals: globals);
    let n = read_uleb(r: r, bytes: bytes);
    for (j in 0_u64..n) {
      let fi = read_uleb(r: r, bytes: bytes);
      let at = offset +wrap j;
      if at < table^.inner.len {
        set table^.inner[at] = fi;
      } else {
        return False();
      }
    }
  }
  let failed = r^.failed;
  return bnot(failed);
}

fn parse_data(r: &Reader, bytes: &Box<Array<u8>>, globals: &Box<Slots<u64>>, mem: &Box<Array<u8>>) -> ok: Bool reads(bytes), reads(globals), writes(r), writes(mem) {
  doc "The data section: active segments copied into memory 0; passive segments are skipped.";
  let count = read_uleb(r: r, bytes: bytes);
  for (i in 0_u64..count) {
    let flags = read_uleb(r: r, bytes: bytes);
    let offset = 0_u64;
    let active = True();
    if flags == 0_u64 {
      set offset = const_expr(r: r, bytes: bytes, globals: globals);
    } else if flags == 2_u64 {
      let mi = read_uleb(r: r, bytes: bytes);
      set offset = const_expr(r: r, bytes: bytes, globals: globals);
    } else if flags == 1_u64 {
      set active = False();
    } else {
      return False();
    }
    let n = read_uleb(r: r, bytes: bytes);
    for (j in 0_u64..n) {
      let b = read_byte(r: r, bytes: bytes);
      if active {
        let at = offset +wrap j;
        if at < mem^.inner.len {
          set mem^.inner[at] = b;
        } else {
          return False();
        }
      }
    }
  }
  let failed = r^.failed;
  return bnot(failed);
}

struct Pending {
  depth: u64;
  at: u64;
  table: Bool;
  form: u64;
  s: u64;
  d: u64;
  c: u64;
}

struct Prov {
  kind: u64;
  value: u64;
}

fn push_pending(cell: &Box<Slots<Pending>>, value: Pending) -> r: unit writes(cell) {
  doc "Records a forward branch to patch when its label's block ends.";
  let length = cell^.inner.len;
  let capacity = cell^.inner.cap;
  if length >= capacity {
    let doubled = capacity +wrap capacity;
    let bigger = imax(doubled, 64_u64);
    if bigger >= capacity {
      grow(cell: cell, capacity: bigger);
    }
  }
  if cell^.inner.len < cell^.inner.cap {
    place_back(window: &cell^.inner, value: value);
  }
  return unit;
}

fn push_prov(cell: &Box<Slots<Prov>>, value: Prov) -> r: unit writes(cell) {
  doc "Pushes the provider of an operand.";
  let length = cell^.inner.len;
  let capacity = cell^.inner.cap;
  if length >= capacity {
    let doubled = capacity +wrap capacity;
    let bigger = imax(doubled, 64_u64);
    if bigger >= capacity {
      grow(cell: cell, capacity: bigger);
    }
  }
  if cell^.inner.len < cell^.inner.cap {
    place_back(window: &cell^.inner, value: value);
  }
  return unit;
}

fn narrow(value: u64) -> n: u32 pure {
  doc "The low 32 bits of a translator quantity.";
  return cvt.wrap::<u64, u32>(value);
}

fn slot16(value: u64) -> n: u16 pure {
  doc "A frame slot as an operand; the translator refuses a frame past 65535 slots.";
  return cvt.wrap::<u64, u16>(value);
}

fn branch_op(form: u64, target: u64, s: u64, d: u64, c: u64) -> op: Op pure {
  doc "The branch operation of a form: 0 Jump, 1 Br moving slot s to d, 2 BrIf on slot c, 4 BrUnless on slot c, 5 a branch on comparison c of slots s and d.";
  let t = narrow(value: target);
  if form == 1_u64 {
    let s16 = slot16(value: s);
    let d16 = slot16(value: d);
    let o = Op::Br(t: t, s: s16, d: d16);
    return o;
  }
  if form == 2_u64 {
    let c16 = slot16(value: c);
    let o = Op::BrIf(t: t, c: c16);
    return o;
  }
  if form == 4_u64 {
    let c16 = slot16(value: c);
    let o = Op::BrUnless(t: t, c: c16);
    return o;
  }
  if form == 5_u64 {
    let s16 = slot16(value: s);
    let d16 = slot16(value: d);
    return fused_branch(code: c, a: s16, b: d16, t: t);
  }
  let o = Op::Jump(t: t);
  return o;
}

fn patch(code: &Box<Slots<Op>>, brtab: &Box<Slots<Target>>, p: Pending, target: u64) -> r: unit writes(code), writes(brtab) {
  doc "Points a recorded forward branch, an operation or a branch-table entry, at target.";
  let at = p.at;
  if p.table {
    if at < brtab^.inner.len {
      let t = narrow(value: target);
      set brtab^.inner[at].t = t;
    }
    return unit;
  }
  if at < code^.inner.len {
    let o = branch_op(form: p.form, target: target, s: p.s, d: p.d, c: p.c);
    set code^.inner[at] = o;
  }
  return unit;
}

fn block_type(r: &Reader, bytes: &Box<Array<u8>>, types: &Box<Slots<FuncType>>) -> (params: u64, results: u64) reads(bytes), reads(types), writes(r) {
  doc "A block type: empty, one value type, or a type index.";
  let pos = r^.pos;
  let b = read_byte(r: r, bytes: bytes);
  if b == 64_u8 {
    return 0_u64, 0_u64;
  }
  let one = False();
  if b == 127_u8 {
    set one = True();
  }
  if b == 126_u8 {
    set one = True();
  }
  if b == 125_u8 {
    set one = True();
  }
  if b == 124_u8 {
    set one = True();
  }
  if b == 123_u8 {
    set one = True();
  }
  if b == 112_u8 {
    set one = True();
  }
  if b == 111_u8 {
    set one = True();
  }
  if one {
    return 0_u64, 1_u64;
  }
  set r^.pos = pos;
  let index = read_sleb(r: r, bytes: bytes);
  if index < types^.inner.len {
    let ft = types^.inner[index];
    return ft.params, ft.results;
  }
  set r^.failed = True();
  return 0_u64, 0_u64;
}

fn skip_immediates(r: &Reader, bytes: &Box<Array<u8>>, op: u8) -> done: unit reads(bytes), writes(r) {
  doc "Skips the immediates of an operation in unreachable code.";
  let one_uleb = False();
  if op == 12_u8 {
    set one_uleb = True();
  }
  if op == 13_u8 {
    set one_uleb = True();
  }
  if op == 16_u8 {
    set one_uleb = True();
  }
  if op >= 32_u8 {
    if op <= 36_u8 {
      set one_uleb = True();
    }
  }
  if one_uleb {
    let v = read_uleb(r: r, bytes: bytes);
    return unit;
  }
  if op == 14_u8 {
    let n = read_uleb(r: r, bytes: bytes);
    let p = r^.pos;
    let e = r^.end;
    let room = e -wrap p;
    if n >= room {
      set r^.failed = True();
      return unit;
    }
    let total = n + 1_u64;
    for (i in 0_u64..total) {
      let v = read_uleb(r: r, bytes: bytes);
    }
    return unit;
  }
  if op == 17_u8 {
    let a = read_uleb(r: r, bytes: bytes);
    let b = read_uleb(r: r, bytes: bytes);
    return unit;
  }
  if op == 28_u8 {
    let n = read_uleb(r: r, bytes: bytes);
    let p = r^.pos;
    let e = r^.end;
    let room = e -wrap p;
    if n > room {
      set r^.failed = True();
      return unit;
    }
    for (i in 0_u64..n) {
      let t = read_byte(r: r, bytes: bytes);
    }
    return unit;
  }
  if op >= 40_u8 {
    if op <= 62_u8 {
      let a = read_uleb(r: r, bytes: bytes);
      let b = read_uleb(r: r, bytes: bytes);
      return unit;
    }
  }
  if op == 63_u8 {
    let b = read_byte(r: r, bytes: bytes);
    return unit;
  }
  if op == 64_u8 {
    let b = read_byte(r: r, bytes: bytes);
    return unit;
  }
  if op == 65_u8 {
    let v = read_sleb(r: r, bytes: bytes);
    return unit;
  }
  if op == 66_u8 {
    let v = read_sleb(r: r, bytes: bytes);
    return unit;
  }
  if op == 67_u8 {
    let v = read_fixed(r: r, bytes: bytes, count: 4_u64);
    return unit;
  }
  if op == 68_u8 {
    let v = read_fixed(r: r, bytes: bytes, count: 8_u64);
    return unit;
  }
  if op == 252_u8 {
    let sub = read_uleb(r: r, bytes: bytes);
    if sub == 8_u64 {
      let a = read_uleb(r: r, bytes: bytes);
      let b = read_byte(r: r, bytes: bytes);
    }
    if sub == 9_u64 {
      let a = read_uleb(r: r, bytes: bytes);
    }
    if sub == 10_u64 {
      let a = read_byte(r: r, bytes: bytes);
      let b = read_byte(r: r, bytes: bytes);
    }
    if sub == 11_u64 {
      let a = read_byte(r: r, bytes: bytes);
    }
    if sub == 12_u64 {
      let a = read_uleb(r: r, bytes: bytes);
      let b = read_uleb(r: r, bytes: bytes);
    }
    if sub == 14_u64 {
      let a = read_uleb(r: r, bytes: bytes);
      let b = read_uleb(r: r, bytes: bytes);
    }
    if sub == 13_u64 {
      let a = read_uleb(r: r, bytes: bytes);
    }
    if sub >= 15_u64 {
      if sub <= 17_u64 {
        let a = read_uleb(r: r, bytes: bytes);
      }
    }
    return unit;
  }
  return unit;
}

fn temp_slot(st: &Trans, pos: u64) -> slot: u64 reads(st) {
  doc "The frame slot of the operand at stack position pos.";
  return st^.base +wrap pos;
}

fn emit_dest(st: &Trans, code: &Box<Slots<Op>>, op: Op, pos: u64) -> r: unit writes(st), writes(code) {
  doc "Emits an operation writing the temporary of stack position pos and remembers it, so that a local.set right after it can take over its destination.";
  let at = code^.inner.len;
  push_op(code: code, op: op);
  set st^.last = at;
  set st^.last_pos = pos;
  return unit;
}

fn emit_plain(st: &Trans, code: &Box<Slots<Op>>, op: Op) -> r: unit writes(st), writes(code) {
  doc "Emits an operation writing no temporary.";
  push_op(code: code, op: op);
  set st^.last = 18446744073709551615_u64;
  return unit;
}

fn materialize(st: &Trans, provs: &Box<Slots<Prov>>, code: &Box<Slots<Op>>, pos: u64) -> r: unit writes(st), writes(provs), writes(code) {
  doc "Copies a local or constant operand into its own temporary.";
  if pos >= provs^.inner.len {
    return unit;
  }
  let p = provs^.inner[pos];
  if p.kind == 0_u64 {
    return unit;
  }
  let ts = temp_slot(st: st, pos: pos);
  let d = slot16(value: ts);
  if p.kind == 1_u64 {
    let s = slot16(value: p.value);
    let o = Op::Copy(d: d, s: s);
    emit_dest(st: st, code: code, op: o, pos: pos);
  } else {
    let o = Op::Const(d: d, v: p.value);
    emit_dest(st: st, code: code, op: o, pos: pos);
  }
  if pos < provs^.inner.len {
    let in_temp = Prov(kind: 0_u64, value: 0_u64);
    set provs^.inner[pos] = in_temp;
  }
  return unit;
}

fn flush(st: &Trans, provs: &Box<Slots<Prov>>, code: &Box<Slots<Op>>) -> r: unit writes(st), writes(provs), writes(code) {
  doc "Puts every operand in its temporary, as control flow expects.";
  let h = provs^.inner.len;
  for (pos in 0_u64..h) {
    materialize(st: st, provs: provs, code: code, pos: pos);
  }
  return unit;
}

fn source(st: &Trans, provs: &Box<Slots<Prov>>, code: &Box<Slots<Op>>, pos: u64) -> slot: u64 writes(st), writes(provs), writes(code) {
  doc "The slot holding the operand at pos: a local's own slot, or its temporary, a constant first copied there.";
  if pos < provs^.inner.len {
    let p = provs^.inner[pos];
    if p.kind == 1_u64 {
      return p.value;
    }
    if p.kind == 2_u64 {
      materialize(st: st, provs: provs, code: code, pos: pos);
    }
  }
  return temp_slot(st: st, pos: pos);
}

fn preserve(st: &Trans, provs: &Box<Slots<Prov>>, code: &Box<Slots<Op>>, local: u64) -> r: unit writes(st), writes(provs), writes(code) {
  doc "Before a local changes, copies every operand still naming it into its temporary.";
  let h = provs^.inner.len;
  for (pos in 0_u64..h) {
    if pos < provs^.inner.len {
      let p = provs^.inner[pos];
      if p.kind == 1_u64 {
        if p.value == local {
          materialize(st: st, provs: provs, code: code, pos: pos);
        }
      }
    }
  }
  return unit;
}

fn pop_prov(st: &Trans, provs: &Box<Slots<Prov>>, count: u64) -> r: unit writes(st), writes(provs) {
  doc "Pops count operands, marking the translation failed when there are fewer.";
  for (i in 0_u64..count) {
    if provs^.inner.len > 0_u64 {
      let gone = take_back(window: &provs^.inner);
    } else {
      set st^.failed = True();
    }
  }
  return unit;
}

fn push_temp(st: &Trans, provs: &Box<Slots<Prov>>) -> r: unit writes(st), writes(provs) {
  doc "Pushes an operand held in its temporary, refusing a frame past 65535 slots.";
  let pos = provs^.inner.len;
  let ts = temp_slot(st: st, pos: pos);
  if ts >= 65535_u64 {
    set st^.failed = True();
  }
  let p = Prov(kind: 0_u64, value: 0_u64);
  push_prov(cell: provs, value: p);
  return unit;
}

fn set_height(st: &Trans, provs: &Box<Slots<Prov>>, height: u64) -> r: unit writes(st), writes(provs) {
  doc "Makes the operand stack height operands deep, every new one in its temporary.";
  loop @lower {
    if provs^.inner.len <= height {
      break @lower;
    }
    let gone = take_back(window: &provs^.inner);
  }
  loop @raise {
    if provs^.inner.len >= height {
      break @raise;
    }
    let failed = st^.failed;
    if failed {
      break @raise;
    }
    push_temp(st: st, provs: provs);
  }
  return unit;
}

fn top_pos(provs: &Box<Slots<Prov>>, depth: u64) -> pos: u64 reads(provs) {
  doc "The stack position depth below the top, the top being depth 0.";
  let h = provs^.inner.len;
  let above = depth +wrap 1_u64;
  return h -wrap above;
}

fn take_add(st: &Trans, provs: &Box<Slots<Prov>>, code: &Box<Slots<Op>>, pos: u64) -> (found: Bool, a: u64, b: u64) reads(provs), writes(st), writes(code) {
  doc "When the operand at pos is the temporary the last emitted operation, an i32.add, just wrote, removes that operation and returns its operand slots for a load or store to add itself; otherwise found is false.";
  let no = False();
  if pos >= provs^.inner.len {
    return no, 0_u64, 0_u64;
  }
  let p = provs^.inner[pos];
  if p.kind != 0_u64 {
    return no, 0_u64, 0_u64;
  }
  let length = code^.inner.len;
  if length == 0_u64 {
    return no, 0_u64, 0_u64;
  }
  let latest = length - 1_u64;
  let fresh = st^.last == latest;
  let same = st^.last_pos == pos;
  let fused = band(fresh, same);
  if bnot(fused) {
    return no, 0_u64, 0_u64;
  }
  let old = code^.inner[latest];
  let (found, a16, b16) = add_operands(op: old);
  if bnot(found) {
    return no, 0_u64, 0_u64;
  }
  let gone = take_back(window: &code^.inner);
  set st^.last = 18446744073709551615_u64;
  let a = cvt::<u16, u64>(a16);
  let b = cvt::<u16, u64>(b16);
  return found, a, b;
}

fn take_compare(st: &Trans, provs: &Box<Slots<Prov>>, code: &Box<Slots<Op>>) -> (cmp: u64, a: u64, b: u64) reads(provs), writes(st), writes(code) {
  doc "When the top operand is the temporary the last emitted operation, an i32 comparison, just wrote, removes that operation and returns its comparison and operand slots for a branch to test directly; otherwise returns comparison zero.";
  let h = provs^.inner.len;
  if h == 0_u64 {
    return 0_u64, 0_u64, 0_u64;
  }
  let top = h - 1_u64;
  let p = provs^.inner[top];
  if p.kind != 0_u64 {
    return 0_u64, 0_u64, 0_u64;
  }
  let length = code^.inner.len;
  if length == 0_u64 {
    return 0_u64, 0_u64, 0_u64;
  }
  let latest = length - 1_u64;
  let fresh = st^.last == latest;
  let same = st^.last_pos == top;
  let fused = band(fresh, same);
  if bnot(fused) {
    return 0_u64, 0_u64, 0_u64;
  }
  let old = code^.inner[latest];
  let (c, a16, b16) = compare_code(op: old);
  if c == 0_u64 {
    return 0_u64, 0_u64, 0_u64;
  }
  let gone = take_back(window: &code^.inner);
  set st^.last = 18446744073709551615_u64;
  let a = cvt::<u16, u64>(a16);
  let b = cvt::<u16, u64>(b16);
  return c, a, b;
}

fn branch_moves(st: &Trans, depth: u64, height: u64, ctls: &Box<Slots<Ctl>>) -> moves: Bool reads(st), reads(ctls) {
  doc "Whether a branch to the label depth frames out, with height operands below it, must move a result into the label's slot.";
  let nctl = ctls^.inner.len;
  if depth >= nctl {
    return True();
  }
  let up = nctl - depth;
  let ci = up - 1_u64;
  let c = ctls^.inner[ci];
  if c.brk == 0_u64 {
    return False();
  }
  let top = height -wrap 1_u64;
  let value_slot = temp_slot(st: st, pos: top);
  let label_slot = temp_slot(st: st, pos: c.height);
  return value_slot != label_slot;
}

fn emit_branch(st: &Trans, depth: u64, cond: u64, cmp: u64, fa: u64, fb: u64, conditional: Bool, provs: &Box<Slots<Prov>>, code: &Box<Slots<Op>>, brtab: &Box<Slots<Target>>, ctls: &Box<Slots<Ctl>>, fixes: &Box<Slots<Pending>>) -> ok: Bool reads(provs), reads(ctls), writes(st), writes(code), writes(brtab), writes(fixes) {
  doc "A branch to the label depth frames out, every operand already in its temporary: a plain jump when the label's result already sits in the label's slot, a moving branch otherwise; a block's target is patched at its end, a loop's is known.";
  let nctl = ctls^.inner.len;
  if depth >= nctl {
    return False();
  }
  let up = nctl - depth;
  let ci = up - 1_u64;
  let c = ctls^.inner[ci];
  let k = c.brk;
  if k > 1_u64 {
    return False();
  }
  let label_slot = temp_slot(st: st, pos: c.height);
  let top = top_pos(provs: provs, depth: 0_u64);
  let value_slot = temp_slot(st: st, pos: top);
  let moves = False();
  if k == 1_u64 {
    if value_slot != label_slot {
      set moves = True();
    }
  }
  let is_loop = c.kind == 2_u64;
  if conditional {
    if moves {
      let e = brtab^.inner.len;
      let target = 0_u64;
      if is_loop {
        set target = c.target;
      } else {
        let yes = True();
        let pend = Pending(depth: ci, at: e, table: yes, form: 3_u64, s: 0_u64, d: 0_u64, c: 0_u64);
        push_pending(cell: fixes, value: pend);
      }
      let t32 = narrow(value: target);
      let s32 = narrow(value: value_slot);
      let d32 = narrow(value: label_slot);
      let entry_value = Target(t: t32, s: s32, d: d32, k: 1_u32);
      push_target(brtab: brtab, t: entry_value);
      let c16 = slot16(value: cond);
      let e32 = narrow(value: e);
      let o = Op::BrIfMove(c: c16, e: e32);
      emit_plain(st: st, code: code, op: o);
      return True();
    }
  }
  let form = 0_u64;
  let ps = value_slot;
  let pd = label_slot;
  let pc_ = cond;
  if conditional {
    set form = 2_u64;
    if cmp != 0_u64 {
      set form = 5_u64;
      set ps = fa;
      set pd = fb;
      set pc_ = cmp;
    }
  } else if moves {
    set form = 1_u64;
  }
  let target = 0_u64;
  if is_loop {
    set target = c.target;
  } else {
    let at = code^.inner.len;
    let no = False();
    let pend = Pending(depth: ci, at: at, table: no, form: form, s: ps, d: pd, c: pc_);
    push_pending(cell: fixes, value: pend);
  }
  let o = branch_op(form: form, target: target, s: ps, d: pd, c: pc_);
  emit_plain(st: st, code: code, op: o);
  return True();
}

fn emit_table(r: &Reader, bytes: &Box<Array<u8>>, st: &Trans, cond: u64, provs: &Box<Slots<Prov>>, code: &Box<Slots<Op>>, brtab: &Box<Slots<Target>>, ctls: &Box<Slots<Ctl>>, fixes: &Box<Slots<Pending>>) -> ok: Bool reads(bytes), reads(provs), reads(ctls), writes(st), writes(r), writes(code), writes(brtab), writes(fixes) {
  doc "br_table on the index in slot cond: the entries go to the branch table, each moving its label's result to the label's slot.";
  let n = read_uleb(r: r, bytes: bytes);
  let p = r^.pos;
  let e = r^.end;
  let room = e -wrap p;
  if n >= room {
    return False();
  }
  let start = brtab^.inner.len;
  let s32 = narrow(value: start);
  let n32 = narrow(value: n);
  let c16 = slot16(value: cond);
  let o = Op::BrTable(c: c16, start: s32, count: n32);
  emit_plain(st: st, code: code, op: o);
  let top = top_pos(provs: provs, depth: 0_u64);
  let value_slot = temp_slot(st: st, pos: top);
  let total = n + 1_u64;
  for (j in 0_u64..total) {
    let depth = read_uleb(r: r, bytes: bytes);
    let nctl = ctls^.inner.len;
    if depth >= nctl {
      return False();
    }
    let up = nctl - depth;
    let ci = up - 1_u64;
    let c = ctls^.inner[ci];
    let k = c.brk;
    if k > 1_u64 {
      return False();
    }
    let label_slot = temp_slot(st: st, pos: c.height);
    let target = 0_u64;
    if c.kind == 2_u64 {
      set target = c.target;
    } else {
      let at = brtab^.inner.len;
      let yes = True();
      let pend = Pending(depth: ci, at: at, table: yes, form: 0_u64, s: 0_u64, d: 0_u64, c: 0_u64);
      push_pending(cell: fixes, value: pend);
    }
    let t32 = narrow(value: target);
    let vs32 = narrow(value: value_slot);
    let ls32 = narrow(value: label_slot);
    let k32 = narrow(value: k);
    let tv = Target(t: t32, s: vs32, d: ls32, k: k32);
    push_target(brtab: brtab, t: tv);
  }
  let failed = r^.failed;
  return bnot(failed);
}

fn end_block(st: &Trans, provs: &Box<Slots<Prov>>, code: &Box<Slots<Op>>, brtab: &Box<Slots<Target>>, ctls: &Box<Slots<Ctl>>, fixes: &Box<Slots<Pending>>) -> status: u64 writes(st), writes(provs), writes(code), writes(brtab), writes(ctls), writes(fixes) {
  doc "end: puts the block's results in their slots, patches the branches to the closing block and returns 0, or emits the function's return and returns 1; 2 reports a malformed body.";
  if ctls^.inner.len == 0_u64 {
    return 2_u64;
  }
  let innermost = ctls^.inner.len - 1_u64;
  let closing = ctls^.inner[innermost];
  let result_slot = temp_slot(st: st, pos: closing.height);
  if closing.kind == 0_u64 {
    let k = st^.results;
    let filled = closing.height < provs^.inner.len;
    if k == 1_u64 {
      if filled {
        set result_slot = source(st: st, provs: provs, code: code, pos: closing.height);
      }
    }
  } else {
    flush(st: st, provs: provs, code: code);
  }
  let c = take_back(window: &ctls^.inner);
  let depth = ctls^.inner.len;
  let here = code^.inner.len;
  if c.kind == 0_u64 {
    let k = st^.results;
    if k > 1_u64 {
      return 2_u64;
    }
    let s = result_slot;
    let s16 = slot16(value: s);
    let k16 = slot16(value: k);
    let l16 = slot16(value: st^.l);
    let o = Op::Return(s: s16, k: k16, l: l16);
    emit_plain(st: st, code: code, op: o);
  }
  if c.kind == 3_u64 {
    if c.else_at != 18446744073709551615_u64 {
      let no = False();
      let p = if c.cmp == 0_u64 {
        give Pending(depth: depth, at: c.else_at, table: no, form: 4_u64, s: 0_u64, d: 0_u64, c: c.c);
      } else {
        give Pending(depth: depth, at: c.else_at, table: no, form: 5_u64, s: c.c, d: c.fb, c: c.cmp);
      }
      patch(code: code, brtab: brtab, p: p, target: here);
    }
  }
  let keep = c.fixes;
  let from = c.fixes;
  let total = fixes^.inner.len;
  for (i in from..total) {
    if i < fixes^.inner.len {
      let f = fixes^.inner[i];
      if f.depth == depth {
        patch(code: code, brtab: brtab, p: f, target: here);
      } else if keep < fixes^.inner.len {
        set fixes^.inner[keep] = f;
        set keep = keep +wrap 1_u64;
      }
    }
  }
  loop @trim {
    if fixes^.inner.len <= keep {
      break @trim;
    }
    let gone = take_back(window: &fixes^.inner);
  }
  let height = c.height +wrap c.results;
  set_height(st: st, provs: provs, height: height);
  set st^.dead = False();
  set st^.last = 18446744073709551615_u64;
  if c.kind == 0_u64 {
    return 1_u64;
  }
  return 0_u64;
}

fn step_control(op: u8, st: &Trans, r: &Reader, bytes: &Box<Array<u8>>, funcs: &Box<Slots<Func>>, types: &Box<Slots<FuncType>>, provs: &Box<Slots<Prov>>, code: &Box<Slots<Op>>, brtab: &Box<Slots<Target>>, ctls: &Box<Slots<Ctl>>, fixes: &Box<Slots<Pending>>) -> status: u64 reads(bytes), reads(funcs), reads(types), writes(st), writes(r), writes(provs), writes(code), writes(brtab), writes(ctls), writes(fixes) {
  doc "Control operations 0x00 through 0x11: 0 to continue, 1 at the function's end, 2 when malformed or unsupported. Every one first puts the operands in their temporaries.";
  if op == 1_u8 {
    return 0_u64;
  }
  if op == 11_u8 {
    return end_block(st: st, provs: provs, code: code, brtab: brtab, ctls: ctls, fixes: fixes);
  }
  if op == 4_u8 {
    let (p, q) = block_type(r: r, bytes: bytes, types: types);
    let (cmp, fa, fb) = take_compare(st: st, provs: provs, code: code);
    let top = top_pos(provs: provs, depth: 0_u64);
    let cond = 0_u64;
    if cmp == 0_u64 {
      set cond = source(st: st, provs: provs, code: code, pos: top);
    }
    pop_prov(st: st, provs: provs, count: 1_u64);
    flush(st: st, provs: provs, code: code);
    let else_at = code^.inner.len;
    let fused_cmp = 0_u64;
    let fused_b = 0_u64;
    if cmp == 0_u64 {
      let c16 = slot16(value: cond);
      let o = Op::BrUnless(t: 0_u32, c: c16);
      emit_plain(st: st, code: code, op: o);
    } else {
      set fused_cmp = negate_compare(code: cmp);
      set cond = fa;
      set fused_b = fb;
      let a16 = slot16(value: fa);
      let b16 = slot16(value: fb);
      let o = fused_branch(code: fused_cmp, a: a16, b: b16, t: 0_u32);
      emit_plain(st: st, code: code, op: o);
    }
    let height = provs^.inner.len -wrap p;
    let target = code^.inner.len;
    let marks = fixes^.inner.len;
    let c = Ctl(kind: 3_u64, height: height, params: p, brk: q, results: q, target: target, fixes: marks, else_at: else_at, c: cond, cmp: fused_cmp, fb: fused_b);
    push_ctl(cell: ctls, value: c);
    return 0_u64;
  }
  if op == 13_u8 {
    let depth = read_uleb(r: r, bytes: bytes);
    let below = provs^.inner.len -wrap 1_u64;
    let moves = branch_moves(st: st, depth: depth, height: below, ctls: ctls);
    let cmp = 0_u64;
    let fa = 0_u64;
    let fb = 0_u64;
    if bnot(moves) {
      let (c, a, b) = take_compare(st: st, provs: provs, code: code);
      set cmp = c;
      set fa = a;
      set fb = b;
    }
    let top = top_pos(provs: provs, depth: 0_u64);
    let cond = 0_u64;
    if cmp == 0_u64 {
      set cond = source(st: st, provs: provs, code: code, pos: top);
    }
    pop_prov(st: st, provs: provs, count: 1_u64);
    flush(st: st, provs: provs, code: code);
    let yes = True();
    let ok = emit_branch(st: st, depth: depth, cond: cond, cmp: cmp, fa: fa, fb: fb, conditional: yes, provs: provs, code: code, brtab: brtab, ctls: ctls, fixes: fixes);
    if ok {
