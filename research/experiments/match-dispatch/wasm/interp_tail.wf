      }
      if status == 2_u64 {
        return False();
      }
    }
  }
  let failed = r^.failed;
  if failed {
    return False();
  }
  return bnot(st.failed);
}

struct Loaded {
  ok: Bool;
  reason: u64;
  start: u64;
  pages: u64;
  max_pages: u64;
  data_at: u64;
  data_end: u64;
}

struct HostStep {
  sp: u64;
  exit: Bool;
  code: u64;
}

fn find_sections(bytes: &Box<Array<u8>>, size: u64, spans: &Box<Array<u64>>) -> ok: Bool reads(bytes), writes(spans) {
  doc "Checks the header and records each known section's span: spans[2 id] its start and spans[2 id + 1] its end.";
  if size < 8_u64 {
    return False();
  }
  if size > bytes^.inner.len {
    return False();
  }
  let magic = 1836278016_u64;
  let false_1 = False();
  let r = Reader(pos: 0_u64, end: size, failed: false_1);
  let m = read_fixed(r: &r, bytes: bytes, count: 4_u64);
  let v = read_fixed(r: &r, bytes: bytes, count: 4_u64);
  if m != magic {
    return False();
  }
  if v != 1_u64 {
    return False();
  }
  loop @sections {
    if r.pos >= size {
      break @sections;
    }
    let id = read_byte(r: &r, bytes: bytes);
    let length = read_uleb(r: &r, bytes: bytes);
    let at = r.pos;
    let room = size -wrap at;
    if length > room {
      return False();
    }
    let end = at +wrap length;
    let idw = cvt::<u8, u64>(id);
    if idw <= 12_u64 {
      let slot = idw * 2_u64;
      let slot_end = slot + 1_u64;
      if slot_end < spans^.inner.len {
        set spans^.inner[slot] = at;
        set spans^.inner[slot_end] = end;
      }
    }
    set r.pos = end;
    let failed = r.failed;
    if failed {
      return False();
    }
  }
  return True();
}

fn section(spans: &Box<Array<u64>>, id: u64) -> (start: u64, end: u64) reads(spans) {
  doc "A section's span, empty when absent.";
  let slot = id *wrap 2_u64;
  let slot_end = slot +wrap 1_u64;
  if slot_end < spans^.inner.len {
    if slot < spans^.inner.len {
      let s = spans^.inner[slot];
      let e = spans^.inner[slot_end];
      return s, e;
    }
  }
  return 0_u64, 0_u64;
}

fn refuse(why: u64) -> info: Loaded pure {
  doc "A refused module with the step that refused it.";
  let no = False();
  let info = Loaded(ok: no, reason: why, start: 0_u64, pages: 0_u64, max_pages: 0_u64, data_at: 0_u64, data_end: 0_u64);
  return info;
}

fn load(bytes: &Box<Array<u8>>, size: u64, types: &Box<Slots<FuncType>>, funcs: &Box<Slots<Func>>, table: &Box<Slots<u64>>, globals: &Box<Slots<u64>>, code: &Box<Slots<Op>>, brtab: &Box<Slots<Target>>, consts: &Box<Slots<u64>>) -> info: Loaded reads(bytes), writes(types), writes(funcs), writes(table), writes(globals), writes(code), writes(brtab), writes(consts) {
