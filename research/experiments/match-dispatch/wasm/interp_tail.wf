    pop_prov(st: st, provs: provs, count: 1_u64);
    flush(st: st, provs: provs, code: code);
    let ok = emit_table(r: r, bytes: bytes, st: st, cond: cond, provs: provs, code: code, brtab: brtab, ctls: ctls, fixes: fixes);
    set st^.dead = True();
    if ok {
      return 0_u64;
    }
    return 2_u64;
  }
  if op == 15_u8 {
    let k = st^.results;
    if k > 1_u64 {
      return 2_u64;
    }
    let first = top_pos(provs: provs, depth: 0_u64);
    if k == 0_u64 {
      set first = 0_u64;
    }
    let s = temp_slot(st: st, pos: first);
    if k != 0_u64 {
      set s = source(st: st, provs: provs, code: code, pos: first);
    }
    let s16 = slot16(value: s);
    let k16 = slot16(value: k);
    let l16 = slot16(value: st^.l);
    let o = Op::Return(s: s16, k: k16, l: l16);
    emit_plain(st: st, code: code, op: o);
    set st^.dead = True();
    return 0_u64;
  }
  flush(st: st, provs: provs, code: code);
  if op == 0_u8 {
    let o = Op::Unreachable();
    emit_plain(st: st, code: code, op: o);
    set st^.dead = True();
    return 0_u64;
  }
  let opening = False();
  if op == 2_u8 {
    set opening = True();
  }
  if op == 3_u8 {
    set opening = True();
  }
  if opening {
    let (p, q) = block_type(r: r, bytes: bytes, types: types);
    let else_at = 18446744073709551615_u64;
    let cond = 0_u64;
    let fused_cmp = 0_u64;
    let fused_b = 0_u64;
    let kind = 1_u64;
    let brk = q;
    if op == 3_u8 {
      set kind = 2_u64;
      set brk = p;
    }
    let height = provs^.inner.len -wrap p;
    let target = code^.inner.len;
    set st^.last = 18446744073709551615_u64;
    let marks = fixes^.inner.len;
    let c = Ctl(kind: kind, height: height, params: p, brk: brk, results: q, target: target, fixes: marks, else_at: else_at, c: cond, cmp: fused_cmp, fb: fused_b);
    push_ctl(cell: ctls, value: c);
    return 0_u64;
  }
  if op == 5_u8 {
    let n = ctls^.inner.len;
    if n == 0_u64 {
      return 2_u64;
    }
    let top = n - 1_u64;
    let c = ctls^.inner[top];
    if c.kind != 3_u64 {
      return 2_u64;
    }
    let at = code^.inner.len;
    let no = False();
    let jump = Pending(depth: top, at: at, table: no, form: 0_u64, s: 0_u64, d: 0_u64, c: 0_u64);
    push_pending(cell: fixes, value: jump);
    let o = Op::Jump(t: 0_u32);
    emit_plain(st: st, code: code, op: o);
    let here = code^.inner.len;
    let no2 = False();
    let unless = if c.cmp == 0_u64 {
      give Pending(depth: top, at: c.else_at, table: no2, form: 4_u64, s: 0_u64, d: 0_u64, c: c.c);
    } else {
      give Pending(depth: top, at: c.else_at, table: no2, form: 5_u64, s: c.c, d: c.fb, c: c.cmp);
    }
    patch(code: code, brtab: brtab, p: unless, target: here);
    if top < ctls^.inner.len {
      set ctls^.inner[top].else_at = 18446744073709551615_u64;
    }
    let height = c.height +wrap c.params;
    set_height(st: st, provs: provs, height: height);
    set st^.dead = False();
    return 0_u64;
  }
  if op == 12_u8 {
    let depth = read_uleb(r: r, bytes: bytes);
    let no = False();
    let ok = emit_branch(st: st, depth: depth, cond: 0_u64, cmp: 0_u64, fa: 0_u64, fb: 0_u64, conditional: no, provs: provs, code: code, brtab: brtab, ctls: ctls, fixes: fixes);
    set st^.dead = True();
    if ok {
      return 0_u64;
    }
    return 2_u64;
  }
  if op == 16_u8 {
    let fi = read_uleb(r: r, bytes: bytes);
    if fi >= funcs^.inner.len {
      return 2_u64;
    }
    let callee = funcs^.inner[fi];
    let h = provs^.inner.len;
    let np = callee.params;
    if np > h {
      return 2_u64;
    }
    let first = h - np;
    let at = temp_slot(st: st, pos: first);
    let at16 = slot16(value: at);
    if callee.host != 0_u64 {
      let id = slot16(value: callee.host);
      let o = Op::Host(id: id, at: at16);
      emit_plain(st: st, code: code, op: o);
    } else {
      let f32v = narrow(value: fi);
      let o = Op::Call(f: f32v, at: at16);
      emit_plain(st: st, code: code, op: o);
    }
    pop_prov(st: st, provs: provs, count: callee.params);
    for (i in 0_u64..callee.results) {
      push_temp(st: st, provs: provs);
