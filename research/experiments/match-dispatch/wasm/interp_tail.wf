fn load_u32(mem: &Box<Array<u8>>, at: u64) -> v: u64 reads(mem) {
  doc "A little-endian u32 from memory, or the largest u64 outside it.";
  let len = mem^.inner.len;
  if len < 4_u64 {
    return 18446744073709551615_u64;
  }
  let room = len - 4_u64;
  if at > room {
    return 18446744073709551615_u64;
  }
  let value = 0_u64;
  for (i in 0_u64..4_u64) {
    let p = at + i;
    let b = mem^.inner[p];
    let bw = cvt::<u8, u64>(b);
    let i8w = i * 8_u64;
    let s = cvt.wrap::<u64, u32>(i8w);
    let part = ishl.wrap(bw, s);
    set value = ior(value, part);
  }
  return value;
}

fn store_bytes(mem: &Box<Array<u8>>, at: u64, value: u64, count: u64) -> ok: Bool writes(mem) {
  doc "Stores the low count bytes of value little-endian.";
  let len = mem^.inner.len;
  if count > len {
    return False();
  }
  let room = len - count;
  if at > room {
    return False();
  }
  for (i in 0_u64..count) {
    let p = at + i;
    let i8w = i *wrap 8_u64;
    let s = cvt.wrap::<u64, u32>(i8w);
    let shifted = ishr.wrap(value, s);
    let b = cvt.wrap::<u64, u8>(shifted);
    set mem^.inner[p] = b;
  }
  return True();
}

fn write_all(files: &HandleFactory, out: &OutputStream, mem: &Box<Array<u8>>, from: u64, to: u64) -> ok: Bool reads(mem), writes(files), writes(out) waits {
  doc "Writes the memory bytes from from to to.";
  let len = mem^.inner.len;
  if to > len {
    return False();
  }
  if from > to {
    return False();
  }
  let at = from;
  let none = None<Instant>();
  loop @writing {
    if at >= to {
      break @writing;
    }
    match write_once(factory: files, output: out, source: &mem^.inner[0_u64..len], start: at, end: to, deadline: none) {
      Ok(value: next) => {
        if next == at {
          return False();
        }
        set at = next;
      }
      Err(error: problem) => {
        return False();
      }
    }
  }
  return True();
}

fn host_arity(id: u32) -> n: u64 pure {
  doc "How many arguments a WASI function takes.";
  if id == 1_u32 {
    return 2_u64;
  }
  if id == 2_u32 {
    return 2_u64;
  }
  if id == 3_u32 {
    return 3_u64;
  }
  if id == 4_u32 {
    return 1_u64;
  }
  if id == 5_u32 {
    return 2_u64;
  }
  if id == 6_u32 {
    return 4_u64;
  }
  if id == 7_u32 {
    return 4_u64;
  }
  return 1_u64;
}

fn host_call(id: u32, sp: u64, stack: &Box<Array<u64>>, mem: &Box<Array<u8>>, args: &Args, files: &HandleFactory, out: &OutputStream, err: &OutputStream, clock: &Clock, origin: Instant) -> step: HostStep reads(args), writes(stack), writes(mem), writes(files), writes(out), writes(err), writes(clock) waits {
