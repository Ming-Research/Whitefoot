    let cursor = a1;
    for (i in 1_u64..argc) {
      let slot_index = i -wrap 1_u64;
      let slot_offset = slot_index *wrap 4_u64;
      let slot = a0 +wrap slot_offset;
      let pointed = store_bytes(mem: mem, at: slot, value: cursor, count: 4_u64);
      if bnot(pointed) {
        set errno = 21_u64;
      }
      match arg_get(args: args, position: i) {
        Ok(value: text) => {
          let length = host_bytes_len(value: &text);
          let len = mem^.inner.len;
          let end = cursor +wrap length;
          let fits = end < len;
          let ordered = cursor <= end;
          let good = band(fits, ordered);
          if good {
            match host_copy_bytes(value: &text, destination: &mem^.inner[0_u64..len], start: cursor, end: end) {
              Ok(value: next) => {
