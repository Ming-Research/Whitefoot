struct Reader {
  pos: u64;
  end: u64;
  failed: Bool;
}

struct FuncType {
  params: u64;
  results: u64;
  start: u64;
  end: u64;
  canon: u64;
}

struct Ctl {
  kind: u64;
  height: u64;
  params: u64;
  brk: u64;
  results: u64;
  target: u64;
  fixes: u64;
  else_at: u64;
}

struct Trans {
  h: u64;
  dead: Bool;
  skip: u64;
  base: u64;
  l: u64;
  results: u64;
}

fn fail(r: &Reader) -> v: u64 writes(r) {
  doc "Marks the reader failed and returns zero.";
  set r^.failed = True();
  return 0_u64;
}

fn read_byte(r: &Reader, bytes: &Box<Array<u8>>) -> b: u8 reads(bytes), writes(r) {
  doc "The next byte below the reader's end, or zero with the reader failed.";
  let p = r^.pos;
  let e = r^.end;
  if p < e {
    if p < bytes^.inner.len {
      let v = bytes^.inner[p];
      set r^.pos = p + 1_u64;
      return v;
    }
  }
  set r^.failed = True();
  return 0_u8;
}

fn read_uleb(r: &Reader, bytes: &Box<Array<u8>>) -> v: u64 reads(bytes), writes(r) {
  doc "An unsigned LEB128 value of at most ten bytes.";
  let value = 0_u64;
  let shift = 0_u32;
  loop @more {
    let b = read_byte(r: r, bytes: bytes);
    let bw = cvt::<u8, u64>(b);
    let low = iand(bw, 127_u64);
    if shift < 64_u32 {
      let part = ishl.wrap(low, shift);
      set value = ior(value, part);
    }
    let cont = iand(bw, 128_u64);
    if cont == 0_u64 {
      break @more;
    }
    if shift >= 63_u32 {
      set r^.failed = True();
      break @more;
    }
    set shift = shift +wrap 7_u32;
  }
  return value;
}

fn read_sleb(r: &Reader, bytes: &Box<Array<u8>>) -> v: u64 reads(bytes), writes(r) {
  doc "A signed LEB128 value of at most ten bytes, sign-extended to 64 bits.";
  let value = 0_u64;
  let shift = 0_u32;
  let last = 0_u64;
  loop @more {
    let b = read_byte(r: r, bytes: bytes);
    let bw = cvt::<u8, u64>(b);
    set last = bw;
    let low = iand(bw, 127_u64);
    if shift < 64_u32 {
      let part = ishl.wrap(low, shift);
      set value = ior(value, part);
    }
    set shift = shift +wrap 7_u32;
    let cont = iand(bw, 128_u64);
    if cont == 0_u64 {
      break @more;
    }
    if shift >= 70_u32 {
      set r^.failed = True();
      break @more;
    }
  }
  let sign = iand(last, 64_u64);
  if sign != 0_u64 {
    if shift < 64_u32 {
      let ones = ishl.wrap(18446744073709551615_u64, shift);
      set value = ior(value, ones);
    }
  }
  return value;
}

fn read_fixed(r: &Reader, bytes: &Box<Array<u8>>, count: u64) -> v: u64 reads(bytes), writes(r) {
  doc "count little-endian bytes, count at most eight.";
  let value = 0_u64;
  for (i in 0_u64..count) {
    let b = read_byte(r: r, bytes: bytes);
    let bw = cvt::<u8, u64>(b);
    let i8w = i *wrap 8_u64;
    let s = cvt.wrap::<u64, u32>(i8w);
    let part = ishl.wrap(bw, s);
    set value = ior(value, part);
  }
  return value;
}

fn read_name(r: &Reader, bytes: &Box<Array<u8>>) -> h: u64 reads(bytes), writes(r) {
  doc "Reads a name and returns its 64-bit FNV-1a hash.";
  let length = read_uleb(r: r, bytes: bytes);
  let hash = 14695981039346656037_u64;
  let p = r^.pos;
  let e = r^.end;
  if p > e {
    return fail(r: r);
  }
  let room = e - p;
  if length > room {
    return fail(r: r);
  }
  for (i in 0_u64..length) {
    let b = read_byte(r: r, bytes: bytes);
    let bw = cvt::<u8, u64>(b);
    set hash = ixor(hash, bw);
    set hash = hash *wrap 1099511628211_u64;
  }
  return hash;
}

fn host_id(name: u64) -> id: u64 pure {
  doc "The WASI function a wasi_snapshot_preview1 import names, 1 through 8, or 9 for any other.";
  if name == 14248422641143363899_u64 {
    return 1_u64;
  }
  if name == 829219124291053014_u64 {
    return 2_u64;
  }
  if name == 4402587025017636220_u64 {
    return 3_u64;
  }
  if name == 12448045297844228476_u64 {
    return 4_u64;
  }
  if name == 17086530971551567055_u64 {
    return 5_u64;
  }
  if name == 3866961118529516736_u64 {
    return 6_u64;
  }
  if name == 10667629758217591639_u64 {
    return 7_u64;
  }
  if name == 9148826187533924178_u64 {
    return 8_u64;
  }
  return 9_u64;
}

fn push_op(code: &Box<Slots<Op>>, op: Op) -> r: unit writes(code) {
  doc "Appends an operation, doubling the store when full.";
  let length = code^.inner.len;
  let capacity = code^.inner.cap;
  if length >= capacity {
    let doubled = capacity +wrap capacity;
    let bigger = imax(doubled, 1024_u64);
    if bigger >= capacity {
      grow(cell: code, capacity: bigger);
    }
  }
  if code^.inner.len < code^.inner.cap {
    place_back(window: &code^.inner, value: op);
  }
  return unit;
}

fn push_target(brtab: &Box<Slots<Target>>, t: Target) -> r: unit writes(brtab) {
  doc "Appends a branch-table entry.";
  let length = brtab^.inner.len;
  let capacity = brtab^.inner.cap;
  if length >= capacity {
    let doubled = capacity +wrap capacity;
    let bigger = imax(doubled, 256_u64);
    if bigger >= capacity {
      grow(cell: brtab, capacity: bigger);
    }
  }
  if brtab^.inner.len < brtab^.inner.cap {
    place_back(window: &brtab^.inner, value: t);
  }
  return unit;
}

fn push_word(cell: &Box<Slots<u64>>, value: u64) -> r: unit writes(cell) {
  doc "Appends a word.";
  let length = cell^.inner.len;
  let capacity = cell^.inner.cap;
  if length >= capacity {
    let doubled = capacity +wrap capacity;
    let bigger = imax(doubled, 64_u64);
    if bigger >= capacity {
      grow(cell: cell, capacity: bigger);
    }
  }
  if cell^.inner.len < cell^.inner.cap {
    place_back(window: &cell^.inner, value: value);
  }
  return unit;
}

fn push_func(cell: &Box<Slots<Func>>, value: Func) -> r: unit writes(cell) {
  doc "Appends a function record.";
  let length = cell^.inner.len;
  let capacity = cell^.inner.cap;
  if length >= capacity {
    let doubled = capacity +wrap capacity;
    let bigger = imax(doubled, 64_u64);
    if bigger >= capacity {
      grow(cell: cell, capacity: bigger);
    }
  }
  if cell^.inner.len < cell^.inner.cap {
    place_back(window: &cell^.inner, value: value);
  }
  return unit;
}

fn push_type(cell: &Box<Slots<FuncType>>, value: FuncType) -> r: unit writes(cell) {
  doc "Appends a function type.";
  let length = cell^.inner.len;
  let capacity = cell^.inner.cap;
  if length >= capacity {
    let doubled = capacity +wrap capacity;
    let bigger = imax(doubled, 64_u64);
    if bigger >= capacity {
      grow(cell: cell, capacity: bigger);
    }
  }
  if cell^.inner.len < cell^.inner.cap {
    place_back(window: &cell^.inner, value: value);
  }
  return unit;
}

fn push_ctl(cell: &Box<Slots<Ctl>>, value: Ctl) -> r: unit writes(cell) {
  doc "Pushes a control frame of the translator.";
  let length = cell^.inner.len;
  let capacity = cell^.inner.cap;
  if length >= capacity {
    let doubled = capacity +wrap capacity;
    let bigger = imax(doubled, 64_u64);
    if bigger >= capacity {
      grow(cell: cell, capacity: bigger);
    }
  }
  if cell^.inner.len < cell^.inner.cap {
    place_back(window: &cell^.inner, value: value);
  }
  return unit;
}

fn same_bytes(bytes: &Box<Array<u8>>, a: u64, b: u64, length: u64) -> same: Bool reads(bytes) {
  doc "Whether the length bytes at a and at b are equal.";
  let len = bytes^.inner.len;
  if length > len {
    return False();
  }
  let room = len - length;
  if a > room {
    return False();
  }
  if b > room {
    return False();
  }
  for (i in 0_u64..length) {
    let x = a + i;
    let y = b + i;
    let bx = bytes^.inner[x];
    let by = bytes^.inner[y];
    if bx != by {
      return False();
    }
  }
  return True();
}

fn parse_types(r: &Reader, bytes: &Box<Array<u8>>, types: &Box<Slots<FuncType>>) -> ok: Bool reads(bytes), writes(r), writes(types) {
  doc "The type section: each function type's arity, its byte span and its canonical index, the first earlier type with the same bytes.";
  let count = read_uleb(r: r, bytes: bytes);
  for (i in 0_u64..count) {
    let form = read_byte(r: r, bytes: bytes);
    if form != 96_u8 {
      return False();
    }
    let start = r^.pos;
    let params = read_uleb(r: r, bytes: bytes);
    for (p in 0_u64..params) {
      let t = read_byte(r: r, bytes: bytes);
    }
    let results = read_uleb(r: r, bytes: bytes);
    for (q in 0_u64..results) {
      let t = read_byte(r: r, bytes: bytes);
    }
    let end = r^.pos;
    let failed = r^.failed;
    if failed {
      return False();
    }
    let span = end -wrap start;
    let canon = types^.inner.len;
    let known = types^.inner.len;
    for (j in 0_u64..known) {
      if j < types^.inner.len {
        let other = types^.inner[j];
        let other_span = other.end -wrap other.start;
        if other_span == span {
          let same = same_bytes(bytes: bytes, a: start, b: other.start, length: span);
          if same {
            if canon == known {
              set canon = other.canon;
            }
          }
        }
      }
    }
    let ft = FuncType(params: params, results: results, start: start, end: end, canon: canon);
    push_type(cell: types, value: ft);
  }
  let failed = r^.failed;
  return bnot(failed);
}

fn parse_imports(r: &Reader, bytes: &Box<Array<u8>>, types: &Box<Slots<FuncType>>, funcs: &Box<Slots<Func>>) -> ok: Bool reads(bytes), reads(types), writes(r), writes(funcs) {
  doc "The import section: function imports become host functions; any other import is refused.";
  let count = read_uleb(r: r, bytes: bytes);
  for (i in 0_u64..count) {
    let module_name = read_name(r: r, bytes: bytes);
    let field = read_name(r: r, bytes: bytes);
    let kind = read_byte(r: r, bytes: bytes);
    if kind != 0_u8 {
      return False();
    }
    let ti = read_uleb(r: r, bytes: bytes);
    if ti >= types^.inner.len {
      return False();
    }
    let ft = types^.inner[ti];
    let id = host_id(name: field);
    if module_name != 5630335187277993924_u64 {
      set id = 9_u64;
    }
    let f = Func(canon: ft.canon, start: 0_u64, params: ft.params, locals: 0_u64, results: ft.results, host: id);
    push_func(cell: funcs, value: f);
  }
  let failed = r^.failed;
  return bnot(failed);
}

fn parse_functions(r: &Reader, bytes: &Box<Array<u8>>, types: &Box<Slots<FuncType>>, funcs: &Box<Slots<Func>>) -> ok: Bool reads(bytes), reads(types), writes(r), writes(funcs) {
  doc "The function section: one record per defined function, its code filled in by translation.";
  let count = read_uleb(r: r, bytes: bytes);
  for (i in 0_u64..count) {
    let ti = read_uleb(r: r, bytes: bytes);
    if ti >= types^.inner.len {
      return False();
    }
    let ft = types^.inner[ti];
    let f = Func(canon: ft.canon, start: 0_u64, params: ft.params, locals: 0_u64, results: ft.results, host: 0_u64);
    push_func(cell: funcs, value: f);
  }
  let failed = r^.failed;
  return bnot(failed);
}

fn read_limits(r: &Reader, bytes: &Box<Array<u8>>) -> (min: u64, max: u64) reads(bytes), writes(r) {
  doc "A limits pair; the largest u64 stands for an absent maximum.";
  let flag = read_byte(r: r, bytes: bytes);
  let low = read_uleb(r: r, bytes: bytes);
  let high = 18446744073709551615_u64;
  let bounded = iand(flag, 1_u8);
  if bounded != 0_u8 {
    set high = read_uleb(r: r, bytes: bytes);
  }
  return low, high;
}

fn const_expr(r: &Reader, bytes: &Box<Array<u8>>, globals: &Box<Slots<u64>>) -> v: u64 reads(bytes), reads(globals), writes(r) {
  doc "A constant expression: one constant or global.get, then end.";
  let op = read_byte(r: r, bytes: bytes);
  let value = 0_u64;
  if op == 65_u8 {
    let s = read_sleb(r: r, bytes: bytes);
    set value = iand(s, 4294967295_u64);
  } else if op == 66_u8 {
    set value = read_sleb(r: r, bytes: bytes);
  } else if op == 67_u8 {
    set value = read_fixed(r: r, bytes: bytes, count: 4_u64);
  } else if op == 68_u8 {
    set value = read_fixed(r: r, bytes: bytes, count: 8_u64);
  } else if op == 35_u8 {
    let gi = read_uleb(r: r, bytes: bytes);
    if gi < globals^.inner.len {
      set value = globals^.inner[gi];
    } else {
      return fail(r: r);
    }
  } else {
    return fail(r: r);
  }
  let finish = read_byte(r: r, bytes: bytes);
  if finish != 11_u8 {
    return fail(r: r);
  }
  return value;
}

fn parse_globals(r: &Reader, bytes: &Box<Array<u8>>, globals: &Box<Slots<u64>>) -> ok: Bool reads(bytes), writes(r), writes(globals) {
  doc "The global section: each global's initial value.";
  let count = read_uleb(r: r, bytes: bytes);
  for (i in 0_u64..count) {
    let ty = read_byte(r: r, bytes: bytes);
    let mutable = read_byte(r: r, bytes: bytes);
    let v = const_expr(r: r, bytes: bytes, globals: globals);
    push_word(cell: globals, value: v);
  }
  let failed = r^.failed;
  return bnot(failed);
}

fn parse_exports(r: &Reader, bytes: &Box<Array<u8>>) -> start: u64 reads(bytes), writes(r) {
  doc "The export section: the index of the function exported as _start, or the largest u64.";
  let found = 18446744073709551615_u64;
  let count = read_uleb(r: r, bytes: bytes);
  for (i in 0_u64..count) {
    let name = read_name(r: r, bytes: bytes);
    let kind = read_byte(r: r, bytes: bytes);
    let index = read_uleb(r: r, bytes: bytes);
    if kind == 0_u8 {
      if name == 17613185073616922942_u64 {
        set found = index;
      }
    }
  }
  return found;
}

fn parse_elements(r: &Reader, bytes: &Box<Array<u8>>, globals: &Box<Slots<u64>>, table: &Box<Slots<u64>>) -> ok: Bool reads(bytes), reads(globals), writes(r), writes(table) {
  doc "The element section: active segments of function indices into table 0.";
  let count = read_uleb(r: r, bytes: bytes);
  for (i in 0_u64..count) {
    let flags = read_uleb(r: r, bytes: bytes);
    if flags != 0_u64 {
      return False();
    }
    let offset = const_expr(r: r, bytes: bytes, globals: globals);
    let n = read_uleb(r: r, bytes: bytes);
    for (j in 0_u64..n) {
      let fi = read_uleb(r: r, bytes: bytes);
      let at = offset +wrap j;
      if at < table^.inner.len {
        set table^.inner[at] = fi;
      } else {
        return False();
      }
    }
  }
  let failed = r^.failed;
  return bnot(failed);
}

fn parse_data(r: &Reader, bytes: &Box<Array<u8>>, globals: &Box<Slots<u64>>, mem: &Box<Array<u8>>) -> ok: Bool reads(bytes), reads(globals), writes(r), writes(mem) {
  doc "The data section: active segments copied into memory 0; passive segments are skipped.";
  let count = read_uleb(r: r, bytes: bytes);
  for (i in 0_u64..count) {
    let flags = read_uleb(r: r, bytes: bytes);
    let offset = 0_u64;
    let active = True();
    if flags == 0_u64 {
      set offset = const_expr(r: r, bytes: bytes, globals: globals);
    } else if flags == 2_u64 {
      let mi = read_uleb(r: r, bytes: bytes);
      set offset = const_expr(r: r, bytes: bytes, globals: globals);
    } else if flags == 1_u64 {
      set active = False();
    } else {
      return False();
    }
    let n = read_uleb(r: r, bytes: bytes);
    for (j in 0_u64..n) {
      let b = read_byte(r: r, bytes: bytes);
      if active {
        let at = offset +wrap j;
        if at < mem^.inner.len {
          set mem^.inner[at] = b;
        } else {
          return False();
        }
      }
    }
  }
  let failed = r^.failed;
  return bnot(failed);
}

struct Pending {
  depth: u64;
  at: u64;
  table: Bool;
  form: u64;
  h: u64;
  k: u64;
}

fn push_pending(cell: &Box<Slots<Pending>>, value: Pending) -> r: unit writes(cell) {
  doc "Records a forward branch to patch when its label's block ends.";
  let length = cell^.inner.len;
  let capacity = cell^.inner.cap;
  if length >= capacity {
    let doubled = capacity +wrap capacity;
    let bigger = imax(doubled, 64_u64);
    if bigger >= capacity {
      grow(cell: cell, capacity: bigger);
    }
  }
  if cell^.inner.len < cell^.inner.cap {
    place_back(window: &cell^.inner, value: value);
  }
  return unit;
}

fn narrow(value: u64) -> n: u32 pure {
  doc "The low 32 bits of a translator quantity.";
  return cvt.wrap::<u64, u32>(value);
}

fn branch_op(form: u64, target: u64, h: u64, k: u64) -> op: Op pure {
  doc "The branch operation of a form: 0 Jump, 1 Br, 2 BrIf, 3 BrIfJ, 4 BrUnless.";
  let t = narrow(value: target);
  let hh = narrow(value: h);
  let kk = narrow(value: k);
  if form == 1_u64 {
    let o = Op::Br(t: t, h: hh, k: kk);
    return o;
  }
  if form == 2_u64 {
    let o = Op::BrIf(t: t, h: hh, k: kk);
    return o;
  }
  if form == 3_u64 {
    let o = Op::BrIfJ(t: t);
    return o;
  }
  if form == 4_u64 {
    let o = Op::BrUnless(t: t);
    return o;
  }
  let o = Op::Jump(t: t);
  return o;
}

fn patch(code: &Box<Slots<Op>>, brtab: &Box<Slots<Target>>, p: Pending, target: u64) -> r: unit writes(code), writes(brtab) {
  doc "Points a recorded forward branch at target.";
  let at = p.at;
  if p.table {
    if at < brtab^.inner.len {
      let t = narrow(value: target);
      let hh = narrow(value: p.h);
      let kk = narrow(value: p.k);
      let entry_value = Target(t: t, h: hh, k: kk);
      set brtab^.inner[at] = entry_value;
    }
    return unit;
  }
  if at < code^.inner.len {
    let o = branch_op(form: p.form, target: target, h: p.h, k: p.k);
    set code^.inner[at] = o;
  }
  return unit;
}

fn block_type(r: &Reader, bytes: &Box<Array<u8>>, types: &Box<Slots<FuncType>>) -> (params: u64, results: u64) reads(bytes), reads(types), writes(r) {
  doc "A block type: empty, one value type, or a type index.";
  let pos = r^.pos;
  let b = read_byte(r: r, bytes: bytes);
  if b == 64_u8 {
    return 0_u64, 0_u64;
  }
  let one = False();
  if b == 127_u8 {
    set one = True();
  }
  if b == 126_u8 {
    set one = True();
  }
  if b == 125_u8 {
    set one = True();
  }
  if b == 124_u8 {
    set one = True();
  }
  if b == 123_u8 {
    set one = True();
  }
  if b == 112_u8 {
    set one = True();
  }
  if b == 111_u8 {
    set one = True();
  }
  if one {
    return 0_u64, 1_u64;
  }
  set r^.pos = pos;
  let index = read_sleb(r: r, bytes: bytes);
  if index < types^.inner.len {
    let ft = types^.inner[index];
    return ft.params, ft.results;
  }
  set r^.failed = True();
  return 0_u64, 0_u64;
}

fn skip_immediates(r: &Reader, bytes: &Box<Array<u8>>, op: u8) -> done: unit reads(bytes), writes(r) {
  doc "Skips the immediates of an operation in unreachable code.";
  let one_uleb = False();
  if op == 12_u8 {
    set one_uleb = True();
  }
  if op == 13_u8 {
    set one_uleb = True();
  }
  if op == 16_u8 {
    set one_uleb = True();
  }
  if op >= 32_u8 {
    if op <= 36_u8 {
      set one_uleb = True();
    }
  }
  if one_uleb {
    let v = read_uleb(r: r, bytes: bytes);
    return unit;
  }
  if op == 14_u8 {
    let n = read_uleb(r: r, bytes: bytes);
    let p = r^.pos;
    let e = r^.end;
    let room = e -wrap p;
    if n >= room {
      set r^.failed = True();
      return unit;
    }
    let total = n + 1_u64;
    for (i in 0_u64..total) {
      let v = read_uleb(r: r, bytes: bytes);
    }
    return unit;
  }
  if op == 17_u8 {
    let a = read_uleb(r: r, bytes: bytes);
    let b = read_uleb(r: r, bytes: bytes);
    return unit;
  }
  if op == 28_u8 {
    let n = read_uleb(r: r, bytes: bytes);
    let p = r^.pos;
    let e = r^.end;
    let room = e -wrap p;
    if n > room {
      set r^.failed = True();
      return unit;
    }
    for (i in 0_u64..n) {
      let t = read_byte(r: r, bytes: bytes);
    }
    return unit;
  }
  if op >= 40_u8 {
    if op <= 62_u8 {
      let a = read_uleb(r: r, bytes: bytes);
      let b = read_uleb(r: r, bytes: bytes);
      return unit;
    }
  }
  if op == 63_u8 {
    let b = read_byte(r: r, bytes: bytes);
    return unit;
  }
  if op == 64_u8 {
    let b = read_byte(r: r, bytes: bytes);
    return unit;
  }
  if op == 65_u8 {
    let v = read_sleb(r: r, bytes: bytes);
    return unit;
  }
  if op == 66_u8 {
    let v = read_sleb(r: r, bytes: bytes);
    return unit;
  }
  if op == 67_u8 {
    let v = read_fixed(r: r, bytes: bytes, count: 4_u64);
    return unit;
  }
  if op == 68_u8 {
    let v = read_fixed(r: r, bytes: bytes, count: 8_u64);
    return unit;
  }
  if op == 252_u8 {
    let sub = read_uleb(r: r, bytes: bytes);
    if sub == 8_u64 {
      let a = read_uleb(r: r, bytes: bytes);
      let b = read_byte(r: r, bytes: bytes);
    }
    if sub == 9_u64 {
      let a = read_uleb(r: r, bytes: bytes);
    }
    if sub == 10_u64 {
      let a = read_byte(r: r, bytes: bytes);
      let b = read_byte(r: r, bytes: bytes);
    }
    if sub == 11_u64 {
      let a = read_byte(r: r, bytes: bytes);
    }
    if sub == 12_u64 {
      let a = read_uleb(r: r, bytes: bytes);
      let b = read_uleb(r: r, bytes: bytes);
    }
    if sub == 14_u64 {
      let a = read_uleb(r: r, bytes: bytes);
      let b = read_uleb(r: r, bytes: bytes);
    }
    if sub == 13_u64 {
      let a = read_uleb(r: r, bytes: bytes);
    }
    if sub >= 15_u64 {
      if sub <= 17_u64 {
        let a = read_uleb(r: r, bytes: bytes);
      }
    }
    return unit;
  }
  return unit;
}

fn emit_branch(st: &Trans, depth: u64, conditional: Bool, code: &Box<Slots<Op>>, ctls: &Box<Slots<Ctl>>, fixes: &Box<Slots<Pending>>) -> ok: Bool reads(st), reads(ctls), writes(code), writes(fixes) {
  doc "A branch to the label depth frames out: a plain jump when the operands already sit at the label's height, a moving branch otherwise; a block's target is patched at its end, a loop's is known.";
  let nctl = ctls^.inner.len;
  if depth >= nctl {
    return False();
  }
  let up = nctl - depth;
  let ci = up - 1_u64;
  let c = ctls^.inner[ci];
  let k = c.brk;
  if k > 1_u64 {
    return False();
  }
  let dest = c.height;
  let reached = dest +wrap k;
  let fits = st^.h == reached;
  let hh = st^.base +wrap dest;
  let form = 1_u64;
  if fits {
    set form = 0_u64;
  }
  if conditional {
    set form = 3_u64 -wrap form;
  }
  let target = 0_u64;
  if c.kind == 2_u64 {
    set target = c.target;
  } else {
    let at = code^.inner.len;
    let false_1 = False();
    let p = Pending(depth: ci, at: at, table: false_1, form: form, h: hh, k: k);
    push_pending(cell: fixes, value: p);
  }
  let o = branch_op(form: form, target: target, h: hh, k: k);
  push_op(code: code, op: o);
  return True();
}

fn emit_table(r: &Reader, bytes: &Box<Array<u8>>, st: &Trans, code: &Box<Slots<Op>>, brtab: &Box<Slots<Target>>, ctls: &Box<Slots<Ctl>>, fixes: &Box<Slots<Pending>>) -> ok: Bool reads(bytes), reads(st), reads(ctls), writes(r), writes(code), writes(brtab), writes(fixes) {
  doc "br_table: the table's entries go to the branch table, each moving its label's results to the label's height.";
  let n = read_uleb(r: r, bytes: bytes);
  let p = r^.pos;
  let e = r^.end;
  let room = e -wrap p;
  if n >= room {
    return False();
  }
  let start = brtab^.inner.len;
  let s32 = narrow(value: start);
  let n32 = narrow(value: n);
  let o = Op::BrTable(start: s32, count: n32);
  push_op(code: code, op: o);
  let total = n + 1_u64;
  for (j in 0_u64..total) {
    let depth = read_uleb(r: r, bytes: bytes);
    let nctl = ctls^.inner.len;
    if depth >= nctl {
      return False();
    }
    let up = nctl - depth;
    let ci = up - 1_u64;
    let c = ctls^.inner[ci];
    let k = c.brk;
    if k > 1_u64 {
      return False();
    }
    let hh = st^.base +wrap c.height;
    let target = 0_u64;
    if c.kind == 2_u64 {
      set target = c.target;
    } else {
      let at = brtab^.inner.len;
      let true_2 = True();
      let pend = Pending(depth: ci, at: at, table: true_2, form: 0_u64, h: hh, k: k);
      push_pending(cell: fixes, value: pend);
    }
    let t32 = narrow(value: target);
    let h32 = narrow(value: hh);
    let k32 = narrow(value: k);
    let tv = Target(t: t32, h: h32, k: k32);
    push_target(brtab: brtab, t: tv);
  }
  let failed = r^.failed;
  return bnot(failed);
}

fn end_block(st: &Trans, code: &Box<Slots<Op>>, brtab: &Box<Slots<Target>>, ctls: &Box<Slots<Ctl>>, fixes: &Box<Slots<Pending>>) -> status: u64 writes(st), writes(code), writes(brtab), writes(ctls), writes(fixes) {
  doc "end: patches the branches to the closing block and returns 0, or emits the function's return and returns 1; 2 reports a malformed body.";
  if ctls^.inner.len == 0_u64 {
    return 2_u64;
  }
  let c = take_back(window: &ctls^.inner);
  let depth = ctls^.inner.len;
  let here = code^.inner.len;
  if c.kind == 3_u64 {
    if c.else_at != 18446744073709551615_u64 {
      let false_3 = False();
      let p = Pending(depth: depth, at: c.else_at, table: false_3, form: 4_u64, h: 0_u64, k: 0_u64);
      patch(code: code, brtab: brtab, p: p, target: here);
    }
  }
  let keep = c.fixes;
  let from = c.fixes;
  let total = fixes^.inner.len;
  for (i in from..total) {
    if i < fixes^.inner.len {
      let f = fixes^.inner[i];
      if f.depth == depth {
        patch(code: code, brtab: brtab, p: f, target: here);
      } else if keep < fixes^.inner.len {
        set fixes^.inner[keep] = f;
        set keep = keep +wrap 1_u64;
      }
    }
  }
  loop @trim {
    if fixes^.inner.len <= keep {
      break @trim;
    }
    let gone = take_back(window: &fixes^.inner);
  }
  set st^.h = c.height +wrap c.results;
  set st^.dead = False();
  if c.kind == 0_u64 {
    let k32 = narrow(value: st^.results);
    let l32 = narrow(value: st^.l);
    let o = Op::Return(k: k32, l: l32);
    push_op(code: code, op: o);
    return 1_u64;
  }
  return 0_u64;
}

fn step_control(op: u8, st: &Trans, r: &Reader, bytes: &Box<Array<u8>>, funcs: &Box<Slots<Func>>, types: &Box<Slots<FuncType>>, code: &Box<Slots<Op>>, brtab: &Box<Slots<Target>>, ctls: &Box<Slots<Ctl>>, fixes: &Box<Slots<Pending>>) -> status: u64 reads(bytes), reads(funcs), reads(types), writes(st), writes(r), writes(code), writes(brtab), writes(ctls), writes(fixes) {
  doc "Control operations 0x00 through 0x11: 0 to continue, 1 at the function's end, 2 when malformed or unsupported.";
  if op == 0_u8 {
    let o = Op::Unreachable();
    push_op(code: code, op: o);
    set st^.dead = True();
    return 0_u64;
  }
  if op == 1_u8 {
    return 0_u64;
  }
  let opening = False();
  if op == 2_u8 {
    set opening = True();
  }
  if op == 3_u8 {
    set opening = True();
  }
  if op == 4_u8 {
    set opening = True();
  }
  if opening {
    let (p, q) = block_type(r: r, bytes: bytes, types: types);
    let else_at = 18446744073709551615_u64;
    let kind = 1_u64;
    if op == 4_u8 {
      set kind = 3_u64;
      set st^.h = st^.h -wrap 1_u64;
      set else_at = code^.inner.len;
      let o = Op::BrUnless(t: 0_u32);
      push_op(code: code, op: o);
    }
    let brk = q;
    if op == 3_u8 {
      set kind = 2_u64;
      set brk = p;
    }
    let height = st^.h -wrap p;
    let target = code^.inner.len;
    let marks = fixes^.inner.len;
    let c = Ctl(kind: kind, height: height, params: p, brk: brk, results: q, target: target, fixes: marks, else_at: else_at);
    push_ctl(cell: ctls, value: c);
    return 0_u64;
  }
  if op == 5_u8 {
    let n = ctls^.inner.len;
    if n == 0_u64 {
      return 2_u64;
    }
    let top = n - 1_u64;
    let c = ctls^.inner[top];
    if c.kind != 3_u64 {
      return 2_u64;
    }
    let at = code^.inner.len;
    let false_4 = False();
    let jump = Pending(depth: top, at: at, table: false_4, form: 0_u64, h: 0_u64, k: 0_u64);
    push_pending(cell: fixes, value: jump);
    let o = Op::Jump(t: 0_u32);
    push_op(code: code, op: o);
    let here = code^.inner.len;
    let false_5 = False();
    let unless = Pending(depth: top, at: c.else_at, table: false_5, form: 4_u64, h: 0_u64, k: 0_u64);
    patch(code: code, brtab: brtab, p: unless, target: here);
    if top < ctls^.inner.len {
      set ctls^.inner[top].else_at = 18446744073709551615_u64;
    }
    set st^.h = c.height +wrap c.params;
    set st^.dead = False();
    return 0_u64;
  }
  if op == 11_u8 {
    return end_block(st: st, code: code, brtab: brtab, ctls: ctls, fixes: fixes);
  }
  if op == 12_u8 {
    let depth = read_uleb(r: r, bytes: bytes);
    let no = False();
    let ok = emit_branch(st: st, depth: depth, conditional: no, code: code, ctls: ctls, fixes: fixes);
    set st^.dead = True();
    if ok {
      return 0_u64;
    }
    return 2_u64;
  }
  if op == 13_u8 {
    let depth = read_uleb(r: r, bytes: bytes);
    set st^.h = st^.h -wrap 1_u64;
    let yes = True();
    let ok = emit_branch(st: st, depth: depth, conditional: yes, code: code, ctls: ctls, fixes: fixes);
    if ok {
      return 0_u64;
    }
    return 2_u64;
  }
  if op == 14_u8 {
    set st^.h = st^.h -wrap 1_u64;
    let ok = emit_table(r: r, bytes: bytes, st: st, code: code, brtab: brtab, ctls: ctls, fixes: fixes);
    set st^.dead = True();
    if ok {
      return 0_u64;
    }
    return 2_u64;
  }
  if op == 15_u8 {
    let k32 = narrow(value: st^.results);
    let l32 = narrow(value: st^.l);
    let o = Op::Return(k: k32, l: l32);
    push_op(code: code, op: o);
    set st^.dead = True();
    return 0_u64;
  }
  if op == 16_u8 {
    let fi = read_uleb(r: r, bytes: bytes);
    if fi >= funcs^.inner.len {
      return 2_u64;
    }
    let callee = funcs^.inner[fi];
    if callee.host != 0_u64 {
      let id = narrow(value: callee.host);
      let o = Op::Host(id: id);
      push_op(code: code, op: o);
    } else {
      let f32v = narrow(value: fi);
      let o = Op::Call(f: f32v);
      push_op(code: code, op: o);
    }
    let lowered = st^.h -wrap callee.params;
    set st^.h = lowered +wrap callee.results;
    return 0_u64;
  }
  if op == 17_u8 {
    let ti = read_uleb(r: r, bytes: bytes);
    let tbl = read_uleb(r: r, bytes: bytes);
    if ti >= types^.inner.len {
      return 2_u64;
    }
    let ft = types^.inner[ti];
    let canon = narrow(value: ft.canon);
    let o = Op::CallIndirect(canon: canon);
    push_op(code: code, op: o);
    let popped = st^.h -wrap 1_u64;
    let lowered = popped -wrap ft.params;
    set st^.h = lowered +wrap ft.results;
    return 0_u64;
  }
  return 2_u64;
}

fn step_data(op: u8, st: &Trans, r: &Reader, bytes: &Box<Array<u8>>, code: &Box<Slots<Op>>) -> status: u64 reads(bytes), writes(st), writes(r), writes(code) {
  doc "Parametric, variable, memory and constant operations, 0x1a through 0x44.";
  if op == 26_u8 {
    let o = Op::Drop();
    push_op(code: code, op: o);
    set st^.h = st^.h -wrap 1_u64;
    return 0_u64;
  }
  let picks = False();
  if op == 27_u8 {
    set picks = True();
  }
  if op == 28_u8 {
    let n = read_uleb(r: r, bytes: bytes);
    if n > 1_u64 {
      return 2_u64;
    }
    for (i in 0_u64..n) {
      let t = read_byte(r: r, bytes: bytes);
    }
    set picks = True();
  }
  if picks {
    let o = Op::Select();
    push_op(code: code, op: o);
    set st^.h = st^.h -wrap 2_u64;
    return 0_u64;
  }
  if op >= 32_u8 {
    if op <= 36_u8 {
      let index = read_uleb(r: r, bytes: bytes);
      let i32v = narrow(value: index);
      if op == 32_u8 {
        let o = Op::LocalGet(i: i32v);
        push_op(code: code, op: o);
        set st^.h = st^.h +wrap 1_u64;
      }
      if op == 33_u8 {
        let o = Op::LocalSet(i: i32v);
        push_op(code: code, op: o);
        set st^.h = st^.h -wrap 1_u64;
      }
      if op == 34_u8 {
        let o = Op::LocalTee(i: i32v);
        push_op(code: code, op: o);
      }
      if op == 35_u8 {
        let o = Op::GlobalGet(i: i32v);
        push_op(code: code, op: o);
        set st^.h = st^.h +wrap 1_u64;
      }
      if op == 36_u8 {
        let o = Op::GlobalSet(i: i32v);
        push_op(code: code, op: o);
        set st^.h = st^.h -wrap 1_u64;
      }
      return 0_u64;
    }
  }
  if op >= 40_u8 {
    if op <= 62_u8 {
      let align = read_uleb(r: r, bytes: bytes);
      let offset = read_uleb(r: r, bytes: bytes);
      if offset > 4294967295_u64 {
        return 2_u64;
      }
      let o32 = narrow(value: offset);
      match load_op(code: op, offset: o32) {
        Some(value: o) => {
          push_op(code: code, op: o);
        }
        None() => {
          return 2_u64;
        }
      }
      if op >= 54_u8 {
        set st^.h = st^.h -wrap 2_u64;
      }
      return 0_u64;
    }
  }
  if op == 63_u8 {
    let b = read_byte(r: r, bytes: bytes);
    let o = Op::MemorySize();
    push_op(code: code, op: o);
    set st^.h = st^.h +wrap 1_u64;
    return 0_u64;
  }
  if op == 64_u8 {
    let b = read_byte(r: r, bytes: bytes);
    let o = Op::MemoryGrow();
    push_op(code: code, op: o);
    return 0_u64;
  }
  if op == 65_u8 {
    let v = read_sleb(r: r, bytes: bytes);
    let v32 = narrow(value: v);
    let o = Op::I32Const(v: v32);
    push_op(code: code, op: o);
    set st^.h = st^.h +wrap 1_u64;
    return 0_u64;
  }
  if op == 66_u8 {
    let v = read_sleb(r: r, bytes: bytes);
    let o = Op::I64Const(v: v);
    push_op(code: code, op: o);
    set st^.h = st^.h +wrap 1_u64;
    return 0_u64;
  }
  if op == 67_u8 {
    let v = read_fixed(r: r, bytes: bytes, count: 4_u64);
    let v32 = narrow(value: v);
    let o = Op::I32Const(v: v32);
    push_op(code: code, op: o);
    set st^.h = st^.h +wrap 1_u64;
    return 0_u64;
  }
  if op == 68_u8 {
    let v = read_fixed(r: r, bytes: bytes, count: 8_u64);
    let o = Op::I64Const(v: v);
    push_op(code: code, op: o);
    set st^.h = st^.h +wrap 1_u64;
    return 0_u64;
  }
  return 2_u64;
}

fn step_numeric(op: u8, st: &Trans, r: &Reader, bytes: &Box<Array<u8>>, code: &Box<Slots<Op>>) -> status: u64 reads(bytes), writes(st), writes(r), writes(code) {
  doc "Numeric operations 0x45 through 0xc4 and the 0xfc prefix; the zero-extension and reinterpretations need no operation, the representation already holding their result.";
  if op == 252_u8 {
    let sub = read_uleb(r: r, bytes: bytes);
    if sub < 8_u64 {
      match saturating_op(sub: sub) {
        Some(value: o) => {
          push_op(code: code, op: o);
          return 0_u64;
        }
        None() => {
          return 2_u64;
        }
      }
    }
    if sub == 10_u64 {
      let a = read_byte(r: r, bytes: bytes);
      let b = read_byte(r: r, bytes: bytes);
      let o = Op::MemoryCopy();
      push_op(code: code, op: o);
      set st^.h = st^.h -wrap 3_u64;
      return 0_u64;
    }
    if sub == 11_u64 {
      let a = read_byte(r: r, bytes: bytes);
      let o = Op::MemoryFill();
      push_op(code: code, op: o);
      set st^.h = st^.h -wrap 3_u64;
      return 0_u64;
    }
    return 2_u64;
  }
  if op == 173_u8 {
    return 0_u64;
  }
  if op >= 188_u8 {
    if op <= 191_u8 {
      return 0_u64;
    }
  }
  match numeric_op(code: op) {
    Some(value: o) => {
      push_op(code: code, op: o);
      let ins = numeric_inputs(code: op);
      let lowered = st^.h -wrap ins;
      set st^.h = lowered +wrap 1_u64;
      return 0_u64;
    }
    None() => {
      return 2_u64;
    }
  }
}

fn translate(r: &Reader, bytes: &Box<Array<u8>>, fi: u64, funcs: &Box<Slots<Func>>, types: &Box<Slots<FuncType>>, code: &Box<Slots<Op>>, brtab: &Box<Slots<Target>>, ctls: &Box<Slots<Ctl>>, fixes: &Box<Slots<Pending>>) -> ok: Bool reads(bytes), reads(types), writes(r), writes(funcs), writes(code), writes(brtab), writes(ctls), writes(fixes) {
  doc "Translates one function body, the reader bounded to it, into the operation store.";
  if fi >= funcs^.inner.len {
    return False();
  }
  let f = funcs^.inner[fi];
  let groups = read_uleb(r: r, bytes: bytes);
  let p0 = r^.pos;
  let e0 = r^.end;
  let room = e0 -wrap p0;
  if groups > room {
    return False();
  }
  let nl = 0_u64;
  for (g in 0_u64..groups) {
    let c = read_uleb(r: r, bytes: bytes);
    let t = read_byte(r: r, bytes: bytes);
    set nl = nl +wrap c;
    if nl > 1048576_u64 {
      return False();
    }
  }
  let l = f.params +wrap nl;
  let begin = code^.inner.len;
  if fi < funcs^.inner.len {
    set funcs^.inner[fi].locals = nl;
    set funcs^.inner[fi].start = begin;
  }
  loop @clear_ctls {
    if ctls^.inner.len == 0_u64 {
      break @clear_ctls;
    }
    let gone = take_back(window: &ctls^.inner);
  }
  loop @clear_fixes {
    if fixes^.inner.len == 0_u64 {
      break @clear_fixes;
    }
    let gone = take_back(window: &fixes^.inner);
  }
  let base = l +wrap 2_u64;
  let false_6 = False();
  let st = Trans(h: 0_u64, dead: false_6, skip: 0_u64, base: base, l: l, results: f.results);
  let top = Ctl(kind: 0_u64, height: 0_u64, params: 0_u64, brk: f.results, results: f.results, target: 0_u64, fixes: 0_u64, else_at: 18446744073709551615_u64);
  push_ctl(cell: ctls, value: top);
  loop @ops {
    let failed = r^.failed;
    if failed {
      return False();
    }
    let op = read_byte(r: r, bytes: bytes);
    let process = True();
    if st.dead {
      set process = False();
      let opening = False();
      if op == 2_u8 {
        set opening = True();
      }
      if op == 3_u8 {
        set opening = True();
      }
      if op == 4_u8 {
        set opening = True();
      }
      if opening {
        let (p, q) = block_type(r: r, bytes: bytes, types: types);
        set st.skip = st.skip +wrap 1_u64;
      } else if op == 11_u8 {
        if st.skip > 0_u64 {
          set st.skip = st.skip - 1_u64;
        } else {
          set process = True();
        }
      } else if op == 5_u8 {
        if st.skip == 0_u64 {
          set process = True();
        }
      } else {
        skip_immediates(r: r, bytes: bytes, op: op);
      }
    }
    if process {
      let status = 2_u64;
      if op <= 17_u8 {
        set status = step_control(op: op, st: &st, r: r, bytes: bytes, funcs: funcs, types: types, code: code, brtab: brtab, ctls: ctls, fixes: fixes);
      } else if op <= 68_u8 {
        set status = step_data(op: op, st: &st, r: r, bytes: bytes, code: code);
      } else {
        set status = step_numeric(op: op, st: &st, r: r, bytes: bytes, code: code);
      }
      if status == 1_u64 {
        break @ops;
      }
      if status == 2_u64 {
        return False();
      }
    }
  }
  let failed = r^.failed;
  return bnot(failed);
}

struct Loaded {
  ok: Bool;
  reason: u64;
  start: u64;
  pages: u64;
  max_pages: u64;
  data_at: u64;
  data_end: u64;
}

struct HostStep {
  sp: u64;
  exit: Bool;
  code: u64;
}

fn find_sections(bytes: &Box<Array<u8>>, size: u64, spans: &Box<Array<u64>>) -> ok: Bool reads(bytes), writes(spans) {
  doc "Checks the header and records each known section's span: spans[2 id] its start and spans[2 id + 1] its end.";
  if size < 8_u64 {
    return False();
  }
  if size > bytes^.inner.len {
    return False();
  }
  let magic = 1836278016_u64;
  let false_1 = False();
  let r = Reader(pos: 0_u64, end: size, failed: false_1);
  let m = read_fixed(r: &r, bytes: bytes, count: 4_u64);
  let v = read_fixed(r: &r, bytes: bytes, count: 4_u64);
  if m != magic {
    return False();
  }
  if v != 1_u64 {
    return False();
  }
  loop @sections {
    if r.pos >= size {
      break @sections;
    }
    let id = read_byte(r: &r, bytes: bytes);
    let length = read_uleb(r: &r, bytes: bytes);
    let at = r.pos;
    let room = size -wrap at;
    if length > room {
      return False();
    }
    let end = at +wrap length;
    let idw = cvt::<u8, u64>(id);
    if idw <= 12_u64 {
      let slot = idw * 2_u64;
      let slot_end = slot + 1_u64;
      if slot_end < spans^.inner.len {
        set spans^.inner[slot] = at;
        set spans^.inner[slot_end] = end;
      }
    }
    set r.pos = end;
    let failed = r.failed;
    if failed {
      return False();
    }
  }
  return True();
}

fn section(spans: &Box<Array<u64>>, id: u64) -> (start: u64, end: u64) reads(spans) {
  doc "A section's span, empty when absent.";
  let slot = id *wrap 2_u64;
  let slot_end = slot +wrap 1_u64;
  if slot_end < spans^.inner.len {
    if slot < spans^.inner.len {
      let s = spans^.inner[slot];
      let e = spans^.inner[slot_end];
      return s, e;
    }
  }
  return 0_u64, 0_u64;
}

fn refuse(why: u64) -> info: Loaded pure {
  doc "A refused module with the step that refused it.";
  let no = False();
  let info = Loaded(ok: no, reason: why, start: 0_u64, pages: 0_u64, max_pages: 0_u64, data_at: 0_u64, data_end: 0_u64);
  return info;
}

fn load(bytes: &Box<Array<u8>>, size: u64, types: &Box<Slots<FuncType>>, funcs: &Box<Slots<Func>>, table: &Box<Slots<u64>>, globals: &Box<Slots<u64>>, code: &Box<Slots<Op>>, brtab: &Box<Slots<Target>>) -> info: Loaded reads(bytes), writes(types), writes(funcs), writes(table), writes(globals), writes(code), writes(brtab) {
  doc "Decodes the module and translates every function body; data segments wait until memory exists.";
  let false_2 = False();
  let spans = box_array_filled::<u64>(count: 26_u64, value: 0_u64);
  let found = find_sections(bytes: bytes, size: size, spans: &spans);
  if bnot(found) {
    return refuse(why: 1_u64);
  }
  let (ts, te) = section(spans: &spans, id: 1_u64);
  let false_3 = False();
  let tr = Reader(pos: ts, end: te, failed: false_3);
  let types_ok = True();
  if ts < te {
    set types_ok = parse_types(r: &tr, bytes: bytes, types: types);
  }
  let (im_s, im_e) = section(spans: &spans, id: 2_u64);
  let false_4 = False();
  let ir = Reader(pos: im_s, end: im_e, failed: false_4);
  let imports_ok = True();
  if im_s < im_e {
    set imports_ok = parse_imports(r: &ir, bytes: bytes, types: types, funcs: funcs);
  }
  let imported = funcs^.inner.len;
  let (fs, fe) = section(spans: &spans, id: 3_u64);
  let false_5 = False();
  let fr = Reader(pos: fs, end: fe, failed: false_5);
  let funcs_ok = True();
  if fs < fe {
    set funcs_ok = parse_functions(r: &fr, bytes: bytes, types: types, funcs: funcs);
  }
  let (tbs, tbe) = section(spans: &spans, id: 4_u64);
  if tbs < tbe {
    let false_6 = False();
    let tbr = Reader(pos: tbs, end: tbe, failed: false_6);
    let tcount = read_uleb(r: &tbr, bytes: bytes);
    if tcount != 1_u64 {
      return refuse(why: 2_u64);
    }
    let reftype = read_byte(r: &tbr, bytes: bytes);
    let (tmin, tmax) = read_limits(r: &tbr, bytes: bytes);
    if tmin > 1048576_u64 {
      return refuse(why: 3_u64);
    }
    for (i in 0_u64..tmin) {
      push_word(cell: table, value: 18446744073709551615_u64);
    }
  }
  let pages = 0_u64;
  let max_pages = 65536_u64;
  let (ms, me) = section(spans: &spans, id: 5_u64);
  if ms < me {
    let false_7 = False();
    let mr = Reader(pos: ms, end: me, failed: false_7);
    let mcount = read_uleb(r: &mr, bytes: bytes);
    if mcount != 1_u64 {
      return refuse(why: 4_u64);
    }
    let (mmin, mmax) = read_limits(r: &mr, bytes: bytes);
    set pages = mmin;
    if mmax < max_pages {
      set max_pages = mmax;
    }
  }
  let (gs, ge) = section(spans: &spans, id: 6_u64);
  let false_8 = False();
  let gr = Reader(pos: gs, end: ge, failed: false_8);
  let globals_ok = True();
  if gs < ge {
    set globals_ok = parse_globals(r: &gr, bytes: bytes, globals: globals);
  }
  let (xs, xe) = section(spans: &spans, id: 7_u64);
  let false_9 = False();
  let xr = Reader(pos: xs, end: xe, failed: false_9);
  let start = 18446744073709551615_u64;
  if xs < xe {
    set start = parse_exports(r: &xr, bytes: bytes);
  }
  let (es, ee) = section(spans: &spans, id: 9_u64);
  let false_10 = False();
  let er = Reader(pos: es, end: ee, failed: false_10);
  let elements_ok = True();
  if es < ee {
    set elements_ok = parse_elements(r: &er, bytes: bytes, globals: globals, table: table);
  }
  let (cs, ce) = section(spans: &spans, id: 10_u64);
  let false_11 = False();
  let cr = Reader(pos: cs, end: ce, failed: false_11);
  let bodies = 0_u64;
  if cs < ce {
    set bodies = read_uleb(r: &cr, bytes: bytes);
  }
  let local_count = funcs^.inner.len -wrap imported;
  if bodies != local_count {
    return refuse(why: 5_u64);
  }
  let ctls = box_slots_new::<Ctl>(capacity: 64_u64);
  let fixes = box_slots_new::<Pending>(capacity: 64_u64);
  for (b in 0_u64..bodies) {
    let length = read_uleb(r: &cr, bytes: bytes);
    let at = cr.pos;
    let room = ce -wrap at;
    if length > room {
      return refuse(why: 6_u64);
    }
    let body_end = at +wrap length;
    let false_12 = False();
    let br = Reader(pos: at, end: body_end, failed: false_12);
    let fi = imported +wrap b;
    let translated = translate(r: &br, bytes: bytes, fi: fi, funcs: funcs, types: types, code: code, brtab: brtab, ctls: &ctls, fixes: &fixes);
    if bnot(translated) {
      return refuse(why: 7_u64);
    }
    set cr.pos = body_end;
  }
  let why = 0_u64;
  if bnot(elements_ok) {
    set why = 24_u64;
  }
  if bnot(globals_ok) {
    set why = 23_u64;
  }
  if bnot(funcs_ok) {
    set why = 22_u64;
  }
  if bnot(imports_ok) {
    set why = 21_u64;
  }
  if bnot(types_ok) {
    set why = 20_u64;
  }
  let all = band(types_ok, imports_ok);
  set all = band(all, funcs_ok);
  set all = band(all, globals_ok);
  set all = band(all, elements_ok);
  let (ds, de) = section(spans: &spans, id: 11_u64);
  let info = Loaded(ok: all, reason: why, start: start, pages: pages, max_pages: max_pages, data_at: ds, data_end: de);
  return info;
}

fn load_u32(mem: &Box<Array<u8>>, at: u64) -> v: u64 reads(mem) {
  doc "A little-endian u32 from memory, or the largest u64 outside it.";
  let len = mem^.inner.len;
  if len < 4_u64 {
    return 18446744073709551615_u64;
  }
  let room = len - 4_u64;
  if at > room {
    return 18446744073709551615_u64;
  }
  let value = 0_u64;
  for (i in 0_u64..4_u64) {
    let p = at + i;
    let b = mem^.inner[p];
    let bw = cvt::<u8, u64>(b);
    let i8w = i * 8_u64;
    let s = cvt.wrap::<u64, u32>(i8w);
    let part = ishl.wrap(bw, s);
    set value = ior(value, part);
  }
  return value;
}

fn store_bytes(mem: &Box<Array<u8>>, at: u64, value: u64, count: u64) -> ok: Bool writes(mem) {
  doc "Stores the low count bytes of value little-endian.";
  let len = mem^.inner.len;
  if count > len {
    return False();
  }
  let room = len - count;
  if at > room {
    return False();
  }
  for (i in 0_u64..count) {
    let p = at + i;
    let i8w = i *wrap 8_u64;
    let s = cvt.wrap::<u64, u32>(i8w);
    let shifted = ishr.wrap(value, s);
    let b = cvt.wrap::<u64, u8>(shifted);
    set mem^.inner[p] = b;
  }
  return True();
}

fn write_all(files: &HandleFactory, out: &OutputStream, mem: &Box<Array<u8>>, from: u64, to: u64) -> ok: Bool reads(mem), writes(files), writes(out) waits {
  doc "Writes the memory bytes from from to to.";
  let len = mem^.inner.len;
  if to > len {
    return False();
  }
  if from > to {
    return False();
  }
  let at = from;
  let none = None<Instant>();
  loop @writing {
    if at >= to {
      break @writing;
    }
    match write_once(factory: files, output: out, source: &mem^.inner[0_u64..len], start: at, end: to, deadline: none) {
      Ok(value: next) => {
        if next == at {
          return False();
        }
        set at = next;
      }
      Err(error: problem) => {
        return False();
      }
    }
  }
  return True();
}

fn host_arity(id: u32) -> n: u64 pure {
  doc "How many arguments a WASI function takes.";
  if id == 1_u32 {
    return 2_u64;
  }
  if id == 2_u32 {
    return 2_u64;
  }
  if id == 3_u32 {
    return 3_u64;
  }
  if id == 4_u32 {
    return 1_u64;
  }
  if id == 5_u32 {
    return 2_u64;
  }
  if id == 6_u32 {
    return 4_u64;
  }
  if id == 7_u32 {
    return 4_u64;
  }
  return 1_u64;
}

fn host_call(id: u32, sp: u64, stack: &Box<Array<u64>>, mem: &Box<Array<u8>>, args: &Args, files: &HandleFactory, out: &OutputStream, err: &OutputStream, clock: &Clock, origin: Instant) -> step: HostStep reads(args), writes(stack), writes(mem), writes(files), writes(out), writes(err), writes(clock) waits {
  doc "Performs one WASI call on the arguments at the top of the stack and leaves its errno there.";
  let false_1 = False();
  let failed = HostStep(sp: 18446744073709551615_u64, exit: false_1, code: 0_u64);
  let n = host_arity(id: id);
