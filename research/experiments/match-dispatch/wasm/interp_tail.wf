    return 0_u64;
  }
  if op == 17_u8 {
    let ti = read_uleb(r: r, bytes: bytes);
    let tbl = read_uleb(r: r, bytes: bytes);
    if ti >= types^.inner.len {
      return 2_u64;
    }
    let ft = types^.inner[ti];
    let top = top_pos(provs: provs, depth: 0_u64);
    let index_slot = temp_slot(st: st, pos: top);
    pop_prov(st: st, provs: provs, count: 1_u64);
    let h = provs^.inner.len;
    let np = ft.params;
    if np > h {
      return 2_u64;
    }
    let first = h - np;
    let at = temp_slot(st: st, pos: first);
    let canon = narrow(value: ft.canon);
    let at16 = slot16(value: at);
    let idx16 = slot16(value: index_slot);
    let o = Op::CallIndirect(canon: canon, at: at16, i: idx16);
    emit_plain(st: st, code: code, op: o);
    pop_prov(st: st, provs: provs, count: ft.params);
    for (i in 0_u64..ft.results) {
      push_temp(st: st, provs: provs);
    }
    return 0_u64;
  }
  return 2_u64;
}

fn set_local(st: &Trans, provs: &Box<Slots<Prov>>, code: &Box<Slots<Op>>, local: u64) -> ok: Bool writes(st), writes(provs), writes(code) {
  doc "local.set: the operation that computed the top operand into its temporary writes the local instead when it is the last one emitted; otherwise a copy or a constant writes it.";
  if local >= st^.l {
    return False();
  }
  if provs^.inner.len == 0_u64 {
    return False();
  }
  preserve(st: st, provs: provs, code: code, local: local);
  let top = top_pos(provs: provs, depth: 0_u64);
  if top >= provs^.inner.len {
    return False();
  }
  let p = provs^.inner[top];
  pop_prov(st: st, provs: provs, count: 1_u64);
  let li = slot16(value: local);
  if p.kind == 1_u64 {
    let s = slot16(value: p.value);
    let length = code^.inner.len;
    let latest = length -wrap 1_u64;
    let paired = st^.last == latest;
    let moved = st^.last_pos == 18446744073709551614_u64;
    if band(paired, moved) {
      if latest < code^.inner.len {
        let d0 = slot16(value: st^.copy_d);
        let s0 = slot16(value: st^.copy_s);
        let o = Op::Copy2(d: d0, s: s0, e: li, t: s);
        set code^.inner[latest] = o;
        set st^.last = 18446744073709551615_u64;
        return True();
      }
    }
    let o = Op::Copy(d: li, s: s);
    emit_plain(st: st, code: code, op: o);
    set st^.last = latest +wrap 1_u64;
    set st^.last_pos = 18446744073709551614_u64;
    set st^.copy_d = local;
    set st^.copy_s = p.value;
    return True();
  }
  if p.kind == 2_u64 {
    let o = Op::Const(d: li, v: p.value);
    emit_plain(st: st, code: code, op: o);
    return True();
  }
  let length = code^.inner.len;
  let latest = length -wrap 1_u64;
  let fresh = st^.last == latest;
  let same = st^.last_pos == top;
  let fused = band(fresh, same);
  if fused {
    if latest < code^.inner.len {
      let old = code^.inner[latest];
      match with_dest(op: old, slot: li) {
        Some(value: o) => {
          set code^.inner[latest] = o;
          set st^.last = 18446744073709551615_u64;
          return True();
        }
        None() => {
        }
      }
    }
  }
  let ts = temp_slot(st: st, pos: top);
  let s = slot16(value: ts);
  let o = Op::Copy(d: li, s: s);
  emit_plain(st: st, code: code, op: o);
  return True();
}

fn step_data(op: u8, st: &Trans, r: &Reader, bytes: &Box<Array<u8>>, consts: &Box<Slots<u64>>, provs: &Box<Slots<Prov>>, code: &Box<Slots<Op>>) -> status: u64 reads(bytes), reads(consts), writes(st), writes(r), writes(provs), writes(code) {
  doc "Parametric, variable, memory and constant operations, 0x1a through 0x44: a local.get or a constant becomes the operand's provider and emits nothing.";
  if op == 26_u8 {
    pop_prov(st: st, provs: provs, count: 1_u64);
    return 0_u64;
  }
  let picks = False();
  if op == 27_u8 {
    set picks = True();
  }
  if op == 28_u8 {
    let n = read_uleb(r: r, bytes: bytes);
    if n > 1_u64 {
      return 2_u64;
    }
    for (i in 0_u64..n) {
      let t = read_byte(r: r, bytes: bytes);
    }
    set picks = True();
  }
  if picks {
    let c_pos = top_pos(provs: provs, depth: 0_u64);
    let b_pos = top_pos(provs: provs, depth: 1_u64);
    let a_pos = top_pos(provs: provs, depth: 2_u64);
    let c = source(st: st, provs: provs, code: code, pos: c_pos);
    let b = source(st: st, provs: provs, code: code, pos: b_pos);
    let a = source(st: st, provs: provs, code: code, pos: a_pos);
    pop_prov(st: st, provs: provs, count: 3_u64);
    let dest_pos = provs^.inner.len;
    let d = temp_slot(st: st, pos: dest_pos);
    let d16 = slot16(value: d);
    let a16 = slot16(value: a);
    let b16 = slot16(value: b);
    let c16 = slot16(value: c);
    let o = Op::Select(d: d16, a: a16, b: b16, c: c16);
    emit_dest(st: st, code: code, op: o, pos: dest_pos);
    push_temp(st: st, provs: provs);
    return 0_u64;
  }
  if op >= 32_u8 {
    if op <= 36_u8 {
      let index = read_uleb(r: r, bytes: bytes);
      if op == 32_u8 {
        if index >= st^.l {
          return 2_u64;
        }
        let p = Prov(kind: 1_u64, value: index);
        push_prov(cell: provs, value: p);
        return 0_u64;
      }
      if op == 33_u8 {
        let ok = set_local(st: st, provs: provs, code: code, local: index);
        if ok {
          return 0_u64;
        }
        return 2_u64;
      }
      if op == 34_u8 {
        let ok = set_local(st: st, provs: provs, code: code, local: index);
        let p = Prov(kind: 1_u64, value: index);
        push_prov(cell: provs, value: p);
        if ok {
          return 0_u64;
        }
        return 2_u64;
      }
      let i32v = narrow(value: index);
      if op == 35_u8 {
        let dest_pos = provs^.inner.len;
        let d = temp_slot(st: st, pos: dest_pos);
        let d16 = slot16(value: d);
        let o = Op::GlobalGet(d: d16, i: i32v);
        emit_dest(st: st, code: code, op: o, pos: dest_pos);
        push_temp(st: st, provs: provs);
        return 0_u64;
      }
      let top = top_pos(provs: provs, depth: 0_u64);
      let s = source(st: st, provs: provs, code: code, pos: top);
      pop_prov(st: st, provs: provs, count: 1_u64);
      let s16 = slot16(value: s);
      let o = Op::GlobalSet(s: s16, i: i32v);
      emit_plain(st: st, code: code, op: o);
      return 0_u64;
    }
  }
  if op >= 40_u8 {
    if op <= 62_u8 {
      let align = read_uleb(r: r, bytes: bytes);
      let offset = read_uleb(r: r, bytes: bytes);
      if offset > 4294967295_u64 {
        return 2_u64;
      }
      let o32 = narrow(value: offset);
      if op >= 54_u8 {
        let v_pos = top_pos(provs: provs, depth: 0_u64);
        let a_pos = top_pos(provs: provs, depth: 1_u64);
        if v_pos < provs^.inner.len {
          let vp = provs^.inner[v_pos];
          let eligible = indexed(code: op);
          let named = vp.kind == 1_u64;
          if band(eligible, named) {
            let (found, xa, xb) = take_add(st: st, provs: provs, code: code, pos: a_pos);
            if found {
              pop_prov(st: st, provs: provs, count: 2_u64);
              let v16x = slot16(value: vp.value);
              let xa16 = slot16(value: xa);
              let xb16 = slot16(value: xb);
              match indexed_op(code: op, first: v16x, a: xa16, b: xb16, offset: o32) {
                Some(value: o) => {
                  emit_plain(st: st, code: code, op: o);
                  return 0_u64;
                }
                None() => {
                  return 2_u64;
                }
              }
            }
          }
        }
        let v = source(st: st, provs: provs, code: code, pos: v_pos);
        let a = source(st: st, provs: provs, code: code, pos: a_pos);
        pop_prov(st: st, provs: provs, count: 2_u64);
        let a16 = slot16(value: a);
        let v16 = slot16(value: v);
        match load_op(code: op, first: a16, second: v16, offset: o32) {
          Some(value: o) => {
            emit_plain(st: st, code: code, op: o);
            return 0_u64;
          }
          None() => {
            return 2_u64;
          }
        }
      }
      let a_pos = top_pos(provs: provs, depth: 0_u64);
      if indexed(code: op) {
        let (found, xa, xb) = take_add(st: st, provs: provs, code: code, pos: a_pos);
        if found {
          pop_prov(st: st, provs: provs, count: 1_u64);
          let xpos = provs^.inner.len;
          let xd = temp_slot(st: st, pos: xpos);
          let xd16 = slot16(value: xd);
          let xa16 = slot16(value: xa);
          let xb16 = slot16(value: xb);
          match indexed_op(code: op, first: xd16, a: xa16, b: xb16, offset: o32) {
            Some(value: o) => {
              emit_dest(st: st, code: code, op: o, pos: xpos);
              push_temp(st: st, provs: provs);
              return 0_u64;
            }
            None() => {
              return 2_u64;
            }
          }
        }
      }
      let a = source(st: st, provs: provs, code: code, pos: a_pos);
      pop_prov(st: st, provs: provs, count: 1_u64);
      let dest_pos = provs^.inner.len;
      let d = temp_slot(st: st, pos: dest_pos);
      let d16 = slot16(value: d);
      let a16 = slot16(value: a);
      match load_op(code: op, first: d16, second: a16, offset: o32) {
        Some(value: o) => {
          emit_dest(st: st, code: code, op: o, pos: dest_pos);
          push_temp(st: st, provs: provs);
          return 0_u64;
        }
        None() => {
          return 2_u64;
        }
      }
    }
  }
  if op == 63_u8 {
    let b = read_byte(r: r, bytes: bytes);
    let dest_pos = provs^.inner.len;
    let d = temp_slot(st: st, pos: dest_pos);
    let d16 = slot16(value: d);
    let o = Op::MemorySize(d: d16);
    emit_dest(st: st, code: code, op: o, pos: dest_pos);
    push_temp(st: st, provs: provs);
    return 0_u64;
  }
  if op == 64_u8 {
    let b = read_byte(r: r, bytes: bytes);
    let top = top_pos(provs: provs, depth: 0_u64);
    let s = source(st: st, provs: provs, code: code, pos: top);
    pop_prov(st: st, provs: provs, count: 1_u64);
    let dest_pos = provs^.inner.len;
    let d = temp_slot(st: st, pos: dest_pos);
    let d16 = slot16(value: d);
    let s16 = slot16(value: s);
    let o = Op::MemoryGrow(d: d16, s: s16);
    emit_dest(st: st, code: code, op: o, pos: dest_pos);
    push_temp(st: st, provs: provs);
    return 0_u64;
  }
  let value = 0_u64;
  if op == 65_u8 {
    let v = read_sleb(r: r, bytes: bytes);
    set value = iand(v, 4294967295_u64);
  } else if op == 66_u8 {
    set value = read_sleb(r: r, bytes: bytes);
  } else if op == 67_u8 {
    set value = read_fixed(r: r, bytes: bytes, count: 4_u64);
  } else if op == 68_u8 {
    set value = read_fixed(r: r, bytes: bytes, count: 8_u64);
  } else {
    return 2_u64;
  }
  let cs = const_slot(st: st, consts: consts, value: value);
  if cs == 18446744073709551615_u64 {
    return 2_u64;
  }
  let p = Prov(kind: 1_u64, value: cs);
  push_prov(cell: provs, value: p);
  return 0_u64;
}

fn step_numeric(op: u8, st: &Trans, r: &Reader, bytes: &Box<Array<u8>>, provs: &Box<Slots<Prov>>, code: &Box<Slots<Op>>) -> status: u64 reads(bytes), writes(st), writes(r), writes(provs), writes(code) {
  doc "Numeric operations 0x45 through 0xc4 and the 0xfc prefix; the zero-extension and reinterpretations need no operation, the representation already holding their result.";
  if op == 252_u8 {
    let sub = read_uleb(r: r, bytes: bytes);
    if sub < 8_u64 {
      let a_pos = top_pos(provs: provs, depth: 0_u64);
      let a = source(st: st, provs: provs, code: code, pos: a_pos);
      pop_prov(st: st, provs: provs, count: 1_u64);
      let dest_pos = provs^.inner.len;
      let d = temp_slot(st: st, pos: dest_pos);
      let d16 = slot16(value: d);
      let a16 = slot16(value: a);
      match saturating_op(sub: sub, d: d16, a: a16) {
        Some(value: o) => {
          emit_dest(st: st, code: code, op: o, pos: dest_pos);
          push_temp(st: st, provs: provs);
          return 0_u64;
        }
        None() => {
          return 2_u64;
        }
      }
    }
    let copying = sub == 10_u64;
    let filling = sub == 11_u64;
    let bulk = bor(copying, filling);
    if bulk {
      let a = read_byte(r: r, bytes: bytes);
      if copying {
        let b = read_byte(r: r, bytes: bytes);
      }
      let n_pos = top_pos(provs: provs, depth: 0_u64);
      let s_pos = top_pos(provs: provs, depth: 1_u64);
      let d_pos = top_pos(provs: provs, depth: 2_u64);
      let nslot = source(st: st, provs: provs, code: code, pos: n_pos);
      let sslot = source(st: st, provs: provs, code: code, pos: s_pos);
      let dslot = source(st: st, provs: provs, code: code, pos: d_pos);
      pop_prov(st: st, provs: provs, count: 3_u64);
      let d16 = slot16(value: dslot);
      let s16 = slot16(value: sslot);
      let n16 = slot16(value: nslot);
      if copying {
        let o = Op::MemoryCopy(d: d16, s: s16, n: n16);
        emit_plain(st: st, code: code, op: o);
      } else {
        let o = Op::MemoryFill(d: d16, v: s16, n: n16);
        emit_plain(st: st, code: code, op: o);
      }
      return 0_u64;
    }
    return 2_u64;
  }
  if op == 173_u8 {
    return 0_u64;
  }
  if op >= 188_u8 {
    if op <= 191_u8 {
      return 0_u64;
    }
  }
  let ins = numeric_inputs(code: op);
  let b = 0_u64;
  if ins == 2_u64 {
    let b_pos = top_pos(provs: provs, depth: 0_u64);
    set b = source(st: st, provs: provs, code: code, pos: b_pos);
  }
  let a_depth = ins -wrap 1_u64;
  let a_pos = top_pos(provs: provs, depth: a_depth);
  let a = source(st: st, provs: provs, code: code, pos: a_pos);
  pop_prov(st: st, provs: provs, count: ins);
  let dest_pos = provs^.inner.len;
  let d = temp_slot(st: st, pos: dest_pos);
  let d16 = slot16(value: d);
  let a16 = slot16(value: a);
  let b16 = slot16(value: b);
  match numeric_op(code: op, d: d16, a: a16, b: b16) {
    Some(value: o) => {
      emit_dest(st: st, code: code, op: o, pos: dest_pos);
      push_temp(st: st, provs: provs);
      return 0_u64;
    }
    None() => {
      return 2_u64;
    }
  }
}

fn add_const(consts: &Box<Slots<u64>>, cbase: u64, value: u64) -> r: unit writes(consts) {
  doc "Adds value to the function's constant pool, the slots from cbase, unless it is there.";
  let length = consts^.inner.len;
  for (i in cbase..length) {
    if i < consts^.inner.len {
      if consts^.inner[i] == value {
        return unit;
      }
    }
  }
  push_word(cell: consts, value: value);
  return unit;
}

fn collect_consts(r: &Reader, bytes: &Box<Array<u8>>, types: &Box<Slots<FuncType>>, consts: &Box<Slots<u64>>) -> ok: Bool reads(r), reads(bytes), reads(types), writes(consts) {
  doc "Scans a function body, from the reader's position to its end, for its distinct constants; the reader is not moved.";
  let scan = Reader(pos: r^.pos, end: r^.end, failed: r^.failed);
  let cbase = consts^.inner.len;
  loop @ops {
    if scan.pos >= scan.end {
      break @ops;
    }
    let failed = scan.failed;
    if failed {
      return False();
    }
    let op = read_byte(r: &scan, bytes: bytes);
    let opening = False();
    if op == 2_u8 {
      set opening = True();
    }
    if op == 3_u8 {
      set opening = True();
    }
    if op == 4_u8 {
      set opening = True();
    }
    if opening {
      let (p, q) = block_type(r: &scan, bytes: bytes, types: types);
    } else if op == 65_u8 {
      let v = read_sleb(r: &scan, bytes: bytes);
      let w = iand(v, 4294967295_u64);
      add_const(consts: consts, cbase: cbase, value: w);
    } else if op == 66_u8 {
      let v = read_sleb(r: &scan, bytes: bytes);
      add_const(consts: consts, cbase: cbase, value: v);
    } else if op == 67_u8 {
      let v = read_fixed(r: &scan, bytes: bytes, count: 4_u64);
      add_const(consts: consts, cbase: cbase, value: v);
    } else if op == 68_u8 {
      let v = read_fixed(r: &scan, bytes: bytes, count: 8_u64);
      add_const(consts: consts, cbase: cbase, value: v);
    } else {
      skip_immediates(r: &scan, bytes: bytes, op: op);
    }
  }
  let failed = scan.failed;
  return bnot(failed);
}

fn const_slot(st: &Trans, consts: &Box<Slots<u64>>, value: u64) -> slot: u64 reads(st), reads(consts) {
  doc "The frame slot holding a constant of the function, or the largest u64.";
  let cbase = st^.cbase;
  let cn = st^.cn;
  for (k in 0_u64..cn) {
    let i = cbase +wrap k;
    if i < consts^.inner.len {
      if consts^.inner[i] == value {
        return st^.cslot +wrap k;
      }
    }
  }
  return 18446744073709551615_u64;
}

fn translate(r: &Reader, bytes: &Box<Array<u8>>, fi: u64, funcs: &Box<Slots<Func>>, types: &Box<Slots<FuncType>>, code: &Box<Slots<Op>>, brtab: &Box<Slots<Target>>, ctls: &Box<Slots<Ctl>>, fixes: &Box<Slots<Pending>>, provs: &Box<Slots<Prov>>, consts: &Box<Slots<u64>>) -> ok: Bool reads(bytes), reads(types), writes(r), writes(funcs), writes(code), writes(brtab), writes(ctls), writes(fixes), writes(provs), writes(consts) {
  doc "Translates one function body, the reader bounded to it, into register-form operations on frame slots.";
  if fi >= funcs^.inner.len {
    return False();
  }
  let f = funcs^.inner[fi];
  let groups = read_uleb(r: r, bytes: bytes);
  let p0 = r^.pos;
  let e0 = r^.end;
  let room = e0 -wrap p0;
  if groups > room {
    return False();
