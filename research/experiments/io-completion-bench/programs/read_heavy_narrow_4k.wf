    }
  }
  region {
    let native_window_78 = slice_of(&name_0);
    region {
      region {
        let opened_0 = open_file(factory: &uniq deref(files), root: cwd, name: &native_window_78, start: 0_u64, end: 10_u64);
        region {
          let native_window_79 = slice_of(&name_1);
