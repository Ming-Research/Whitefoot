fn factory_refusal(error: &IoError) -> result: own Bool reads(error) {
  match deref(error) {
    NotFound(code: native_code, origin: native_origin) => {
      return False();
    }
    PermissionDenied(code: native_code, origin: native_origin) => {
      return False();
    }
    AlreadyExists(code: native_code, origin: native_origin) => {
      return False();
    }
    NotDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    IsDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    DirectoryNotEmpty(code: native_code, origin: native_origin) => {
      return False();
    }
    ReadOnly(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceBusy(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidInput(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidPath(code: native_code, origin: native_origin) => {
      return False();
    }
    Unsupported(code: native_code, origin: native_origin) => {
      return False();
    }
    TimedOut(code: native_code, origin: native_origin) => {
      return False();
    }
    BrokenPipe(code: native_code, origin: native_origin) => {
      return False();
    }
    WriteZero(code: native_code, origin: native_origin) => {
      return False();
    }
    UnexpectedEnd(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionRefused(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionReset(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionAborted(code: native_code, origin: native_origin) => {
      return False();
    }
    NotConnected(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressInUse(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressUnavailable(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceExhausted(code: native_code, origin: native_origin) => {
      return deref(native_origin) == 0_u8;
    }
    FileTooLarge(code: native_code, origin: native_origin) => {
      return False();
    }
    NoSpace(code: native_code, origin: native_origin) => {
      return False();
    }
    QuotaExceeded(code: native_code, origin: native_origin) => {
      return False();
    }
    CrossDevice(code: native_code, origin: native_origin) => {
      return False();
    }
    DeviceFailure(code: native_code, origin: native_origin) => {
      return False();
    }
    Other(code: native_code, origin: native_origin) => {
      return False();
    }
  }
}

fn discard_open_result(factory: &uniq HandleFactory, outcome: own Result<ReadFile, IoError>) -> result: own unit reads(factory), writes(factory) {
  match move outcome {
    Ok(value: file) => {
      region {
        close_read(factory: &uniq deref(factory), file: move file);
      }
    }
    Err(error: problem) => {
    }
  }
  return unit;
}

fn name_at(name: &uniq MutSlice<u8>, index: own u64) -> result: own unit reads(name), writes(name) {
  doc "Renders the fixed ten-byte generated file name for one index as f00000.dat.";
  let room = len_of(deref(name));
  let sized = room >= 10_u64;
  if sized {
  } else {
    return unit;
  }
  set deref(name)[0_u64] = 102_u8;
  let value = index;
  let position = 5_u64;
  loop @digits {
    let digit = value % 10_u64;
    let narrowed = cvt::<u64, u8>(digit);
    let byte = match narrowed {
      Ok(value: exact) => {
        give 48_u8 +wrap exact;
      }
      Err(error: failure) => {
        give 48_u8;
      }
    }
    let writable = position < room;
    if writable {
      set deref(name)[position] = byte;
    }
    set value = value / 10_u64;
    let done = position == 1_u64;
    if done {
      break @digits;
    }
    set position = position -wrap 1_u64;
  }
  set deref(name)[6_u64] = 46_u8;
  set deref(name)[7_u64] = 100_u8;
  set deref(name)[8_u64] = 97_u8;
  set deref(name)[9_u64] = 116_u8;
  return unit;
}

fn render_u64(destination: &uniq MutSlice<u8>, at: own u64, value: own u64) -> result: own u64 reads(destination), writes(destination) {
  doc "Renders one twenty-digit zero-padded decimal number and reports the position after it.";
  let room = len_of(deref(destination));
  let remaining = value;
  let position = at +wrap 20_u64;
  loop @digits {
    let done = position <= at;
    if done {
      break @digits;
    }
    set position = position -wrap 1_u64;
    let digit = remaining % 10_u64;
    let narrowed = cvt::<u64, u8>(digit);
    let byte = match narrowed {
      Ok(value: exact) => {
        give 48_u8 +wrap exact;
      }
      Err(error: failure) => {
        give 48_u8;
      }
    }
    let writable = position < room;
    if writable {
      set deref(destination)[position] = byte;
    }
    set remaining = remaining / 10_u64;
  }
  return at +wrap 20_u64;
}

fn fold_bytes(source: &buffer<u8>, produced: own u64, seed: own u64) -> result: own u64 reads(source) {
  doc "Folds one read prefix into a running order-sensitive checksum.";
  let room = len_of(deref(source));
  let sum = seed;
  let at = 0_u64;
  loop @fold {
    let scanned = at >= produced;
    if scanned {
      break @fold;
    }
    let readable = at < room;
    if readable {
    } else {
      break @fold;
    }
    let byte = deref(source)[at];
    let widened = cvt::<u8, u64>(byte);
    set sum = sum *wrap 31_u64;
    set sum = sum +wrap widened;
    set at = at +wrap 1_u64;
  }
  return sum;
}

fn exercise(cwd: &DirectoryRead, out: &uniq OutputStream, files: &uniq HandleFactory) -> status: own ExitStatus reads(cwd, out, files), writes(out, files) {
  doc "Opens and reads the generated file set four independent files at a time and publishes one folded checksum.";
  let name_a = buffer_new(16_u64, 0_u8);
  let name_b = buffer_new(16_u64, 0_u8);
  let name_c = buffer_new(16_u64, 0_u8);
  let name_d = buffer_new(16_u64, 0_u8);
  let data_a = buffer_new(65536_u64, 0_u8);
  let data_b = buffer_new(65536_u64, 0_u8);
  let data_c = buffer_new(65536_u64, 0_u8);
  let data_d = buffer_new(65536_u64, 0_u8);
  let line = buffer_new(64_u64, 0_u8);
  let sum_a = 0_u64;
  let sum_b = 0_u64;
  let sum_c = 0_u64;
  let sum_d = 0_u64;
  let bytes = 0_u64;
  let index = 0_u64;
  loop @scan (
    invariant name_a_room: len_of(name_a) >= 16_u64,
    invariant name_b_room: len_of(name_b) >= 16_u64,
    invariant name_c_room: len_of(name_c) >= 16_u64,
    invariant name_d_room: len_of(name_d) >= 16_u64
  ) {
    let done = index >= 8192_u64;
    if done {
      break @scan;
    }
    let second = index +wrap 1_u64;
    let third = index +wrap 2_u64;
    let fourth = index +wrap 3_u64;
    region {
      let name_a_window = mut_slice_of(&uniq name_a);
      region {
        let rendered_a = name_at(name: &uniq name_a_window, index: index);
      }
    }
    region {
      let name_b_window = mut_slice_of(&uniq name_b);
      region {
        let rendered_b = name_at(name: &uniq name_b_window, index: second);
      }
    }
    region {
      let name_c_window = mut_slice_of(&uniq name_c);
      region {
        let rendered_c = name_at(name: &uniq name_c_window, index: third);
      }
    }
    region {
      let name_d_window = mut_slice_of(&uniq name_d);
      region {
        let rendered_d = name_at(name: &uniq name_d_window, index: fourth);
      }
    }
    region {
      let native_window_166 = slice_of(&name_a);
      region {
        region {
          let opened_a = open_file(factory: &uniq deref(files), root: cwd, name: &native_window_166, start: 0_u64, end: 10_u64);
          region {
            let native_window_167 = slice_of(&name_b);
            region {
              let opened_b = open_file(factory: &uniq deref(files), root: cwd, name: &native_window_167, start: 0_u64, end: 10_u64);
              region {
                let native_window_168 = slice_of(&name_c);
                region {
                  let opened_c = open_file(factory: &uniq deref(files), root: cwd, name: &native_window_168, start: 0_u64, end: 10_u64);
                  region {
                    let native_window_169 = slice_of(&name_d);
                    region {
                      let opened_d = open_file(factory: &uniq deref(files), root: cwd, name: &native_window_169, start: 0_u64, end: 10_u64);
                      match opened_a {
                        Ok(value: handle_a) => {
                          match opened_b {
                            Ok(value: handle_b) => {
                              match opened_c {
                                Ok(value: handle_c) => {
                                  match opened_d {
                                    Ok(value: handle_d) => {
                                      region {
                                        let native_window_170 = mut_slice_of(&uniq data_a);
                                        region {
                                          region {
                                            let read_a = read_at(factory: &uniq deref(files), file: &uniq handle_a, destination: &uniq native_window_170, file_offset: 0_u64, start: 0_u64, end: 65536_u64);
                                            region {
                                              let native_window_171 = mut_slice_of(&uniq data_b);
                                              region {
                                                let read_b = read_at(factory: &uniq deref(files), file: &uniq handle_b, destination: &uniq native_window_171, file_offset: 0_u64, start: 0_u64, end: 65536_u64);
                                                region {
                                                  let native_window_172 = mut_slice_of(&uniq data_c);
                                                  region {
                                                    let read_c = read_at(factory: &uniq deref(files), file: &uniq handle_c, destination: &uniq native_window_172, file_offset: 0_u64, start: 0_u64, end: 65536_u64);
                                                    region {
                                                      let native_window_173 = mut_slice_of(&uniq data_d);
                                                      region {
                                                        let read_d = read_at(factory: &uniq deref(files), file: &uniq handle_d, destination: &uniq native_window_173, file_offset: 0_u64, start: 0_u64, end: 65536_u64);
                                                        match read_a {
                                                          Ok(value: produced_a) => {
                                                            let digest_a = 0_u64;
                                                            region {
                                                              set digest_a = fold_bytes(source: &data_a, produced: produced_a, seed: 0_u64);
                                                            }
                                                            let weight_a = index +wrap 1_u64;
                                                            set digest_a = digest_a *wrap weight_a;
                                                            set sum_a = sum_a +wrap digest_a;
                                                            set bytes = bytes +wrap produced_a;
                                                          }
                                                          Err(error: read_stop_162) => {
                                                            match read_stop_162 {
                                                              ReadEnd() => {
                                                              }
                                                              ReadFailed(error: problem_a) => {
                                                              }
                                                            }
                                                          }
                                                        }
                                                        match read_b {
                                                          Ok(value: produced_b) => {
                                                            let digest_b = 0_u64;
                                                            region {
                                                              set digest_b = fold_bytes(source: &data_b, produced: produced_b, seed: 0_u64);
                                                            }
                                                            let weight_b = second +wrap 1_u64;
                                                            set digest_b = digest_b *wrap weight_b;
                                                            set sum_b = sum_b +wrap digest_b;
                                                            set bytes = bytes +wrap produced_b;
                                                          }
                                                          Err(error: read_stop_163) => {
                                                            match read_stop_163 {
                                                              ReadEnd() => {
                                                              }
                                                              ReadFailed(error: problem_b) => {
                                                              }
                                                            }
                                                          }
                                                        }
                                                        match read_c {
                                                          Ok(value: produced_c) => {
                                                            let digest_c = 0_u64;
                                                            region {
                                                              set digest_c = fold_bytes(source: &data_c, produced: produced_c, seed: 0_u64);
                                                            }
                                                            let weight_c = third +wrap 1_u64;
                                                            set digest_c = digest_c *wrap weight_c;
                                                            set sum_c = sum_c +wrap digest_c;
                                                            set bytes = bytes +wrap produced_c;
                                                          }
                                                          Err(error: read_stop_164) => {
                                                            match read_stop_164 {
                                                              ReadEnd() => {
                                                              }
                                                              ReadFailed(error: problem_c) => {
                                                              }
                                                            }
                                                          }
                                                        }
                                                        match read_d {
                                                          Ok(value: produced_d) => {
                                                            let digest_d = 0_u64;
                                                            region {
                                                              set digest_d = fold_bytes(source: &data_d, produced: produced_d, seed: 0_u64);
                                                            }
                                                            let weight_d = fourth +wrap 1_u64;
                                                            set digest_d = digest_d *wrap weight_d;
                                                            set sum_d = sum_d +wrap digest_d;
                                                            set bytes = bytes +wrap produced_d;
                                                          }
                                                          Err(error: read_stop_165) => {
                                                            match read_stop_165 {
                                                              ReadEnd() => {
                                                              }
                                                              ReadFailed(error: problem_d) => {
                                                              }
                                                            }
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                          close_read(factory: &uniq deref(files), file: move handle_d);
                                        }
                                      }
                                    }
                                    Err(error: failed_d) => {
                                      region {
                                        let failure_status = if factory_refusal(error: &failed_d) {
                                          give 11_u8;
                                        } else {
                                          give 7_u8;
                                        }
                                        close_read(factory: &uniq deref(files), file: move handle_c);
                                        close_read(factory: &uniq deref(files), file: move handle_b);
                                        close_read(factory: &uniq deref(files), file: move handle_a);
                                        return exit_status(code: failure_status);
                                      }
                                    }
                                  }
                                  close_read(factory: &uniq deref(files), file: move handle_c);
                                }
                                Err(error: failed_c) => {
                                  region {
                                    let failure_status = if factory_refusal(error: &failed_c) {
                                      give 10_u8;
                                    } else {
                                      give 6_u8;
                                    }
                                    close_read(factory: &uniq deref(files), file: move handle_b);
                                    close_read(factory: &uniq deref(files), file: move handle_a);
                                    discard_open_result(factory: &uniq deref(files), outcome: move opened_d);
                                    return exit_status(code: failure_status);
                                  }
                                }
                              }
                              close_read(factory: &uniq deref(files), file: move handle_b);
                            }
                            Err(error: failed_b) => {
                              region {
                                let failure_status = if factory_refusal(error: &failed_b) {
                                  give 9_u8;
                                } else {
                                  give 5_u8;
                                }
                                close_read(factory: &uniq deref(files), file: move handle_a);
                                discard_open_result(factory: &uniq deref(files), outcome: move opened_d);
                                discard_open_result(factory: &uniq deref(files), outcome: move opened_c);
                                return exit_status(code: failure_status);
                              }
                            }
                          }
                          close_read(factory: &uniq deref(files), file: move handle_a);
                        }
                        Err(error: failed_a) => {
                          region {
                            let failure_status = if factory_refusal(error: &failed_a) {
                              give 8_u8;
                            } else {
                              give 4_u8;
                            }
                            discard_open_result(factory: &uniq deref(files), outcome: move opened_d);
                            discard_open_result(factory: &uniq deref(files), outcome: move opened_c);
                            discard_open_result(factory: &uniq deref(files), outcome: move opened_b);
                            return exit_status(code: failure_status);
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
        set index = index +wrap 4_u64;
      }
    }
  }
  let sum = sum_a;
  set sum = sum +wrap sum_b;
  set sum = sum +wrap sum_c;
  set sum = sum +wrap sum_d;
  let room = len_of(line);
  let cursor = 0_u64;
  region {
    let line_window = mut_slice_of(&uniq line);
    region {
      set cursor = render_u64(destination: &uniq line_window, at: cursor, value: sum);
    }
  }
  let space_fits = cursor < room;
  if space_fits {
    set line[cursor] = 32_u8;
    set cursor = cursor +wrap 1_u64;
  }
  region {
    let line_window = mut_slice_of(&uniq line);
    region {
      set cursor = render_u64(destination: &uniq line_window, at: cursor, value: bytes);
    }
  }
  let end_fits = cursor < room;
  if end_fits {
    set line[cursor] = 10_u8;
    set cursor = cursor +wrap 1_u64;
  }
  let status = 0_u8;
  let publishable = cursor <= room;
  if publishable {
    region {
      let native_window_174 = slice_of(&line);
      region {
        match write_once(factory: &uniq deref(files), output: &uniq deref(out), source: &native_window_174, start: 0_u64, end: cursor) {
          Ok(value: written) => {
          }
          Err(error: problem) => {
            set status = 2_u8;
          }
        }
      }
    }
  } else {
    set status = 3_u8;
  }
  return exit_status(code: status);
}

fn main(inputs: own Inputs) -> status: own ExitStatus pure {
  doc "PRE-1 ordinary Inputs are destructured once; the borrowed operation chain returns before the initial directory is explicitly closed on every exit.";
  let Inputs(args: unused_args, cwd: cwd, stdout: out, stderr: unused_stderr, handles: files, stdin: unused_stdin, ..) = move inputs;
  region {
    let outcome = exercise(cwd: &cwd, out: &uniq out, files: &uniq files);
    close_directory(factory: &uniq files, directory: move cwd);
    return move outcome;
  }
}
