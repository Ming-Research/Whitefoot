fn factory_refusal(error: &IoError) -> result: own Bool reads(error) {
  match deref(error) {
    NotFound(code: native_code, origin: native_origin) => {
      return False();
    }
    PermissionDenied(code: native_code, origin: native_origin) => {
      return False();
    }
    AlreadyExists(code: native_code, origin: native_origin) => {
      return False();
    }
    NotDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    IsDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    DirectoryNotEmpty(code: native_code, origin: native_origin) => {
      return False();
    }
    ReadOnly(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceBusy(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidInput(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidPath(code: native_code, origin: native_origin) => {
      return False();
    }
    Unsupported(code: native_code, origin: native_origin) => {
      return False();
    }
    TimedOut(code: native_code, origin: native_origin) => {
      return False();
    }
    BrokenPipe(code: native_code, origin: native_origin) => {
      return False();
    }
    WriteZero(code: native_code, origin: native_origin) => {
      return False();
    }
    UnexpectedEnd(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionRefused(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionReset(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionAborted(code: native_code, origin: native_origin) => {
      return False();
    }
    NotConnected(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressInUse(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressUnavailable(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceExhausted(code: native_code, origin: native_origin) => {
      return deref(native_origin) == 0_u8;
    }
    FileTooLarge(code: native_code, origin: native_origin) => {
      return False();
    }
    NoSpace(code: native_code, origin: native_origin) => {
      return False();
    }
    QuotaExceeded(code: native_code, origin: native_origin) => {
      return False();
    }
    CrossDevice(code: native_code, origin: native_origin) => {
      return False();
    }
    DeviceFailure(code: native_code, origin: native_origin) => {
      return False();
    }
    Other(code: native_code, origin: native_origin) => {
      return False();
    }
  }
}

fn discard_open_result(factory: &uniq HandleFactory, outcome: own Result<ReadFile, IoError>) -> result: own unit reads(factory), writes(factory) {
  match move outcome {
    Ok(value: file) => {
      region {
        close_read(factory: &uniq deref(factory), file: move file);
      }
    }
    Err(error: problem) => {
    }
  }
  return unit;
}

fn name_at(name: &uniq MutSlice<u8>, index: own u64) -> result: own unit reads(name), writes(name) {
  doc "Renders the fixed ten-byte generated file name for one index as f00000.dat.";
  let room = len_of(deref(name));
  let sized = room >= 10_u64;
  if sized {
  } else {
    return unit;
  }
  set deref(name)[0_u64] = 102_u8;
  let value = index;
  let position = 5_u64;
  loop @digits {
    let digit = value % 10_u64;
    let narrowed = cvt::<u64, u8>(digit);
    let byte = match narrowed {
      Ok(value: exact) => {
        give 48_u8 +wrap exact;
      }
      Err(error: failure) => {
        give 48_u8;
      }
    }
    let writable = position < room;
    if writable {
      set deref(name)[position] = byte;
    }
    set value = value / 10_u64;
    let done = position == 1_u64;
    if done {
      break @digits;
    }
    set position = position -wrap 1_u64;
  }
  set deref(name)[6_u64] = 46_u8;
  set deref(name)[7_u64] = 100_u8;
  set deref(name)[8_u64] = 97_u8;
  set deref(name)[9_u64] = 116_u8;
  return unit;
}

fn render_u64(destination: &uniq MutSlice<u8>, at: own u64, value: own u64) -> result: own u64 reads(destination), writes(destination) {
  doc "Renders one twenty-digit zero-padded decimal number and reports the position after it.";
  let room = len_of(deref(destination));
  let remaining = value;
  let position = at +wrap 20_u64;
  loop @digits {
    let done = position <= at;
    if done {
      break @digits;
    }
    set position = position -wrap 1_u64;
    let digit = remaining % 10_u64;
    let narrowed = cvt::<u64, u8>(digit);
    let byte = match narrowed {
      Ok(value: exact) => {
        give 48_u8 +wrap exact;
      }
      Err(error: failure) => {
        give 48_u8;
      }
    }
    let writable = position < room;
    if writable {
      set deref(destination)[position] = byte;
    }
    set remaining = remaining / 10_u64;
  }
  return at +wrap 20_u64;
}

fn fold_bytes(source: &buffer<u8>, produced: own u64, seed: own u64) -> result: own u64 reads(source) {
  doc "Folds one read prefix into a running order-sensitive checksum.";
  let room = len_of(deref(source));
  let sum = seed;
  let at = 0_u64;
  loop @fold {
    let scanned = at >= produced;
    if scanned {
      break @fold;
    }
    let readable = at < room;
    if readable {
    } else {
      break @fold;
    }
    let byte = deref(source)[at];
    let widened = cvt::<u8, u64>(byte);
    set sum = sum *wrap 31_u64;
    set sum = sum +wrap widened;
    set at = at +wrap 1_u64;
  }
  return sum;
}

fn exercise(cwd: &DirectoryRead, out: &uniq OutputStream, files: &uniq HandleFactory) -> status: own ExitStatus reads(cwd, out, files), writes(out, files) {
  doc "Opens and reads the generated file set eight independent files at a time and publishes one folded checksum.";
  let name_a = buffer_new(16_u64, 0_u8);
  let name_b = buffer_new(16_u64, 0_u8);
  let name_c = buffer_new(16_u64, 0_u8);
  let name_d = buffer_new(16_u64, 0_u8);
  let name_e = buffer_new(16_u64, 0_u8);
  let name_f = buffer_new(16_u64, 0_u8);
  let name_g = buffer_new(16_u64, 0_u8);
  let name_h = buffer_new(16_u64, 0_u8);
  let data_a = buffer_new(65536_u64, 0_u8);
  let data_b = buffer_new(65536_u64, 0_u8);
  let data_c = buffer_new(65536_u64, 0_u8);
  let data_d = buffer_new(65536_u64, 0_u8);
  let data_e = buffer_new(65536_u64, 0_u8);
  let data_f = buffer_new(65536_u64, 0_u8);
  let data_g = buffer_new(65536_u64, 0_u8);
  let data_h = buffer_new(65536_u64, 0_u8);
  let line = buffer_new(64_u64, 0_u8);
  let sum_a = 0_u64;
  let sum_b = 0_u64;
  let sum_c = 0_u64;
  let sum_d = 0_u64;
  let sum_e = 0_u64;
  let sum_f = 0_u64;
  let sum_g = 0_u64;
  let sum_h = 0_u64;
  let bytes = 0_u64;
  let index = 0_u64;
  loop @scan (
    invariant name_a_room: len_of(name_a) >= 16_u64,
    invariant name_b_room: len_of(name_b) >= 16_u64,
    invariant name_c_room: len_of(name_c) >= 16_u64,
    invariant name_d_room: len_of(name_d) >= 16_u64,
    invariant name_e_room: len_of(name_e) >= 16_u64,
    invariant name_f_room: len_of(name_f) >= 16_u64,
    invariant name_g_room: len_of(name_g) >= 16_u64,
    invariant name_h_room: len_of(name_h) >= 16_u64
  ) {
    let done = index >= 8192_u64;
    if done {
      break @scan;
    }
    let second = index +wrap 1_u64;
    let third = index +wrap 2_u64;
    let fourth = index +wrap 3_u64;
    let fifth = index +wrap 4_u64;
    let sixth = index +wrap 5_u64;
    let seventh = index +wrap 6_u64;
    let eighth = index +wrap 7_u64;
    region {
      let name_a_window = mut_slice_of(&uniq name_a);
      region {
        let rendered_a = name_at(name: &uniq name_a_window, index: index);
      }
    }
    region {
      let name_b_window = mut_slice_of(&uniq name_b);
      region {
        let rendered_b = name_at(name: &uniq name_b_window, index: second);
      }
    }
    region {
      let name_c_window = mut_slice_of(&uniq name_c);
      region {
        let rendered_c = name_at(name: &uniq name_c_window, index: third);
      }
    }
    region {
      let name_d_window = mut_slice_of(&uniq name_d);
      region {
        let rendered_d = name_at(name: &uniq name_d_window, index: fourth);
      }
    }
    region {
      let name_e_window = mut_slice_of(&uniq name_e);
      region {
        let rendered_e = name_at(name: &uniq name_e_window, index: fifth);
      }
    }
    region {
      let name_f_window = mut_slice_of(&uniq name_f);
      region {
        let rendered_f = name_at(name: &uniq name_f_window, index: sixth);
      }
    }
    region {
      let name_g_window = mut_slice_of(&uniq name_g);
      region {
        let rendered_g = name_at(name: &uniq name_g_window, index: seventh);
      }
    }
    region {
      let name_h_window = mut_slice_of(&uniq name_h);
      region {
        let rendered_h = name_at(name: &uniq name_h_window, index: eighth);
      }
    }
    region {
      let native_window_103 = slice_of(&name_a);
      region {
        region {
          let opened_a = open_file(factory: &uniq deref(files), root: cwd, name: &native_window_103, start: 0_u64, end: 10_u64);
          region {
            let native_window_104 = slice_of(&name_b);
            region {
              let opened_b = open_file(factory: &uniq deref(files), root: cwd, name: &native_window_104, start: 0_u64, end: 10_u64);
              region {
                let native_window_105 = slice_of(&name_c);
                region {
                  let opened_c = open_file(factory: &uniq deref(files), root: cwd, name: &native_window_105, start: 0_u64, end: 10_u64);
                  region {
                    let native_window_106 = slice_of(&name_d);
                    region {
                      let opened_d = open_file(factory: &uniq deref(files), root: cwd, name: &native_window_106, start: 0_u64, end: 10_u64);
                      region {
                        let native_window_107 = slice_of(&name_e);
                        region {
                          let opened_e = open_file(factory: &uniq deref(files), root: cwd, name: &native_window_107, start: 0_u64, end: 10_u64);
                          region {
                            let native_window_108 = slice_of(&name_f);
                            region {
                              let opened_f = open_file(factory: &uniq deref(files), root: cwd, name: &native_window_108, start: 0_u64, end: 10_u64);
                              region {
                                let native_window_109 = slice_of(&name_g);
                                region {
                                  let opened_g = open_file(factory: &uniq deref(files), root: cwd, name: &native_window_109, start: 0_u64, end: 10_u64);
                                  region {
                                    let native_window_110 = slice_of(&name_h);
                                    region {
                                      let opened_h = open_file(factory: &uniq deref(files), root: cwd, name: &native_window_110, start: 0_u64, end: 10_u64);
                                      match opened_a {
                                        Ok(value: handle_a) => {
                                          match opened_b {
                                            Ok(value: handle_b) => {
                                              match opened_c {
                                                Ok(value: handle_c) => {
                                                  match opened_d {
                                                    Ok(value: handle_d) => {
                                                      match opened_e {
                                                        Ok(value: handle_e) => {
                                                          match opened_f {
                                                            Ok(value: handle_f) => {
                                                              match opened_g {
                                                                Ok(value: handle_g) => {
                                                                  match opened_h {
                                                                    Ok(value: handle_h) => {
                                                                      region {
                                                                        let native_window_111 = mut_slice_of(&uniq data_a);
                                                                        region {
                                                                          region {
                                                                            let read_a = read_at(factory: &uniq deref(files), file: &uniq handle_a, destination: &uniq native_window_111, file_offset: 0_u64, start: 0_u64, end: 65536_u64);
                                                                            region {
                                                                              let native_window_112 = mut_slice_of(&uniq data_b);
                                                                              region {
                                                                                let read_b = read_at(factory: &uniq deref(files), file: &uniq handle_b, destination: &uniq native_window_112, file_offset: 0_u64, start: 0_u64, end: 65536_u64);
                                                                                region {
                                                                                  let native_window_113 = mut_slice_of(&uniq data_c);
                                                                                  region {
                                                                                    let read_c = read_at(factory: &uniq deref(files), file: &uniq handle_c, destination: &uniq native_window_113, file_offset: 0_u64, start: 0_u64, end: 65536_u64);
                                                                                    region {
                                                                                      let native_window_114 = mut_slice_of(&uniq data_d);
                                                                                      region {
                                                                                        let read_d = read_at(factory: &uniq deref(files), file: &uniq handle_d, destination: &uniq native_window_114, file_offset: 0_u64, start: 0_u64, end: 65536_u64);
                                                                                        region {
                                                                                          let native_window_115 = mut_slice_of(&uniq data_e);
                                                                                          region {
                                                                                            let read_e = read_at(factory: &uniq deref(files), file: &uniq handle_e, destination: &uniq native_window_115, file_offset: 0_u64, start: 0_u64, end: 65536_u64);
                                                                                            region {
                                                                                              let native_window_116 = mut_slice_of(&uniq data_f);
                                                                                              region {
                                                                                                let read_f = read_at(factory: &uniq deref(files), file: &uniq handle_f, destination: &uniq native_window_116, file_offset: 0_u64, start: 0_u64, end: 65536_u64);
                                                                                                region {
                                                                                                  let native_window_117 = mut_slice_of(&uniq data_g);
                                                                                                  region {
                                                                                                    let read_g = read_at(factory: &uniq deref(files), file: &uniq handle_g, destination: &uniq native_window_117, file_offset: 0_u64, start: 0_u64, end: 65536_u64);
                                                                                                    region {
                                                                                                      let native_window_118 = mut_slice_of(&uniq data_h);
                                                                                                      region {
                                                                                                        let read_h = read_at(factory: &uniq deref(files), file: &uniq handle_h, destination: &uniq native_window_118, file_offset: 0_u64, start: 0_u64, end: 65536_u64);
                                                                                                        match read_a {
                                                                                                          Ok(value: produced_a) => {
                                                                                                            let digest_a = 0_u64;
                                                                                                            region {
                                                                                                              set digest_a = fold_bytes(source: &data_a, produced: produced_a, seed: 0_u64);
                                                                                                            }
                                                                                                            let weight_a = index +wrap 1_u64;
                                                                                                            set digest_a = digest_a *wrap weight_a;
                                                                                                            set sum_a = sum_a +wrap digest_a;
                                                                                                            set bytes = bytes +wrap produced_a;
                                                                                                          }
                                                                                                          Err(error: read_stop_95) => {
                                                                                                            match read_stop_95 {
                                                                                                              ReadEnd() => {
                                                                                                              }
                                                                                                              ReadFailed(error: problem_a) => {
                                                                                                              }
                                                                                                            }
                                                                                                          }
                                                                                                        }
                                                                                                        match read_b {
                                                                                                          Ok(value: produced_b) => {
                                                                                                            let digest_b = 0_u64;
                                                                                                            region {
                                                                                                              set digest_b = fold_bytes(source: &data_b, produced: produced_b, seed: 0_u64);
                                                                                                            }
                                                                                                            let weight_b = second +wrap 1_u64;
                                                                                                            set digest_b = digest_b *wrap weight_b;
                                                                                                            set sum_b = sum_b +wrap digest_b;
                                                                                                            set bytes = bytes +wrap produced_b;
                                                                                                          }
                                                                                                          Err(error: read_stop_96) => {
                                                                                                            match read_stop_96 {
                                                                                                              ReadEnd() => {
                                                                                                              }
                                                                                                              ReadFailed(error: problem_b) => {
                                                                                                              }
                                                                                                            }
                                                                                                          }
                                                                                                        }
                                                                                                        match read_c {
                                                                                                          Ok(value: produced_c) => {
                                                                                                            let digest_c = 0_u64;
                                                                                                            region {
                                                                                                              set digest_c = fold_bytes(source: &data_c, produced: produced_c, seed: 0_u64);
                                                                                                            }
                                                                                                            let weight_c = third +wrap 1_u64;
                                                                                                            set digest_c = digest_c *wrap weight_c;
                                                                                                            set sum_c = sum_c +wrap digest_c;
                                                                                                            set bytes = bytes +wrap produced_c;
                                                                                                          }
                                                                                                          Err(error: read_stop_97) => {
                                                                                                            match read_stop_97 {
                                                                                                              ReadEnd() => {
                                                                                                              }
                                                                                                              ReadFailed(error: problem_c) => {
                                                                                                              }
                                                                                                            }
                                                                                                          }
                                                                                                        }
                                                                                                        match read_d {
                                                                                                          Ok(value: produced_d) => {
                                                                                                            let digest_d = 0_u64;
                                                                                                            region {
                                                                                                              set digest_d = fold_bytes(source: &data_d, produced: produced_d, seed: 0_u64);
                                                                                                            }
                                                                                                            let weight_d = fourth +wrap 1_u64;
                                                                                                            set digest_d = digest_d *wrap weight_d;
                                                                                                            set sum_d = sum_d +wrap digest_d;
                                                                                                            set bytes = bytes +wrap produced_d;
                                                                                                          }
                                                                                                          Err(error: read_stop_98) => {
                                                                                                            match read_stop_98 {
                                                                                                              ReadEnd() => {
                                                                                                              }
                                                                                                              ReadFailed(error: problem_d) => {
                                                                                                              }
                                                                                                            }
                                                                                                          }
                                                                                                        }
                                                                                                        match read_e {
                                                                                                          Ok(value: produced_e) => {
                                                                                                            let digest_e = 0_u64;
                                                                                                            region {
                                                                                                              set digest_e = fold_bytes(source: &data_e, produced: produced_e, seed: 0_u64);
                                                                                                            }
                                                                                                            let weight_e = fifth +wrap 1_u64;
                                                                                                            set digest_e = digest_e *wrap weight_e;
                                                                                                            set sum_e = sum_e +wrap digest_e;
                                                                                                            set bytes = bytes +wrap produced_e;
                                                                                                          }
                                                                                                          Err(error: read_stop_99) => {
                                                                                                            match read_stop_99 {
                                                                                                              ReadEnd() => {
                                                                                                              }
                                                                                                              ReadFailed(error: problem_e) => {
                                                                                                              }
                                                                                                            }
                                                                                                          }
                                                                                                        }
                                                                                                        match read_f {
                                                                                                          Ok(value: produced_f) => {
                                                                                                            let digest_f = 0_u64;
                                                                                                            region {
                                                                                                              set digest_f = fold_bytes(source: &data_f, produced: produced_f, seed: 0_u64);
                                                                                                            }
                                                                                                            let weight_f = sixth +wrap 1_u64;
                                                                                                            set digest_f = digest_f *wrap weight_f;
                                                                                                            set sum_f = sum_f +wrap digest_f;
                                                                                                            set bytes = bytes +wrap produced_f;
                                                                                                          }
                                                                                                          Err(error: read_stop_100) => {
                                                                                                            match read_stop_100 {
                                                                                                              ReadEnd() => {
                                                                                                              }
                                                                                                              ReadFailed(error: problem_f) => {
                                                                                                              }
                                                                                                            }
                                                                                                          }
                                                                                                        }
                                                                                                        match read_g {
                                                                                                          Ok(value: produced_g) => {
                                                                                                            let digest_g = 0_u64;
                                                                                                            region {
                                                                                                              set digest_g = fold_bytes(source: &data_g, produced: produced_g, seed: 0_u64);
                                                                                                            }
                                                                                                            let weight_g = seventh +wrap 1_u64;
                                                                                                            set digest_g = digest_g *wrap weight_g;
                                                                                                            set sum_g = sum_g +wrap digest_g;
                                                                                                            set bytes = bytes +wrap produced_g;
                                                                                                          }
                                                                                                          Err(error: read_stop_101) => {
                                                                                                            match read_stop_101 {
                                                                                                              ReadEnd() => {
                                                                                                              }
                                                                                                              ReadFailed(error: problem_g) => {
                                                                                                              }
                                                                                                            }
                                                                                                          }
                                                                                                        }
                                                                                                        match read_h {
                                                                                                          Ok(value: produced_h) => {
                                                                                                            let digest_h = 0_u64;
                                                                                                            region {
                                                                                                              set digest_h = fold_bytes(source: &data_h, produced: produced_h, seed: 0_u64);
                                                                                                            }
                                                                                                            let weight_h = eighth +wrap 1_u64;
                                                                                                            set digest_h = digest_h *wrap weight_h;
                                                                                                            set sum_h = sum_h +wrap digest_h;
                                                                                                            set bytes = bytes +wrap produced_h;
                                                                                                          }
                                                                                                          Err(error: read_stop_102) => {
                                                                                                            match read_stop_102 {
                                                                                                              ReadEnd() => {
                                                                                                              }
                                                                                                              ReadFailed(error: problem_h) => {
                                                                                                              }
                                                                                                            }
                                                                                                          }
                                                                                                        }
                                                                                                      }
                                                                                                    }
                                                                                                  }
                                                                                                }
                                                                                              }
                                                                                            }
                                                                                          }
                                                                                        }
                                                                                      }
                                                                                    }
                                                                                  }
                                                                                }
                                                                              }
                                                                            }
                                                                          }
                                                                          close_read(factory: &uniq deref(files), file: move handle_h);
                                                                        }
                                                                      }
                                                                    }
                                                                    Err(error: failed_h) => {
                                                                      region {
                                                                        let failure_status = if factory_refusal(error: &failed_h) {
                                                                          give 19_u8;
                                                                        } else {
                                                                          give 11_u8;
                                                                        }
                                                                        close_read(factory: &uniq deref(files), file: move handle_g);
                                                                        close_read(factory: &uniq deref(files), file: move handle_f);
                                                                        close_read(factory: &uniq deref(files), file: move handle_e);
                                                                        close_read(factory: &uniq deref(files), file: move handle_d);
                                                                        close_read(factory: &uniq deref(files), file: move handle_c);
                                                                        close_read(factory: &uniq deref(files), file: move handle_b);
                                                                        close_read(factory: &uniq deref(files), file: move handle_a);
                                                                        return exit_status(code: failure_status);
                                                                      }
                                                                    }
                                                                  }
                                                                  close_read(factory: &uniq deref(files), file: move handle_g);
                                                                }
                                                                Err(error: failed_g) => {
                                                                  region {
                                                                    let failure_status = if factory_refusal(error: &failed_g) {
                                                                      give 18_u8;
                                                                    } else {
                                                                      give 10_u8;
                                                                    }
                                                                    close_read(factory: &uniq deref(files), file: move handle_f);
                                                                    close_read(factory: &uniq deref(files), file: move handle_e);
                                                                    close_read(factory: &uniq deref(files), file: move handle_d);
