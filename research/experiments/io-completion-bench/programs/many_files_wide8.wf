                                                                close_read(factory: &uniq deref(files), file: move handle_b);
                                                                close_read(factory: &uniq deref(files), file: move handle_a);
                                                                discard_open_result(factory: &uniq deref(files), outcome: move opened_h);
                                                                discard_open_result(factory: &uniq deref(files), outcome: move opened_g);
                                                                return exit_status(code: failure_status);
                                                              }
