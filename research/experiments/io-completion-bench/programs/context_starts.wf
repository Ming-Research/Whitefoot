alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;

fn tick(value: u64) -> result: u64 pure waits {
  doc "Returns its argument; a context that runs it does nothing else.";
  return value;
}

fn batch(count: u64) -> result: unit pure waits {
  doc "Starts one context per position and waits for every one of them as it returns [WAIT-3].";
  let at = 0_u64;
  loop @starting {
    if at >= count {
      break @starting;
    }
    spawn tick(value: at);
    set at = at +wrap 1_u64;
  }
  return unit;
}

fn bound(count: u64) -> result: u64 pure waits {
  doc "Starts one bound context per position and joins it at once, where its result is added [WAIT-2].";
  let total = 0_u64;
  let at = 0_u64;
  loop @joining {
    if at >= count {
      break @joining;
    }
    let got = spawn tick(value: at);
    set total = total +wrap got;
    set at = at +wrap 1_u64;
  }
  return total;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Starts a thousand batches of a thousand contexts, then a million contexts each joined at once.";
  let Inputs(args: unused_args, cwd: unused_cwd, stdout: unused_stdout, stderr: unused_stderr, handles: handles, stdin: unused_stdin) = move inputs;
  close_directory(factory: &handles, directory: move unused_cwd);
  let rounds = 0_u64;
  loop @rounds {
    if rounds >= 1000_u64 {
      break @rounds;
    }
    batch(count: 1000_u64);
    set rounds = rounds +wrap 1_u64;
  }
  let total = bound(count: 1000000_u64);
  if total == 499999500000_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
