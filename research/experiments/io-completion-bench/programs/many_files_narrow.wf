fn name_at(name: &uniq MutSlice<u8>, index: own u64) -> result: own unit reads(name), writes(name) {
  doc "Renders the fixed ten-byte generated file name for one index as f00000.dat.";
  let room = len_of(deref(name));
  let sized = room >= 10_u64;
  if sized {
  } else {
    return unit;
  }
  set deref(name)[0_u64] = 102_u8;
  let value = index;
  let position = 5_u64;
  loop @digits {
    let digit = value % 10_u64;
    let narrowed = cvt::<u64, u8>(digit);
    let byte = match narrowed {
      Ok(value: exact) => {
        give 48_u8 +wrap exact;
      }
      Err(error: failure) => {
        give 48_u8;
      }
    }
    let writable = position < room;
    if writable {
      set deref(name)[position] = byte;
    }
    set value = value / 10_u64;
    let done = position == 1_u64;
    if done {
      break @digits;
    }
    set position = position -wrap 1_u64;
  }
  set deref(name)[6_u64] = 46_u8;
  set deref(name)[7_u64] = 100_u8;
  set deref(name)[8_u64] = 97_u8;
  set deref(name)[9_u64] = 116_u8;
  return unit;
}

fn render_u64(destination: &uniq MutSlice<u8>, at: own u64, value: own u64) -> result: own u64 reads(destination), writes(destination) {
  doc "Renders one twenty-digit zero-padded decimal number and reports the position after it.";
  let room = len_of(deref(destination));
  let remaining = value;
  let position = at +wrap 20_u64;
  loop @digits {
    let done = position <= at;
    if done {
      break @digits;
    }
    set position = position -wrap 1_u64;
    let digit = remaining % 10_u64;
    let narrowed = cvt::<u64, u8>(digit);
    let byte = match narrowed {
      Ok(value: exact) => {
        give 48_u8 +wrap exact;
      }
      Err(error: failure) => {
        give 48_u8;
      }
    }
    let writable = position < room;
    if writable {
      set deref(destination)[position] = byte;
    }
    set remaining = remaining / 10_u64;
  }
  return at +wrap 20_u64;
}

fn fold_bytes(source: &buffer<u8>, produced: own u64, seed: own u64) -> result: own u64 reads(source) {
  doc "Folds one read prefix into a running order-sensitive checksum.";
  let room = len_of(deref(source));
  let sum = seed;
  let at = 0_u64;
  loop @fold {
    let scanned = at >= produced;
    if scanned {
      break @fold;
    }
    let readable = at < room;
    if readable {
    } else {
      break @fold;
    }
    let byte = deref(source)[at];
    let widened = cvt::<u8, u64>(byte);
    set sum = sum *wrap 31_u64;
    set sum = sum +wrap widened;
    set at = at +wrap 1_u64;
  }
  return sum;
}

fn exercise(cwd: &DirectoryRead, out: &uniq OutputStream, files: &uniq HandleFactory) -> status: own ExitStatus reads(cwd, out, files), writes(out, files) {
  doc "Opens and reads the generated file set one file at a time and publishes one folded checksum.";
  let name = buffer_new(16_u64, 0_u8);
  let data = buffer_new(65536_u64, 0_u8);
  let line = buffer_new(64_u64, 0_u8);
  let sum = 0_u64;
  let bytes = 0_u64;
  let index = 0_u64;
  loop @scan (
    invariant name_room: len_of(name) >= 16_u64
  ) {
    let done = index >= 8192_u64;
    if done {
      break @scan;
    }
    region {
      let name_window = mut_slice_of(&uniq name);
      region {
        let rendered = name_at(name: &uniq name_window, index: index);
      }
    }
    region {
      let native_window_68 = slice_of(&name);
      region {
        region {
          match open_file(factory: &uniq deref(files), root: cwd, name: &native_window_68, start: 0_u64, end: 10_u64) {
            Ok(value: handle) => {
              region {
                let native_window_67 = mut_slice_of(&uniq data);
                region {
                  region {
                    match read_at(factory: &uniq deref(files), file: &uniq handle, destination: &uniq native_window_67, file_offset: 0_u64, start: 0_u64, end: 65536_u64) {
                      Ok(value: produced) => {
                        let digest = 0_u64;
                        region {
                          set digest = fold_bytes(source: &data, produced: produced, seed: 0_u64);
                        }
                        let weight = index +wrap 1_u64;
                        set digest = digest *wrap weight;
                        set sum = sum +wrap digest;
                        set bytes = bytes +wrap produced;
                      }
                      Err(error: read_stop_66) => {
                        match read_stop_66 {
                          ReadEnd() => {
                          }
                          ReadFailed(error: problem) => {
                          }
                        }
                      }
                    }
                  }
                  close_read(factory: &uniq deref(files), file: move handle);
                }
              }
            }
            Err(error: problem) => {
            }
          }
        }
        set index = index +wrap 1_u64;
      }
    }
  }
  let room = len_of(line);
  let cursor = 0_u64;
  region {
    let line_window = mut_slice_of(&uniq line);
    region {
      set cursor = render_u64(destination: &uniq line_window, at: cursor, value: sum);
    }
  }
  let space_fits = cursor < room;
  if space_fits {
    set line[cursor] = 32_u8;
    set cursor = cursor +wrap 1_u64;
  }
  region {
    let line_window = mut_slice_of(&uniq line);
    region {
      set cursor = render_u64(destination: &uniq line_window, at: cursor, value: bytes);
    }
  }
  let end_fits = cursor < room;
  if end_fits {
    set line[cursor] = 10_u8;
    set cursor = cursor +wrap 1_u64;
  }
  let status = 0_u8;
  let publishable = cursor <= room;
  if publishable {
    region {
      let native_window_69 = slice_of(&line);
      region {
        match write_once(factory: &uniq deref(files), output: &uniq deref(out), source: &native_window_69, start: 0_u64, end: cursor) {
          Ok(value: written) => {
          }
          Err(error: problem) => {
            set status = 2_u8;
          }
        }
      }
    }
  } else {
    set status = 3_u8;
  }
  return exit_status(code: status);
}

fn main(inputs: own Inputs) -> status: own ExitStatus pure {
  doc "PRE-1 ordinary Inputs are destructured once; the borrowed operation chain returns before the initial directory is explicitly closed on every exit.";
  let Inputs(args: unused_args, cwd: cwd, stdout: out, stderr: unused_stderr, handles: files, stdin: unused_stdin, ..) = move inputs;
  region {
    let outcome = exercise(cwd: &cwd, out: &uniq out, files: &uniq files);
    close_directory(factory: &uniq files, directory: move cwd);
    return move outcome;
  }
}
