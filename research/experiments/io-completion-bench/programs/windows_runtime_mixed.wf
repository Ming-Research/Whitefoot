fn factory_refusal(error: &IoError) -> result: own Bool reads(error) {
  match deref(error) {
    NotFound(code: native_code, origin: native_origin) => {
      return False();
    }
    PermissionDenied(code: native_code, origin: native_origin) => {
      return False();
    }
    AlreadyExists(code: native_code, origin: native_origin) => {
      return False();
    }
    NotDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    IsDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    DirectoryNotEmpty(code: native_code, origin: native_origin) => {
      return False();
    }
    ReadOnly(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceBusy(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidInput(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidPath(code: native_code, origin: native_origin) => {
      return False();
    }
    Unsupported(code: native_code, origin: native_origin) => {
      return False();
    }
    TimedOut(code: native_code, origin: native_origin) => {
      return False();
    }
    BrokenPipe(code: native_code, origin: native_origin) => {
      return False();
    }
    WriteZero(code: native_code, origin: native_origin) => {
      return False();
    }
    UnexpectedEnd(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionRefused(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionReset(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionAborted(code: native_code, origin: native_origin) => {
      return False();
    }
    NotConnected(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressInUse(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressUnavailable(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceExhausted(code: native_code, origin: native_origin) => {
      return deref(native_origin) == 0_u8;
    }
    FileTooLarge(code: native_code, origin: native_origin) => {
      return False();
    }
    NoSpace(code: native_code, origin: native_origin) => {
      return False();
    }
    QuotaExceeded(code: native_code, origin: native_origin) => {
      return False();
    }
    CrossDevice(code: native_code, origin: native_origin) => {
      return False();
    }
    DeviceFailure(code: native_code, origin: native_origin) => {
      return False();
    }
    Other(code: native_code, origin: native_origin) => {
      return False();
    }
  }
}

fn discard_open_result(factory: &uniq HandleFactory, outcome: own Result<ReadFile, IoError>) -> result: own unit reads(factory), writes(factory) {
  match move outcome {
    Ok(value: file) => {
      region {
        close_read(factory: &uniq deref(factory), file: move file);
      }
    }
    Err(error: problem) => {
    }
  }
  return unit;
}

fn churn(seed: own u64) -> result: own u64 pure {
  doc "Runs a fixed integer kernel long enough for the native compute pool to do useful work.";
  let value = seed;
  let round = 0_u64;
  loop @rounds {
    let done = round == 65536_u64;
    if done {
      break @rounds;
    }
    let rotated = irotl(value, 17_u32);
    set value = ixor(value, rotated);
    set value = value *wrap 6364136223846793005_u64;
    set value = value +wrap 1442695040888963407_u64;
    set round = round +wrap 1_u64;
  }
  return value;
}

fn compute_pair(left_seed: own u64, right_seed: own u64) -> result: own u64 pure {
  doc "Offers two independent coarse compute kernels between the caller's completed first read and its next read.";
  let left = churn(seed: left_seed);
  let right = churn(seed: right_seed);
  let rotated = irotl(right, 23_u32);
  return ixor(left, rotated);
}

fn render_u64(destination: &uniq MutSlice<u8>, value: own u64) -> result: own unit reads(destination), writes(destination) {
  doc "Renders one twenty-digit zero-padded decimal result.";
  let room = len_of(deref(destination));
  let remaining = value;
  let position = 20_u64;
  loop @digits {
    let done = position == 0_u64;
    if done {
      break @digits;
    }
    set position = position -wrap 1_u64;
    let digit = remaining % 10_u64;
    let writable = position < room;
    if writable {
      match cvt::<u64, u8>(digit) {
        Ok(value: exact) => {
          set deref(destination)[position] = 48_u8 +wrap exact;
        }
        Err(error: failure) => {
          set deref(destination)[position] = 63_u8;
        }
      }
    }
    set remaining = remaining / 10_u64;
  }
  return unit;
}

fn exercise(args: &Args, cwd: &DirectoryRead, out: &uniq OutputStream, files: &uniq HandleFactory) -> status: own ExitStatus reads(args, cwd, out, files), writes(out, files) {
  doc "Pairs independent compute calls with independent positioned reads in one production runtime and publishes one deterministic checksum.";
  let left_data = buffer_new(4096_u64, 0_u8);
  let right_data = buffer_new(4096_u64, 0_u8);
  let report = buffer_new(21_u64, 10_u8);
  region {
    match arg_get(args: args, position: 1_u64) {
      Ok(value: left_text) => {
        match relative_path(value: move left_text) {
          Ok(value: left_path) => {
            region {
              match arg_get(args: args, position: 2_u64) {
                Ok(value: right_text) => {
                  match relative_path(value: move right_text) {
                    Ok(value: right_path) => {
                      region {
                        let left_opened = open_read(factory: &uniq deref(files), root: cwd, path: &left_path);
                        let right_opened = open_read(factory: &uniq deref(files), root: cwd, path: &right_path);
                        match move left_opened {
                          Ok(value: left_file) => {
                            match move right_opened {
                              Ok(value: right_file) => {
                                let checksum = 0_u64;
                                let iteration = 0_u64;
                                loop @work {
                                  let done = iteration == 1024_u64;
                                  if done {
                                    break @work;
                                  }
                                  let left_seed = iteration +wrap 11400714819323198485_u64;
                                  let right_seed = iteration +wrap 13787848793156543929_u64;
                                  let block = iand(iteration, 4095_u64);
                                  let offset = block *wrap 4096_u64;
                                  region {
                                    let native_window_131 = mut_slice_of(&uniq left_data);
                                    region {
                                      region {
                                        let left_read = read_at(factory: &uniq deref(files), file: &uniq left_file, destination: &uniq native_window_131, file_offset: offset, start: 0_u64, end: 4096_u64);
                                        let compute = compute_pair(left_seed: left_seed, right_seed: right_seed);
                                        region {
                                          let native_window_132 = mut_slice_of(&uniq right_data);
                                          region {
                                            let right_read = read_at(factory: &uniq deref(files), file: &uniq right_file, destination: &uniq native_window_132, file_offset: offset, start: 0_u64, end: 4096_u64);
                                            match move left_read {
                                              Ok(value: left_next) => {
                                                if left_next == 4096_u64 {
                                                } else {
                                                  close_read(factory: &uniq deref(files), file: move right_file);
                                                  close_read(factory: &uniq deref(files), file: move left_file);
                                                  return exit_status(code: 11_u8);
                                                }
                                              }
                                              Err(error: read_stop_129) => {
                                                match read_stop_129 {
                                                  ReadEnd() => {
                                                    close_read(factory: &uniq deref(files), file: move right_file);
                                                    close_read(factory: &uniq deref(files), file: move left_file);
                                                    return exit_status(code: 12_u8);
                                                  }
                                                  ReadFailed(error: left_problem) => {
                                                    close_read(factory: &uniq deref(files), file: move right_file);
                                                    close_read(factory: &uniq deref(files), file: move left_file);
                                                    return exit_status(code: 13_u8);
                                                  }
                                                }
                                              }
                                            }
                                            match move right_read {
                                              Ok(value: right_next) => {
                                                if right_next == 4096_u64 {
                                                } else {
                                                  close_read(factory: &uniq deref(files), file: move right_file);
                                                  close_read(factory: &uniq deref(files), file: move left_file);
                                                  return exit_status(code: 14_u8);
                                                }
                                              }
                                              Err(error: read_stop_130) => {
                                                match read_stop_130 {
                                                  ReadEnd() => {
                                                    close_read(factory: &uniq deref(files), file: move right_file);
                                                    close_read(factory: &uniq deref(files), file: move left_file);
                                                    return exit_status(code: 15_u8);
                                                  }
                                                  ReadFailed(error: right_problem) => {
                                                    close_read(factory: &uniq deref(files), file: move right_file);
                                                    close_read(factory: &uniq deref(files), file: move left_file);
                                                    return exit_status(code: 16_u8);
                                                  }
                                                }
                                              }
                                            }
                                            let left_byte = cvt::<u8, u64>(left_data[0_u64]);
                                            let right_byte = cvt::<u8, u64>(right_data[0_u64]);
                                            set checksum = ixor(checksum, compute);
                                            set checksum = checksum *wrap 31_u64;
                                            set checksum = checksum +wrap left_byte;
                                            set checksum = checksum *wrap 31_u64;
                                            set checksum = checksum +wrap right_byte;
                                          }
                                        }
                                      }
                                      set iteration = iteration +wrap 1_u64;
                                    }
                                  }
                                }
                                region {
                                  let report_window = mut_slice_of(&uniq report);
                                  region {
                                    let rendered = render_u64(destination: &uniq report_window, value: checksum);
                                  }
                                }
                                region {
                                  let native_window_133 = slice_of(&report);
                                  region {
                                    match write_once(factory: &uniq deref(files), output: &uniq deref(out), source: &native_window_133, start: 0_u64, end: 21_u64) {
                                      Ok(value: published) => {
                                        if published == 21_u64 {
                                          close_read(factory: &uniq deref(files), file: move right_file);
                                          close_read(factory: &uniq deref(files), file: move left_file);
                                          return exit_status(code: 0_u8);
                                        }
                                        close_read(factory: &uniq deref(files), file: move right_file);
                                        close_read(factory: &uniq deref(files), file: move left_file);
                                        return exit_status(code: 17_u8);
                                      }
                                      Err(error: output_problem) => {
                                        close_read(factory: &uniq deref(files), file: move right_file);
                                        close_read(factory: &uniq deref(files), file: move left_file);
                                        return exit_status(code: 18_u8);
                                      }
                                    }
                                  }
                                }
                              }
                              Err(error: right_problem) => {
                                region {
                                  let failure_status = if factory_refusal(error: &right_problem) {
                                    give 20_u8;
                                  } else {
                                    give 6_u8;
                                  }
                                  close_read(factory: &uniq deref(files), file: move left_file);
                                  return exit_status(code: failure_status);
                                }
                              }
                            }
                          }
                          Err(error: left_problem) => {
                            region {
                              let failure_status = if factory_refusal(error: &left_problem) {
                                give 19_u8;
                              } else {
                                give 5_u8;
                              }
                              discard_open_result(factory: &uniq deref(files), outcome: move right_opened);
                              return exit_status(code: failure_status);
                            }
                          }
                        }
                      }
                    }
                    Err(error: right_rejected) => {
                      return exit_status(code: 4_u8);
                    }
                  }
                }
                Err(error: right_missing) => {
                  return exit_status(code: 3_u8);
                }
              }
            }
          }
          Err(error: left_rejected) => {
            return exit_status(code: 2_u8);
          }
        }
      }
      Err(error: left_missing) => {
        return exit_status(code: 1_u8);
      }
    }
  }
}

fn main(inputs: own Inputs) -> status: own ExitStatus pure {
  doc "PRE-1 ordinary Inputs are destructured once; the borrowed operation chain returns before the initial directory is explicitly closed on every exit.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: unused_stderr, handles: files, stdin: unused_stdin, ..) = move inputs;
  region {
    let outcome = exercise(args: &args, cwd: &cwd, out: &uniq out, files: &uniq files);
    close_directory(factory: &uniq files, directory: move cwd);
    return move outcome;
  }
}
