fn factory_refusal(error: &IoError) -> result: own Bool reads(error) {
  match deref(error) {
    NotFound(code: native_code, origin: native_origin) => {
      return False();
    }
    PermissionDenied(code: native_code, origin: native_origin) => {
      return False();
    }
    AlreadyExists(code: native_code, origin: native_origin) => {
      return False();
    }
    NotDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    IsDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    DirectoryNotEmpty(code: native_code, origin: native_origin) => {
      return False();
    }
    ReadOnly(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceBusy(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidInput(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidPath(code: native_code, origin: native_origin) => {
      return False();
    }
    Unsupported(code: native_code, origin: native_origin) => {
      return False();
    }
    TimedOut(code: native_code, origin: native_origin) => {
      return False();
    }
    BrokenPipe(code: native_code, origin: native_origin) => {
      return False();
    }
    WriteZero(code: native_code, origin: native_origin) => {
      return False();
    }
    UnexpectedEnd(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionRefused(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionReset(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionAborted(code: native_code, origin: native_origin) => {
      return False();
    }
    NotConnected(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressInUse(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressUnavailable(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceExhausted(code: native_code, origin: native_origin) => {
      return deref(native_origin) == 0_u8;
    }
    FileTooLarge(code: native_code, origin: native_origin) => {
      return False();
    }
    NoSpace(code: native_code, origin: native_origin) => {
      return False();
    }
    QuotaExceeded(code: native_code, origin: native_origin) => {
      return False();
    }
    CrossDevice(code: native_code, origin: native_origin) => {
      return False();
    }
    DeviceFailure(code: native_code, origin: native_origin) => {
      return False();
    }
    Other(code: native_code, origin: native_origin) => {
      return False();
    }
  }
}

fn byte_at(store: &buffer<u8>, index: own u64) -> result: own u8 reads(store) {
  doc "Reads one stored byte, delivering zero for a position the buffer does not hold.";
  let room = len_of(deref(store));
  let inside = index < room;
  if inside {
    let value = deref(store)[index];
    return value;
  }
  return 0_u8;
}

fn parse_number(digits: &buffer<u8>, length: own u64) -> result: own u64 reads(digits) {
  doc "Reads one decimal number out of the argument bytes the invocation supplied; a byte that is not a digit ends the number.";
  let value = 0_u64;
  let ended = 0_u8;
  let index = 0_u64;
  loop @scan {
    let more = index < length;
    if more {
    } else {
      break @scan;
    }
    let byte = byte_at(store: digits, index: index);
    let low = byte >= 48_u8;
    let high = byte <= 57_u8;
    let digit = band(low, high);
    if digit {
      let value_byte = byte -wrap 48_u8;
      let widened = cvt::<u8, u64>(value_byte);
      let scaled = value *wrap 10_u64;
      set value = scaled +wrap widened;
    } else {
      set ended = 1_u8;
    }
    if ended == 0_u8 {
      set index = index +wrap 1_u64;
    } else {
      break @scan;
    }
  }
  return value;
}

fn argument(args: &Args, position: own u64) -> result: own u64 reads(args) {
  doc "One decimal invocation argument, through the text route, so the digits are the same bytes on every host string family through the ordinary text-copy library contract; zero when the argument is absent or not text.";
  let digits = buffer_new(24_u64, 0_u8);
  let carried = 0_u64;
  region {
    match arg_get(args: args, position: position) {
      Ok(value: text) => {
        region {
          region {
            let native_window_161 = mut_slice_of(&uniq digits);
            region {
              match host_copy_utf8(value: &text, destination: &uniq native_window_161, start: 0_u64, end: 24_u64) {
                Ok(value: written) => {
                  set carried = written;
                }
                Err(error: problem) => {
                  set carried = 0_u64;
                }
              }
            }
          }
        }
      }
      Err(error: problem) => {
        set carried = 0_u64;
      }
    }
  }
  let value = 0_u64;
  region {
    set value = parse_number(digits: &digits, length: carried);
  }
  return value;
}

fn send_all(send: &uniq TcpSend, source: &Slice<u8>, length: own u64) -> result: own Result<unit, IoError> reads(send, source), writes(send) contract {
  define source_length = len_of(deref(source));
  requires length <= source_length;
} {
  doc "Sends one prefix of the source buffer, reattempting until the connection has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @sending {
    let pending = sent < length;
    if pending {
    } else {
      break @sending;
    }
    region {
      match send_once(send: &uniq deref(send), source: source, start: sent, end: length) {
        Ok(value: next) => {
          set sent = next;
        }
        Err(error: problem) => {
          return Err<unit, IoError>(error: move problem);
        }
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn serve_one(listener: &uniq TcpListener, handles: &uniq HandleFactory, scratch: &uniq buffer<u8>) -> result: own u8 reads(listener, handles, scratch), writes(listener, handles, scratch) contract {
  define room = len_of(deref(scratch));
  requires 65536_u64 <= room;
} {
  doc "Accepts one peer, echoes chunks until its input ends, and explicitly closes both directions before returning the listener and factory loans.";
  let outcome = 0_u8;
  region {
    match tcp_accept(factory: &uniq deref(handles), listener: &uniq deref(listener)) {
      Ok(value: accepted_link) => {
        let AcceptedConnection(connection: link, peer: from) = move accepted_link;
        loop @chunks {
          let available = 0_u64;
          let ended = 0_u8;
          region {
            let window = mut_slice_of(&uniq deref(scratch));
            region {
              match receive_next(receive: &uniq link.receive, destination: &uniq window, start: 0_u64, end: 65536_u64) {
                Ok(value: endpoint) => {
                  set available = endpoint;
                }
                Err(error: read_stop_159) => {
                  match read_stop_159 {
                    ReadEnd() => {
                      set ended = 1_u8;
                    }
                    ReadFailed(error: problem) => {
                      set outcome = 3_u8;
                      set ended = 2_u8;
                    }
                  }
                }
              }
            }
          }
          if ended == 0_u8 {
            region {
              let window = slice_of(&deref(scratch));
              region {
                match send_all(send: &uniq link.send, source: &window, length: available) {
                  Ok(value: delivered) => {
                  }
                  Err(error: problem) => {
                    set outcome = 4_u8;
                    set ended = 2_u8;
                  }
                }
              }
            }
          }
          if ended == 0_u8 {
          } else {
            break @chunks;
          }
        }
        let TcpConnection(receive: close_receive_160, send: close_send_160) = move link;
        close_receive(factory: &uniq deref(handles), receive: move close_receive_160);
        close_send(factory: &uniq deref(handles), send: move close_send_160);
      }
      Err(error: problem) => {
        region {
          if factory_refusal(error: &problem) {
            set outcome = 6_u8;
          } else {
            set outcome = 5_u8;
          }
        }
      }
    }
  }
  return outcome;
}

fn main(inputs: own Inputs) -> status: own ExitStatus pure {
  doc "The ordinary-call TCP echo control serves the requested number of connections sequentially. All peers and payloads match the retained workload; C2 removes PAR-3 overlap over the shared listener and factory.";
  let Inputs(args: args, cwd: unused_cwd, stdout: unused_stdout, stderr: unused_stderr, handles: handles, stdin: unused_stdin, ..) = move inputs;
  region {
    close_directory(factory: &uniq handles, directory: move unused_cwd);
  }
  let arguments = 0_u64;
  region {
    set arguments = args_count(args: &args);
  }
  let named = arguments >= 3_u64;
  if named {
  } else {
    return exit_status(code: 1_u8);
  }
  let port_value = 0_u64;
  let count = 0_u64;
  region {
    set port_value = argument(args: &args, position: 1_u64);
    set count = argument(args: &args, position: 2_u64);
  }
  let port_named = port_value <= 65535_u64;
  let count_named = count >= 1_u64;
  let usable = band(port_named, count_named);
  if usable {
  } else {
    return exit_status(code: 2_u8);
  }
  let port = 0_u16;
  region {
    match cvt::<u64, u16>(port_value) {
      Ok(value: narrowed) => {
        set port = narrowed;
      }
      Err(error: problem) => {
        return exit_status(code: 2_u8);
      }
    }
  }
  let address = socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: port);
  let outcome = 0_u8;
  region {
    region {
      match tcp_listen(factory: &uniq handles, address: &address) {
        Ok(value: bound) => {
          for (
            served in 0_u64..count,
            invariant progress: served <= count
          ) {
            let scratch = buffer_new(65536_u64, 0_u8);
            region {
              let reported = serve_one(listener: &uniq bound, handles: &uniq handles, scratch: &uniq scratch);
              if reported == 6_u8 {
                close_listener(factory: &uniq handles, listener: move bound);
                return exit_status(code: 6_u8);
              }
              if reported == 0_u8 {
              } else {
                set outcome = reported;
              }
            }
          }
          let listener_credit = close_listener(factory: &uniq handles, listener: move bound);
        }
        Err(error: problem) => {
          region {
            if factory_refusal(error: &problem) {
              set outcome = 8_u8;
            } else {
              set outcome = 7_u8;
            }
          }
        }
      }
    }
  }
  return exit_status(code: outcome);
}
