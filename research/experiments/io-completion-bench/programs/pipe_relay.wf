fn main(inputs: own Inputs) -> status: own ExitStatus pure {
  doc "Relays a fixed byte volume onto two outputs, one chunk to each per round. The shared factory orders the writes; a blocked first write delays the second.";
  let Inputs(args: unused_args, cwd: unused_cwd, stdout: out, stderr: err, handles: entry_factory, stdin: unused_stdin, ..) = move inputs;
  region {
    close_directory(factory: &uniq entry_factory, directory: move unused_cwd);
  }
  let left = buffer_new(262144_u64, 65_u8);
  let right = buffer_new(262144_u64, 66_u8);
  let status = 0_u8;
  let round = 0_u64;
  loop @relay {
    let done = round >= 64_u64;
    if done {
      break @relay;
    }
    region {
      let native_window_179 = slice_of(&left);
      region {
        region {
          let published_left = write_once(factory: &uniq entry_factory, output: &uniq out, source: &native_window_179, start: 0_u64, end: 262144_u64);
          region {
            let native_window_180 = slice_of(&right);
            region {
              let published_right = write_once(factory: &uniq entry_factory, output: &uniq err, source: &native_window_180, start: 0_u64, end: 262144_u64);
              match published_left {
                Ok(value: reached_left) => {
                  let complete_left = reached_left == 262144_u64;
                  if complete_left {
                  } else {
                    set status = 4_u8;
                  }
                }
                Err(error: failed_left) => {
                  set status = 2_u8;
                }
              }
              match published_right {
                Ok(value: reached_right) => {
                  let complete_right = reached_right == 262144_u64;
                  if complete_right {
                  } else {
                    set status = 5_u8;
                  }
                }
                Err(error: failed_right) => {
                  set status = 3_u8;
                }
              }
            }
          }
        }
        if status == 0_u8 {
        } else {
          break @relay;
        }
        set round = round +wrap 1_u64;
      }
    }
  }
  return exit_status(code: status);
}
