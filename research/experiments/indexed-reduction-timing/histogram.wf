alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias arg_get = std::text::arg_get;
alias args_count = std::text::args_count;
alias close_directory = std::fs::close_directory;
alias exit_status = std::process::exit_status;
alias host_copy_utf8 = std::text::host_copy_utf8;
alias write_once = std::io::write_once;

fn parse_repetitions(digits: &[u8]) -> result: Option<u64> reads(digits) {
  doc "Parses a nonempty decimal repetition count, rejecting nondigits and u64 overflow.";
  let length = digits^.len;
  let empty = length == 0_u64;
  if empty {
    return None<u64>();
  }
  let total = 0_u64;
  for (index in 0_u64..length) {
    let byte = digits^[index];
    let below_digit = byte < 48_u8;
    let above_digit = byte > 57_u8;
    let invalid_digit = bor(below_digit, above_digit);
    if invalid_digit {
      return None<u64>();
    }
    let small_digit = byte -wrap 48_u8;
    let digit = cvt::<u8, u64>(small_digit);
    let prefix_too_large = total > 1844674407370955161_u64;
    let prefix_at_limit = total == 1844674407370955161_u64;
    let last_too_large = digit > 5_u64;
    let last_overflows = band(prefix_at_limit, last_too_large);
    let overflows = bor(prefix_too_large, last_overflows);
    if overflows {
      return None<u64>();
    }
    let scaled = total *wrap 10_u64;
    set total = scaled +wrap digit;
  }
  return Some<u64>(value: total);
}

fn command_repetitions(arguments: &std::text::Args) -> result: Option<u64> reads(arguments) {
  doc "Reads K from the sole command-line argument after the program name, accepting at most twenty decimal digits.";
  let argument_count = args_count(args: arguments);
  let wrong_count = argument_count != 2_u64;
  if wrong_count {
    return None<u64>();
  }
  let scratch = box_array_filled::<u8>(count: 20_u64, value: 0_u8);
  let window = &scratch.inner[0_u64..scratch.inner.len];
  let capacity = window^.len;
  match arg_get(args: arguments, position: 1_u64) {
    Ok(value: argument_text) => {
      match host_copy_utf8(value: &argument_text, destination: window, start: 0_u64, end: capacity) {
        Ok(value: copied_end) => {
          let copied = &window^[0_u64..copied_end];
          return parse_repetitions(digits: copied);
        }
        Err(error: copy_problem) => {
          return None<u64>();
        }
      }
    }
    Err(error: argument_problem) => {
      return None<u64>();
    }
  }
}

fn low_byte(v: u64) -> result: u8 pure {
  doc "The low eight bits of v as a byte.";
  let low = iand(v, 255_u64);
  let byte = cvt::<u64, u8>(low);
  return byte;
}

fn spell(destination: &[u8], at: u64, value: u64) -> result: u64 writes(destination) {
  doc "Writes the eight little-endian bytes of value at the given offset, skipping any slot the range does not have.";
  let cursor = at;
  let rest = value;
  loop @octets {
    let limit = at +wrap 8_u64;
    let done = cursor >= limit;
    if done {
      break @octets;
    }
    let spare = destination^.len;
    let writable = cursor < spare;
    if writable {
      let byte = low_byte(v: rest);
      set destination^[cursor] = byte;
    }
    set rest = irotr(rest, 8_u32);
    set cursor = cursor +wrap 1_u64;
  }
  return at +wrap 8_u64;
}

fn generate(destination: &[u8], seed: u64) -> result: u64 writes(destination) {
  doc "Fills the window with the high half of successive xorshift64 states; both K=0 and K>0 generate the same keys, and the returned state seeds the printed checksum.";
  let state = seed;
  let cursor = 0_u64;
  loop @keys {
    let spare = destination^.len;
    let done = cursor >= spare;
    if done {
      break @keys;
    }
    let left = ishl.wrap(state, 13_u32);
    set state = ixor(state, left);
    let right = ishr.wrap(state, 7_u32);
    set state = ixor(state, right);
    let wide = ishl.wrap(state, 17_u32);
    set state = ixor(state, wide);
    let high = ishr.wrap(state, 32_u32);
    let masked = iand(high, 255_u64);
    let key = cvt::<u64, u8>(masked);
    set destination^[cursor] = key;
    set cursor = cursor +wrap 1_u64;
  }
  return state;
}

fn histogram(keys: &[u8]) -> made: Box<Array<u64>> reads(keys) {
  doc "The histogram of the design document: colliding keys contribute to one of 256 counters.";
  let counts = box_array_filled::<u64>(count: 256_u64, value: 0_u64);
  let count = keys^.len;
  for (i in 0_u64..count) {
    let bucket = cvt::<u8, u64>(keys^[i]);
    set counts.inner[bucket] = counts.inner[bucket] +wrap 1_u64;
  }
  return move counts;
}

fn digest(cells: &[u64]) -> result: u64 reads(cells) {
  doc "An order-sensitive hash of every counter, so a wrong cell changes the printed checksum.";
  let running = 14695981039346656037_u64;
  let count = cells^.len;
  for (i in 0_u64..count) {
    let mixed = ixor(running, cells^[i]);
    set running = mixed *wrap 1099511628211_u64;
  }
  return running;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Generates ten million keys, folds the digest of each of K histograms into one checksum, and writes that checksum as one little-endian word; K=0 supplies the process baseline.";
  let Inputs(args: arguments, cwd: unused_cwd_directory, stdout: out, stderr: unused_stderr, handles: entry_factory, stdin: unused_stdin, clock: unused_clock, wall_clock: unused_wall_clock) = move inputs;
  let std::fs::Directory(read: unused_cwd, write: unused_cwd_write) = move unused_cwd_directory;
  std::fs::close_directory_write(factory: &entry_factory, directory: move unused_cwd_write);
  close_directory(factory: &entry_factory, directory: move unused_cwd);
  let repetitions = 0_u64;
  match command_repetitions(arguments: &arguments) {
    Some(value: supplied_repetitions) => {
      set repetitions = supplied_repetitions;
    }
    None() => {
      return exit_status(code: 2_u8);
    }
  }
  let keys = box_array_filled::<u8>(count: 10000000_u64, value: 0_u8);
  let view = &keys.inner[0_u64..keys.inner.len];
  let final_state = generate(destination: view, seed: 88172645463325252_u64);
  let checksum = final_state;
  for (repetition in 0_u64..repetitions) {
    let counts = histogram(keys: view);
    let cell_digest = digest(cells: &counts.inner[0_u64..counts.inner.len]);
    let mixed_checksum = ixor(checksum, cell_digest);
    set checksum = mixed_checksum *wrap 1099511628211_u64;
  }
  let report = box_array_filled::<u8>(count: 8_u64, value: 0_u8);
  let window = &report.inner[0_u64..report.inner.len];
  let after_checksum = spell(destination: window, at: 0_u64, value: checksum);
  let no_deadline = None<std::time::Instant>();
  let report_length = window^.len;
  let wait_cancel_1 = std::time::cancel_never();
  let wait_outcome_1 = write_once(factory: &entry_factory, output: &out, source: window, start: 0_u64, end: report_length, deadline: no_deadline, cancel: &wait_cancel_1);
  std::time::close_cancel_watch(watch: move wait_cancel_1);
  match wait_outcome_1 {
    Ok(value: written_end) => {
      return exit_status(code: 0_u8);
    }
    Err(error: write_problem) => {
      return exit_status(code: 1_u8);
    }
  }
}
