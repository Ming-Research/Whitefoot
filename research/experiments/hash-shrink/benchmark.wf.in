// Explicit experiment input. Generated copies and LLVM are retained as artifacts.
alias HashMap = std::collections::hash_map::HashMap;
alias HashMapKey = std::collections::hash_map::HashMapKey;
alias HashMapSlot = std::collections::hash_map::HashMapSlot;
alias HashMapPair = std::collections::hash_map::HashMapPair;
alias HashMapPut = std::collections::hash_map::HashMapPut;
alias hash_map_new = std::collections::hash_map::hash_map_new;
alias hash_map_put = std::collections::hash_map::hash_map_put;
alias hash_map_lookup = std::collections::hash_map::hash_map_lookup;
alias hash_map_remove = std::collections::hash_map::hash_map_remove;
@EXTRA@

fn make_key(index: u64) -> result: @KEY@ pure {
  @MAKE_KEY@
}
fn key_id(key: &@KEY@) -> result: u64 reads(key) {
  @KEY_ID@
}
fn make_value(index: u64) -> result: @VALUE@ pure {
  @MAKE_VALUE@
}
fn mixed(value: u64) -> result: u64 pure {
  let shift1 = ishr(value, 30_u32);
  let mix1 = ixor(value, shift1);
  let first = mix1 *wrap 13787848793156543929_u64;
  let shift2 = ishr(first, 27_u32);
  let mix2 = ixor(first, shift2);
  let second = mix2 *wrap 10723151780598845931_u64;
  let shift3 = ishr(second, 31_u32);
  return ixor(second, shift3);
}
fn hash(env: &unit, key: &@KEY@) -> result: u64 reads(key) {
  let id = key_id(key: key);
  return mixed(value: id);
}
fn equal(env: &unit, left: &@KEY@, right: &@KEY@) -> result: Bool reads(left), reads(right) {
  let left_id = key_id(key: left);
  let right_id = key_id(key: right);
  return left_id == right_id;
}
binding Keys : HashMapKey<@KEY@, unit> { hash = hash; equal = equal; }
fn inspect(env: &unit, key: &@KEY@, value: &@VALUE@) -> result: u64 reads(key), reads(value) {
  @INSPECT@
}

struct Observation { elapsed: u64; checksum: u64; capacity: u64; first_elapsed: u64; second_elapsed: u64; }

fn probe(home: u64, step: u64, count: u64) -> index: u64 pure contract {
  requires home < count;
  requires step < count;
  ensures index < count;
} {
  let left = count - home;
  if step >= left { return step - left; }
  return home + step;
}

// Copy the chosen owning key before mutation, like Firn's first-filled picker.
fn picked(map: &HashMap<@KEY@, @VALUE@, 4000000>, random: u64) -> result: Option<@KEY@> reads(map) {
  let count = map^.cells.inner.len;
  for (step in 0_u64..count) {
    let home = random % count;
    let index = probe(home: home, step: step, count: count);
    match map^.cells.inner[index] {
      HashMapFilled(key: key, value: value) => {
        let id = key_id(key: key);
        let copy = make_key(index: id);
        return Some<@KEY@>(value: move copy);
      }
      HashMapVacant() => {}
      HashMapDeleted() => {}
    }
  }
  return None<@KEY@>();
}

fn run(count: u64, mode: u64, remaining: u64, requests: u64, clock: &std::time::Clock) -> result: Option<Observation> writes(clock) contract {
  requires count > 0_u64;
  requires count <= 1000000_u64;
  requires remaining > 0_u64;
  requires remaining <= count;
  requires requests <= remaining;
} {
  let env = unit;
  let visit_env = unit;
  // Input owner creation and initial bucket construction are outside timing.
  let pairs = box_slots_new::<HashMapPair<@KEY@, @VALUE@>>(capacity: count);
  let queries = box_slots_new::<@KEY@>(capacity: count);
  for @build_inputs (
    i in 0_u64..count,
    invariant pairs_filled: pairs.inner.len == i,
    invariant queries_filled: queries.inner.len == i
  ) {
    let key = make_key(index: i);
    let value = make_value(index: i);
    let pair = HashMapPair<@KEY@, @VALUE@>(key: move key, value: move value);
    place_back(window: &pairs.inner, value: move pair);
    let query = make_key(index: i);
    place_back(window: &queries.inner, value: move query);
  }
  invariant pairs_complete: pairs.inner.len == count;
  invariant queries_complete: queries.inner.len == count;
  let initial = 0_u64;
  if mode == 1_u64 { set initial = count * 2_u64; }
  let map = hash_map_new::<@KEY@, @VALUE@, 4000000>(capacity: initial);
  let started = std::time::now(clock: clock);
  for @insert (
    i in 0_u64..count,
    invariant pairs_left: pairs.inner.len + i == count
  ) {
    let pair = take_back(window: &pairs.inner);
    let HashMapPair(key: key, value: value) = move pair;
    let put = hash_map_put::<Keys, @VALUE@, 4000000>(map: &map, key: move key, value: move value, env: &env);
    match move put {
      HashMapInserted() => {}
      HashMapReturned(reason: reason, pair: refused) => { return None<Observation>(); }
    }
  }
  let ended = std::time::now(clock: clock);
  let elapsed = std::time::nanoseconds_from(earlier: started, later: ended);
  if map.length != count { return None<Observation>(); }
  // Independent integer IDs and wide-value contents check every inserted pair.
  for (i in 0_u64..count) {
    let found = hash_map_lookup::<Keys, @VALUE@, unit, u64, fn inspect, 4000000>(map: &map, key: &queries.inner[i], key_env: &env, visit_env: &visit_env);
    match found {
      Ok(value: id) => { if id != i { return None<Observation>(); } }
      Err(error: absent) => { return None<Observation>(); }
    }
  }
  let checksum = 0_u64;
  if mode == 2_u64 {
    let lookup_started = std::time::now(clock: clock);
    for (i in 0_u64..count) {
      let found = hash_map_lookup::<Keys, @VALUE@, unit, u64, fn inspect, 4000000>(map: &map, key: &queries.inner[i], key_env: &env, visit_env: &visit_env);
      match found {
        Ok(value: id) => { set checksum = checksum +wrap id; }
        Err(error: absent) => { return None<Observation>(); }
      }
    }
    let lookup_ended = std::time::now(clock: clock);
    set elapsed = std::time::nanoseconds_from(earlier: lookup_started, later: lookup_ended);
    let previous = count - 1_u64;
    let product = count * previous;
    let expected = product / 2_u64;
    if checksum != expected { return None<Observation>(); }
  }
  if mode >= 3_u64 {
    let population = count;
    let pops = count;
    if mode == 3_u64 {
      // Million-to-thousand preparation is deliberately outside the timer.
      let removed = count - remaining;
      for (i in 0_u64..removed) {
        let pair = hash_map_remove::<Keys, @VALUE@, 4000000>(map: &map, key: &queries.inner[i], env: &env);
        match move pair { Some(value: gone) => {} None() => { return None<Observation>(); } }
      }
      set population = remaining;
      set pops = requests;
    }
    let ledger = box_array_filled::<u8>(count: count, value: 0_u8);
    let random = 88172645463325252_u64;
    let pop_started = std::time::now(clock: clock);
    for (i in 0_u64..pops) {
      let product = random *wrap 2862933555777941757_u64;
      set random = product +wrap 3037000493_u64;
      let choice = picked(map: &map, random: random);
      match move choice {
        Some(value: key) => {
          let pair = hash_map_remove::<Keys, @VALUE@, 4000000>(map: &map, key: &key, env: &env);
          match move pair {
            Some(value: removed) => {
              let HashMapPair(key: owned_key, value: owned_value) = move removed;
              let id = key_id(key: &owned_key);
              if id < ledger.inner.len {
                if ledger.inner[id] != 0_u8 { return None<Observation>(); }
                set ledger.inner[id] = 1_u8;
              } else { return None<Observation>(); }
              set checksum = checksum +wrap id;
            }
            None() => { return None<Observation>(); }
          }
        }
        None() => { return None<Observation>(); }
      }
    }
    let pop_ended = std::time::now(clock: clock);
    set elapsed = std::time::nanoseconds_from(earlier: pop_started, later: pop_ended);
    let expected_length = population - pops;
    if map.length != expected_length { return None<Observation>(); }
    // Check every expected survivor/removal outside timing, independently of buckets.
    let prepared = count - remaining;
    for (i in 0_u64..count) {
      let should_exist = ledger.inner[i] == 0_u8;
      if mode == 3_u64 { if i < prepared { set should_exist = False(); } }
      let found = hash_map_lookup::<Keys, @VALUE@, unit, u64, fn inspect, 4000000>(map: &map, key: &queries.inner[i], key_env: &env, visit_env: &visit_env);
      match found {
        Ok(value: id) => { if bnot(should_exist) { return None<Observation>(); } if id != i { return None<Observation>(); } }
        Err(error: absent) => { if should_exist { return None<Observation>(); } }
      }
    }
  }
  let capacity = map.cells.inner.len;
  // Owners and backing are destroyed after the recorded interval.
  let row = Observation(elapsed: elapsed, checksum: checksum, capacity: capacity, first_elapsed: elapsed, second_elapsed: 0_u64);
  return Some<Observation>(value: row);
}

fn disjoint(count: u64, mode: u64, remaining: u64, requests: u64, clock: &std::time::Clock) -> result: Option<Observation> reads(clock) contract {
  requires count > 0_u64;
  requires count <= 1000000_u64;
  requires remaining > 0_u64;
  requires remaining <= count;
  requires requests <= remaining;
} {
  let absent = None<Observation>();
  let rows = array_filled::<Option<Observation>, 2>(value: absent);
  // --par may offer the two independent owning traces; the parent clock is
  // only read to create a separate clock view inside each iteration.
  for (i in 0_u64..2_u64) {
    let own_clock = std::time::clock_share(clock: clock);
    let row = run(count: count, mode: mode, remaining: remaining, requests: requests, clock: &own_clock);
    set rows[i] = row;
  }
  let elapsed = 0_u64;
  let checksum = 0_u64;
  let capacity = 0_u64;
  let first = 0_u64;
  let second = 0_u64;
  for (i in 0_u64..2_u64) {
    match rows[i] {
      None() => { return None<Observation>(); }
      Some(value: row) => {
        if row.elapsed > elapsed { set elapsed = row.elapsed; }
        if row.capacity > capacity { set capacity = row.capacity; }
        set checksum = checksum +wrap row.checksum;
        if i == 0_u64 { set first = row.elapsed; }
        else { set second = row.elapsed; }
      }
    }
  }
  let combined = Observation(elapsed: elapsed, checksum: checksum, capacity: capacity, first_elapsed: first, second_elapsed: second);
  return Some<Observation>(value: combined);
}

fn argument(args: &std::text::Args, position: u64) -> value: u64 reads(args) {
  let got = std::text::arg_get(args: args, position: position);
  match move got {
    Ok(value: text) => {
      let bytes = array_filled::<u8, 24>(value: 0_u8);
      let copied = std::text::host_copy_bytes(value: &text, destination: &bytes[0_u64..24_u64], start: 0_u64, end: 24_u64);
      match copied {
        Ok(value: length) => {
          let parsed = 0_u64;
          for (i in 0_u64..length) {
            let byte = bytes[i];
            if byte < 48_u8 { return 0_u64; }
            if byte > 57_u8 { return 0_u64; }
            let digit_byte = byte - 48_u8;
            let digit = cvt.wrap::<u8, u64>(digit_byte);
            let prefix = parsed *sat 10_u64;
            set parsed = prefix +sat digit;
          }
          return parsed;
        }
        Err(error: error) => { return 0_u64; }
      }
    }
    Err(error: error) => { return 0_u64; }
  }
}

fn number(out: &Box<Slots<u8>>, value: u64) -> result: unit writes(out) contract {
  requires out^.inner.len <= 18446744073709551594_u64;
  requires out^.inner.len + 21_u64 <= out^.inner.cap;
  ensures out^.inner.len == entry(out)^.inner.len + 21_u64;
} {
  let digits = array_filled::<u8, 20>(value: 0_u8);
  let rest = value;
  for (i in 0_u64..20_u64) {
    let low = rest % 10_u64;
    let byte = cvt.wrap::<u64, u8>(low);
    set digits[i] = byte + 48_u8;
    set rest = rest / 10_u64;
  }
  let start = out^.inner.len;
  for @emit_number (
    i in 0_u64..20_u64,
    invariant emitted: out^.inner.len == start + i
  ) {
    let index = 19_u64 - i;
    place_back(window: &out^.inner, value: digits[index]);
  }
  invariant all_digits: out^.inner.len == start + 20_u64;
  place_back(window: &out^.inner, value: 10_u8);
  return unit;
}

fn main(inputs: std::process::Inputs) -> status: std::process::ExitStatus pure waits {
  let std::process::Inputs(args: args, cwd: directory, stdout: output, handles: factory, clock: clock, ..) = move inputs;
  let std::fs::Directory(read: read_directory, write: write_directory) = move directory;
  std::fs::close_directory_write(factory: &factory, directory: move write_directory);
  std::fs::close_directory(factory: &factory, directory: move read_directory);
  let count = argument(args: &args, position: 1_u64);
  let mode = argument(args: &args, position: 2_u64);
  let remaining = argument(args: &args, position: 3_u64);
  let requests = argument(args: &args, position: 4_u64);
  let tables = argument(args: &args, position: 5_u64);
  if count == 0_u64 { return std::process::exit_status(code: 1_u8); }
  if count > 1000000_u64 { return std::process::exit_status(code: 1_u8); }
  if remaining == 0_u64 { return std::process::exit_status(code: 1_u8); }
  if remaining > count { return std::process::exit_status(code: 1_u8); }
  if requests > remaining { return std::process::exit_status(code: 1_u8); }
  if mode > 4_u64 { return std::process::exit_status(code: 1_u8); }
  if tables == 0_u64 { return std::process::exit_status(code: 1_u8); }
  if tables > 2_u64 { return std::process::exit_status(code: 1_u8); }
  let observation = None<Observation>();
  if tables == 2_u64 {
    set observation = disjoint(count: count, mode: mode, remaining: remaining, requests: requests, clock: &clock);
  } else {
    set observation = run(count: count, mode: mode, remaining: remaining, requests: requests, clock: &clock);
  }
  match observation {
    None() => { return std::process::exit_status(code: 2_u8); }
    Some(value: row) => {
      let out = box_slots_new::<u8>(capacity: 128_u64);
      number(out: &out, value: row.elapsed);
      number(out: &out, value: row.checksum);
      number(out: &out, value: row.capacity);
      number(out: &out, value: row.first_elapsed);
      number(out: &out, value: row.second_elapsed);
      let length = out.inner.len;
      let sent = 0_u64;
      let never = std::time::cancel_never();
      let deadline = None<std::time::Instant>();
      loop {
        if sent >= length { break; }
        let written = std::io::write_once(factory: &factory, output: &output, source: &out.inner[0_u64..length], start: sent, end: length, deadline: deadline, cancel: &never);
        match written {
          Ok(value: next) => { if next <= sent { return std::process::exit_status(code: 3_u8); } set sent = next; }
          Err(error: error) => { return std::process::exit_status(code: 3_u8); }
        }
      }
    }
  }
  return std::process::exit_status(code: 0_u8);
}
