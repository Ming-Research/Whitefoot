alias SlabHandle = std::collections::slab::SlabHandle;
alias slab_new = std::collections::slab::slab_new;
alias slab_insert = std::collections::slab::slab_insert;
alias slab_visit = std::collections::slab::slab_visit;
alias slab_remove = std::collections::slab::slab_remove;
alias slab_free = std::collections::slab::slab_free;
alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct SlabDigest {
  value: u64;
}

nocopy struct SlabRecord {
  words: Array<u64, 32>;
}

interface SlabElement<T: drop> {
  fn make(seed: u64) -> value: T pure;
  fn visit(env: &SlabDigest, value: &T) -> result: unit reads(value), writes(env);
  fn consume(env: &SlabDigest, value: T) -> result: unit writes(env);
}

fn slab_word_make(seed: u64) -> value: u64 pure {
  return seed;
}

fn slab_word_consume(env: &SlabDigest, value: u64) -> result: unit writes(env) {
  let prefix = env^.value *wrap 131_u64;
  set env^.value = prefix +wrap value;
  return unit;
}

fn slab_word_visit(env: &SlabDigest, value: &u64) -> result: unit reads(value), writes(env) {
  slab_word_consume(env: env, value: value^);
  return unit;
}

fn slab_record_make(seed: u64) -> value: SlabRecord pure {
  let words = array_filled::<u64, 32>(value: 0_u64);
  for (index in 0_u64..32_u64) {
    set words[index] = seed +wrap index;
  }
  return SlabRecord(words: words);
}

fn slab_record_visit(env: &SlabDigest, value: &SlabRecord) -> result: unit reads(value), writes(env) {
  for (index in 0_u64..32_u64) {
    let prefix = env^.value *wrap 131_u64;
    set env^.value = prefix +wrap value^.words[index];
  }
  return unit;
}

fn slab_record_consume(env: &SlabDigest, value: SlabRecord) -> result: unit writes(env) {
  for (index in 0_u64..32_u64) {
    let prefix = env^.value *wrap 131_u64;
    set env^.value = prefix +wrap value.words[index];
  }
  return unit;
}

binding SlabWordElement : SlabElement<u64> {
  make = slab_word_make;
  visit = slab_word_visit;
  consume = slab_word_consume;
}

binding SlabRecordElement : SlabElement<SlabRecord> {
  make = slab_record_make;
  visit = slab_record_visit;
  consume = slab_record_consume;
}

fn slab_library_trace<interface SlabElement<T>>(count: u64, rounds: u64, seed: u64, path: u64) -> result: u64 pure contract {
  requires count <= 8192_u64;
} {
  let slab = slab_new::<T, 8192, 18446744073709551615>(capacity: count);
  let digest = SlabDigest(value: seed);
  for (index in 0_u64..count) {
    let next = seed +wrap index;
    let value = SlabElement::make(seed: next);
    let inserted = slab_insert::<T, 8192, 18446744073709551615>(slab: &slab, value: move value);
    match move inserted {
      Ok(value: handle) => {
        slab_word_consume(env: &digest, value: handle.index);
        slab_word_consume(env: &digest, value: handle.generation);
      }
      Err(error: recovered) => {
        SlabElement::consume(env: &digest, value: move recovered);
        slab_word_consume(env: &digest, value: 18446744073709551615_u64);
      }
    }
  }
  let marker_seed = ixor(seed, 11400714819323198485_u64);
  let marker = SlabElement::make(seed: marker_seed);
  let refused = slab_insert::<T, 8192, 18446744073709551615>(slab: &slab, value: move marker);
  match move refused {
    Ok(value: handle) => {
      slab_word_consume(env: &digest, value: 18446744073709551615_u64);
    }
    Err(error: value) => {
      SlabElement::consume(env: &digest, value: move value);
    }
  }
  for (round in 0_u64..rounds) {
    let generation = 0_u64;
    if path != 0_u64 {
      set generation = round;
    }
    for (index in 0_u64..count) {
      let handle = SlabHandle(index: index, generation: generation);
      if path == 0_u64 {
        let visited = slab_visit::<T, SlabDigest, unit, fn SlabElement::visit, 8192, 18446744073709551615>(slab: &slab, handle: handle, env: &digest);
        match visited {
          Ok(value: done) => {
          }
          Err(error: missing) => {
            slab_word_consume(env: &digest, value: 18446744073709551615_u64);
          }
        }
      } else {
        let removed = slab_remove::<T, 8192, 18446744073709551615>(slab: &slab, handle: handle);
        match move removed {
          Some(value: taken) => {
            SlabElement::consume(env: &digest, value: move taken);
          }
          None() => {
            slab_word_consume(env: &digest, value: 18446744073709551615_u64);
          }
        }
        let expired = slab_visit::<T, SlabDigest, unit, fn SlabElement::visit, 8192, 18446744073709551615>(slab: &slab, handle: handle, env: &digest);
        match expired {
          Ok(value: done) => {
            slab_word_consume(env: &digest, value: 18446744073709551615_u64);
          }
          Err(error: missing) => {
            slab_word_consume(env: &digest, value: 0_u64);
          }
        }
        let next_round = round +wrap 1_u64;
        let shift = next_round *wrap count;
        let base = seed +wrap shift;
        let next_seed = base +wrap index;
        let next = SlabElement::make(seed: next_seed);
        let inserted = slab_insert::<T, 8192, 18446744073709551615>(slab: &slab, value: move next);
        match move inserted {
          Ok(value: replacement) => {
            slab_word_consume(env: &digest, value: replacement.index);
            slab_word_consume(env: &digest, value: replacement.generation);
          }
          Err(error: value) => {
            SlabElement::consume(env: &digest, value: move value);
            slab_word_consume(env: &digest, value: 18446744073709551615_u64);
          }
        }
      }
    }
  }
  slab_free::<T, SlabDigest, fn SlabElement::consume, 8192, 18446744073709551615>(slab: move slab, env: &digest);
  return digest.value;
}

fn slab_library_word_trace(count: u64, rounds: u64, seed: u64, path: u64) -> result: u64 pure contract {
  requires count <= 8192_u64;
} {
  return slab_library_trace::<SlabWordElement>(count: count, rounds: rounds, seed: seed, path: path);
}

fn slab_library_record_trace(count: u64, rounds: u64, seed: u64, path: u64) -> result: u64 pure contract {
  requires count <= 8192_u64;
} {
  return slab_library_trace::<SlabRecordElement>(count: count, rounds: rounds, seed: seed, path: path);
}

fn main() -> status: ExitStatus pure {
  let words = slab_library_word_trace(count: 3_u64, rounds: 2_u64, seed: 17_u64, path: 1_u64);
  let records = slab_library_record_trace(count: 3_u64, rounds: 2_u64, seed: 17_u64, path: 0_u64);
  return exit_status(code: 0_u8);
}
