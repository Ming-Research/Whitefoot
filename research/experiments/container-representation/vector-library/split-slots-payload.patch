+extern int wf__floor_run(int, char **);
+struct descriptor { uint64_t len, cap; unsigned char *payload; };
+_Static_assert(sizeof(struct descriptor) == 24, "descriptor extent");
+struct allocation { unsigned char *pointer; size_t bytes; unsigned live; };
+static struct allocation allocations[8];
+static size_t allocated, calls, releases;
+static unsigned selected, failing;
+static void **failure_cell;
+static void require(int okay, const char *message) {
+    if (!okay) { fprintf(stderr, "split Slots observer: %s\n", message); exit(1); }
+}
+static struct allocation *find(void *pointer) {
+    for (size_t i=0; i<allocated; ++i)
+        if (allocations[i].pointer == pointer) return &allocations[i];
+    require(0, "foreign pointer"); return NULL;
+}
+void *wf_observe_allocate(uint64_t bytes) {
+    static const size_t expected[7][5] = {
+        {24,16,8,8,32}, {24,4,8}, {24,1,3}, {24,1,1},
+        {24,1}, {24,1}, {24,1,2}
+    };
+    require(calls<5 && bytes==expected[selected][calls], "exact requested extent");
+    ++calls;
+    if (failing && calls==3) return NULL;
+    struct allocation *a=&allocations[allocated++];
+    a->pointer=malloc(64); a->bytes=(size_t)bytes; a->live=1;
+    require(a->pointer!=NULL, "observer allocation");
+    memset(a->pointer, allocated>2 ? 0xa6 : 0xa5, 64);
+    return a->pointer;
+}
+void wf_observe_release(void *pointer) {
+    struct allocation *a=find(pointer);
+    require(a->live, "exactly once release");
+    struct descriptor *d=(void *)allocations[0].pointer;
+    require(allocations[0].live, "payload/nested owner released after descriptor");
+    if (a==&allocations[1] && selected<4) {
+        static const uint64_t lengths[]={2,2,0,1}, caps[]={2,4,0,1};
+        require(d->len==lengths[selected] && d->cap==caps[selected]
+                && d->payload==a->pointer, "grow published before old payload release");
+#ifdef CORRUPT_PRESERVED_ORDER
+        if (selected==0) {
+            unsigned char *fresh=allocations[4].pointer;
+            void *first,*second;
+            memcpy(&first,fresh,8); memcpy(&second,fresh+8,8);
+            memcpy(fresh,&second,8); memcpy(fresh+8,&first,8);
+        }
+#endif
+    }
+    if (selected==0 && a->bytes==8)
+        require(*(uint64_t *)pointer==17 || *(uint64_t *)pointer==29,
+                "nested owner contents");
+    if (a==&allocations[0]) {
+        static const uint64_t lengths[]={2,2,0,1,0,0}, caps[]={4,8,3,4,0,0};
+        require(d->len==lengths[selected] && d->cap==caps[selected], "final descriptor");
+        require(!find(d->payload)->live, "payload released before descriptor");
+        if (selected==0)
+            require(!allocations[2].live && !allocations[3].live,
+                    "nested owners released before descriptor");
+    }
+    if (selected==1 && a==&allocations[2]) {
+        require(a->pointer[0]==31 && a->pointer[1]==47, "initialized prefix");
+        for (size_t i=2; i<8; ++i)
+            require(a->pointer[i]==0xa6, "spare bytes not copied");
+    }
+    a->live=0; ++releases;
+    /* Quarantine retired payloads so stale accesses remain observable. */
+    if (a!=&allocations[0]) memset(a->pointer,0xdd,a->bytes);
+}
+void wf_observe_abort(void) {
+    require(failing && calls==3 && releases==0, "floor route");
+    require(failure_cell && *failure_cell==allocations[0].pointer,
+            "stable owner on failed allocation");
+    struct descriptor *d=*failure_cell;
+    require(d->len==1 && d->cap==1 && d->payload==allocations[1].pointer
+            && d->payload[0]==17 && allocations[0].live && allocations[1].live,
+            "failed grow preserves descriptor and payload");
+    puts("split Slots: failed grow preserves owner, descriptor and payload"); exit(73);
+}
+static void reset(void) {
+    memset(allocations,0,sizeof allocations); allocated=calls=releases=0;
+}
+int wf__main_body(int argc, char **argv) {
+    if (argc==2 && !strcmp(argv[1],"failure")) {
+        selected=6; failing=1; reset();
+        struct descriptor *owner=wf_observe_allocate(24);
+        owner->len=1; owner->cap=1; owner->payload=wf_observe_allocate(1);
+        owner->payload[0]=17; failure_cell=(void **)&owner;
+        (void)wf_grow_failure((void **)&owner);
