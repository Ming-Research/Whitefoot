+        wf_grow_zero_capacity,wf_grow_zero_stride,wf_empty_range,wf_empty_cell};
+    const size_t counts[]={5,3,3,3,2,2};
+    for (selected=0; selected<6; ++selected) {
+        reset(); require(cases[selected]()==0,"source content/header assertion");
+        require(calls==counts[selected] && releases==counts[selected],"complete ledger");
+        for (size_t i=0; i<allocated; ++i) {
