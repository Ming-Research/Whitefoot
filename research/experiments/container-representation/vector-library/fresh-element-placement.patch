+/* Independent observer for the edited concrete append-one timed paths. */
+#include <stdint.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+struct descriptor { uint64_t len, cap; unsigned char *payload; };
+struct guarded_owner { uint64_t before[2]; struct descriptor value; uint64_t after[2]; };
+_Static_assert(sizeof(struct descriptor)==24,"ordinary inline owner extent");
+extern uint64_t wf_vector_api_word_append_one(struct descriptor *, uint64_t);
+extern uint64_t wf_vector_api_record_append_one(struct descriptor *, uint64_t);
+extern int wf__floor_run(int, char **);
+struct allocation { unsigned char *pointer; size_t bytes, backing; bool live; };
+static struct allocation allocations[2];
+static size_t requests, successes, copies, releases, requested_bytes, live_bytes, peak_bytes;
+static size_t stride, old_cap, new_cap, old_bytes, new_bytes;
+static bool refusing;
+static struct guarded_owner owner, original_owner;
+static unsigned char *original_payload;
+static const uint64_t old_seed=17, appended_seed=29;
+static void require(bool okay, const char *message) {
+    if (!okay) { fprintf(stderr,"fresh placement observer: %s\n",message); exit(1); }
+}
+static uint64_t read_word(const unsigned char *p) { uint64_t n; memcpy(&n,p,8); return n; }
+static void check_old(void) {
+    require(allocations[0].live,"old allocation remains live");
+    require(memcmp(allocations[0].pointer,original_payload,old_bytes+stride)==0,
+            "all old prefix and guarded spare bytes unchanged");
+}
+static void check_owner(void) {
+    require(memcmp(&owner,&original_owner,sizeof owner)==0,
+            "all descriptor words and surrounding canaries unchanged");
+}
+static void check_appended(const unsigned char *p) {
+    for(size_t word=0;word<stride/8;++word)
+        require(read_word(p+word*8)==appended_seed+word,"all fresh appended fields precede prefix copy");
+}
+static void check_result(const unsigned char *p) {
+    for(size_t element=0;element<old_cap;++element)
+        for(size_t word=0;word<stride/8;++word)
+            require(read_word(p+element*stride+word*8)==old_seed+element+word,
+                    "complete preserved prefix value and order");
+    check_appended(p+old_bytes);
+    for(size_t byte=old_bytes+stride;byte<new_bytes;++byte)
+        require(p[byte]==0xa6,"remaining fresh spare bytes untouched");
+}
+void *wf_placement_allocate(uint64_t bytes) {
+    require(requests==0 && bytes==new_bytes,"one exact append allocation request");
+    ++requests; requested_bytes+=(size_t)bytes;
+    check_old();
+    if(refusing) { check_owner(); return NULL; }
+    struct allocation *fresh=&allocations[1];
+    fresh->pointer=malloc((size_t)bytes); require(fresh->pointer!=NULL,"observer backing allocation");
+    fresh->bytes=fresh->backing=(size_t)bytes; fresh->live=true;
+    memset(fresh->pointer,0xa6,fresh->backing); ++successes;
+    live_bytes+=fresh->bytes; if(live_bytes>peak_bytes) peak_bytes=live_bytes;
+    return fresh->pointer;
+}
+void wf_placement_copy(void *destination,const void *source,uint64_t bytes,bool is_volatile) {
+    require(!refusing,"no prefix copy after allocation refusal");
+    require(requests==1 && successes==1 && copies==0 && releases==0 && !is_volatile,
+            "exact successful allocation before prefix copy");
+    require(destination==allocations[1].pointer && source==allocations[0].pointer
