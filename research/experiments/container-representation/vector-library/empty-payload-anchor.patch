+        "  %{cap_field} = getelementptr inbounds {llvm}, ptr {address}, i64 0, i32 1\n  %{capacity} = load i64, ptr %{cap_field}\n  %{positive_cap} = icmp ne i64 %{capacity}, 0\n  %{positive_stride} = icmp ne i64 ptrtoint (ptr getelementptr ({element_llvm}, ptr null, i64 1) to i64), 0\n  %{allocated} = and i1 %{positive_cap}, %{positive_stride}\n  br i1 %{allocated}, label %{release}, label %{done}"
+    ).map_err(|_| BackendFailure::TextEmission)?;
+    output.open_block(release);
+    let field = next_temporary(temporary)?;
+    let payload = next_temporary(temporary)?;
