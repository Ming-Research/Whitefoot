+/* Independent observer for the inline-owner append research overlay. */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+struct descriptor { uint64_t len, cap; unsigned char *payload; };
+_Static_assert(sizeof(struct descriptor)==24,"descriptor extent");
+extern uint64_t wf_grow_owned(void), wf_grow_partial(void);
+extern uint64_t wf_grow_zero_capacity(void), wf_grow_zero_stride(void);
+extern uint64_t wf_empty_range(void), wf_empty_cell(void);
+extern uint64_t wf_grow_failure(struct descriptor *);
