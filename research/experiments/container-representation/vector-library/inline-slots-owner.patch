+fn owner_identity(value: Box<Slots<Box<u64>>>) -> result: Box<Slots<Box<u64>>> pure {
+  return move value;
+}
+
+fn grow_owned() -> result: u64 pure {
+  let values = box_slots_new::<Box<u64>>(capacity: 2_u64);
+  let first = box_new::<u64>(value: 17_u64);
+  place_back(window: &values.inner, value: move first);
+  let second = box_new::<u64>(value: 29_u64);
+  place_back(window: &values.inner, value: move second);
+  grow(cell: &values, capacity: 4_u64);
+  let carried = owner_identity(value: move values);
+  if carried.inner.len != 2_u64 {
+    return 1_u64;
+  }
+  if carried.inner.cap != 4_u64 {
+    return 2_u64;
+  }
+  let first_value = carried.inner[0_u64].inner;
+  let second_value = carried.inner[1_u64].inner;
+  if first_value != 17_u64 {
+    return 3_u64;
+  }
+  if second_value != 29_u64 {
+    return 4_u64;
+  }
+  return 0_u64;
+}
+
+fn grow_partial() -> result: u64 pure {
+  let values = box_slots_new::<u8>(capacity: 4_u64);
+  place_back(window: &values.inner, value: 31_u8);
+  place_back(window: &values.inner, value: 47_u8);
+  grow(cell: &values, capacity: 8_u64);
+  if values.inner.len != 2_u64 {
+    return 1_u64;
+  }
+  if values.inner.cap != 8_u64 {
+    return 2_u64;
+  }
+  if values.inner[0_u64] != 31_u8 {
+    return 3_u64;
+  }
+  if values.inner[1_u64] != 47_u8 {
+    return 4_u64;
+  }
+  return 0_u64;
+}
+
+fn grow_zero_capacity() -> result: u64 pure {
+  let values = box_slots_new::<u8>(capacity: 0_u64);
+  grow(cell: &values, capacity: 3_u64);
+  if values.inner.len != 0_u64 {
+    return 1_u64;
+  }
+  if values.inner.cap != 3_u64 {
+    return 2_u64;
+  }
+  return 0_u64;
+}
+
+fn grow_zero_stride() -> result: u64 pure {
+  let values = box_slots_new::<Array<u64, 0>>(capacity: 1_u64);
+  let empty = array_filled::<u64, 0>(value: 0_u64);
+  place_back(window: &values.inner, value: empty);
+  grow(cell: &values, capacity: 4_u64);
+  if values.inner.len != 1_u64 {
+    return 1_u64;
+  }
+  if values.inner.cap != 4_u64 {
+    return 2_u64;
+  }
+  let value = values.inner[0_u64];
+  return 0_u64;
+}
+
+fn grow_failure(values: &Box<Slots<u8>>) -> result: u64 writes(values) contract {
+  requires values^.inner.len == 1_u64;
+  requires values^.inner.cap == 1_u64;
+} {
+  grow(cell: values, capacity: 2_u64);
+  return 0_u64;
+}
+
+fn empty_length(values: &[u8]) -> result: u64 reads(values.len) {
+  return values^.len;
+}
+
+fn empty_range() -> result: u64 pure {
+  let values = box_slots_new::<u8>(capacity: 0_u64);
+  let empty = &values.inner[0_u64..0_u64];
+  let count = empty_length(values: empty);
+  return count;
+}
+
+fn empty_cell() -> result: u64 pure {
+  let values = box_slots_new::<u8>(capacity: 0_u64);
+  free_empty(window: move values);
+  return 0_u64;
+}
+
+fn main() -> status: std::process::ExitStatus pure {
+  return std::process::exit_status(code: 0_u8);
+}
+
+fn swap_owners(first: &Box<Slots<u8>>, second: &Box<Slots<u8>>) -> result: unit writes(first), writes(second) {
+  swap(first: &first^.inner, second: &second^.inner);
+  return unit;
+}
+
+fn release_owner(value: Box<Slots<u8>>) -> result: unit pure {
+  return unit;
+}
