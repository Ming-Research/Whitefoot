+    struct descriptor second={2,4,wf_observe_allocate(4)};
+    first.payload[0]=11; second.payload[0]=23; second.payload[1]=37;
+    unsigned char *old_first=first.payload, *old_second=second.payload;
+    (void)wf_swap_owners(&first,&second);
+    require(first.len==2 && first.cap==4 && first.payload==old_second
+            && first.payload[0]==23 && first.payload[1]==37
+            && second.len==1 && second.cap==2 && second.payload==old_first
+            && second.payload[0]==11,"whole runtime content exchange");
+    (void)wf_release_owner(&first); (void)wf_release_owner(&second);
+    require(calls==2 && remakes==0 && releases==2,"exchanged owners exact cleanup");
+    for(size_t i=0;i<allocated;++i) { require(!allocations[i].live,"exchanged allocation leak"); free(allocations[i].pointer); }
+    puts("inline Slots: 12 in-place/moving nested/partial/cap0/ZST/empty cases; exact releases");
+    return 0;
+}
