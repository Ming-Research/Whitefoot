+extern uint8_t wf_release_owner(struct descriptor *);
+extern int wf__floor_run(int, char **);
+struct allocation { unsigned char *pointer; size_t bytes; unsigned live; };
+static struct allocation allocations[8];
+static size_t allocated, calls, remakes, releases, transfers;
+static unsigned selected, moving, failing;
+static struct descriptor *failure_cell;
+static void require(int okay, const char *message) {
+    if (!okay) { fprintf(stderr,"inline Slots observer: %s\n",message); exit(1); }
+}
+static struct allocation *find(void *pointer) {
+    for (size_t i=0; i<allocated; ++i)
+        if (allocations[i].pointer==pointer) return &allocations[i];
+    require(0,"foreign pointer (including stack descriptor)"); return NULL;
+}
+static struct allocation *make(size_t bytes) {
+    require(allocated<8 && bytes<=64,"unexpected physical allocation");
+    struct allocation *a=&allocations[allocated++];
+    a->pointer=malloc(64); a->bytes=bytes; a->live=1;
+    require(a->pointer!=NULL,"observer allocation");
+    memset(a->pointer,0xa6,64);
+    return a;
+}
+void *wf_observe_allocate(uint64_t bytes) {
+    static const size_t expected[8][3]={
+        {16,8,8}, {4,8}, {1}, {1}, {1}, {1}, {1}, {2,4}
+    };
+    require(calls<3 && bytes==expected[selected][calls],"exact malloc extent");
+    ++calls; return make((size_t)bytes)->pointer;
+}
+void *wf_observe_reallocate(void *pointer, uint64_t bytes) {
+    static const size_t sizes[]={32,0,3,1,0,0,2};
+    struct allocation *old=find(pointer);
+    require(selected!=1 && selected<7 && remakes++==0 && old==&allocations[0]
+            && old->live && bytes==sizes[selected],"full realloc identity and extent");
+    if (failing) return NULL;
+    struct allocation *fresh=old;
+    if (moving) {
+        fresh=make((size_t)bytes);
+        memcpy(fresh->pointer,old->pointer,old->bytes);
+        old->live=0;
+        memset(old->pointer,0xdd,old->bytes);
+    } else {
+        if (bytes>old->bytes)
+            memset(old->pointer+old->bytes,0xa6,(size_t)bytes-old->bytes);
+        old->bytes=(size_t)bytes;
+    }
+#ifdef CORRUPT_PRESERVED_ORDER
+    if (selected==0) {
+        void *first,*second;
+        memcpy(&first,fresh->pointer,8); memcpy(&second,fresh->pointer+8,8);
+        memcpy(fresh->pointer,&second,8); memcpy(fresh->pointer+8,&first,8);
+    }
+#endif
+    return fresh->pointer;
+}
+void wf_observe_release(void *pointer) {
+    struct allocation *a=find(pointer);
+    require(a->live,"release of retired or released allocation");
+    if (selected==0) {
+        if(a->bytes==8)
+            require(*(uint64_t *)pointer==17 || *(uint64_t *)pointer==29,"nested owner contents");
+        else
+            require(!allocations[1].live && !allocations[2].live,"nested owners precede payload release");
+    }
+    if (selected==1 && a==&allocations[1]) {
+        require(a->pointer[0]==31 && a->pointer[1]==47,"initialized prefix");
+        for (size_t i=2; i<8; ++i)
+            require(a->pointer[i]==0xa6,"spare bytes not copied");
+    }
+    a->live=0; ++releases;
+    memset(a->pointer,0xdd,a->bytes);
+}
+/* The linked implementation takes ownership through the ordinary content pointer.
+ * LLVM bridge returns the copied three words with the exact WF callable ABI. */
+void wf_observe_transfer(struct descriptor *out, const struct descriptor *in) {
+    require(selected==0 && transfers++==0 && in->len==2 && in->cap==4,"linked input descriptor");
+    require(find(in->payload)->live,"linked live payload");
+    const void *first, *second;
+    memcpy(&first,in->payload,8); memcpy(&second,in->payload+8,8);
+#ifndef CORRUPT_PRESERVED_ORDER
+    require(*(const uint64_t *)first==17 && *(const uint64_t *)second==29,"linked complete payload");
+#endif
+    *out=*in;
+}
+void wf_observe_abort(void) {
+    require(failing && calls==1 && remakes==1 && releases==0,"floor route");
+    require(failure_cell && failure_cell->len==1 && failure_cell->cap==1
+            && failure_cell->payload==allocations[0].pointer
+            && failure_cell->payload[0]==17 && allocations[0].live,
+            "failed realloc preserves caller descriptor and payload");
