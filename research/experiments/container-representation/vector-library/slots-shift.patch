+  requires deref(values).len < 9223372036854775809_u64;
+} {
+  let empty = Empty();
+  insert_at(window: values, index: index, value: empty);
+  return unit;
+}
+
+fn remove(values: &Slots<Empty, 9223372036854775809>, index: u64) -> result: Empty writes(values) contract {
+  requires index < deref(values).len;
+} {
