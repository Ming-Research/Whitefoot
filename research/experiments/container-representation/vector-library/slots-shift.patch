+    /// A Slots shift moves complete, stride-spaced elements within the one
+    /// qualified allocation. The source and destination overlap, so this
+    /// must remain memmove, including for non-copy owning elements. The
+    /// removed element was captured before this step; insertion places its
+    /// new element afterwards. No source observation or release intervenes.
+    fn emit_slots_shift(
+        &mut self,
+        result: IrValueId,
+        run_type: IrType,
+        run: IrValueId,
+        index: IrValueId,
+        open: bool,
+        shape: RunShape,
+    ) -> Result<(), BackendFailure> {
+        let pre = run_shift_pre_label(result);
+        let done = run_shift_done_label(result);
+        writeln!(self.output, "  br label %{pre}\n{pre}:")
+            .map_err(|_| BackendFailure::TextEmission)?;
+        let length = self.run_word(run_type, run, shape.length_field())?;
+        let index = self.value_name(index);
+        let next = self.next_temporary()?;
+        let count = self.next_temporary()?;
+        writeln!(self.output, "  %{next} = add i64 {index}, 1")
+            .map_err(|_| BackendFailure::TextEmission)?;
+        let next_index = format!("%{next}");
+        let (source_index, destination_index) = if open {
+            (index.as_str(), next_index.as_str())
+        } else {
+            (next_index.as_str(), index.as_str())
+        };
+        // Insertion moves [index, length); removal has already captured
+        // index and moves [index + 1, length). OP-10 bounds both endpoints
+        // by cap, including the one-past pointer when the count is zero.
+        // The complete qualified allocation bounds count * target stride;
+        // that stride includes padding between adjacent element owners.
+        writeln!(self.output, "  %{count} = sub i64 {length}, {source_index}")
+            .map_err(|_| BackendFailure::TextEmission)?;
+        let source = self.element_pointer(result, shape, run_type, run, source_index)?;
+        let destination = self.element_pointer(result, shape, run_type, run, destination_index)?;
+        let element = shape.element_type(self.program)?;
+        let logical_count = format!("%{count}");
+        // A zero-byte element can have a logical count outside the signed
+        // target address domain. Normalize only this address/size operand;
+        // the source index and the length update retain their logical values.
+        let address_count = self.element_address_index(element, &logical_count)?;
+        let element_llvm = llvm_type(self.program, element)?;
+        self.intrinsics.insert(IntrinsicDeclaration::MemoryMove);
+        self.copy_element_range(
+            &element_llvm,
+            &format!("%{source}"),
+            &format!("%{destination}"),
+            address_count,
+        )?;
