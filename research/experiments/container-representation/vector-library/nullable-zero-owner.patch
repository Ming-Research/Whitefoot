+#[test]
+fn nullable_shapes_preserve_linked_real_zero_owners_and_nested_lifecycle() {
+    for overlap in [OverlapLowering::Off, OverlapLowering::On] {
+        let llvm = emit_lowered(SOURCE, overlap);
+        assert!(
+            llvm.contains("load <16 x i8>"),
+            "the byte scan must reach wide-probe lowering"
+        );
+        for symbol in ["wf_make_bundle", "wf_linked_bundle"] {
+            let header = definition_header(&llvm, symbol);
+            assert!(
+                header.starts_with(&format!("define void @{symbol}(ptr %wf.result, i64 ")),
+                "native destination must be the first argument: {header}"
+            );
+        }
+        let scalar = definition_header(&llvm, "wf_make_slots");
+        assert!(
+            scalar.starts_with("define ptr @wf_make_slots(i64 "),
+            "{scalar}"
+        );
+        for (retained, llvm) in [(false, llvm.clone()), (true, retain_calls(&llvm))] {
+            let mut linked = llvm;
+            for symbol in ["wf_linked_bundle", "wf_linked_range", "wf_finish"] {
+                linked = link_definition(&linked, symbol);
+            }
+            let observed = linked
+                .replace("@malloc(", "@wf_nullable_allocate(")
+                .replace("@free(", "@wf_nullable_release(");
+            let directory = test_directory();
+            let executable = build_linked_executable(&observed, Some(HOST), &[], &directory);
+            let output = Command::new(&executable)
+                .env("WF_WORKERS", "0")
+                .bounded_output()
+                .expect("run nullable lifecycle");
+            assert_eq!(output.status.code(), Some(0), "{output:?}");
+            assert!(
+                output.stdout.is_empty() && output.stderr.is_empty(),
+                "{output:?}"
+            );
+            eprintln!(
+                "nullable lifecycle {overlap:?} retained={retained} success: {}",
+                output.status
+            );
+            for (fault, reason) in [
+                ("destination", "destination owner\n"),
+                ("skip-release", "owner ledger\n"),
+                ("guard", "allocation guard\n"),
+                ("double-release", "owner identity\n"),
+                ("null-release", "owner identity\n"),
+                ("lost-owner", "refusal owner changed\n"),
+                ("range-route", "linked owner route\n"),
+                ("finish-route", "linked owner route\n"),
