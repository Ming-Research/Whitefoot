+fn definition_header<'a>(module: &'a str, symbol: &str) -> &'a str {
+    module
+        .lines()
+        .find(|line| line.starts_with("define ") && line.contains(&format!(" @{symbol}(")))
+        .expect("ordinary source definition")
+}
+
+fn link_definition(module: &str, symbol: &str) -> String {
+    let ordinary = definition_header(module, symbol);
+    let sequential = format!("wf__par_seq_{}", symbol.strip_prefix("wf_").unwrap());
+    let mut linked = module.to_owned();
+    for target in [symbol, sequential.as_str()] {
+        let Some(header) = linked
+            .lines()
+            .find(|line| line.starts_with("define ") && line.contains(&format!(" @{target}(")))
+        else {
+            assert_eq!(target, sequential, "ordinary native binding must exist");
+            continue;
+        };
+        assert_eq!(
+            header
+                .replace(&format!("@{target}("), &format!("@{symbol}("))
+                .replace(" noinline", ""),
+            ordinary.replace(" noinline", ""),
+            "the C sequential forwarder must have the ordinary ABI"
+        );
+        let start = linked.find(header).unwrap();
+        let end = linked[start..].find("\n}").unwrap() + start + 2;
+        let declaration = header
+            .replacen("define ", "declare ", 1)
+            .strip_suffix(" {")
+            .unwrap()
+            .to_owned();
+        linked = format!("{}{}{}", &linked[..start], declaration, &linked[end..]);
+    }
+    linked
+}
