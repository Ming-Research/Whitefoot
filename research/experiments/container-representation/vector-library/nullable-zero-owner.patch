+//! Independent native ledgers for nullable owners and ordinary linked results.
+//! This candidate-only ABI fixture supplies both virtual and real zero owners.
+//! The retained control requires real zero owners at its native boundaries.
+
+use super::owned_places::retain_calls;
+use super::{
+    BoundedOutput, build_linked_executable, compile_rejection, emit_lowered, test_directory,
+};
+use crate::OverlapLowering;
+use std::process::Command;
+
+const SOURCE: &[u8] = br#"struct Bundle {
+  slots: Box<Slots<u64>>;
+  ring: Box<Ring<u64>>;
+  array: Box<Array<u64>>;
+  marker: u64;
+}
+
+struct Envelope {
+  values: Bundle;
+  tail: Box<u64>;
+}
+
+enum Carrier {
+  Absent();
+  Held(values: Bundle);
+}
+
+nodrop struct Ticket {
+  value: u64;
+}
+
+fn make_bundle(count: u64) -> made: Bundle pure contract {
+  requires count <= 17_u64;
+  ensures made.slots.inner.cap == count;
+  ensures made.slots.inner.len == 0_u64;
+  ensures made.ring.inner.cap == count;
+  ensures made.ring.inner.len == 0_u64;
+  ensures made.ring.inner.head == 0_u64;
+  ensures made.array.inner.len == count;
+} {
+  let slots = box_slots_new::<u64>(capacity: count);
+  let ring = box_ring_new::<u64>(capacity: count);
+  let array = box_array_filled::<u64>(count: count, value: 9_u64);
+  return Bundle(slots: move slots, ring: move ring, array: move array, marker: 0_u64);
+}
+
+fn linked_bundle(real: u64) -> made: Bundle pure contract {
+  ensures made.slots.inner.cap == 0_u64;
+  ensures made.slots.inner.len == 0_u64;
+  ensures made.ring.inner.cap == 0_u64;
+  ensures made.ring.inner.len == 0_u64;
+  ensures made.ring.inner.head == 0_u64;
+  ensures made.array.inner.len == 0_u64;
+} {
+  let result = make_bundle(count: 0_u64);
+  return move result;
+}
+
+fn linked_range(values: &[u64]) -> result: u64 reads(values) {
+  return values^.len;
+}
+
+fn consume_owned(array: Box<Array<Box<u64>>>, slots: Box<Slots<Box<u64>>>, ring: Box<Ring<Box<u64>>>) -> result: unit pure {
+  return unit;
+}
+
+fn consume_bundle(values: Bundle) -> result: unit pure {
+  return unit;
+}
+
+fn make_slots(count: u64) -> made: Box<Slots<u64>> pure contract {
+  requires count <= 17_u64;
+} {
+  return box_slots_new::<u64>(capacity: count);
+}
+
+fn consume_slots(values: Box<Slots<u64>>) -> result: unit pure {
+  return unit;
+}
+
+fn consume_bytes(values: Box<Array<u8>>) -> result: unit pure {
+  return unit;
+}
+
+fn grow_empty(values: &Box<Slots<u64>>, capacity: u64) -> result: unit writes(values) contract {
+  requires values^.inner.cap == 0_u64;
+  requires capacity <= 17_u64;
+} {
+  grow(cell: values, capacity: capacity);
+  return unit;
+}
+
+fn range_last(values: &[u64]) -> result: u64 reads(values) {
+  if values^.len > 0_u64 {
+    let last = values^.len - 1_u64;
+    return values^[last];
+  }
+  return 0_u64;
+}
+
+fn capture_empty(values: &Box<Array<u64>>, output: &Array<u64, 512>) -> result: u64 reads(values), writes(output) {
+  for (index in 0_u64..512_u64) {
+    set output^[index] = values^.inner.len;
+  }
+  return output^[511_u64];
+}
+
+fn zero_trip(values: &Box<Array<u64>>) -> result: u64 reads(values) {
+  let hash = 0_u64;
+  for (index in 0_u64..values^.inner.len) {
+    set hash = hash +wrap values^.inner[index];
+  }
+  return hash;
+}
+
+fn scan(values: &Box<Array<u8>>) -> result: u64 reads(values) {
+  let mark = 88_u8;
+  let seen = 0_u64;
+  let stop = values^.inner.len;
+  let cursor = 0_u64;
+  loop @walk {
+    let done = cursor >= stop;
+    if done {
+      break @walk;
+    }
+    let byte = values^.inner[cursor];
+    let newline = byte == 10_u8;
+    if newline {
+      set seen = seen +wrap 1_u64;
+    }
+    let lead = byte == mark;
+    if lead {
+      set seen = seen +wrap 2_u64;
+    }
+    set cursor = cursor +wrap 1_u64;
+  }
+  return seen;
+}
+
+fn relay(values: Carrier) -> made: Carrier pure waits {
+  return move values;
+}
+
+fn waiting_owners() -> result: u64 pure waits {
+  let real = linked_bundle(real: 1_u64);
+  let empty = linked_bundle(real: 0_u64);
+  let real_carrier = Carrier::Held(values: move real);
+  let started = spawn relay(values: move real_carrier);
+  let empty_carrier = Carrier::Held(values: move empty);
+  spawn relay(values: move empty_carrier);
+  match move started {
+    Absent() => {
+      return 1_u64;
+    }
+    Held(values: kept) => {
+      if kept.slots.inner.cap != 0_u64 {
+        return 2_u64;
+      }
+      if kept.ring.inner.head != 0_u64 {
+        return 3_u64;
+      }
+      if kept.array.inner.len != 0_u64 {
+        return 4_u64;
+      }
+      return 0_u64;
+    }
+  }
+}
+
+fn finish() -> result: u64 pure {
+  return 0_u64;
+}
+
+fn run() -> result: u64 pure {
+  let fresh = make_bundle(count: 0_u64);
+  let real = linked_bundle(real: 1_u64);
+  let empty = linked_bundle(real: 0_u64);
+  let temporary = make_bundle(count: 0_u64);
+  consume_bundle(values: move temporary);
+  grow(cell: &real.slots, capacity: 0_u64);
+  append(destination: &empty.ring.inner, source: &real.ring.inner);
+  split_off(source: &empty.ring.inner, index: 0_u64, destination: &real.ring.inner);
+  let selected_alias = &fresh.slots.inner;
+  swap(first: selected_alias, second: &real.slots.inner);
+  swap(first: selected_alias, second: selected_alias);
+  if selected_alias^.cap != 0_u64 {
+    return 1_u64;
+  }
+  if selected_alias^.len != 0_u64 {
+    return 2_u64;
+  }
+  let slice = &empty.array.inner[0_u64..empty.array.inner.len];
+  let slice_count = linked_range(values: slice);
+  if slice_count != 0_u64 {
+    return 3_u64;
+  }
+  let suffix = &slice^[0_u64..0_u64];
+  let suffix_count = linked_range(values: suffix);
+  if suffix_count != 0_u64 {
+    return 4_u64;
+  }
+  let slots_slice = &empty.slots.inner[0_u64..empty.slots.inner.len];
+  let slots_count = linked_range(values: slots_slice);
+  if slots_count != 0_u64 {
+    return 5_u64;
+  }
+  set fresh.slots = box_slots_new::<u64>(capacity: 0_u64);
+  let first = box_slots_new::<u64>(capacity: 0_u64);
+  let second = box_slots_new::<u64>(capacity: 0_u64);
+  append(destination: &first.inner, source: &second.inner);
+  split_off(source: &first.inner, index: 0_u64, destination: &second.inner);
+  grow(cell: &first, capacity: 0_u64);
+  grow(cell: &first, capacity: 0_u64);
+  grow(cell: &first, capacity: 1_u64);
+  place_back(window: &first.inner, value: 7_u64);
+  let content = &second.inner;
+  swap(first: content, second: &first.inner);
+  if content^.len != 1_u64 {
+    return 6_u64;
+  }
+  if content^.len > 0_u64 {
+    if content^[0_u64] != 7_u64 {
+      return 7_u64;
+    }
+  }
+  let explicit = box_slots_new::<u64>(capacity: 0_u64);
+  free_empty(window: move explicit);
+  let linear = box_slots_new::<Ticket>(capacity: 0_u64);
+  free_empty(window: move linear);
+  let linear_ring = box_ring_new::<Ticket>(capacity: 0_u64);
+  free_empty(window: move linear_ring);
+  let seed = array_filled::<u64, 0>(value: 0_u64);
+  let zero_stride = box_ring_new::<Array<u64, 0>>(capacity: 3_u64);
+  place_front(window: &zero_stride.inner, value: seed);
+  let taken = take_front(window: &zero_stride.inner);
+  if zero_stride.inner.head != 0_u64 {
+    return 8_u64;
+  }
+  let zero_array = box_array_filled::<Array<u64, 0>>(count: 5_u64, value: seed);
+  if zero_array.inner.len != 5_u64 {
+    return 9_u64;
+  }
+  let ranged = box_slots_new::<u64>(capacity: 3_u64);
+  place_back(window: &ranged.inner, value: 11_u64);
+  place_back(window: &ranged.inner, value: 22_u64);
+  let before = &ranged.inner[1_u64..2_u64];
+  let before_last = range_last(values: before);
+  if before_last != 22_u64 {
+    return 11_u64;
+  }
+  grow(cell: &ranged, capacity: 5_u64);
+  let after = &ranged.inner[1_u64..2_u64];
+  let after_last = range_last(values: after);
+  if after_last != 22_u64 {
+    return 12_u64;
+  }
+  let nested_values = linked_bundle(real: 1_u64);
+  let tail = box_new::<u64>(value: 99_u64);
+  let envelope = Envelope(values: move nested_values, tail: move tail);
+  let nested = box_new::<Envelope>(value: move envelope);
+  let selected = move nested.inner.values.slots;
+  if selected.inner.cap != 0_u64 {
+    return 10_u64;
+  }
+  return 0_u64;
+}
+
+fn main() -> status: std::process::ExitStatus pure waits {
+  let run_result = run();
+  if run_result != 0_u64 {
+    return std::process::exit_status(code: 1_u8);
+  }
+  let waiting_result = waiting_owners();
+  if waiting_result != 0_u64 {
+    return std::process::exit_status(code: 3_u8);
+  }
+  let finish_result = finish();
+  if finish_result != 0_u64 {
+    return std::process::exit_status(code: 2_u8);
+  }
+  return std::process::exit_status(code: 0_u8);
+}
