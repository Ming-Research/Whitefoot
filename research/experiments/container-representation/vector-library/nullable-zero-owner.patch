+//! Physical elision of zero-extent runtime Array/Slots/Ring blocks.
+//!
+//! Null is the sole virtual-owner tag. Nonnull includes ordinary linked
+//! zero-extent allocations, which must still be read and released normally.
+//! References address live owner slots; this module never creates shared
+//! writable headers. Checked source operations and target qualification remain.
+
+use super::*;
+
+pub(super) const READ: &str = "wf.runtime.shape.read";
+pub(super) const WRITE: &str = "wf.runtime.shape.write";
+pub(super) const RELEASE: &str = "wf.runtime.shape.release";
+const PAYLOAD: &str = "wf.runtime.shape.payload";
+const OWNER: &str = "wf.runtime.shape.owner";
+
+pub(super) const fn is_nullable_shape(ty: IrType) -> bool {
+    matches!(
+        ty,
+        IrType::Buffer { .. } | IrType::Window { capacity: None, .. }
+    )
+}
+
+/// Compiler-private helpers keep all physical tag handling in one place.
+/// Inlining is ordinary lowering of these operations, not a source call rule.
+pub(super) fn helpers() -> Result<Module, BackendFailure> {
+    let mut module = Module::default();
+    for (name, result, arguments, body, symbols) in [
+        (
+            READ,
+            "i64",
+            vec![
+                Parameter::named("ptr", "%block"),
+                Parameter::named("i64", "%word"),
+            ],
+            "  %empty = icmp eq ptr %block, null\n  br i1 %empty, label %zero, label %real\nzero:\n  ret i64 0\nreal:\n  %address = getelementptr inbounds i64, ptr %block, i64 %word\n  %value = load i64, ptr %address\n  ret i64 %value\n",
+            vec![],
+        ),
+        (
+            WRITE,
+            "void",
+            vec![
+                Parameter::named("ptr", "%block"),
+                Parameter::named("i64", "%word"),
+                Parameter::named("i64", "%value"),
+            ],
+            "  %empty = icmp eq ptr %block, null\n  br i1 %empty, label %done, label %real\nreal:\n  %address = getelementptr inbounds i64, ptr %block, i64 %word\n  store i64 %value, ptr %address\n  br label %done\ndone:\n  ret void\n",
+            vec![],
+        ),
+        (
+            RELEASE,
+            "void",
+            vec![Parameter::named("ptr", "%block")],
+            "  %empty = icmp eq ptr %block, null\n  br i1 %empty, label %done, label %real\nreal:\n  call void @free(ptr %block)\n  br label %done\ndone:\n  ret void\n",
+            vec!["free"],
+        ),
+        (
+            PAYLOAD,
+            "ptr",
+            vec![
+                Parameter::named("ptr", "%block"),
+                Parameter::named("ptr", "%fallback"),
+                Parameter::named("i64", "%header"),
+            ],
+            "  %empty = icmp eq ptr %block, null\n  br i1 %empty, label %zero, label %real\nzero:\n  ret ptr %fallback\nreal:\n  %address = getelementptr inbounds i8, ptr %block, i64 %header\n  ret ptr %address\n",
+            vec![],
+        ),
+        (
+            OWNER,
+            "ptr",
+            vec![
+                Parameter::named("ptr", "%payload"),
+                Parameter::named("i64", "%header"),
+            ],
+            "  %empty = icmp eq ptr %payload, null\n  br i1 %empty, label %zero, label %real\nzero:\n  ret ptr null\nreal:\n  %negative = sub i64 0, %header\n  %address = getelementptr inbounds i8, ptr %payload, i64 %negative\n  ret ptr %address\n",
+            vec![],
+        ),
+    ] {
+        let mut signature = Signature::new(name, result, arguments);
+        signature.linkage = Linkage::Private;
+        signature.suffix = " alwaysinline".to_owned();
+        let mut output = FunctionBody::default();
+        output.open_block("entry".to_owned());
+        output.instructions(body, &symbols);
+        module.define(signature.define(output, "")?);
+    }
+    Ok(module)
+}
+
+impl FunctionEmitter<'_, '_> {
+    pub(super) fn shape_word(
+        &mut self,
+        shape: IrType,
+        block: &str,
+        field: usize,
+    ) -> Result<String, BackendFailure> {
+        let word = self.next_temporary()?;
+        if is_nullable_shape(shape) {
+            self.output.symbol(READ);
+            writeln!(
+                self.output,
+                "  %{word} = call i64 @{READ}(ptr {block}, i64 {field})"
+            )?;
+        } else {
+            let address = self.aggregate_field_pointer(shape, block, field)?;
+            writeln!(self.output, "  %{word} = load i64, ptr {address}")?;
+        }
+        Ok(format!("%{word}"))
+    }
+
+    pub(super) fn store_shape_word(
+        &mut self,
+        shape: IrType,
+        block: &str,
+        field: usize,
+        value: &str,
+    ) -> Result<(), BackendFailure> {
+        if is_nullable_shape(shape) {
+            self.output.symbol(WRITE);
+            writeln!(
+                self.output,
+                "  call void @{WRITE}(ptr {block}, i64 {field}, i64 {value})"
+            )?;
+        } else {
+            let address = self.aggregate_field_pointer(shape, block, field)?;
+            writeln!(self.output, "  store i64 {value}, ptr {address}")?;
+        }
+        Ok(())
+    }
+
+    /// Empty ranges borrow their nonnull owner slot; captures use null.
+    pub(super) fn shape_payload(
+        &mut self,
+        block_type: IrType,
+        block: &str,
+        fallback: &str,
+        elements_field: usize,
+    ) -> Result<String, BackendFailure> {
+        if !is_nullable_shape(block_type) {
+            return Err(BackendFailure::InvalidIr);
+        }
+        let llvm = self.output.type_name(self.program, block_type)?;
+        let header = format!(
+            "ptrtoint (ptr getelementptr ({llvm}, ptr null, i64 0, i32 {elements_field}) to i64)"
+        );
+        let pointer = self.next_temporary()?;
+        self.output.symbol(PAYLOAD);
+        writeln!(
+            self.output,
+            "  %{pointer} = call ptr @{PAYLOAD}(ptr {block}, ptr {fallback}, i64 {header})"
+        )?;
+        Ok(format!("%{pointer}"))
+    }
+
+    pub(super) fn shape_owner(
+        &mut self,
+        payload: &str,
+        header: &str,
+    ) -> Result<String, BackendFailure> {
+        let pointer = self.next_temporary()?;
+        self.output.symbol(OWNER);
+        writeln!(
+            self.output,
+            "  %{pointer} = call ptr @{OWNER}(ptr {payload}, i64 {header})"
+        )?;
+        Ok(format!("%{pointer}"))
+    }
+}
