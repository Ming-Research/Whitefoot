+                    .env("WF_WORKERS", "0")
+                    .env("WF_NULLABLE_FAULT", fault)
+                    .bounded_output()
+                    .expect("run lifecycle observer failure control");
+                assert_eq!(output.status.code(), Some(94), "{fault}: {output:?}");
+                assert_eq!(output.stderr, reason.as_bytes(), "{fault}: {output:?}");
+                assert!(output.stdout.is_empty(), "{fault}: {output:?}");
+                eprintln!(
+                    "nullable lifecycle {overlap:?} retained={retained} {fault}: {}",
+                    output.status
