alias ExitStatus = std::process::ExitStatus;
alias GrowVector = std::collections::vector::GrowVector;
alias VectorDrain = std::collections::vector::VectorDrain;
alias exit_status = std::process::exit_status;
alias grow_vector_append = std::collections::vector::grow_vector_append;
alias grow_vector_drain = std::collections::vector::grow_vector_drain;
alias grow_vector_free_empty = std::collections::vector::grow_vector_free_empty;
alias grow_vector_insert = std::collections::vector::grow_vector_insert;
alias grow_vector_new = std::collections::vector::grow_vector_new;
alias grow_vector_remove = std::collections::vector::grow_vector_remove;
alias grow_vector_reserve = std::collections::vector::grow_vector_reserve;
alias grow_vector_swap_remove = std::collections::vector::grow_vector_swap_remove;
alias grow_vector_truncate = std::collections::vector::grow_vector_truncate;

struct VectorDigest {
  value: u64;
}

nocopy struct VectorRecord {
  words: Array<u64, 32>;
}

interface VectorElement<T: drop> {
  fn make(seed: u64) -> value: T pure;
  fn accept(env: &VectorDigest, value: T) -> result: unit writes(env);
}

fn vector_word_make(seed: u64) -> value: u64 pure {
  return seed;
}

fn vector_word_accept(env: &VectorDigest, value: u64) -> result: unit writes(env) {
  let prefix = env^.value *wrap 131_u64;
  set env^.value = prefix +wrap value;
  return unit;
}

fn vector_record_make(seed: u64) -> value: VectorRecord pure {
  let words = array_filled::<u64, 32>(value: 0_u64);
  for (index in 0_u64..32_u64) {
    set words[index] = seed +wrap index;
  }
  return VectorRecord(words: words);
}

fn vector_record_accept(env: &VectorDigest, value: VectorRecord) -> result: unit writes(env) {
  for (index in 0_u64..32_u64) {
    let word = value.words[index];
    let prefix = env^.value *wrap 131_u64;
    set env^.value = prefix +wrap word;
  }
  return unit;
}

binding WordElement : VectorElement<u64> {
  make = vector_word_make;
  accept = vector_word_accept;
}

binding RecordElement : VectorElement<VectorRecord> {
  make = vector_record_make;
  accept = vector_record_accept;
}

fn vector_library_work<interface VectorElement<T>>(values: &GrowVector<T, 8193>, count: u64, seed: u64, digest: &VectorDigest) -> result: unit writes(values.storage), writes(digest) contract {
  requires count <= 8192_u64;
  requires values^.storage.inner.len <= 0_u64;
  ensures values^.storage.inner.len == 0_u64;
} {
  for @fill (
    index in 0_u64..count,
    invariant length_lo: values^.storage.inner.len >= index,
    invariant length_hi: values^.storage.inner.len <= index
  ) {
    let next = seed +wrap index;
    let value = VectorElement::make(seed: next);
    let length = grow_vector_append::<T, 8193>(values: values, value: move value);
  }
  let middle = count / 2_u64;
  let marker_seed = ixor(seed, 11400714819323198485_u64);
  let marker = VectorElement::make(seed: marker_seed);
  let inserted = grow_vector_insert::<T, 8193>(values: values, index: middle, value: move marker);
  let removed = grow_vector_remove::<T, 8193>(values: values, index: middle);
  VectorElement::accept(env: digest, value: move removed);
  if count > 0_u64 {
    let first = grow_vector_swap_remove::<T, 8193>(values: values, index: 0_u64);
    VectorElement::accept(env: digest, value: move first);
  }
  let remaining = values^.storage.inner.len;
  let retained = remaining / 2_u64;
  grow_vector_truncate::<T, VectorDigest, fn VectorElement::accept, 8193>(values: values, retained: retained, env: digest);
  grow_vector_drain::<T, VectorDigest, fn VectorElement::accept, 8193>(values: values, env: digest);
  return unit;
}

fn vector_library_round<interface VectorElement<T>>(count: u64, seed: u64, reserve_first: Bool) -> result: u64 pure contract {
  requires count <= 8192_u64;
} {
  let values = grow_vector_new::<T, 8193>();
  let initial = values.storage.inner.len;
  if initial != 0_u64 {
    return 18446744073709551615_u64;
  }
  if reserve_first {
    let requested = count + 1_u64;
    let reserved = grow_vector_reserve::<T, 8193>(values: &values, total: requested);
  }
  let digest = VectorDigest(value: seed);
  vector_library_work::<VectorElement<T>>(values: &values, count: count, seed: seed, digest: &digest);
  grow_vector_free_empty::<T, 8193>(values: move values);
  return digest.value;
}

fn vector_library_tail_work<interface VectorElement<T>>(values: &GrowVector<T, 8193>, retained: u64, removed: u64, seed: u64, digest: &VectorDigest) -> result: unit writes(values.storage), writes(digest) contract {
  requires values^.storage.inner.len >= retained;
  requires values^.storage.inner.len <= retained;
  requires retained + removed <= 8192_u64;
  ensures values^.storage.inner.len == retained;
} {
  for @suffix (
    index in 0_u64..removed,
    invariant length_lo: values^.storage.inner.len >= retained + index,
    invariant length_hi: values^.storage.inner.len <= retained + index
  ) {
    let base = seed +wrap retained;
    let next = base +wrap index;
    let value = VectorElement::make(seed: next);
    let length = grow_vector_append::<T, 8193>(values: values, value: move value);
  }
  grow_vector_truncate::<T, VectorDigest, fn VectorElement::accept, 8193>(values: values, retained: retained, env: digest);
  return unit;
}

fn vector_library_suffix_cycles<interface VectorElement<T>>(values: &GrowVector<T, 8193>, retained: u64, removed: u64, rounds: u64, seed: u64, initial_checksum: u64) -> result: u64 writes(values.storage) contract {
  requires values^.storage.inner.len >= retained;
  requires values^.storage.inner.len <= retained;
  requires retained + removed <= 8192_u64;
  ensures values^.storage.inner.len == retained;
} {
  let checksum = initial_checksum;
  let pending = rounds;
  let next_seed = seed;
  loop @cycles (
    invariant prefix_length: values^.storage.inner.len == retained
  ) {
    if pending <= 0_u64 {
      break @cycles;
    }
    let next = next_seed;
    let digest = VectorDigest(value: next);
    for @suffix (
      suffix_index in 0_u64..removed,
      invariant suffix_length_lo: values^.storage.inner.len >= retained + suffix_index,
      invariant suffix_length_hi: values^.storage.inner.len <= retained + suffix_index
    ) {
      let suffix_base = next +wrap retained;
      let suffix_seed = suffix_base +wrap suffix_index;
      let suffix_value = VectorElement::make(seed: suffix_seed);
      let suffix_length = grow_vector_append::<T, 8193>(values: values, value: move suffix_value);
    }
    grow_vector_truncate::<T, VectorDigest, fn VectorElement::accept, 8193>(values: values, retained: retained, env: &digest);
    let prefix = checksum *wrap 257_u64;
    set checksum = prefix +wrap digest.value;
    set next_seed = next_seed +wrap 1_u64;
    set pending = pending - 1_u64;
  }
  return checksum;
}

fn vector_library_trace<interface VectorElement<T>>(count: u64, rounds: u64, seed: u64, path: u64) -> result: u64 pure contract {
  requires count <= 8192_u64;
} {
  let checksum = seed;
  if path >= 3_u64 {
    let removed = path - 3_u64;
    if removed > count {
      set removed = count;
    }
    let retained = count - removed;
    invariant prefix_bound: retained <= 8192_u64;
    invariant suffix_bound: retained + removed <= 8192_u64;
    let values = grow_vector_new::<T, 8193>();
    let initial = values.storage.inner.len;
    if initial != 0_u64 {
      return 18446744073709551615_u64;
    }
    let requested = count + 1_u64;
    let reserved = grow_vector_reserve::<T, 8193>(values: &values, total: requested);
    for @prefix (
      index in 0_u64..retained,
      invariant length_lo: values.storage.inner.len >= index,
      invariant length_hi: values.storage.inner.len <= index
    ) {
      let next = seed +wrap index;
      let value = VectorElement::make(seed: next);
      let length = grow_vector_append::<T, 8193>(values: &values, value: move value);
    }
    set checksum = vector_library_suffix_cycles::<VectorElement<T>>(values: &values, retained: retained, removed: removed, rounds: rounds, seed: seed, initial_checksum: checksum);
    let final = VectorDigest(value: seed);
    grow_vector_drain::<T, VectorDigest, fn VectorElement::accept, 8193>(values: &values, env: &final);
    grow_vector_free_empty::<T, 8193>(values: move values);
    let prefix = checksum *wrap 257_u64;
    return prefix +wrap final.value;
  }
  if path == 2_u64 {
    let values = grow_vector_new::<T, 8193>();
    let initial = values.storage.inner.len;
    if initial != 0_u64 {
      return 18446744073709551615_u64;
    }
    let requested = count + 1_u64;
    let reserved = grow_vector_reserve::<T, 8193>(values: &values, total: requested);
    for @reuse (
      round in 0_u64..rounds,
      invariant empty: values.storage.inner.len == 0_u64
    ) {
      let next = seed +wrap round;
      let digest = VectorDigest(value: next);
      vector_library_work::<VectorElement<T>>(values: &values, count: count, seed: next, digest: &digest);
      let prefix = checksum *wrap 257_u64;
      set checksum = prefix +wrap digest.value;
    }
    grow_vector_free_empty::<T, 8193>(values: move values);
    return checksum;
  }
  for (round in 0_u64..rounds) {
    let next = seed +wrap round;
    let reserve_first = path == 0_u64;
    let observed = vector_library_round::<VectorElement<T>>(count: count, seed: next, reserve_first: reserve_first);
    let prefix = checksum *wrap 257_u64;
    set checksum = prefix +wrap observed;
  }
  return checksum;
}

fn vector_library_word_trace(count: u64, rounds: u64, seed: u64, path: u64) -> result: u64 pure contract {
  requires count <= 8192_u64;
} {
  let result = vector_library_trace::<WordElement>(count: count, rounds: rounds, seed: seed, path: path);
  return result;
}

fn vector_library_record_trace(count: u64, rounds: u64, seed: u64, path: u64) -> result: u64 pure contract {
  requires count <= 8192_u64;
} {
  let result = vector_library_trace::<RecordElement>(count: count, rounds: rounds, seed: seed, path: path);
  return result;
}

struct VectorApiObservation {
  length: u64;
  capacity: u64;
  checksum: u64;
  valid: u64;
}

struct VectorApiDigest {
  seed: u64;
  index: u64;
  checksum: u64;
  valid: u64;
}

interface VectorApiElement<T: drop> {
  fn make(seed: u64) -> value: T pure;
  fn inspect(env: &VectorApiDigest, value: T) -> result: unit writes(env);
}

fn vector_api_word_inspect(env: &VectorApiDigest, value: u64) -> result: unit writes(env) {
  let expected = env^.seed +wrap env^.index;
  if value != expected {
    set env^.valid = 0_u64;
  }
  let prefix = env^.checksum *wrap 131_u64;
  set env^.checksum = prefix +wrap value;
  set env^.index = env^.index +wrap 1_u64;
  return unit;
}

fn vector_api_record_inspect(env: &VectorApiDigest, value: VectorRecord) -> result: unit writes(env) {
  let base = env^.seed +wrap env^.index;
  for (word in 0_u64..32_u64) {
    let actual = value.words[word];
    let expected = base +wrap word;
    if actual != expected {
      set env^.valid = 0_u64;
    }
    let prefix = env^.checksum *wrap 131_u64;
    set env^.checksum = prefix +wrap actual;
  }
  set env^.index = env^.index +wrap 1_u64;
  return unit;
}

binding ApiWordElement : VectorApiElement<u64> {
  make = vector_word_make;
  inspect = vector_api_word_inspect;
}

binding ApiRecordElement : VectorApiElement<VectorRecord> {
  make = vector_record_make;
  inspect = vector_api_record_inspect;
}

fn vector_api_prepare<interface VectorApiElement<T>>(capacity: u64) -> made: GrowVector<T, 8193> pure contract {
  requires capacity <= 8193_u64;
} {
  let values = grow_vector_new::<T, 8193>();
  let reserved = grow_vector_reserve::<T, 8193>(values: &values, total: capacity);
  return move values;
}

fn vector_api_append_batch<interface VectorApiElement<T>>(values: &GrowVector<T, 8193>, count: u64, seed: u64) -> length: u64 writes(values.storage) contract {
  requires count <= 8192_u64;
  requires values^.storage.inner.len <= 0_u64;
  ensures values^.storage.inner.len == count;
} {
  for @append (
    index in 0_u64..count,
    invariant length_lo: values^.storage.inner.len >= index,
    invariant length_hi: values^.storage.inner.len <= index
  ) {
    let next = seed +wrap index;
    let value = VectorApiElement::make(seed: next);
    let appended = grow_vector_append::<T, 8193>(values: values, value: move value);
  }
  return values^.storage.inner.len;
}

fn vector_api_inspect_reset<interface VectorApiElement<T>>(values: &GrowVector<T, 8193>, count: u64, seed: u64, observation: &VectorApiObservation) -> valid: u64 writes(values.storage), writes(observation) contract {
  ensures values^.storage.inner.len == 0_u64;
} {
  let length = values^.storage.inner.len;
  let capacity = values^.storage.inner.cap;
  let digest = VectorApiDigest(seed: seed, index: 0_u64, checksum: seed, valid: 1_u64);
  if length != count {
    set digest.valid = 0_u64;
  }
  grow_vector_drain::<T, VectorApiDigest, fn VectorApiElement::inspect, 8193>(values: values, env: &digest);
  set observation^.length = length;
  set observation^.capacity = capacity;
  set observation^.checksum = digest.checksum;
  set observation^.valid = digest.valid;
  return digest.valid;
}

fn vector_api_word_prepare(capacity: u64) -> made: GrowVector<u64, 8193> pure contract {
  requires capacity <= 8193_u64;
} {
  return vector_api_prepare::<ApiWordElement>(capacity: capacity);
}

fn vector_api_record_prepare(capacity: u64) -> made: GrowVector<VectorRecord, 8193> pure contract {
  requires capacity <= 8193_u64;
} {
  return vector_api_prepare::<ApiRecordElement>(capacity: capacity);
}

fn vector_api_word_append_batch(values: &GrowVector<u64, 8193>, count: u64, seed: u64) -> length: u64 writes(values.storage) contract {
  requires count <= 8192_u64;
  requires values^.storage.inner.len <= 0_u64;
  ensures values^.storage.inner.len == count;
} {
  return vector_api_append_batch::<ApiWordElement>(values: values, count: count, seed: seed);
}

fn vector_api_record_append_batch(values: &GrowVector<VectorRecord, 8193>, count: u64, seed: u64) -> length: u64 writes(values.storage) contract {
  requires count <= 8192_u64;
  requires values^.storage.inner.len <= 0_u64;
  ensures values^.storage.inner.len == count;
} {
  return vector_api_append_batch::<ApiRecordElement>(values: values, count: count, seed: seed);
}

fn vector_api_word_inspect_reset(values: &GrowVector<u64, 8193>, count: u64, seed: u64, observation: &VectorApiObservation) -> valid: u64 writes(values.storage), writes(observation) contract {
  ensures values^.storage.inner.len == 0_u64;
} {
  return vector_api_inspect_reset::<ApiWordElement>(values: values, count: count, seed: seed, observation: observation);
}

fn vector_api_record_inspect_reset(values: &GrowVector<VectorRecord, 8193>, count: u64, seed: u64, observation: &VectorApiObservation) -> valid: u64 writes(values.storage), writes(observation) contract {
  ensures values^.storage.inner.len == 0_u64;
} {
  return vector_api_inspect_reset::<ApiRecordElement>(values: values, count: count, seed: seed, observation: observation);
}

fn vector_api_word_destroy(values: GrowVector<u64, 8193>) -> result: unit pure contract {
  requires values.storage.inner.len <= 0_u64;
} {
  grow_vector_free_empty::<u64, 8193>(values: move values);
  return unit;
}

fn vector_api_record_destroy(values: GrowVector<VectorRecord, 8193>) -> result: unit pure contract {
  requires values.storage.inner.len <= 0_u64;
} {
  grow_vector_free_empty::<VectorRecord, 8193>(values: move values);
  return unit;
}

fn main() -> status: ExitStatus pure {
  let word_reserved = vector_library_word_trace(count: 3_u64, rounds: 2_u64, seed: 17_u64, path: 0_u64);
  let word_growth = vector_library_word_trace(count: 3_u64, rounds: 2_u64, seed: 17_u64, path: 1_u64);
  let record_reserved = vector_library_record_trace(count: 3_u64, rounds: 2_u64, seed: 17_u64, path: 0_u64);
  let record_growth = vector_library_record_trace(count: 3_u64, rounds: 2_u64, seed: 17_u64, path: 1_u64);
  if word_reserved != word_growth {
    return exit_status(code: 1_u8);
  }
  if record_reserved != record_growth {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
