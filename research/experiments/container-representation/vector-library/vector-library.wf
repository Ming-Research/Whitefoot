fn vector_api_word_snapshot(values: &GrowVector<u64, 8193>, observation: &VectorApiObservation) -> length: u64 reads(values.storage), writes(observation) {
  return vector_api_snapshot::<ApiWordElement>(values: values, observation: observation);
