fn vector_api_word_append_one(values: &GrowVector<u64, 8193>, seed: u64) -> length: u64 writes(values.storage) contract {
  requires values^.storage.inner.len < 8193_u64;
  ensures length == values^.storage.inner.len;
  ensures values^.storage.inner.len == entry(values)^.storage.inner.len + 1_u64;
} {
  let appended = vector_api_append_one::<ApiWordElement>(values: values, seed: seed);
  return appended;
}

