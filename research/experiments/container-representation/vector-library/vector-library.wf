}

fn vector_api_word_remove(values: &GrowVector<u64, 8193>, index: u64, seed: u64, observation: &VectorApiObservation) -> checksum: u64 writes(values.storage), writes(observation) contract {
  requires index < values^.storage.inner.len;
} {
  return vector_api_remove::<ApiWordElement>(values: values, index: index, seed: seed, observation: observation);
}

fn vector_api_record_remove(values: &GrowVector<VectorRecord, 8193>, index: u64, seed: u64, observation: &VectorApiObservation) -> checksum: u64 writes(values.storage), writes(observation) contract {
  requires index < values^.storage.inner.len;
} {
  return vector_api_remove::<ApiRecordElement>(values: values, index: index, seed: seed, observation: observation);
}

fn vector_api_word_drain(values: &GrowVector<u64, 8193>, seed: u64, observation: &VectorApiObservation) -> checksum: u64 writes(values.storage), writes(observation) {
  return vector_api_drain::<ApiWordElement>(values: values, seed: seed, observation: observation);
}

fn vector_api_record_drain(values: &GrowVector<VectorRecord, 8193>, seed: u64, observation: &VectorApiObservation) -> checksum: u64 writes(values.storage), writes(observation) {
  return vector_api_drain::<ApiRecordElement>(values: values, seed: seed, observation: observation);
}

fn vector_api_word_destroy(values: GrowVector<u64, 8193>) -> result: unit pure contract {
  requires values.storage.inner.len <= 0_u64;
} {
  grow_vector_free_empty::<u64, 8193>(values: move values);
  return unit;
}

fn vector_api_record_destroy(values: GrowVector<VectorRecord, 8193>) -> result: unit pure contract {
  requires values.storage.inner.len <= 0_u64;
} {
  grow_vector_free_empty::<VectorRecord, 8193>(values: move values);
  return unit;
}

fn main() -> status: ExitStatus pure {
  let word_reserved = vector_library_word_trace(count: 3_u64, rounds: 2_u64, seed: 17_u64, path: 0_u64);
  let word_growth = vector_library_word_trace(count: 3_u64, rounds: 2_u64, seed: 17_u64, path: 1_u64);
  let record_reserved = vector_library_record_trace(count: 3_u64, rounds: 2_u64, seed: 17_u64, path: 0_u64);
  let record_growth = vector_library_record_trace(count: 3_u64, rounds: 2_u64, seed: 17_u64, path: 1_u64);
  if word_reserved != word_growth {
    return exit_status(code: 1_u8);
  }
  if record_reserved != record_growth {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
