+#if defined(ECOSYSTEM) && defined(ACCOUNT_ONLY)
+// The logical WF pointer follows this observer's private prefix. Only the
+// prefix base may be passed to libc realloc. Save all old metadata first:
+// successful realloc ends the old allocation even when the address is equal.
+NOINLINE void *wf_cost_reallocate(void *pointer, uint64_t bytes) {
+    require(pointer != NULL, "realloc owner");
+    require(bytes != 0 && bytes <= SIZE_MAX - sizeof(AllocationHeader),
+            "realloc allocation extent");
+    AllocationHeader *old = (AllocationHeader *)pointer - 1;
+    require(old->value.magic == UINT64_C(0x766563746f726c69), "realloc allocation identity");
+    const size_t old_bytes = old->value.bytes;
+    require(bytes >= old_bytes, "grow allocation extent does not shrink");
+    AllocationHeader *fresh = realloc(old, sizeof *fresh + (size_t)bytes);
+    if (fresh == NULL) return NULL; // Original allocation and ledger survive.
+    fresh->value.bytes = (size_t)bytes;
+    fresh->value.magic = UINT64_C(0x766563746f726c69);
+    wf_ecosystem_note_realloc(old_bytes, bytes);
+    return fresh + 1;
+}
+#endif
