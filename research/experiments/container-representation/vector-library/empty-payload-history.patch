+// Frozen scalar Z descriptor ABIs: WF {len,cap,ptr}, Rust {cap,ptr,len},
+// libc++ {begin,end,end_capacity}. The owner and payload remain unchanged.
+static NOINLINE void history_read(const ApiOperations *api, ApiStorage *owner,
+                                  unsigned variant, uint64_t seed, bool corrupt) {
+    _Static_assert(sizeof(uintptr_t) == 8 && sizeof(ApiStorage) >= 24,
+                   "history frozen three-word descriptor ABI");
+    uintptr_t words[3];
+    memcpy(words, owner, sizeof words);
+    uintptr_t address;
+    uint64_t length, capacity;
+    if (variant == 0) {
+        length = words[0]; capacity = words[1]; address = words[2];
+    } else if (variant == 1) {
+        length = words[2]; capacity = words[0]; address = words[1];
+    } else {
+        require(words[2] >= words[1] && words[1] >= words[0]
+                && (words[1] - words[0]) % 8 == 0
+                && (words[2] - words[0]) % 8 == 0,
+                "history frozen C++ descriptor extent");
+        address = words[0]; length = (words[1] - words[0]) / 8;
+        capacity = (words[2] - words[0]) / 8;
+    }
+    ApiObservation snapshot = {0};
+    require(api->snapshot(owner, &snapshot) == 4096 && snapshot.valid == 1
+            && snapshot.length == length && snapshot.capacity == capacity
+            && length == 4096 && capacity == 4096 && address != 0,
+            "history descriptor agrees with ordinary snapshot");
+    const volatile uint64_t *payload = (const volatile uint64_t *)address;
+    uint64_t digest = seed;
+    for (size_t i = 0; i < 4096; ++i)
+        digest = digest * UINT64_C(131) + payload[i];
+    require((digest ^ corrupt) == append_oracle(4096, seed, false),
+            "history common read independent checksum");
+}
+
+static void history_check(bool corrupt) {
+    for (unsigned variant = 0; variant < 3; ++variant) {
+        const ApiOperations *api = &append_api[0][variant];
+        ApiStorage owner;
+        require(growth_prepare(api, &owner, 4096, 101) == 4096,
+                "history prepared capacity");
+        history_read(api, &owner, variant, 101, corrupt);
+        uint64_t returned = api->append_one(&owner, 101 + 4096);
+        require(growth_inspect_reset(api, &owner, 4096, 101, returned, false, false) == 8192,
+                "history post capacity");
+        (void)api->destroy(&owner);
+    }
+    puts("history common read: all three scalar APIs passed");
+}
