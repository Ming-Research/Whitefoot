index 000000000..ac3b5d757
--- /dev/null
+++ b/compiler/src/backend/tests/reallocation_observer.c
@@ -0,0 +1,166 @@
+/* Deterministic allocator routes for grow, independent of the host allocator's
+ * choice to move. Retire with the lowering if that obligation disappears. */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern uint64_t wf_grow_owned(void);
+extern uint64_t wf_grow_partial(void);
+extern uint64_t wf_grow_zero_capacity(void);
+extern uint64_t wf_grow_zero_stride(void);
+extern uint64_t wf_grow_failure(void **);
+extern int wf__floor_run(int, char **);
+
+struct allocation { unsigned char *pointer; size_t bytes; unsigned live; };
+static struct allocation allocations[4];
+static size_t allocated, malloc_calls, realloc_calls, releases;
+static unsigned moving, selected_case, failing;
+static void **failure_cell;
+
+static void require(int okay, const char *message) {
+    if (!okay) { fprintf(stderr, "reallocation observer: %s\n", message); exit(1); }
+}
+static struct allocation *find(void *pointer) {
+    for (size_t i = 0; i < allocated; ++i)
+        if (allocations[i].pointer == pointer) return &allocations[i];
+    require(0, "foreign allocation");
+    return NULL;
+}
+static struct allocation *make(size_t bytes, unsigned char poison) {
+    require(allocated < 4 && bytes <= 64, "unexpected allocation size/count");
+    struct allocation *allocation = &allocations[allocated++];
+    /* Reserve room for the forced in-place route, while recording only the
+     * exact logical extent the emitted allocator actually requested. */
+    allocation->pointer = malloc(64);
+    require(allocation->pointer != NULL, "observer allocation failed");
+    allocation->bytes = bytes;
+    allocation->live = 1;
+    memset(allocation->pointer, poison, 64);
+    return allocation;
+}
+static void corrupt_preserved_order(void *pointer) {
+#ifdef CORRUPT_PRESERVED_ORDER
+    if (selected_case == 0) {
+        unsigned char *payload = (unsigned char *)pointer + 16;
+        void *first, *second;
+        memcpy(&first, payload, sizeof first);
+        memcpy(&second, payload + sizeof first, sizeof second);
+        memcpy(payload, &second, sizeof second);
+        memcpy(payload + sizeof second, &first, sizeof first);
+    }
+#else
+    (void)pointer;
+#endif
+}
+void *wf_observe_allocate(uint64_t bytes) {
+    const size_t nested[] = {32, 8, 8};
+    size_t expected = selected_case == 0 ? nested[malloc_calls < 3 ? malloc_calls : 0]
+        : selected_case == 1 ? (malloc_calls == 0 ? 20 : 24)
+        : selected_case == 4 ? 17 : 16;
+    if (bytes != expected)
+        fprintf(stderr, "case=%u malloc=%zu expected=%zu observed=%llu\n",
+                selected_case, malloc_calls, expected, (unsigned long long)bytes);
+    require(bytes == expected, "malloc extent");
+    require(malloc_calls < (selected_case == 0 ? 3u : selected_case == 1 ? 2u : 1u),
+            "extra malloc");
+    ++malloc_calls;
+    return make((size_t)bytes, malloc_calls == 2 ? 0xa6 : 0xa5)->pointer;
+}
+void *wf_observe_reallocate(void *pointer, uint64_t bytes) {
+    struct allocation *old = find(pointer);
+    require(old->live && realloc_calls++ == 0 && selected_case != 1,
+            "realloc route/identity");
+    uint64_t *header = (uint64_t *)pointer;
+    uint64_t length = selected_case == 0 ? 2 : selected_case == 2 ? 0 : 1;
+    uint64_t capacity = selected_case == 0 ? 2 : selected_case == 2 ? 0 : 1;
+    size_t expected = selected_case == 0 ? 48 : selected_case == 2 ? 19
+        : selected_case == 3 ? 16 : 18;
+    require(header[0] == length && header[1] == capacity && bytes == expected,
+            "realloc old header or requested extent");
+    if (failing) return NULL;
+    if (!moving) {
+        if (bytes > old->bytes)
+            memset(old->pointer + old->bytes, 0xa6, (size_t)bytes - old->bytes);
+        old->bytes = (size_t)bytes;
+        corrupt_preserved_order(pointer);
+        return pointer;
+    }
+    struct allocation *fresh = make((size_t)bytes, 0xa6);
+    memcpy(fresh->pointer, old->pointer, old->bytes);
+    old->live = 0; /* realloc retires the old allocation without an owner free. */
+    memset(old->pointer, 0xdd, old->bytes);
+    corrupt_preserved_order(fresh->pointer);
+    return fresh->pointer;
+}
+void wf_observe_release(void *pointer) {
+    struct allocation *allocation = find(pointer);
+    require(allocation->live, "release of retired/released allocation");
+    if (selected_case == 0 && allocation->bytes == 8) {
+        uint64_t value = *(uint64_t *)pointer;
+        require(value == 17 || value == 29, "nested owner content");
+    } else {
+        uint64_t *header = (uint64_t *)pointer;
+        if (selected_case == 0)
+            require(header[0] == 2 && header[1] == 4, "nested run final header");
+        if (selected_case == 1 && allocation->bytes == 24) {
+            require(header[0] == 2 && header[1] == 8, "partial final header");
+            unsigned char *payload = allocation->pointer + 16;
+            require(payload[0] == 31 && payload[1] == 47, "partial prefix contents");
+            for (size_t i = 2; i < 8; ++i)
+                require(payload[i] == 0xa6, "partial grow copied uninitialized spare bytes");
+        }
+        if (selected_case == 2)
+            require(header[0] == 0 && header[1] == 3, "zero-capacity final header");
+        if (selected_case == 3)
+            require(header[0] == 1 && header[1] == 4, "zero-stride final header");
+    }
+    allocation->live = 0;
+    ++releases;
+    memset(pointer, 0xdd, allocation->bytes);
+}
+void wf_observe_abort(void) {
+    require(failing && realloc_calls == 1 && malloc_calls == 1 && releases == 0,
+            "unexpected floor path");
+    require(failure_cell && *failure_cell == allocations[0].pointer && allocations[0].live,
+            "owner published before realloc failure");
