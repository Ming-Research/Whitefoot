+/* Independent actual public-append observer; allocation bookkeeping is untimed. */
+#include <stdint.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+struct descriptor { uint64_t len, cap; unsigned char *payload; };
+struct guarded { uint64_t before[2]; struct descriptor value; uint64_t after[2]; };
+extern uint64_t wf_vector_api_word_append_one(struct descriptor *, uint64_t);
+extern uint64_t wf_vector_api_record_append_one(struct descriptor *, uint64_t);
+extern uint64_t wf_vector_api_word_destroy(struct descriptor *);
+extern uint64_t wf_vector_api_record_destroy(struct descriptor *);
+extern int wf__floor_run(int,char **);
+static struct guarded owner, original;
+static unsigned char *old, *fresh, *snapshot;
+static size_t stride, count, bytes, new_bytes, requests, copies, releases, resizes;
+static bool refuse, resize_route, old_live, fresh_live;
+static void require(bool okay,const char *message) {
+    if(!okay) { fprintf(stderr,"small-copy observer: %s\n",message); exit(1); }
+}
+static void unchanged(void) {
+    require(memcmp(&owner,&original,sizeof owner)==0,"descriptor and canaries before publication");
+    require(old_live && memcmp(old,snapshot,bytes+stride)==0,"complete old payload and guard unchanged");
+}
+void *wf_policy_allocate(uint64_t n) {
+    require(!resize_route && requests++==0 && n==new_bytes,"expected single malloc and exact extent");
+    unchanged(); if(refuse) return NULL;
+    fresh=malloc((size_t)n); require(fresh!=NULL,"observer fresh backing");
+    memset(fresh,0xa6,(size_t)n); fresh_live=true; return fresh;
+}
+void *wf_policy_reallocate(void *p,uint64_t n) {
+    require(resize_route && requests++==0 && p==old && n==new_bytes,"expected single realloc and exact extent");
+    unchanged(); ++resizes; if(refuse) return NULL;
+    /* Force a moved successful realloc, preserving the complete initialized prefix.
+       This is allocator instrumentation, not a measured implementation change. */
+    fresh=malloc((size_t)n); require(fresh!=NULL,"observer resize backing");
+    memset(fresh,0xa6,(size_t)n); memcpy(fresh,old,bytes); fresh_live=true; old_live=false;
+    return fresh;
+}
+void wf_policy_copy(void *to,const void *from,uint64_t n,bool vol) {
+    require(!resize_route && !refuse && requests==1 && copies++==0 && releases==0
+            && fresh_live && to==fresh && from==old && n==bytes && !vol,"exact initialized copy after malloc success");
+    unchanged(); memcpy(to,from,(size_t)n);
+#ifdef CORRUPT_COPY
+    fresh[bytes-1]^=1;
+#endif
+}
+void wf_policy_release(void *p) {
+    require(!refuse,"no release after NULL");
+    if(p==old) {
+        require(!resize_route && old_live && copies==1 && releases==0,"old retirement after full copy");
+        unchanged(); require(memcmp(fresh,snapshot,bytes)==0,"entire copied prefix before retirement");
+        old_live=false;
+    } else {
+        require(p==fresh && fresh_live && !old_live,"final payload cleanup exactly once");
+        fresh_live=false;
+    }
+    ++releases;
+}
+_Noreturn void wf_policy_abort(void) {
+    require(refuse && requests==1 && copies==0 && releases==0 && resizes==(size_t)resize_route
+            && !fresh_live,"NULL route has no copy/retirement/publication");
+    unchanged(); puts("small-copy actual append: NULL preserves all old state"); exit(73);
+}
+int wf__main_body(int argc,char **argv) {
+    require(argc==5,"usage: stride count malloc|realloc positive|null");
+    stride=(size_t)strtoull(argv[1],NULL,10); count=(size_t)strtoull(argv[2],NULL,10);
+    require((stride==8 || stride==256) && count>0 && count<=4096,"known dimensions");
+    require(!strcmp(argv[3],"malloc") || !strcmp(argv[3],"realloc"),"known route");
+    require(!strcmp(argv[4],"positive") || !strcmp(argv[4],"null"),"known mode");
+    resize_route=!strcmp(argv[3],"realloc"); refuse=!strcmp(argv[4],"null");
+    bytes=count*stride; new_bytes=2*bytes; old=malloc(bytes+stride); snapshot=malloc(bytes+stride);
+    require(old && snapshot,"initial backing and independent snapshot"); memset(old,0xa6,bytes+stride);
+    for(size_t i=0;i<count;++i)for(size_t j=0;j<stride/8;++j) { uint64_t x=17+i+j; memcpy(old+i*stride+j*8,&x,8); }
+    memcpy(snapshot,old,bytes+stride); old_live=true;
+    owner=(struct guarded){{17,29},{count,count,old},{31,47}}; original=owner;
+    uint64_t result=(stride==8?wf_vector_api_word_append_one:wf_vector_api_record_append_one)(&owner.value,101);
+    require(!refuse && result==count+1 && owner.value.len==count+1 && owner.value.cap==count*2
+            && owner.value.payload==fresh,"returned append descriptor");
+    require(!memcmp(owner.before,original.before,sizeof owner.before)
+            && !memcmp(owner.after,original.after,sizeof owner.after),"descriptor canaries after append");
+    require(!memcmp(fresh,snapshot,bytes),"entire initialized prefix value/order");
+    for(size_t j=0;j<stride/8;++j) { uint64_t x; memcpy(&x,fresh+bytes+j*8,8); require(x==101+j,"all new element fields"); }
+    for(size_t i=bytes+stride;i<new_bytes;++i)require(fresh[i]==0xa6,"remaining spare bytes untouched");
+    require(requests==1 && copies==!resize_route && resizes==resize_route && releases==!resize_route,"exact selected-route ledger");
+    (void)(stride==8?wf_vector_api_word_destroy:wf_vector_api_record_destroy)(&owner.value);
+    require(!old_live && !fresh_live && releases==(resize_route?1u:2u),"full final cleanup");
+    free(old);free(fresh);free(snapshot);puts("small-copy actual append: contents/state/route/cleanup passed");return 0;
+}
+int main(int argc,char **argv) { return wf__floor_run(argc,argv); }
