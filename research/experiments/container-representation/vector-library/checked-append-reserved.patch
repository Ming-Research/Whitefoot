+alias ExitStatus = std::process::ExitStatus;
+alias exit_status = std::process::exit_status;
+alias grow_vector_append_reserved = std::collections::vector::grow_vector_append_reserved;
+alias grow_vector_drain = std::collections::vector::grow_vector_drain;
+alias grow_vector_free_empty = std::collections::vector::grow_vector_free_empty;
+alias grow_vector_new = std::collections::vector::grow_vector_new;
+alias grow_vector_reserve = std::collections::vector::grow_vector_reserve;
+
+struct Seen {
+  total: u64;
+  count: u64;
+  failures: u64;
+}
+
+nocopy struct Record {
+  words: Array<u64, 32>;
+}
+
+nodrop struct Ticket {
+  payload: Box<u64>;
+}
+
+interface ReservedElement<T> {
+  fn make(seed: u64) -> value: T pure;
+  fn accept(env: &Seen, value: T) -> result: unit writes(env);
+}
+
+fn word_make(seed: u64) -> value: u64 pure {
+  return seed;
+}
+
+fn word_accept(env: &Seen, value: u64) -> result: unit writes(env) {
+  let expected = env^.count +wrap 1_u64;
+  if value != expected {
+    set env^.failures = env^.failures +wrap 1_u64;
+  }
+  set env^.total = env^.total +wrap value;
+  set env^.count = env^.count +wrap 1_u64;
+  return unit;
+}
+
+fn record_make(seed: u64) -> value: Record pure {
+  let words = array_filled::<u64, 32>(value: 0_u64);
+  for (index in 0_u64..32_u64) {
+    set words[index] = seed +wrap index;
+  }
+  return Record(words: words);
+}
+
+fn record_accept(env: &Seen, value: Record) -> result: unit writes(env) {
+  let seed = env^.count +wrap 1_u64;
+  for (index in 0_u64..32_u64) {
+    let word = value.words[index];
+    let expected = seed +wrap index;
+    if word != expected {
+      set env^.failures = env^.failures +wrap 1_u64;
+    }
+    set env^.total = env^.total +wrap word;
+  }
+  set env^.count = env^.count +wrap 1_u64;
+  return unit;
+}
+
+fn ticket_make(seed: u64) -> value: Ticket pure {
+  let payload = box_new::<u64>(value: seed);
+  return Ticket(payload: move payload);
+}
+
+fn ticket_accept(env: &Seen, value: Ticket) -> result: unit writes(env) {
+  let Ticket(payload: payload) = move value;
+  let number = payload.inner;
+  word_accept(env: env, value: number);
+  return unit;
+}
+
+binding WordElement : ReservedElement<u64> {
+  make = word_make;
+  accept = word_accept;
+}
+
+binding RecordElement : ReservedElement<Record> {
+  make = record_make;
+  accept = record_accept;
+}
+
+binding TicketElement : ReservedElement<Ticket> {
+  make = ticket_make;
+  accept = ticket_accept;
+}
+
+fn exercise<interface ReservedElement<T>>(count: u64) -> total: u64 pure contract {
+  requires count <= 3_u64;
+} {
+  let values = grow_vector_new::<T, 3>();
+  let seen = Seen(total: 0_u64, count: 0_u64, failures: 0_u64);
+  let failures = 0_u64;
+  let initial = values.storage.inner.len;
+  if initial == 0_u64 {
+    let capacity = grow_vector_reserve::<T, 3>(values: &values, total: count);
+    for @fill (
+      index in 0_u64..count,
+      invariant length_lo: values.storage.inner.len >= index,
+      invariant length_hi: values.storage.inner.len <= index,
+      invariant capacity_lo: values.storage.inner.cap >= capacity,
+      invariant capacity_hi: values.storage.inner.cap <= capacity
+    ) {
+      let seed = index + 1_u64;
+      let value = ReservedElement::make(seed: seed);
+      let length = grow_vector_append_reserved::<T, 3>(values: &values, value: move value);
+    }
+    if values.storage.inner.len != count {
+      set failures = failures +wrap 1_u64;
+    }
+    if values.storage.inner.cap != count {
+      set failures = failures +wrap 1_u64;
+    }
+    if values.storage.inner.cap != capacity {
+      set failures = failures +wrap 1_u64;
+    }
+  } else {
+    set failures = failures +wrap 1_u64;
+  }
+  grow_vector_drain::<T, Seen, fn ReservedElement::accept, 3>(values: &values, env: &seen);
+  grow_vector_free_empty::<T, 3>(values: move values);
+  if seen.count != count {
+    set failures = failures +wrap 1_u64;
+  }
+  if seen.failures != 0_u64 {
+    set failures = failures +wrap 1_u64;
+  }
+  if failures != 0_u64 {
+    return 18446744073709551615_u64;
+  }
+  return seen.total;
+}
+
+fn prefix_accept(env: &Seen, value: u64) -> result: unit writes(env) {
+  let ordinal = env^.count +wrap 1_u64;
+  let expected = ordinal *wrap 11_u64;
+  if value != expected {
+    set env^.failures = env^.failures +wrap 1_u64;
+  }
+  set env^.total = env^.total +wrap value;
+  set env^.count = env^.count +wrap 1_u64;
+  return unit;
+}
+
+fn prefix_reference() -> code: u64 pure {
+  let values = grow_vector_new::<u64, 2>();
+  let initial = values.storage.inner.len;
+  if initial != 0_u64 {
+    return 1_u64;
+  }
+  let capacity = grow_vector_reserve::<u64, 2>(values: &values, total: 2_u64);
+  let first_length = grow_vector_append_reserved::<u64, 2>(values: &values, value: 11_u64);
+  let prefix = &values.storage.inner[0_u64];
+  let second_length = grow_vector_append_reserved::<u64, 2>(values: &values, value: 22_u64);
+  let retained = prefix^;
+  let seen = Seen(total: 0_u64, count: 0_u64, failures: 0_u64);
+  grow_vector_drain::<u64, Seen, fn prefix_accept, 2>(values: &values, env: &seen);
+  grow_vector_free_empty::<u64, 2>(values: move values);
+  if retained != 11_u64 {
+    return 2_u64;
+  }
+  if seen.total != 33_u64 {
+    return 3_u64;
+  }
+  if seen.count != 2_u64 {
+    return 4_u64;
+  }
+  if seen.failures != 0_u64 {
+    return 5_u64;
+  }
+  return 0_u64;
+}
+
+fn main() -> status: ExitStatus pure {
+  let scalar_empty = exercise::<WordElement>(count: 0_u64);
+  let scalar_full = exercise::<WordElement>(count: 3_u64);
+  let wide_empty = exercise::<RecordElement>(count: 0_u64);
+  let wide_full = exercise::<RecordElement>(count: 3_u64);
+  let owning_empty = exercise::<TicketElement>(count: 0_u64);
+  let owning_full = exercise::<TicketElement>(count: 3_u64);
+  let prefix = prefix_reference();
+  if scalar_empty != 0_u64 {
+    return exit_status(code: 1_u8);
+  }
+  if scalar_full != 6_u64 {
+    return exit_status(code: 2_u8);
+  }
+  if wide_empty != 0_u64 {
+    return exit_status(code: 3_u8);
+  }
+  if wide_full != 1680_u64 {
+    return exit_status(code: 4_u8);
+  }
+  if owning_empty != 0_u64 {
+    return exit_status(code: 5_u8);
+  }
+  if owning_full != 6_u64 {
+    return exit_status(code: 6_u8);
+  }
+  if prefix != 0_u64 {
+    return exit_status(code: 7_u8);
+  }
+  return exit_status(code: 0_u8);
+}
