struct Item {
  rank: u64;
}

struct Ascending {
}

fn ascending_compare(env: &Ascending, left: &Item, right: &Item) -> order: own i32 reads(left.rank, right.rank) contract {
  ensures order >= -1_i32;
  ensures order <= 1_i32;
} {
  if deref(left).rank < deref(right).rank {
    return -1_i32;
  }
  if deref(left).rank > deref(right).rank {
    return 1_i32;
  }
  return 0_i32;
}

formal Order<T: linear, E: linear> {
  fn compare(env: &E, left: &T, right: &T) -> order: own i32 reads(env, left, right) contract {
    ensures order >= -1_i32;
    ensures order <= 1_i32;
  };
}

struct Queue<Order<T, E>> {
  heap: FixedVector<T, 16>;
}

actual ItemOrder : Order<Item, Ascending> {
  compare = ascending_compare;
}

fn exchange_at<T: linear>(heap: &uniq FixedVector<T, 16>, left: own u64, right: own u64) -> result: own unit reads(heap), writes(heap) contract {
  requires left < len_of(deref(heap));
  requires right < len_of(deref(heap));
  requires head_of(deref(heap)) <= 0_u64;
  ensures len_of(deref(heap)) == len_of(deref(entry(heap)));
  ensures room_of(deref(heap)) == room_of(deref(entry(heap)));
  ensures head_of(deref(heap)) <= 0_u64;
} {
  if left == right {
    return unit;
  }
  region {
    let tail = take_back(vector: &uniq deref(heap));
    let end = len_of(deref(heap));
    if left == end {
      let previous = replace deref(heap)[right] = move tail;
      place_back(vector: &uniq deref(heap), value: move previous);
      return unit;
    }
    if right == end {
      let previous = replace deref(heap)[left] = move tail;
      place_back(vector: &uniq deref(heap), value: move previous);
      return unit;
    }
    let left_value = replace deref(heap)[left] = move tail;
    let right_value = replace deref(heap)[right] = move left_value;
    let saved_tail = replace deref(heap)[left] = move right_value;
    place_back(vector: &uniq deref(heap), value: move saved_tail);
    return unit;
  }
}

fn sift_rise<Order<T, E>>(queue: &uniq Queue<Order<T, E>>, count: own u64, env: &E) -> result: own unit reads(queue.heap, env), writes(queue.heap) contract {
  requires len_of(deref(queue).heap) == count;
  requires count >= 1_u64;
  requires head_of(deref(queue).heap) <= 0_u64;
  ensures len_of(deref(queue).heap) == count;
  ensures room_of(deref(queue).heap) == room_of(deref(entry(queue)).heap);
  ensures head_of(deref(queue).heap) <= 0_u64;
} {
  let spare = room_of(deref(queue).heap);
  region {
    let at = count - 1_u64;
    loop @rise (
      invariant live: at < count,
      invariant count_low: len_of(deref(queue).heap) >= count,
      invariant count_high: len_of(deref(queue).heap) <= count,
      invariant room_low: room_of(deref(queue).heap) >= spare,
      invariant room_high: room_of(deref(queue).heap) <= spare,
      invariant origin: head_of(deref(queue).heap) <= 0_u64
    ) {
      if at == 0_u64 {
        return unit;
      }
      let before = at - 1_u64;
      let parent = before / 2_u64;
      let order = Order::compare(env: env, left: &deref(queue).heap[parent], right: &deref(queue).heap[at]);
      if order <= 0_i32 {
        return unit;
      }
      exchange_at::<T>(heap: &uniq deref(queue).heap, left: parent, right: at);
      set at = parent;
    }
  }
}

fn sift_sink<Order<T, E>>(queue: &uniq Queue<Order<T, E>>, count: own u64, env: &E) -> result: own unit reads(queue.heap, env), writes(queue.heap) contract {
  requires len_of(deref(queue).heap) == count;
  requires count >= 1_u64;
  requires head_of(deref(queue).heap) <= 0_u64;
  ensures len_of(deref(queue).heap) == count;
  ensures room_of(deref(queue).heap) == room_of(deref(entry(queue)).heap);
  ensures head_of(deref(queue).heap) <= 0_u64;
} {
  let spare = room_of(deref(queue).heap);
  region {
    let at = 0_u64;
    loop @sink (
      invariant live: at < count,
      invariant count_low: len_of(deref(queue).heap) >= count,
      invariant count_high: len_of(deref(queue).heap) <= count,
      invariant room_low: room_of(deref(queue).heap) >= spare,
      invariant room_high: room_of(deref(queue).heap) <= spare,
      invariant origin: head_of(deref(queue).heap) <= 0_u64
    ) {
      let doubled = at * 2_u64;
      let left = doubled + 1_u64;
      if left >= count {
        return unit;
      }
      let best = left;
      let right = left + 1_u64;
      if right < count {
        let sibling_order = Order::compare(env: env, left: &deref(queue).heap[right], right: &deref(queue).heap[left]);
        if sibling_order < 0_i32 {
          set best = right;
        }
      }
      let order = Order::compare(env: env, left: &deref(queue).heap[at], right: &deref(queue).heap[best]);
      if order <= 0_i32 {
        return unit;
      }
      exchange_at::<T>(heap: &uniq deref(queue).heap, left: at, right: best);
      set at = best;
    }
  }
}

fn push<Order<T, E>>(queue: &uniq Queue<Order<T, E>>, value: own T, env: &E) -> result: own unit reads(queue.heap, env), writes(queue.heap) contract {
  requires room_of(deref(queue).heap) >= 1_u64;
  requires head_of(deref(queue).heap) <= 0_u64;
  ensures len_of(deref(queue).heap) == len_of(deref(entry(queue)).heap) + 1_u64;
  ensures room_of(deref(queue).heap) == room_of(deref(entry(queue)).heap) - 1_u64;
  ensures head_of(deref(queue).heap) <= 0_u64;
} {
  region {
    let entering = len_of(deref(queue).heap);
    let count = entering + 1_u64;
    place_back(vector: &uniq deref(queue).heap, value: move value);
    sift_rise::<Order<T, E>>(queue: &uniq deref(queue), count: count, env: env);
    return unit;
  }
}

fn pop<Order<T, E>>(queue: &uniq Queue<Order<T, E>>, env: &E) -> minimum: own T reads(queue.heap, env), writes(queue.heap) contract {
  requires len_of(deref(queue).heap) >= 1_u64;
  requires head_of(deref(queue).heap) <= 0_u64;
  ensures len_of(deref(queue).heap) == len_of(deref(entry(queue)).heap) - 1_u64;
  ensures head_of(deref(queue).heap) <= 0_u64;
} {
  region {
    let last = take_back(vector: &uniq deref(queue).heap);
    let count = len_of(deref(queue).heap);
    if count == 0_u64 {
      return move last;
    }
    let minimum = replace deref(queue).heap[0_u64] = move last;
    sift_sink::<Order<T, E>>(queue: &uniq deref(queue), count: count, env: env);
    return move minimum;
  }
}

struct Direction {
  descending: Bool;
}

fn word_compare(env: &Ascending, left: &u64, right: &u64) -> order: own i32 reads(left, right) contract {
  ensures order >= -1_i32;
  ensures order <= 1_i32;
} {
  if deref(left) < deref(right) {
    return -1_i32;
  }
  if deref(left) > deref(right) {
    return 1_i32;
  }
  return 0_i32;
}

fn directed_compare(env: &Direction, left: &Item, right: &Item) -> order: own i32 reads(env.descending, left.rank, right.rank) contract {
  ensures order >= -1_i32;
  ensures order <= 1_i32;
} {
  if deref(left).rank < deref(right).rank {
    if deref(env).descending {
      return 1_i32;
    }
    return -1_i32;
  }
  if deref(left).rank > deref(right).rank {
    if deref(env).descending {
      return -1_i32;
    }
    return 1_i32;
  }
  return 0_i32;
}

actual WordOrder : Order<u64, Ascending> {
  compare = word_compare;
}

actual DirectedOrder : Order<Item, Direction> {
  compare = directed_compare;
}

fn empty_heap<T: linear>() -> heap: own FixedVector<T, 16> pure contract {
  ensures len_of(heap) == 0_u64;
  ensures head_of(heap) <= 0_u64;
} {
  let heap = fixed_vector::<T, 16>();
  return move heap;
}

fn priority_round(seed: own u64, entering: own u64) -> (checksum: own u64, next_state: own u64) pure {
  let checksum = entering;
  let state = seed;
  let heap = empty_heap::<u64>();
  let queue = Queue<WordOrder>(heap: move heap);
  let env = Ascending();
  region {
    for (
      index in 0_u64..16_u64,
      invariant grown: len_of(queue.heap) >= index,
      invariant spare: room_of(queue.heap) + index >= 16_u64,
      invariant flat: head_of(queue.heap) <= 0_u64
    ) {
      let product = state *wrap 6364136223846793005_u64;
      set state = product +wrap 1442695040888963407_u64;
      let value = state % 97_u64;
      push::<WordOrder>(queue: &uniq queue, value: value, env: &env);
    }
    for (
      index in 0_u64..16_u64,
      invariant remaining: len_of(queue.heap) + index >= 16_u64,
      invariant flat: head_of(queue.heap) <= 0_u64
    ) {
      let value = pop::<WordOrder>(queue: &uniq queue, env: &env);
      let product = checksum *wrap 1099511628211_u64;
      set checksum = product +wrap value;
    }
    return checksum, state;
  }
}

fn priority_trace(seed: own u64, rounds: own u64) -> checksum: own u64 pure {
  let checksum = 0_u64;
  let state = seed;
  for (round in 0_u64..rounds) {
    set (checksum, state) = priority_round(seed: state, entering: checksum);
  }
  return checksum;
}

fn directed_demo() -> result: own u8 pure {
  let heap = empty_heap::<Item>();
  let queue = Queue<DirectedOrder>(heap: move heap);
  let descending = True();
  let env = Direction(descending: descending);
  let first = Item(rank: 9_u64);
  let second = Item(rank: 2_u64);
  let third = Item(rank: 7_u64);
  region {
    push::<DirectedOrder>(queue: &uniq queue, value: move first, env: &env);
    push::<DirectedOrder>(queue: &uniq queue, value: move second, env: &env);
    push::<DirectedOrder>(queue: &uniq queue, value: move third, env: &env);
    let high = pop::<DirectedOrder>(queue: &uniq queue, env: &env);
    let middle = pop::<DirectedOrder>(queue: &uniq queue, env: &env);
    let low = pop::<DirectedOrder>(queue: &uniq queue, env: &env);
    if high.rank != 9_u64 {
      return 1_u8;
    }
    if middle.rank != 7_u64 {
      return 2_u8;
    }
    if low.rank != 2_u64 {
      return 3_u8;
    }
    return 0_u8;
  }
}

fn main() -> status: own ExitStatus pure {
  let code = directed_demo();
  if code != 0_u8 {
    return exit_status(code: code);
  }
  let trace = priority_trace(seed: 1_u64, rounds: 1_u64);
  if trace != 16743229412097926756_u64 {
    return exit_status(code: 4_u8);
  }
  return exit_status(code: 0_u8);
}
