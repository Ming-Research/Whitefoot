+    /// Scratch-only fused Ring operation: return the old back element, write
+    /// a replacement at the new front, and leave length unchanged.
+    pub(super) fn emit_run_replace_back_front(
+        &mut self,
+        result: IrValueId,
+        ty: IrType,
+        run: IrValueId,
+        value: IrValueId,
+    ) -> Result<(), BackendFailure> {
+        if !matches!(self.value_type(run), Some(IrType::Address(_))) {
+            return Err(BackendFailure::InvalidIr);
+        }
+        let run_type = self.run_value_type(run)?;
+        let Some(shape) = RunShape::of(run_type) else {
+            return Err(BackendFailure::InvalidIr);
+        };
+        if shape.shape != IrWindowShape::Ring
+            || shape.element_type(self.program)? != ty
+            || self.value_type(value) != Some(ty)
+        {
+            return Err(BackendFailure::InvalidIr);
+        }
+        // At full capacity the old back and new front can be one slot, so
+        // capture the result before storing the replacement.
+        let old_physical = self.boundary_slot(shape, run_type, run, IrBoundary::TakeBack)?;
+        let old_pointer = self.element_pointer(result, shape, run_type, run, &old_physical)?;
+        self.load_place_result(result, ty, &format!("%{old_pointer}"))?;
+        let new_physical = self.boundary_slot(shape, run_type, run, IrBoundary::PlaceFront)?;
+        let new_pointer = self.element_pointer(result, shape, run_type, run, &new_physical)?;
+        self.store_value_at(value, &format!("%{new_pointer}"))?;
+        let destination = self.run_storage(run)?.ok_or(BackendFailure::InvalidIr)?;
+        let field = shape.head_field().ok_or(BackendFailure::InvalidIr)?;
+        let head = self.aggregate_field_pointer(run_type, &destination, field as usize)?;
+        writeln!(self.output, "  store i64 {new_physical}, ptr {head}")
+            .map_err(|_| BackendFailure::TextEmission)
+    }
