fn priority_queue_sift_rise_indexed<interface PriorityOrder<T, E>, P, fn placed(env: &P, value: &T, index: u64) -> result: unit reads(value), writes(env), const ceiling: u64>(queue: &PriorityQueue<T, ceiling>, start: u64, count: u64, order_env: &E, position_env: &P) -> result: unit reads(order_env), writes(queue.storage), writes(position_env) contract {
  requires deref(queue).storage.inner.len >= count;
  requires deref(queue).storage.inner.len <= count;
  requires start < count;
  ensures deref(queue).storage.inner.len == count;
  ensures deref(queue).storage.inner.cap == deref(entry(queue)).storage.inner.cap;
} {
  doc "Each continuing iteration moves to a strictly smaller parent index. Comparison can stop a sift but cannot change its direction or extend its logarithmic path. Each exchange reports both resident positions through a separate callback whose state is disjoint from the heap.";
  let capacity = deref(queue).storage.inner.cap;
  let at = start;
  loop @rise (
    invariant live: at < count,
    invariant length_low: deref(queue).storage.inner.len >= count,
    invariant length_high: deref(queue).storage.inner.len <= count,
    invariant capacity_low: deref(queue).storage.inner.cap >= capacity,
    invariant capacity_high: deref(queue).storage.inner.cap <= capacity
  ) {
    if at == 0_u64 {
      return unit;
    }
    let before = at - 1_u64;
    let parent = before / 2_u64;
    invariant progress: parent < at;
    let order = PriorityOrder::compare(env: order_env, left: &deref(queue).storage.inner[parent], right: &deref(queue).storage.inner[at]);
    if order <= 0_i32 {
      return unit;
    }
    swap(first: &deref(queue).storage.inner[parent], second: &deref(queue).storage.inner[at]);
    placed(env: position_env, value: &deref(queue).storage.inner[parent], index: parent);
    placed(env: position_env, value: &deref(queue).storage.inner[at], index: at);
    set at = parent;
  }
  return unit;
}

fn priority_queue_sift_sink_indexed<interface PriorityOrder<T, E>, P, fn placed(env: &P, value: &T, index: u64) -> result: unit reads(value), writes(env), const ceiling: u64>(queue: &PriorityQueue<T, ceiling>, start: u64, count: u64, order_env: &E, position_env: &P) -> result: unit reads(order_env), writes(queue.storage), writes(position_env) contract {
  requires deref(queue).storage.inner.len >= count;
  requires deref(queue).storage.inner.len <= count;
  requires start < count;
  ensures deref(queue).storage.inner.len == count;
  ensures deref(queue).storage.inner.cap == deref(entry(queue)).storage.inner.cap;
} {
  doc "Exactly the indices below count / 2 have children. The leaf test precedes child arithmetic, and its quotient bound proves both children fit u64 even for zero-byte elements and the largest capacity. Each continuing iteration selects a strictly larger child below count, independently of comparator consistency, and reports both positions after each exchange.";
  let capacity = deref(queue).storage.inner.cap;
  let parents = count / 2_u64;
  let at = start;
  loop @sink (
    invariant live: at < count,
    invariant length_low: deref(queue).storage.inner.len >= count,
    invariant length_high: deref(queue).storage.inner.len <= count,
    invariant capacity_low: deref(queue).storage.inner.cap >= capacity,
    invariant capacity_high: deref(queue).storage.inner.cap <= capacity
  ) {
    if at >= parents {
      return unit;
    }
    invariant children: 2_u64 * at + 2_u64 <= count {
      use (2_u64 * parents <= count);
      use 2 times (at < parents);
    }
    let doubled = at * 2_u64;
    let left = doubled + 1_u64;
    let best = priority_queue_child::<PriorityOrder<T, E>, ceiling>(queue: queue, left: left, env: order_env);
    invariant progress: best > at;
    let order = PriorityOrder::compare(env: order_env, left: &deref(queue).storage.inner[at], right: &deref(queue).storage.inner[best]);
    if order <= 0_i32 {
      return unit;
    }
    swap(first: &deref(queue).storage.inner[at], second: &deref(queue).storage.inner[best]);
    placed(env: position_env, value: &deref(queue).storage.inner[at], index: at);
    placed(env: position_env, value: &deref(queue).storage.inner[best], index: best);
    set at = best;
  }
  return unit;
}

fn priority_queue_repair_at_indexed<interface PriorityOrder<T, E>, P, fn placed(env: &P, value: &T, index: u64) -> result: unit reads(value), writes(env), const ceiling: u64>(queue: &PriorityQueue<T, ceiling>, index: u64, count: u64, order_env: &E, position_env: &P) -> result: unit reads(order_env), writes(queue.storage), writes(position_env) contract {
  requires deref(queue).storage.inner.len >= count;
  requires deref(queue).storage.inner.len <= count;
  requires index < count;
  ensures deref(queue).storage.inner.len == count;
  ensures deref(queue).storage.inner.cap == deref(entry(queue)).storage.inner.cap;
} {
  doc "Only the selected entry has changed relative to a previously ordered heap. Compare its parent once to choose a rise or sink; either selected path has bounded progress for every returning comparator and reporter. Ordering and correct reverse metadata are protocol properties, never premises for an access bound.";
  if index > 0_u64 {
    let before = index - 1_u64;
    let parent = before / 2_u64;
    invariant bounded_parent: parent < index;
    let order = PriorityOrder::compare(env: order_env, left: &deref(queue).storage.inner[parent], right: &deref(queue).storage.inner[index]);
    if order > 0_i32 {
      priority_queue_sift_rise_indexed::<PriorityOrder<T, E>, P, fn placed, ceiling>(queue: queue, start: index, count: count, order_env: order_env, position_env: position_env);
      return unit;
    }
  }
  priority_queue_sift_sink_indexed::<PriorityOrder<T, E>, P, fn placed, ceiling>(queue: queue, start: index, count: count, order_env: order_env, position_env: position_env);
  return unit;
}

fn priority_queue_push_indexed<interface PriorityOrder<T, E>, P, fn placed(env: &P, value: &T, index: u64) -> result: unit reads(value), writes(env), const ceiling: u64>(queue: &PriorityQueue<T, ceiling>, value: T, order_env: &E, position_env: &P) -> result: Result<unit, T> reads(order_env), writes(queue.storage), writes(position_env) {
  doc "Adds one entry and reports its initial resident position even when it does not rise. Every later swap reports both resident entries. Err returns the offered owner unchanged without invoking the reporter. The reporter's environment must be disjoint from the queue and order environment.";
  let entering = deref(queue).storage.inner.len;
  if entering >= ceiling {
    return Err<unit, T>(error: move value);
  }
  priority_queue_make_room::<T, ceiling>(queue: queue);
  let count = entering + 1_u64;
  place_back(window: &deref(queue).storage.inner, value: move value);
  placed(env: position_env, value: &deref(queue).storage.inner[entering], index: entering);
  priority_queue_sift_rise_indexed::<PriorityOrder<T, E>, P, fn placed, ceiling>(queue: queue, start: entering, count: count, order_env: order_env, position_env: position_env);
  return Ok<unit, T>(value: unit);
}

fn priority_queue_peek_at<T, F, R, fn observe(env: &F, value: &T) -> result: R reads(value), writes(env), const ceiling: u64>(queue: &PriorityQueue<T, ceiling>, index: u64, env: &F) -> result: R reads(queue.storage), writes(env) contract {
  requires index < deref(queue).storage.inner.len;
} {
  doc "Lends the entry currently at a caller-proved position. A position is not stable identity; a handle-based caller must check the observed entry before using that position for a later mutation. The result is ordinary owned data and cannot retain the reference.";
  let observed = observe(env: env, value: &deref(queue).storage.inner[index]);
  return move observed;
}

fn priority_queue_remove_at_indexed<interface PriorityOrder<T, E>, P, fn placed(env: &P, value: &T, index: u64) -> result: unit reads(value), writes(env), const ceiling: u64>(queue: &PriorityQueue<T, ceiling>, index: u64, order_env: &E, position_env: &P) -> removed: T reads(order_env), writes(queue.storage), writes(position_env) contract {
  requires index < deref(queue).storage.inner.len;
  ensures deref(queue).storage.inner.len + 1_u64 == deref(entry(queue)).storage.inner.len;
  ensures deref(queue).storage.inner.cap == deref(entry(queue)).storage.inner.cap;
} {
  doc "Returns the owner at the current position, replacing it with the last entry and repairing in one direction when necessary. Removing the last entry reports no placement. The caller explicitly retires the returned entry's membership; the reporter only receives entries still resident in the heap.";
  let removed = take_back(window: &deref(queue).storage.inner);
  let count = deref(queue).storage.inner.len;
  if index < count {
    swap(first: &deref(queue).storage.inner[index], second: &removed);
    placed(env: position_env, value: &deref(queue).storage.inner[index], index: index);
    priority_queue_repair_at_indexed::<PriorityOrder<T, E>, P, fn placed, ceiling>(queue: queue, index: index, count: count, order_env: order_env, position_env: position_env);
  }
  return move removed;
}

fn priority_queue_replace_at_indexed<interface PriorityOrder<T, E>, P, fn placed(env: &P, value: &T, index: u64) -> result: unit reads(value), writes(env), const ceiling: u64>(queue: &PriorityQueue<T, ceiling>, index: u64, value: T, order_env: &E, position_env: &P) -> removed: T reads(order_env), writes(queue.storage), writes(position_env) contract {
  requires index < deref(queue).storage.inner.len;
  ensures deref(queue).storage.inner.len == deref(entry(queue)).storage.inner.len;
  ensures deref(queue).storage.inner.cap == deref(entry(queue)).storage.inner.cap;
} {
  doc "Exchanges the offered owner with the selected entry, reports its placement and repairs upward or downward. A reschedule offers the same application identity with a new ordering key. Replacing a different identity requires the caller to retire the returned entry's old membership separately.";
  let count = deref(queue).storage.inner.len;
  swap(first: &deref(queue).storage.inner[index], second: &value);
  placed(env: position_env, value: &deref(queue).storage.inner[index], index: index);
  priority_queue_repair_at_indexed::<PriorityOrder<T, E>, P, fn placed, ceiling>(queue: queue, index: index, count: count, order_env: order_env, position_env: position_env);
  return move value;
}
