+#[derive(Clone, Copy)]
+enum OpeningMutation {
+    OmitTransfer,
+    KeepLength,
+    AlwaysTransfer,
+    ObserveTransfer,
+}
+
+/// Mutate just the eligible opening, leaving insertion placement and every
+/// other aggregate copy intact. The host probe observes the actual move size;
+/// faults independently omit movement, omit length change or bypass its guard.
+fn opening_mutation(module: &str, mutation: OpeningMutation) -> String {
+    let mut in_insert = false;
+    let mut in_shift = false;
+    let mut after_shift = false;
+    let mut changed = 0;
+    let mut broken = String::new();
+    for line in module.lines() {
+        if line.starts_with("define ") {
+            in_insert = line.contains("@wf_insert_at$instance$");
+            in_shift = false;
+            after_shift = false;
+        }
+        if in_insert && line.starts_with("run.shift.pre.") {
+            in_shift = true;
+        }
+        if in_insert && line.starts_with("run.shift.done.") {
+            in_shift = false;
+            after_shift = true;
+        }
+        if matches!(mutation, OpeningMutation::ObserveTransfer)
+            && in_shift
+            && line.contains("call void @llvm.memmove.p0.p0.i64(")
+        {
+            broken.push_str(&line.replace("@llvm.memmove.p0.p0.i64(", "@wf_test_opening_move("));
+            broken.push('\n');
+            changed += 1;
+            continue;
+        }
+        if matches!(mutation, OpeningMutation::AlwaysTransfer)
+            && in_shift
+            && line.starts_with("  br i1 ")
+            && let Some((_, targets)) = line.split_once(", label %run.shift.body.")
+            && let Some((suffix, _)) = targets.split_once(", label %run.shift.done.")
+        {
+            broken.push_str(&format!("  br label %run.shift.body.{suffix}\n"));
+            changed += 1;
+            continue;
+        }
+        if matches!(mutation, OpeningMutation::OmitTransfer)
+            && in_shift
+            && line.contains("call void @llvm.memmove.")
+        {
+            changed += 1;
+            continue;
+        }
+        if matches!(mutation, OpeningMutation::KeepLength)
+            && after_shift
+            && line.contains(" = add i64 ")
+            && let Some(prefix) = line.strip_suffix(", 1")
+        {
+            broken.push_str(prefix);
+            broken.push_str(", 0\n");
+            changed += 1;
+            after_shift = false;
+            continue;
+        }
+        broken.push_str(line);
+        broken.push('\n');
+    }
+    assert!(
+        changed > 0,
+        "the selected opening mutation must change its instruction"
+    );
+    if matches!(mutation, OpeningMutation::ObserveTransfer) {
+        broken.push_str("\ndeclare void @wf_test_opening_move(ptr, ptr, i64, i1)\n");
+    }
+    broken
+}
