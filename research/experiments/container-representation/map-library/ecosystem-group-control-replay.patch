+fn hash_map_controls_new<const ceiling: u64>(capacity: u64) -> result: HashMapControls pure contract {
+  requires capacity <= ceiling;
+} {
+  let empty = 9259542123273814144_u64;
+  let words = slots_new::<Box<Array<u64>>, 1>();
+  if capacity > 8_u64 {
+    let groups = capacity / 8_u64;
+    let backing = box_array_filled::<u64>(count: groups, value: empty);
+    place_back(window: &words, value: move backing);
+  }
+  return HashMapControls(tail: empty, words: move words);
+}
+
+fn hash_map_control_fingerprint(hash: u64) -> result: u64 pure contract {
+  ensures result <= 127_u64;
+} {
+  let fingerprint = ishr(hash, 57_u32);
+  return fingerprint;
+}
+
+fn hash_map_control_word(controls: &HashMapControls, group: u64) -> result: u64 reads(controls) {
+  if controls^.words.len == 0_u64 {
+    if group == 0_u64 {
+      return controls^.tail;
+    }
+    return 9259542123273814144_u64;
+  }
+  let stored_words = &controls^.words[0_u64];
+  if group < stored_words^.inner.len {
+    return stored_words^.inner[group];
+  }
+  if group == stored_words^.inner.len {
+    return controls^.tail;
+  }
+  return 9259542123273814144_u64;
+}
+
+fn hash_map_control_set(controls: &HashMapControls, index: u64, code: u64) -> result: unit writes(controls) contract {
+  requires code <= 255_u64;
+} {
+  let group = index / 8_u64;
+  let lane = index % 8_u64;
+  let distance = lane * 8_u64;
+  let shift = cvt::<u64, u32>(distance);
+  let lane_bits = ishl(255_u64, shift);
+  let keep = inot(lane_bits);
+  let bits = ishl(code, shift);
+  if controls^.words.len == 0_u64 {
+    if group == 0_u64 {
+      let kept = iand(controls^.tail, keep);
+      set controls^.tail = ior(kept, bits);
+    }
+    return unit;
+  }
+  let stored_words = &controls^.words[0_u64];
+  if group < stored_words^.inner.len {
+    let kept = iand(stored_words^.inner[group], keep);
+    set stored_words^.inner[group] = ior(kept, bits);
+  } else if group == stored_words^.inner.len {
+    let kept = iand(controls^.tail, keep);
+    set controls^.tail = ior(kept, bits);
+  }
+  return unit;
+}
+
+fn hash_map_control_equal(word: u64, code: u64) -> result: u64 pure {
+  let repeated = code *wrap 72340172838076673_u64;
+  let different = ixor(word, repeated);
+  let lower = iand(different, 9187201950435737471_u64);
+  let nonzero = lower +wrap 9187201950435737471_u64;
+  let either = ior(nonzero, different);
+  let filled = ior(either, 9187201950435737471_u64);
+  let inverse = inot(filled);
+  return iand(inverse, 9259542123273814144_u64);
+}
+
+fn hash_map_control_span(lane: u64, suffix: u64, remaining: u64) -> result: u64 pure contract {
+  requires lane < 8_u64;
+  requires suffix > 0_u64;
+  requires remaining > 0_u64;
+  ensures result >= 1_u64;
+  ensures result <= 8_u64;
+  ensures result <= suffix;
+  ensures result <= remaining;
+} {
+  let span = 8_u64 - lane;
+  if span > suffix {
+    set span = suffix;
+  }
+  if span > remaining {
+    set span = remaining;
+  }
+  return span;
+}
+
+fn hash_map_control_active(lane: u64, span: u64) -> result: u64 pure contract {
+  requires lane < 8_u64;
+  requires span >= 1_u64;
+  requires span <= 8_u64;
+} {
+  let width = span * 8_u64;
+  let width32 = cvt::<u64, u32>(width);
+  let discard = 64_u32 - width32;
+  let prefix = ishr(9259542123273814144_u64, discard);
+  let distance = lane * 8_u64;
+  let shift = cvt::<u64, u32>(distance);
+  return ishl(prefix, shift);
+}
+
+fn hash_map_control_first(mask: u64) -> result: u64 pure contract {
+  requires mask > 0_u64;
+  ensures result < 8_u64;
+} {
+  let bit = ictz(mask);
+  let lane = bit / 8_u32;
+  let selected = cvt::<u32, u64>(lane);
+  return selected;
+}
+
+fn hash_map_control_stop(empty: u64, lane: u64, span: u64) -> result: u64 pure contract {
+  ensures result <= span;
+} {
+  if empty > 0_u64 {
+    let first = hash_map_control_first(mask: empty);
+    if first >= lane {
+      let offset = first - lane;
+      if offset < span {
+        return offset;
+      }
+    }
+  }
+  return span;
+}
+
+fn hash_map_control_inserted<K, V>(outcome: &HashMapPut<K, V>) -> result: Bool reads(outcome) {
+  match outcome^ {
+    HashMapInserted() => {
+      return True();
+    }
+    HashMapReturned(reason: returned_reason, pair: returned_pair) => {
+      return False();
+    }
+  }
+}
