struct MapCostEnv {
  salt: u64;
  collide: Bool;
}

struct MapCostDigest {
  ordered: u64;
  sum: u64;
  parity: u64;
  count: u64;
}

nocopy struct MapCostRecord {
  words: Array<u64, 32>;
}

interface MapCostElement<T: drop> {
  fn make(seed: u64) -> value: T pure;
  fn content(key: u64, value: T) -> result: u64 pure;
  fn observe(env: &MapCostDigest, key: &u64, value: &T) -> result: u64 reads(key), reads(value), writes(env);
  fn edit(env: &MapCostDigest, key: &u64, value: &T) -> result: u64 reads(key), writes(env), writes(value);
  fn consume(env: &MapCostDigest, key: u64, value: T) -> result: unit writes(env);
}

fn map_cost_mix(value: u64) -> result: u64 pure {
  let shifted1 = ishr(value, 30_u32);
  let mixed1 = ixor(value, shifted1);
  let first = mixed1 *wrap 13787848793156543929_u64;
  let shifted2 = ishr(first, 27_u32);
  let mixed2 = ixor(first, shifted2);
  let second = mixed2 *wrap 10723151780598845931_u64;
  let shifted3 = ishr(second, 31_u32);
  return ixor(second, shifted3);
}

fn map_cost_hash(env: &MapCostEnv, key: &u64) -> result: u64 reads(env), reads(key) {
  if deref(env).collide {
    return 0_u64;
  }
  let salted = ixor(deref(key), deref(env).salt);
  return map_cost_mix(value: salted);
}

fn map_cost_equal(env: &MapCostEnv, left: &u64, right: &u64) -> result: Bool reads(left), reads(right) {
  return deref(left) == deref(right);
}

binding MapCostDenseKey : DenseKey<u64, MapCostEnv> {
  hash = map_cost_hash;
  equal = map_cost_equal;
}

binding MapCostSparseKey : SparseKey<u64, MapCostEnv> {
  hash = map_cost_hash;
  equal = map_cost_equal;
}

binding MapCostSlotKey : SlotKey<u64, MapCostEnv> {
  hash = map_cost_hash;
  equal = map_cost_equal;
}

binding MapCostStagedKey : StagedKey<u64, MapCostEnv> {
  hash = map_cost_hash;
  equal = map_cost_equal;
}

binding MapCostLibraryKey : HashMapKey<u64, MapCostEnv> {
  hash = map_cost_hash;
  equal = map_cost_equal;
}

fn map_cost_key(index: u64) -> result: u64 pure {
  let doubled = index *wrap 2_u64;
  return doubled +wrap 1_u64;
}

fn map_cost_ordered(env: &MapCostDigest, value: u64) -> result: unit writes(env) {
  let prefix = deref(env).ordered *wrap 131_u64;
  set deref(env).ordered = prefix +wrap value;
  return unit;
}

fn map_cost_final(env: &MapCostDigest, value: u64) -> result: unit writes(env) {
  set deref(env).sum = deref(env).sum +wrap value;
  let mixed = map_cost_mix(value: value);
  set deref(env).parity = ixor(deref(env).parity, mixed);
  set deref(env).count = deref(env).count +wrap 1_u64;
  return unit;
}

fn map_cost_finish(digest: MapCostDigest) -> result: u64 pure {
  let first = map_cost_mix(value: digest.ordered);
  let second = map_cost_mix(value: digest.sum);
  let pair = ixor(first, second);
  let combined = ixor(pair, digest.parity);
  let count = digest.count *wrap 11400714819323198485_u64;
  return ixor(combined, count);
}

fn map_cost_word_make(seed: u64) -> value: u64 pure {
  return seed;
}

fn map_cost_word_content(key: u64, value: u64) -> result: u64 pure {
  let prefix = key *wrap 131_u64;
  return prefix +wrap value;
}

fn map_cost_word_observe(env: &MapCostDigest, key: &u64, value: &u64) -> result: u64 reads(value) {
  return deref(value);
}

fn map_cost_word_edit(env: &MapCostDigest, key: &u64, value: &u64) -> result: u64 writes(value) {
  set deref(value) = deref(value) +wrap 1_u64;
  return deref(value);
}

fn map_cost_word_consume(env: &MapCostDigest, key: u64, value: u64) -> result: unit writes(env) {
  let content = map_cost_word_content(key: key, value: value);
  map_cost_final(env: env, value: content);
  return unit;
}

fn map_cost_record_make(seed: u64) -> value: MapCostRecord pure {
  let words = array_filled::<u64, 32>(value: 0_u64);
  for (index in 0_u64..32_u64) {
    set words[index] = seed +wrap index;
  }
  return MapCostRecord(words: words);
}

fn map_cost_record_content(key: u64, value: MapCostRecord) -> result: u64 pure {
  let digest = key;
  for (index in 0_u64..32_u64) {
    let prefix = digest *wrap 131_u64;
    set digest = prefix +wrap value.words[index];
  }
  return digest;
}

fn map_cost_record_observe(env: &MapCostDigest, key: &u64, value: &MapCostRecord) -> result: u64 reads(value) {
  return deref(value).words[0_u64];
}

fn map_cost_record_edit(env: &MapCostDigest, key: &u64, value: &MapCostRecord) -> result: u64 writes(value) {
  set deref(value).words[0_u64] = deref(value).words[0_u64] +wrap 1_u64;
  return deref(value).words[0_u64];
}

fn map_cost_record_consume(env: &MapCostDigest, key: u64, value: MapCostRecord) -> result: unit writes(env) {
  let content = map_cost_record_content(key: key, value: move value);
  map_cost_final(env: env, value: content);
  return unit;
}

binding MapCostWord : MapCostElement<u64> {
  make = map_cost_word_make;
  content = map_cost_word_content;
  observe = map_cost_word_observe;
  edit = map_cost_word_edit;
  consume = map_cost_word_consume;
}

binding MapCostWide : MapCostElement<MapCostRecord> {
  make = map_cost_record_make;
  content = map_cost_record_content;
  observe = map_cost_record_observe;
  edit = map_cost_record_edit;
  consume = map_cost_record_consume;
}

fn map_cost_lookup_result(found: Result<u64, unit>, digest: &MapCostDigest) -> result: unit writes(digest) {
  match found {
    Ok(value: identity) => {
      map_cost_ordered(env: digest, value: 1_u64);
      map_cost_ordered(env: digest, value: identity);
    }
    Err(error: absent) => {
      map_cost_ordered(env: digest, value: 0_u64);
    }
  }
  return unit;
}

fn map_cost_rebuild_result(result: Result<unit, unit>, digest: &MapCostDigest) -> done: unit writes(digest) {
  match result {
    Ok(value: success) => {
      map_cost_ordered(env: digest, value: 1_u64);
    }
    Err(error: refused) => {
      map_cost_ordered(env: digest, value: 0_u64);
    }
  }
  return unit;
}

fn map_cost_dense_trace<interface MapCostElement<T>>(capacity: u64, count: u64, rounds: u64, seed: u64, path: u64, collide: u64) -> result: u64 pure contract {
  requires capacity <= 8192_u64;
  requires count <= capacity;
} {
  let salt = ixor(seed, 11400714819323198485_u64);
  let colliding = collide != 0_u64;
  let env = MapCostEnv(salt: salt, collide: colliding);
  let map = dense_map_new::<u64, T, 16384>(capacity: capacity);
  let digest = MapCostDigest(ordered: seed, sum: 0_u64, parity: 0_u64, count: 0_u64);
  for (index in 0_u64..count) {
    let key = map_cost_key(index: index);
    let next = seed +wrap index;
    let value = MapCostElement::make(seed: next);
    let inserted = dense_map_put::<MapCostDenseKey, T, 16384>(map: &map, key: key, value: move value, env: &env);
    match move inserted {
      DenseInserted() => {
        map_cost_ordered(env: &digest, value: 0_u64);
      }
      DenseReplaced(previous: pair) => {
        map_cost_ordered(env: &digest, value: 1_u64);
        let DensePair(key: old_key, value: old_value) = move pair;
        let content = MapCostElement::content(key: old_key, value: move old_value);
        map_cost_ordered(env: &digest, value: content);
      }
      DenseFull(offered: pair) => {
        map_cost_ordered(env: &digest, value: 2_u64);
        let DensePair(key: old_key, value: old_value) = move pair;
        let content = MapCostElement::content(key: old_key, value: move old_value);
        map_cost_ordered(env: &digest, value: content);
      }
    }
  }
  for (round in 0_u64..rounds) {
    if path == 5_u64 {
      let lower_half = count / 2_u64;
      let removed_count = count - lower_half;
      for (removed_index in 0_u64..removed_count) {
        let index = removed_index *wrap 2_u64;
        let key = map_cost_key(index: index);
        let removed = dense_map_remove::<MapCostDenseKey, T, 16384>(map: &map, key: &key, env: &env);
        match move removed {
          Some(value: pair) => {
            map_cost_ordered(env: &digest, value: 1_u64);
            let DensePair(key: old_key, value: old_value) = move pair;
            let content = MapCostElement::content(key: old_key, value: move old_value);
            map_cost_ordered(env: &digest, value: content);
          }
          None() => {
            map_cost_ordered(env: &digest, value: 0_u64);
          }
        }
        let absent = dense_map_lookup::<MapCostDenseKey, T, MapCostDigest, u64, fn MapCostElement::observe, 16384>(map: &map, key: &key, key_env: &env, visit_env: &digest);
        map_cost_lookup_result(found: absent, digest: &digest);
      }
      let rebuilt = dense_map_rehash::<MapCostDenseKey, T, 16384>(map: &map, env: &env);
      map_cost_rebuild_result(result: rebuilt, digest: &digest);
      for (index in 0_u64..count) {
        let key = map_cost_key(index: index);
        let found = dense_map_lookup::<MapCostDenseKey, T, MapCostDigest, u64, fn MapCostElement::observe, 16384>(map: &map, key: &key, key_env: &env, visit_env: &digest);
        map_cost_lookup_result(found: found, digest: &digest);
      }
      for (removed_index in 0_u64..removed_count) {
        let index = removed_index *wrap 2_u64;
        let key = map_cost_key(index: index);
        let next_round = round +wrap 1_u64;
        let shift = next_round *wrap count;
        let base = seed +wrap shift;
        let next = base +wrap index;
        let value = MapCostElement::make(seed: next);
        let inserted = dense_map_put::<MapCostDenseKey, T, 16384>(map: &map, key: key, value: move value, env: &env);
        match move inserted {
          DenseInserted() => {
            map_cost_ordered(env: &digest, value: 0_u64);
          }
          DenseReplaced(previous: pair) => {
            map_cost_ordered(env: &digest, value: 1_u64);
            let DensePair(key: old_key, value: old_value) = move pair;
            let content = MapCostElement::content(key: old_key, value: move old_value);
            map_cost_ordered(env: &digest, value: content);
          }
          DenseFull(offered: pair) => {
            map_cost_ordered(env: &digest, value: 2_u64);
            let DensePair(key: old_key, value: old_value) = move pair;
            let content = MapCostElement::content(key: old_key, value: move old_value);
            map_cost_ordered(env: &digest, value: content);
          }
        }
      }
    } else {
      if path == 4_u64 {
        let target = 1_u64;
        if capacity != 0_u64 {
          set target = capacity * 2_u64;
        }
        let grown = dense_map_reserve::<MapCostDenseKey, T, 16384>(map: &map, capacity: target, env: &env);
        map_cost_rebuild_result(result: grown, digest: &digest);
      }
      for (index in 0_u64..count) {
        let query_index = index;
        if path == 1_u64 {
          set query_index = count +wrap index;
        }
        let key = map_cost_key(index: query_index);
        let hit_path = path == 0_u64;
        let miss_path = path == 1_u64;
        let grow_path = path == 4_u64;
        let fixed_lookup = bor(hit_path, miss_path);
        let lookup_path = bor(fixed_lookup, grow_path);
        if lookup_path {
          let found = dense_map_lookup::<MapCostDenseKey, T, MapCostDigest, u64, fn MapCostElement::observe, 16384>(map: &map, key: &key, key_env: &env, visit_env: &digest);
          map_cost_lookup_result(found: found, digest: &digest);
        } else if path == 2_u64 {
          let next_round = round +wrap 1_u64;
          let shift = next_round *wrap count;
          let base = seed +wrap shift;
          let next = base +wrap index;
          let value = MapCostElement::make(seed: next);
          let replaced = dense_map_put::<MapCostDenseKey, T, 16384>(map: &map, key: key, value: move value, env: &env);
          match move replaced {
            DenseInserted() => {
              map_cost_ordered(env: &digest, value: 0_u64);
            }
            DenseReplaced(previous: pair) => {
              map_cost_ordered(env: &digest, value: 1_u64);
              let DensePair(key: old_key, value: old_value) = move pair;
              let content = MapCostElement::content(key: old_key, value: move old_value);
              map_cost_ordered(env: &digest, value: content);
            }
            DenseFull(offered: pair) => {
              map_cost_ordered(env: &digest, value: 2_u64);
              let DensePair(key: old_key, value: old_value) = move pair;
              let content = MapCostElement::content(key: old_key, value: move old_value);
              map_cost_ordered(env: &digest, value: content);
            }
          }
        } else if path == 3_u64 {
          let removed = dense_map_remove::<MapCostDenseKey, T, 16384>(map: &map, key: &key, env: &env);
          match move removed {
            Some(value: pair) => {
              map_cost_ordered(env: &digest, value: 1_u64);
              let DensePair(key: old_key, value: old_value) = move pair;
              let content = MapCostElement::content(key: old_key, value: move old_value);
              map_cost_ordered(env: &digest, value: content);
            }
            None() => {
              map_cost_ordered(env: &digest, value: 0_u64);
            }
          }
          let absent = dense_map_lookup::<MapCostDenseKey, T, MapCostDigest, u64, fn MapCostElement::observe, 16384>(map: &map, key: &key, key_env: &env, visit_env: &digest);
          map_cost_lookup_result(found: absent, digest: &digest);
          let next_round = round +wrap 1_u64;
          let shift = next_round *wrap count;
          let base = seed +wrap shift;
          let next = base +wrap index;
          let value = MapCostElement::make(seed: next);
          let inserted = dense_map_put::<MapCostDenseKey, T, 16384>(map: &map, key: key, value: move value, env: &env);
          match move inserted {
            DenseInserted() => {
              map_cost_ordered(env: &digest, value: 0_u64);
            }
            DenseReplaced(previous: pair) => {
              map_cost_ordered(env: &digest, value: 1_u64);
              let DensePair(key: old_key, value: old_value) = move pair;
              let content = MapCostElement::content(key: old_key, value: move old_value);
              map_cost_ordered(env: &digest, value: content);
            }
            DenseFull(offered: pair) => {
              map_cost_ordered(env: &digest, value: 2_u64);
              let DensePair(key: old_key, value: old_value) = move pair;
              let content = MapCostElement::content(key: old_key, value: move old_value);
              map_cost_ordered(env: &digest, value: content);
            }
          }
        } else if path == 7_u64 {
          let edited = dense_map_edit::<MapCostDenseKey, T, MapCostDigest, u64, fn MapCostElement::edit, 16384>(map: &map, key: &key, key_env: &env, edit_env: &digest);
          map_cost_lookup_result(found: edited, digest: &digest);
        }
      }
    }
  }
  dense_map_free::<u64, T, MapCostDigest, fn MapCostElement::consume, 16384>(map: move map, env: &digest);
  return map_cost_finish(digest: digest);
}

fn map_cost_dense_word_trace(capacity: u64, count: u64, rounds: u64, seed: u64, path: u64, collide: u64) -> result: u64 pure contract {
  requires capacity <= 8192_u64;
  requires count <= capacity;
} {
  return map_cost_dense_trace::<MapCostWord>(capacity: capacity, count: count, rounds: rounds, seed: seed, path: path, collide: collide);
}

fn map_cost_dense_record_trace(capacity: u64, count: u64, rounds: u64, seed: u64, path: u64, collide: u64) -> result: u64 pure contract {
  requires capacity <= 8192_u64;
  requires count <= capacity;
} {
  return map_cost_dense_trace::<MapCostWide>(capacity: capacity, count: count, rounds: rounds, seed: seed, path: path, collide: collide);
}

fn map_cost_sparse_trace<interface MapCostElement<T>>(capacity: u64, count: u64, rounds: u64, seed: u64, path: u64, collide: u64) -> result: u64 pure contract {
  requires capacity <= 8192_u64;
  requires count <= capacity;
} {
  let salt = ixor(seed, 11400714819323198485_u64);
  let colliding = collide != 0_u64;
  let env = MapCostEnv(salt: salt, collide: colliding);
  let map = sparse_map_new::<u64, T, 16384>(capacity: capacity);
  let digest = MapCostDigest(ordered: seed, sum: 0_u64, parity: 0_u64, count: 0_u64);
  for (index in 0_u64..count) {
    let key = map_cost_key(index: index);
    let next = seed +wrap index;
    let value = MapCostElement::make(seed: next);
    let inserted = sparse_map_put::<MapCostSparseKey, T, 16384>(map: &map, key: key, value: move value, env: &env);
    match move inserted {
      SparseInserted() => {
        map_cost_ordered(env: &digest, value: 0_u64);
      }
      SparseReplaced(previous: pair) => {
        map_cost_ordered(env: &digest, value: 1_u64);
        let SparsePair(key: old_key, value: old_value) = move pair;
        let content = MapCostElement::content(key: old_key, value: move old_value);
        map_cost_ordered(env: &digest, value: content);
      }
      SparseFull(offered: pair) => {
        map_cost_ordered(env: &digest, value: 2_u64);
        let SparsePair(key: old_key, value: old_value) = move pair;
        let content = MapCostElement::content(key: old_key, value: move old_value);
        map_cost_ordered(env: &digest, value: content);
      }
    }
  }
  for (round in 0_u64..rounds) {
    if path == 5_u64 {
      let lower_half = count / 2_u64;
      let removed_count = count - lower_half;
      for (removed_index in 0_u64..removed_count) {
        let index = removed_index *wrap 2_u64;
        let key = map_cost_key(index: index);
        let removed = sparse_map_remove::<MapCostSparseKey, T, 16384>(map: &map, key: &key, env: &env);
        match move removed {
          Some(value: pair) => {
            map_cost_ordered(env: &digest, value: 1_u64);
            let SparsePair(key: old_key, value: old_value) = move pair;
            let content = MapCostElement::content(key: old_key, value: move old_value);
            map_cost_ordered(env: &digest, value: content);
          }
          None() => {
            map_cost_ordered(env: &digest, value: 0_u64);
          }
        }
        let absent = sparse_map_lookup::<MapCostSparseKey, T, MapCostDigest, u64, fn MapCostElement::observe, 16384>(map: &map, key: &key, key_env: &env, visit_env: &digest);
        map_cost_lookup_result(found: absent, digest: &digest);
      }
      let rebuilt = sparse_map_rehash::<MapCostSparseKey, T, 16384>(map: &map, env: &env);
      map_cost_rebuild_result(result: rebuilt, digest: &digest);
      for (index in 0_u64..count) {
        let key = map_cost_key(index: index);
        let found = sparse_map_lookup::<MapCostSparseKey, T, MapCostDigest, u64, fn MapCostElement::observe, 16384>(map: &map, key: &key, key_env: &env, visit_env: &digest);
        map_cost_lookup_result(found: found, digest: &digest);
      }
      for (removed_index in 0_u64..removed_count) {
        let index = removed_index *wrap 2_u64;
        let key = map_cost_key(index: index);
        let next_round = round +wrap 1_u64;
        let shift = next_round *wrap count;
        let base = seed +wrap shift;
        let next = base +wrap index;
        let value = MapCostElement::make(seed: next);
        let inserted = sparse_map_put::<MapCostSparseKey, T, 16384>(map: &map, key: key, value: move value, env: &env);
        match move inserted {
          SparseInserted() => {
            map_cost_ordered(env: &digest, value: 0_u64);
          }
          SparseReplaced(previous: pair) => {
            map_cost_ordered(env: &digest, value: 1_u64);
            let SparsePair(key: old_key, value: old_value) = move pair;
            let content = MapCostElement::content(key: old_key, value: move old_value);
            map_cost_ordered(env: &digest, value: content);
          }
          SparseFull(offered: pair) => {
            map_cost_ordered(env: &digest, value: 2_u64);
            let SparsePair(key: old_key, value: old_value) = move pair;
            let content = MapCostElement::content(key: old_key, value: move old_value);
            map_cost_ordered(env: &digest, value: content);
          }
        }
      }
    } else {
      if path == 4_u64 {
        let target = 1_u64;
        if capacity != 0_u64 {
          set target = capacity * 2_u64;
        }
        let grown = sparse_map_reserve::<MapCostSparseKey, T, 16384>(map: &map, capacity: target, env: &env);
        map_cost_rebuild_result(result: grown, digest: &digest);
      }
      for (index in 0_u64..count) {
        let query_index = index;
        if path == 1_u64 {
          set query_index = count +wrap index;
        }
        let key = map_cost_key(index: query_index);
        let hit_path = path == 0_u64;
        let miss_path = path == 1_u64;
        let grow_path = path == 4_u64;
        let fixed_lookup = bor(hit_path, miss_path);
        let lookup_path = bor(fixed_lookup, grow_path);
        if lookup_path {
          let found = sparse_map_lookup::<MapCostSparseKey, T, MapCostDigest, u64, fn MapCostElement::observe, 16384>(map: &map, key: &key, key_env: &env, visit_env: &digest);
          map_cost_lookup_result(found: found, digest: &digest);
        } else if path == 2_u64 {
          let next_round = round +wrap 1_u64;
          let shift = next_round *wrap count;
          let base = seed +wrap shift;
          let next = base +wrap index;
          let value = MapCostElement::make(seed: next);
          let replaced = sparse_map_put::<MapCostSparseKey, T, 16384>(map: &map, key: key, value: move value, env: &env);
          match move replaced {
            SparseInserted() => {
              map_cost_ordered(env: &digest, value: 0_u64);
            }
            SparseReplaced(previous: pair) => {
              map_cost_ordered(env: &digest, value: 1_u64);
              let SparsePair(key: old_key, value: old_value) = move pair;
              let content = MapCostElement::content(key: old_key, value: move old_value);
              map_cost_ordered(env: &digest, value: content);
            }
            SparseFull(offered: pair) => {
              map_cost_ordered(env: &digest, value: 2_u64);
              let SparsePair(key: old_key, value: old_value) = move pair;
              let content = MapCostElement::content(key: old_key, value: move old_value);
              map_cost_ordered(env: &digest, value: content);
            }
          }
        } else if path == 3_u64 {
          let removed = sparse_map_remove::<MapCostSparseKey, T, 16384>(map: &map, key: &key, env: &env);
          match move removed {
            Some(value: pair) => {
              map_cost_ordered(env: &digest, value: 1_u64);
              let SparsePair(key: old_key, value: old_value) = move pair;
              let content = MapCostElement::content(key: old_key, value: move old_value);
              map_cost_ordered(env: &digest, value: content);
            }
            None() => {
              map_cost_ordered(env: &digest, value: 0_u64);
            }
          }
          let absent = sparse_map_lookup::<MapCostSparseKey, T, MapCostDigest, u64, fn MapCostElement::observe, 16384>(map: &map, key: &key, key_env: &env, visit_env: &digest);
          map_cost_lookup_result(found: absent, digest: &digest);
          let next_round = round +wrap 1_u64;
          let shift = next_round *wrap count;
          let base = seed +wrap shift;
          let next = base +wrap index;
          let value = MapCostElement::make(seed: next);
          let inserted = sparse_map_put::<MapCostSparseKey, T, 16384>(map: &map, key: key, value: move value, env: &env);
          match move inserted {
            SparseInserted() => {
              map_cost_ordered(env: &digest, value: 0_u64);
            }
            SparseReplaced(previous: pair) => {
              map_cost_ordered(env: &digest, value: 1_u64);
              let SparsePair(key: old_key, value: old_value) = move pair;
              let content = MapCostElement::content(key: old_key, value: move old_value);
              map_cost_ordered(env: &digest, value: content);
            }
            SparseFull(offered: pair) => {
              map_cost_ordered(env: &digest, value: 2_u64);
              let SparsePair(key: old_key, value: old_value) = move pair;
              let content = MapCostElement::content(key: old_key, value: move old_value);
              map_cost_ordered(env: &digest, value: content);
            }
          }
        } else if path == 7_u64 {
          let edited = sparse_map_edit::<MapCostSparseKey, T, MapCostDigest, u64, fn MapCostElement::edit, 16384>(map: &map, key: &key, key_env: &env, edit_env: &digest);
          map_cost_lookup_result(found: edited, digest: &digest);
        }
      }
    }
  }
  sparse_map_free::<u64, T, MapCostDigest, fn MapCostElement::consume, 16384>(map: move map, env: &digest);
  return map_cost_finish(digest: digest);
}

fn map_cost_sparse_word_trace(capacity: u64, count: u64, rounds: u64, seed: u64, path: u64, collide: u64) -> result: u64 pure contract {
  requires capacity <= 8192_u64;
  requires count <= capacity;
} {
  return map_cost_sparse_trace::<MapCostWord>(capacity: capacity, count: count, rounds: rounds, seed: seed, path: path, collide: collide);
}

