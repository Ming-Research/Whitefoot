struct SlotPair<K, V> {
  key: K;
  value: V;
}

struct SlotCell<K, V> {
  storage: Slots<SlotPair<K, V>, 1>;
  deleted: Bool;
}

enum SlotPut<K, V> {
  SlotInserted();
  SlotReplaced(previous: SlotPair<K, V>);
  SlotFull(offered: SlotPair<K, V>);
}

enum SlotAction {
  SlotStop();
  SlotSkip();
  SlotMiss();
  SlotMatch();
}

struct SlotMap<K, V, const ceiling: u64> {
  cells: Box<Slots<SlotCell<K, V>>>;
  length: u64;
}

interface SlotKey<K, E> {
  fn hash(env: &E, key: &K) -> hash: u64 reads(env), reads(key);
  fn equal(env: &E, left: &K, right: &K) -> equal: Bool reads(env), reads(left), reads(right);
}

interface SlotVisit<K, V, E, R> {
  fn visit(env: &E, key: &K, value: &V) -> result: R reads(key), reads(value), writes(env);
}

interface SlotConsume<K, V, E> {
  fn consume(env: &E, key: K, value: V) -> result: unit writes(env);
}

fn slot_map_extend<K, V, const ceiling: u64>(cells: &Box<Slots<SlotCell<K, V>>>, target: u64) -> result: unit writes(cells) contract {
  requires cells^.inner.len <= target;
  requires target <= ceiling;
  ensures cells^.inner.len == target;
  ensures cells^.inner.cap >= target;
} {
  if cells^.inner.cap < target {
    grow(cell: cells, capacity: target);
  }
  let start = cells^.inner.len;
  for @fill (
    index in start..target,
    invariant filled: cells^.inner.len >= index,
    invariant bounded: cells^.inner.len <= index,
    invariant spare: cells^.inner.cap - cells^.inner.len + index >= target
  ) {
    let storage = slots_new::<SlotPair<K, V>, 1>();
    let deleted = False();
    let vacant = SlotCell<K, V>(storage: move storage, deleted: deleted);
    place_back(window: &cells^.inner, value: move vacant);
  }
  invariant complete_min: cells^.inner.len >= target;
  invariant complete_max: cells^.inner.len <= target;
  return unit;
}

fn slot_map_new<K, V, const ceiling: u64>(capacity: u64) -> result: SlotMap<K, V, ceiling> pure contract {
  requires capacity <= ceiling;
} {
  doc "The caller keeps hash, equality and their per-call environment consistent while querying existing contents. Ownership, bounds and finite probing require no equality or hashing laws. Entries own K and V inline; neither needs a separate Box. A zero-capacity rebuild is a no-op and makes no allocation.";
  let cells = box_slots_new::<SlotCell<K, V>>(capacity: capacity);
  slot_map_extend::<K, V, ceiling>(cells: &cells, target: capacity);
  return SlotMap<K, V, ceiling>(cells: move cells, length: 0_u64);
}

fn slot_map_probe(home: u64, step: u64, count: u64) -> index: u64 pure contract {
  requires home < count;
  requires step < count;
  ensures index < count;
} {
  let remaining = count - home;
  if step >= remaining {
    let wrapped = step - remaining;
    return wrapped;
  }
  let straight = home + step;
  return straight;
}

fn slot_map_action<interface SlotKey<K, E>, V>(slot: &SlotCell<K, V>, key: &K, env: &E) -> result: SlotAction reads(slot), reads(key), reads(env) {
  if slot^.storage.len > 0_u64 {
    let equal = SlotKey::equal(env: env, left: &slot^.storage[0_u64].key, right: key);
    if equal {
      return SlotMatch();
    }
    return SlotMiss();
  }
  if slot^.deleted {
    return SlotSkip();
  }
  return SlotStop();
}

fn slot_map_find<interface SlotKey<K, E>, V, const ceiling: u64>(map: &SlotMap<K, V, ceiling>, key: &K, env: &E) -> result: Result<u64, unit> reads(map), reads(key), reads(env) contract {
  ensures when Ok(value: index): index < map^.cells.inner.len;
} {
  let hash = SlotKey::hash(env: env, key: key);
  let count = map^.cells.inner.len;
  for (step in 0_u64..count) {
    let home = hash % count;
    let index = slot_map_probe(home: home, step: step, count: count);
    let action = slot_map_action::<SlotKey<K, E>, V>(slot: &map^.cells.inner[index], key: key, env: env);
    match action {
      SlotMatch() => {
        return Ok<u64, unit>(value: index);
      }
      SlotStop() => {
        return Err<u64, unit>(error: unit);
      }
      SlotSkip() => {
      }
      SlotMiss() => {
      }
    }
  }
  return Err<u64, unit>(error: unit);
}

fn slot_map_read_at<interface SlotVisit<K, V, E, R>, const ceiling: u64>(map: &SlotMap<K, V, ceiling>, index: u64, env: &E) -> result: Result<R, unit> reads(map), writes(env) {
  if index < map^.cells.inner.len {
    if map^.cells.inner[index].storage.len > 0_u64 {
      let pair = &map^.cells.inner[index].storage[0_u64];
      let observed = SlotVisit::visit(env: env, key: &pair^.key, value: &pair^.value);
      return Ok<R, unit>(value: move observed);
    }
  }
  return Err<R, unit>(error: unit);
}

fn slot_map_lookup<interface SlotKey<K, E>, V, F, R, fn observe(env: &F, key: &K, value: &V) -> result: R reads(key), reads(value), writes(env), const ceiling: u64>(map: &SlotMap<K, V, ceiling>, key: &K, key_env: &E, visit_env: &F) -> result: Result<R, unit> reads(map), reads(key), reads(key_env), writes(visit_env) {
  let hash = SlotKey::hash(env: key_env, key: key);
  let count = map^.cells.inner.len;
  for (step in 0_u64..count) {
    let home = hash % count;
    let index = slot_map_probe(home: home, step: step, count: count);
    if map^.cells.inner[index].storage.len > 0_u64 {
      let pair = &map^.cells.inner[index].storage[0_u64];
      let equal = SlotKey::equal(env: key_env, left: &pair^.key, right: key);
      if equal {
        let observed = observe(env: visit_env, key: &pair^.key, value: &pair^.value);
        return Ok<R, unit>(value: move observed);
      }
    } else if map^.cells.inner[index].deleted {
    } else {
      return Err<R, unit>(error: unit);
    }
  }
  return Err<R, unit>(error: unit);
}

fn slot_map_edit<interface SlotKey<K, E>, V, F, R, fn update(env: &F, key: &K, value: &V) -> result: R reads(key), writes(env), writes(value), const ceiling: u64>(map: &SlotMap<K, V, ceiling>, key: &K, key_env: &E, edit_env: &F) -> result: Result<R, unit> reads(key), reads(key_env), writes(map), writes(edit_env) contract {
  ensures map^.cells.inner.len == entry(map)^.cells.inner.len;
  ensures map^.cells.inner.cap == entry(map)^.cells.inner.cap;
} {
  let hash = SlotKey::hash(env: key_env, key: key);
  let count = map^.cells.inner.len;
  for (step in 0_u64..count) {
    let home = hash % count;
    let index = slot_map_probe(home: home, step: step, count: count);
    if map^.cells.inner[index].storage.len > 0_u64 {
      let pair = &map^.cells.inner[index].storage[0_u64];
      let equal = SlotKey::equal(env: key_env, left: &pair^.key, right: key);
      if equal {
        let updated = update(env: edit_env, key: &pair^.key, value: &pair^.value);
        return Ok<R, unit>(value: move updated);
      }
    } else if map^.cells.inner[index].deleted {
    } else {
      return Err<R, unit>(error: unit);
    }
  }
  return Err<R, unit>(error: unit);
}

fn slot_map_exchange<K, V>(cells: &Box<Slots<SlotCell<K, V>>>, index: u64, key: K, value: V) -> result: SlotPut<K, V> writes(cells) contract {
  requires index < cells^.inner.len;
  ensures cells^.inner.len == entry(cells)^.inner.len;
  ensures cells^.inner.cap == entry(cells)^.inner.cap;
} {
  let offered = SlotPair<K, V>(key: move key, value: move value);
  if cells^.inner[index].storage.len > 0_u64 {
    swap(first: &cells^.inner[index].storage[0_u64], second: &offered);
    return SlotReplaced<K, V>(previous: move offered);
  }
  place_back(window: &cells^.inner[index].storage, value: move offered);
  set cells^.inner[index].deleted = False();
  return SlotInserted<K, V>();
}

fn slot_map_try_put<interface SlotKey<K, E>, V, const ceiling: u64>(map: &SlotMap<K, V, ceiling>, key: K, value: V, env: &E) -> result: SlotPut<K, V> reads(env), writes(map) contract {
  ensures map^.cells.inner.len == entry(map)^.cells.inner.len;
  ensures map^.cells.inner.cap == entry(map)^.cells.inner.cap;
} {
  let hash = SlotKey::hash(env: env, key: &key);
  let count = map^.cells.inner.len;
  let available = count;
  for @probe (step in 0_u64..count) {
    let home = hash % count;
    let index = slot_map_probe(home: home, step: step, count: count);
    let action = slot_map_action::<SlotKey<K, E>, V>(slot: &map^.cells.inner[index], key: &key, env: env);
    match action {
      SlotMatch() => {
        let replaced = slot_map_exchange::<K, V>(cells: &map^.cells, index: index, key: move key, value: move value);
        return move replaced;
      }
      SlotStop() => {
        if available == count {
          set available = index;
        }
        break @probe;
      }
      SlotSkip() => {
        if available == count {
          set available = index;
        }
      }
      SlotMiss() => {
      }
    }
  }
  if available < count {
    let before = map^.length;
    if before < ceiling {
      set map^.length = before + 1_u64;
      let inserted = slot_map_exchange::<K, V>(cells: &map^.cells, index: available, key: move key, value: move value);
      return move inserted;
    }
  }
  let offered = SlotPair<K, V>(key: move key, value: move value);
  return SlotFull<K, V>(offered: move offered);
}

fn slot_map_rebuild<interface SlotKey<K, E>, V, const ceiling: u64>(map: &SlotMap<K, V, ceiling>, capacity: u64, env: &E) -> result: Result<unit, unit> reads(env), writes(map) {
  doc "Refusal precedes every owner mutation. A fresh table of at least the old materialized extent has room for every old one-slot owner, independently of hash and equality laws. Migration hashes each live key once and never calls equality. The source-window loop exits on a checked zero length; one capacity-bounded scan always finds a vacancy because fewer than capacity owners have been moved. There is no migration Full arm and no discarded linear value.";
  if capacity > ceiling {
    return Err<unit, unit>(error: unit);
  }
  let old_count = map^.cells.inner.len;
  if capacity < old_count {
    return Err<unit, unit>(error: unit);
  }
  if capacity == 0_u64 {
    return Ok<unit, unit>(value: unit);
  }
  let previous = box_slots_new::<SlotCell<K, V>>(capacity: capacity);
  slot_map_extend::<K, V, ceiling>(cells: &previous, target: capacity);
  swap(first: &map^.cells, second: &previous);
  loop @old_cells {
    if previous.inner.len == 0_u64 {
      break @old_cells;
    }
    let cell = take_back(window: &previous.inner);
    let SlotCell(storage: source, deleted: old_deleted) = move cell;
    let hash = 0_u64;
    if source.len > 0_u64 {
      set hash = SlotKey::hash(env: env, key: &source[0_u64].key);
    }
    loop @owner {
      if source.len == 0_u64 {
        break @owner;
      }
      let count = map^.cells.inner.len;
      for @vacancy (step in 0_u64..count) {
        let home = hash % count;
        let index = slot_map_probe(home: home, step: step, count: count);
        if map^.cells.inner[index].storage.len == 0_u64 {
          append(destination: &map^.cells.inner[index].storage, source: &source);
          break @vacancy;
        }
      }
    }
    free_empty(window: move source);
  }
  free_empty(window: move previous);
  return Ok<unit, unit>(value: unit);
}

fn slot_map_reserve<interface SlotKey<K, E>, V, const ceiling: u64>(map: &SlotMap<K, V, ceiling>, capacity: u64, env: &E) -> result: Result<unit, unit> reads(env), writes(map) {
  if capacity > ceiling {
    return Err<unit, unit>(error: unit);
  }
  if capacity <= map^.cells.inner.len {
    return Ok<unit, unit>(value: unit);
  }
  let rebuilt = slot_map_rebuild::<SlotKey<K, E>, V, ceiling>(map: map, capacity: capacity, env: env);
  return rebuilt;
}

fn slot_map_rehash<interface SlotKey<K, E>, V, const ceiling: u64>(map: &SlotMap<K, V, ceiling>, env: &E) -> result: Result<unit, unit> reads(env), writes(map) {
  let capacity = map^.cells.inner.len;
  let rebuilt = slot_map_rebuild::<SlotKey<K, E>, V, ceiling>(map: map, capacity: capacity, env: env);
  return rebuilt;
}

fn slot_map_put<interface SlotKey<K, E>, V, const ceiling: u64>(map: &SlotMap<K, V, ceiling>, key: K, value: V, env: &E) -> result: SlotPut<K, V> reads(env), writes(map) {
  let attempted = slot_map_try_put::<SlotKey<K, E>, V, ceiling>(map: map, key: move key, value: move value, env: env);
  match attempted {
    SlotInserted() => {
      return SlotInserted<K, V>();
    }
    SlotReplaced(previous: old_pair) => {
      return SlotReplaced<K, V>(previous: move old_pair);
    }
    SlotFull(offered: new_pair) => {
      let count = map^.cells.inner.len;
      if count >= ceiling {
        return SlotFull<K, V>(offered: move new_pair);
      }
      let capacity = ceiling;
      if count == 0_u64 {
        set capacity = 1_u64;
      } else if count <= 9223372036854775807_u64 {
        let doubled = count + count;
        if doubled <= ceiling {
          set capacity = doubled;
        }
      }
      let grown = slot_map_reserve::<SlotKey<K, E>, V, ceiling>(map: map, capacity: capacity, env: env);
      match grown {
        Ok(value: success) => {
          let SlotPair(key: retry_key, value: retry_value) = move new_pair;
          let retried = slot_map_try_put::<SlotKey<K, E>, V, ceiling>(map: map, key: move retry_key, value: move retry_value, env: env);
          return move retried;
        }
        Err(error: refused) => {
          return SlotFull<K, V>(offered: move new_pair);
        }
      }
    }
  }
}

fn slot_map_remove<interface SlotKey<K, E>, V, const ceiling: u64>(map: &SlotMap<K, V, ceiling>, key: &K, env: &E) -> result: Option<SlotPair<K, V>> reads(key), reads(env), writes(map) {
  let before = map^.length;
  if before == 0_u64 {
    return None<SlotPair<K, V>>();
  }
  let found = slot_map_find::<SlotKey<K, E>, V, ceiling>(map: map, key: key, env: env);
  match found {
    Ok(value: index) => {
      if map^.cells.inner[index].storage.len > 0_u64 {
        let removed = take_back(window: &map^.cells.inner[index].storage);
        set map^.cells.inner[index].deleted = True();
        set map^.length = before - 1_u64;
        return Some<SlotPair<K, V>>(value: move removed);
      }
      return None<SlotPair<K, V>>();
    }
    Err(error: missing) => {
      return None<SlotPair<K, V>>();
    }
  }
}

fn slot_map_each<K, V, E, fn visit(env: &E, key: &K, value: &V) -> result: unit reads(key), reads(value), writes(env), const ceiling: u64>(map: &SlotMap<K, V, ceiling>, env: &E) -> result: unit reads(map), writes(env) {
  let count = map^.cells.inner.len;
  for (index in 0_u64..count) {
    if map^.cells.inner[index].storage.len > 0_u64 {
      let pair = &map^.cells.inner[index].storage[0_u64];
      visit(env: env, key: &pair^.key, value: &pair^.value);
    }
  }
  return unit;
}

fn slot_pair_consume<interface SlotConsume<K, V, E>>(pair: SlotPair<K, V>, env: &E) -> result: unit writes(env) {
  let SlotPair(key: saved_key, value: saved_value) = move pair;
  SlotConsume::consume(env: env, key: move saved_key, value: move saved_value);
  return unit;
}

fn slot_map_free<interface SlotConsume<K, V, E>, const ceiling: u64>(map: SlotMap<K, V, ceiling>, env: &E) -> result: unit writes(env) {
  let SlotMap(cells: cells, length: live) = move map;
  loop @cleanup {
    if cells.inner.len == 0_u64 {
      break @cleanup;
    }
    let cell = take_back(window: &cells.inner);
    let SlotCell(storage: storage, deleted: deleted) = move cell;
    if storage.len > 0_u64 {
      let pair = take_back(window: &storage);
      slot_pair_consume::<SlotConsume<K, V, E>>(pair: move pair, env: env);
    }
    free_empty(window: move storage);
  }
  free_empty(window: move cells);
  return unit;
}
