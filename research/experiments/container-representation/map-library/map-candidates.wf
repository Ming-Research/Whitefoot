        let absent = sparse_map_lookup::<MapCostSparseKey, T, MapCostDigest, u64, fn MapCostElement::observe, 16384>(map: &map, key: &key, key_env: &env, visit_env: &digest);
        map_cost_lookup_result(found: absent, digest: &digest);
      }
      let rebuilt = sparse_map_rehash::<MapCostSparseKey, T, 16384>(map: &map, env: &env);
      map_cost_rebuild_result(result: rebuilt, digest: &digest);
      for (index in 0_u64..count) {
        let key = map_cost_key(index: index);
        let found = sparse_map_lookup::<MapCostSparseKey, T, MapCostDigest, u64, fn MapCostElement::observe, 16384>(map: &map, key: &key, key_env: &env, visit_env: &digest);
        map_cost_lookup_result(found: found, digest: &digest);
      }
      for (removed_index in 0_u64..removed_count) {
        let index = removed_index *wrap 2_u64;
        let key = map_cost_key(index: index);
        let next_round = round +wrap 1_u64;
        let shift = next_round *wrap count;
        let base = seed +wrap shift;
        let next = base +wrap index;
        let value = MapCostElement::make(seed: next);
        let inserted = sparse_map_put::<MapCostSparseKey, T, 16384>(map: &map, key: key, value: move value, env: &env);
        match move inserted {
          SparseInserted() => {
