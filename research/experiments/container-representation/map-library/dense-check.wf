struct DenseHashEnv {
  hostile: Bool;
}

struct DenseTestSeen {
  failures: u64;
  consumed: u64;
  key_sum: u64;
  value_sum: u64;
  visits: u64;
  observed: u64;
}

nodrop struct DenseTicket {
  id: u64;
}

fn dense_test_fail(seen: &DenseTestSeen) -> result: unit writes(seen) {
  set deref(seen).failures = deref(seen).failures +wrap 1_u64;
  return unit;
}

fn dense_scalar_hash(env: &DenseHashEnv, key: &u64) -> result: u64 reads(key) {
  return deref(key) % 1_u64;
}

fn dense_scalar_equal(env: &DenseHashEnv, left: &u64, right: &u64) -> result: Bool reads(env), reads(left), reads(right) {
  if deref(env).hostile {
    return False();
  }
  return deref(left) == deref(right);
}

binding DenseScalarKey : DenseKey<u64, DenseHashEnv> {
  hash = dense_scalar_hash;
  equal = dense_scalar_equal;
}

fn dense_ticket_hash(env: &DenseHashEnv, key: &DenseTicket) -> result: u64 reads(key) {
  return deref(key).id % 1_u64;
}

fn dense_ticket_equal(env: &DenseHashEnv, left: &DenseTicket, right: &DenseTicket) -> result: Bool reads(env), reads(left), reads(right) {
  if deref(env).hostile {
    return False();
  }
  return deref(left).id == deref(right).id;
}

binding DenseTicketKey : DenseKey<DenseTicket, DenseHashEnv> {
  hash = dense_ticket_hash;
  equal = dense_ticket_equal;
}

fn dense_scalar_read(env: &DenseTestSeen, key: &u64, value: &u64) -> result: u64 reads(value), writes(env) {
  set deref(env).visits = deref(env).visits +wrap 1_u64;
  set deref(env).observed = deref(env).observed +wrap deref(value);
  return deref(value);
}

fn dense_scalar_visit(env: &DenseTestSeen, key: &u64, value: &u64) -> result: unit reads(value), writes(env) {
  let observed = dense_scalar_read(env: env, key: key, value: value);
  return unit;
}

fn dense_scalar_increment(env: &DenseTestSeen, key: &u64, value: &u64) -> result: u64 writes(env), writes(value) {
  set deref(env).visits = deref(env).visits +wrap 1_u64;
  set deref(value) = deref(value) +wrap 1_u64;
  return deref(value);
}

fn dense_ticket_read(env: &DenseTestSeen, key: &DenseTicket, value: &DenseTicket) -> result: u64 reads(value), writes(env) {
  set deref(env).visits = deref(env).visits +wrap 1_u64;
  set deref(env).observed = deref(env).observed +wrap deref(value).id;
  return deref(value).id;
}

fn dense_ticket_visit(env: &DenseTestSeen, key: &DenseTicket, value: &DenseTicket) -> result: unit reads(value), writes(env) {
  let observed = dense_ticket_read(env: env, key: key, value: value);
  return unit;
}

binding DenseScalarVisit : DenseVisit<u64, u64, DenseTestSeen, u64> {
  visit = dense_scalar_read;
}

binding DenseTicketVisit : DenseVisit<DenseTicket, DenseTicket, DenseTestSeen, u64> {
  visit = dense_ticket_read;
}

fn dense_scalar_consume(env: &DenseTestSeen, key: u64, value: u64) -> result: unit writes(env) {
  set deref(env).consumed = deref(env).consumed +wrap 1_u64;
  set deref(env).key_sum = deref(env).key_sum +wrap key;
  set deref(env).value_sum = deref(env).value_sum +wrap value;
  return unit;
}

fn dense_ticket_consume(env: &DenseTestSeen, key: DenseTicket, value: DenseTicket) -> result: unit writes(env) {
  let DenseTicket(id: key_id) = move key;
  let DenseTicket(id: value_id) = move value;
  dense_scalar_consume(env: env, key: key_id, value: value_id);
  return unit;
}

binding DenseScalarConsume : DenseConsume<u64, u64, DenseTestSeen> {
  consume = dense_scalar_consume;
}

binding DenseTicketConsume : DenseConsume<DenseTicket, DenseTicket, DenseTestSeen> {
  consume = dense_ticket_consume;
}

fn dense_scalar_outcome(outcome: DensePut<u64, u64>, expected: u64, key: u64, value: u64, seen: &DenseTestSeen) -> result: unit writes(seen) {
  match outcome {
    DenseInserted() => {
      if expected != 0_u64 {
        dense_test_fail(seen: seen);
      }
    }
    DenseReplaced(previous: pair) => {
      if expected != 1_u64 {
        dense_test_fail(seen: seen);
      }
      if pair.key != key {
        dense_test_fail(seen: seen);
      }
      if pair.value != value {
        dense_test_fail(seen: seen);
      }
      dense_pair_consume::<DenseScalarConsume>(pair: pair, env: seen);
    }
    DenseFull(offered: pair) => {
      if expected != 2_u64 {
        dense_test_fail(seen: seen);
      }
      if pair.key != key {
        dense_test_fail(seen: seen);
      }
      if pair.value != value {
        dense_test_fail(seen: seen);
      }
      dense_pair_consume::<DenseScalarConsume>(pair: pair, env: seen);
    }
  }
  return unit;
}

fn dense_ticket_outcome(outcome: DensePut<DenseTicket, DenseTicket>, expected: u64, key: u64, value: u64, seen: &DenseTestSeen) -> result: unit writes(seen) {
  match outcome {
    DenseInserted() => {
      if expected != 0_u64 {
        dense_test_fail(seen: seen);
      }
    }
    DenseReplaced(previous: pair) => {
      if expected != 1_u64 {
        dense_test_fail(seen: seen);
      }
      if pair.key.id != key {
        dense_test_fail(seen: seen);
      }
      if pair.value.id != value {
        dense_test_fail(seen: seen);
      }
      dense_pair_consume::<DenseTicketConsume>(pair: move pair, env: seen);
    }
    DenseFull(offered: pair) => {
      if expected != 2_u64 {
        dense_test_fail(seen: seen);
      }
      if pair.key.id != key {
        dense_test_fail(seen: seen);
      }
      if pair.value.id != value {
        dense_test_fail(seen: seen);
      }
      dense_pair_consume::<DenseTicketConsume>(pair: move pair, env: seen);
    }
  }
  return unit;
}

fn dense_check_reserve(outcome: Result<unit, unit>, expected: Bool, seen: &DenseTestSeen) -> result: unit writes(seen) {
  match outcome {
    Ok(value: success) => {
      if expected {
      } else {
        dense_test_fail(seen: seen);
      }
    }
    Err(error: refused) => {
      if expected {
        dense_test_fail(seen: seen);
      }
    }
  }
  return unit;
}

fn dense_test_tickets() -> result: u64 pure {
  let seen = DenseTestSeen(failures: 0_u64, consumed: 0_u64, key_sum: 0_u64, value_sum: 0_u64, visits: 0_u64, observed: 0_u64);
  let false_value = False();
  let true_value = True();
  let env = DenseHashEnv(hostile: false_value);
  let map = dense_map_new::<DenseTicket, DenseTicket, 4>(capacity: 0_u64);
  for (key in 1_u64..5_u64) {
    let value = key * 11_u64;
    let key_ticket = DenseTicket(id: key);
    let value_ticket = DenseTicket(id: value);
    let offered = dense_map_put::<DenseTicketKey, DenseTicket, 4>(map: &map, key: move key_ticket, value: move value_ticket, env: &env);
    dense_ticket_outcome(outcome: move offered, expected: 0_u64, key: key, value: value, seen: &seen);
  }
  if map.entries.inner.len != 4_u64 {
    dense_test_fail(seen: &seen);
  }
  if map.indexes.inner.len != 4_u64 {
    dense_test_fail(seen: &seen);
  }
  let refused_key = DenseTicket(id: 5_u64);
  let refused_value = DenseTicket(id: 55_u64);
  let refused = dense_map_put::<DenseTicketKey, DenseTicket, 4>(map: &map, key: move refused_key, value: move refused_value, env: &env);
  dense_ticket_outcome(outcome: move refused, expected: 2_u64, key: 5_u64, value: 55_u64, seen: &seen);
  let replacement_key = DenseTicket(id: 2_u64);
  let replacement_value = DenseTicket(id: 222_u64);
  let replaced = dense_map_put::<DenseTicketKey, DenseTicket, 4>(map: &map, key: move replacement_key, value: move replacement_value, env: &env);
  dense_ticket_outcome(outcome: move replaced, expected: 1_u64, key: 2_u64, value: 22_u64, seen: &seen);
  let first_query = DenseTicket(id: 1_u64);
  let removed = dense_map_remove::<DenseTicketKey, DenseTicket, 4>(map: &map, key: &first_query, env: &env);
  let DenseTicket(id: first_query_id) = move first_query;
  match removed {
    Some(value: pair) => {
      if pair.key.id != 1_u64 {
        dense_test_fail(seen: &seen);
      }
      if pair.value.id != 11_u64 {
        dense_test_fail(seen: &seen);
      }
      dense_pair_consume::<DenseTicketConsume>(pair: move pair, env: &seen);
    }
    None() => {
      dense_test_fail(seen: &seen);
    }
  }
  let moved_query = DenseTicket(id: 4_u64);
  let moved = dense_map_lookup::<DenseTicketKey, DenseTicket, DenseTestSeen, u64, fn dense_ticket_read, 4>(map: &map, key: &moved_query, key_env: &env, visit_env: &seen);
  let DenseTicket(id: moved_query_id) = move moved_query;
  match moved {
    Ok(value: found_value) => {
      if found_value != 44_u64 {
        dense_test_fail(seen: &seen);
      }
    }
    Err(error: absent) => {
      dense_test_fail(seen: &seen);
    }
  }
  let reused_key = DenseTicket(id: 6_u64);
  let reused_value = DenseTicket(id: 66_u64);
  let reused = dense_map_put::<DenseTicketKey, DenseTicket, 4>(map: &map, key: move reused_key, value: move reused_value, env: &env);
  dense_ticket_outcome(outcome: move reused, expected: 0_u64, key: 6_u64, value: 66_u64, seen: &seen);
  let too_large = dense_map_reserve::<DenseTicketKey, DenseTicket, 4>(map: &map, capacity: 8_u64, env: &env);
  dense_check_reserve(outcome: too_large, expected: false_value, seen: &seen);
  let too_small_plan = dense_map_rebuild::<DenseTicketKey, DenseTicket, 4>(map: &map, capacity: 1_u64, env: &env);
  dense_check_reserve(outcome: too_small_plan, expected: false_value, seen: &seen);
  if map.entries.inner.len != 4_u64 {
    dense_test_fail(seen: &seen);
  }
  if map.indexes.inner.len != 4_u64 {
    dense_test_fail(seen: &seen);
  }
  let tombstone_query = DenseTicket(id: 3_u64);
  let tombstone_owner = dense_map_remove::<DenseTicketKey, DenseTicket, 4>(map: &map, key: &tombstone_query, env: &env);
  let DenseTicket(id: tombstone_query_id) = move tombstone_query;
  match tombstone_owner {
    Some(value: removed_pair) => {
      if removed_pair.key.id != 3_u64 {
        dense_test_fail(seen: &seen);
      }
      if removed_pair.value.id != 33_u64 {
        dense_test_fail(seen: &seen);
      }
      dense_pair_consume::<DenseTicketConsume>(pair: move removed_pair, env: &seen);
    }
    None() => {
      dense_test_fail(seen: &seen);
    }
  }
  let compacted = dense_map_rehash::<DenseTicketKey, DenseTicket, 4>(map: &map, env: &env);
  dense_check_reserve(outcome: compacted, expected: true_value, seen: &seen);
  dense_map_each::<DenseTicket, DenseTicket, DenseTestSeen, fn dense_ticket_visit, 4>(map: &map, env: &seen);
  if seen.visits != 4_u64 {
    dense_test_fail(seen: &seen);
  }
  if seen.observed != 376_u64 {
    dense_test_fail(seen: &seen);
  }
  dense_map_free::<DenseTicketConsume, 4>(map: move map, env: &seen);
  if seen.consumed != 7_u64 {
    dense_test_fail(seen: &seen);
  }
  if seen.key_sum != 23_u64 {
    dense_test_fail(seen: &seen);
  }
  if seen.value_sum != 453_u64 {
    dense_test_fail(seen: &seen);
  }
  return seen.failures;
}

fn dense_test_scalars() -> result: u64 pure {
  let seen = DenseTestSeen(failures: 0_u64, consumed: 0_u64, key_sum: 0_u64, value_sum: 0_u64, visits: 0_u64, observed: 0_u64);
  let true_value = True();
  let env = DenseHashEnv(hostile: true_value);
  let map = dense_map_new::<u64, u64, 8>(capacity: 2_u64);
  let first = dense_map_put::<DenseScalarKey, u64, 8>(map: &map, key: 7_u64, value: 70_u64, env: &env);
  dense_scalar_outcome(outcome: first, expected: 0_u64, key: 7_u64, value: 70_u64, seen: &seen);
  let second = dense_map_put::<DenseScalarKey, u64, 8>(map: &map, key: 7_u64, value: 71_u64, env: &env);
  dense_scalar_outcome(outcome: second, expected: 0_u64, key: 7_u64, value: 71_u64, seen: &seen);
  if map.entries.inner.len != 2_u64 {
    dense_test_fail(seen: &seen);
  }
  if map.indexes.inner.len != 2_u64 {
    dense_test_fail(seen: &seen);
  }
  let hostile_key = 7_u64;
  let missing = dense_map_lookup::<DenseScalarKey, u64, DenseTestSeen, u64, fn dense_scalar_read, 8>(map: &map, key: &hostile_key, key_env: &env, visit_env: &seen);
  match missing {
    Ok(value: unexpected_value) => {
      dense_test_fail(seen: &seen);
    }
    Err(error: absent) => {
    }
  }
  let removed = dense_map_remove::<DenseScalarKey, u64, 8>(map: &map, key: &hostile_key, env: &env);
  match removed {
    Some(value: unexpected_pair) => {
      dense_test_fail(seen: &seen);
      dense_pair_consume::<DenseScalarConsume>(pair: unexpected_pair, env: &seen);
    }
    None() => {
    }
  }
  if seen.visits != 0_u64 {
    dense_test_fail(seen: &seen);
  }
  if seen.observed != 0_u64 {
    dense_test_fail(seen: &seen);
  }
  if seen.consumed != 0_u64 {
    dense_test_fail(seen: &seen);
  }
  if map.entries.inner.len != 2_u64 {
    dense_test_fail(seen: &seen);
  }
  let larger = dense_map_reserve::<DenseScalarKey, u64, 8>(map: &map, capacity: 4_u64, env: &env);
  dense_check_reserve(outcome: larger, expected: true_value, seen: &seen);
  let compacted = dense_map_rehash::<DenseScalarKey, u64, 8>(map: &map, env: &env);
  dense_check_reserve(outcome: compacted, expected: true_value, seen: &seen);
  if map.entries.inner.len != 2_u64 {
    dense_test_fail(seen: &seen);
  }
  if map.entries.inner.cap != 4_u64 {
    dense_test_fail(seen: &seen);
  }
  if map.indexes.inner.len != 4_u64 {
    dense_test_fail(seen: &seen);
  }
  dense_map_each::<u64, u64, DenseTestSeen, fn dense_scalar_visit, 8>(map: &map, env: &seen);
  if seen.observed != 141_u64 {
    dense_test_fail(seen: &seen);
  }
  let observed = dense_map_read_at::<DenseScalarVisit, 8>(map: &map, index: 0_u64, env: &seen);
  match observed {
    Ok(value: found_value) => {
      if found_value != 70_u64 {
        dense_test_fail(seen: &seen);
      }
    }
    Err(error: absent) => {
      dense_test_fail(seen: &seen);
    }
  }
  dense_map_free::<DenseScalarConsume, 8>(map: move map, env: &seen);
  if seen.consumed != 2_u64 {
    dense_test_fail(seen: &seen);
  }
  if seen.key_sum != 14_u64 {
    dense_test_fail(seen: &seen);
  }
  if seen.value_sum != 141_u64 {
    dense_test_fail(seen: &seen);
  }
  let zero = dense_map_new::<u64, u64, 0>(capacity: 0_u64);
  let refused = dense_map_put::<DenseScalarKey, u64, 0>(map: &zero, key: 9_u64, value: 90_u64, env: &env);
  dense_scalar_outcome(outcome: refused, expected: 2_u64, key: 9_u64, value: 90_u64, seen: &seen);
  dense_map_free::<DenseScalarConsume, 0>(map: move zero, env: &seen);
  return seen.failures;
}

fn dense_identity_hash(env: &DenseHashEnv, key: &u64) -> result: u64 reads(key) {
  return deref(key);
}

binding DenseIdentityKey : DenseKey<u64, DenseHashEnv> {
  hash = dense_identity_hash;
  equal = dense_scalar_equal;
}

fn dense_scalar_expect(map: &DenseMap<u64, u64, 8>, key: u64, expected: u64, env: &DenseHashEnv, seen: &DenseTestSeen) -> result: unit reads(map), reads(env), writes(seen) {
  let observed = dense_map_lookup::<DenseIdentityKey, u64, DenseTestSeen, u64, fn dense_scalar_read, 8>(map: map, key: &key, key_env: env, visit_env: seen);
  match observed {
    Ok(value: found_value) => {
      if found_value != expected {
        dense_test_fail(seen: seen);
      }
    }
    Err(error: absent) => {
      dense_test_fail(seen: seen);
    }
  }
  return unit;
}

fn dense_test_wrapping() -> result: u64 pure {
  let seen = DenseTestSeen(failures: 0_u64, consumed: 0_u64, key_sum: 0_u64, value_sum: 0_u64, visits: 0_u64, observed: 0_u64);
  let false_value = False();
  let true_value = True();
  let env = DenseHashEnv(hostile: false_value);
  let map = dense_map_new::<u64, u64, 8>(capacity: 4_u64);
  let first = dense_map_put::<DenseIdentityKey, u64, 8>(map: &map, key: 3_u64, value: 30_u64, env: &env);
  dense_scalar_outcome(outcome: first, expected: 0_u64, key: 3_u64, value: 30_u64, seen: &seen);
  let second = dense_map_put::<DenseIdentityKey, u64, 8>(map: &map, key: 7_u64, value: 70_u64, env: &env);
  dense_scalar_outcome(outcome: second, expected: 0_u64, key: 7_u64, value: 70_u64, seen: &seen);
  let third = dense_map_put::<DenseIdentityKey, u64, 8>(map: &map, key: 11_u64, value: 110_u64, env: &env);
  dense_scalar_outcome(outcome: third, expected: 0_u64, key: 11_u64, value: 110_u64, seen: &seen);
  let removed_key = 3_u64;
  let removed = dense_map_remove::<DenseIdentityKey, u64, 8>(map: &map, key: &removed_key, env: &env);
  match removed {
    Some(value: old_pair) => {
      if old_pair.key != 3_u64 {
        dense_test_fail(seen: &seen);
      }
      if old_pair.value != 30_u64 {
        dense_test_fail(seen: &seen);
      }
      dense_pair_consume::<DenseScalarConsume>(pair: old_pair, env: &seen);
    }
    None() => {
      dense_test_fail(seen: &seen);
    }
  }
  let replaced = dense_map_put::<DenseIdentityKey, u64, 8>(map: &map, key: 7_u64, value: 700_u64, env: &env);
  dense_scalar_outcome(outcome: replaced, expected: 1_u64, key: 7_u64, value: 70_u64, seen: &seen);
  dense_scalar_expect(map: &map, key: 7_u64, expected: 700_u64, env: &env, seen: &seen);
  dense_scalar_expect(map: &map, key: 11_u64, expected: 110_u64, env: &env, seen: &seen);
  let rebuilt = dense_map_rehash::<DenseIdentityKey, u64, 8>(map: &map, env: &env);
  dense_check_reserve(outcome: rebuilt, expected: true_value, seen: &seen);
  dense_scalar_expect(map: &map, key: 7_u64, expected: 700_u64, env: &env, seen: &seen);
  dense_scalar_expect(map: &map, key: 11_u64, expected: 110_u64, env: &env, seen: &seen);
  let grown = dense_map_reserve::<DenseIdentityKey, u64, 8>(map: &map, capacity: 8_u64, env: &env);
  dense_check_reserve(outcome: grown, expected: true_value, seen: &seen);
  dense_scalar_expect(map: &map, key: 7_u64, expected: 700_u64, env: &env, seen: &seen);
  dense_scalar_expect(map: &map, key: 11_u64, expected: 110_u64, env: &env, seen: &seen);
  dense_map_free::<DenseScalarConsume, 8>(map: move map, env: &seen);
  if seen.consumed != 4_u64 {
    dense_test_fail(seen: &seen);
  }
  if seen.key_sum != 28_u64 {
    dense_test_fail(seen: &seen);
  }
  if seen.value_sum != 910_u64 {
    dense_test_fail(seen: &seen);
  }
  if seen.visits != 6_u64 {
    dense_test_fail(seen: &seen);
  }
  return seen.failures;
}

fn dense_test_counted_contract() -> result: u64 pure {
  let seen = DenseTestSeen(failures: 0_u64, consumed: 0_u64, key_sum: 0_u64, value_sum: 0_u64, visits: 0_u64, observed: 0_u64);
  let false_value = False();
  let env = DenseHashEnv(hostile: false_value);
  let map = dense_map_new::<u64, u64, 4>(capacity: 4_u64);
  if map.entries.inner.len == 0_u64 {
    let reserved = map.entries.inner.cap;
    let table_count = map.indexes.inner.len;
    for (
      index in 0_u64..4_u64,
      invariant length_bound: map.entries.inner.len <= index,
      invariant reserved_unchanged: map.entries.inner.cap == reserved,
      invariant table_unchanged: map.indexes.inner.len == table_count
    ) {
      let inserted = dense_map_try_put::<DenseScalarKey, u64, 4>(map: &map, key: index, value: index, env: &env);
      dense_scalar_outcome(outcome: inserted, expected: 0_u64, key: index, value: index, seen: &seen);
    }
    invariant total_bound: map.entries.inner.len <= 4_u64;
    invariant retained_capacity: map.entries.inner.cap == reserved;
    invariant retained_table: map.indexes.inner.len == table_count;
    let before_edit = map.entries.inner.len;
    let edit_key = 0_u64;
    let edited = dense_map_edit::<DenseScalarKey, u64, DenseTestSeen, u64, fn dense_scalar_increment, 4>(map: &map, key: &edit_key, key_env: &env, edit_env: &seen);
    invariant edited_length: map.entries.inner.len == before_edit;
    invariant edited_capacity: map.entries.inner.cap == reserved;
    invariant edited_table: map.indexes.inner.len == table_count;
    match edited {
      Ok(value: reached) => {
        if reached != 1_u64 {
          dense_test_fail(seen: &seen);
        }
      }
      Err(error: missing) => {
        dense_test_fail(seen: &seen);
      }
    }
  } else {
    dense_test_fail(seen: &seen);
  }
  dense_map_free::<DenseScalarConsume, 4>(map: move map, env: &seen);
  if seen.visits != 1_u64 {
    dense_test_fail(seen: &seen);
  }
  return seen.failures;
}

fn main() -> status: ExitStatus pure {
  let scalar_failures = dense_test_scalars();
  let ticket_failures = dense_test_tickets();
  let wrapping_failures = dense_test_wrapping();
  let counted_failures = dense_test_counted_contract();
  if scalar_failures == 0_u64 {
    if ticket_failures == 0_u64 {
      if wrapping_failures == 0_u64 {
        if counted_failures == 0_u64 {
          return exit_status(code: 0_u8);
        }
      }
    }
  }
  return exit_status(code: 1_u8);
}
