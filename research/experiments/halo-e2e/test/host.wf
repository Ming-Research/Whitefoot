struct Env { db: Value; types: Value; expiry: Value; error: Bool; line: u64; }

fn raw(vm: &Vm, table: Value, key: Value, value: Value) -> r: unit writes(vm) {
  let written = halo::heap::table_set(heap: &vm^.heap, t: table, key: key, val: value); return unit;
}
fn get(vm: &Vm, table: Value, key: Value) -> r: Value reads(vm) { return halo::heap::table_get(heap: &vm^.heap, t: table, key: key); }
fn literal(vm: &Vm, text: &[u8]) -> r: Value reads(text), writes(vm) { return halo::heap::intern(heap: &vm^.heap, bytes: text); }
fn num(x: f64) -> r: Value pure { return Value::Num(n: x); }
fn kind(v: Value) -> r: u8 pure { return halo::embed::kind(value: v); }
fn is_nil(v: Value) -> r: Bool pure { let k = kind(v: v); return k == 0_u8; }
fn is_string(v: Value) -> r: Bool pure { let k = kind(v: v); return k == 3_u8; }
fn arg(stack: &Box<Slots<Value>>, func: u64, argc: u64, index: u64) -> r: Value reads(stack) {
