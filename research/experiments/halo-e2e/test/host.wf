fn number(vm: &Vm, v: Value) -> r: f64 reads(vm) {
  match num_of(v: v) { Is(x: n) => {return n;} Not() => {} }
  match halo::heap::string_of(heap: &vm^.heap, value: v) {
    None() => {}
    Some(value: view) => { let h = cvt::<u32,u64>(view.handle); if h < vm^.heap.strings.inner.len { let n = vm^.heap.strings.inner[h].payload.bytes.inner.len; match halo::number::str2number(bytes: &vm^.heap.strings.inner[h].payload.bytes.inner[0_u64..n]) { Some(value: x) => {return x;} None() => {} } } }
  }
  return 0.0_f64;
}
fn equals_text(vm: &Vm, value: Value, text: &[u8]) -> r: Bool reads(vm), reads(text) {
  match halo::heap::string_of(heap: &vm^.heap, value: value) {
    None() => {return False();}
    Some(value: view) => {
      let h = cvt::<u32,u64>(view.handle);
      if h < vm^.heap.strings.inner.len {
        if vm^.heap.strings.inner[h].payload.bytes.inner.len == text^.len {
          for (i in 0_u64..text^.len) {
