fn redis_raised(vm: &Vm, message: Value) -> r: Value writes(vm) {
  doc "Redis's replacement pcall unwraps an error table to its err string. Apply that conversion when the nearest active protection will catch this host error.";
  let i = vm^.frames.inner.len;
  loop {
    if i == 0_u64 {
      break;
    }
    set i = i - 1_u64;
    if i < vm^.frames.inner.len {
      let frame = vm^.frames.inner[i];
      if frame.activation != vm^.activation {
        break;
      }
      if frame.flags == protected_flag {
        return message;
      }
    }
  }
  return reply_table(vm: vm, field: &s_30[0_u64..3_u64], v: message);
}

