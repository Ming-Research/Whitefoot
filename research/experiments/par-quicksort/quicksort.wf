fn quicksort(v: &[u64]) -> result: unit writes(v) {
  let n = deref(v).len;
  if n <= 1_u64 {
    return unit;
  }
  let p = partition(v: v);
  let after = p + 1_u64;
  let smaller = &deref(v)[0_u64..p];
  let larger = &deref(v)[after..n];
  quicksort(v: smaller);
  quicksort(v: larger);
  return unit;
}

fn partition(v: &[u64]) -> pivot_at: u64 writes(v) contract {
  requires deref(v).len >= 2_u64;
  ensures pivot_at < deref(v).len;
} {
  let n = deref(v).len;
  let last = n - 1_u64;
  let pivot = deref(v)[last];
  let store = 0_u64;
  for (
    i in 0_u64..last,
    invariant behind: store <= i
  ) {
    let x = deref(v)[i];
    if x < pivot {
      let displaced = deref(v)[store];
      set deref(v)[store] = x;
      set deref(v)[i] = displaced;
      set store = store + 1_u64;
    }
  }
  let moved = deref(v)[store];
  set deref(v)[store] = pivot;
  set deref(v)[last] = moved;
  return store;
}

fn fill(v: &[u64]) -> result: unit writes(v) {
  let state = 88172645463325252_u64;
  for (i in 0_u64..deref(v).len) {
    let a = ishl.wrap(state, 13_u32);
    set state = ixor(state, a);
    let b = ishr.wrap(state, 7_u32);
    set state = ixor(state, b);
    let c = ishl.wrap(state, 17_u32);
    set state = ixor(state, c);
    set deref(v)[i] = state;
  }
  return unit;
}

fn sorted(v: &[u64]) -> ok: Bool reads(v) {
  let n = deref(v).len;
  if n <= 1_u64 {
    return True();
  }
  let last = n - 1_u64;
  for (i in 0_u64..last) {
    let next = i + 1_u64;
    let a = deref(v)[i];
    let b = deref(v)[next];
    if a > b {
      return False();
    }
  }
  return True();
}

fn main() -> status: std::process::ExitStatus pure {
  let data = box_array_filled::<u64>(count: 2000000_u64, value: 0_u64);
  let all = &data.inner[0_u64..2000000_u64];
  fill(v: all);
  quicksort(v: all);
  let ok = sorted(v: all);
  if ok {
    return std::process::exit_status(code: 0_u8);
  }
  return std::process::exit_status(code: 1_u8);
}
