fn mark(cells: &Box<Array<u64>>, salt: u64) -> result: unit writes(cells) contract {
  requires 3_u64 <= cells^.inner.len;
} {
  for (i in 0_u64..3_u64) {
    set cells^.inner[i] = i +wrap salt;
  }
  return unit;
}

fn workload(repetitions: u64, extent: u64, seed: u64) -> result: u64 pure {
  let cells = box_array_filled::<u64>(count: 4096_u64, value: 0_u64);
  let n = 0_u64;
  loop @walk {
    if n == repetitions {
      break @walk;
    }
    if 3_u64 <= cells.inner.len {
      let salt = n +wrap seed;
      let done = mark(cells: &cells, salt: salt);
    }
    set n = n +wrap 1_u64;
  }
  let checksum = 0_u64;
  let at = 0_u64;
  loop @read {
    if at >= cells.inner.len {
      break @read;
    }
    set checksum = checksum +wrap cells.inner[at];
    set at = at +wrap 1_u64;
  }
  return checksum;
}
