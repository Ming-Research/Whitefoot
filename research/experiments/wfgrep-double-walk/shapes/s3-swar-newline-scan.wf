fn io_class(error: own IoError) -> result: own u8 pure {
  doc "Reduces one portable IoError class to the distinctions wfgrep reports.";
  match error {
    NotFound(code: c, origin: o) => {
      return 1_u8;
    }
    PermissionDenied(code: c, origin: o) => {
      return 2_u8;
    }
    AlreadyExists(code: c, origin: o) => {
      return 9_u8;
    }
    NotDirectory(code: c, origin: o) => {
      return 9_u8;
    }
    IsDirectory(code: c, origin: o) => {
      return 3_u8;
    }
    DirectoryNotEmpty(code: c, origin: o) => {
      return 9_u8;
    }
    ReadOnly(code: c, origin: o) => {
      return 9_u8;
    }
    ResourceBusy(code: c, origin: o) => {
      return 9_u8;
    }
    InvalidInput(code: c, origin: o) => {
      return 9_u8;
    }
    InvalidPath(code: c, origin: o) => {
      return 9_u8;
    }
    Unsupported(code: c, origin: o) => {
      return 9_u8;
    }
    TimedOut(code: c, origin: o) => {
      return 9_u8;
    }
    BrokenPipe(code: c, origin: o) => {
      return 4_u8;
    }
    WriteZero(code: c, origin: o) => {
      return 9_u8;
    }
    UnexpectedEnd(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionRefused(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionReset(code: c, origin: o) => {
      return 9_u8;
    }
    ConnectionAborted(code: c, origin: o) => {
      return 9_u8;
    }
    NotConnected(code: c, origin: o) => {
      return 9_u8;
    }
    AddressInUse(code: c, origin: o) => {
      return 9_u8;
    }
    AddressUnavailable(code: c, origin: o) => {
      return 9_u8;
    }
    ResourceExhausted(code: c, origin: o) => {
      return 9_u8;
    }
    FileTooLarge(code: c, origin: o) => {
      return 9_u8;
    }
    NoSpace(code: c, origin: o) => {
      return 9_u8;
    }
    QuotaExceeded(code: c, origin: o) => {
      return 9_u8;
    }
    CrossDevice(code: c, origin: o) => {
      return 9_u8;
    }
    DeviceFailure(code: c, origin: o) => {
      return 9_u8;
    }
    Other(code: c, origin: o) => {
      return 9_u8;
    }
  }
}

fn append_slice(destination: &uniq MutSlice<u8>, filled: own u64, text: own Slice<u8>) -> result: own u64 reads(destination, text), writes(destination) contract {
  define capacity = len_of(deref(destination));
  ensures result <= capacity;
  ensures len_of(deref(destination)) == len_of(deref(entry(destination)));
} {
  doc "Appends as much of one static message as the destination still holds.";
  let capacity = len_of(deref(destination));
  let admitted = filled <= capacity;
  let length = len_of(text);
  if admitted {
    for @append (at in filled..capacity) {
      let taken = at -wrap filled;
      let done = taken >= length;
      if done {
        return at;
      }
      let byte = text[taken];
      set deref(destination)[at] = byte;
    }
    return capacity;
  } else {
    return capacity;
  }
}

fn copy_range(destination: &uniq MutSlice<u8>, at: own u64, source: &buffer<u8>, from: own u64, to: own u64) -> result: own u64 reads(destination, source), writes(destination) contract {
  define destination_room = len_of(deref(destination));
  ensures result <= destination_room;
  ensures len_of(deref(destination)) == len_of(deref(entry(destination)));
} {
  doc "Copies one half-open source range into the destination at one offset.";
  let source_room = len_of(deref(source));
  let destination_room = len_of(deref(destination));
  let admitted = at <= destination_room;
  if admitted {
  } else {
    return destination_room;
  }
  let target = at;
  let cursor = from;
  loop @copy {
    let done = cursor >= to;
    if done {
      break @copy;
    }
    let read_ok = cursor < source_room;
    if read_ok {
    } else {
      let target_fits = target <= destination_room;
      if target_fits {
        return target;
      } else {
        return destination_room;
      }
    }
    let byte = deref(source)[cursor];
    let write_ok = target < destination_room;
    if write_ok {
    } else {
      return destination_room;
    }
    set deref(destination)[target] = byte;
    set target = target +wrap 1_u64;
    set cursor = cursor +wrap 1_u64;
  }
  let target_fits = target <= destination_room;
  if target_fits {
    return target;
  } else {
    return destination_room;
  }
}

fn line_matches(source: &buffer<u8>, start: own u64, stop: own u64, pattern: &buffer<u8>, length: own u64) -> result: own Bool reads(source, pattern) {
  doc "Reports whether the literal pattern bytes occur in one line's byte range.";
  let source_room = len_of(deref(source));
  let pattern_room = len_of(deref(pattern));
  let ordered = start <= stop;
  if ordered {
  } else {
    return False();
  }
  let source_fits = stop <= source_room;
  if source_fits {
  } else {
    return False();
  }
  let pattern_fits = length <= pattern_room;
  if pattern_fits {
  } else {
    return False();
  }
  let empty = length == 0_u64;
  if empty {
    return True();
  }
  let span = stop -wrap start;
  let fits = span >= length;
  if fits {
  } else {
    return False();
  }
  let last = span -wrap length;
  let offset = 0_u64;
  loop @candidates {
    let past = offset > last;
    if past {
      break @candidates;
    }
    let base = start +wrap offset;
    let base_ok = base < source_room;
    if base_ok {
    } else {
      return False();
    }
    let probe = 0_u64;
    let same = True();
    loop @compare {
      let done = probe >= length;
      if done {
        break @compare;
      }
      let position = base +wrap probe;
      let position_ok = position < source_room;
      if position_ok {
      } else {
        set same = False();
        break @compare;
      }
      let probe_ok = probe < pattern_room;
      if probe_ok {
      } else {
        set same = False();
        break @compare;
      }
      let left = deref(source)[position];
      let right = deref(pattern)[probe];
      let equal = left == right;
      if equal {
      } else {
        set same = False();
        break @compare;
      }
      set probe = probe +wrap 1_u64;
    }
    if same {
      return True();
    }
    set offset = offset +wrap 1_u64;
  }
  return False();
}

fn publish_all(factory: &uniq HandleFactory, output: &uniq OutputStream, source: &Slice<u8>, length: own u64) -> result: own Result<unit, IoError> reads(factory, output, source), writes(factory, output) contract {
  define source_length = len_of(deref(source));
  requires length <= source_length;
} {
  doc "Publishes one prefix of the source view, reattempting until the host has accepted every byte or refused it.";
  let sent = 0_u64;
  region {
    loop @publish {
      let pending = sent < length;
      if pending {
      } else {
        break @publish;
      }
      region {
        match write_once(factory: &uniq deref(factory), output: &uniq deref(output), source: source, start: sent, end: length) {
          Ok(value: written) => {
            set sent = written;
          }
          Err(error: problem) => {
            return Err<unit, IoError>(error: move problem);
          }
        }
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn report_failure(factory: &uniq HandleFactory, args: &Args, err: &uniq OutputStream, report: &uniq MutSlice<u8>, status: own u8, position: own u64) -> result: own unit reads(factory, args, err, report), writes(factory, err, report) contract {
  define report_room = len_of(deref(report));
  requires 256_u64 <= report_room;
  ensures len_of(deref(report)) == len_of(deref(entry(report)));
} {
  doc "Assembles one `wfgrep: NAME: reason` diagnostic in the reusable report buffer and publishes it to standard error.";
  let length = 0_u64;
  region {
    let view = slice_of(&error_prefix);
    region {
      set length = append_slice(destination: &uniq deref(report), filled: length, text: view);
    }
  }
  match arg_get(args: args, position: position) {
    Ok(value: text) => {
      let name_start_ok = length <= 256_u64;
      if name_start_ok {
        region {
          match host_copy_bytes(value: &text, destination: &uniq deref(report), start: length, end: 256_u64) {
            Ok(value: copied) => {
              set length = copied;
            }
            Err(error: too_small) => {
            }
          }
        }
      }
    }
    Err(error: absent) => {
    }
  }
  region {
    let view = slice_of(&error_separator);
    region {
      set length = append_slice(destination: &uniq deref(report), filled: length, text: view);
    }
  }
  let named = 0_u8;
  if status == 1_u8 {
    set named = 1_u8;
    region {
      let view = slice_of(&reason_missing);
      region {
        set length = append_slice(destination: &uniq deref(report), filled: length, text: view);
      }
    }
  }
  if status == 2_u8 {
    set named = 1_u8;
    region {
      let view = slice_of(&reason_denied);
      region {
        set length = append_slice(destination: &uniq deref(report), filled: length, text: view);
      }
    }
  }
  if status == 3_u8 {
    set named = 1_u8;
    region {
      let view = slice_of(&reason_directory);
      region {
        set length = append_slice(destination: &uniq deref(report), filled: length, text: view);
      }
    }
  }
  if status == 5_u8 {
    set named = 1_u8;
    region {
      let view = slice_of(&reason_invalid_path);
      region {
        set length = append_slice(destination: &uniq deref(report), filled: length, text: view);
      }
    }
  }
  if status == 6_u8 {
    set named = 1_u8;
    region {
      let view = slice_of(&reason_long_line);
      region {
        set length = append_slice(destination: &uniq deref(report), filled: length, text: view);
      }
    }
  }
  if named == 0_u8 {
    region {
      let view = slice_of(&reason_unreadable);
      region {
        set length = append_slice(destination: &uniq deref(report), filled: length, text: view);
      }
    }
  }
  region {
    let publish_window_1 = slice_of(&deref(report));
    region {
      match publish_all(factory: &uniq deref(factory), output: &uniq deref(err), source: &publish_window_1, length: length) {
        Ok(value: published) => {
        }
        Err(error: problem) => {
        }
      }
    }
  }
  return unit;
}

fn exercise(args: &Args, cwd: &DirectoryRead, out: &uniq OutputStream, err: &uniq OutputStream, files: &uniq HandleFactory) -> status: own ExitStatus reads(args, cwd, out, err, files), writes(out, err, files) {
  doc "Publishes every line of every named file that contains the literal pattern bytes; 0 matched, 1 none, 2 error.";
  let input = buffer_new(4096_u64, 0_u8);
  let batch = buffer_new(4096_u64, 0_u8);
  let pattern = buffer_new(4096_u64, 0_u8);
  let report = buffer_new(512_u64, 0_u8);
  let arguments = 0_u64;
  region {
    set arguments = args_count(args: args);
  }
  let startup = 0_u8;
  let pattern_length = 0_u64;
  let usable = arguments >= 3_u64;
  if usable {
    region {
      match arg_get(args: args, position: 1_u64) {
        Ok(value: text) => {
          region {
            let native_window_185 = mut_slice_of(&uniq pattern);
            region {
              match host_copy_bytes(value: &text, destination: &uniq native_window_185, start: 0_u64, end: 4096_u64) {
                Ok(value: copied) => {
                  set pattern_length = copied;
                }
                Err(error: too_small) => {
                  set startup = 2_u8;
                }
              }
            }
          }
        }
        Err(error: absent) => {
          set startup = 1_u8;
        }
      }
    }
  } else {
    set startup = 1_u8;
  }
  if startup == 0_u8 {
  } else {
    let length = 0_u64;
    if startup == 1_u8 {
      region {
        let view = slice_of(&usage_text);
        region {
          let byte_window_1 = mut_slice_of(&uniq report);
          region {
            set length = append_slice(destination: &uniq byte_window_1, filled: length, text: view);
          }
        }
      }
    } else {
      region {
        let view = slice_of(&reason_pattern_too_long);
        region {
          let byte_window_2 = mut_slice_of(&uniq report);
          region {
            set length = append_slice(destination: &uniq byte_window_2, filled: length, text: view);
          }
        }
      }
    }
    region {
      let publish_window_2 = slice_of(&report);
      region {
        match publish_all(factory: &uniq deref(files), output: &uniq deref(err), source: &publish_window_2, length: length) {
          Ok(value: published) => {
          }
          Err(error: problem) => {
          }
        }
      }
    }
    return exit_status(code: 2_u8);
  }
  let failed = 0_u8;
  let matched = 0_u8;
  let filled = 0_u64;
  let write_failed = 0_u8;
  let write_class = 0_u8;
  let position = 2_u64;
  loop @files {
    let more = position < arguments;
    if more {
    } else {
      break @files;
    }
    let status = 0_u8;
    region {
      match arg_get(args: args, position: position) {
        Ok(value: text) => {
          match relative_path(value: move text) {
            Ok(value: path) => {
              region {
                match open_read(factory: &uniq deref(files), root: cwd, path: &path) {
                  Ok(value: file) => {
                    let carry = 0_u64;
                    let file_offset = 0_u64;
                    loop @chunks {
                      let carry_fits = carry < 4096_u64;
                      if carry_fits {
                      } else {
                        set status = 6_u8;
                        break @chunks;
                      }
                      let room = 4096_u64 -wrap carry;
                      let overlong = room == 0_u64;
                      if overlong {
                        set status = 6_u8;
                        break @chunks;
                      }
                      let available = 0_u64;
                      let ended = 0_u8;
                      region {
                        let native_window_186 = mut_slice_of(&uniq input);
                        region {
                          match read_at(factory: &uniq deref(files), file: &uniq file, destination: &uniq native_window_186, file_offset: file_offset, start: carry, end: 4096_u64) {
                            Ok(value: taken) => {
                              set available = taken;
                              let delivered = taken -wrap carry;
                              set file_offset = file_offset +wrap delivered;
                            }
                            Err(error: read_stop_184) => {
                              match read_stop_184 {
                                ReadEnd() => {
                                  set ended = 1_u8;
                                }
                                ReadFailed(error: problem) => {
                                  set status = io_class(error: move problem);
                                  set ended = 2_u8;
                                }
                              }
                            }
                          }
                        }
                      }
                      if ended == 2_u8 {
                        break @chunks;
                      }
                      if ended == 1_u8 {
                        let trailing = carry > 0_u64;
                        if trailing {
                          set input[carry] = 10_u8;
                          set available = carry +wrap 1_u64;
                        }
                      }
                      let available_fits = available <= 4096_u64;
                      if available_fits {
                      } else {
                        set status = 6_u8;
                        break @chunks;
                      }
                      let scan = 0_u64;
                      loop @lines {
                        let terminator = available;
                        let probe = scan;
                        loop @findword {
                          let probe_word_fits = probe <= 4088_u64;
                          if probe_word_fits {
                          } else {
                            break @findword;
                          }
                          let next = probe + 8_u64;
                          let roomy = next <= available;
                          if roomy {
                          } else {
                            break @findword;
                          }
                          let byte0 = input[probe];
                          let at1 = probe + 1_u64;
                          let byte1 = input[at1];
                          let at2 = probe + 2_u64;
                          let byte2 = input[at2];
                          let at3 = probe + 3_u64;
                          let byte3 = input[at3];
                          let at4 = probe + 4_u64;
                          let byte4 = input[at4];
                          let at5 = probe + 5_u64;
                          let byte5 = input[at5];
                          let at6 = probe + 6_u64;
                          let byte6 = input[at6];
                          let at7 = probe + 7_u64;
                          let byte7 = input[at7];
                          let wide0 = cvt::<u8, u64>(byte0);
                          let wide1 = cvt::<u8, u64>(byte1);
                          let wide2 = cvt::<u8, u64>(byte2);
                          let wide3 = cvt::<u8, u64>(byte3);
                          let wide4 = cvt::<u8, u64>(byte4);
                          let wide5 = cvt::<u8, u64>(byte5);
                          let wide6 = cvt::<u8, u64>(byte6);
                          let wide7 = cvt::<u8, u64>(byte7);
                          let lane1 = ishl.wrap(wide1, 8_u32);
                          let lane2 = ishl.wrap(wide2, 16_u32);
                          let lane3 = ishl.wrap(wide3, 24_u32);
                          let lane4 = ishl.wrap(wide4, 32_u32);
                          let lane5 = ishl.wrap(wide5, 40_u32);
                          let lane6 = ishl.wrap(wide6, 48_u32);
                          let lane7 = ishl.wrap(wide7, 56_u32);
                          let pair01 = ior(wide0, lane1);
                          let pair23 = ior(lane2, lane3);
                          let pair45 = ior(lane4, lane5);
                          let pair67 = ior(lane6, lane7);
                          let quad03 = ior(pair01, pair23);
                          let quad47 = ior(pair45, pair67);
                          let word = ior(quad03, quad47);
                          let marked = ixor(word, 723401728380766730_u64);
                          let borrowed = marked -wrap 72340172838076673_u64;
                          let inverted = inot(marked);
                          let carried = iand(borrowed, inverted);
                          let hits = iand(carried, 9259542123273814144_u64);
                          let found = hits != 0_u64;
                          if found {
                            break @findword;
                          }
                          set probe = next;
                        }
                        loop @find {
                          let done = probe >= available;
                          if done {
                            break @find;
                          }
                          let byte = input[probe];
                          let newline = byte == 10_u8;
                          if newline {
                            set terminator = probe;
                            break @find;
                          }
                          set probe = probe +wrap 1_u64;
                        }
                        let complete = terminator < available;
                        if complete {
                        } else {
                          break @lines;
                        }
                        let hit = False();
                        region {
                          set hit = line_matches(source: &input, start: scan, stop: terminator, pattern: &pattern, length: pattern_length);
                        }
                        if hit {
                          set matched = 1_u8;
                          let stop = terminator +wrap 1_u64;
                          let span = stop -wrap scan;
                          let need = filled +wrap span;
                          let overfull = need > 4096_u64;
                          if overfull {
                            let filled_fits = filled <= 4096_u64;
                            if filled_fits {
                              region {
                                let publish_window_3 = slice_of(&batch);
                                region {
                                  match publish_all(factory: &uniq deref(files), output: &uniq deref(out), source: &publish_window_3, length: filled) {
                                    Ok(value: published) => {
                                    }
                                    Err(error: problem) => {
                                      set write_failed = 1_u8;
                                      set write_class = io_class(error: move problem);
                                    }
                                  }
                                }
                              }
                            } else {
                              set write_failed = 1_u8;
                            }
                            set filled = 0_u64;
                          }
                          if write_failed == 0_u8 {
                            region {
                              region {
                                let byte_window_3 = mut_slice_of(&uniq batch);
                                region {
                                  set filled = copy_range(destination: &uniq byte_window_3, at: filled, source: &input, from: scan, to: stop);
                                }
                              }
                            }
                          } else {
                            region {
                              close_read(factory: &uniq deref(files), file: move file);
                            }
                            break @files;
                          }
                        }
                        set scan = terminator +wrap 1_u64;
                      }
                      if ended == 1_u8 {
                        break @chunks;
                      }
                      let tail = available -wrap scan;
                      let moved = 0_u64;
                      loop @shift {
                        let done = moved >= tail;
                        if done {
                          break @shift;
                        }
                        let source_index = scan +wrap moved;
                        let source_fits = source_index < 4096_u64;
                        let target_fits = moved < 4096_u64;
                        if source_fits {
                        } else {
                          break @shift;
                        }
                        if target_fits {
                        } else {
                          break @shift;
                        }
                        let byte = input[source_index];
                        set input[moved] = byte;
                        set moved = moved +wrap 1_u64;
                      }
                      set carry = tail;
                    }
                    close_read(factory: &uniq deref(files), file: move file);
                  }
                  Err(error: problem) => {
                    set status = io_class(error: move problem);
                  }
                }
              }
            }
            Err(error: rejected) => {
              set status = 5_u8;
            }
          }
        }
        Err(error: absent) => {
          set status = 9_u8;
        }
      }
    }
    let reportable = status != 0_u8;
    if reportable {
      set failed = 1_u8;
      region {
        region {
          let byte_window_4 = mut_slice_of(&uniq report);
          region {
            report_failure(factory: &uniq deref(files), args: args, err: &uniq deref(err), report: &uniq byte_window_4, status: status, position: position);
          }
        }
      }
    }
    set position = position +wrap 1_u64;
  }
  if write_failed == 0_u8 {
    let filled_fits = filled <= 4096_u64;
    if filled_fits {
      region {
        let publish_window_4 = slice_of(&batch);
        region {
          match publish_all(factory: &uniq deref(files), output: &uniq deref(out), source: &publish_window_4, length: filled) {
            Ok(value: published) => {
            }
            Err(error: problem) => {
              set write_failed = 1_u8;
              set write_class = io_class(error: move problem);
            }
          }
        }
      }
    } else {
      set write_failed = 1_u8;
    }
  }
  if write_failed == 0_u8 {
  } else {
    set failed = 1_u8;
    let length = 0_u64;
    if write_class == 4_u8 {
      region {
        let view = slice_of(&reason_broken_pipe);
        region {
          let byte_window_5 = mut_slice_of(&uniq report);
          region {
            set length = append_slice(destination: &uniq byte_window_5, filled: length, text: view);
          }
        }
      }
    } else {
      region {
        let view = slice_of(&reason_write_error);
        region {
          let byte_window_6 = mut_slice_of(&uniq report);
          region {
            set length = append_slice(destination: &uniq byte_window_6, filled: length, text: view);
          }
        }
      }
    }
    region {
      let publish_window_5 = slice_of(&report);
      region {
        match publish_all(factory: &uniq deref(files), output: &uniq deref(err), source: &publish_window_5, length: length) {
          Ok(value: published) => {
          }
          Err(error: problem) => {
          }
        }
      }
    }
  }
  if failed == 0_u8 {
  } else {
    return exit_status(code: 2_u8);
  }
  if matched == 0_u8 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}

fn main(inputs: own Inputs) -> status: own ExitStatus pure {
  doc "PRE-1 ordinary Inputs are destructured once; the borrowed operation chain returns before the initial directory is explicitly closed on every exit.";
  let Inputs(args: args, cwd: cwd, stdout: out, stderr: err, handles: files, stdin: unused_stdin, ..) = move inputs;
  region {
    let outcome = exercise(args: &args, cwd: &cwd, out: &uniq out, err: &uniq err, files: &uniq files);
    close_directory(factory: &uniq files, directory: move cwd);
    return move outcome;
  }
}
