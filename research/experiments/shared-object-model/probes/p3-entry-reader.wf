// Class 3 probe (shared-object-model): a value read from a concurrent hash
// map's entry carries its type invariant. Board item expectation under the
// unified design: accepted. Predicted today: rejected at the subtraction
// (only a whole struct target is sealed at block entry).
const name: Array<u8, 1> =[97_u8];

struct Window {
  next: u64;
  len: u64;
  invariant(w): w^.next <= w^.len;
}

fn remaining(w: &Window) -> result: u64 reads(w) {
  let r = w^.len - w^.next;
  return r;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let store = shared_map_new::<Window>(capacity: 0_u64);
  let key = &name[0_u64..1_u64];
  atomic e = &store[key] {
    set e^ = Some<Window>(value: Window(next: 1_u64, len: 4_u64));
  }
  let out = 0_u64;
  atomic e = &store[key] {
    match e^ {
      Some(value: w) => {
        set out = remaining(w: w);
      }
      None() => {
      }
    }
  }
  if out != 3_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
