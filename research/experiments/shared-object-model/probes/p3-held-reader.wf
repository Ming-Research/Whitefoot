// Class 3 probe (shared-object-model): a shared object's whole state, held by
// an atomic statement, carries its type invariant. Expected today: accepted
// (TYPE-11 seals a whole struct target at block entry).
struct Window {
  next: u64;
  len: u64;
  invariant(w): w^.next <= w^.len;
}

fn remaining(w: &Window) -> result: u64 reads(w) {
  let r = w^.len - w^.next;
  return r;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let w = Window(next: 1_u64, len: 4_u64);
  let h = shared_new::<Window>(value: w);
  let out = 0_u64;
  atomic s = &h {
    set out = remaining(w: s);
  }
  if out != 3_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
