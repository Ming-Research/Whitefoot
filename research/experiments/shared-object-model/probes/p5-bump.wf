// Class 5 probe (shared-object-model): a function whose row is pure but which
// changes shared state. Expected today: accepted only with `waits`, which
// EFF-3 excludes from deduplication and reordering.
fn bump(counter: Shared<u8>) -> result: unit pure waits {
  atomic count = &counter {
    set count^ = count^ +wrap 1_u8;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let c = shared_new::<u8>(value: 1_u8);
  let d = shared_share::<u8>(shared: &c);
  bump(counter: d);
  return std::process::exit_status(code: 0_u8);
}
