struct Window {
  next: u64;
  len: u64;
  invariant ordered(w): w.next <= w.len;
}

fn remaining(w: &Window) -> result: u64 reads(w) {
  let r = w^.len - w^.next;
  return r;
}

fn reader(f: &Frozen<Window>) -> result: u64 reads(f) {
  let r = remaining(w: &f^.inner);
  return r;
}

fn main() -> status: std::process::ExitStatus pure {
  let w = Window(next: 1_u64, len: 4_u64);
  let f = frozen_new::<Window>(value: w);
  let r = reader(f: &f);
  if r != 3_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
