struct Pair {
  first: u8;
  second: u8;
}

fn bump_both(first: &u8, second: &u8) -> result: unit writes(first), writes(second) {
  set first^ = first^ +wrap 1_u8;
  set second^ = second^ +wrap 1_u8;
  return unit;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let pair = Pair(first: 2_u8, second: 3_u8);
  let h = shared_new::<Pair>(value: pair);
  atomic s = &h {
    bump_both(first: &s^.first, second: &s^.second);
  }
  return std::process::exit_status(code: 0_u8);
}
