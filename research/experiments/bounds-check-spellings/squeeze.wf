fn squeeze(buf: &[u8]) -> kept: u64 writes(buf) {
  let kept = 0_u64;
  for (
    i in 0_u64..deref(buf).len,
    invariant behind: kept <= i
  ) {
    let byte = deref(buf)[i];
    if byte != 32_u8 {
      set deref(buf)[kept] = byte;
      set kept = kept + 1_u64;
    }
  }
  return kept;
}

fn main() -> status: ExitStatus pure {
  let data = box_array_filled::<u8>(count: 5_u64, value: 32_u8);
  let text = &data.inner[0_u64..5_u64];
  set deref(text)[1_u64] = 104_u8;
  set deref(text)[3_u64] = 105_u8;
  let kept = squeeze(buf: text);
  let first = deref(text)[0_u64];
  let second = deref(text)[1_u64];
  if kept != 2_u64 {
    return exit_status(code: 1_u8);
  }
  if first != 104_u8 {
    return exit_status(code: 1_u8);
  }
  if second != 105_u8 {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
