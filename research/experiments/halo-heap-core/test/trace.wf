  set keys[107_u64] = v11;
  let n12 = reinterpret::<u64, f64>(4746794007248502784_u64);
  let v12 = Value::Num(n: n12);
  set keys[108_u64] = v12;
  let n13 = reinterpret::<u64, f64>(13970166044103278592_u64);
