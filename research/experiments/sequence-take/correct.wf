alias Clock = std::time::Clock;
alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias Instant = std::time::Instant;

const sq_name_c2: Array<u8, 4> =[99_u8, 95_u8, 116_u8, 50_u8];

const sq_name_cbad: Array<u8, 6> =[99_u8, 95_u8, 116_u8, 98_u8, 97_u8, 100_u8];

struct SqRec {
  doc "One statement's record: its key, the value it wrote, its number, and the clock readings taken just before it began and just after it completed, in nanoseconds from the gate's opening.";
  key: u64;
  value: u64;
  number: u64;
  before: u64;
  after: u64;
}

struct SqLog {
  doc "Every context's records, appended once when its loop ends.";
  log: Slots<SqRec, 32768>;
}

fn sq_log_new() -> result: Shared<SqLog> pure {
  doc "An empty merged log.";
  let log = slots_new::<SqRec, 32768>();
  let holder = SqLog(log: move log);
  return shared_new::<SqLog>(value: move holder);
}

fn sq_check_context(table: Shared<ConcurrentHashMap<u64>>, part: Shared<SqPart>, seq: Shared<u64>, collected: Shared<SqLog>, totals: Shared<Totals>, gate: Shared<Gate>, clock: Clock, index: u64, numbering: u8) -> result: unit pure waits {
  doc "One context of a correctness run: up to 512 atomic statements, each preceded and followed by a clock reading and recorded. Numbering 0 is T2's, from the shared sequence inside the statement; numbering 1 is Tbad's, the context's index times 2^40 plus its own count, with T0's statement.";
  let deadline = gate_pass(gate: &gate, clock: &clock);
  let base = gate_base(gate: &gate, clock: &clock);
  let state = index;
  let count = 0_u64;
  let mine = slots_new::<SqRec, 512>();
  loop @run {
    set state = step(state: state);
    let high = ishr.wrap(state, 33_u32);
    let key = high % 100000_u64;
    let bytes = sq_key_bytes(key: key);
    let view = &bytes[0_u64..8_u64];
    let origin = ishl.wrap(index, 32_u32);
    let stored = ior(origin, count);
    let number = 0_u64;
    let exhausted = False();
    let first = std::time::now(clock: &clock);
    let before = std::time::nanoseconds_from(earlier: base, later: first);
    if numbering == 0_u8 {
      atomic slot = &table[view], p = &part, s = &seq {
        let current = s^;
        let record = sq_record(key: key, number: current);
        match current +checked 1_u64 {
          Ok(value: next) => {
            set s^ = next;
            set number = current;
            set slot^ = Some<u64>(value: stored);
            let ring_at = p^.pos % 4096_u64;
            set p^.ring[ring_at] = record;
            set p^.pos = p^.pos +wrap 1_u64;
          }
          Err(error: overflow) => {
            set exhausted = True();
          }
        }
      }
    } else {
      let own = ishl.wrap(index, 40_u32);
      let numbered = ior(own, count);
      let record = sq_record(key: key, number: numbered);
      atomic slot = &table[view], p = &part {
        set slot^ = Some<u64>(value: stored);
        let ring_at = p^.pos % 4096_u64;
        set p^.ring[ring_at] = record;
        set p^.pos = p^.pos +wrap 1_u64;
      }
      set number = numbered;
    }
    let second = std::time::now(clock: &clock);
    let after = std::time::nanoseconds_from(earlier: base, later: second);
    if exhausted {
      break @run;
    }
    if mine.len < mine.cap {
      let logged = SqRec(key: key, value: stored, number: number, before: before, after: after);
      place_back(window: &mine, value: logged);
    }
    set count = count +wrap 1_u64;
    if mine.len >= mine.cap {
      break @run;
    }
    if std::time::instant_reached(deadline: deadline, instant: second) {
      break @run;
    }
  }
  atomic c = &collected {
    for @merge (at in 0_u64..mine.len) {
      if c^.log.len < c^.log.cap {
        place_back(window: &c^.log, value: mine[at]);
      }
    }
  }
  tally(totals: &totals, done: count, state: state);
  return unit;
}

fn sq_check_start(numbering: u8, table: &Shared<ConcurrentHashMap<u64>>, seq: &Shared<u64>, collected: &Shared<SqLog>, totals: &Shared<Totals>, clock: &Clock, millis: u64, contexts: u64) -> started: Instant reads(table), reads(seq), reads(collected), reads(totals), writes(clock) waits {
  doc "Spawns the contexts of a correctness run, each with a part of its own, opens the gate and returns the instant it opened, once every context has completed.";
  let gate = gate_new(clock: clock);
  for @start (index in 0_u64..contexts) {
    let table_handle = shared_share::<ConcurrentHashMap<u64>>(shared: table);
    let part = sq_part_new();
    let seq_handle = shared_share::<u64>(shared: seq);
    let log_handle = shared_share::<SqLog>(shared: collected);
    let tally_handle = shared_share::<Totals>(shared: totals);
    let gate_handle = shared_share::<Gate>(shared: &gate);
    let ticks = std::time::clock_share(clock: clock);
    spawn sq_check_context(table: move table_handle, part: move part, seq: move seq_handle, collected: move log_handle, totals: move tally_handle, gate: move gate_handle, clock: move ticks, index: index, numbering: numbering);
  }
  let started = gate_open(gate: &gate, clock: clock, millis: millis);
  return started;
}

fn sq_verify(collected: &Shared<SqLog>, table: &Shared<ConcurrentHashMap<u64>>) -> verdict: u8 reads(collected), reads(table) waits {
  doc "Checks N1, N2 and N3 of the sequence-take investigation, section 2, over the merged records after every join; the verdict has bit 1 set when the numbers are not distinct and dense (N1), bit 2 when applying the records in number order does not give the final table (N2), and bit 4 when a statement that completed before another began has the larger number (N3). Every check is a direct pass or pair loop over all records.";
  let keys = box_array_filled::<u64>(count: 32768_u64, value: 0_u64);
  let values = box_array_filled::<u64>(count: 32768_u64, value: 0_u64);
  let numbers = box_array_filled::<u64>(count: 32768_u64, value: 0_u64);
  let befores = box_array_filled::<u64>(count: 32768_u64, value: 0_u64);
  let afters = box_array_filled::<u64>(count: 32768_u64, value: 0_u64);
  let used = 0_u64;
  atomic c = &collected {
    set used = c^.log.len;
    for @copy (at in 0_u64..c^.log.len) {
      if at < 32768_u64 {
        set keys.inner[at] = c^.log[at].key;
        set values.inner[at] = c^.log[at].value;
        set numbers.inner[at] = c^.log[at].number;
        set befores.inner[at] = c^.log[at].before;
        set afters.inner[at] = c^.log[at].after;
      }
    }
  }
  let low = 18446744073709551615_u64;
  let top = 0_u64;
  for @range (i in 0_u64..32768_u64) {
    if i < used {
      let seen_number = numbers.inner[i];
      if seen_number < low {
        set low = seen_number;
      }
      if seen_number > top {
        set top = seen_number;
      }
    }
  }
  let bad_one = False();
  let bad_two = False();
  let bad_three = False();
  if used == 0_u64 {
    set bad_one = True();
  } else {
    let span = top -wrap low;
    let expected = used -wrap 1_u64;
    if span != expected {
      set bad_one = True();
    }
  }
  let latest = 0_u64;
  for @outer (i in 0_u64..32768_u64) {
    if i < used {
      let superseded = False();
      for @inner (j in 0_u64..32768_u64) {
        if j < used {
          let same_number = numbers.inner[i] == numbers.inner[j];
          let other = i != j;
          let duplicate = band(same_number, other);
          if duplicate {
            set bad_one = True();
          }
          let finished_first = afters.inner[i] < befores.inner[j];
          let larger = numbers.inner[i] > numbers.inner[j];
          let inverted = band(finished_first, larger);
          if inverted {
            set bad_three = True();
          }
          let same_key = keys.inner[i] == keys.inner[j];
          let newer = numbers.inner[j] > numbers.inner[i];
          let replaced = band(same_key, newer);
          if replaced {
            set superseded = True();
          }
        }
      }
      if superseded {
      } else {
        set latest = latest +wrap 1_u64;
        let own_key = keys.inner[i];
        let own_value = values.inner[i];
        let bytes = sq_key_bytes(key: own_key);
        let view = &bytes[0_u64..8_u64];
        atomic slot = &table[view] {
          match slot^ {
            Some(value: held) => {
              if held^ != own_value {
                set bad_two = True();
              }
            }
            None() => {
              set bad_two = True();
            }
          }
        }
      }
    }
  }
  let entries = 0_u64;
  atomic all = &table {
    set entries = map_count::<u64>(map: all);
  }
  if entries != latest {
    set bad_two = True();
  }
  let code = 0_u8;
  if bad_one {
    set code = ior(code, 1_u8);
  }
  if bad_two {
    set code = ior(code, 2_u8);
  }
  if bad_three {
    set code = ior(code, 4_u8);
  }
  return code;
}

fn sq_check_run(inputs: Inputs, numbering: u8, name: &[u8]) -> status: ExitStatus reads(name) waits {
  doc "Runs one correctness arm and prints the harness line ending with the verdict; the exit status is the verdict.";
  let bench = bench_begin(inputs: move inputs);
  if bench.valid {
  } else {
    return std::process::exit_status(code: 2_u8);
  }
  let table = shared_map_new::<u64>(capacity: 100000_u64);
  let seq = shared_new::<u64>(value: 0_u64);
  let collected = sq_log_new();
  let totals = totals_new();
  let started = sq_check_start(numbering: numbering, table: &table, seq: &seq, collected: &collected, totals: &totals, clock: &bench.clock, millis: bench.millis, contexts: bench.contexts);
  let ended = std::time::now(clock: &bench.clock);
  let verdict = sq_verify(collected: &collected, table: &table);
  return bench_end(bench: move bench, name: name, totals: &totals, started: started, ended: ended, verdict: verdict);
}

fn sq_c2_main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Correctness run of T2: the status is 0 when N1, N2 and N3 all hold.";
  return sq_check_run(inputs: move inputs, numbering: 0_u8, name: &sq_name_c2[0_u64..4_u64]);
}

fn sq_cbad_main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Correctness run of Tbad: the status must have bits 1 and 4 set, N1 and N3 failing.";
  return sq_check_run(inputs: move inputs, numbering: 1_u8, name: &sq_name_cbad[0_u64..6_u64]);
}
