alias Clock = std::time::Clock;
alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias Instant = std::time::Instant;

const take_name: Array<u8, 4> =[116_u8, 97_u8, 107_u8, 101_u8];

const take_key: Array<u8, 1> =[107_u8];

fn take_context(totals: Shared<Totals>, gate: Shared<Gate>, clock: Clock, index: u64) -> result: unit pure waits {
  doc "Makes a map and a shared object of its own that no other context names, and until the deadline adds one to the map's one entry and then to the object in one atomic statement per operation, in batches of 1024: the statement holds the entry when it takes the object, and finds the object free at its first look. Then checks that both ended at its operation count and adds its count and verdict to the totals once.";
  let deadline = gate_pass(gate: &gate, clock: &clock);
  let entries = shared_map_new::<u64>(capacity: 1_u64);
  let counter = shared_new::<u64>(value: 0_u64);
  let name = &take_key[0_u64..1_u64];
  let state = index;
  let done = 0_u64;
  loop @run {
    for @batch (turn in 0_u64..1024_u64) {
      atomic slot = &entries[name], obj = &counter {
        match slot^ {
          Some(value: seen) => {
            let next = seen^ +wrap 1_u64;
            set slot^ = Some<u64>(value: next);
          }
          None() => {
            set slot^ = Some<u64>(value: 1_u64);
          }
        }
        set state = ixor(state, obj^);
        set obj^ = obj^ +wrap 1_u64;
      }
      set state = step(state: state);
    }
    set done = done +wrap 1024_u64;
    let at = std::time::now(clock: &clock);
    if std::time::instant_reached(deadline: deadline, instant: at) {
      break @run;
    }
  }
  let entry_total = 0_u64;
  let object_total = 1_u64;
  atomic slot = &entries[name], obj = &counter {
    match slot^ {
      Some(value: seen) => {
        set entry_total = seen^;
      }
      None() => {
      }
    }
    set object_total = obj^;
  }
  let mismatch = 0_u64;
  if entry_total != done {
    set mismatch = 1_u64;
  }
  if object_total != done {
    set mismatch = 1_u64;
  }
  tally(totals: &totals, done: done, state: state, mismatch: mismatch);
  return unit;
}

fn take_start(totals: &Shared<Totals>, clock: &Clock, millis: u64, contexts: u64) -> started: Instant reads(totals), writes(clock) waits {
  doc "Spawns the contexts, opens the gate and returns the instant it opened, once every context has completed.";
  let gate = gate_new(clock: clock);
  for @start (index in 0_u64..contexts) {
    let tally_handle = shared_share::<Totals>(shared: totals);
    let gate_handle = shared_share::<Gate>(shared: &gate);
    let ticks = std::time::clock_share(clock: clock);
    spawn take_context(totals: move tally_handle, gate: move gate_handle, clock: move ticks, index: index);
  }
  let started = gate_open(gate: &gate, clock: clock, millis: millis);
  return started;
}

fn take_main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "Each of CONTEXTS contexts, for MILLISECONDS, runs atomic statements that hold an entry of its own map and then take its own shared object, so every take is admitted at its first look and no claim ever queues.";
  let bench = bench_begin(inputs: move inputs);
  if bench.valid {
  } else {
    return std::process::exit_status(code: 2_u8);
  }
  let totals = totals_new();
  let started = take_start(totals: &totals, clock: &bench.clock, millis: bench.millis, contexts: bench.contexts);
  let ended = std::time::now(clock: &bench.clock);
  return bench_end(bench: move bench, name: &take_name[0_u64..4_u64], totals: &totals, started: started, ended: ended);
}
