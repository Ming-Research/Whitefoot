struct Table {
  slots: Slots<u64, 8>;
  next: u64;
}

fn claim(table: Shared<Table>) -> result: u64 pure waits {
  let got = 0_u64;
  atomic t = &table {
    if t^.next <= t^.slots.len {
      let at = t^.next;
      set got = t^.slots[at];
      let after = at + 1_u64;
      if after == t^.slots.len {
        set t^.next = 0_u64;
      } else {
        set t^.next = after;
      }
      let now = t^.next;
      invariant kept: now < t^.slots.len;
    }
  }
  return got;
}

fn main() -> status: std::process::ExitStatus pure waits {
  let slots = slots_new::<u64, 8>();
  place_back(window: &slots, value: 10_u64);
  place_back(window: &slots, value: 11_u64);
  let initial = Table(slots: move slots, next: 0_u64);
  let table = shared_new::<Table>(value: move initial);
  let first = shared_share::<Table>(shared: &table);
  let a = claim(table: move first);
  let second = shared_share::<Table>(shared: &table);
  let b = claim(table: move second);
  let third = shared_share::<Table>(shared: &table);
  let c = claim(table: move third);
  let sum = a +wrap b;
  let total = sum +wrap c;
  let code = cvt.wrap::<u64, u8>(total);
  return std::process::exit_status(code: code);
}
