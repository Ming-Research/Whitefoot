alias Value = halo::value::Value;
alias Cell = halo::value::Cell;
alias Proto = halo::value::Proto;
alias Script = halo::value::Script;
alias Vm = halo::vm::Vm;
alias Outcome = halo::vm::Outcome;
alias HostOutcome = halo::vm::HostOutcome;
alias Host = halo::vm::Host;
alias num_of = halo::value::num_of;
alias tab_of = halo::value::tab_of;
alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias unlimited = halo::vm::unlimited;

const text_0: Array<u8, 3> = "fib";

const text_1: Array<u8, 3> = "key";

const text_2: Array<u8, 6> = "answer";

const text_3: Array<u8, 1> = "n";

const text_4: Array<u8, 7> = "__index";

const text_5: Array<u8, 5> = "__add";

const text_6: Array<u8, 4> = "code";

const text_7: Array<u8, 1> = "#";

const text_8: Array<u8, 4> = "loop";

struct Env {
  stopped: Bool;
  mode: u8;
  calls: u64;
  last_func: u64;
  last_len: u64;
}

fn host_call(env: &Env, vm: &Vm, stack: &Box<Slots<Value>>, func: u64, argc: u64, id: u32) -> r: HostOutcome writes(env), writes(vm), writes(stack) contract {
  ensures stack^.inner.len == entry(stack)^.inner.len;
} {
  set env^.calls = env^.calls +sat 1_u64;
  set env^.last_func = func;
  set env^.last_len = stack^.inner.len;
  if env^.mode == 2_u8 {
    set vm^.error = Value::Num(n: 99.0_f64);
    return HostOutcome::Raised();
  }
  if func < stack^.inner.len {
    set stack^.inner[func] = Value::Num(n: 73.0_f64);
  }
  if env^.mode == 1_u8 {
    return HostOutcome::Returned(count: 1_u64);
  }
  set env^.stopped = True();
  return HostOutcome::Stop();
}

binding TestHost : Host<Env> {
  call = host_call;
}

fn put_code(code: &Box<Slots<Cell>>, cell: Cell) -> r: unit writes(code) {
  if code^.inner.len < code^.inner.cap {
    place_back(window: &code^.inner, value: cell);
  }
  return unit;
}

fn put_const(consts: &Box<Slots<Value>>, value: Value) -> r: unit writes(consts) {
  if consts^.inner.len < consts^.inner.cap {
    place_back(window: &consts^.inner, value: value);
  }
  return unit;
}

fn put_proto(protos: &Box<Slots<Proto>>, start: u32, params: u8, vararg: Bool, ups: u8, maxstack: u8) -> r: unit writes(protos) {
  let p = Proto(start: start, kbase: 0_u32, nk: 16_u32, numparams: params, is_vararg: vararg, maxstack: maxstack, nups: ups);
  if protos^.inner.len < protos^.inner.cap {
    place_back(window: &protos^.inner, value: p);
  }
  return unit;
}

fn pad(consts: &Box<Slots<Value>>) -> r: unit writes(consts) {
  for (i in 0_u64..256_u64) {
    let nil = Value::Nil();
    put_const(consts: consts, value: nil);
  }
  return unit;
}

fn raw(vm: &Vm, t: Value, key: Value, val: Value) -> r: unit writes(vm) {
  let result = halo::heap::table_set(heap: &vm^.heap, t: t, key: key, val: val);
  return unit;
}

fn attach(vm: &Vm, t: Value, mt: Value) -> r: unit writes(vm) {
  match tab_of(v: t) {
    Handle(h: th) => {
      match tab_of(v: mt) {
        Handle(h: mh) => {
          let i = cvt::<u32, u64>(th);
          if i < vm^.heap.tables.inner.len {
            set vm^.heap.tables.inner[i].payload.meta = mh;
          }
        }
        NoHandle() => {
        }
      }
    }
    NoHandle() => {
    }
  }
  return unit;
}

fn number_is(stack: &Box<Slots<Value>>, slot: u64, expected: f64) -> r: Bool reads(stack) {
  if slot < stack^.inner.len {
    match num_of(v: stack^.inner[slot]) {
      Is(x: value) => {
        return feq(value, expected);
      }
      Not() => {
      }
    }
  }
  return False();
}

fn fixture_smoke(budget: u64) -> r: Bool pure {
  let vm = halo::vm::vm_new(limit: 67108864_u64);
  let stack = halo::vm::stack_new(size: 1024_u64);
  let atom0 = False();
  let env = Env(stopped: atom0, mode: 0_u8, calls: 0_u64, last_func: 0_u64, last_len: 0_u64);
  let code = box_slots_new::<Cell>(capacity: 128_u64);
  let consts = box_slots_new::<Value>(capacity: 512_u64);
  let protos = box_slots_new::<Proto>(capacity: 8_u64);
  let lines = box_slots_new::<u32>(capacity: 0_u64);
  let c0 = Cell::LoadK(a: 0_u8, k: 0_u8);
  put_code(code: &code, cell: c0);
  let c1 = Cell::Return(a: 0_u8, b: 2_u8);
  put_code(code: &code, cell: c1);
  let k0 = Value::Num(n: 42.0_f64);
  put_const(consts: &consts, value: k0);
  pad(consts: &consts);
  let atom1 = False();
  put_proto(protos: &protos, start: 0_u32, params: 0_u8, vararg: atom1, ups: 0_u8, maxstack: 2_u8);
  let script = Script(code: move code, consts: move consts, protos: move protos, lineinfo: move lines);
  let out = halo::vm::start::<TestHost>(script: &script, stack: &stack, vm: &vm, env: &env, proto: 0_u32, argc: 0_u64, budget: budget);
  let suspensions = 0_u64;
  loop {
    match out {
      Done(count: got) => {
        if got != 1_u64 {
          return False();
        }
        let matches0 = number_is(stack: &stack, slot: 0_u64, expected: 42.0_f64);
        if bnot(matches0) {
          return False();
        }
        return True();
      }
      Error() => {
        return False();
      }
      HostStopped() => {
        return False();
      }
      Budget() => {
        set suspensions = suspensions +sat 1_u64;
        set out = halo::vm::resume::<TestHost>(script: &script, stack: &stack, vm: &vm, env: &env, budget: budget);
      }
    }
  }
  return False();
}

