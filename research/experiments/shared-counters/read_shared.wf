alias Clock = std::time::Clock;
alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias Instant = std::time::Instant;

const read_shared_name: Array<u8, 11> =[114_u8, 101_u8, 97_u8, 100_u8, 95_u8, 115_u8, 104_u8, 97_u8, 114_u8, 101_u8, 100_u8];

fn read_shared_context(counter: Shared<u64>, totals: Shared<Totals>, gate: Shared<Gate>, clock: Clock, index: u64) -> result: unit pure waits {
  doc "Until the deadline reads the shared object every context names, in one atomic statement per operation that writes nothing, in batches of 1024, then adds its count to the totals once.";
  let deadline = gate_pass(gate: &gate, clock: &clock);
  let state = index;
  let done = 0_u64;
  loop @run {
    for @batch (turn in 0_u64..1024_u64) {
      atomic held = &counter {
        set state = ixor(state, held^);
      }
      set state = step(state: state);
    }
    set done = done +wrap 1024_u64;
    let at = std::time::now(clock: &clock);
    if std::time::instant_reached(deadline: deadline, instant: at) {
      break @run;
    }
  }
  tally(totals: &totals, done: done, state: state);
  return unit;
}

fn read_shared_start(counter: &Shared<u64>, totals: &Shared<Totals>, clock: &Clock, millis: u64, contexts: u64) -> started: Instant reads(counter), reads(totals), writes(clock) waits {
  doc "Spawns the contexts, opens the gate and returns the instant it opened, once every context has completed.";
  let gate = gate_new(clock: clock);
  for @start (index in 0_u64..contexts) {
    let counter_handle = shared_share::<u64>(shared: counter);
    let tally_handle = shared_share::<Totals>(shared: totals);
    let gate_handle = shared_share::<Gate>(shared: &gate);
    let ticks = std::time::clock_share(clock: clock);
    spawn read_shared_context(counter: move counter_handle, totals: move tally_handle, gate: move gate_handle, clock: move ticks, index: index);
  }
  let started = gate_open(gate: &gate, clock: clock, millis: millis);
  return started;
}

fn read_shared_main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "W6: each of CONTEXTS contexts reads the same shared object in one atomic statement per operation that writes nothing, for MILLISECONDS; ties the read-only row of the earlier witnesses to a source.";
  let bench = bench_begin(inputs: move inputs);
  if bench.valid {
  } else {
    return std::process::exit_status(code: 2_u8);
  }
  let counter = shared_new::<u64>(value: 0_u64);
  let totals = totals_new();
  let started = read_shared_start(counter: &counter, totals: &totals, clock: &bench.clock, millis: bench.millis, contexts: bench.contexts);
  let ended = std::time::now(clock: &bench.clock);
  return bench_end(bench: move bench, name: &read_shared_name[0_u64..11_u64], totals: &totals, started: started, ended: ended);
}
