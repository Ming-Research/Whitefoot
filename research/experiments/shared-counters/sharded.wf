alias Clock = std::time::Clock;
alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias Instant = std::time::Instant;

const sharded_name: Array<u8, 7> =[115_u8, 104_u8, 97_u8, 114_u8, 100_u8, 101_u8, 100_u8];

fn sharded_zero() -> made: u64 pure {
  return 0_u64;
}

fn sharded_context(counter: Shared<Shards<u64>>, totals: Shared<Totals>, gate: Shared<Gate>, clock: Clock, index: u64) -> result: unit pure waits {
  doc "Until the deadline adds one to its selected shard through a value handle, in one statement per operation and batches of 1024, then adds its count to the totals once.";
  let deadline = gate_pass(gate: &gate, clock: &clock);
  let mine = any_shard();
  let state = index;
  let done = 0_u64;
  loop @run {
    for @batch (turn in 0_u64..1024_u64) {
      atomic kept = &counter[mine] {
        set state = ixor(state, kept^);
        set kept^ = kept^ +wrap 1_u64;
      }
      set state = step(state: state);
    }
    set done = done +wrap 1024_u64;
    let at = std::time::now(clock: &clock);
    if std::time::instant_reached(deadline: deadline, instant: at) {
      break @run;
    }
  }
  tally(totals: &totals, done: done, state: state);
  return unit;
}

fn sharded_start(counter: &Shared<Shards<u64>>, totals: &Shared<Totals>, clock: &Clock, millis: u64, contexts: u64) -> started: Instant reads(counter), reads(totals), writes(clock) waits {
  doc "Spawns the contexts, opens the gate and returns the instant it opened, once every context has completed.";
  let gate = gate_new(clock: clock);
  for @start (index in 0_u64..contexts) {
    let counter_handle = shared_share::<Shards<u64>>(shared: counter);
    let tally_handle = shared_share::<Totals>(shared: totals);
    let gate_handle = shared_share::<Gate>(shared: &gate);
    let ticks = std::time::clock_share(clock: clock);
    spawn sharded_context(counter: move counter_handle, totals: move tally_handle, gate: move gate_handle, clock: move ticks, index: index);
  }
  let started = gate_open(gate: &gate, clock: clock, millis: millis);
  return started;
}

fn sharded_main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "W4: each context adds one to its selected shard of one Shared<Shards<u64>> through a value handle, in one statement per operation.";
  let bench = bench_begin(inputs: move inputs);
  if bench.valid {
  } else {
    return std::process::exit_status(code: 2_u8);
  }
  let counter = shared_shards_new::<u64, fn sharded_zero>();
  let totals = totals_new();
  let started = sharded_start(counter: &counter, totals: &totals, clock: &bench.clock, millis: bench.millis, contexts: bench.contexts);
  let ended = std::time::now(clock: &bench.clock);
  return bench_end(bench: move bench, name: &sharded_name[0_u64..7_u64], totals: &totals, started: started, ended: ended);
}
