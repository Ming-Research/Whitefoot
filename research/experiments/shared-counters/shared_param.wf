alias Clock = std::time::Clock;
alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias Instant = std::time::Instant;

const shared_param_name: Array<u8, 12> =[115_u8, 104_u8, 97_u8, 114_u8, 101_u8, 100_u8, 95_u8, 112_u8, 97_u8, 114_u8, 97_u8, 109_u8];

fn shared_param_batch(counter: &Shared<u64>, state: u64) -> next: u64 reads(counter) waits {
  doc "One batch of 1024 operations of W2, reaching the shared object through a reference parameter whose row only reads it, as firn's command functions reach the keyspace: each adds one to the object in one atomic statement, then advances the local number.";
  let current = state;
  for @batch (turn in 0_u64..1024_u64) {
    atomic kept = &counter^ {
      set current = ixor(current, kept^);
      set kept^ = kept^ +wrap 1_u64;
    }
    set current = step(state: current);
  }
  return current;
}

fn shared_param_context(counter: Shared<u64>, totals: Shared<Totals>, gate: Shared<Gate>, clock: Clock, index: u64) -> result: unit pure waits {
  doc "W2's context, its batches made by shared_param_batch, which receives the shared object as a read-only reference parameter; then adds its count to the totals once.";
  let deadline = gate_pass(gate: &gate, clock: &clock);
  let state = index;
  let done = 0_u64;
  loop @run {
    set state = shared_param_batch(counter: &counter, state: state);
    set done = done +wrap 1024_u64;
    let at = std::time::now(clock: &clock);
    if std::time::instant_reached(deadline: deadline, instant: at) {
      break @run;
    }
  }
  tally(totals: &totals, done: done, state: state);
  return unit;
}

fn shared_param_start(counter: &Shared<u64>, totals: &Shared<Totals>, clock: &Clock, millis: u64, contexts: u64) -> started: Instant reads(counter), reads(totals), writes(clock) waits {
  doc "Spawns the contexts, opens the gate and returns the instant it opened, once every context has completed.";
  let gate = gate_new(clock: clock);
  for @start (index in 0_u64..contexts) {
    let counter_handle = shared_share::<u64>(shared: counter);
    let tally_handle = shared_share::<Totals>(shared: totals);
    let gate_handle = shared_share::<Gate>(shared: &gate);
    let ticks = std::time::clock_share(clock: clock);
    spawn shared_param_context(counter: move counter_handle, totals: move tally_handle, gate: move gate_handle, clock: move ticks, index: index);
  }
  let started = gate_open(gate: &gate, clock: clock, millis: millis);
  return started;
}

fn shared_param_main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "W2r: W2 with each atomic statement reaching the one shared object through a read-only reference parameter, which the compiler counts no handle for; the arm that attributes the handle count.";
  let bench = bench_begin(inputs: move inputs);
  if bench.valid {
  } else {
    return std::process::exit_status(code: 2_u8);
  }
  let counter = shared_new::<u64>(value: 0_u64);
  let totals = totals_new();
  let started = shared_param_start(counter: &counter, totals: &totals, clock: &bench.clock, millis: bench.millis, contexts: bench.contexts);
  let ended = std::time::now(clock: &bench.clock);
  return bench_end(bench: move bench, name: &shared_param_name[0_u64..12_u64], totals: &totals, started: started, ended: ended);
}
