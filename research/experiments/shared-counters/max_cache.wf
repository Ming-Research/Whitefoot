alias Clock = std::time::Clock;
alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias Instant = std::time::Instant;

const max_cache_name: Array<u8, 9> =[109_u8, 97_u8, 120_u8, 95_u8, 99_u8, 97_u8, 99_u8, 104_u8, 101_u8];

fn max_cache_context(peak: Shared<u64>, totals: Shared<Totals>, gate: Shared<Gate>, clock: Clock, index: u64) -> result: unit pure waits {
  doc "M3: every context caches the last maximum it observed under its exclusive update and updates only above that cache. The candidate is the local LCG state modulo 2^20; batches contain 1024 operations.";
  let deadline = gate_pass(gate: &gate, clock: &clock);
  let cached = 0_u64;
  let state = index;
  let done = 0_u64;
  loop @run {
    for @batch (turn in 0_u64..1024_u64) {
      let value = state % 1048576_u64;
      if value > cached {
        atomic kept = &peak {
          set kept^ = imax(kept^, value);
          set cached = kept^;
        }
      }
      set state = step(state: state);
    }
    set done = done +wrap 1024_u64;
    let at = std::time::now(clock: &clock);
    if std::time::instant_reached(deadline: deadline, instant: at) {
      break @run;
    }
  }
  tally(totals: &totals, done: done, state: state);
  return unit;
}

fn max_cache_start(peak: &Shared<u64>, totals: &Shared<Totals>, clock: &Clock, millis: u64, contexts: u64) -> started: Instant reads(peak), reads(totals), writes(clock) waits {
  doc "Spawns every writer, opens the common gate and returns its start after all writers join.";
  let gate = gate_new(clock: clock);
  for @start (index in 0_u64..contexts) {
    let peak_handle = shared_share::<u64>(shared: peak);
    let tally_handle = shared_share::<Totals>(shared: totals);
    let gate_handle = shared_share::<Gate>(shared: &gate);
    let ticks = std::time::clock_share(clock: clock);
    spawn max_cache_context(peak: move peak_handle, totals: move tally_handle, gate: move gate_handle, clock: move ticks, index: index);
  }
  let started = gate_open(gate: &gate, clock: clock, millis: millis);
  return started;
}

fn max_cache_main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "M3: every context caches the last maximum it observed under its exclusive update and updates only above that cache. Reports the established harness line, including the final maximum in check after timing ends.";
  let bench = bench_begin(inputs: move inputs);
  if bench.valid {
  } else {
    return std::process::exit_status(code: 2_u8);
  }
  let peak = shared_new::<u64>(value: 0_u64);
  let totals = totals_new();
  let started = max_cache_start(peak: &peak, totals: &totals, clock: &bench.clock, millis: bench.millis, contexts: bench.contexts);
  let ended = std::time::now(clock: &bench.clock);
  let highest = 0_u64;
  atomic kept = &peak {
    set highest = kept^;
  }
  tally(totals: &totals, done: 0_u64, state: highest);
  return bench_end(bench: move bench, name: &max_cache_name[0_u64..9_u64], totals: &totals, started: started, ended: ended);
}
