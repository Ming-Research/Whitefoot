alias Clock = std::time::Clock;
alias ExitStatus = std::process::ExitStatus;
alias Inputs = std::process::Inputs;
alias Instant = std::time::Instant;

const base_name: Array<u8, 4> =[98_u8, 97_u8, 115_u8, 101_u8];

fn base_context(totals: Shared<Totals>, gate: Shared<Gate>, clock: Clock, index: u64) -> result: unit pure waits {
  doc "Advances its own local number in batches of 1024 operations until the deadline, with no atomic statement, then adds its count to the totals once.";
  let deadline = gate_pass(gate: &gate, clock: &clock);
  let state = index;
  let done = 0_u64;
  loop @run {
    for @batch (turn in 0_u64..1024_u64) {
      set state = step(state: state);
    }
    set done = done +wrap 1024_u64;
    let at = std::time::now(clock: &clock);
    if std::time::instant_reached(deadline: deadline, instant: at) {
      break @run;
    }
  }
  tally(totals: &totals, done: done, state: state);
  return unit;
}

fn base_start(totals: &Shared<Totals>, clock: &Clock, millis: u64, contexts: u64) -> started: Instant reads(totals), writes(clock) waits {
  doc "Spawns the contexts, opens the gate and returns the instant it opened, once every context has completed.";
  let gate = gate_new(clock: clock);
  for @start (index in 0_u64..contexts) {
    let tally_handle = shared_share::<Totals>(shared: totals);
    let gate_handle = shared_share::<Gate>(shared: &gate);
    let ticks = std::time::clock_share(clock: clock);
    spawn base_context(totals: move tally_handle, gate: move gate_handle, clock: move ticks, index: index);
  }
  let started = gate_open(gate: &gate, clock: clock, millis: millis);
  return started;
}

fn base_main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "W0: each of CONTEXTS contexts advances its own local number for MILLISECONDS, with no atomic statement; the runtime's no-sharing baseline.";
  let bench = bench_begin(inputs: move inputs);
  if bench.valid {
  } else {
    return std::process::exit_status(code: 2_u8);
  }
  let totals = totals_new();
  let started = base_start(totals: &totals, clock: &bench.clock, millis: bench.millis, contexts: bench.contexts);
  let ended = std::time::now(clock: &bench.clock);
  return bench_end(bench: move bench, name: &base_name[0_u64..4_u64], totals: &totals, started: started, ended: ended);
}
