fn mark(cells: &Box<Array<u64>>, lo: u64, hi: u64, salt: u64) -> result: unit writes(cells) contract {
  requires lo <= hi;
  requires hi <= cells^.inner.len;
} {
  for @mark (i in lo..hi) {
    set cells^.inner[i] = i +wrap salt;
  }
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  let cells = box_array_filled::<u64>(count: 4096_u64, value: 0_u64);
  let lo = 0_u64;
  let n = 0_u64;
  loop @walk {
    if n == 20000000_u64 {
      break @walk;
    }
    if lo >= 4000_u64 {
      set lo = 0_u64;
    }
    let hi = lo +wrap 3_u64;
    if lo <= hi {
      if hi <= cells.inner.len {
        let done = mark(cells: &cells, lo: lo, hi: hi, salt: n);
      }
    }
    set lo = lo +wrap 7_u64;
    set n = n +wrap 1_u64;
  }
  if 0_u64 < cells.inner.len {
    if cells.inner[0_u64] == 12345_u64 {
      return std::process::exit_status(code: 1_u8);
    }
  }
  return std::process::exit_status(code: 0_u8);
}
