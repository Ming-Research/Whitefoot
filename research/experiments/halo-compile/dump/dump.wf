alias Inputs = std::process::Inputs;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias InputStream = std::io::InputStream;
alias OutputStream = std::io::OutputStream;
alias Value = halo::value::Value;
alias Cell = halo::value::Cell;
alias Script = halo::value::Script;
alias Heap = halo::heap::Heap;

fn push(out: &Box<Slots<u8>>, byte: u8) -> result: unit writes(out) {
  doc "Append a byte to reusable experiment storage.";
  let cap = out^.inner.cap;
  if out^.inner.len == cap {
    let twice = cap +sat cap;
    let target = imax(twice, 4096_u64);
    if target >= cap {
      grow(cell: out, capacity: target);
    }
  }
  if out^.inner.len < out^.inner.cap {
    place_back(window: &out^.inner, value: byte);
  }
  return unit;
}

fn decimal(out: &Box<Slots<u8>>, number: u64) -> result: unit writes(out) {
  doc "Decimal field in a token dump.";
  let digits = slots_new::<u8, 20>();
  let n = number;
  loop {
    let d = n % 10_u64;
    let b = cvt.wrap::<u64, u8>(d);
    let c = b +wrap 48_u8;
    if digits.len < digits.cap {
      place_back(window: &digits, value: c);
    }
    set n = n / 10_u64;
    if n == 0_u64 {
      break;
    }
  }
  loop {
    if digits.len == 0_u64 {
      break;
    }
    let b = take_back(window: &digits);
    push(out: out, byte: b);
  }
  push(out: out, byte: 9_u8);
  return unit;
}

fn hex_digit(n: u8) -> b: u8 pure {
  doc "Lowercase hexadecimal digit.";
  if n < 10_u8 {
    return n +wrap 48_u8;
  }
  return n +wrap 87_u8;
}

fn hex(out: &Box<Slots<u8>>, bytes: &[u8], start: u64, end: u64) -> result: unit reads(bytes), writes(out) {
  doc "Binary-safe payload; a dash denotes empty or absent bytes.";
  if start == end {
    push(out: out, byte: 45_u8);
  }
  if start <= end {
    for (i in start..end) {
      if i < bytes^.len {
        let byte = bytes^[i];
        let hi = byte / 16_u8;
        let lo = byte % 16_u8;
        let h = hex_digit(n: hi);
        let l = hex_digit(n: lo);
        push(out: out, byte: h);
        push(out: out, byte: l);
      }
    }
  }
  push(out: out, byte: 10_u8);
  return unit;
}

fn read_source(factory: &HandleFactory, input: &InputStream, source: &Box<Slots<u8>>) -> success: Bool writes(factory), writes(input), writes(source) waits {
  doc "Read stdin in small host operations, preserving all binary bytes.";
  let scratch = array_filled::<u8, 4096>(value: 0_u8);
  loop {
    let deadline = None<std::time::Instant>();
    let got = std::io::read_next(factory: factory, input: input, destination: &scratch[0_u64..4096_u64], start: 0_u64, end: 4096_u64, deadline: deadline);
    match got {
      Ok(value: count) => {
        for (i in 0_u64..count) {
          if i < 4096_u64 {
            let b = scratch[i];
            push(out: source, byte: b);
          }
        }
      }
      Err(error: stop) => {
        match stop {
          ReadEnd() => {
            return True();
          }
          ReadFailed(error: problem) => {
            return False();
          }
        }
      }
    }
  }
  return False();
}

const chunk_name: Array<u8, 6> = "=stdin";

fn dump_value(heap: &Heap, value: Value, out: &Box<Slots<u8>>) -> result: unit reads(heap), writes(out) {
  match value {
    Nil() => {
      push(out: out, byte: 48_u8);
      push(out: out, byte: 10_u8);
    }
    False() => {
      push(out: out, byte: 49_u8);
      push(out: out, byte: 10_u8);
    }
    True() => {
      push(out: out, byte: 50_u8);
      push(out: out, byte: 10_u8);
    }
    Num(n: number) => {
      push(out: out, byte: 51_u8);
      push(out: out, byte: 9_u8);
      let text = array_filled::<u8, 32>(value: 0_u8);
      let count = halo::number::format_number(value: number, out: &text[0_u64..32_u64]);
      for (i in 0_u64..count) {
        if i < 32_u64 {
          push(out: out, byte: text[i]);
        }
      }
      push(out: out, byte: 10_u8);
    }
    Str(h: handle) => {
      push(out: out, byte: 52_u8);
      push(out: out, byte: 9_u8);
      let i = cvt::<u32, u64>(handle);
      if i < heap^.strings.inner.len {
        let n = heap^.strings.inner[i].payload.bytes.inner.len;
        hex(out: out, bytes: &heap^.strings.inner[i].payload.bytes.inner[0_u64..n], start: 0_u64, end: n);
      }
    }
    Tab(h: handle) => {
      push(out: out, byte: 88_u8);
    }
    Fun(h: handle) => {
      push(out: out, byte: 88_u8);
    }
    Builtin(id: handle) => {
      push(out: out, byte: 88_u8);
    }
  }
  return unit;
}

