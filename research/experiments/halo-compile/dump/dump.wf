fn dump_script(heap: &Heap, script: &Script, out: &Box<Slots<u8>>) -> result: unit reads(heap), reads(script), writes(out) {
  for (i in 0_u64..script^.protos.inner.len) {
    let p = script^.protos.inner[i];
    push(out: out, byte: 80_u8);
    push(out: out, byte: 9_u8);
    decimal(out: out, number: i);
    let w_start = cvt::<u32, u64>(p.start);
    decimal(out: out, number: w_start);
    let w_kbase = cvt::<u32, u64>(p.kbase);
    decimal(out: out, number: w_kbase);
    let w_nk = cvt::<u32, u64>(p.nk);
    decimal(out: out, number: w_nk);
    let w_numparams = cvt::<u8, u64>(p.numparams);
    decimal(out: out, number: w_numparams);
    let w_maxstack = cvt::<u8, u64>(p.maxstack);
    decimal(out: out, number: w_maxstack);
    let w_nups = cvt::<u8, u64>(p.nups);
    decimal(out: out, number: w_nups);
    let vararg = 0_u64;
    if p.is_vararg {
      set vararg = 1_u64;
    }
    decimal(out: out, number: vararg);
    push(out: out, byte: 10_u8);
  }
  for (i in 0_u64..script^.consts.inner.len) {
    push(out: out, byte: 75_u8);
    push(out: out, byte: 9_u8);
    decimal(out: out, number: i);
    let v = script^.consts.inner[i];
    dump_value(heap: heap, value: v, out: out);
  }
  for (i in 0_u64..script^.code.inner.len) {
    push(out: out, byte: 67_u8);
    push(out: out, byte: 9_u8);
    decimal(out: out, number: i);
    let line = 0_u64;
    if i < script^.lineinfo.inner.len {
      set line = cvt::<u32, u64>(script^.lineinfo.inner[i]);
    }
    decimal(out: out, number: line);
    let cell = script^.code.inner[i];
    dump_cell(cell: cell, out: out);
  }
  return unit;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: args, cwd: cwd, stdout: output, stderr: stderr, handles: factory, stdin: input, clock: clock, wall_clock: wall_clock) = move inputs;
  let std::fs::Directory(read: cwd_read, write: cwd_write) = move cwd;
  std::fs::close_directory(factory: &factory, directory: move cwd_read);
  std::fs::close_directory_write(factory: &factory, directory: move cwd_write);
  let source = box_slots_new::<u8>(capacity: 0_u64);
  let read = read_source(factory: &factory, input: &input, source: &source);
  if read {
  } else {
    return std::process::exit_status(code: 2_u8);
  }
  let out = box_slots_new::<u8>(capacity: 0_u64);
  let heap = halo::heap::heap_new(limit: 18446744073709551615_u64);
  let argc = std::text::args_count(args: &args);
  if argc > 1_u64 {
    set heap.bytes = 18446744073709551615_u64;
    if argc > 2_u64 {
      set heap.bytes = 18446744073709551590_u64;
    }
  }
  let n = source.inner.len;
  let compiled = halo::compile::compile(heap: &heap, chunk_name: &chunk_name[0_u64..6_u64], source: &source.inner[0_u64..n]);
  match move compiled {
    Ok(value: script) => {
      dump_script(heap: &heap, script: &script, out: &out);
    }
    Err(error: problem) => {
      push(out: &out, byte: 69_u8);
      push(out: &out, byte: 9_u8);
      decimal(out: &out, number: problem.line);
      let len = problem.message.inner.len;
      hex(out: &out, bytes: &problem.message.inner[0_u64..len], start: 0_u64, end: len);
    }
  }
  let length = out.inner.len;
  let position = 0_u64;
  loop {
    if position >= length {
      break;
    }
    let deadline = None<std::time::Instant>();
    let written = std::io::write_once(factory: &factory, output: &output, source: &out.inner[0_u64..length], start: position, end: length, deadline: deadline);
    match written {
      Ok(value: end) => {
        if end == position {
          return std::process::exit_status(code: 2_u8);
        }
        set position = end;
      }
      Err(error: problem) => {
        return std::process::exit_status(code: 2_u8);
      }
    }
  }
  return std::process::exit_status(code: 0_u8);
}
