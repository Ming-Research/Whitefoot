alias Args = std::text::Args;
alias Clock = std::time::Clock;
alias DirectoryRead = std::fs::DirectoryRead;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias HashMap = std::collections::hash_map::HashMap;
alias HashMapKey = std::collections::hash_map::HashMapKey;
alias Inputs = std::process::Inputs;
alias Instant = std::time::Instant;
alias OutputStream = std::io::OutputStream;
alias arg_get = std::text::arg_get;
alias clock_share = std::time::clock_share;
alias close_directory = std::fs::close_directory;
alias close_directory_write = std::fs::close_directory_write;
alias close_read = std::fs::close_read;
alias exit_status = std::process::exit_status;
alias factory_share = std::io::factory_share;
alias hash_map_edit = std::collections::hash_map::hash_map_edit;
alias hash_map_lookup = std::collections::hash_map::hash_map_lookup;
alias hash_map_new = std::collections::hash_map::hash_map_new;
alias hash_map_put = std::collections::hash_map::hash_map_put;
alias hash_map_remove = std::collections::hash_map::hash_map_remove;
alias host_copy_utf8 = std::text::host_copy_utf8;
alias instant_after = std::time::instant_after;
alias instant_reached = std::time::instant_reached;
alias now = std::time::now;
alias open_read = std::fs::open_read;
alias read_at = std::fs::read_at;
alias relative_path = std::fs::relative_path;
alias write_once = std::io::write_once;

const ceiling: u64 = 4294967296_u64;

const golden: u64 = 11400714819323198485_u64;

const mix_one: u64 = 13787848793156543929_u64;

const mix_two: u64 = 10723151780598845931_u64;

const low_62: u64 = 4611686018427387903_u64;

const zipf_bytes: u64 = 4194304_u64;

const zipf_header: u64 = 40_u64;

struct KeyEnv {
  unused: u64;
}

struct Seen {
  visits: u64;
}

struct Store {
  doc "The map firn's keyspace uses, behind the one lock of its shared object.";
  map: HashMap<u64, u64, ceiling>;
  env: KeyEnv;
}

struct Gate {
  doc "Opened once every worker of a cell has started, with the instants the cell's warmup and measurement end at.";
  open: Bool;
  warm: Instant;
  end: Instant;
}

struct Tally {
  ops: u64;
  get_misses: u64;
  update_misses: u64;
  updates: u64;
  inserted: u64;
  removed: u64;
}

fn key_hash(env: &KeyEnv, key: &u64) -> result: u64 reads(key) {
  doc "One multiplication by the 64-bit golden ratio, the hash every native implementation uses.";
  let hashed = key^ *wrap golden;
  return hashed;
}

fn key_equal(env: &KeyEnv, left: &u64, right: &u64) -> result: Bool reads(left), reads(right) {
  return left^ == right^;
}

binding WordKey : HashMapKey<u64, KeyEnv> {
  hash = key_hash;
  equal = key_equal;
}

fn read_value(env: &Seen, key: &u64, value: &u64) -> result: u64 reads(value), writes(env) {
  set env^.visits = env^.visits +wrap 1_u64;
  return value^;
}

fn add_one(env: &Seen, key: &u64, value: &u64) -> result: u64 writes(env), writes(value) {
  set env^.visits = env^.visits +wrap 1_u64;
  set value^ = value^ +wrap 1_u64;
  return value^;
}

fn mix64(z: u64) -> result: u64 pure {
  doc "The SplitMix64 finalizer, as workload.h states it.";
  let s1 = ishr.wrap(z, 30_u32);
  let x1 = ixor(z, s1);
  let m1 = x1 *wrap mix_one;
  let s2 = ishr.wrap(m1, 27_u32);
  let x2 = ixor(m1, s2);
  let m2 = x2 *wrap mix_two;
  let s3 = ishr.wrap(m2, 31_u32);
  return ixor(m2, s3);
}

fn key_of(index: u64) -> result: u64 pure {
  doc "The key of an index: one plus the finalizer's steps modulo 2^62, as workload.h states it.";
  let x0 = iand(index, low_62);
  let s1 = ishr.wrap(x0, 31_u32);
  let x1 = ixor(x0, s1);
  let m1 = x1 *wrap mix_one;
  let x2 = iand(m1, low_62);
  let s2 = ishr.wrap(x2, 29_u32);
  let x3 = ixor(x2, s2);
  let m2 = x3 *wrap mix_two;
  let x4 = iand(m2, low_62);
  let s3 = ishr.wrap(x4, 32_u32);
  let x5 = ixor(x4, s3);
  return x5 +wrap 1_u64;
}

fn seed(mix: u64, threads: u64, thread: u64) -> result: u64 pure {
  let high = ishl.wrap(mix, 48_u32);
  let middle = ishl.wrap(threads, 32_u32);
  let both = ixor(high, middle);
  let all = ixor(both, thread);
  return mix64(z: all);
}

fn rank_byte(ranks: &Box<Slots<u8>>, index: u64) -> result: u64 reads(ranks) {
  if index < ranks^.inner.len {
    let byte = ranks^.inner[index];
    return cvt::<u8, u64>(byte);
  }
  return 0_u64;
}

fn rank_at(ranks: &Box<Slots<u8>>, position: u64) -> result: u64 reads(ranks) {
  doc "The little-endian 32-bit rank at a position of a thread's repeating Zipf buffer.";
  let slot = iand(position, 1048575_u64);
  let base = slot *wrap 4_u64;
  let b0 = rank_byte(ranks: ranks, index: base);
  let i1 = base +wrap 1_u64;
  let b1 = rank_byte(ranks: ranks, index: i1);
  let i2 = base +wrap 2_u64;
  let b2 = rank_byte(ranks: ranks, index: i2);
  let i3 = base +wrap 3_u64;
  let b3 = rank_byte(ranks: ranks, index: i3);
  let w1 = ishl.wrap(b1, 8_u32);
  let w2 = ishl.wrap(b2, 16_u32);
  let w3 = ishl.wrap(b3, 24_u32);
  let low = ior(b0, w1);
  let high = ior(w2, w3);
  return ior(low, high);
}

fn work(store: Shared<Store>, tally: Shared<Tally>, gate: Shared<Gate>, clock: Clock, ranks: Box<Slots<u8>>, thread: u64, threads: u64, mix: u64, dist: u64, range: u64) -> result: unit pure waits {
  doc "One thread of a cell: waits for the gate, draws operations until its end, and counts those of the batches begun after its warmup.";
  let warm = now(clock: &clock);
  let end = now(clock: &clock);
  atomic opened = &gate when opened^.open {
    set warm = opened^.warm;
    set end = opened^.end;
  }
  let get_limit = 0_u64;
  let update_limit = 100_u64;
  let insert_limit = 100_u64;
  if mix == 0_u64 {
    set get_limit = 100_u64;
  }
  if mix == 1_u64 {
    set get_limit = 95_u64;
  }
  if mix == 2_u64 {
    set get_limit = 50_u64;
  }
  if mix == 4_u64 {
    set get_limit = 50_u64;
    set update_limit = 50_u64;
    set insert_limit = 75_u64;
  }
  let state = seed(mix: mix, threads: threads, thread: thread);
  let position = 0_u64;
  let ops = 0_u64;
  let counting = False();
  let get_misses = 0_u64;
  let update_misses = 0_u64;
  let updates = 0_u64;
  let inserted = 0_u64;
  let removed = 0_u64;
  let seen = Seen(visits: 0_u64);
  loop @run {
    for @batch (step in 0_u64..256_u64) {
      set state = state +wrap golden;
      let drawn = mix64(z: state);
      let low = iand(drawn, 4294967295_u64);
      let scaled = low *wrap 100_u64;
      let roll = ishr.wrap(scaled, 32_u32);
      let index = 0_u64;
      if dist == 0_u64 {
        let high = ishr.wrap(drawn, 32_u32);
        let product = high *wrap range;
        set index = ishr.wrap(product, 32_u32);
      }
      if dist == 1_u64 {
        set index = rank_at(ranks: &ranks, position: position);
        set position = position +wrap 1_u64;
      }
      let key = key_of(index: index);
      if roll < get_limit {
        let hit = False();
        atomic held = &store {
          match hash_map_lookup::<WordKey, u64, Seen, u64, fn read_value, ceiling>(map: &held^.map, key: &key, key_env: &held^.env, visit_env: &seen) {
            Ok(value: found) => {
              set hit = True();
            }
            Err(error: absent) => {
              set hit = False();
            }
          }
        }
        if hit {
        } else {
          set get_misses = get_misses +wrap 1_u64;
        }
      } else if roll < update_limit {
        let done = False();
        atomic held = &store {
          match hash_map_edit::<WordKey, u64, Seen, u64, fn add_one, ceiling>(map: &held^.map, key: &key, key_env: &held^.env, edit_env: &seen) {
            Ok(value: after) => {
              set done = True();
            }
            Err(error: absent) => {
              set done = False();
            }
          }
        }
        if done {
          set updates = updates +wrap 1_u64;
        } else {
          set update_misses = update_misses +wrap 1_u64;
        }
      } else if roll < insert_limit {
        let fresh = False();
        atomic held = &store {
          match hash_map_put::<WordKey, u64, ceiling>(map: &held^.map, key: key, value: index, env: &held^.env) {
            HashMapInserted() => {
              set fresh = True();
            }
            HashMapReturned(reason: why, pair: old) => {
              set fresh = False();
            }
          }
        }
        if fresh {
          set inserted = inserted +wrap 1_u64;
        }
      } else {
        let gone = False();
        atomic held = &store {
          match hash_map_remove::<WordKey, u64, ceiling>(map: &held^.map, key: &key, env: &held^.env) {
            Some(value: pair) => {
              set gone = True();
            }
            None() => {
              set gone = False();
            }
          }
        }
        if gone {
          set removed = removed +wrap 1_u64;
        }
      }
    }
    let at = now(clock: &clock);
    if counting {
      set ops = ops +wrap 256_u64;
    } else if instant_reached(deadline: warm, instant: at) {
      set counting = True();
    }
    if instant_reached(deadline: end, instant: at) {
      break @run;
    }
  }
  atomic total = &tally {
    set total^.ops = total^.ops +wrap ops;
    set total^.get_misses = total^.get_misses +wrap get_misses;
    set total^.update_misses = total^.update_misses +wrap update_misses;
    set total^.updates = total^.updates +wrap updates;
    set total^.inserted = total^.inserted +wrap inserted;
    set total^.removed = total^.removed +wrap removed;
  }
  return unit;
}

fn bytes_new(capacity: u64) -> made: Box<Slots<u8>> pure contract {
  requires capacity <= 1073741824_u64;
  ensures made.inner.len == capacity;
} {
  let made = box_slots_new::<u8>(capacity: capacity);
  for @fill (
    at in 0_u64..capacity,
    invariant filled: made.inner.len == at
  ) {
    place_back(window: &made.inner, value: 0_u8);
  }
  return move made;
}

fn load_ranks(factory: &HandleFactory, file: &std::fs::ReadFile, thread: u64) -> result: Box<Slots<u8>> writes(factory), writes(file) waits {
  doc "Reads one thread's Zipf buffer from the rank file; a short file leaves zeros.";
  let ranks = bytes_new(capacity: zipf_bytes);
  let offset = thread *wrap zipf_bytes;
  let base = offset +wrap zipf_header;
  let done = 0_u64;
  loop @reading {
    if done >= zipf_bytes {
      break @reading;
    }
    let at = base +wrap done;
    let window = &ranks.inner[0_u64..zipf_bytes];
    match read_at(factory: factory, file: file, destination: window, file_offset: at, start: done, end: zipf_bytes) {
      Ok(value: next) => {
        if next == done {
          break @reading;
        }
        set done = next;
      }
      Err(error: stop) => {
        break @reading;
      }
    }
  }
  return move ranks;
}

fn run_cell(factory: &HandleFactory, root: &DirectoryRead, args: &Args, store: &Shared<Store>, tally: &Shared<Tally>, clock: &Clock, threads: u64, mix: u64, dist: u64, range: u64, warmup_ms: u64, duration_ms: u64) -> result: unit reads(root), reads(args), reads(store), reads(tally), writes(factory), writes(clock) waits {
  doc "Starts one context per thread, opens the gate once all have started, and returns once all of them have finished.";
  let placeholder = now(clock: clock);
  let shut = False();
  let shut_gate = Gate(open: shut, warm: placeholder, end: placeholder);
  let gate = shared_new::<Gate>(value: shut_gate);
  let named = dist == 1_u64;
  for @start (thread in 0_u64..threads) {
    let ranks = bytes_new(capacity: 0_u64);
    if named {
      match arg_get(args: args, position: 7_u64) {
        Ok(value: text) => {
          match relative_path(value: move text) {
            Ok(value: path) => {
              match open_read(factory: factory, root: root, path: &path) {
                Ok(value: file) => {
                  set ranks = load_ranks(factory: factory, file: &file, thread: thread);
                  match close_read(factory: factory, file: move file) {
                    Ok(value: closed) => {
                      let unused = 0_u64;
                    }
                    Err(error: problem) => {
                      let unused = 0_u64;
                    }
                  }
                }
                Err(error: problem) => {
                  let unused = 0_u64;
                }
              }
            }
            Err(error: problem) => {
              let unused = 0_u64;
            }
          }
        }
        Err(error: problem) => {
          let unused = 0_u64;
        }
      }
    }
    let held = shared_share::<Store>(shared: store);
    let counted = shared_share::<Tally>(shared: tally);
    let ticking = clock_share(clock: clock);
    let waiting = shared_share::<Gate>(shared: &gate);
    spawn work(store: move held, tally: move counted, gate: move waiting, clock: move ticking, ranks: move ranks, thread: thread, threads: threads, mix: mix, dist: dist, range: range);
  }
  let begun = now(clock: clock);
  let warm_ns = warmup_ms *wrap 1000000_u64;
  let duration_ns = duration_ms *wrap 1000000_u64;
  let warm = instant_after(instant: begun, nanoseconds: warm_ns);
  let end = instant_after(instant: warm, nanoseconds: duration_ns);
  atomic opening = &gate {
    set opening^.warm = warm;
    set opening^.end = end;
    set opening^.open = True();
  }
  return unit;
}

fn parse_number(digits: &[u8], length: u64) -> result: u64 reads(digits) {
  let value = 0_u64;
  for @digits (at in 0_u64..length) {
    if at < digits^.len {
      let byte = digits^[at];
      let offset = byte -wrap 48_u8;
      let wide = cvt::<u8, u64>(offset);
      let scaled = value *wrap 10_u64;
      set value = scaled +wrap wide;
    }
  }
  return value;
}

fn arg_number(args: &Args, position: u64) -> result: u64 reads(args) {
  doc "The decimal argument at a position, or zero when there is none.";
  let digits = slots_new::<u8, 24>();
  for @fill (
    at in 0_u64..24_u64,
    invariant grown: digits.len == at
  ) {
    place_back(window: &digits, value: 0_u8);
  }
  let window = &digits[0_u64..24_u64];
  let length = 0_u64;
  match arg_get(args: args, position: position) {
    Ok(value: text) => {
      match host_copy_utf8(value: &text, destination: window, start: 0_u64, end: 24_u64) {
        Ok(value: written) => {
          set length = written;
        }
        Err(error: problem) => {
          set length = 0_u64;
        }
      }
    }
    Err(error: problem) => {
      set length = 0_u64;
    }
  }
  return parse_number(digits: window, length: length);
}

fn put_byte(line: &Slots<u8, 256>, value: u8) -> result: unit writes(line) {
  if line^.len < 256_u64 {
    place_back(window: line, value: value);
  }
  return unit;
}

fn put_number(line: &Slots<u8, 256>, value: u64) -> result: unit writes(line) {
  doc "Appends a number in decimal and a space.";
  let digits = 1_u64;
  let rest = value / 10_u64;
  loop @count {
    if rest == 0_u64 {
      break @count;
    }
    set digits = digits +wrap 1_u64;
    set rest = rest / 10_u64;
  }
  let scratch = array_filled::<u8, 20>(value: 0_u8);
  let remaining = value;
  for @emit (step in 0_u64..digits) {
    let back = digits -wrap step;
    let index = back -wrap 1_u64;
    let low = remaining % 10_u64;
    let narrow = cvt.wrap::<u64, u8>(low);
    if index < 20_u64 {
      set scratch[index] = narrow +wrap 48_u8;
    }
    set remaining = remaining / 10_u64;
  }
  for @copy (at in 0_u64..digits) {
    if at < 20_u64 {
      put_byte(line: line, value: scratch[at]);
    }
  }
  put_byte(line: line, value: 32_u8);
  return unit;
}

fn write_line(factory: &HandleFactory, out: &OutputStream, line: &Slots<u8, 256>) -> result: Bool writes(factory), writes(out), writes(line) waits {
  doc "Writes a line's bytes and a newline; false when the output refuses them.";
  put_newline(line: line);
  let length = line^.len;
  let published = &line^[0_u64..length];
  let sent = 0_u64;
  loop @write {
    if sent >= length {
      break @write;
    }
    let no_deadline = None<Instant>();
    match write_once(factory: factory, output: out, source: published, start: sent, end: length, deadline: no_deadline) {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return False();
      }
    }
  }
  return True();
}

fn tally_new() -> result: Tally pure {
  return Tally(ops: 0_u64, get_misses: 0_u64, update_misses: 0_u64, updates: 0_u64, inserted: 0_u64, removed: 0_u64);
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "The wf-current control of concurrent-map-bench: driver.c's measurement on a standard HashMap behind one Shared object reached through atomic statements, as firn reaches its keyspace. Arguments: size, key choice (0 uniform, 1 Zipf, 2 one key), a mask of mixes (bit 0 read, 1 mostly-read, 2 balanced, 3 update, 4 churn), threads, warmup and duration in milliseconds, and the Zipf rank file relative to the working directory. Prints `mix threads ops nanoseconds get-misses update-misses` per cell, then `9 missing sum expected`, and after churn `8 live expected`.";
  let Inputs(args: args, cwd: cwd_directory, stdout: out, stderr: unused_err, handles: handles, stdin: unused_in, clock: clock, wall_clock: unused_wall) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  close_directory_write(factory: &handles, directory: move cwd_write);
  let size = arg_number(args: &args, position: 1_u64);
  let dist = arg_number(args: &args, position: 2_u64);
  let mixes = arg_number(args: &args, position: 3_u64);
  let threads = arg_number(args: &args, position: 4_u64);
  let warmup_ms = arg_number(args: &args, position: 5_u64);
  let duration_ms = arg_number(args: &args, position: 6_u64);
  let bad_size = size > 2147483648_u64;
  let no_size = size == 0_u64;
  let no_threads = threads == 0_u64;
  let unusable = bor(bad_size, no_size);
  if bor(unusable, no_threads) {
    close_directory(factory: &handles, directory: move cwd);
    return exit_status(code: 2_u8);
  }
  let env = KeyEnv(unused: 0_u64);
  let map = hash_map_new::<u64, u64, ceiling>(capacity: size);
  for @prefill (index in 0_u64..size) {
    let key = key_of(index: index);
    match hash_map_put::<WordKey, u64, ceiling>(map: &map, key: key, value: index, env: &env) {
      HashMapInserted() => {
        let unused = 0_u64;
      }
      HashMapReturned(reason: why, pair: old) => {
        close_directory(factory: &handles, directory: move cwd);
        return exit_status(code: 3_u8);
      }
    }
  }
  let filled = Store(map: move map, env: env);
  let store = shared_new::<Store>(value: move filled);
  let updates = 0_u64;
  let line = slots_new::<u8, 256>();
  for @cells (mix in 0_u64..4_u64) {
    let amount = cvt.wrap::<u64, u32>(mix);
    let bit = ishl.wrap(1_u64, amount);
    let chosen = iand(mixes, bit);
    if chosen != 0_u64 {
      let zero = tally_new();
      let tally = shared_new::<Tally>(value: zero);
      run_cell(factory: &handles, root: &cwd, args: &args, store: &store, tally: &tally, clock: &clock, threads: threads, mix: mix, dist: dist, range: size, warmup_ms: warmup_ms, duration_ms: duration_ms);
      let counted = tally_new();
      atomic total = &tally {
        set counted = total^;
      }
      set updates = updates +wrap counted.updates;
      clear_line(line: &line);
      put_number(line: &line, value: mix);
      put_number(line: &line, value: threads);
      put_number(line: &line, value: counted.ops);
      let nanoseconds = duration_ms *wrap 1000000_u64;
      put_number(line: &line, value: nanoseconds);
      put_number(line: &line, value: counted.get_misses);
      put_number(line: &line, value: counted.update_misses);
      if write_line(factory: &handles, out: &out, line: &line) {
      } else {
        close_directory(factory: &handles, directory: move cwd);
        return exit_status(code: 4_u8);
      }
    }
  }
  let missing = 0_u64;
  let total_sum = 0_u64;
  let seen = Seen(visits: 0_u64);
  atomic held = &store {
    for @check (index in 0_u64..size) {
      let key = key_of(index: index);
      match hash_map_lookup::<WordKey, u64, Seen, u64, fn read_value, ceiling>(map: &held^.map, key: &key, key_env: &held^.env, visit_env: &seen) {
        Ok(value: found) => {
          set total_sum = total_sum +wrap found;
        }
        Err(error: absent) => {
          set missing = missing +wrap 1_u64;
        }
      }
    }
  }
  let below = size -wrap 1_u64;
  let product = size *wrap below;
  let half = product / 2_u64;
  let expected = half +wrap updates;
  clear_line(line: &line);
  put_number(line: &line, value: 9_u64);
  put_number(line: &line, value: missing);
  put_number(line: &line, value: total_sum);
  put_number(line: &line, value: expected);
  if write_line(factory: &handles, out: &out, line: &line) {
  } else {
    close_directory(factory: &handles, directory: move cwd);
    return exit_status(code: 4_u8);
  }
  let churn_bit = iand(mixes, 16_u64);
  let uniform = dist == 0_u64;
  let churning = churn_bit != 0_u64;
  if band(churning, uniform) {
    let zero = tally_new();
    let tally = shared_new::<Tally>(value: zero);
    let doubled = size *wrap 2_u64;
    run_cell(factory: &handles, root: &cwd, args: &args, store: &store, tally: &tally, clock: &clock, threads: threads, mix: 4_u64, dist: dist, range: doubled, warmup_ms: warmup_ms, duration_ms: duration_ms);
    let counted = tally_new();
    atomic total = &tally {
      set counted = total^;
    }
    clear_line(line: &line);
    put_number(line: &line, value: 4_u64);
    put_number(line: &line, value: threads);
    put_number(line: &line, value: counted.ops);
    let nanoseconds = duration_ms *wrap 1000000_u64;
    put_number(line: &line, value: nanoseconds);
    put_number(line: &line, value: 0_u64);
    put_number(line: &line, value: 0_u64);
    if write_line(factory: &handles, out: &out, line: &line) {
    } else {
      close_directory(factory: &handles, directory: move cwd);
      return exit_status(code: 4_u8);
    }
    let live = 0_u64;
    atomic held = &store {
      for @count (index in 0_u64..doubled) {
        let key = key_of(index: index);
        match hash_map_lookup::<WordKey, u64, Seen, u64, fn read_value, ceiling>(map: &held^.map, key: &key, key_env: &held^.env, visit_env: &seen) {
          Ok(value: found) => {
            set live = live +wrap 1_u64;
          }
          Err(error: absent) => {
            let unused = 0_u64;
          }
        }
      }
    }
    let grown = size +wrap counted.inserted;
    let want = grown -wrap counted.removed;
    clear_line(line: &line);
    put_number(line: &line, value: 8_u64);
    put_number(line: &line, value: live);
    put_number(line: &line, value: want);
    if write_line(factory: &handles, out: &out, line: &line) {
    } else {
      close_directory(factory: &handles, directory: move cwd);
      return exit_status(code: 4_u8);
    }
  }
  close_directory(factory: &handles, directory: move cwd);
  return exit_status(code: 0_u8);
}

fn clear_line(line: &Slots<u8, 256>) -> result: unit writes(line) {
  loop @clearing {
    if line^.len > 0_u64 {
      let dropped = take_back(window: line);
    } else {
      break @clearing;
    }
  }
  return unit;
}

fn put_newline(line: &Slots<u8, 256>) -> result: unit writes(line) {
  put_byte(line: line, value: 10_u8);
  return unit;
}
