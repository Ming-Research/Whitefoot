struct Mark {
  at: u64;
  kind: u8;
}

const item_ceiling: u64 = 1073741824_u64;

fn marks_for(source: &[u64]) -> result: Box<Slots<Mark>> reads(source) {
  doc "Room for one mark per element of source, clamped to the program's ceiling as the layout code does.";
  let count = source^.len;
  let bounded = imin(count, item_ceiling);
  let marks = box_slots_new::<Mark>(capacity: bounded);
  return move marks;
}

fn main() -> status: std::process::ExitStatus pure {
  let source = box_array_filled::<u64>(count: 3_u64, value: 0_u64);
  let marks = marks_for(source: &source.inner[0_u64..3_u64]);
  if marks.inner.cap != 3_u64 {
    return std::process::exit_status(code: 1_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
