alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn equal_list(first: &[u64], second: &[u64]) -> same: Bool reads(first), reads(second) {
  let count = first^.len;
  if count != second^.len { return False(); }
  let same = True();
  for (i in 0_u64..count) {
    let item = first^[i] == second^[i];
    set same = band(same, item);
  }
  return same;
}

fn compare_rows(first: &[u64], second: &[u64], changed: &[u64], output: &[u8], width: u64) -> result: Unit reads(first), reads(second), reads(changed), writes(output) contract {
  requires width <= 4096_u64;
  requires output^.len <= 100000_u64;
  requires output^.len * width <= first^.len;
  requires first^.len == second^.len;
  requires first^.len == changed^.len;
} {
  let count = output^.len;
  for (row in 0_u64..count) {
    let start = row * width;
    let end = start + width;
    invariant covered: end <= count * width {
      use width times (row + 1_u64 <= count);
    }
    let a = &first^[start..end];
    let b = &second^[start..end];
    let c = &changed^[start..end];
    let equal = equal_list(first: a, second: b);
    let unequal = equal_list(first: a, second: c);
    let flag = if equal { give 1_u8; } else { give 0_u8; };
    let other = if unequal { give 2_u8; } else { give 0_u8; };
    set output^[row] = flag +wrap other;
  }
  return Unit();
}

fn tree(depth: u64) -> result: u64 pure {
  if depth == 0_u64 { return 1_u64; }
  let next = depth - 1_u64;
  let left = tree(depth: next);
  let right = tree(depth: next);
  return left +wrap right;
}

fn recursive_loop(input: &[u64]) -> result: u64 reads(input) {
  let total = 0_u64;
  let count = input^.len;
  for (i in 0_u64..count) {
    let value = tree(depth: input^[i]);
    set total = total +wrap value;
  }
  return total;
}

fn check_case(width: u64, count: u64) -> valid: Bool pure contract {
  requires width <= 4096_u64;
  requires count <= 100000_u64;
} {
  let size = count * width;
  let first = box_array_filled::<u64>(count: size, value: 7_u64);
  let second = box_array_filled::<u64>(count: size, value: 7_u64);
  let changed = box_array_filled::<u64>(count: size, value: 7_u64);
  if width > 0_u64 {
    for (row in 0_u64..count) {
      let end = (row + 1_u64) * width;
      invariant covered: end <= size {
        use width times (row + 1_u64 <= count);
      }
      let last = end - 1_u64;
      set changed.inner[last] = 9_u64;
    }
  }
  let output = box_array_filled::<u8>(count: count, value: 0_u8);
  let done = compare_rows(first: &first.inner[0_u64..size], second: &second.inner[0_u64..size], changed: &changed.inner[0_u64..size], output: &output.inner[0_u64..count], width: width);
  let expected = if width == 0_u64 { give 3_u8; } else { give 1_u8; };
  let valid = True();
  for (i in 0_u64..count) {
    let flag = output.inner[i] == expected;
    set valid = band(valid, flag);
  }
  return valid;
}

fn main() -> status: ExitStatus pure {
  let empty = check_case(width: 0_u64, count: 32_u64);
  let singleton = check_case(width: 1_u64, count: 32_u64);
  let small = check_case(width: 8_u64, count: 32_u64);
  let large = check_case(width: 4096_u64, count: 32_u64);
  let depths = array_filled::<u64, 2>(value: 3_u64);
  let first = recursive_loop(input: &depths[0_u64..2_u64]);
  let second = recursive_loop(input: &depths[0_u64..2_u64]);
  if band(band(empty, singleton), band(small, large)) {
    if first == 16_u64 { if second == 16_u64 { return exit_status(code: 0_u8); } }
  }
  return exit_status(code: 1_u8);
}
