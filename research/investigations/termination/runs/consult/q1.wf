alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn pick(count: u64) -> result: Option<u64> pure contract {
  ensures when Some(value: p): p < count;
} {
  if count > 0_u64 {
    return Some<u64>(value: 0_u64);
  }
  return None<u64>();
}

fn walk(table: &Slots<Slots<u64, 4>, 8>) -> result: u64 reads(table) {
  let count = table^.len;
  match pick(count: count) {
    Some(value: p) => {
      let before = table^[p].len;
      let after = table^[p].len;
      invariant same: after <= before;
      invariant direct: table^[p].len <= before;
      return after;
    }
    None() => {
      return 0_u64;
    }
  }
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
