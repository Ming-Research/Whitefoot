alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn drain() -> result: u64 pure {
  let stack = slots_new::<u64, 8>();
  place_back(window: &stack, value: 1_u64);
  place_back(window: &stack, value: 2_u64);
  let total = 0_u64;
  loop @pop {
    let n = stack.len;
    let empty = n == 0_u64;
    if empty {
      break @pop;
    }
    let before = stack.len;
    let v = take_back(window: &stack);
    set total = total +wrap v;
    let after = stack.len;
    invariant progress: after < before;
  }
  return total;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
