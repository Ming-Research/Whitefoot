fn fill(item: u64, salt: u64, window: &[Cmd]) -> result: unit writes(window) {
  let count = window^.len;
  for (at in 0_u64..count) {
    let made = command(item: item, at: at, salt: salt);
    set window^[at] = made;
  }
  return unit;
}

fn fill_run(offsets: &[u64], first: u64, salt: u64, out: &[Cmd]) -> consistent: Bool reads(offsets), writes(out) {
  let count = offsets^.len;
  if count < 2_u64 {
    return True();
  }
  if count == 2_u64 {
    fill(item: first, salt: salt, window: out);
    return True();
  }
  let half = count / 2_u64;
  let base = offsets^[0_u64];
  let split = offsets^[half];
  let ordered = base <= split;
  if ordered {
  } else {
    return False();
  }
  let cut = split - base;
  let inside = cut <= out^.len;
  if inside {
  } else {
    return False();
  }
  let length = out^.len;
  let middle = first +wrap half;
  let upto = half + 1_u64;
  let left = fill_run(offsets: &offsets^[0_u64..upto], first: first, salt: salt, out: &out^[0_u64..cut]);
  let right = fill_run(offsets: &offsets^[half..count], first: middle, salt: salt, out: &out^[cut..length]);
  let both = band(left, right);
  return both;
}

fn once(salt: u64) -> sum: u64 pure {
  let counts = box_array_filled::<u64>(count: items, value: 0_u64);
  for (i in 0_u64..items) {
    let count = count_of(item: i);
    set counts.inner[i] = count;
  }
  let slots = items + 1_u64;
  let offsets = box_array_filled::<u64>(count: slots, value: 0_u64);
  let running = 0_u64;
  for (i in 0_u64..items) {
    set running = running +wrap counts.inner[i];
    let next = i + 1_u64;
    set offsets.inner[next] = running;
  }
  let fits = running <= 1073741824_u64;
  let size = if fits {
    give running;
  } else {
    give 0_u64;
  }
  let zero = Cmd(kind: 0_u64, a: 0_u64, b: 0_u64, c: 0_u64);
  let out = box_array_filled::<Cmd>(count: size, value: zero);
  let consistent = fill_run(offsets: &offsets.inner[0_u64..slots], first: 0_u64, salt: salt, out: &out.inner[0_u64..size]);
  let sum = checksum(out: &out.inner[0_u64..size]);
  return sum;
}

fn main() -> status: std::process::ExitStatus pure {
  let total = 0_u64;
  for (rep in 0_u64..reps) {
    let one = once(salt: total);
    set total = one;
  }
  let low = cvt.wrap::<u64, u8>(total);
  return std::process::exit_status(code: low);
}
