alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn consume_shift(amount: i64) -> result: i64 pure contract {
  requires 0_i64 <= amount;
  requires amount <= 1080_i64;
  ensures result == 0_i64;
} {
  doc "Expected refusal, not run: INV-1 on the next-header proof of remaining_ceiling. Subtracting min(remaining, 60) consumes at most eighteen chunks, but the published min rows bound its result above by each operand without expressing the lower relation needed here.";
  let remaining = amount;
  for (
    step in 0_u64..18_u64,
    invariant remaining_floor: 0_i64 <= remaining,
    invariant remaining_ceiling: remaining <= 1080_i64 - 60_i64 * step
  ) {
    if 0_i64 < remaining {
      let chunk = imin(remaining, 60_i64);
      set remaining = remaining - chunk;
    }
  }
  return remaining;
}

fn main() -> status: ExitStatus pure {
  let remaining = consume_shift(amount: 1076_i64);
  if remaining == 0_i64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
