struct Decimal {
  doc "The same one-digit storage as the field-guard witness.";
  digits: Array<u8, 1>;
  count: u64;
}

fn set_first(decimal: &Decimal, count: u64) -> result: unit writes(decimal.digits) contract {
  ensures forall leading(k in 0_u64..1_u64) when 0_u64 < count: 1_u8 <= decimal^.digits[k];
} {
  doc "Sets the sole digit to one. Predicted acceptance: the guard names an own-mode integer parameter admitted by RANGE-1, and the write establishes the indexed conclusion for the sole quantified index. This prediction has not been checked. The separate count parameter isolates term admission; no equality with decimal^.count or behavioral equivalence is assumed. Check this source with whitefootc --check; it has no executable entry.";
  set decimal^.digits[0_u64] = 1_u8;
  return unit;
}
