fn assign_digits(input: &[u8]) -> result: Array<u8, 2> reads(input) contract {
  requires input^.len == 2_u64;
  requires forall small(k in 0_u64..2_u64): input^[k] <= 9_u8;
  requires forall nonzero(k in 1_u64..2_u64): 1_u8 <= input^[k];
  ensures forall leading(k in 0_u64..1_u64): 1_u8 <= result[k];
} {
  doc "Predicted RANGE-3 refusal at return, not compiled: skipping leading zeros makes the first stored digit nonzero, but the loop states only its count bound and carries no leading-digit invariant. The second input digit is nonzero, so the output is nonempty even when the first input digit is zero. This isolates the scan's missing induction fact without a field in a range guard, parsing, trimming, or helper calls; it does not show that the language cannot express that induction fact.";
  let digits = array_filled::<u8, 2>(value: 0_u8);
  let held = 0_u64;
  for (
    position in 0_u64..2_u64,
    invariant held_bound: held <= position
  ) {
    let digit = input^[position];
    let zero_digit = digit == 0_u8;
    let nothing_held = held == 0_u64;
    let skip = band(zero_digit, nothing_held);
    if skip {
    } else {
      set digits[held] = digit;
      set held = held + 1_u64;
    }
  }
  return digits;
}
