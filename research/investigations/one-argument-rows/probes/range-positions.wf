fn mixed(part: &[u8], a: u64, b: u64, k: u64) -> result: unit reads(part[a..b]), writes(part[k]) contract {
  requires a < b;
  requires b <= deref(part).len;
  requires k < deref(part).len;
} {
  let sub = &deref(part)[a..b];
  let first = deref(sub)[0_u64];
  set deref(part)[k] = first;
  return unit;
}

fn main() -> status: ExitStatus pure {
  let values = array_filled::<u8, 4>(value: 1_u8);
  mixed(part: &values[0_u64..4_u64], a: 0_u64, b: 2_u64, k: 3_u64);
  return exit_status(code: 0_u8);
}
