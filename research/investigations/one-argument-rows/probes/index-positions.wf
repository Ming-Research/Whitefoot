fn copy_within(values: &Array<u8, 4>, i: u64, j: u64) -> result: unit reads(values[i]), writes(values[j]) contract {
  requires i < 4_u64;
  requires j < 4_u64;
} {
  let observed = deref(values)[i];
  set deref(values)[j] = observed;
  return unit;
}

fn main() -> status: ExitStatus pure {
  let values = array_filled::<u8, 4>(value: 1_u8);
  copy_within(values: &values, i: 1_u64, j: 1_u64);
  return exit_status(code: 0_u8);
}
