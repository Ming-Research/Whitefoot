alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn pop(window: &Slots<Box<u64>, 4>) -> value: Box<u64> writes(window.last), writes(window.len) contract {
  requires deref(window).len > 0_u64;
} {
  let v = take_back(window: window);
  return move v;
}

fn main() -> status: ExitStatus pure {
  let r = slots_new::<Box<u64>, 4>();
  let a = box_new::<u64>(value: 1_u64);
  let b = box_new::<u64>(value: 2_u64);
  let c = box_new::<u64>(value: 3_u64);
  place_back(window: &r, value: move a);
  place_back(window: &r, value: move b);
  let part = &r[0_u64..2_u64];
  let x = pop(window: &r);
  set deref(part)[1_u64] = move c;
  let d = box_new::<u64>(value: 100_u64);
  set x.inner = 55_u64;
  if d.inner == 55_u64 {
    return exit_status(code: 42_u8);
  }
  return exit_status(code: 0_u8);
}
