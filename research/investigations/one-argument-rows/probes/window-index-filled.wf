fn remove_after_read(window: &Slots<u64, 4>, i: u64) -> result: u64 reads(window[i]), writes(window.filled), writes(window.len) contract {
  requires i < deref(window).len;
} {
  let observed = deref(window)[i];
  let removed = remove_at(window: window, index: i);
  return observed +wrap removed;
}

fn main() -> status: ExitStatus pure {
  let window = slots_new::<u64, 4>();
  place_back(window: &window, value: 5_u64);
  place_back(window: &window, value: 6_u64);
  let sum = remove_after_read(window: &window, i: 0_u64);
  if sum == 10_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
