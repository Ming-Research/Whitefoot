fn settle_run(part: &[u64], k: u64) -> result: unit reads(part), writes(part[k]) contract {
  requires 0_u64 < deref(part).len;
  requires k < deref(part).len;
} {
  let first = deref(part)[0_u64];
  set deref(part)[k] = first +wrap 1_u64;
  return unit;
}

fn main() -> status: ExitStatus pure {
  let values = array_filled::<u64, 8>(value: 4_u64);
  for (i in 0_u64..4_u64) {
    let lo = i * 2_u64;
    let hi = lo + 2_u64;
    settle_run(part: &values[lo..hi], k: 1_u64);
  }
  let seen = values[7_u64];
  if seen == 5_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
