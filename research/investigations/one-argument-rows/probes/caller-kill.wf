struct Stats {
  count: u64;
  total: u64;
}

fn record(stats: &Stats) -> result: unit reads(stats), writes(stats.count) {
  let whole = deref(stats);
  set deref(stats).count = whole.total;
  return unit;
}

fn main() -> status: ExitStatus pure {
  let table = array_filled::<u8, 10>(value: 0_u8);
  let stats = Stats(count: 3_u64, total: 50_u64);
  let before = stats.count;
  if before < 10_u64 {
    record(stats: &stats);
    let after = stats.count;
    let seen = table[after];
  }
  return exit_status(code: 0_u8);
}
