struct Cell {
  count: u64;
  total: u64;
}

fn settle(cell: &Cell) -> result: unit reads(cell), writes(cell.count) {
  let whole = deref(cell);
  set deref(cell).count = whole.total +wrap 1_u64;
  return unit;
}

fn main() -> status: ExitStatus pure {
  let initial = Cell(count: 0_u64, total: 4_u64);
  let cells = array_filled::<Cell, 8>(value: initial);
  for (i in 0_u64..8_u64) {
    settle(cell: &cells[i]);
  }
  let last = cells[7_u64];
  let seen = last.count;
  if seen == 5_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
