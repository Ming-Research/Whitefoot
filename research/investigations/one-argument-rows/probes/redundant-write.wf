struct Stats {
  count: u64;
  total: u64;
}

fn reset(stats: &Stats) -> result: unit writes(stats), writes(stats.count) {
  set deref(stats).count = 1_u64;
  set deref(stats) = Stats(count: 0_u64, total: 0_u64);
  return unit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
