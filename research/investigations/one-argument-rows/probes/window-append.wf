fn push_copy(window: &Slots<u64, 4>) -> result: unit reads(window), writes(window.next), writes(window.len) contract {
  requires 0_u64 < deref(window).len;
  requires deref(window).len < deref(window).cap;
} {
  let first = deref(window)[0_u64];
  place_back(window: window, value: first);
  return unit;
}

fn main() -> status: ExitStatus pure {
  let window = slots_new::<u64, 4>();
  place_back(window: &window, value: 5_u64);
  push_copy(window: &window);
  let length = window.len;
  if 1_u64 < length {
    let seen = window[1_u64];
    if seen == 5_u64 {
    } else {
      return exit_status(code: 1_u8);
    }
  } else {
    return exit_status(code: 2_u8);
  }
  return exit_status(code: 0_u8);
}
