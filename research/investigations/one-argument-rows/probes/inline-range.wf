fn fill(part: &[u8], k: u64) -> result: unit reads(part), writes(part[k]) contract {
  requires 0_u64 < deref(part).len;
  requires k < deref(part).len;
} {
  let first = deref(part)[0_u64];
  set deref(part)[k] = first;
  return unit;
}

fn main() -> status: ExitStatus pure {
  let values = array_filled::<u8, 4>(value: 1_u8);
  set values[0_u64] = 5_u8;
  fill(part: &values[0_u64..4_u64], k: 2_u64);
  let seen = values[2_u64];
  if seen == 5_u8 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
