struct Stats {
  count: u64;
  total: u64;
}

fn record(stats: &Stats) -> result: unit reads(stats), writes(stats.count) {
  let whole = deref(stats);
  set deref(stats).count = whole.total;
  return unit;
}

fn observe(count: &u64) -> result: u64 reads(count) {
  return deref(count);
}

fn main() -> status: ExitStatus pure {
  let first = Stats(count: 0_u64, total: 3_u64);
  record(stats: &first);
  let seen = observe(count: &first.count);
  if seen == 3_u64 {
  } else {
    return exit_status(code: 1_u8);
  }
  return exit_status(code: 0_u8);
}
