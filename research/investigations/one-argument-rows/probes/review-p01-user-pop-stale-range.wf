alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn pop(window: &Slots<u64, 4>) -> value: u64 writes(window.last), writes(window.len) contract {
  requires deref(window).len > 0_u64;
} {
  let v = take_back(window: window);
  return v;
}

fn main() -> status: ExitStatus pure {
  let r = slots_new::<u64, 4>();
  place_back(window: &r, value: 1_u64);
  place_back(window: &r, value: 2_u64);
  let part = &r[0_u64..2_u64];
  let x = pop(window: &r);
  let y = deref(part)[1_u64];
  if y == 2_u64 {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 1_u8);
}
