fn small(x: u64) -> result: u64 pure contract {
  requires x < 10_u64;
} {
  return x;
}

fn caller(y: u64) -> result: u64 pure {
  if y < 10_u64 {
    let r = small(x: y);
    return r;
  }
  return 0_u64;
}

fn main() -> status: ExitStatus pure {
  let r = caller(y: 3_u64);
  return exit_status(code: 0_u8);
}
