fn small(x: u64) -> result: u64 pure contract {
  requires x < 10_u64;
} {
  return x;
}

fn helper() -> result: u64 pure contract {
  requires 20_u64 < 10_u64;
} {
  let r = small(x: 20_u64);
  return r;
}

fn main() -> status: ExitStatus pure {
  let r = helper();
  return exit_status(code: 0_u8);
}
