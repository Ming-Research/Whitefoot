fn not_four(value: u64) -> result: unit pure contract {
  requires value != 4_u64;
} {
  return unit;
}

fn probe(x: u64) -> result: unit pure contract {
  requires x != 2_u64;
  requires x <= 1000_u64;
} {
  doc "x != 2 gives 2 * x != 4: the theory step solves the equation 2 * x = 4 over the integers and finds only x = 2.";
  let doubled = 2_u64 * x;
  not_four(value: doubled);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
