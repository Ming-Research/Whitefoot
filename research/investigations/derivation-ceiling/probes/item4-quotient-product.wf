fn at_most(value: u64, limit: u64) -> result: unit pure contract {
  requires value <= limit;
} {
  return unit;
}

fn probe(total: u64, divisor: u64) -> result: unit pure contract {
  requires 1_u64 <= divisor;
} {
  doc "Item 4: q = a / d gives d * q <= a, which bounds the product's IntegerDomain goal and the later bound.";
  let quotient = total / divisor;
  let product = quotient * divisor;
  at_most(value: product, limit: total);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
