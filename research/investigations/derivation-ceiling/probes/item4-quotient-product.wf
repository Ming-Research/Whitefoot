fn at_most_nine(value: u64) -> result: unit pure contract {
  requires value <= 9_u64;
} {
  return unit;
}

fn probe(total: u64, divisor: u64) -> result: unit pure contract {
  requires 1_u64 <= divisor;
  requires divisor <= 1152921504606846976_u64;
  requires total < 10_u64 * divisor;
} {
  doc "Item 4: the goal quotient <= 9 on q = total / divisor is rewritten to total <= 10 * divisor - 1, which the requirement gives.";
  let quotient = total / divisor;
  at_most_nine(value: quotient);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
