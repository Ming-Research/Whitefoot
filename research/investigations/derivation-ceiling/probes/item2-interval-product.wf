fn at_most(value: u64, limit: u64) -> result: unit pure contract {
  requires value <= limit;
} {
  return unit;
}

fn probe(left: u64, right: u64) -> result: unit pure contract {
  requires left <= 10_u64;
  requires right <= 20_u64;
} {
  doc "Item 2: the product of two operands that are not constants is bounded by the product of their intervals, for its own IntegerDomain goal and for the later bound.";
  let product = left * right;
  at_most(value: product, limit: 200_u64);
  return unit;
}

fn main() -> status: std::process::ExitStatus pure {
  return std::process::exit_status(code: 0_u8);
}
