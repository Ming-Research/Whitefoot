alias Task = pkg::data::Job;

fn new_storage() -> storage: Ring<Task, capacity> pure contract {
  ensures storage.len == 0_u64;
} {
  doc "A module-private constructor used by operations.wf. No declaration in this directory's module.wfm is needed for this internal call, and the ring's capacity equals the constant capacity as a standing fact of its type.";
  let built = ring_new::<Task, capacity>();
  return move built;
}
