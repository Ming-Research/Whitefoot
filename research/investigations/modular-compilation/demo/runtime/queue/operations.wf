alias Work = pkg::data::Job;

fn new() -> made: Queue pure contract {
  ensures made.storage.len == 0_u64;
} {
  doc "The helper's postcondition reaches storage at its result destination, and the CONSTRUCT placement carries the ring's length into the queue this function returns.";
  let storage = new_storage();
  let built = Queue(storage: move storage);
  return move built;
}

fn push(queue: &Queue, job: Work) -> result: unit writes(queue.storage) contract {
  requires queue^.storage.len < capacity;
  ensures queue^.storage.len == entry(queue)^.storage.len + 1_u64;
} {
  doc "The readonly storage field is an ordinary writable field here, because this module declares it.";
  place_back(window: &queue^.storage, value: job);
  return unit;
}

fn pop(queue: &Queue) -> job: Work writes(queue.storage) contract {
  requires queue^.storage.len > 0_u64;
  ensures queue^.storage.len + 1_u64 == entry(queue)^.storage.len;
} {
  let taken = take_front(window: &queue^.storage);
  return taken;
}
