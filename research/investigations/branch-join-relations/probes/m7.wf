alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn probe(table: &Slots<u8, 4>, lo: u64, hi: u64) -> found: u8 reads(table) contract {
  define spare = table^.len;
  requires lo < hi;
  requires hi <= spare;
} {
  let span = hi - lo;
  let half = ishr(span, 1_u32);
  let mid = lo + half;
  let byte = table^[mid];
  return byte;
}

fn main() -> status: ExitStatus pure {
  let values = array_filled::<u8, 4>(value: 0_u8);
  let table = slots_from_array::<u8, 4>(values: values);
  let found = probe(table: &table, lo: 0_u64, hi: 4_u64);
  return exit_status(code: found);
}
