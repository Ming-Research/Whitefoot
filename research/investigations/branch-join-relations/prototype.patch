+impl Reasoning<'_, '_, '_> {
+    /// Prototype (a): every affine premise whose coefficient vector is the
+    /// difference of two L0 candidates' current images becomes that L0
+    /// difference bound in this join input, so the ordinary L0 join keeps the
+    /// weakest common bound over the joined terms.
+    pub(super) fn project_affine_differences(&mut self, state: &mut ProofFlowState) {
+        let candidates = self.affine_l0_candidates(&state.affine);
+        let mut by_vector: HashMap<Vec<super::super::affine::AffineCoefficient>, Vec<(TermId, TermId, i128)>> =
+            HashMap::new();
+        for x in &candidates {
+            for y in &candidates {
+                if x.term == y.term {
+                    continue;
+                }
+                let Ok(difference) = x.value.subtract(&y.value, &mut AffineCheckState::new()) else {
+                    continue;
+                };
+                if difference.terms().is_empty() {
+                    continue;
+                }
+                by_vector
+                    .entry(difference.terms().to_vec())
+                    .or_default()
+                    .push((x.term, y.term, difference.constant_value()));
+            }
+        }
+        let premises = canonical_affine_facts(&state.affine.facts)
+            .into_iter()
+            .map(|fact| fact.inequality.clone())
+            .collect::<Vec<_>>();
+        let mut projected = Vec::new();
+        for inequality in premises {
+            let Some(pairs) = by_vector.get(inequality.terms()) else {
+                continue;
+            };
+            for (left, right, constant) in pairs {
+                let Some(bound) = inequality.upper().checked_add(*constant) else {
+                    continue;
+                };
+                projected.push(Relation::Bound {
+                    left: *left,
+                    right: *right,
+                    bound,
+                });
+            }
+        }
+        if projected.is_empty() {
+            return;
+        }
+        let event = self.vocabulary.proof_event(FlowEventKind::S4, None);
+        for relation in projected {
+            state
+                .facts
+                .establish(&relation, &mut self.vocabulary.derivations, event);
+        }
+    }
+}
