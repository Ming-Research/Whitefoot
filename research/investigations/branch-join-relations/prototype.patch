+impl Reasoning<'_, '_, '_> {
+    /// Prototype (b): a proved invariant target whose source normalization is
+    /// one unit-coefficient difference bound over live bindings, measure terms
+    /// and constants is also established as that L0 relation over the current
+    /// place terms, with their ordinary support, as S4 does for a requirement.
+    pub(super) fn project_invariant_l0(
+        &mut self,
+        relation: &CheckedAffineRelation,
+        facts: &mut FactState,
+    ) {
+        let mut relations = Vec::new();
+        if let Some(first) = self.checked_affine_relation_l0(relation) {
+            relations.push(first);
+        }
+        if relation.equality {
+            let swapped = CheckedAffineRelation {
+                node_path: relation.node_path.clone(),
+                left: relation.right.clone(),
+                right: relation.left.clone(),
+                bound: 0,
+                equality: false,
+            };
+            if let Some(second) = self.checked_affine_relation_l0(&swapped) {
+                relations.push(second);
+            }
+        }
+        if relations.is_empty() {
+            return;
+        }
+        let event = self
+            .vocabulary
+            .proof_event(FlowEventKind::S4, Some(&relation.node_path));
+        for relation in relations {
+            if let Relation::Bound { left, right, .. } = relation
+                && left == ZERO
+                && right == ZERO
+            {
+                continue;
+            }
+            facts.establish(&relation, &mut self.vocabulary.derivations, event);
+        }
+    }
+}
