+/// Research prototype switches for the branch-join investigation. Each reads
+/// one environment variable once; every switch off is the unmodified checker.
+pub(crate) mod proto {
+    use std::sync::OnceLock;
+    fn flag(cell: &'static OnceLock<bool>, name: &str) -> bool {
+        *cell.get_or_init(|| std::env::var_os(name).is_some_and(|value| value == "1"))
+    }
+    /// (b) a proved invariant's unit-coefficient target is also an L0 fact.
+    pub(crate) fn join_b() -> bool {
+        static CELL: OnceLock<bool> = OnceLock::new();
+        flag(&CELL, "WF_JOIN_B")
+    }
+    /// (a) at every join input, project affine premises that are a difference
+    /// of two candidates' current images into L0 before the L0 join.
+    pub(crate) fn join_a() -> bool {
+        static CELL: OnceLock<bool> = OnceLock::new();
+        flag(&CELL, "WF_JOIN_A")
+    }
+    /// (a+) at every join input, bound every pair of candidates, one of whose
+    /// images differs across the inputs, by the tightest constant AUTO's
+    /// families prove, and establish it in L0 before the L0 join.
+    pub(crate) fn join_ap() -> bool {
+        static CELL: OnceLock<bool> = OnceLock::new();
+        flag(&CELL, "WF_JOIN_AP")
+    }
+    /// S7: `/` and `ishr` publish `r < a` when a0 >= 1 and the divisor or
+    /// shift is at least 2 or 1.
+    pub(crate) fn mid_div() -> bool {
+        static CELL: OnceLock<bool> = OnceLock::new();
+        flag(&CELL, "WF_MID_DIV")
+    }
+    /// S7: exact `-` result bounds also read the operands' closed difference.
+    pub(crate) fn mid_sub() -> bool {
+        static CELL: OnceLock<bool> = OnceLock::new();
+        flag(&CELL, "WF_MID_SUB")
+    }
+
+}
