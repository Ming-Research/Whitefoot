alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn walk(room: u64, t0: u64, c: u64) -> r: u64 pure {
  doc "One invariant; one path sets j from a guarded value, the other leaves j.";
  let j = 0_u64;
  loop (
    invariant jb: j <= room
  ) {
    let t = t0;
    if c == 1_u64 {
      if t <= room {
        set j = t;
      } else {
        return j;
      }
    } else if c == 2_u64 {
      return j;
    }
  }
  return j;
}

fn main() -> status: ExitStatus pure {
  let r = walk(room: 5_u64, t0: 1_u64, c: 3_u64);
  return exit_status(code: 0_u8);
}
