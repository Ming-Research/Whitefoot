alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Entry {
  value: u64;
}

struct State {
  map: KeyedTable<Entry>;
  log: u64;
}

const names: Array<u8, 2> =[97_u8, 98_u8];

struct Vm {
  acc: u64;
}

interface Host<E> {
  fn call(env: &E, vm: &Vm, op: u64) -> r: u64 writes(env), writes(vm);
}

fn run<interface Host<E>>(vm: &Vm, env: &E) -> r: u64 writes(vm), writes(env) {
  let got = Host::call(env: env, vm: vm, op: 1_u64);
  return got;
}

fn entries_call(env: &KeyedEntries<Entry>, vm: &Vm, op: u64) -> r: u64 writes(env), writes(vm) {
  let n = 0_u64;
  if op < env^.len {
    let e = Entry(value: 7_u64);
    set env^[op] = Some<Entry>(value: e);
  }
  set vm^.acc = n;
  return n;
}

binding EntriesHost : Host<KeyedEntries<Entry>> {
  call = entries_call;
}

fn main() -> status: ExitStatus pure waits {
  let table = keyed_table_new::<Entry>(capacity: 4_u64);
  let state = State(map: move table, log: 0_u64);
  let h = shared_new::<State>(value: move state);
  let vm = Vm(acc: 0_u64);
  let keys = key_set_new(capacity: 2_u64);
  key_set_put(keys: &keys, key: &names[0_u64..1_u64], payload: 0_u64);
  key_set_put(keys: &keys, key: &names[1_u64..2_u64], payload: 1_u64);
  let out = 0_u64;
  atomic s = &h, slots = &s^.map[keys] {
    set out = run::<EntriesHost>(vm: &vm, env: slots);
    set s^.log = out;
  }
  return exit_status(code: 0_u8);
}
