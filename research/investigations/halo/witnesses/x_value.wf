alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

struct Table {
  array: Box<Slots<Value>>;
  meta: Option<Box<Table>>;
}

enum Value {
  Nil();
  Number(n: f64);
  Text(bytes: Box<Array<u8>>);
  Tab(t: Box<Table>);
}

fn depth(v: &Value) -> d: u64 reads(v) {
  match v^ {
    Tab(t: held) => {
      let n = held^.inner.array.inner.len;
      return n;
    }
    Nil() => {
      return 0_u64;
    }
    Number(n: x) => {
      return 1_u64;
    }
    Text(bytes: b) => {
      return 2_u64;
    }
  }
}

fn main() -> status: ExitStatus pure {
  let v = Value::Nil();
  let d = depth(v: &v);
  return exit_status(code: 0_u8);
}
