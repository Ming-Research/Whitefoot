alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;
alias Inputs = std::process::Inputs;
alias Clock = std::time::Clock;
alias Instant = std::time::Instant;

struct State {
  count: u64;
}

struct Flag {
  stop: Bool;
}

fn script(state: &State, clock: &Clock, deadline: Instant) -> killed: Bool writes(state), writes(clock) {
  loop {
    let t = std::time::now(clock: clock);
    let late = std::time::instant_reached(deadline: deadline, instant: t);
    if late {
      return True();
    }
    set state^.count = state^.count +wrap 1_u64;
  }
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  let Inputs(args: a, cwd: c, stdout: o, stderr: e, handles: hf, stdin: i, clock: clock, wall_clock: w, stops: unused_stops, memory_meter: unused_memory_meter) = move inputs;
  let st = State(count: 0_u64);
  let h = shared_new::<State>(value: st);
  let no = False();
  let fl = Flag(stop: no);
  let flag = shared_new::<Flag>(value: fl);
  let start = std::time::now(clock: &clock);
  let deadline = std::time::instant_after(instant: start, nanoseconds: 5000000_u64);
  let killed = False();
  atomic s = &h {
    set killed = script(state: s, clock: &clock, deadline: deadline);
  }
  atomic s = &h {
    let seen = False();
    atomic f = &flag {
      set seen = f^.stop;
    }
  }
  return exit_status(code: 0_u8);
}
