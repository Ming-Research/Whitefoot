alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}

enum Op {
  Jump(target: u64);
  Halt();
}

fn inspect(code: &Array<Op, 4>) -> r: u64 reads(code) contract {
  requires forall valid(j in 0_u64..4_u64): code^[j].Jump.target < 4_u64;
} {
  let n = code^.len;
  return n;
}
