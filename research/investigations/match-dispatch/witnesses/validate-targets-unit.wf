alias ExitStatus = std::process::ExitStatus;
alias exit_status = std::process::exit_status;

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}

fn validate(targets: &Array<u64, 4>) -> r: Result<unit, NarrowError> reads(targets) contract {
  ensures when Ok(value: count): forall valid(j in 0_u64..4_u64): targets^[j] < 4_u64;
} {
  for (
    i in 0_u64..4_u64,
    invariant forall prefix(j in 0_u64..i): targets^[j] < 4_u64
  ) {
    let t = targets^[i];
    if t >= 4_u64 {
      let error = NarrowError();
      return Err<unit, NarrowError>(error: error);
    }
  }
  return Ok<unit, NarrowError>(value: unit);
}
