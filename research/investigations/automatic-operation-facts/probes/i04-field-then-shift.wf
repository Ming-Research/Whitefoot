fn middle_nibble_digit(word: u32) -> result: u8 pure {
  let digits = array_filled::<u8, 16>(value: 48_u8);
  let field = iand(word, 3840_u32);
  let nibble = ishr(field, 8_u32);
  let index = cvt::<u32, u64>(nibble);
  let digit = digits[index];
  return digit;
}

fn main() -> status: ExitStatus pure {
  return exit_status(code: 0_u8);
}
