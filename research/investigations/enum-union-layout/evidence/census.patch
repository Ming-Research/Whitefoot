+// CENSUS (temporary): enums a union layout would change under the hybrid rule.
+thread_local! {
+    pub(crate) static CENSUS_SITE: std::cell::RefCell<String> = std::cell::RefCell::new(String::new());
+}
+
+pub(crate) fn census_set(site: &str) {
+    CENSUS_SITE.with(|cell| *cell.borrow_mut() = site.to_owned());
+}
+
+pub(crate) fn census_site() -> String {
+    CENSUS_SITE.with(|cell| cell.borrow().clone())
+}
+
+pub(crate) fn census_union_enum(program: &IrProgram, ty: IrType) -> bool {
+    let IrType::Nominal(id) = ty else { return false };
+    let Some(nominal) = program.nominal(id) else { return false };
+    let IrNominalKind::Enum { variants } = nominal.kind() else { return false };
+    variants.iter().filter(|variant| !variant.fields().is_empty()).count() >= 2
+        && !fits_return_registers(program, ty).unwrap_or(true)
+}
+
+pub(crate) fn census_contains(program: &IrProgram, ty: IrType, depth: u32) -> bool {
+    if depth > 16 {
+        return false;
+    }
+    if census_union_enum(program, ty) {
+        return true;
+    }
+    match ty {
+        IrType::Array { element, .. } | IrType::Window { element, capacity: Some(_), .. } => program
+            .element(element)
+            .is_some_and(|element| census_contains(program, element, depth + 1)),
+        IrType::Nominal(id) => match program.nominal(id).map(|nominal| nominal.kind()) {
+            Some(IrNominalKind::Struct { fields }) => fields
+                .iter()
+                .any(|field| census_contains(program, field.ty(), depth + 1)),
+            Some(IrNominalKind::Enum { variants }) => variants
+                .iter()
+                .flat_map(|variant| variant.fields())
+                .any(|field| census_contains(program, field.ty(), depth + 1)),
+            _ => false,
+        },
+        _ => false,
+    }
+}
