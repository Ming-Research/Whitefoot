+// CENSUS (temporary): product versus per-variant union layout of every enum
+// with at least two payload-carrying variants.
+pub(crate) fn census_enum_layouts(program: &crate::IrProgram, target: TargetLayout) -> Vec<String> {
+    let mut product = LayoutComputer::new(target, program.nominals(), program.elements());
+    let mut union = LayoutComputer::new(target, program.nominals(), program.elements());
+    let mut lines = Vec::new();
+    for (index, nominal) in program.nominals().iter().enumerate() {
+        let IrNominalKind::Enum { variants } = nominal.kind() else { continue };
+        let payload = variants.iter().filter(|variant| !variant.fields().is_empty()).count();
+        if payload < 2 {
+            continue;
+        }
+        let Ok(id) = u32::try_from(index) else { continue };
+        let id = IrNominalId(id);
+        let Ok(p) = product.layout(IrType::Nominal(id)) else { continue };
+        let Ok(u) = union.union_layout(id) else { continue };
+        lines.push(format!(
+            "census-layout {} {} variants={} payload_variants={} product={} union={} align={} product_fits_registers={}",
+            nominal.link_name(),
+            nominal.stable_spelling().unwrap_or(&nominal.name).replace(' ', ""),
+            variants.len(),
+            payload,
+            p.size,
+            u.size,
+            u.align,
+            crate::backend::abi::fits_return_registers(program, IrType::Nominal(id)).unwrap_or(false)
+        ));
+    }
+    lines
+}
+
+impl LayoutComputer<'_> {
+    fn union_field(&mut self, ty: IrType) -> Result<Layout, TargetLayoutFailure> {
+        if let IrType::Nominal(id) = ty {
+            if let Some(nominal) = self.nominals.get(id.index()) {
+                if let IrNominalKind::Enum { variants } = nominal.kind() {
+                    if variants.iter().any(|variant| !variant.fields().is_empty()) {
+                        return self.union_layout(id);
+                    }
+                }
+                if let IrNominalKind::Struct { fields } = nominal.kind() {
+                    let mut layouts = Vec::new();
+                    for field in fields.clone() {
+                        layouts.push(self.union_field(field.ty())?);
+                    }
+                    return self.aggregate_layout(layouts, TargetObject::Representation);
+                }
+            }
+        }
+        self.layout(ty)
+    }
+
+    fn union_layout(&mut self, id: IrNominalId) -> Result<Layout, TargetLayoutFailure> {
+        let nominal = self.nominals.get(id.index()).ok_or(TargetLayoutFailure::InvalidIr)?;
+        let IrNominalKind::Enum { variants } = nominal.kind() else {
+            return Err(TargetLayoutFailure::InvalidIr);
+        };
+        let mut size = 0_u64;
+        let mut align = 1_u64;
+        for variant in variants.clone() {
+            let mut layouts = vec![Layout { size: 4, align: 4 }];
+            for field in variant.fields() {
+                layouts.push(self.union_field(field.ty())?);
+            }
+            let view = self.aggregate_layout(layouts, TargetObject::Representation)?;
+            size = size.max(view.size);
+            align = align.max(view.align);
+        }
+        let size = align_up(self.target, size, align, TargetObject::Representation)?;
+        Ok(Layout { size, align })
+    }
+}
