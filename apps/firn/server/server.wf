const option_bind: Array<u8, 4> =[66_u8, 73_u8, 78_u8, 68_u8];

const option_timeout: Array<u8, 7> =[84_u8, 73_u8, 77_u8, 69_u8, 79_u8, 85_u8, 84_u8];

const option_appendonly: Array<u8, 10> =[65_u8, 80_u8, 80_u8, 69_u8, 78_u8, 68_u8, 79_u8, 78_u8, 76_u8, 89_u8];

const option_appendfilename: Array<u8, 14> =[65_u8, 80_u8, 80_u8, 69_u8, 78_u8, 68_u8, 70_u8, 73_u8, 76_u8, 69_u8, 78_u8, 65_u8, 77_u8, 69_u8];

const option_requirepass: Array<u8, 11> =[82_u8, 69_u8, 81_u8, 85_u8, 73_u8, 82_u8, 69_u8, 80_u8, 65_u8, 83_u8, 83_u8];

const option_clients: Array<u8, 7> =[67_u8, 76_u8, 73_u8, 69_u8, 78_u8, 84_u8, 83_u8];

const word_yes: Array<u8, 3> =[89_u8, 69_u8, 83_u8];

const word_no: Array<u8, 2> =[78_u8, 79_u8];

const default_file: Array<u8, 14> =[97_u8, 112_u8, 112_u8, 101_u8, 110_u8, 100_u8, 111_u8, 110_u8, 108_u8, 121_u8, 46_u8, 97_u8, 111_u8, 102_u8];

const default_bind: Array<u8, 9> =[49_u8, 50_u8, 55_u8, 46_u8, 48_u8, 46_u8, 48_u8, 46_u8, 49_u8];

struct Text {
  bytes: Box<Slots<u8>>;
  valid: Bool;
}

struct Decimal {
  value: u64;
  valid: Bool;
}

struct Address {
  a: u8;
  b: u8;
  c: u8;
  d: u8;
  valid: Bool;
}

struct Options {
  port: u64;
  count: u64;
  idle: u64;
  logging: Bool;
  aof: Box<Slots<u8>>;
  bind: Box<Slots<u8>>;
  password: Box<Slots<u8>>;
  valid: Bool;
}

fn option_text(args: &std::text::Args, position: u64) -> text: Text reads(args) {
  doc "The UTF-8 bytes of the invocation argument at a position; valid is false when it is absent, is not UTF-8 or holds more than 65,536 bytes.";
  let invalid = False();
  match arg_get(args: args, position: position) {
    Ok(value: host) => {
      match host_utf8_len(value: &host) {
        Ok(value: length) => {
          if length <= 65536_u64 {
            let made = input_new(capacity: length);
            let window = &made.inner[0_u64..length];
            match host_copy_utf8(value: &host, destination: window, start: 0_u64, end: length) {
              Ok(value: next) => {
                let complete = next == length;
                return Text(bytes: move made, valid: complete);
              }
              Err(error: problem) => {
              }
            }
          }
        }
        Err(error: problem) => {
        }
      }
    }
    Err(error: problem) => {
    }
  }
  let empty = box_slots_new::<u8>(capacity: 0_u64);
  return Text(bytes: move empty, valid: invalid);
}

fn text_of(word: &[u8]) -> made: Box<Slots<u8>> reads(word) contract {
  requires word^.len <= 65536_u64;
} {
  doc "A copy of a constant word in an allocation of its own.";
  let length = word^.len;
  let made = box_slots_new::<u8>(capacity: length);
  for @copy (index in 0_u64..length) {
    let byte = word^[index];
    if made.inner.len < made.inner.cap {
      place_back(window: &made.inner, value: byte);
    }
  }
  return move made;
}

fn dashed(text: &Box<Slots<u8>>) -> marked: Bool reads(text) {
  doc "Whether an argument starts with --, the mark of an option given by name.";
  let length = text^.inner.len;
  if length < 2_u64 {
    return False();
  }
  let first = text^.inner[0_u64];
  let second = text^.inner[1_u64];
  let one = first == 45_u8;
  let two = second == 45_u8;
  let both = band(one, two);
  return both;
}

fn option_named(text: &Box<Slots<u8>>, word: &[u8]) -> named: Bool reads(text), reads(word) {
  doc "Whether an argument is -- followed by an option's upper-case name, in either case.";
  let length = text^.inner.len;
  if length < 2_u64 {
    return False();
  }
  let window = &text^.inner[0_u64..length];
  let size = length -wrap 2_u64;
  let named = name_is(input: window, start: 2_u64, length: size, word: word);
  return named;
}

fn spelled(text: &Box<Slots<u8>>, word: &[u8]) -> same: Bool reads(text), reads(word) {
  doc "Whether an argument spells an upper-case word, in either case.";
  let length = text^.inner.len;
  let window = &text^.inner[0_u64..length];
  let same = name_is(input: window, start: 0_u64, length: length, word: word);
  return same;
}

fn decimal(text: &Box<Slots<u8>>, limit: u64) -> number: Decimal reads(text) {
  doc "Reads an argument as a decimal number of digits alone, no greater than limit; valid is false for no digit, any other byte or a greater number.";
  let length = text^.inner.len;
  let invalid = False();
  let empty = length == 0_u64;
  let long = length > 20_u64;
  let outside = bor(empty, long);
  if outside {
    return Decimal(value: 0_u64, valid: invalid);
  }
  let total = 0_u64;
  for @digits (index in 0_u64..length) {
    let byte = text^.inner[index];
    let low = byte >= 48_u8;
    let high = byte <= 57_u8;
    let digit = band(low, high);
    if digit {
    } else {
      return Decimal(value: 0_u64, valid: invalid);
    }
    let face = byte -wrap 48_u8;
    let wide = cvt::<u8, u64>(face);
    match total *checked 10_u64 {
      Ok(value: scaled) => {
        match scaled +checked wide {
          Ok(value: summed) => {
            set total = summed;
          }
          Err(error: overflow) => {
            return Decimal(value: 0_u64, valid: invalid);
          }
        }
      }
      Err(error: overflow) => {
        return Decimal(value: 0_u64, valid: invalid);
      }
    }
  }
  if total > limit {
    return Decimal(value: 0_u64, valid: invalid);
  }
  let valid = True();
  return Decimal(value: total, valid: valid);
}

fn parse_address(text: &Box<Slots<u8>>) -> address: Address reads(text) {
  doc "Reads the address to listen on: a dotted IPv4 address, four decimal numbers of at most 255 joined by dots, each without a leading zero unless it is 0, or *, which stands for 0.0.0.0, every IPv4 address, as Redis reads it; valid is false for anything else.";
  let length = text^.inner.len;
  let invalid = False();
  let valid = True();
  if length == 1_u64 {
    let only = text^.inner[0_u64];
    if only == 42_u8 {
      return Address(a: 0_u8, b: 0_u8, c: 0_u8, d: 0_u8, valid: valid);
    }
  }
  let parts = array_filled::<u64, 4>(value: 0_u64);
  let part = 0_u64;
  let digits = 0_u64;
  let leading = 0_u8;
  for @bytes (index in 0_u64..length) {
    let byte = text^.inner[index];
    let low = byte >= 48_u8;
    let high = byte <= 57_u8;
    let digit = band(low, high);
    if byte == 46_u8 {
      if digits == 0_u64 {
        return Address(a: 0_u8, b: 0_u8, c: 0_u8, d: 0_u8, valid: invalid);
      }
      set part = part +wrap 1_u64;
      if part >= 4_u64 {
        return Address(a: 0_u8, b: 0_u8, c: 0_u8, d: 0_u8, valid: invalid);
      }
      set digits = 0_u64;
    } else if digit {
      let padded = leading == 48_u8;
      let second = digits == 1_u64;
      let zero_led = band(padded, second);
      let too_many = digits >= 3_u64;
      let refused = bor(zero_led, too_many);
      if refused {
        return Address(a: 0_u8, b: 0_u8, c: 0_u8, d: 0_u8, valid: invalid);
      }
      if digits == 0_u64 {
        set leading = byte;
      }
      let face = byte -wrap 48_u8;
      let wide = cvt::<u8, u64>(face);
      if part < 4_u64 {
        let current = parts[part];
        let scaled = current *wrap 10_u64;
        let summed = scaled +wrap wide;
        if summed > 255_u64 {
          return Address(a: 0_u8, b: 0_u8, c: 0_u8, d: 0_u8, valid: invalid);
        }
        set parts[part] = summed;
      }
      set digits = digits +wrap 1_u64;
    } else {
      return Address(a: 0_u8, b: 0_u8, c: 0_u8, d: 0_u8, valid: invalid);
    }
  }
  let complete = part == 3_u64;
  let ended = digits > 0_u64;
  let whole = band(complete, ended);
  if whole {
  } else {
    return Address(a: 0_u8, b: 0_u8, c: 0_u8, d: 0_u8, valid: invalid);
  }
  let a = cvt.wrap::<u64, u8>(parts[0_u64]);
  let b = cvt.wrap::<u64, u8>(parts[1_u64]);
  let c = cvt.wrap::<u64, u8>(parts[2_u64]);
  let d = cvt.wrap::<u64, u8>(parts[3_u64]);
  return Address(a: a, b: b, c: c, d: d, valid: valid);
}

fn apply_named(options: &Options, name: Box<Slots<u8>>, value: Box<Slots<u8>>) -> applied: Bool writes(options) {
  doc "Applies one option given by name to the options, returning false for an unknown name or a value that does not read.";
  let is_port = option_named(text: &name, word: &option_port[0_u64..4_u64]);
  let is_bind = option_named(text: &name, word: &option_bind[0_u64..4_u64]);
  let is_timeout = option_named(text: &name, word: &option_timeout[0_u64..7_u64]);
  let is_appendonly = option_named(text: &name, word: &option_appendonly[0_u64..10_u64]);
  let is_appendfilename = option_named(text: &name, word: &option_appendfilename[0_u64..14_u64]);
  let is_requirepass = option_named(text: &name, word: &option_requirepass[0_u64..11_u64]);
  let is_clients = option_named(text: &name, word: &option_clients[0_u64..7_u64]);
  if is_port {
    let number = decimal(text: &value, limit: 65535_u64);
    set options^.port = number.value;
    return number.valid;
  }
  if is_bind {
    let address = parse_address(text: &value);
    set options^.bind = move value;
    return address.valid;
  }
  if is_timeout {
    let number = decimal(text: &value, limit: 2147483647_u64);
    set options^.idle = number.value;
    return number.valid;
  }
  if is_appendonly {
    let yes = spelled(text: &value, word: &word_yes[0_u64..3_u64]);
    let no = spelled(text: &value, word: &word_no[0_u64..2_u64]);
    set options^.logging = yes;
    let either = bor(yes, no);
    return either;
  }
  if is_appendfilename {
    let length = value.inner.len;
    set options^.aof = move value;
    let named = length > 0_u64;
    return named;
  }
  if is_requirepass {
    set options^.password = move value;
    return True();
  }
  if is_clients {
    let number = decimal(text: &value, limit: 18446744073709551615_u64);
    set options^.count = number.value;
    return number.valid;
  }
  return False();
}

fn apply_positional(options: &Options, ordinal: u64, value: Box<Slots<u8>>) -> applied: Bool writes(options) {
  doc "Applies the argument at an ordinal by position to the options, as firn has always read them: the port, how many clients to accept, the append-only file's name, - or an empty one for none, and the idle limit; false reports a value that does not read.";
  if ordinal == 0_u64 {
    let number = decimal(text: &value, limit: 65535_u64);
    set options^.port = number.value;
    return number.valid;
  }
  if ordinal == 1_u64 {
    let number = decimal(text: &value, limit: 18446744073709551615_u64);
    set options^.count = number.value;
    return number.valid;
  }
  if ordinal == 2_u64 {
    let length = value.inner.len;
    let none = length == 0_u64;
    if length == 1_u64 {
      let only = value.inner[0_u64];
      if only == 45_u8 {
        set none = True();
      }
    }
    if none {
      set options^.logging = False();
      return True();
    }
    set options^.logging = True();
    set options^.aof = move value;
    return True();
  }
  let number = decimal(text: &value, limit: 2147483647_u64);
  set options^.idle = number.value;
  return number.valid;
}

fn read_options(args: &std::text::Args) -> options: Options reads(args) {
  doc "Reads firn's invocation. Up to four arguments come by position, as firn has always taken them: the port, how many clients to accept, the append-only file's name or - for none, and the idle limit in seconds. Options by name follow, each -- and a name in either case, then its value: --port; --bind, an IPv4 address or *; --timeout, the idle limit; --appendonly, yes or no; --appendfilename, the file's name, which alone does not turn the file on, as in Redis; --requirepass, the password clients must give, empty for none; and --clients, how many clients to accept before stopping. A later value replaces an earlier one, one by position included. The defaults are port 6379, the loopback address 127.0.0.1, no idle limit, no append-only file, named appendonly.aof once turned on, no password and no limit on clients. valid is false for an unknown name, a name without its value, an argument by position after one by name or past the fourth, and a value that does not read: a port past 65,535, an idle limit past 2,147,483,647 seconds, Redis's limit, an empty file name, or an argument that is not UTF-8 or holds more than 65,536 bytes.";
  let total = args_count(args: args);
  let aof = text_of(word: &default_file[0_u64..14_u64]);
  let bind = text_of(word: &default_bind[0_u64..9_u64]);
  let password = box_slots_new::<u8>(capacity: 0_u64);
  let off = False();
  let readable = True();
  let options = Options(port: 6379_u64, count: 0_u64, idle: 0_u64, logging: off, aof: move aof, bind: move bind, password: move password, valid: readable);
  let position = 1_u64;
  let ordinal = 0_u64;
  let named = False();
  loop @arguments {
    if position >= total {
      break @arguments;
    }
    let text = option_text(args: args, position: position);
    let Text(bytes: argument, valid: read) = move text;
    if read {
    } else {
      set options.valid = False();
      break @arguments;
    }
    let marked = dashed(text: &argument);
    if marked {
      set named = True();
      let value_position = position +wrap 1_u64;
      if value_position >= total {
        set options.valid = False();
        break @arguments;
      }
      let given = option_text(args: args, position: value_position);
      let Text(bytes: value, valid: value_read) = move given;
      if value_read {
      } else {
        set options.valid = False();
        break @arguments;
      }
      let applied = apply_named(options: &options, name: move argument, value: move value);
      if applied {
      } else {
        set options.valid = False();
        break @arguments;
      }
      set position = position +wrap 2_u64;
    } else {
      let full = ordinal >= 4_u64;
      let late = bor(named, full);
      if late {
        set options.valid = False();
        break @arguments;
      }
      let applied = apply_positional(options: &options, ordinal: ordinal, value: move argument);
      if applied {
      } else {
        set options.valid = False();
        break @arguments;
      }
      set ordinal = ordinal +wrap 1_u64;
      set position = position +wrap 1_u64;
    }
  }
  return move options;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "firn, a server of Redis's protocol: PING, ECHO, GET, SET with EX or PX, MSET, INCR, DEL, EXISTS, TYPE, EXPIRE, PEXPIRE, PEXPIREAT, TTL, PTTL, PERSIST, DBSIZE, FLUSHALL, FLUSHDB, CONFIG GET with patterns, CONFIG SET, CONFIG RESETSTAT, INFO, FUNCTION FLUSH, DEBUG LOG, the lists' LPUSH, RPUSH, LPOP, RPOP, LRANGE and LLEN, the sets' SADD, SREM, SPOP and SCARD, the hashes' HSET and HGET, the sorted sets' ZADD, ZPOPMIN, ZCARD and ZSCORE, and the connection commands QUIT, AUTH, HELLO, SELECT, CLIENT ID, GETNAME and SETNAME, TIME, COMMAND and COMMAND COUNT, over TCP in RESP2 or as inline commands, with pipelining. It serves each accepted client in a context of its own over one keyspace, a shared state every client reaches through atomic statements that hold the entries of the keys a command names, or the keyspace's table whole for DBSIZE and FLUSHALL. Its invocation, which read_options reads, names up to four arguments by position, the port, how many clients to accept, zero for no limit, the append-only file's name or - for none, and the idle limit, then options by name, --port, --bind, --timeout, --appendonly, --appendfilename, --requirepass and --clients; an invocation that does not read stops firn with status 1. firn listens on the address --bind names, the loopback address by default. An append-only file is replayed before firn listens and every change is appended to it, the file synced once a second. A client silent for the idle limit, when it is not zero, is closed, and while a password is required a client that has not authenticated, by giving it or by being accepted while none was required, must give it before other commands; CONFIG SET changes both while firn runs, in the server's state beside the keyspace. Expired keys are removed when a command finds them and by a context that wakes ten times a second.";
  let Inputs(args: args, cwd: cwd_directory, stdout: unused_stdout, stderr: unused_stderr, handles: handles, stdin: unused_stdin, clock: clock, wall_clock: wall_clock) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  let options = read_options(args: &args);
  if options.valid {
  } else {
    close_directory_write(factory: &handles, directory: move cwd_write);
    close_directory(factory: &handles, directory: move cwd);
    return exit_status(code: 1_u8);
  }
  let port = cvt.wrap::<u64, u16>(options.port);
  let count = options.count;
  let idle = options.idle;
  let listen_at = parse_address(text: &options.bind);
  let name_length = options.aof.inner.len;
  let name = &options.aof.inner[0_u64..name_length];
  let bind_length = options.bind.inner.len;
  let bind_window = &options.bind.inner[0_u64..bind_length];
  let bind_text = bytes_new(input: bind_window, start: 0_u64, length: bind_length);
  let file_text = bytes_new(input: name, start: 0_u64, length: name_length);
  let password_length = options.password.inner.len;
  let password_window = &options.password.inner[0_u64..password_length];
  let password_text = bytes_new(input: password_window, start: 0_u64, length: password_length);
  let settings = Settings(port: options.port, bind: move bind_text, appendfilename: move file_text);
  let origin = std::time::now(clock: &clock);
  let calendar = unix_nanoseconds(clock: &wall_clock);
  let seed = cvt.wrap::<i64, u64>(calendar);
  let quiet = False();
  let root = keyspace_new(seed: seed, logging: quiet, password: move password_text, timeout: idle);
  let logging = False();
  let failed = False();
  if options.logging {
    let read = read_time(clock: &clock, wall: &wall_clock, origin: origin);
    let replaying = True();
    let time = Time(now: read.time.now, unix_ms: read.time.unix_ms, check: 0_u64, loading: replaying);
    let applied = replay(store: &root, factory: &handles, root: &cwd, name: name, name_length: name_length, time: &time);
    match open_append(factory: &handles, root: &cwd_write, name: name, start: 0_u64, end: name_length) {
      Ok(value: file) => {
        set logging = True();
        let writer_store = keyspace_logging(store: &root, logging: logging);
        let writer_factory = factory_share(factory: &handles);
        let writer_clock = clock_share(clock: &clock);
        spawn write_log(store: move writer_store, factory: move writer_factory, file: move file, clock: move writer_clock);
      }
      Err(error: problem) => {
        set failed = True();
      }
    }
  }
  close_directory_write(factory: &handles, directory: move cwd_write);
  close_directory(factory: &handles, directory: move cwd);
  if failed {
    return exit_status(code: 4_u8);
  }
  let keyspace = keyspace_logging(store: &root, logging: logging);
  let expiring_store = keyspace_share(store: &keyspace);
  let expiring_clock = clock_share(clock: &clock);
  spawn expire_keys(store: move expiring_store, clock: move expiring_clock, origin: origin);
  let address = socket_address_v4(a: listen_at.a, b: listen_at.b, c: listen_at.c, d: listen_at.d, port: port);
  let listened = True();
  match tcp_listen(factory: &handles, address: &address) {
    Ok(value: listener) => {
      let accepted = 0_u64;
      loop @accepting {
        if count != 0_u64 {
          if accepted >= count {
            break @accepting;
          }
        }
        let no_deadline = None<Instant>();
        match tcp_accept(factory: &handles, listener: &listener, deadline: no_deadline) {
          Ok(value: next) => {
            let AcceptedConnection(connection: connection, peer: unused_peer) = move next;
            let factory = factory_share(factory: &handles);
            let handle = keyspace_share(store: &keyspace);
            let serving_clock = clock_share(clock: &clock);
            let serving_wall = wall_clock_share(clock: &wall_clock);
            let serving_settings = settings_copy(settings: &settings);
            let id = accepted +wrap 1_u64;
            atomic s = &keyspace.state {
              set s^.meta.clients = s^.meta.clients +wrap 1_u64;
            }
            let required = False();
            atomic v = &keyspace.server {
              set v^.connections = v^.connections +wrap 1_u64;
              let length = bytes_length(bytes: &v^.password);
              set required = length > 0_u64;
            }
            spawn serve(connection: move connection, factory: move factory, store: move handle, clock: move serving_clock, wall: move serving_wall, origin: origin, required: required, settings: move serving_settings, id: id);
          }
          Err(error: problem) => {
            break @accepting;
          }
        }
        set accepted = accepted +wrap 1_u64;
      }
      close_listener(factory: &handles, listener: move listener);
    }
    Err(error: problem) => {
      set listened = False();
    }
  }
  atomic s = &keyspace.state when s^.meta.clients == 0_u64 {
    set s^.meta.stopping = True();
  }
  if listened {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 3_u8);
}
