fn send_all(send: &TcpSend, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(send) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  doc "Sends one prefix of the source range, reattempting until the connection has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @sending {
    let pending = sent < length;
    if pending {
    } else {
      break @sending;
    }
    let no_deadline = None<Instant>();
    match send_once(send: send, source: source, start: sent, end: length, deadline: no_deadline) {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn flush(send: &TcpSend, client: &Client) -> sent: Bool writes(send), writes(client) waits {
  doc "Sends the replies the client holds and empties them; false reports a connection that refused them.";
  let written = client^.at;
  let capacity = client^.bytes.inner.len;
  let window = &client^.bytes.inner[0_u64..capacity];
  let delivered = True();
  if written <= capacity {
    match send_all(send: send, source: window, length: written) {
      Ok(value: done) => {
      }
      Err(error: problem) => {
        set delivered = False();
      }
    }
  }
  set client^.at = 0_u64;
  return delivered;
}

struct Reading {
  time: Time;
  unix_us: u64;
}

fn deadline_error(error: &IoError) -> passed: Bool reads(error) {
  doc "Whether a host error is DeadlinePassed, a wait that ended at its deadline with nothing transferred.";
  match error^ {
    NotFound(code: native_code, origin: native_origin) => {
      return False();
    }
    PermissionDenied(code: native_code, origin: native_origin) => {
      return False();
    }
    AlreadyExists(code: native_code, origin: native_origin) => {
      return False();
    }
    NotDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    IsDirectory(code: native_code, origin: native_origin) => {
      return False();
    }
    DirectoryNotEmpty(code: native_code, origin: native_origin) => {
      return False();
    }
    ReadOnly(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceBusy(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidInput(code: native_code, origin: native_origin) => {
      return False();
    }
    InvalidPath(code: native_code, origin: native_origin) => {
      return False();
    }
    Unsupported(code: native_code, origin: native_origin) => {
      return False();
    }
    TimedOut(code: native_code, origin: native_origin) => {
      return False();
    }
    DeadlinePassed() => {
      return True();
    }
    BrokenPipe(code: native_code, origin: native_origin) => {
      return False();
    }
    WriteZero(code: native_code, origin: native_origin) => {
      return False();
    }
    UnexpectedEnd(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionRefused(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionReset(code: native_code, origin: native_origin) => {
      return False();
    }
    ConnectionAborted(code: native_code, origin: native_origin) => {
      return False();
    }
    NotConnected(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressInUse(code: native_code, origin: native_origin) => {
      return False();
    }
    AddressUnavailable(code: native_code, origin: native_origin) => {
      return False();
    }
    ResourceExhausted(code: native_code, origin: native_origin) => {
      return False();
    }
    FileTooLarge(code: native_code, origin: native_origin) => {
      return False();
    }
    NoSpace(code: native_code, origin: native_origin) => {
      return False();
    }
    QuotaExceeded(code: native_code, origin: native_origin) => {
      return False();
    }
    CrossDevice(code: native_code, origin: native_origin) => {
      return False();
    }
    DeviceFailure(code: native_code, origin: native_origin) => {
      return False();
    }
    Other(code: native_code, origin: native_origin) => {
      return False();
    }
  }
}

fn passed_deadline(stop: &ReadStop) -> passed: Bool reads(stop) {
  doc "Whether a receive stopped at its deadline with no byte received, which leaves the connection as it was, rather than because the peer finished sending or the connection failed.";
  match stop^ {
    ReadEnd() => {
      return False();
    }
    ReadFailed(error: failure) => {
      let passed = deadline_error(error: failure);
      return passed;
    }
  }
}

fn idle_limit(store: &Keyspace) -> seconds: u64 reads(store) waits {
  doc "How many seconds a silent client is kept, zero for no limit, as the server's state holds it now.";
  let seconds = 0_u64;
  atomic v = &store^.server {
    set seconds = v^.timeout;
  }
  return seconds;
}

fn password_required(store: &Keyspace) -> required: Bool reads(store) waits {
  doc "Whether the server's state holds a password now, which a connection that has not given it must give before other commands.";
  let required = False();
  atomic v = &store^.server {
    let length = bytes_length(bytes: &v^.password);
    set required = length > 0_u64;
  }
  return required;
}

fn read_time(clock: &Clock, wall: &WallClock, origin: Instant) -> result: Reading reads(wall), writes(clock) {
  doc "Reads both clocks: the monotonic one as nanoseconds from the program's origin, and the calendar one as milliseconds since 1970 for the commands' time and as microseconds for TIME.";
  let reading = std::time::now(clock: clock);
  let offset = nanoseconds_from(earlier: origin, later: reading);
  let calendar = unix_nanoseconds(clock: wall);
  let unix_ms = 0_u64;
  let unix_us = 0_u64;
  if calendar > 0_i64 {
    let wide = cvt.wrap::<i64, u64>(calendar);
    set unix_ms = wide / 1000000_u64;
    set unix_us = wide / 1000_u64;
  }
  let live = False();
  let time = Time(now: offset, unix_ms: unix_ms, check: offset, loading: live);
  return Reading(time: time, unix_us: unix_us);
}

fn serve(connection: TcpConnection, factory: HandleFactory, store: Keyspace, clock: Clock, wall: WallClock, origin: Instant, required: Bool, settings: Settings, id: u64) -> result: unit pure waits {
  doc "Serves one client, the id-th the server accepted, in a context of its own: reads requests into its input, which grows to hold a request larger than it, answers every complete request the input holds with one send, sending sooner once 16,384 bytes of replies are waiting, and keeps an incomplete one for the next read. Every command of one read sees the clocks as read once after it. A client silent for the idle limit the server's state holds, when it is not zero, is closed: while a limit is set, each read waits no longer than the limit leaves, and the client reads the limit again when that wait ends and at most once a second while it sends, so that a limit CONFIG SET changes reaches it; a client that waits with no limit set reads none until it sends. A client that sends a malformed request is closed after its error, and one that sends QUIT after its reply. A client accepted while a password is required, when required is true, has not authenticated until it gives the password, as AUTH and HELLO record; until then it reads the password again before each request and must give it before other commands while one is set, as Redis's clients must.";
  let env = KeyEnv();
  let client = client_new(capacity: 16384_u64);
  atomic s = &store.state {
    set client.random = s^.meta.random;
    let stepped = s^.meta.random *wrap 6364136223846793005_u64;
    set s^.meta.random = stepped +wrap 1442695040888963407_u64;
  }
  let args = box_slots_new::<Span>(capacity: 16_u64);
  let input = input_new(capacity: 16384_u64);
  set client.id = id;
  set client.authenticated = bnot(required);
  set client.locked = required;
  set client.settings = move settings;
  let idle = idle_limit(store: &store);
  let started = std::time::now(clock: &clock);
  let last = nanoseconds_from(earlier: origin, later: started);
  let polled = last;
  let held = 0_u64;
  loop @requests {
    if held >= input.inner.len {
      input_grow(input: &input);
      if held >= input.inner.len {
        break @requests;
      }
    }
    let ended = False();
    let received = held;
    loop @receiving {
      let limit = None<Instant>();
      if idle != 0_u64 {
        let before = std::time::now(clock: &clock);
        let current = nanoseconds_from(earlier: origin, later: before);
        let quiet = current -sat last;
        let idle_ns = idle *wrap 1000000000_u64;
        let left = idle_ns -sat quiet;
        let bound = instant_after(instant: before, nanoseconds: left);
        set limit = Some<Instant>(value: bound);
      }
      let length = input.inner.len;
      let window = &input.inner[0_u64..length];
      let waited = False();
      match receive_next(receive: &connection.receive, destination: window, start: held, end: length, deadline: limit) {
        Ok(value: next) => {
          set received = next;
        }
        Err(error: stop) => {
          set waited = passed_deadline(stop: &stop);
          if waited {
          } else {
            set ended = True();
          }
        }
      }
      if waited {
      } else {
        break @receiving;
      }
      set idle = idle_limit(store: &store);
      let after = std::time::now(clock: &clock);
      let current = nanoseconds_from(earlier: origin, later: after);
      set polled = current;
      let quiet = current -sat last;
      let idle_ns = idle *wrap 1000000000_u64;
      let limited = idle != 0_u64;
      let silent = quiet >= idle_ns;
      let expired = band(limited, silent);
      if expired {
        set ended = True();
        break @receiving;
      }
    }
    if ended {
      break @requests;
    }
    set held = received;
    let reading = read_time(clock: &clock, wall: &wall, origin: origin);
    let time = reading.time;
    set client.unix_us = reading.unix_us;
    set last = time.now;
    let since = time.now -sat polled;
    if since >= 1000000000_u64 {
      set idle = idle_limit(store: &store);
      set polled = time.now;
    }
    let consumed = 0_u64;
    let broken = False();
    let closing = False();
    loop @commands {
      let current = input.inner.len;
      let bytes = &input.inner[0_u64..current];
      if client.authenticated {
      } else {
        let demanded = password_required(store: &store);
        set client.locked = demanded;
      }
      let locked = client.locked;
      let parsed = parse_request(input: bytes, start: consumed, held: held, args: &args, locked: locked);
      if parsed.state == 0_u64 {
        break @commands;
      }
      if parsed.state == 1_u64 {
        execute(store: &store, input: bytes, args: &args, client: &client, env: &env, time: &time);
        if client.closing {
          set closing = True();
          break @commands;
        }
      } else if parsed.state != 6_u64 {
        protocol_error(client: &client, input: bytes, parsed: parsed);
        set closing = True();
        break @commands;
      }
      set consumed = parsed.next;
      if client.at > 16384_u64 {
        let delivered = flush(send: &connection.send, client: &client);
        if delivered {
        } else {
          set broken = True();
          break @commands;
        }
      }
    }
    if client.at > 0_u64 {
      let delivered = flush(send: &connection.send, client: &client);
      if delivered {
      } else {
        set broken = True();
      }
    }
    let stopping = bor(broken, closing);
    if stopping {
      break @requests;
    }
    set held = keep_rest(input: &input, from: consumed, held: held);
  }
  let TcpConnection(receive: closing_receive, send: closing_send) = move connection;
  close_receive(factory: &factory, receive: move closing_receive);
  close_send(factory: &factory, send: move closing_send);
  atomic s = &store.state {
    set s^.meta.clients = s^.meta.clients -wrap 1_u64;
  }
  return unit;
}

fn expire_keys(store: Keyspace, clock: Clock, origin: Instant) -> result: unit pure waits {
  doc "Wakes ten times a second and removes the keys whose expiry has passed, in batches of atomic statements so that clients proceed between them, until the server stops. A key whose expiry did not fit the queue is removed only when a command finds it expired.";
  let env = KeyEnv();
  let batch = box_slots_new::<Due>(capacity: 256_u64);
  loop @ticks {
    let started = std::time::now(clock: &clock);
    let wake = instant_after(instant: started, nanoseconds: 100000000_u64);
    sleep_until(deadline: wake);
    let reading = std::time::now(clock: &clock);
    let current = nanoseconds_from(earlier: origin, later: reading);
    let stop = False();
    loop @batches {
      atomic s = &store.state {
        set stop = s^.meta.stopping;
      }
      let more = expire_batch(store: &store, now: current, env: &env, batch: &batch);
      if more {
      } else {
        break @batches;
      }
    }
    if stop {
      break @ticks;
    }
  }
  return unit;
}

