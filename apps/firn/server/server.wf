alias AcceptedConnection = std::net::AcceptedConnection;
alias Client = pkg::protocol::Client;
alias Clock = std::time::Clock;
alias ExitStatus = std::process::ExitStatus;
alias HandleFactory = std::io::HandleFactory;
alias Inputs = std::process::Inputs;
alias Instant = std::time::Instant;
alias IoError = std::io::IoError;
alias KeyEnv = pkg::bytes::KeyEnv;
alias Span = pkg::protocol::Span;
alias Store = pkg::store::Store;
alias TcpConnection = std::net::TcpConnection;
alias TcpSend = std::net::TcpSend;
alias Time = pkg::store::Time;
alias WallClock = std::time::WallClock;
alias arg_get = std::text::arg_get;
alias args_count = std::text::args_count;
alias byte_at = pkg::bytes::byte_at;
alias client_new = pkg::protocol::client_new;
alias clock_share = std::time::clock_share;
alias close_directory = std::fs::close_directory;
alias close_directory_write = std::fs::close_directory_write;
alias close_listener = std::net::close_listener;
alias close_receive = std::net::close_receive;
alias close_send = std::net::close_send;
alias execute = pkg::commands::execute;
alias exit_status = std::process::exit_status;
alias expire_batch = pkg::store::expire_batch;
alias factory_share = std::io::factory_share;
alias host_copy_utf8 = std::text::host_copy_utf8;
alias input_grow = pkg::protocol::input_grow;
alias input_new = pkg::protocol::input_new;
alias instant_after = std::time::instant_after;
alias keep_rest = pkg::protocol::keep_rest;
alias nanoseconds_from = std::time::nanoseconds_from;
alias open_append = std::fs::open_append;
alias parse_request = pkg::protocol::parse_request;
alias protocol_error = pkg::protocol::protocol_error;
alias receive_next = std::net::receive_next;
alias replay = pkg::persistence::replay;
alias send_once = std::net::send_once;
alias sleep_until = std::time::sleep_until;
alias socket_address_v4 = std::net::socket_address_v4;
alias store_new = pkg::store::store_new;
alias tcp_accept = std::net::tcp_accept;
alias tcp_listen = std::net::tcp_listen;
alias unix_nanoseconds = std::time::unix_nanoseconds;
alias wall_clock_share = std::time::wall_clock_share;
alias write_log = pkg::persistence::write_log;

fn send_all(send: &TcpSend, source: &[u8], length: u64) -> result: Result<unit, IoError> reads(source), writes(send) waits contract {
  define source_length = source^.len;
  requires length <= source_length;
} {
  doc "Sends one prefix of the source range, reattempting until the connection has accepted every byte or refused it.";
  let sent = 0_u64;
  loop @sending {
    let pending = sent < length;
    if pending {
    } else {
      break @sending;
    }
    let no_deadline = None<Instant>();
    match send_once(send: send, source: source, start: sent, end: length, deadline: no_deadline) {
      Ok(value: next) => {
        set sent = next;
      }
      Err(error: problem) => {
        return Err<unit, IoError>(error: problem);
      }
    }
  }
  return Ok<unit, IoError>(value: unit);
}

fn flush(send: &TcpSend, client: &Client) -> sent: Bool writes(send), writes(client) waits {
  doc "Sends the replies the client holds and empties them; false reports a connection that refused them.";
  let written = client^.at;
  let capacity = client^.bytes.inner.len;
  let window = &client^.bytes.inner[0_u64..capacity];
  let delivered = True();
  if written <= capacity {
    match send_all(send: send, source: window, length: written) {
      Ok(value: done) => {
      }
      Err(error: problem) => {
        set delivered = False();
      }
    }
  }
  set client^.at = 0_u64;
  return delivered;
}

fn read_time(clock: &Clock, wall: &WallClock, origin: Instant) -> result: Time reads(wall), writes(clock) {
  doc "Reads both clocks: the monotonic one as nanoseconds from the program's origin, and the calendar one as milliseconds since 1970.";
  let reading = std::time::now(clock: clock);
  let offset = nanoseconds_from(earlier: origin, later: reading);
  let calendar = unix_nanoseconds(clock: wall);
  let unix_ms = 0_u64;
  if calendar > 0_i64 {
    let wide = cvt.wrap::<i64, u64>(calendar);
    set unix_ms = wide / 1000000_u64;
  }
  let live = False();
  return Time(now: offset, unix_ms: unix_ms, check: offset, loading: live);
}

fn serve(connection: TcpConnection, factory: HandleFactory, store: Shared<Store>, clock: Clock, wall: WallClock, origin: Instant, idle: u64) -> result: unit pure waits {
  doc "Serves one client in a context of its own: reads requests into its input, which grows to hold a request larger than it, answers every complete request the input holds with one send, sending sooner once 16,384 bytes of replies are waiting, and keeps an incomplete one for the next read. Every command of one read sees the clocks as read once after it; a client silent for idle seconds, when idle is not zero, is closed, and so is one that sends a malformed request, after its error.";
  let env = KeyEnv();
  let client = client_new(capacity: 16384_u64);
  let args = box_slots_new::<Span>(capacity: 16_u64);
  let input = input_new(capacity: 16384_u64);
  let idle_ns = idle *wrap 1000000000_u64;
  let held = 0_u64;
  loop @requests {
    if held >= input.inner.len {
      input_grow(input: &input);
      if held >= input.inner.len {
        break @requests;
      }
    }
    let ended = False();
    let limit = None<Instant>();
    if idle != 0_u64 {
      let before = std::time::now(clock: &clock);
      let bound = instant_after(instant: before, nanoseconds: idle_ns);
      set limit = Some<Instant>(value: bound);
    }
    let length = input.inner.len;
    let window = &input.inner[0_u64..length];
    match receive_next(receive: &connection.receive, destination: window, start: held, end: length, deadline: limit) {
      Ok(value: next) => {
        set held = next;
      }
      Err(error: stop) => {
        set ended = True();
      }
    }
    if ended {
      break @requests;
    }
    let time = read_time(clock: &clock, wall: &wall, origin: origin);
    let consumed = 0_u64;
    let broken = False();
    let closing = False();
    loop @commands {
      let current = input.inner.len;
      let bytes = &input.inner[0_u64..current];
      let parsed = parse_request(input: bytes, start: consumed, held: held, args: &args);
      if parsed.state == 0_u64 {
        break @commands;
      }
      if parsed.state == 1_u64 {
        execute(store: &store, input: bytes, args: &args, client: &client, env: &env, time: &time);
      } else if parsed.state != 6_u64 {
        protocol_error(client: &client, input: bytes, parsed: parsed);
        set closing = True();
        break @commands;
      }
      set consumed = parsed.next;
      if client.at > 16384_u64 {
        let delivered = flush(send: &connection.send, client: &client);
        if delivered {
        } else {
          set broken = True();
          break @commands;
        }
      }
    }
    if client.at > 0_u64 {
      let delivered = flush(send: &connection.send, client: &client);
      if delivered {
      } else {
        set broken = True();
      }
    }
    let stopping = bor(broken, closing);
    if stopping {
      break @requests;
    }
    set held = keep_rest(input: &input, from: consumed, held: held);
  }
  let TcpConnection(receive: closing_receive, send: closing_send) = move connection;
  close_receive(factory: &factory, receive: move closing_receive);
  close_send(factory: &factory, send: move closing_send);
  atomic state = &store {
    set state^.clients = state^.clients -wrap 1_u64;
  }
  return unit;
}

fn expire_keys(store: Shared<Store>, clock: Clock, origin: Instant) -> result: unit pure waits {
  doc "Wakes ten times a second and removes the keys whose expiry has passed, in batches of atomic statements so that clients proceed between them, until the server stops. A key whose expiry did not fit the queue is removed only when a command finds it expired.";
  let env = KeyEnv();
  loop @ticks {
    let started = std::time::now(clock: &clock);
    let wake = instant_after(instant: started, nanoseconds: 100000000_u64);
    sleep_until(deadline: wake);
    let reading = std::time::now(clock: &clock);
    let current = nanoseconds_from(earlier: origin, later: reading);
    let stop = False();
    loop @batches {
      let more = False();
      atomic state = &store {
        set stop = state^.stopping;
        set more = expire_batch(store: &state^, now: current, env: &env);
      }
      if more {
      } else {
        break @batches;
      }
    }
    if stop {
      break @ticks;
    }
  }
  return unit;
}

fn parse_port(digits: &[u8], length: u64) -> result: u16 reads(digits) {
  doc "Reads one decimal number of at most 16 bits out of the argument bytes; a byte that is not a digit ends the number.";
  let port = 0_u16;
  for @scan (index in 0_u64..length) {
    let byte = byte_at(input: digits, index: index);
    let low = byte >= 48_u8;
    let high = byte <= 57_u8;
    let digit = band(low, high);
    if digit {
    } else {
      return port;
    }
    let value = byte -wrap 48_u8;
    let widened = cvt::<u8, u16>(value);
    let scaled = port *wrap 10_u16;
    set port = scaled +wrap widened;
  }
  return port;
}

fn argument(args: &std::text::Args, position: u64, window: &[u8]) -> result: u64 reads(args), writes(window) contract {
  ensures result <= window^.len;
} {
  doc "Copies one invocation argument into the window and returns its length, or zero when it is absent or does not fit.";
  let carried = 0_u64;
  let room = window^.len;
  match arg_get(args: args, position: position) {
    Ok(value: text) => {
      match host_copy_utf8(value: &text, destination: window, start: 0_u64, end: room) {
        Ok(value: written) => {
          set carried = written;
        }
        Err(error: problem) => {
          set carried = 0_u64;
        }
      }
    }
    Err(error: problem) => {
      set carried = 0_u64;
    }
  }
  if carried > room {
    return 0_u64;
  }
  return carried;
}

fn main(inputs: Inputs) -> status: ExitStatus pure waits {
  doc "firn, a server of Redis's protocol: PING, ECHO, GET, SET with EX or PX, MSET, INCR, DEL, EXISTS, TYPE, EXPIRE, PEXPIRE, PEXPIREAT, TTL, PTTL, PERSIST, DBSIZE, CONFIG GET, the lists' LPUSH, RPUSH, LPOP, RPOP, LRANGE and LLEN, the sets' SADD, SREM, SPOP and SCARD, the hashes' HSET and HGET and the sorted sets' ZADD, ZPOPMIN, ZCARD and ZSCORE, over TCP in RESP2 or as inline commands, with pipelining. It listens on the loopback port the first argument names and serves each accepted client in a context of its own over one keyspace, a shared object every client reaches through atomic statements. The second argument is how many clients to accept; zero accepts until the listener fails. A third argument other than - names an append-only file in the working directory: firn replays it before it listens and appends every change to it, syncing it once a second. A fourth argument, when not zero, closes a client silent for that many seconds. Expired keys are removed when a command finds them and by a context that wakes ten times a second.";
  let Inputs(args: args, cwd: cwd_directory, stdout: unused_stdout, stderr: unused_stderr, handles: handles, stdin: unused_stdin, clock: clock, wall_clock: wall_clock) = move inputs;
  let std::fs::Directory(read: cwd, write: cwd_write) = move cwd_directory;
  let digits = slots_new::<u8, 16>();
  for @fill_digits (
    at in 0_u64..16_u64,
    invariant grown_digits: digits.len == at
  ) {
    place_back(window: &digits, value: 0_u8);
  }
  let window = &digits[0_u64..16_u64];
  let names = slots_new::<u8, 256>();
  for @fill_names (
    at in 0_u64..256_u64,
    invariant grown_names: names.len == at
  ) {
    place_back(window: &names, value: 0_u8);
  }
  let name = &names[0_u64..256_u64];
  let arguments = args_count(args: &args);
  let usage = arguments < 3_u64;
  let port_length = 0_u64;
  if usage {
  } else {
    set port_length = argument(args: &args, position: 1_u64, window: window);
  }
  let unnamed = port_length == 0_u64;
  let refused = bor(usage, unnamed);
  if refused {
    close_directory_write(factory: &handles, directory: move cwd_write);
    close_directory(factory: &handles, directory: move cwd);
    if usage {
      return exit_status(code: 1_u8);
    }
    return exit_status(code: 2_u8);
  }
  let port = parse_port(digits: window, length: port_length);
  let count_length = argument(args: &args, position: 2_u64, window: window);
  let written_count = parse_port(digits: window, length: count_length);
  let count = cvt::<u16, u64>(written_count);
  let name_length = 0_u64;
  if arguments > 3_u64 {
    set name_length = argument(args: &args, position: 3_u64, window: name);
    if name_length == 1_u64 {
      if name^[0_u64] == 45_u8 {
        set name_length = 0_u64;
      }
    }
  }
  let idle = 0_u64;
  if arguments > 4_u64 {
    let idle_length = argument(args: &args, position: 4_u64, window: window);
    let written_idle = parse_port(digits: window, length: idle_length);
    set idle = cvt::<u16, u64>(written_idle);
  }
  let origin = std::time::now(clock: &clock);
  let calendar = unix_nanoseconds(clock: &wall_clock);
  let seed = cvt.wrap::<i64, u64>(calendar);
  let initial = store_new(seed: seed);
  let keyspace = shared_new::<Store>(value: move initial);
  let failed = False();
  if name_length > 0_u64 {
    let read = read_time(clock: &clock, wall: &wall_clock, origin: origin);
    let replaying = True();
    let time = Time(now: read.now, unix_ms: read.unix_ms, check: 0_u64, loading: replaying);
    let applied = replay(store: &keyspace, factory: &handles, root: &cwd, name: name, name_length: name_length, time: &time);
    match open_append(factory: &handles, root: &cwd_write, name: name, start: 0_u64, end: name_length) {
      Ok(value: file) => {
        atomic state = &keyspace {
          set state^.logging = True();
        }
        let writer_store = shared_share::<Store>(shared: &keyspace);
        let writer_factory = factory_share(factory: &handles);
        let writer_clock = clock_share(clock: &clock);
        spawn write_log(store: move writer_store, factory: move writer_factory, file: move file, clock: move writer_clock);
      }
      Err(error: problem) => {
        set failed = True();
      }
    }
  }
  close_directory_write(factory: &handles, directory: move cwd_write);
  close_directory(factory: &handles, directory: move cwd);
  if failed {
    return exit_status(code: 4_u8);
  }
  let expiring_store = shared_share::<Store>(shared: &keyspace);
  let expiring_clock = clock_share(clock: &clock);
  spawn expire_keys(store: move expiring_store, clock: move expiring_clock, origin: origin);
  let address = socket_address_v4(a: 127_u8, b: 0_u8, c: 0_u8, d: 1_u8, port: port);
  let listened = True();
  match tcp_listen(factory: &handles, address: &address) {
    Ok(value: listener) => {
      let accepted = 0_u64;
      loop @accepting {
        if count != 0_u64 {
          if accepted >= count {
            break @accepting;
          }
        }
        let no_deadline = None<Instant>();
        match tcp_accept(factory: &handles, listener: &listener, deadline: no_deadline) {
          Ok(value: next) => {
            let AcceptedConnection(connection: connection, peer: unused_peer) = move next;
            let factory = factory_share(factory: &handles);
            let handle = shared_share::<Store>(shared: &keyspace);
            let serving_clock = clock_share(clock: &clock);
            let serving_wall = wall_clock_share(clock: &wall_clock);
            atomic state = &keyspace {
              set state^.clients = state^.clients +wrap 1_u64;
            }
            spawn serve(connection: move connection, factory: move factory, store: move handle, clock: move serving_clock, wall: move serving_wall, origin: origin, idle: idle);
          }
          Err(error: problem) => {
            break @accepting;
          }
        }
        set accepted = accepted +wrap 1_u64;
      }
      close_listener(factory: &handles, listener: move listener);
    }
    Err(error: problem) => {
      set listened = False();
    }
  }
  atomic state = &keyspace when state^.clients == 0_u64 {
    set state^.stopping = True();
  }
  if listened {
    return exit_status(code: 0_u8);
  }
  return exit_status(code: 3_u8);
}
