const state_absent: u64 = 0_u64;

const state_done: u64 = 1_u64;

const state_expired: u64 = 2_u64;

const state_wrong: u64 = 3_u64;

const state_emptied: u64 = 4_u64;

const count_unit: u64 = 4294967296_u64;

const index_mask: u64 = 4294967295_u64;

const expire_nx: u64 = 1_u64;

const expire_xx: u64 = 2_u64;

const expire_gt: u64 = 4_u64;

const expire_lt: u64 = 8_u64;

const expire_others: u64 = 14_u64;

const text_unsupported: Array<u8, 23> =[69_u8, 82_u8, 82_u8, 32_u8, 85_u8, 110_u8, 115_u8, 117_u8, 112_u8, 112_u8, 111_u8, 114_u8, 116_u8, 101_u8, 100_u8, 32_u8, 111_u8, 112_u8, 116_u8, 105_u8, 111_u8, 110_u8, 32_u8];

