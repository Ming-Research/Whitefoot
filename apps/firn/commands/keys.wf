const reply_type_none: Array<u8, 7> =[43_u8, 110_u8, 111_u8, 110_u8, 101_u8, 13_u8, 10_u8];

const reply_type_string: Array<u8, 9> =[43_u8, 115_u8, 116_u8, 114_u8, 105_u8, 110_u8, 103_u8, 13_u8, 10_u8];

const reply_type_list: Array<u8, 7> =[43_u8, 108_u8, 105_u8, 115_u8, 116_u8, 13_u8, 10_u8];

const reply_type_set: Array<u8, 6> =[43_u8, 115_u8, 101_u8, 116_u8, 13_u8, 10_u8];

const reply_type_hash: Array<u8, 7> =[43_u8, 104_u8, 97_u8, 115_u8, 104_u8, 13_u8, 10_u8];

const reply_type_zset: Array<u8, 7> =[43_u8, 122_u8, 115_u8, 101_u8, 116_u8, 13_u8, 10_u8];

const reply_zero: Array<u8, 4> =[58_u8, 48_u8, 13_u8, 10_u8];

const reply_one: Array<u8, 4> =[58_u8, 49_u8, 13_u8, 10_u8];

const reply_no_expiry: Array<u8, 5> =[58_u8, 45_u8, 49_u8, 13_u8, 10_u8];

const reply_no_key: Array<u8, 5> =[58_u8, 45_u8, 50_u8, 13_u8, 10_u8];

struct Expiry {
  at: u64;
  now: u64;
  state: u64;
}

struct Bounds {
  start: u64;
  end: u64;
}

struct Remaining {
  at: u64;
  now: u64;
  state: u64;
}

struct ExpireOptions {
  flags: u64;
  error: u64;
  at: u64;
}

fn key_at(input: &[u8], args: &Box<Slots<Span>>, index: u64) -> made: Key reads(input), reads(args) {
  doc "Copies one argument out of the input into a key of its own, hashed.";
  let span = arg(args: args, index: index);
  let made = make_key(input: input, start: span.start, length: span.length);
  return move made;
}

fn key_bounds(input: &[u8], args: &Box<Slots<Span>>, index: u64) -> bounds: Bounds reads(input), reads(args) contract {
  define input_length = input^.len;
  ensures bounds.start <= bounds.end;
  ensures bounds.end <= input_length;
} {
  doc "Where one argument lies in the input, as the bounds of a key the keyspace is reached by; an argument reaching past the input, which the parser never places, names no bytes.";
  let span = arg(args: args, index: index);
  let end = span.start +wrap span.length;
  let within = end <= input^.len;
  let ordered = span.start <= end;
  let fits = band(within, ordered);
  if fits {
    return Bounds(start: span.start, end: end);
  }
  return Bounds(start: 0_u64, end: 0_u64);
}

fn option_code(input: &[u8], span: Span) -> code: u64 reads(input) {
  doc "The number name_code packs from an option word's bytes up to its first zero byte, since Redis compares an option as a C string, with strcasecmp or letter by letter.";
  let length = span.length;
  for @bytes (offset in 0_u64..span.length) {
    let position = span.start +wrap offset;
    let byte = byte_at(input: input, index: position);
    if byte == 0_u8 {
      set length = offset;
      break @bytes;
    }
  }
  let code = name_code(input: input, start: span.start, length: length);
  return code;
}

fn kind_of(env: &Client, value: &Entry) -> kind: u64 reads(value), writes(env) {
  doc "Reports a live entry's kind: 1 a string, 2 a list, 3 a set, 4 a hash and 5 a sorted set, recording done in state; an expired one is 0, recording expired.";
  let reached = expired(expires: value^.expires, now: env^.now);
  if reached {
    set env^.state = state_expired;
    return 0_u64;
  }
  set env^.state = state_done;
  match value^.value {
    Text(bytes: stored) => {
      return 1_u64;
    }
    Items(items: list) => {
      return 2_u64;
    }
    Members(members: set_of) => {
      return 3_u64;
    }
    Fields(fields: hash_of) => {
      return 4_u64;
    }
    Ranked(ranked: sorted) => {
      return 5_u64;
    }
  }
}

fn entry_kind(slot: &Option<Entry>, client: &Client) -> kind: u64 writes(slot), writes(client) {
  doc "The kind of the value an entry holds, as kind_of reports it, removing it when its expiry has been reached; 0 for an absent or expired key.";
  set client^.state = state_absent;
  let kind = 0_u64;
  match slot^ {
    Some(value: held) => {
      set kind = kind_of(env: client, value: held);
    }
    None() => {
    }
  }
  if client^.state == state_expired {
    set slot^ = None<Entry>();
    return 0_u64;
  }
  return kind;
}

fn remove_live(slot: &Option<Entry>, now: u64) -> found: u64 writes(slot) {
  doc "Removes an entry and reports what it held: 1 a live value, 2 one whose expiry had been reached, 0 nothing.";
  let found = 0_u64;
  match slot^ {
    Some(value: gone) => {
      let reached = expired(expires: gone^.expires, now: now);
      if reached {
        set found = 2_u64;
      } else {
        set found = 1_u64;
      }
    }
    None() => {
    }
  }
  set slot^ = None<Entry>();
  return found;
}

fn prepare_keys(input: &[u8], args: &Box<Slots<Span>>, client: &Client, first: u64) -> result: unit reads(input), reads(args), writes(client) {
  doc "Copies the arguments from first on into the client's prepared keys, the last argument first, so that taking them from the back takes them in order.";
  clear_items(client: client);
  let count = args^.inner.len;
  let many = count -sat first;
  for @keys (step in 0_u64..many) {
    let back = count -wrap step;
    let index = back -wrap 1_u64;
    let key = key_at(input: input, args: args, index: index);
    push_item(client: client, item: move key);
  }
  return unit;
}

fn named_keys(input: &[u8], args: &Box<Slots<Span>>) -> keys: KeySet reads(input), reads(args) {
  doc "The keys the arguments from the second on name, each carrying in the low 32 bits of its payload the index of the first argument naming it, which a request of at most 2^31 arguments leaves room for, and above them how many arguments name it.";
  let count = args^.inner.len;
  let keys = key_set_new(capacity: count);
  for @named (index in 1_u64..count) {
    let place = key_bounds(input: input, args: args, index: index);
    let key = &input^[place.start..place.end];
    let before = keys.len;
    key_set_add(keys: &keys, key: key, amount: count_unit);
    if keys.len > before {
      let first = count_unit +wrap index;
      key_set_put(keys: &keys, key: key, payload: first);
    }
  }
  return move keys;
}

fn named_bounds(input: &[u8], args: &Box<Slots<Span>>, payload: u64) -> bounds: Bounds reads(input), reads(args) contract {
  define input_length = input^.len;
  ensures bounds.start <= bounds.end;
  ensures bounds.end <= input_length;
} {
  doc "Where the key named_keys gave a payload lies in the input, as key_bounds places the argument whose index the payload carries.";
  let index = iand(payload, index_mask);
  let bounds = key_bounds(input: input, args: args, index: index);
  return bounds;
}

fn run_del(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "DEL key [key ...]: removes every key named, in one statement on their entries, and answers how many were live; a key named twice is removed and counted once. The file records a key found expired as log_removal does, then the command as it was sent when it removed a live key, as Redis propagates them.";
  let keys = named_keys(input: input, args: args);
  let removed = 0_u64;
  let logged = store^.logging;
  atomic s = &store^.state, slots = &s^.map[keys] {
    for @named (at in 0_u64..keys.len) {
      let found = remove_live(slot: &slots^[at], now: time^.check);
      if found == 1_u64 {
        set removed = removed +wrap 1_u64;
      }
      if found == 2_u64 {
        if logged {
          let payload = key_set_payload(keys: &keys, index: at);
          let place = named_bounds(input: input, args: args, payload: payload);
          let key = &input^[place.start..place.end];
          log_removal(log: &s^.meta.log, key: key);
        }
      }
    }
    if removed > 0_u64 {
      if logged {
        log_command(log: &s^.meta.log, input: input, args: args);
      }
    }
  }
  let answer = cvt.wrap::<u64, i64>(removed);
  reply_integer(client: client, value: answer);
  return unit;
}

fn run_exists(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "EXISTS key [key ...]: answers how many of the keys named are live, a key named twice counted twice, in one statement on their entries, removing a key found expired, which the file records as log_removal does.";
  let keys = named_keys(input: input, args: args);
  set client^.now = time^.check;
  let live = 0_u64;
  let logged = store^.logging;
  atomic s = &store^.state, slots = &s^.map[keys] {
    for @named (at in 0_u64..keys.len) {
      let kind = entry_kind(slot: &slots^[at], client: client);
      let payload = key_set_payload(keys: &keys, index: at);
      if kind != 0_u64 {
        let occurrences = ishr.wrap(payload, 32_u32);
        set live = live +wrap occurrences;
      }
      if client^.state == state_expired {
        if logged {
          let place = named_bounds(input: input, args: args, payload: payload);
          let key = &input^[place.start..place.end];
          log_removal(log: &s^.meta.log, key: key);
        }
      }
    }
  }
  let answer = cvt.wrap::<u64, i64>(live);
  reply_integer(client: client, value: answer);
  return unit;
}

fn run_type(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "TYPE key: answers the kind of the value a live key holds, or none, removing a key found expired, which the file records as log_removal does.";
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  set client^.now = time^.check;
  let kind = 0_u64;
  let logged = store^.logging;
  atomic s = &store^.state, slot = &s^.map[key] {
    set kind = entry_kind(slot: slot, client: client);
    if client^.state == state_expired {
      if logged {
        log_removal(log: &s^.meta.log, key: key);
      }
    }
  }
  if kind == 1_u64 {
    reply_word(client: client, word: &reply_type_string[0_u64..9_u64]);
  } else if kind == 2_u64 {
    reply_word(client: client, word: &reply_type_list[0_u64..7_u64]);
  } else if kind == 3_u64 {
    reply_word(client: client, word: &reply_type_set[0_u64..6_u64]);
  } else if kind == 4_u64 {
    reply_word(client: client, word: &reply_type_hash[0_u64..7_u64]);
  } else if kind == 5_u64 {
    reply_word(client: client, word: &reply_type_zset[0_u64..7_u64]);
  } else {
    reply_word(client: client, word: &reply_type_none[0_u64..7_u64]);
  }
  return unit;
}

fn clear_expiry(env: &Expiry, value: &Entry) -> result: u64 writes(env), writes(value) {
  doc "Removes a live entry's expiry. State 1 removed one, 0 found none, and 2 marks an expired entry.";
  let reached = expired(expires: value^.expires, now: env^.now);
  if reached {
    set env^.state = state_expired;
    return 2_u64;
  }
  if value^.expires == 0_u64 {
    set env^.state = state_absent;
    return 0_u64;
  }
  set value^.expires = 0_u64;
  set env^.state = state_done;
  return 1_u64;
}

fn read_expiry(env: &Remaining, value: &Entry) -> result: u64 reads(value), writes(env) {
  doc "Reads a live entry's expiry. State 2 has one, its calendar milliseconds recorded in at, 1 has none, and 0 marks an expired entry.";
  let reached = expired(expires: value^.expires, now: env^.now);
  if reached {
    set env^.state = 0_u64;
    return 0_u64;
  }
  if value^.expires == 0_u64 {
    set env^.state = 1_u64;
    return 1_u64;
  }
  set env^.at = value^.expires;
  set env^.state = 2_u64;
  return 2_u64;
}

fn log_expire_at(log: &Box<Slots<u8>>, input: &[u8], key: Span, at_ms: u64) -> result: unit reads(input), writes(log) {
  doc "Appends PEXPIREAT key with the expiry as calendar milliseconds, as Redis 7.0.15 propagates an expiry GETEX sets.";
  let room = key.length +wrap 64_u64;
  log_count(log: log, count: 3_u64, room: room);
  log_word(log: log, word: &word_pexpireat[0_u64..9_u64]);
  log_input(log: log, input: input, span: key);
  log_decimal(log: log, value: at_ms);
  return unit;
}

fn log_expire_options(log: &Box<Slots<u8>>, input: &[u8], args: &Box<Slots<Span>>, at_ms: u64) -> result: unit reads(input), reads(args), writes(log) {
  doc "Appends PEXPIREAT key with the expiry as calendar milliseconds, then the command's options as they were sent, the form Redis 7.0.15 propagates EXPIRE, PEXPIRE and EXPIREAT in.";
  let count = args^.inner.len;
  let key = arg(args: args, index: 1_u64);
  let room = key.length +wrap 64_u64;
  log_count(log: log, count: count, room: room);
  log_word(log: log, word: &word_pexpireat[0_u64..9_u64]);
  log_input(log: log, input: input, span: key);
  log_decimal(log: log, value: at_ms);
  for @options (index in 3_u64..count) {
    let span = args^.inner[index];
    log_input(log: log, input: input, span: span);
  }
  return unit;
}

fn log_key_word(log: &Box<Slots<u8>>, word: &[u8], input: &[u8], key: Span) -> result: unit reads(word), reads(input), writes(log) {
  doc "Appends a command of one word and a key.";
  let room = key.length +wrap 32_u64;
  log_count(log: log, count: 2_u64, room: room);
  log_word(log: log, word: word);
  log_input(log: log, input: input, span: key);
  return unit;
}

fn expire_options(input: &[u8], args: &Box<Slots<Span>>) -> options: ExpireOptions reads(input), reads(args) {
  doc "Reads EXPIRE's options from the fourth argument on as Redis 7.0.15's parseExtendedExpireArgumentsOrReply reads them, each compared with strcasecmp, so in either case and up to a zero byte: NX, XX, GT and LT. Error 1 is a word that is none of them, at the index at records; 2 is NX beside another option and 3 is GT beside LT, judged once every word has been read.";
  let count = args^.inner.len;
  let flags = 0_u64;
  for @options (index in 3_u64..count) {
    let span = arg(args: args, index: index);
    let code = option_code(input: input, span: span);
    if code == code_nx {
      set flags = ior(flags, expire_nx);
    } else if code == code_xx {
      set flags = ior(flags, expire_xx);
    } else if code == code_gt {
      set flags = ior(flags, expire_gt);
    } else if code == code_lt {
      set flags = ior(flags, expire_lt);
    } else {
      return ExpireOptions(flags: 0_u64, error: 1_u64, at: index);
    }
  }
  let fresh = iand(flags, expire_nx);
  let others = iand(flags, expire_others);
  let lone = fresh != 0_u64;
  let crowded = others != 0_u64;
  let clash = band(lone, crowded);
  if clash {
    return ExpireOptions(flags: 0_u64, error: 2_u64, at: 0_u64);
  }
  let greater = iand(flags, expire_gt);
  let less = iand(flags, expire_lt);
  let above = greater != 0_u64;
  let below = less != 0_u64;
  let both = band(above, below);
  if both {
    return ExpireOptions(flags: 0_u64, error: 3_u64, at: 0_u64);
  }
  return ExpireOptions(flags: flags, error: 0_u64, at: 0_u64);
}

fn expire_allowed(flags: u64, current: u64, deadline: i64) -> allowed: Bool pure {
  doc "Whether EXPIRE's options let it give a key whose expiry is current, zero for none, the expiry deadline, as Redis 7.0.15 judges them: NX only a key without one, XX only a key with one, GT only a later expiry than the key's, a key without one counting as never expiring, and LT only an earlier one, a key without one taking any.";
  let none = current == 0_u64;
  let held = cvt.wrap::<u64, i64>(current);
  let fresh = iand(flags, expire_nx);
  if fresh != 0_u64 {
    if none {
    } else {
      return False();
    }
  }
  let present = iand(flags, expire_xx);
  if present != 0_u64 {
    if none {
      return False();
    }
  }
  let greater = iand(flags, expire_gt);
  if greater != 0_u64 {
    if none {
      return False();
    }
    if deadline <= held {
      return False();
    }
  }
  let less = iand(flags, expire_lt);
  if less != 0_u64 {
    if none {
    } else if deadline >= held {
      return False();
    }
  }
  return True();
}

fn reply_unsupported(client: &Client, input: &[u8], span: Span) -> result: unit reads(input), writes(client) {
  doc "Writes the error Redis 7.0.15 replies to an option of EXPIRE it does not know: the option as a C string, up to a zero byte, with its trailing carriage returns and line feeds dropped and any others written as spaces, as addReplyErrorFormat trims and maps them.";
  let length = span.length;
  for @bytes (offset in 0_u64..span.length) {
    let position = span.start +wrap offset;
    let byte = byte_at(input: input, index: position);
    if byte == 0_u8 {
      set length = offset;
      break @bytes;
    }
  }
  loop @trailing {
    if length == 0_u64 {
      break @trailing;
    }
    let back = span.start +wrap length;
    let position = back -wrap 1_u64;
    let last = byte_at(input: input, index: position);
    let carriage = last == 13_u8;
    let feed = last == 10_u8;
    let ending = bor(carriage, feed);
    if ending {
      set length = length -wrap 1_u64;
    } else {
      break @trailing;
    }
  }
  reply_byte(client: client, value: 45_u8);
  reply_word(client: client, word: &text_unsupported[0_u64..23_u64]);
  let shown = Span(start: span.start, length: length);
  let written = reply_echoed(client: client, input: input, span: shown, limit: length);
  reply_word(client: client, word: &text_crlf[0_u64..2_u64]);
  return unit;
}

fn run_expire(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time, scale: u64, absolute: Bool, invalid: &[u8]) -> result: unit reads(store), reads(input), reads(args), reads(env), reads(time), reads(invalid), writes(client) waits {
  doc "EXPIRE key seconds (scale 1000), PEXPIRE key milliseconds (scale 1), EXPIREAT key unix-seconds (absolute, scale 1000) and PEXPIREAT key unix-milliseconds (absolute), each with NX, XX, GT or LT: gives a live key the expiry at those calendar milliseconds, a relative amount counting from the command's time, when the options allow it, or removes the key when that time has passed, and answers 1 when it did either and 0 otherwise, as Redis 7.0.15's expireGenericCommand does. The options are judged first, then the amount: one whose milliseconds, or their sum with the command's time, leave the range of i64 is answered with invalid. The file records an expiry as PEXPIREAT key at with the options as they were sent, a PEXPIREAT as it was sent, a removal as DEL key, and a key found expired as log_removal does. While a file is replayed an expiry already past is kept as one already reached, as Redis keeps it while loading, so a later PERSIST in the file still finds the key.";
  let options = expire_options(input: input, args: args);
  if options.error == 1_u64 {
    let option = arg(args: args, index: options.at);
    reply_unsupported(client: client, input: input, span: option);
    return unit;
  }
  if options.error == 2_u64 {
    reply_error(client: client, word: &text_expire_nx[0_u64..67_u64]);
    return unit;
  }
  if options.error == 3_u64 {
    reply_error(client: client, word: &text_expire_gt[0_u64..57_u64]);
    return unit;
  }
  let key_span = arg(args: args, index: 1_u64);
  let amount = arg(args: args, index: 2_u64);
  let number = read_integer(input: input, start: amount.start, length: amount.length);
  if number.state != 1_u64 {
    reply_error(client: client, word: &text_not_integer[0_u64..43_u64]);
    return unit;
  }
  let deadline = number.value;
  if scale == 1000_u64 {
    let above = deadline > 9223372036854775_i64;
    let below = deadline < -9223372036854775_i64;
    let outside = bor(above, below);
    if outside {
      reply_error(client: client, word: invalid);
      return unit;
    }
    set deadline = deadline *wrap 1000_i64;
  }
  let now = cvt.wrap::<u64, i64>(time^.unix_ms);
  let base = now;
  if absolute {
    set base = 0_i64;
  }
  let room = 9223372036854775807_i64 -wrap base;
  if deadline > room {
    reply_error(client: client, word: invalid);
    return unit;
  }
  set deadline = deadline +wrap base;
  let remove_now = deadline <= now;
  if time^.loading {
    set remove_now = False();
  }
  let expires = 1_u64;
  if deadline > 0_i64 {
    set expires = cvt.wrap::<i64, u64>(deadline);
  }
  let as_sent = False();
  if absolute {
    set as_sent = scale == 1_u64;
  }
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let logged = store^.logging;
  set client^.now = time^.check;
  let done = False();
  atomic s = &store^.state, slot = &s^.map[key] {
    let kind = entry_kind(slot: slot, client: client);
    if client^.state == state_expired {
      if logged {
        log_removal(log: &s^.meta.log, key: key);
      }
    }
    if kind != 0_u64 {
      let current = held_expiry(slot: slot);
      let allowed = expire_allowed(flags: options.flags, current: current, deadline: deadline);
      if allowed {
        if remove_now {
          set slot^ = None<Entry>();
          if logged {
            log_key_word(log: &s^.meta.log, word: &word_del[0_u64..3_u64], input: input, key: key_span);
          }
        } else {
          hold_expiry(slot: slot, expires: expires);
          queue_expiry(meta: &s^.meta, key: key, at: expires, env: env);
          if logged {
            if as_sent {
              log_command(log: &s^.meta.log, input: input, args: args);
            } else {
              log_expire_options(log: &s^.meta.log, input: input, args: args, at_ms: expires);
            }
          }
        }
        set done = True();
      }
    }
  }
  if done {
    reply_word(client: client, word: &reply_one[0_u64..4_u64]);
    return unit;
  }
  reply_word(client: client, word: &reply_zero[0_u64..4_u64]);
  return unit;
}

fn run_ttl(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time, in_seconds: Bool, absolute: Bool) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "TTL key and PTTL key: answers the time a live key has left, in seconds rounded as Redis rounds them or in milliseconds; EXPIRETIME key and PEXPIRETIME key (absolute): its expiry's calendar time, in seconds rounded so or in milliseconds; -1 for a key without an expiry and -2 for an absent or expired one, removing an expired key, which the file records as log_removal does.";
  let remaining = Remaining(at: 0_u64, now: time^.check, state: 3_u64);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  atomic s = &store^.state, slot = &s^.map[key] {
    match slot^ {
      Some(value: held) => {
        let found = read_expiry(env: &remaining, value: held);
      }
      None() => {
      }
    }
    if remaining.state == 0_u64 {
      set slot^ = None<Entry>();
      if store^.logging {
        log_removal(log: &s^.meta.log, key: key);
      }
    }
  }
  if remaining.state == 1_u64 {
    reply_word(client: client, word: &reply_no_expiry[0_u64..5_u64]);
    return unit;
  }
  if remaining.state == 2_u64 {
    let answer = remaining.at -wrap time^.check;
    if absolute {
      set answer = remaining.at;
    }
    if in_seconds {
      let rounded = answer +wrap 500_u64;
      set answer = rounded / 1000_u64;
    }
    let signed = cvt.wrap::<u64, i64>(answer);
    reply_integer(client: client, value: signed);
    return unit;
  }
  reply_word(client: client, word: &reply_no_key[0_u64..5_u64]);
  return unit;
}

fn run_persist(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "PERSIST key: removes a live key's expiry and answers 1 when it had one, 0 otherwise, removing an expired key, which the file records as log_removal does.";
  let expiry = Expiry(at: 0_u64, now: time^.check, state: state_absent);
  let key_span = arg(args: args, index: 1_u64);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  atomic s = &store^.state, slot = &s^.map[key] {
    match slot^ {
      Some(value: held) => {
        let outcome = clear_expiry(env: &expiry, value: held);
      }
      None() => {
      }
    }
    if expiry.state == state_expired {
      set slot^ = None<Entry>();
      if store^.logging {
        log_removal(log: &s^.meta.log, key: key);
      }
    }
    if expiry.state == state_done {
      if store^.logging {
        log_key_word(log: &s^.meta.log, word: &word_persist[0_u64..7_u64], input: input, key: key_span);
      }
    }
  }
  if expiry.state == state_done {
    reply_word(client: client, word: &reply_one[0_u64..4_u64]);
    return unit;
  }
  reply_word(client: client, word: &reply_zero[0_u64..4_u64]);
  return unit;
}

fn run_dbsize(store: &Keyspace, client: &Client) -> result: unit reads(store), writes(client) waits {
  doc "DBSIZE: answers how many keys the keyspace holds, counting an expired key not yet removed, as Redis does, in one statement that holds the keyspace's table whole.";
  let size = 0_u64;
  atomic s = &store^.state {
    set size = keyed_table_count::<Entry>(table: &s^.map);
  }
  let answer = cvt.wrap::<u64, i64>(size);
  reply_integer(client: client, value: answer);
  return unit;
}
