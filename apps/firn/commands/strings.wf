alias Key = pkg::bytes::Key;
alias Client = pkg::protocol::Client;
alias Entry = pkg::store::Entry;
alias KeyEnv = pkg::bytes::KeyEnv;
alias Span = pkg::protocol::Span;
alias Keyspace = pkg::store::Keyspace;
alias Time = pkg::store::Time;
alias Value = pkg::store::Value;
alias arg = pkg::protocol::arg;
alias expired = pkg::store::expired;
alias remove_expired = pkg::store::remove_expired;
alias log_command = pkg::store::log_command;
alias log_count = pkg::store::log_count;
alias log_input = pkg::store::log_input;
alias log_word = pkg::store::log_word;
alias queue_expiry = pkg::store::queue_expiry;
alias name_is = pkg::bytes::name_is;
alias read_integer = pkg::bytes::read_integer;
alias reply_bulk_input = pkg::protocol::reply_bulk_input;
alias reply_array = pkg::protocol::reply_array;
alias reply_error = pkg::protocol::reply_error;
alias reply_integer = pkg::protocol::reply_integer;
alias reply_nil = pkg::protocol::reply_nil;
alias reply_ok = pkg::protocol::reply_ok;
alias reply_echoed = pkg::protocol::reply_echoed;
alias reply_word = pkg::protocol::reply_word;
alias reply_wrong_type = pkg::protocol::reply_wrong_type;
alias Bytes = pkg::bytes::Bytes;
alias bytes_new = pkg::bytes::bytes_new;
alias bytes_integer = pkg::bytes::bytes_integer;
alias decimal_text = pkg::bytes::decimal_text;
alias reply_text = pkg::protocol::reply_text;

const word_set: Array<u8, 3> =[83_u8, 69_u8, 84_u8];

const word_ex: Array<u8, 2> =[69_u8, 88_u8];

const word_px: Array<u8, 2> =[80_u8, 88_u8];

const reply_pong: Array<u8, 7> =[43_u8, 80_u8, 79_u8, 78_u8, 71_u8, 13_u8, 10_u8];

const text_overflow: Array<u8, 41> =[69_u8, 82_u8, 82_u8, 32_u8, 105_u8, 110_u8, 99_u8, 114_u8, 101_u8, 109_u8, 101_u8, 110_u8, 116_u8, 32_u8, 111_u8, 114_u8, 32_u8, 100_u8, 101_u8, 99_u8, 114_u8, 101_u8, 109_u8, 101_u8, 110_u8, 116_u8, 32_u8, 119_u8, 111_u8, 117_u8, 108_u8, 100_u8, 32_u8, 111_u8, 118_u8, 101_u8, 114_u8, 102_u8, 108_u8, 111_u8, 119_u8];

const text_expire_set: Array<u8, 40> =[69_u8, 82_u8, 82_u8, 32_u8, 105_u8, 110_u8, 118_u8, 97_u8, 108_u8, 105_u8, 100_u8, 32_u8, 101_u8, 120_u8, 112_u8, 105_u8, 114_u8, 101_u8, 32_u8, 116_u8, 105_u8, 109_u8, 101_u8, 32_u8, 105_u8, 110_u8, 32_u8, 39_u8, 115_u8, 101_u8, 116_u8, 39_u8, 32_u8, 99_u8, 111_u8, 109_u8, 109_u8, 97_u8, 110_u8, 100_u8];

struct Counted {
  value: i64;
  now: u64;
  state: u64;
}

fn run_ping(input: &[u8], args: &Box<Slots<Span>>, client: &Client) -> result: unit reads(input), reads(args), writes(client) {
  doc "PING [message]: answers PONG, or the message as a bulk string.";
  if args^.inner.len == 2_u64 {
    let message = arg(args: args, index: 1_u64);
    reply_bulk_input(client: client, input: input, start: message.start, length: message.length);
    return unit;
  }
  reply_word(client: client, word: &reply_pong[0_u64..7_u64]);
  return unit;
}

fn run_echo(input: &[u8], args: &Box<Slots<Span>>, client: &Client) -> result: unit reads(input), reads(args), writes(client) {
  doc "ECHO message: answers the message as a bulk string.";
  let message = arg(args: args, index: 1_u64);
  reply_bulk_input(client: client, input: input, start: message.start, length: message.length);
  return unit;
}

fn text_value(env: &Client, value: &Entry) -> kind: u64 reads(value), writes(env) {
  doc "Writes a live string's bytes as a bulk string reply, recording done; records wrong for another kind and expired for an expired entry, writing nothing.";
  let reached = expired(expires: value^.expires, now: env^.now);
  if reached {
    set env^.state = state_expired;
    return 0_u64;
  }
  match value^.value {
    Text(bytes: stored) => {
      reply_text(client: env, text: stored);
      set env^.state = state_done;
      return 1_u64;
    }
    Items(items: list) => {
      set env^.state = state_wrong;
      return 2_u64;
    }
    Members(members: set_of) => {
      set env^.state = state_wrong;
      return 3_u64;
    }
    Fields(fields: hash_of) => {
      set env^.state = state_wrong;
      return 4_u64;
    }
    Ranked(ranked: sorted) => {
      set env^.state = state_wrong;
      return 5_u64;
    }
  }
}

fn run_get(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "GET key: answers a live string as a bulk string, written into the reply inside the statement on the key that finds it; a key whose expiry has been reached is removed there instead.";
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  set client^.now = time^.check;
  set client^.state = state_absent;
  atomic s = &store^.state, slot = &s^.map[key] {
    match slot^ {
      Some(value: held) => {
        let kind = text_value(env: client, value: held);
      }
      None() => {
      }
    }
  }
  if client^.state == state_expired {
    remove_expired(store: store, key: key, now: client^.now);
  }
  if client^.state == state_done {
    return unit;
  }
  if client^.state == state_wrong {
    reply_wrong_type(client: client);
    return unit;
  }
  reply_nil(client: client);
  return unit;
}

fn put_text(slot: &Option<Entry>, value: Bytes, expires: u64) -> result: unit writes(slot) {
  doc "Stores a string in an entry, replacing any value it held.";
  let text = Value::Text(bytes: move value);
  let held_entry = Entry(value: move text, expires: expires);
  set slot^ = Some<Entry>(value: move held_entry);
  return unit;
}

fn run_set(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(env), reads(time), writes(client) waits {
  doc "SET key value [EX seconds | PX milliseconds]: stores the value with the expiry the option gives, counted from the command's time, or none, replacing any value the key held, in one atomic statement that also appends the change to the append-only file's pending bytes. Redis's other options are answered as a syntax error.";
  let count = args^.inner.len;
  let expires = 0_u64;
  if count == 5_u64 {
    let option = arg(args: args, index: 3_u64);
    let in_seconds = name_is(input: input, start: option.start, length: option.length, word: &word_ex[0_u64..2_u64]);
    let in_milliseconds = name_is(input: input, start: option.start, length: option.length, word: &word_px[0_u64..2_u64]);
    let known = bor(in_seconds, in_milliseconds);
    if known {
    } else {
      reply_error(client: client, word: &text_syntax[0_u64..16_u64]);
      return unit;
    }
    let amount = arg(args: args, index: 4_u64);
    let number = read_integer(input: input, start: amount.start, length: amount.length);
    if number.state != 1_u64 {
      reply_error(client: client, word: &text_not_integer[0_u64..43_u64]);
      return unit;
    }
    let positive = number.value > 0_i64;
    if positive {
    } else {
      reply_error(client: client, word: &text_expire_set[0_u64..40_u64]);
      return unit;
    }
    let value = cvt.wrap::<i64, u64>(number.value);
    if in_seconds {
      if value > 9223372036854775_u64 {
        reply_error(client: client, word: &text_expire_set[0_u64..40_u64]);
        return unit;
      }
      set value = value *wrap 1000_u64;
    }
    let at = value +wrap time^.unix_ms;
    if at > 9223372036854775807_u64 {
      reply_error(client: client, word: &text_expire_set[0_u64..40_u64]);
      return unit;
    }
    set expires = at;
  } else if count != 3_u64 {
    reply_error(client: client, word: &text_syntax[0_u64..16_u64]);
    return unit;
  }
  let key_span = arg(args: args, index: 1_u64);
  let value_span = arg(args: args, index: 2_u64);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let value = bytes_new(input: input, start: value_span.start, length: value_span.length);
  let at_ms = expires;
  let queued = expires != 0_u64;
  let logged = store^.logging;
  atomic s = &store^.state, slot = &s^.map[key] {
    put_text(slot: slot, value: move value, expires: expires);
    if queued {
      queue_expiry(meta: &s^.meta, key: key, at: expires, env: env);
    }
    if logged {
      let key_value = arg(args: args, index: 2_u64);
      let room = key_span.length +wrap key_value.length;
      log_count(log: &s^.meta.log, count: 3_u64, room: room);
      log_word(log: &s^.meta.log, word: &word_set[0_u64..3_u64]);
      log_input(log: &s^.meta.log, input: input, span: key_span);
      log_input(log: &s^.meta.log, input: input, span: key_value);
      if queued {
        log_expire_at(log: &s^.meta.log, input: input, key: key_span, at_ms: at_ms);
      }
    }
  }
  reply_ok(client: client);
  return unit;
}

fn run_mset(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv) -> result: unit reads(store), reads(input), reads(args), writes(client) waits {
  doc "MSET key value [key value ...]: stores every pair, removing any expiry the keys had, in one statement on the keys' entries; a key named twice keeps its last value.";
  let count = args^.inner.len;
  let pairs = count / 2_u64;
  let keys = key_set_new(capacity: pairs);
  for @pairs (pair in 0_u64..pairs) {
    let doubled = pair *wrap 2_u64;
    let index = doubled +wrap 1_u64;
    let place = key_bounds(input: input, args: args, index: index);
    let key = &input^[place.start..place.end];
    let next = index +wrap 1_u64;
    key_set_put(keys: &keys, key: key, payload: next);
  }
  atomic s = &store^.state, slots = &s^.map[keys] {
    for @stored (at in 0_u64..keys.len) {
      let position = key_set_payload(keys: &keys, index: at);
      let value_span = arg(args: args, index: position);
      let value = bytes_new(input: input, start: value_span.start, length: value_span.length);
      put_text(slot: &slots^[at], value: move value, expires: 0_u64);
    }
    if store^.logging {
      log_command(log: &s^.meta.log, input: input, args: args);
    }
  }
  reply_ok(client: client);
  return unit;
}

fn bump_value(env: &Counted, value: &Entry) -> result: u64 writes(env), writes(value) {
  doc "Adds one to a live stored decimal in place, keeping its expiry. State 1 is done, 3 marks another kind, 5 a string that is not a number, 6 a sum past the range of i64, and 2 an expired entry.";
  let reached = expired(expires: value^.expires, now: env^.now);
  if reached {
    set env^.state = state_expired;
    return 2_u64;
  }
  match value^.value {
    Text(bytes: stored) => {
      let number = bytes_integer(bytes: stored);
      if number.state != 1_u64 {
        set env^.state = 5_u64;
        return 5_u64;
      }
      if number.value == 9223372036854775807_i64 {
        set env^.state = 6_u64;
        return 6_u64;
      }
      let bumped = number.value +wrap 1_i64;
      let fresh = decimal_text(value: bumped);
      set stored^ = move fresh;
      set env^.value = bumped;
      set env^.state = state_done;
      return 1_u64;
    }
    Items(items: list) => {
      set env^.state = state_wrong;
      return 3_u64;
    }
    Members(members: set_of) => {
      set env^.state = state_wrong;
      return 3_u64;
    }
    Fields(fields: hash_of) => {
      set env^.state = state_wrong;
      return 3_u64;
    }
    Ranked(ranked: sorted) => {
      set env^.state = state_wrong;
      return 3_u64;
    }
  }
}

fn run_incr(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "INCR key: adds one to the stored number, keeping its expiry, or stores 1 without one for an absent or expired key, in one atomic statement.";
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let counted = Counted(value: 0_i64, now: time^.check, state: state_absent);
  atomic s = &store^.state, slot = &s^.map[key] {
    let fresh_needed = True();
    match slot^ {
      Some(value: held) => {
        let outcome = bump_value(env: &counted, value: held);
        set fresh_needed = False();
      }
      None() => {
      }
    }
    if counted.state == state_expired {
      set fresh_needed = True();
    }
    if fresh_needed {
      let fresh = decimal_text(value: 1_i64);
      put_text(slot: slot, value: move fresh, expires: 0_u64);
      set counted.value = 1_i64;
      set counted.state = state_done;
    }
    if counted.state == state_done {
      if store^.logging {
        log_command(log: &s^.meta.log, input: input, args: args);
      }
    }
  }
  if counted.state == state_done {
    reply_integer(client: client, value: counted.value);
  } else if counted.state == state_wrong {
    reply_wrong_type(client: client);
  } else if counted.state == 6_u64 {
    reply_error(client: client, word: &text_overflow[0_u64..41_u64]);
  } else {
    reply_error(client: client, word: &text_not_integer[0_u64..43_u64]);
  }
  return unit;
}
