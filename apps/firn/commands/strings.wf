const text_expire_set: Array<u8, 40> =[69_u8, 82_u8, 82_u8, 32_u8, 105_u8, 110_u8, 118_u8, 97_u8, 108_u8, 105_u8, 100_u8, 32_u8, 101_u8, 120_u8, 112_u8, 105_u8, 114_u8, 101_u8, 32_u8, 116_u8, 105_u8, 109_u8, 101_u8, 32_u8, 105_u8, 110_u8, 32_u8, 39_u8, 115_u8, 101_u8, 116_u8, 39_u8, 32_u8, 99_u8, 111_u8, 109_u8, 109_u8, 97_u8, 110_u8, 100_u8];

const text_config: Array<u8, 25> =[45_u8, 69_u8, 82_u8, 82_u8, 32_u8, 117_u8, 110_u8, 107_u8, 110_u8, 111_u8, 119_u8, 110_u8, 32_u8, 115_u8, 117_u8, 98_u8, 99_u8, 111_u8, 109_u8, 109_u8, 97_u8, 110_u8, 100_u8, 32_u8, 39_u8];

const word_save: Array<u8, 4> =[83_u8, 65_u8, 86_u8, 69_u8];

const word_appendonly: Array<u8, 10> =[65_u8, 80_u8, 80_u8, 69_u8, 78_u8, 68_u8, 79_u8, 78_u8, 76_u8, 89_u8];

const text_config_get_arity: Array<u8, 57> =[45_u8, 69_u8, 82_u8, 82_u8, 32_u8, 119_u8, 114_u8, 111_u8, 110_u8, 103_u8, 32_u8, 110_u8, 117_u8, 109_u8, 98_u8, 101_u8, 114_u8, 32_u8, 111_u8, 102_u8, 32_u8, 97_u8, 114_u8, 103_u8, 117_u8, 109_u8, 101_u8, 110_u8, 116_u8, 115_u8, 32_u8, 102_u8, 111_u8, 114_u8, 32_u8, 39_u8, 99_u8, 111_u8, 110_u8, 102_u8, 105_u8, 103_u8, 124_u8, 103_u8, 101_u8, 116_u8, 39_u8, 32_u8, 99_u8, 111_u8, 109_u8, 109_u8, 97_u8, 110_u8, 100_u8, 13_u8, 10_u8];

const text_config_set_arity: Array<u8, 57> =[45_u8, 69_u8, 82_u8, 82_u8, 32_u8, 119_u8, 114_u8, 111_u8, 110_u8, 103_u8, 32_u8, 110_u8, 117_u8, 109_u8, 98_u8, 101_u8, 114_u8, 32_u8, 111_u8, 102_u8, 32_u8, 97_u8, 114_u8, 103_u8, 117_u8, 109_u8, 101_u8, 110_u8, 116_u8, 115_u8, 32_u8, 102_u8, 111_u8, 114_u8, 32_u8, 39_u8, 99_u8, 111_u8, 110_u8, 102_u8, 105_u8, 103_u8, 124_u8, 115_u8, 101_u8, 116_u8, 39_u8, 32_u8, 99_u8, 111_u8, 109_u8, 109_u8, 97_u8, 110_u8, 100_u8, 13_u8, 10_u8];

const reply_config_save: Array<u8, 20> =[42_u8, 50_u8, 13_u8, 10_u8, 36_u8, 52_u8, 13_u8, 10_u8, 115_u8, 97_u8, 118_u8, 101_u8, 13_u8, 10_u8, 36_u8, 48_u8, 13_u8, 10_u8, 13_u8, 10_u8];

const reply_config_append_yes: Array<u8, 30> =[42_u8, 50_u8, 13_u8, 10_u8, 36_u8, 49_u8, 48_u8, 13_u8, 10_u8, 97_u8, 112_u8, 112_u8, 101_u8, 110_u8, 100_u8, 111_u8, 110_u8, 108_u8, 121_u8, 13_u8, 10_u8, 36_u8, 51_u8, 13_u8, 10_u8, 121_u8, 101_u8, 115_u8, 13_u8, 10_u8];

const reply_config_append_no: Array<u8, 29> =[42_u8, 50_u8, 13_u8, 10_u8, 36_u8, 49_u8, 48_u8, 13_u8, 10_u8, 97_u8, 112_u8, 112_u8, 101_u8, 110_u8, 100_u8, 111_u8, 110_u8, 108_u8, 121_u8, 13_u8, 10_u8, 36_u8, 50_u8, 13_u8, 10_u8, 110_u8, 111_u8, 13_u8, 10_u8];

const text_config_set: Array<u8, 61> =[45_u8, 69_u8, 82_u8, 82_u8, 32_u8, 85_u8, 110_u8, 107_u8, 110_u8, 111_u8, 119_u8, 110_u8, 32_u8, 111_u8, 112_u8, 116_u8, 105_u8, 111_u8, 110_u8, 32_u8, 111_u8, 114_u8, 32_u8, 110_u8, 117_u8, 109_u8, 98_u8, 101_u8, 114_u8, 32_u8, 111_u8, 102_u8, 32_u8, 97_u8, 114_u8, 103_u8, 117_u8, 109_u8, 101_u8, 110_u8, 116_u8, 115_u8, 32_u8, 102_u8, 111_u8, 114_u8, 32_u8, 67_u8, 79_u8, 78_u8, 70_u8, 73_u8, 71_u8, 32_u8, 83_u8, 69_u8, 84_u8, 32_u8, 45_u8, 32_u8, 39_u8];

const text_quote_end: Array<u8, 3> =[39_u8, 13_u8, 10_u8];

const text_try_config: Array<u8, 21> =[39_u8, 46_u8, 32_u8, 84_u8, 114_u8, 121_u8, 32_u8, 67_u8, 79_u8, 78_u8, 70_u8, 73_u8, 71_u8, 32_u8, 72_u8, 69_u8, 76_u8, 80_u8, 46_u8, 13_u8, 10_u8];

struct Counted {
  value: i64;
  now: u64;
  state: u64;
}

fn run_ping(input: &[u8], args: &Box<Slots<Span>>, client: &Client) -> result: unit reads(input), reads(args), writes(client) {
  doc "PING [message]: answers PONG, or the message as a bulk string.";
  if args^.inner.len == 2_u64 {
    let message = arg(args: args, index: 1_u64);
    reply_bulk_input(client: client, input: input, start: message.start, length: message.length);
    return unit;
  }
  reply_word(client: client, word: &reply_pong[0_u64..7_u64]);
  return unit;
}

fn run_echo(input: &[u8], args: &Box<Slots<Span>>, client: &Client) -> result: unit reads(input), reads(args), writes(client) {
  doc "ECHO message: answers the message as a bulk string.";
  let message = arg(args: args, index: 1_u64);
  reply_bulk_input(client: client, input: input, start: message.start, length: message.length);
  return unit;
}

fn text_value(env: &Client, value: &Entry) -> kind: u64 reads(value), writes(env) {
  doc "Writes a live string's bytes as a bulk string reply, recording done; records wrong for another kind and expired for an expired entry, writing nothing.";
  let reached = expired(expires: value^.expires, now: env^.now);
  if reached {
    set env^.state = state_expired;
    return 0_u64;
  }
  match value^.value {
    Text(bytes: stored) => {
      reply_text(client: env, text: stored);
      set env^.state = state_done;
      return 1_u64;
    }
    Items(items: list) => {
      set env^.state = state_wrong;
      return 2_u64;
    }
    Members(members: set_of) => {
      set env^.state = state_wrong;
      return 3_u64;
    }
    Fields(fields: hash_of) => {
      set env^.state = state_wrong;
      return 4_u64;
    }
    Ranked(ranked: sorted) => {
      set env^.state = state_wrong;
      return 5_u64;
    }
  }
}

fn run_get(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "GET key: answers a live string as a bulk string, written into the reply inside the statement on the key that finds it; a key whose expiry has been reached is removed there instead.";
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  set client^.now = time^.check;
  set client^.state = state_absent;
  atomic slot = &store^.map[key] {
    match slot^ {
      Some(value: held) => {
        let kind = text_value(env: client, value: held);
      }
      None() => {
      }
    }
    if client^.state == state_expired {
      set slot^ = None<Entry>();
    }
  }
  if client^.state == state_done {
    return unit;
  }
  if client^.state == state_wrong {
    reply_wrong_type(client: client);
    return unit;
  }
  reply_nil(client: client);
  return unit;
}

fn put_text(slot: &Option<Entry>, value: Bytes, expires: u64) -> result: unit writes(slot) {
  doc "Stores a string in an entry, replacing any value it held.";
  let text = Value::Text(bytes: move value);
  let held_entry = Entry(value: move text, expires: expires);
  set slot^ = Some<Entry>(value: move held_entry);
  return unit;
}

fn run_set(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(env), reads(time), writes(client) waits {
  doc "SET key value [EX seconds | PX milliseconds]: stores the value with the expiry the option gives, or none, replacing any value the key held, in one atomic statement that also appends the change to the append-only file's pending bytes. Redis's other options are answered as a syntax error.";
  let count = args^.inner.len;
  let ttl_ms = 0_u64;
  if count == 5_u64 {
    let option = arg(args: args, index: 3_u64);
    let in_seconds = name_is(input: input, start: option.start, length: option.length, word: &word_ex[0_u64..2_u64]);
    let in_milliseconds = name_is(input: input, start: option.start, length: option.length, word: &word_px[0_u64..2_u64]);
    let known = bor(in_seconds, in_milliseconds);
    if known {
    } else {
      reply_error(client: client, word: &text_syntax[0_u64..16_u64]);
      return unit;
    }
    let amount = arg(args: args, index: 4_u64);
    let number = read_integer(input: input, start: amount.start, length: amount.length);
    if number.state != 1_u64 {
      reply_error(client: client, word: &text_not_integer[0_u64..43_u64]);
      return unit;
    }
    let positive = number.value > 0_i64;
    if positive {
    } else {
      reply_error(client: client, word: &text_expire_set[0_u64..40_u64]);
      return unit;
    }
    let value = cvt.wrap::<i64, u64>(number.value);
    let beyond = value > 1000000000000_u64;
    if in_seconds {
      set beyond = value > 1000000000_u64;
    }
    if beyond {
      reply_error(client: client, word: &text_expire_set[0_u64..40_u64]);
      return unit;
    }
    set ttl_ms = value;
    if in_seconds {
      set ttl_ms = value *wrap 1000_u64;
    }
  } else if count != 3_u64 {
    reply_error(client: client, word: &text_syntax[0_u64..16_u64]);
    return unit;
  }
  let key_span = arg(args: args, index: 1_u64);
  let value_span = arg(args: args, index: 2_u64);
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let value = bytes_new(input: input, start: value_span.start, length: value_span.length);
  let expires = 0_u64;
  if ttl_ms != 0_u64 {
    let ttl_ns = ttl_ms *wrap 1000000_u64;
    set expires = time^.now +wrap ttl_ns;
  }
  let at_ms = time^.unix_ms +wrap ttl_ms;
  let queued = expires != 0_u64;
  let logged = store^.logging;
  let beside = bor(queued, logged);
  atomic slot = &store^.map[key] {
    put_text(slot: slot, value: move value, expires: expires);
    if beside {
      atomic meta = &store^.meta {
        if queued {
          queue_expiry(meta: &meta^, key: key, at: expires, env: env);
        }
        if logged {
          let key_value = arg(args: args, index: 2_u64);
          let room = key_span.length +wrap key_value.length;
          log_count(log: &meta^.log, count: 3_u64, room: room);
          log_word(log: &meta^.log, word: &word_set[0_u64..3_u64]);
          log_input(log: &meta^.log, input: input, span: key_span);
          log_input(log: &meta^.log, input: input, span: key_value);
          if queued {
            log_expire_at(log: &meta^.log, input: input, key: key_span, at_ms: at_ms);
          }
        }
      }
    }
  }
  reply_ok(client: client);
  return unit;
}

fn run_mset(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv) -> result: unit reads(store), reads(input), reads(args), writes(client) waits {
  doc "MSET key value [key value ...]: stores every pair, removing any expiry the keys had, in one statement over the whole keyspace; a key named twice keeps its last value.";
  let count = args^.inner.len;
  let pairs = count / 2_u64;
  atomic state = &store^.map {
    for @pairs (pair in 0_u64..pairs) {
      let doubled = pair *wrap 2_u64;
      let index = doubled +wrap 1_u64;
      let place = key_bounds(input: input, args: args, index: index);
      let key = &input^[place.start..place.end];
      let next = index +wrap 1_u64;
      let value_span = arg(args: args, index: next);
      let value = bytes_new(input: input, start: value_span.start, length: value_span.length);
      atomic slot = &state^[key] {
        put_text(slot: slot, value: move value, expires: 0_u64);
      }
    }
    if store^.logging {
      atomic meta = &store^.meta {
        log_command(log: &meta^.log, input: input, args: args);
      }
    }
  }
  reply_ok(client: client);
  return unit;
}

fn bump_value(env: &Counted, value: &Entry) -> result: u64 writes(env), writes(value) {
  doc "Adds one to a live stored decimal in place, keeping its expiry. State 1 is done, 3 marks another kind, 5 a string that is not a number, 6 a sum past the range of i64, and 2 an expired entry.";
  let reached = expired(expires: value^.expires, now: env^.now);
  if reached {
    set env^.state = state_expired;
    return 2_u64;
  }
  match value^.value {
    Text(bytes: stored) => {
      let number = bytes_integer(bytes: stored);
      if number.state != 1_u64 {
        set env^.state = 5_u64;
        return 5_u64;
      }
      if number.value == 9223372036854775807_i64 {
        set env^.state = 6_u64;
        return 6_u64;
      }
      let bumped = number.value +wrap 1_i64;
      let fresh = decimal_text(value: bumped);
      set stored^ = move fresh;
      set env^.value = bumped;
      set env^.state = state_done;
      return 1_u64;
    }
    Items(items: list) => {
      set env^.state = state_wrong;
      return 3_u64;
    }
    Members(members: set_of) => {
      set env^.state = state_wrong;
      return 3_u64;
    }
    Fields(fields: hash_of) => {
      set env^.state = state_wrong;
      return 3_u64;
    }
    Ranked(ranked: sorted) => {
      set env^.state = state_wrong;
      return 3_u64;
    }
  }
}

fn run_incr(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(time), writes(client) waits {
  doc "INCR key: adds one to the stored number, keeping its expiry, or stores 1 without one for an absent or expired key, in one atomic statement.";
  let place = key_bounds(input: input, args: args, index: 1_u64);
  let key = &input^[place.start..place.end];
  let counted = Counted(value: 0_i64, now: time^.check, state: state_absent);
  atomic slot = &store^.map[key] {
    let fresh_needed = True();
    match slot^ {
      Some(value: held) => {
        let outcome = bump_value(env: &counted, value: held);
        set fresh_needed = False();
      }
      None() => {
      }
    }
    if counted.state == state_expired {
      set fresh_needed = True();
    }
    if fresh_needed {
      let fresh = decimal_text(value: 1_i64);
      put_text(slot: slot, value: move fresh, expires: 0_u64);
      set counted.value = 1_i64;
      set counted.state = state_done;
    }
    if counted.state == state_done {
      if store^.logging {
        atomic meta = &store^.meta {
          log_command(log: &meta^.log, input: input, args: args);
        }
      }
    }
  }
  if counted.state == state_done {
    reply_integer(client: client, value: counted.value);
  } else if counted.state == state_wrong {
    reply_wrong_type(client: client);
  } else if counted.state == 6_u64 {
    reply_error(client: client, word: &text_overflow[0_u64..41_u64]);
  } else {
    reply_error(client: client, word: &text_not_integer[0_u64..43_u64]);
  }
  return unit;
}

fn run_config(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client) -> result: unit reads(store), reads(input), reads(args), writes(client) {
  doc "CONFIG GET parameter [parameter ...]: answers each of save, which firn never does and reports as empty, and appendonly, yes when firn keeps an append-only file, that a parameter names, spelled as the first parameter naming it spells it, and appendonly first, one of the two orders Redis answers in, since Redis orders them by a hash seeded anew at each start; other parameters match nothing, as a parameter Redis does not know does, and patterns are not matched. CONFIG SET with an option and a value is answered as Redis answers an option it does not know, the option echoed whole, with too few arguments or an unpaired option as Redis answers them, and any other subcommand as Redis answers an unknown one, its name echoed to 128 bytes.";
  let sub = arg(args: args, index: 1_u64);
  let getting = name_is(input: input, start: sub.start, length: sub.length, word: &word_get[0_u64..3_u64]);
  let setting = name_is(input: input, start: sub.start, length: sub.length, word: &word_set[0_u64..3_u64]);
  let count = args^.inner.len;
  if getting {
    if count < 3_u64 {
      reply_word(client: client, word: &text_config_get_arity[0_u64..57_u64]);
      return unit;
    }
    let saving = False();
    let appending = False();
    let save_name = Span(start: 0_u64, length: 0_u64);
    let append_name = Span(start: 0_u64, length: 0_u64);
    for @parameters (index in 2_u64..count) {
      let parameter = arg(args: args, index: index);
      let named_save = name_is(input: input, start: parameter.start, length: parameter.length, word: &word_save[0_u64..4_u64]);
      let named_append = name_is(input: input, start: parameter.start, length: parameter.length, word: &word_appendonly[0_u64..10_u64]);
      if named_save {
        if saving {
        } else {
          set saving = True();
          set save_name = parameter;
        }
      }
      if named_append {
        if appending {
        } else {
          set appending = True();
          set append_name = parameter;
        }
      }
    }
    let fields = 0_u64;
    if saving {
      set fields = fields +wrap 2_u64;
    }
    if appending {
      set fields = fields +wrap 2_u64;
    }
    reply_array(client: client, count: fields);
    if appending {
      let logging = store^.logging;
      reply_bulk_input(client: client, input: input, start: append_name.start, length: append_name.length);
      if logging {
        reply_word(client: client, word: &reply_config_append_yes[21_u64..30_u64]);
      } else {
        reply_word(client: client, word: &reply_config_append_no[21_u64..29_u64]);
      }
    }
    if saving {
      reply_bulk_input(client: client, input: input, start: save_name.start, length: save_name.length);
      reply_word(client: client, word: &reply_config_save[14_u64..20_u64]);
    }
    return unit;
  }
  if setting {
    if count < 4_u64 {
      reply_word(client: client, word: &text_config_set_arity[0_u64..57_u64]);
      return unit;
    }
    let unpaired = count % 2_u64;
    if unpaired == 1_u64 {
      reply_error(client: client, word: &text_syntax[0_u64..16_u64]);
      return unit;
    }
    let option = arg(args: args, index: 2_u64);
    reply_word(client: client, word: &text_config_set[0_u64..61_u64]);
    let echoed = reply_echoed(client: client, input: input, span: option, limit: option.length);
    reply_word(client: client, word: &text_quote_end[0_u64..3_u64]);
    return unit;
  }
  reply_word(client: client, word: &text_config[0_u64..25_u64]);
  let shown = imin(sub.length, 128_u64);
  let echoed = reply_echoed(client: client, input: input, span: sub, limit: shown);
  reply_word(client: client, word: &text_try_config[0_u64..21_u64]);
  return unit;
}
