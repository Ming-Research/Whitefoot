            let go = band(fits, open);
            if bnot(go) {
              refused(client: client, input: input, name: name, fits: fits);
            }
            if go {
              let reading = False();
              run_combine(store: store, input: input, args: args, client: client, env: env, time: time, operation: operation_diff, storing: reading);
            }
            return unit;
          }
        } else if code < code_touch {
          if code == code_debug {
            let fits = count >= 2_u64;
            let go = band(fits, open);
            if bnot(go) {
              refused(client: client, input: input, name: name, fits: fits);
            }
            if go {
