fn admitted(client: &Client, input: &[u8], name: Span, fits: Bool) -> go: Bool reads(input), writes(client) {
  doc "Whether a known command runs: one given the wrong number of arguments is answered as Redis answers it, and then one from a connection that must authenticate first is answered NOAUTH, Redis counting a command's arguments before it checks authentication.";
  if fits {
  } else {
    reply_arity(client: client, input: input, name: name);
    return False();
  }
  let stopped = denied(client: client);
  if stopped {
    return False();
  }
  return True();
}

fn execute(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(env), reads(time), writes(client) waits {
  doc "Answers one command, whose arguments are spans of the input, by appending its reply to the client's. A command that changes the keyspace does so in one atomic statement, which also appends the change to the append-only file's pending bytes when the keyspace keeps them. As in Redis, an unknown command or a known one given the wrong number of arguments is answered so whether or not the connection has authenticated, and every other command but AUTH, HELLO and QUIT from a connection that must authenticate first is answered NOAUTH.";
  let count = args^.inner.len;
  let name = arg(args: args, index: 0_u64);
  let code = name_code(input: input, start: name.start, length: name.length);
  if code == code_pexpireat {
    let spelled = name_is(input: input, start: name.start, length: name.length, word: &word_pexpireat[0_u64..9_u64]);
    if spelled {
    } else {
      set code = 0_u64;
    }
  }
  let relative = False();
  let calendar = True();
  let whole_seconds = True();
  let milliseconds = False();
  let head = True();
  let tail = False();
  let pairs = count % 2_u64;
  let odd = pairs == 1_u64;
  let even = pairs == 0_u64;
  let at_least_three = count >= 3_u64;
  let at_least_four = count >= 4_u64;
  let mset_shape = band(odd, at_least_three);
  let hset_shape = band(even, at_least_four);
  let one_or_two = count >= 2_u64;
  let at_most_three = count <= 3_u64;
  let pop_shape = band(one_or_two, at_most_three);
  if code == code_ping {
    let fits = count <= 2_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_ping(input: input, args: args, client: client);
    }
    return unit;
  }
  if code == code_echo {
    let fits = count == 2_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_echo(input: input, args: args, client: client);
    }
    return unit;
  }
  if code == code_get {
    let fits = count == 2_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_get(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_set {
    let fits = count >= 3_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_set(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_setnx {
    let fits = count == 3_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_setnx(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_setex {
    let fits = count == 4_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_setex(store: store, input: input, args: args, client: client, env: env, time: time, in_seconds: whole_seconds, invalid: &text_expire_setex[0_u64..42_u64]);
    }
    return unit;
  }
  if code == code_psetex {
    let fits = count == 4_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_setex(store: store, input: input, args: args, client: client, env: env, time: time, in_seconds: milliseconds, invalid: &text_expire_psetex[0_u64..43_u64]);
    }
    return unit;
  }
  if code == code_getset {
    let fits = count == 3_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_getset(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_getdel {
