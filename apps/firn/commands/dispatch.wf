      } else if code < code_lset {
        if code == code_hset {
          let fits = count >= 4_u64;
          let go = band(fits, open);
          if bnot(go) {
            refused(client: client, input: input, name: name, fits: fits);
          }
          if go {
            run_hset(store: store, input: input, args: args, client: client, env: env, time: time, counted: counting);
