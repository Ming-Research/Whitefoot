fn refused(client: &Client, input: &[u8], name: Span, fits: Bool) -> result: unit reads(input), writes(client) {
  doc "Answers a known command that does not run: one outside the arity Redis's command table admits as Redis answers it, and then one from a connection that must authenticate first NOAUTH. Restrictions within that arity, such as MSET's pair count and LPOP's optional count, are checked after authentication.";
  if fits {
    let stopped = denied(client: client);
  } else {
    reply_arity(client: client, input: input, name: name);
  }
  return unit;
}

fn execute(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(env), reads(time), writes(client) waits {
  doc "Answers one command through a balanced tree of packed command codes, whose arguments are spans of the input, by appending its reply to the client's. A command that changes the keyspace does so in one atomic statement, which also appends the change to the append-only file's pending bytes when the keyspace keeps them. As in Redis, an unknown command or a known one outside its command-table arity is answered so whether or not the connection has authenticated, and every other command but AUTH, HELLO and QUIT from a connection that must authenticate first is answered NOAUTH.";
  let count = args^.inner.len;
  let name = arg(args: args, index: 0_u64);
  let code = name_code(input: input, start: name.start, length: name.length);
  let open = bnot(client^.locked);
  let relative = False();
  let calendar = True();
  let whole_seconds = True();
  let milliseconds = False();
  let head = True();
  let tail = False();
  let counting = True();
  let plain = False();
  let yes = True();
  let no = False();
  if code < code_config {
    if code < code_mset {
      if code < code_zrem {
        if code < code_type {
          if code < code_set {
            if code < code_ttl {
              if code == code_del {
                let fits = count >= 2_u64;
                let go = band(fits, open);
                if bnot(go) {
                  refused(client: client, input: input, name: name, fits: fits);
                }
                if go {
                  run_del(store: store, input: input, args: args, client: client, env: env, time: time);
                }
                return unit;
              }
            } else if code < code_get {
              if code == code_ttl {
                let fits = count == 2_u64;
                let go = band(fits, open);
                if bnot(go) {
                  refused(client: client, input: input, name: name, fits: fits);
                }
                if go {
                  run_ttl(store: store, input: input, args: args, client: client, env: env, time: time, in_seconds: whole_seconds, absolute: relative);
                }
                return unit;
              }
            } else if code == code_get {
              let fits = count == 2_u64;
              let go = band(fits, open);
              if bnot(go) {
                refused(client: client, input: input, name: name, fits: fits);
              }
              if go {
                run_get(store: store, input: input, args: args, client: client, env: env, time: time);
              }
              return unit;
            }
          } else if code < code_zadd {
            if code < code_sadd {
              if code == code_set {
                let fits = count >= 3_u64;
                let go = band(fits, open);
                if bnot(go) {
                  refused(client: client, input: input, name: name, fits: fits);
                }
                if go {
                  run_set(store: store, input: input, args: args, client: client, env: env, time: time);
                }
                return unit;
              }
            } else if code == code_sadd {
              let fits = count >= 3_u64;
              let go = band(fits, open);
              if bnot(go) {
                refused(client: client, input: input, name: name, fits: fits);
              }
              if go {
                run_sadd(store: store, input: input, args: args, client: client, env: env, time: time);
              }
              return unit;
            }
          } else if code < code_time {
            if code == code_zadd {
              let fits = count >= 4_u64;
              let go = band(fits, open);
              if bnot(go) {
                refused(client: client, input: input, name: name, fits: fits);
              }
              if go {
                run_zadd(store: store, input: input, args: args, client: client, env: env, time: time, increment: no);
              }
              return unit;
            }
          } else if code == code_time {
            let fits = count == 1_u64;
            let go = band(fits, open);
            if bnot(go) {
              refused(client: client, input: input, name: name, fits: fits);
            }
            if go {
              run_time(client: client);
            }
            return unit;
          }
        } else if code < code_hdel {
          if code < code_ping {
            if code == code_type {
              let fits = count == 2_u64;
              let go = band(fits, open);
              if bnot(go) {
                refused(client: client, input: input, name: name, fits: fits);
              }
              if go {
                run_type(store: store, input: input, args: args, client: client, env: env, time: time);
              }
              return unit;
            }
          } else if code < code_auth {
            if code == code_ping {
              let any = True();
              let go = band(any, open);
              if bnot(go) {
                refused(client: client, input: input, name: name, fits: any);
              }
              if go {
                if count <= 2_u64 {
                  run_ping(input: input, args: args, client: client);
                } else {
                  reply_arity(client: client, input: input, name: name);
                }
              }
              return unit;
            }
          } else if code == code_auth {
            let fits = count >= 2_u64;
            if fits {
              run_auth(store: store, input: input, args: args, client: client);
            } else {
              reply_arity(client: client, input: input, name: name);
            }
            return unit;
          }
        } else if code < code_lrem {
          if code < code_pttl {
            if code == code_hdel {
              let fits = count >= 3_u64;
              let go = band(fits, open);
              if bnot(go) {
                refused(client: client, input: input, name: name, fits: fits);
              }
              if go {
                run_hdel(store: store, input: input, args: args, client: client, env: env, time: time);
              }
              return unit;
            }
          } else if code == code_pttl {
            let fits = count == 2_u64;
            let go = band(fits, open);
            if bnot(go) {
              refused(client: client, input: input, name: name, fits: fits);
            }
            if go {
              run_ttl(store: store, input: input, args: args, client: client, env: env, time: time, in_seconds: milliseconds, absolute: relative);
            }
            return unit;
          }
        } else if code < code_srem {
          if code == code_lrem {
            let fits = count == 4_u64;
            let go = band(fits, open);
            if bnot(go) {
              refused(client: client, input: input, name: name, fits: fits);
            }
            if go {
              run_lrem(store: store, input: input, args: args, client: client, env: env, time: time);
            }
            return unit;
          }
        } else if code == code_srem {
          let fits = count >= 3_u64;
          let go = band(fits, open);
          if bnot(go) {
            refused(client: client, input: input, name: name, fits: fits);
          }
          if go {
            run_srem(store: store, input: input, args: args, client: client, env: env, time: time);
          }
          return unit;
        }
      } else if code < code_spop {
        if code < code_info {
          if code < code_hlen {
            if code == code_zrem {
              let fits = count >= 3_u64;
              let go = band(fits, open);
              if bnot(go) {
                refused(client: client, input: input, name: name, fits: fits);
              }
              if go {
                run_zrem(store: store, input: input, args: args, client: client, env: env, time: time);
              }
              return unit;
            }
          } else if code < code_llen {
            if code == code_hlen {
              let fits = count == 2_u64;
              let go = band(fits, open);
              if bnot(go) {
                refused(client: client, input: input, name: name, fits: fits);
              }
              if go {
                run_hlen(store: store, input: input, args: args, client: client, env: env, time: time);
              }
              return unit;
            }
          } else if code == code_llen {
            let fits = count == 2_u64;
            let go = band(fits, open);
            if bnot(go) {
              refused(client: client, input: input, name: name, fits: fits);
            }
            if go {
              run_llen(store: store, input: input, args: args, client: client, env: env, time: time);
            }
            return unit;
          }
        } else if code < code_lpop {
          if code < code_echo {
            if code == code_info {
              let fits = count >= 1_u64;
              let go = band(fits, open);
              if bnot(go) {
                refused(client: client, input: input, name: name, fits: fits);
              }
              if go {
                run_info(store: store, input: input, args: args, client: client, time: time);
              }
              return unit;
            }
          } else if code == code_echo {
            let fits = count == 2_u64;
            let go = band(fits, open);
            if bnot(go) {
              refused(client: client, input: input, name: name, fits: fits);
            }
            if go {
              run_echo(input: input, args: args, client: client);
            }
            return unit;
          }
        } else if code < code_rpop {
          if code == code_lpop {
            let fits = count >= 2_u64;
            let go = band(fits, open);
            if bnot(go) {
              refused(client: client, input: input, name: name, fits: fits);
            }
            if go {
              if count > 3_u64 {
                reply_arity(client: client, input: input, name: name);
                return unit;
              }
              run_pop(store: store, input: input, args: args, client: client, env: env, time: time, front: head);
            }
            return unit;
          }
        } else if code == code_rpop {
          let fits = count >= 2_u64;
          let go = band(fits, open);
          if bnot(go) {
            refused(client: client, input: input, name: name, fits: fits);
          }
          if go {
            if count > 3_u64 {
              reply_arity(client: client, input: input, name: name);
              return unit;
            }
            run_pop(store: store, input: input, args: args, client: client, env: env, time: time, front: tail);
          }
          return unit;
        }
      } else if code < code_hget {
        if code < code_incr {
          if code < code_decr {
            if code == code_spop {
              let fits = count >= 2_u64;
              let go = band(fits, open);
              if bnot(go) {
                refused(client: client, input: input, name: name, fits: fits);
              }
              if go {
                run_spop(store: store, input: input, args: args, client: client, env: env, time: time);
              }
              return unit;
            }
          } else if code == code_decr {
            let fits = count == 2_u64;
            let go = band(fits, open);
            if bnot(go) {
              refused(client: client, input: input, name: name, fits: fits);
            }
            if go {
              run_incr(store: store, input: input, args: args, client: client, env: env, time: time, delta: -1_i64);
            }
            return unit;
          }
        } else if code < code_lpos {
          if code == code_incr {
            let fits = count == 2_u64;
            let go = band(fits, open);
            if bnot(go) {
              refused(client: client, input: input, name: name, fits: fits);
            }
            if go {
              run_incr(store: store, input: input, args: args, client: client, env: env, time: time, delta: 1_i64);
            }
            return unit;
          }
        } else if code == code_lpos {
          let fits = count >= 3_u64;
          let go = band(fits, open);
          if bnot(go) {
            refused(client: client, input: input, name: name, fits: fits);
          }
          if go {
            run_lpos(store: store, input: input, args: args, client: client, env: env, time: time);
          }
          return unit;
        }
      } else if code < code_hset {
        if code < code_mget {
          if code == code_hget {
            let fits = count == 3_u64;
            let go = band(fits, open);
            if bnot(go) {
              refused(client: client, input: input, name: name, fits: fits);
            }
            if go {
              run_hget(store: store, input: input, args: args, client: client, env: env, time: time);
            }
