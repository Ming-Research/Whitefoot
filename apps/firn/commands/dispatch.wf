        }
      } else if code == code_lset {
        let fits = count == 4_u64;
        let go = band(fits, open);
        if bnot(go) {
          refused(client: client, input: input, name: name, fits: fits);
        }
        if go {
          run_lset(store: store, input: input, args: args, client: client, env: env, time: time);
        }
        return unit;
      }
    } else if code < code_hello {
      if code < code_sdiff {
        if code < code_scard {
          if code < code_quit {
            if code == code_mset {
              let fits = count >= 3_u64;
              let go = band(fits, open);
              if bnot(go) {
                refused(client: client, input: input, name: name, fits: fits);
              }
              if go {
                let parity = count % 2_u64;
                if parity == 0_u64 {
                  reply_arity(client: client, input: input, name: name);
                  return unit;
                }
                run_mset(store: store, input: input, args: args, client: client, env: env, time: time);
              }
              return unit;
            }
          } else if code < code_copy {
            if code == code_quit {
              run_quit(client: client);
              return unit;
            }
          } else if code == code_copy {
            let fits = count >= 3_u64;
            let go = band(fits, open);
            if bnot(go) {
              refused(client: client, input: input, name: name, fits: fits);
            }
            if go {
              run_copy(store: store, input: input, args: args, client: client, env: env, time: time);
            }
            return unit;
