fn refused(client: &Client, input: &[u8], name: Span, fits: Bool) -> result: unit reads(input), writes(client) {
  doc "Answers a known command that does not run: one outside the arity Redis's command table admits as Redis answers it, and then one from a connection that must authenticate first NOAUTH. Restrictions within that arity, such as MSET's pair count and LPOP's optional count, are checked after authentication.";
  if fits {
    let stopped = denied(client: client);
  } else {
    reply_arity(client: client, input: input, name: name);
  }
  return unit;
}

fn execute(store: &Keyspace, input: &[u8], args: &Box<Slots<Span>>, client: &Client, env: &KeyEnv, time: &Time) -> result: unit reads(store), reads(input), reads(args), reads(env), reads(time), writes(client) waits {
  doc "Answers one command, whose arguments are spans of the input, by appending its reply to the client's. A command that changes the keyspace does so in one atomic statement, which also appends the change to the append-only file's pending bytes when the keyspace keeps them. As in Redis, an unknown command or a known one outside its command-table arity is answered so whether or not the connection has authenticated, and every other command but AUTH, HELLO and QUIT from a connection that must authenticate first is answered NOAUTH.";
  let count = args^.inner.len;
  let name = arg(args: args, index: 0_u64);
  let code = name_code(input: input, start: name.start, length: name.length);
  let open = bnot(client^.locked);
  let relative = False();
  let calendar = True();
  let whole_seconds = True();
  let milliseconds = False();
  let head = True();
  let tail = False();
  if code == code_ping {
    let any = True();
    let go = band(any, open);
    if bnot(go) {
      refused(client: client, input: input, name: name, fits: any);
    }
    if go {
      if count <= 2_u64 {
        run_ping(input: input, args: args, client: client);
      } else {
        reply_arity(client: client, input: input, name: name);
      }
    }
    return unit;
  }
  if code == code_echo {
    let fits = count == 2_u64;
    let go = band(fits, open);
    if bnot(go) {
      refused(client: client, input: input, name: name, fits: fits);
    }
    if go {
      run_echo(input: input, args: args, client: client);
    }
    return unit;
  }
  if code == code_get {
    let fits = arity_holds(arity: arity_get, count: count);
    let go = band(fits, open);
    if bnot(go) {
      refused(client: client, input: input, name: name, fits: fits);
    }
    if go {
      run_get(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_set {
    let fits = arity_holds(arity: arity_set, count: count);
    let go = band(fits, open);
    if bnot(go) {
      refused(client: client, input: input, name: name, fits: fits);
    }
    if go {
      run_set(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_setnx {
    let fits = count == 3_u64;
    let go = band(fits, open);
    if bnot(go) {
      refused(client: client, input: input, name: name, fits: fits);
    }
    if go {
      run_setnx(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_setex {
    let fits = count == 4_u64;
    let go = band(fits, open);
    if bnot(go) {
      refused(client: client, input: input, name: name, fits: fits);
    }
    if go {
      run_setex(store: store, input: input, args: args, client: client, env: env, time: time, in_seconds: whole_seconds, invalid: &text_expire_setex[0_u64..42_u64]);
    }
    return unit;
  }
  if code == code_psetex {
    let fits = count == 4_u64;
    let go = band(fits, open);
    if bnot(go) {
