          }
        } else if code == code_mget {
          let fits = count >= 2_u64;
          let go = band(fits, open);
          if bnot(go) {
            refused(client: client, input: input, name: name, fits: fits);
          }
          if go {
            run_mget(store: store, input: input, args: args, client: client, env: env, time: time);
          }
