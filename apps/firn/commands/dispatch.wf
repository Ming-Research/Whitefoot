    }
    if go {
      let fresh = False();
      run_rename(store: store, input: input, args: args, client: client, env: env, time: time, fresh: fresh);
    }
    return unit;
  }
  if code == code_renamenx {
    let fits = count == 3_u64;
    let go = band(fits, open);
    if bnot(go) {
      refused(client: client, input: input, name: name, fits: fits);
    }
    if go {
      let fresh = True();
      run_rename(store: store, input: input, args: args, client: client, env: env, time: time, fresh: fresh);
    }
    return unit;
  }
  if code == code_copy {
    let fits = count >= 3_u64;
    let go = band(fits, open);
    if bnot(go) {
      refused(client: client, input: input, name: name, fits: fits);
    }
    if go {
      run_copy(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_type {
    let fits = count == 2_u64;
    let go = band(fits, open);
    if bnot(go) {
      refused(client: client, input: input, name: name, fits: fits);
    }
    if go {
      run_type(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_incr {
    let fits = arity_holds(arity: arity_incr, count: count);
    let go = band(fits, open);
    if bnot(go) {
      refused(client: client, input: input, name: name, fits: fits);
    }
    if go {
      run_incr(store: store, input: input, args: args, client: client, env: env, time: time, delta: 1_i64);
    }
    return unit;
  }
  if code == code_decr {
    let fits = count == 2_u64;
    let go = band(fits, open);
    if bnot(go) {
      refused(client: client, input: input, name: name, fits: fits);
    }
    if go {
      run_incr(store: store, input: input, args: args, client: client, env: env, time: time, delta: -1_i64);
    }
    return unit;
  }
  if code == code_incrby {
    let fits = count == 3_u64;
    let go = band(fits, open);
    if bnot(go) {
      refused(client: client, input: input, name: name, fits: fits);
    }
    if go {
      let negate = False();
      run_incrby(store: store, input: input, args: args, client: client, env: env, time: time, negate: negate);
    }
    return unit;
  }
  if code == code_decrby {
    let fits = count == 3_u64;
    let go = band(fits, open);
    if bnot(go) {
      refused(client: client, input: input, name: name, fits: fits);
    }
    if go {
      let negate = True();
      run_incrby(store: store, input: input, args: args, client: client, env: env, time: time, negate: negate);
    }
    return unit;
  }
  if code == code_incrbyfloat {
    let spelled = name_is(input: input, start: name.start, length: name.length, word: &word_incrbyfloat[0_u64..11_u64]);
    if spelled {
      let fits = count == 3_u64;
      let go = band(fits, open);
      if bnot(go) {
        refused(client: client, input: input, name: name, fits: fits);
      }
      if go {
        run_incrbyfloat(store: store, input: input, args: args, client: client, env: env, time: time);
      }
      return unit;
    }
