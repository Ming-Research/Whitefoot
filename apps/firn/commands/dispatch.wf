  if code == code_exists {
    let fits = count >= 2_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_exists(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_type {
    let fits = count == 2_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_type(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_incr {
    let fits = count == 2_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_incr(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_mset {
    let fits = mset_shape;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_mset(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_expire {
    let fits = count == 3_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_expire(store: store, input: input, args: args, client: client, env: env, time: time, scale: 1000_u64, absolute: relative, invalid: &text_expire_expire[0_u64..43_u64]);
    }
    return unit;
  }
  if code == code_pexpire {
    let fits = count == 3_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_expire(store: store, input: input, args: args, client: client, env: env, time: time, scale: 1_u64, absolute: relative, invalid: &text_expire_pexpire[0_u64..44_u64]);
    }
    return unit;
  }
  if code == code_pexpireat {
    let fits = count == 3_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_expire(store: store, input: input, args: args, client: client, env: env, time: time, scale: 1_u64, absolute: calendar, invalid: &text_expire_pexpireat[0_u64..46_u64]);
    }
    return unit;
  }
  if code == code_ttl {
    let fits = count == 2_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_ttl(store: store, input: input, args: args, client: client, env: env, time: time, in_seconds: whole_seconds);
    }
    return unit;
  }
  if code == code_pttl {
    let fits = count == 2_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_ttl(store: store, input: input, args: args, client: client, env: env, time: time, in_seconds: milliseconds);
    }
    return unit;
  }
  if code == code_persist {
    let fits = count == 2_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_persist(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_dbsize {
    let fits = count == 1_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_dbsize(store: store, client: client);
    }
    return unit;
  }
  if code == code_config {
    let fits = count >= 2_u64;
    if fits {
      run_config(store: store, input: input, args: args, client: client);
    } else {
      reply_arity(client: client, input: input, name: name);
    }
    return unit;
  }
  if code == code_lpush {
    let fits = count >= 3_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      let creating = False();
      run_push(store: store, input: input, args: args, client: client, env: env, time: time, front: head, existing: creating);
    }
    return unit;
  }
  if code == code_rpush {
    let fits = count >= 3_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      let creating = False();
      run_push(store: store, input: input, args: args, client: client, env: env, time: time, front: tail, existing: creating);
    }
    return unit;
  }
  if code == code_lpop {
    let fits = pop_shape;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_pop(store: store, input: input, args: args, client: client, env: env, time: time, front: head);
    }
    return unit;
  }
  if code == code_rpop {
    let fits = pop_shape;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_pop(store: store, input: input, args: args, client: client, env: env, time: time, front: tail);
    }
    return unit;
  }
  if code == code_lrange {
    let fits = count == 4_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_lrange(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_llen {
    let fits = count == 2_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_llen(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_lindex {
    let fits = count == 3_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_lindex(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_lset {
    let fits = count == 4_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_lset(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_lrem {
    let fits = count == 4_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_lrem(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_ltrim {
    let fits = count == 4_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_ltrim(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_linsert {
    let fits = count == 5_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_linsert(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_lpos {
    let fits = count >= 3_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_lpos(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_lpushx {
    let fits = count >= 3_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      let existing = True();
      run_push(store: store, input: input, args: args, client: client, env: env, time: time, front: head, existing: existing);
    }
    return unit;
  }
  if code == code_rpushx {
    let fits = count >= 3_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      let existing = True();
      run_push(store: store, input: input, args: args, client: client, env: env, time: time, front: tail, existing: existing);
    }
    return unit;
  }
  if code == code_lmove {
    let fits = count == 5_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_lmove_named(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_rpoplpush {
    let spelled = name_is(input: input, start: name.start, length: name.length, word: &word_rpoplpush[0_u64..9_u64]);
    if spelled {
      let fits = count == 3_u64;
      let go = admitted(client: client, input: input, name: name, fits: fits);
      if go {
        run_lmove(store: store, input: input, args: args, client: client, env: env, time: time, from_head: tail, to_head: head);
      }
      return unit;
    }
  }
  if code == code_sadd {
    let fits = count >= 3_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
      run_sadd(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  if code == code_srem {
    let fits = count >= 3_u64;
    let go = admitted(client: client, input: input, name: name, fits: fits);
    if go {
