    }
    if go {
      run_strlen(store: store, input: input, args: args, client: client, env: env, time: time);
    }
    return unit;
  }
  let ranged = code == code_getrange;
  let substring = code == code_substr;
  let read_range = bor(ranged, substring);
  if read_range {
    let fits = count == 4_u64;
    let go = band(fits, open);
    if bnot(go) {
      refused(client: client, input: input, name: name, fits: fits);
    }
    if go {
      run_getrange(store: store, input: input, args: args, client: client, env: env, time: time);
