            return unit;
          }
        } else if code == code_touch {
          let fits = count >= 2_u64;
          let go = band(fits, open);
          if bnot(go) {
            refused(client: client, input: input, name: name, fits: fits);
          }
          if go {
            run_exists(store: store, input: input, args: args, client: client, env: env, time: time);
          }
          return unit;
        }
      } else if code < code_zrank {
        if code < code_rpush {
          if code == code_lpush {
            let fits = count >= 3_u64;
            let go = band(fits, open);
            if bnot(go) {
              refused(client: client, input: input, name: name, fits: fits);
            }
            if go {
              let creating = False();
              run_push(store: store, input: input, args: args, client: client, env: env, time: time, front: head, existing: creating);
            }
