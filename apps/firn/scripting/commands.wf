fn command(env: &Env, vm: &Vm, stack: &Box<Slots<Value>>, func: u64, argc: u64) -> r: Value reads(stack), writes(env), writes(vm) {
  set env^.error = False();
  if argc == 0_u64 {
    return fail(env: env, vm: vm, text: &commands_text_0[0_u64..64_u64]);
  }
  let converted = box_slots_new::<pkg::bytes::Bytes>(capacity: argc);
  let name = box_slots_new::<u8>(capacity: 0_u64);
  for (i in 0_u64..argc) {
    let v = arg(stack: stack, func: func, argc: argc, index: i);
    let k = kind(v: v);
    if k != 2_u8 {
      if k != 3_u8 {
        return fail(env: env, vm: vm, text: &s_2[0_u64..63_u64]);
      }
    }
    let text = command_argument(vm: vm, v: v);
    let bytes = box_slots_new::<u8>(capacity: 0_u64);
    value_bytes(vm: vm, v: text, out: &bytes);
    if i == 0_u64 {
      let n = bytes.inner.len;
      text_bytes(out: &name, bytes: &bytes.inner[0_u64..n]);
    }
    let n = bytes.inner.len;
    let item = pkg::bytes::bytes_new(input: &bytes.inner[0_u64..n], start: 0_u64, length: n);
    if converted.inner.len < converted.inner.cap {
      place_back(window: &converted.inner, value: move item);
    } else {
      let exhausted = move item;
    }
  }
  let n = name.inner.len;
  let start = env^.reply.inner.len;
  let handled = script_command(name: &name.inner[0_u64..n], held: &env^.held, args: &converted, reply: &env^.reply);
  if bnot(handled) {
    return fail(env: env, vm: vm, text: &commands_text_1[0_u64..44_u64]);
  }
  let end = env^.reply.inner.len;
  let value = command_reply(vm: vm, bytes: &env^.reply.inner[0_u64..end], start: start, end: end, resp: env^.resp);
  loop {
    if env^.reply.inner.len <= start {
      break;
    }
    let dropped = take_back(window: &env^.reply.inner);
  }
  if bnot(env^.held.command_ran) {
    let marker = literal(vm: vm, text: &error_stats_field[0_u64..25_u64]);
    let nil = Value::Nil();
    raw(vm: vm, table: value, key: marker, value: nil);
  }
  let error = field(vm: vm, table: value, name: &s_30[0_u64..3_u64]);
  set env^.error = is_string(v: error);
  return value;
}

fn command_argument(vm: &Vm, v: Value) -> text: Value writes(vm) {
  doc "Redis luaArgsToRedisArgv formats numeric command arguments with %.17g, separately from Lua tostring's %.14g. Reuse firn's Redis score formatter and decode its bulk reply.";
  let tag = kind(v: v);
  if tag == 2_u8 {
    let x = number(vm: vm, v: v);
    let client = pkg::protocol::client_new(capacity: 64_u64);
    pkg::scores::reply_score(client: &client, score: x);
    let n = client.at;
    if n <= client.bytes.inner.len {
      return command_reply(vm: vm, bytes: &client.bytes.inner[0_u64..n], start: 0_u64, end: n, resp: 2_u8);
    }
  }
  return v;
}

fn command_arity(arity: i64, count: u64) -> fits: Bool pure {
  if arity >= 0_i64 {
    let exact = cvt.wrap::<i64, u64>(arity);
    return count == exact;
  }
  let signed = cvt.wrap::<i64, u64>(arity);
  let minimum = 0_u64 -wrap signed;
  return count >= minimum;
}

fn script_command(name: &[u8], held: &HeldState, args: &Box<Slots<pkg::bytes::Bytes>>, reply: &Box<Slots<u8>>) -> handled: Bool reads(name), reads(args), writes(held.command_ran), writes(reply) {
  doc "Interim adapter for firn's future script_command(name/code, held state, args, reply) -> handled plus shared arity check. All command lookup, arity, noscript and temporary refusals are confined here; replace this function with the shared registry call, not a second command table. held carries frozen time and write status in this slice; real keys/meta references must be supplied by the callback interface when command bodies arrive. Append RESP bytes; the caller captures and rewinds the appended range (later in the connection reply buffer). Set held.command_ran only after a real body has run and accounted its command error; refusals leave it false. No nested atomic or AOF write.";
  set held^.command_ran = False();
  let argc = args^.inner.len;
  let n = name^.len;
  let sub = box_slots_new::<u8>(capacity: 0_u64);
  if argc > 1_u64 {
    if 1_u64 < args^.inner.len {
      let copied = pkg::bytes::bytes_copy(bytes: &args^.inner[1_u64]);
      let boxed = pkg::bytes::bytes_boxed(bytes: move copied);
      let size = boxed.inner.len;
      for (i in 0_u64..size) {
        let b = boxed.inner[i];
        push(out: &sub, byte: b);
      }
    }
  }
  let sn = sub.inner.len;
  let found = False();
  let selected = 0_u64;
  for (i in 0_u64..commands.len) {
    let row = commands[i];
    let separator = row.length;
    for (j in 0_u64..row.length) {
      if j < 32_u64 {
        if row.name[j] == 124_u8 {
          set separator = j;
          break;
        }
      }
    }
    if separator <= row.name.len {
      if separator == n {
        let first = pkg::bytes::name_is(input: name, start: 0_u64, length: n, word: &row.name[0_u64..separator]);
        let second = True();
        if separator < row.length {
          let start = separator + 1_u64;
          if row.length <= 32_u64 {
            set second = pkg::bytes::name_is(input: &sub.inner[0_u64..sn], start: 0_u64, length: sn, word: &row.name[start..row.length]);
          }
        }
        let has_sub = argc > 1_u64;
        let container = row.container == 1_u8;
        if band(container, has_sub) {
          set second = False();
        }
        if band(first, second) {
          set found = True();
          set selected = i;
        }
      }
    }
  }
  if bnot(found) {
    return False();
  }
  if selected < commands.len {
    let row = commands[selected];
    let fits = command_arity(arity: row.arity, count: argc);
    if bnot(fits) {
      text_bytes(out: reply, bytes: &command_arity_reply[0_u64..61_u64]);
      return True();
    }
    if row.noscript == 1_u8 {
      text_bytes(out: reply, bytes: &command_noscript_reply[0_u64..52_u64]);
      return True();
    }
    text_bytes(out: reply, bytes: &commands_text_3[0_u64..62_u64]);
    return True();
  }
  return False();
}

const command_arity_reply: Array<u8, 61> = "-ERR Wrong number of args calling Redis command from script\r\n";

const command_noscript_reply: Array<u8, 52> = "-ERR This Redis command is not allowed from script\r\n";

const commands_text_0: Array<u8, 64> = "ERR Please specify at least one argument for this redis lib call";

const commands_text_1: Array<u8, 44> = "ERR Unknown Redis command called from script";

const commands_text_3: Array<u8, 62> = "-ERR This Redis command is not yet supported in firn scripts\r\n";
