alias Bytes = pkg::bytes::Bytes;
alias Key = pkg::bytes::Key;
alias KeyEnv = pkg::bytes::KeyEnv;
alias Span = pkg::protocol::Span;
alias KeyHash = pkg::bytes::KeyHash;
alias byte_at = pkg::bytes::byte_at;
alias bytes_order = pkg::bytes::bytes_order;
alias bytes_new = pkg::bytes::bytes_new;
alias priority_queue_len = std::collections::priority_queue::priority_queue_len;
alias priority_queue_new = std::collections::priority_queue::priority_queue_new;
alias priority_queue_peek = std::collections::priority_queue::priority_queue_peek;
alias priority_queue_pop = std::collections::priority_queue::priority_queue_pop;
alias priority_queue_push = std::collections::priority_queue::priority_queue_push;

const word_del: Array<u8, 3> =[68_u8, 69_u8, 76_u8];

struct Probe {
  at: u64;
}

fn rank_compare(env: &KeyEnv, left: &Rank, right: &Rank) -> order: i32 reads(left), reads(right) {
  doc "Orders ranks by score, then by member bytes, as Redis orders a sorted set.";
  let before = flt(left^.score, right^.score);
  if before {
    return -1_i32;
  }
  let after = fgt(left^.score, right^.score);
  if after {
    return 1_i32;
  }
  let order = bytes_order(left: &left^.member.bytes, right: &right^.member.bytes);
  return order;
}

fn due_order(env: &KeyEnv, left: &Due, right: &Due) -> order: i32 reads(left), reads(right) {
  doc "Orders queued expiries by their instant, the earliest first.";
  if left^.at < right^.at {
    return -1_i32;
  }
  if left^.at > right^.at {
    return 1_i32;
  }
  return 0_i32;
}

fn keyspace_table() -> made: KeyedTable<Entry> pure {
  doc "An empty table of entries sized for 2^18 keys, which spares a benchmark's 2^17 keys the table's moves into memory the host has not yet given the process.";
  let made = keyed_table_new::<Entry>(capacity: 262144_u64);
  return move made;
}

const encoding_defaults: Array<i64, 9> =[512_i64, 64_i64, 0_i64, -2_i64, 512_i64, 4096_i64, 100_i64, 128_i64, 64_i64];

fn keyspace_new(seed: u64, logging: Bool, password: Bytes, timeout: u64, started: u64) -> made: Keyspace pure {
  doc "An empty keyspace, its table made by keyspace_table, appending changes to the append-only file's pending bytes when logging is true, whose SPOP draws start from the seed, beside a server's state that requires the password, none when it is empty, keeps a silent client timeout seconds, none when it is zero, and holds Redis 7.0.15's defaults for the encoding parameters: hash-max-listpack-entries 512, hash-max-listpack-value 64, list-compress-depth 0, list-max-listpack-size -2, set-max-intset-entries 512, stream-node-max-bytes 4096, stream-node-max-entries 100, zset-max-listpack-entries 128 and zset-max-listpack-value 64, in that order, the order of their names; and records started, the calendar time in milliseconds at which the server started.";
  let map = keyspace_table();
  let due = priority_queue_new::<Due, ceiling>();
  let log = box_slots_new::<u8>(capacity: 65536_u64);
  let running = False();
  let meta = Meta(due: move due, log: move log, clients: 0_u64, stopping: running, random: seed);
  let state = KeyspaceState(map: move map, meta: move meta);
  let shared = shared_new::<KeyspaceState>(value: move state);
  let encodings = array_filled::<i64, 9>(value: 0_i64);
  for @defaults (slot in 0_u64..9_u64) {
    set encodings[slot] = encoding_defaults[slot];
  }
  let server = ServerState(password: move password, timeout: timeout, encodings: encodings, connections: 0_u64, started: started);
  let beside = shared_new::<ServerState>(value: move server);
  return Keyspace(state: move shared, server: move beside, logging: logging);
}

fn keyspace_share(store: &Keyspace) -> made: Keyspace reads(store) {
  doc "Another context's handle to the same keyspace.";
  let made = keyspace_logging(store: store, logging: store^.logging);
  return move made;
}

fn keyspace_logging(store: &Keyspace, logging: Bool) -> made: Keyspace reads(store) {
  doc "A handle to the same keyspace and server's state that appends changes to the append-only file's pending bytes when logging is true.";
  let shared = shared_share::<KeyspaceState>(shared: &store^.state);
  let beside = shared_share::<ServerState>(shared: &store^.server);
  return Keyspace(state: move shared, server: move beside, logging: logging);
}

fn expired(expires: u64, now: u64) -> reached: Bool pure {
  doc "Whether an expiry, zero for none, has been reached at now.";
  if expires == 0_u64 {
    return False();
  }
  let reached = expires <= now;
  return reached;
}

fn due_at(env: &Probe, value: &Due) -> result: u64 reads(value), writes(env) {
  doc "Reads a queued expiry's instant.";
  set env^.at = value^.at;
  return value^.at;
}

fn take_due(meta: &Meta, now: u64, env: &KeyEnv, batch: &Box<Slots<Due>>) -> more: Bool reads(env), writes(meta), writes(batch) {
  doc "Moves up to 256 queued expiries that have been reached, the earliest first, into the batch, and returns whether more may be due.";
  for @batch (step in 0_u64..256_u64) {
    let pending = priority_queue_len::<Due, ceiling>(queue: &meta^.due);
    if pending == 0_u64 {
      return False();
    }
    let probe = Probe(at: 0_u64);
    let first = priority_queue_peek::<Due, Probe, u64, fn due_at, ceiling>(queue: &meta^.due, env: &probe);
    if first > now {
      return False();
    }
    let due = priority_queue_pop::<DueOrder, ceiling>(queue: &meta^.due, env: env);
    if batch^.inner.len < batch^.inner.cap {
      place_back(window: &batch^.inner, value: move due);
    } else {
      let dropped = move due;
      return True();
    }
  }
  return True();
}

fn log_removal(log: &Box<Slots<u8>>, key: &[u8]) -> result: unit reads(key), writes(log) {
  doc "Appends DEL key, as Redis 7.0.15 propagates the removal of a key whose expiry has passed, so that a replay, which counts no key as expired, removes the key where the server did and a later command finds it absent there too.";
  let length = key^.len;
  let room = length +wrap 32_u64;
  log_count(log: log, count: 2_u64, room: room);
  log_word(log: log, word: &word_del[0_u64..3_u64]);
  let span = Span(start: 0_u64, length: length);
  log_input(log: log, input: key, span: span);
  return unit;
}

fn expire_key(store: &Keyspace, key: &[u8], at: u64) -> result: unit reads(store), reads(key) waits {
  doc "Removes the key when its expiry is still the one queued at at, recording the removal as log_removal does.";
  let logged = store^.logging;
  atomic s = &store^.state, slot = &s^.map[key] {
    let matched = False();
    match slot^ {
      Some(value: held) => {
        if held^.expires == at {
          set matched = True();
        }
      }
      None() => {
      }
    }
    if matched {
      set slot^ = None<Entry>();
      if logged {
        log_removal(log: &s^.meta.log, key: key);
      }
    }
  }
  return unit;
}

fn remove_expired(store: &Keyspace, key: &[u8], now: u64) -> result: unit reads(store), reads(key) waits {
  doc "Removes the key when its expiry has been reached at now, for a command that found it expired in a statement that only read it, recording the removal as log_removal does; a key set again since keeps its value.";
  let logged = store^.logging;
  atomic s = &store^.state, slot = &s^.map[key] {
    let lapsed = False();
    match slot^ {
      Some(value: held) => {
        set lapsed = expired(expires: held^.expires, now: now);
      }
      None() => {
      }
    }
    if lapsed {
      set slot^ = None<Entry>();
      if logged {
        log_removal(log: &s^.meta.log, key: key);
      }
    }
  }
  return unit;
}

fn expire_batch(store: &Keyspace, now: u64, env: &KeyEnv, batch: &Box<Slots<Due>>) -> more: Bool reads(store), reads(env), writes(batch) waits {
  doc "Takes up to 256 queued expiries that have been reached, the earliest first, in one atomic statement, then removes each key whose expiry is still the one queued in a statement on that key, recording the removal as log_removal does, and returns whether more may be due. A queued expiry that no longer matches its key's, because the key was set, given another expiry or removed since, is dropped.";
  let more = False();
  atomic s = &store^.state {
    set more = take_due(meta: &s^.meta, now: now, env: env, batch: batch);
  }
  loop @keys {
    if batch^.inner.len == 0_u64 {
      break @keys;
    }
    let due = take_back(window: &batch^.inner);
    let at = due.at;
    match move due.key {
      Short(bytes: short) => {
        let length = short.len;
        expire_key(store: store, key: &short[0_u64..length], at: at);
      }
      Long(bytes: long) => {
        let length = long.inner.len;
        expire_key(store: store, key: &long.inner[0_u64..length], at: at);
      }
    }
  }
  return more;
}

fn queue_expiry(meta: &Meta, key: &[u8], at: u64, env: &KeyEnv) -> result: unit reads(key), reads(env), writes(meta) {
  doc "Queues a key's new expiry for active removal; one past the queue's ceiling is left to lazy removal.";
  let length = key^.len;
  let copied = bytes_new(input: key, start: 0_u64, length: length);
  let due = Due(key: move copied, at: at);
  let queued = priority_queue_push::<DueOrder, ceiling>(queue: &meta^.due, value: move due, env: env);
  return unit;
}

fn log_reserve(log: &Box<Slots<u8>>, needed: u64) -> result: unit writes(log) {
  doc "Grows the append-only file's buffer, at least doubling it, until it has room for needed more bytes. No host allocates the 2^62 bytes the growth stops at; a host that cannot allocate less stops the program [SCOPE-3], as Redis stops when its buffer exhausts memory.";
  let length = log^.inner.len;
  let capacity = log^.inner.cap;
  let wanted = length +wrap needed;
  if wanted > capacity {
    let doubled = capacity +wrap capacity;
    let target = imax(doubled, wanted);
    let fits = target <= 4611686018427387904_u64;
    if fits {
      if target >= log^.inner.cap {
        grow(cell: log, capacity: target);
      }
    }
  }
  return unit;
}

fn log_byte(log: &Box<Slots<u8>>, value: u8) -> result: unit writes(log) {
  doc "Appends one byte to the buffer, which log_reserve gave room.";
  if log^.inner.len < log^.inner.cap {
    place_back(window: &log^.inner, value: value);
  }
  return unit;
}

fn log_number(log: &Box<Slots<u8>>, value: u64) -> result: unit writes(log) {
  doc "Appends a number in decimal.";
  let digits = array_filled::<u8, 20>(value: 0_u8);
  let count = 0_u64;
  let rest = value;
  loop @digits {
    let low = rest % 10_u64;
    let narrow = cvt.wrap::<u64, u8>(low);
    let glyph = narrow +wrap 48_u8;
    if count < 20_u64 {
      set digits[count] = glyph;
      set count = count +wrap 1_u64;
    }
    set rest = rest / 10_u64;
    if rest == 0_u64 {
      break @digits;
    }
  }
  for @emit (index in 0_u64..count) {
    let back = count -wrap index;
    let from = back -wrap 1_u64;
    let glyph = 48_u8;
    if from < 20_u64 {
      set glyph = digits[from];
    }
    log_byte(log: log, value: glyph);
  }
  return unit;
}

fn log_crlf(log: &Box<Slots<u8>>) -> result: unit writes(log) {
  doc "Appends CR LF.";
  log_byte(log: log, value: 13_u8);
  log_byte(log: log, value: 10_u8);
  return unit;
}

fn log_length(log: &Box<Slots<u8>>, length: u64) -> result: unit writes(log) {
  doc "Makes room for a bulk string of length bytes and appends its header.";
  let needed = length +wrap 32_u64;
  log_reserve(log: log, needed: needed);
  log_byte(log: log, value: 36_u8);
  log_number(log: log, value: length);
  log_crlf(log: log);
  return unit;
}

fn log_count(log: &Box<Slots<u8>>, count: u64, room: u64) -> result: unit writes(log) {
  doc "Makes room for a command of about room bytes and appends the header of a RESP array of count elements.";
  let needed = room +wrap 32_u64;
  log_reserve(log: log, needed: needed);
  log_byte(log: log, value: 42_u8);
  log_number(log: log, value: count);
  log_crlf(log: log);
  return unit;
}

fn log_word(log: &Box<Slots<u8>>, word: &[u8]) -> result: unit reads(word), writes(log) {
  doc "Appends a constant word as a RESP bulk string.";
  let count = word^.len;
  log_length(log: log, length: count);
  for @word (offset in 0_u64..count) {
    let byte = word^[offset];
    log_byte(log: log, value: byte);
  }
  log_crlf(log: log);
  return unit;
}

fn log_input(log: &Box<Slots<u8>>, input: &[u8], span: Span) -> result: unit reads(input), writes(log) {
  doc "Appends an argument of the input as a RESP bulk string.";
  let length = span.length;
  log_length(log: log, length: length);
  for @copy (offset in 0_u64..length) {
    let position = span.start +wrap offset;
    let byte = byte_at(input: input, index: position);
    log_byte(log: log, value: byte);
  }
  log_crlf(log: log);
  return unit;
}

fn log_text(log: &Box<Slots<u8>>, text: &Bytes) -> result: unit reads(text), writes(log) {
  doc "Appends a stored string as a RESP bulk string.";
  match text^ {
    Short(bytes: short) => {
      let length = short^.len;
      let window = &short^[0_u64..length];
      let span = Span(start: 0_u64, length: length);
      log_input(log: log, input: window, span: span);
    }
    Long(bytes: long) => {
      let length = long^.inner.len;
      let window = &long^.inner[0_u64..length];
      let span = Span(start: 0_u64, length: length);
      log_input(log: log, input: window, span: span);
    }
  }
  return unit;
}

fn log_decimal(log: &Box<Slots<u8>>, value: u64) -> result: unit writes(log) {
  doc "Appends a number as a RESP bulk string of its decimal digits.";
  let digits = 1_u64;
  let rest = value / 10_u64;
  loop @count {
    if rest == 0_u64 {
      break @count;
    }
    set digits = digits +wrap 1_u64;
    set rest = rest / 10_u64;
  }
  log_length(log: log, length: digits);
  log_number(log: log, value: value);
  log_crlf(log: log);
  return unit;
}

fn log_command(log: &Box<Slots<u8>>, input: &[u8], args: &Box<Slots<Span>>) -> result: unit reads(input), reads(args), writes(log) {
  doc "Appends a command as the client sent it, every argument a RESP bulk string.";
  let count = args^.inner.len;
  log_count(log: log, count: count, room: 0_u64);
  for @arguments (index in 0_u64..count) {
    let span = args^.inner[index];
    log_input(log: log, input: input, span: span);
  }
  return unit;
}
