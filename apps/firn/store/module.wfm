alias HashMap = std::collections::hash_map::HashMap;
alias Bytes = pkg::bytes::Bytes;
alias Key = pkg::bytes::Key;
alias KeyEnv = pkg::bytes::KeyEnv;
alias OrderedKey = std::collections::ordered_map::OrderedKey;
alias OrderedMap = std::collections::ordered_map::OrderedMap;
alias PriorityOrder = std::collections::priority_queue::PriorityOrder;
alias PriorityQueue = std::collections::priority_queue::PriorityQueue;
alias Span = pkg::protocol::Span;

public const ceiling: u64 = 4294967296_u64;

public struct Rank {
  doc "A sorted set's member at its score, the key the set's order keeps.";
  public score: f64;
  public member: Key;
}

public struct Sorted {
  doc "A sorted set: its members in score order, ties by member bytes, and each member's score.";
  public order: OrderedMap<Rank, unit, ceiling>;
  public scores: HashMap<Key, f64, ceiling>;
}

public enum Value {
  Text(public bytes: Bytes);
  Items(public items: Box<Ring<Box<Slots<u8>>>>);
  Members(public members: HashMap<Key, unit, ceiling>);
  Fields(public fields: HashMap<Key, Bytes, ceiling>);
  Ranked(public ranked: Sorted);
}

public struct Entry {
  doc "A key's value and its expiry: the calendar time in milliseconds at which it expires, as Redis keeps it, or zero for none.";
  public value: Value;
  public expires: u64;
}

public struct Due {
  doc "An expiry queued for active removal: the key's bytes and the calendar milliseconds it was set to expire at.";
  public key: Bytes;
  public at: u64;
}

public struct Meta {
  doc "What the keyspace keeps beside its keys: the queued expiries, the append-only file's pending bytes, the clients connected, whether the server is stopping, and the state SPOP draws from.";
  public due: PriorityQueue<Due, ceiling>;
  public log: Box<Slots<u8>>;
  public clients: u64;
  public stopping: Bool;
  public random: u64;
}

public struct KeyspaceState {
  doc "The keyspace every client reaches through atomic statements: its keys, a table whose entries statements on different keys hold without waiting for each other, then what the keyspace keeps beside them, declared after the table so that a statement on a key takes it only where its block reaches it, after the key's entry.";
  public map: KeyedTable<Entry>;
  public meta: Meta;
}

public struct Keyspace {
  doc "One context's handle to the keyspace, and whether changes are appended to the append-only file's pending bytes, fixed before any client is served.";
  public state: Shared<KeyspaceState>;
  public logging: Bool;
}

public struct Time {
  doc "The clock as one command sees it: unix_ms, calendar milliseconds, which a relative expiry counts from; check, the instant an expiry is compared against, unix_ms while clients are served and zero while a file is replayed; and whether a file is being replayed.";
  public unix_ms: u64;
  public check: u64;
  public loading: Bool;
}

public fn rank_compare(env: &KeyEnv, left: &Rank, right: &Rank) -> order: i32 reads(left), reads(right) doc "Orders ranks by score, then by member bytes, as Redis orders a sorted set.";

public binding RankOrder : OrderedKey<Rank, KeyEnv> {
  compare = rank_compare;
}

public fn due_order(env: &KeyEnv, left: &Due, right: &Due) -> order: i32 reads(left), reads(right) doc "Orders queued expiries by their instant, the earliest first.";

public binding DueOrder : PriorityOrder<Due, KeyEnv> {
  compare = due_order;
}

public fn keyspace_new(seed: u64, logging: Bool) -> made: Keyspace pure doc "An empty keyspace sized for 2^18 keys, appending changes to the append-only file's pending bytes when logging is true, whose SPOP draws start from the seed.";

public fn keyspace_share(store: &Keyspace) -> made: Keyspace reads(store) doc "Another context's handle to the same keyspace.";

public fn keyspace_logging(store: &Keyspace, logging: Bool) -> made: Keyspace reads(store) doc "A handle to the same keyspace that appends changes to the append-only file's pending bytes when logging is true.";

public fn expired(expires: u64, now: u64) -> reached: Bool pure doc "Whether an expiry, zero for none, has been reached at now.";

public fn remove_expired(store: &Keyspace, key: &[u8], now: u64) -> result: unit reads(store), reads(key) waits doc "Removes the key when its expiry has been reached at now, for a command that found it expired in a statement that only read it, recording the removal as log_removal does; a key set again since keeps its value.";

public fn expire_batch(store: &Keyspace, now: u64, env: &KeyEnv, batch: &Box<Slots<Due>>) -> more: Bool reads(store), reads(env), writes(batch) waits doc "Takes up to 256 queued expiries that have been reached, the earliest first, in one atomic statement, then removes each key whose expiry is still the one queued in a statement on that key, recording the removal as log_removal does, and returns whether more may be due. A queued expiry that no longer matches its key's, because the key was set, given another expiry or removed since, is dropped. The batch is scratch space the caller keeps.";

public fn queue_expiry(meta: &Meta, key: &[u8], at: u64, env: &KeyEnv) -> result: unit reads(key), reads(env), writes(meta) doc "Queues a key's new expiry for active removal; one past the queue's ceiling is left to lazy removal.";

public fn log_removal(log: &Box<Slots<u8>>, key: &[u8]) -> result: unit reads(key), writes(log) doc "Appends DEL key, as Redis 7.0.15 propagates the removal of a key whose expiry has passed, so that a replay, which counts no key as expired, removes the key where the server did and a later command finds it absent there too.";

public fn log_count(log: &Box<Slots<u8>>, count: u64, room: u64) -> result: unit writes(log) doc "Makes room for a command of about room bytes and appends the header of a RESP array of count elements.";

public fn log_word(log: &Box<Slots<u8>>, word: &[u8]) -> result: unit reads(word), writes(log) doc "Appends a constant word as a RESP bulk string.";

public fn log_input(log: &Box<Slots<u8>>, input: &[u8], span: Span) -> result: unit reads(input), writes(log) doc "Appends an argument of the input as a RESP bulk string.";

public fn log_text(log: &Box<Slots<u8>>, text: &Bytes) -> result: unit reads(text), writes(log) doc "Appends a stored string as a RESP bulk string.";

public fn log_decimal(log: &Box<Slots<u8>>, value: u64) -> result: unit writes(log) doc "Appends a number as a RESP bulk string of its decimal digits.";

public fn log_command(log: &Box<Slots<u8>>, input: &[u8], args: &Box<Slots<Span>>) -> result: unit reads(input), reads(args), writes(log) doc "Appends a command as the client sent it, every argument a RESP bulk string.";
