alias Bytes = pkg::bytes::Bytes;
alias Key = pkg::bytes::Key;
alias KeyEnv = pkg::bytes::KeyEnv;
alias byte_at = pkg::bytes::byte_at;

const reply_crlf: Array<u8, 2> =[13_u8, 10_u8];

const reply_plain_ok: Array<u8, 5> =[43_u8, 79_u8, 75_u8, 13_u8, 10_u8];

const reply_null: Array<u8, 5> =[36_u8, 45_u8, 49_u8, 13_u8, 10_u8];

const reply_null_array: Array<u8, 5> =[42_u8, 45_u8, 49_u8, 13_u8, 10_u8];

const text_multibulk: Array<u8, 44> =[69_u8, 82_u8, 82_u8, 32_u8, 80_u8, 114_u8, 111_u8, 116_u8, 111_u8, 99_u8, 111_u8, 108_u8, 32_u8, 101_u8, 114_u8, 114_u8, 111_u8, 114_u8, 58_u8, 32_u8, 105_u8, 110_u8, 118_u8, 97_u8, 108_u8, 105_u8, 100_u8, 32_u8, 109_u8, 117_u8, 108_u8, 116_u8, 105_u8, 98_u8, 117_u8, 108_u8, 107_u8, 32_u8, 108_u8, 101_u8, 110_u8, 103_u8, 116_u8, 104_u8];

const text_dollar: Array<u8, 39> =[69_u8, 82_u8, 82_u8, 32_u8, 80_u8, 114_u8, 111_u8, 116_u8, 111_u8, 99_u8, 111_u8, 108_u8, 32_u8, 101_u8, 114_u8, 114_u8, 111_u8, 114_u8, 58_u8, 32_u8, 101_u8, 120_u8, 112_u8, 101_u8, 99_u8, 116_u8, 101_u8, 100_u8, 32_u8, 39_u8, 36_u8, 39_u8, 44_u8, 32_u8, 103_u8, 111_u8, 116_u8, 32_u8, 39_u8];

const text_bulk: Array<u8, 39> =[69_u8, 82_u8, 82_u8, 32_u8, 80_u8, 114_u8, 111_u8, 116_u8, 111_u8, 99_u8, 111_u8, 108_u8, 32_u8, 101_u8, 114_u8, 114_u8, 111_u8, 114_u8, 58_u8, 32_u8, 105_u8, 110_u8, 118_u8, 97_u8, 108_u8, 105_u8, 100_u8, 32_u8, 98_u8, 117_u8, 108_u8, 107_u8, 32_u8, 108_u8, 101_u8, 110_u8, 103_u8, 116_u8, 104_u8];

const text_inline: Array<u8, 42> =[69_u8, 82_u8, 82_u8, 32_u8, 80_u8, 114_u8, 111_u8, 116_u8, 111_u8, 99_u8, 111_u8, 108_u8, 32_u8, 101_u8, 114_u8, 114_u8, 111_u8, 114_u8, 58_u8, 32_u8, 116_u8, 111_u8, 111_u8, 32_u8, 98_u8, 105_u8, 103_u8, 32_u8, 105_u8, 110_u8, 108_u8, 105_u8, 110_u8, 101_u8, 32_u8, 114_u8, 101_u8, 113_u8, 117_u8, 101_u8, 115_u8, 116_u8];

