struct Line {
  value: i64;
  end: u64;
  state: u64;
}

fn short_line(input: &[u8], marker: u64, held: u64) -> line: Line reads(input) {
  doc "Reads the line after a marker byte when it is one digit, or two without a leading zero, then a carriage return and one more byte, all held: state 1 with the number and where its carriage return is, and state 0, leaving the line to the caller's general reading, for every other line.";
  let first = marker +wrap 1_u64;
  let second = marker +wrap 2_u64;
  let third = marker +wrap 3_u64;
  let fourth = marker +wrap 4_u64;
  let lead = byte_at(input: input, index: first);
  let next = byte_at(input: input, index: second);
  let lead_low = lead >= 48_u8;
  let lead_high = lead <= 57_u8;
  let lead_digit = band(lead_low, lead_high);
  let lead_value = lead -wrap 48_u8;
  let lead_wide = cvt::<u8, u64>(lead_value);
  let one_end = next == 13_u8;
  let one_held = third < held;
  let one_shaped = band(lead_digit, one_end);
  let one = band(one_shaped, one_held);
  if one {
    let single = cvt.wrap::<u64, i64>(lead_wide);
    return Line(value: single, end: second, state: 1_u64);
  }
  let next_low = next >= 48_u8;
  let next_high = next <= 57_u8;
  let next_digit = band(next_low, next_high);
  let unpadded = lead != 48_u8;
  let after = byte_at(input: input, index: third);
  let two_end = after == 13_u8;
  let two_held = fourth < held;
  let digits = band(lead_digit, next_digit);
  let leading = band(digits, unpadded);
  let shaped = band(leading, two_end);
  let two = band(shaped, two_held);
  if two {
    let next_value = next -wrap 48_u8;
    let next_wide = cvt::<u8, u64>(next_value);
    let tens = lead_wide *wrap 10_u64;
    let both = tens +wrap next_wide;
    let double = cvt.wrap::<u64, i64>(both);
    return Line(value: double, end: third, state: 1_u64);
  }
  return Line(value: 0_i64, end: marker, state: 0_u64);
}

fn read_line(input: &[u8], marker: u64, held: u64) -> line: Line reads(input) {
  doc "Reads a count or length line as read_line_full does, first trying the common line of one to nine digits without a sign or leading zero, whose carriage return and the byte after it are held. A marker byte that is a zero byte or a carriage return ends the line at the marker, as strchr ends it, so that line is left to read_line_full.";
  let position = marker +wrap 1_u64;
  let value = 0_u64;
  if marker < held {
    let mark = byte_at(input: input, index: marker);
    let zero = mark == 0_u8;
    let ends = mark == 13_u8;
    let at_marker = bor(zero, ends);
    if at_marker {
      let line = read_line_full(input: input, marker: marker, held: held);
      return line;
    }
  }
  let short = short_line(input: input, marker: marker, held: held);
  if short.state == 1_u64 {
    return short;
  }
  loop @digits {
    if position >= held {
      break @digits;
    }
    let byte = byte_at(input: input, index: position);
    if byte == 13_u8 {
      let first = marker +wrap 1_u64;
      let digits = position -wrap first;
      let after = position +wrap 1_u64;
      let some = digits >= 1_u64;
      let held_after = after < held;
      let lone = digits == 1_u64;
      let lead = byte_at(input: input, index: first);
      let unpadded = lead != 48_u8;
      let canonical = bor(lone, unpadded);
      let counted = band(some, held_after);
      let quick = band(counted, canonical);
      if quick {
        let summed = cvt.wrap::<u64, i64>(value);
        return Line(value: summed, end: position, state: 1_u64);
      }
      break @digits;
    }
    let low = byte >= 48_u8;
    let high = byte <= 57_u8;
    let digit = band(low, high);
    let first = marker +wrap 1_u64;
    let count = position -wrap first;
    let room = count < 9_u64;
    let take = band(digit, room);
    if take {
    } else {
      break @digits;
    }
    let offset = byte -wrap 48_u8;
    let wide = cvt::<u8, u64>(offset);
    let scaled = value *wrap 10_u64;
    set value = scaled +wrap wide;
    set position = position +wrap 1_u64;
  }
  let line = read_line_full(input: input, marker: marker, held: held);
  return line;
}

fn read_line_full(input: &[u8], marker: u64, held: u64) -> line: Line reads(input) {
  doc "Reads a count or length line whose marker byte, * or $, is at marker, as Redis 7.0 reads one. The line ends at the first carriage return from the marker on, found as strchr finds it, so that a zero byte, like the end of the bytes held, leaves the line incomplete; the byte after the carriage return must be held too and is skipped unread. State 1 is a complete line whose bytes after the marker read as a number, as string2ll reads one, into value; 2 is a complete line that does not read as one; 0 is an incomplete line; and 3 is a line still incomplete with more than 65,536 bytes held from its marker. end is the carriage return's position.";
  let position = marker;
  loop @find {
    if position >= held {
      break @find;
    }
    let byte = byte_at(input: input, index: position);
    if byte == 13_u8 {
      let after = position +wrap 1_u64;
      if after >= held {
        return Line(value: 0_i64, end: position, state: 0_u64);
      }
      if position > marker {
        let first = marker +wrap 1_u64;
        let length = position -wrap first;
        let number = read_integer(input: input, start: first, length: length);
        if number.state == 1_u64 {
          return Line(value: number.value, end: position, state: 1_u64);
        }
      }
      return Line(value: 0_i64, end: position, state: 2_u64);
    }
    if byte == 0_u8 {
      break @find;
    }
    set position = position +wrap 1_u64;
  }
  let pending = held -wrap marker;
  if pending > 65536_u64 {
    return Line(value: 0_i64, end: position, state: 3_u64);
  }
  return Line(value: 0_i64, end: position, state: 0_u64);
}

fn clear_args(args: &Box<Slots<Span>>) -> result: unit writes(args) {
  doc "Empties the argument spans, keeping their capacity.";
  loop @clearing {
    if args^.inner.len > 0_u64 {
      let dropped = take_back(window: &args^.inner);
    } else {
      break @clearing;
    }
  }
  return unit;
}

fn push_arg(args: &Box<Slots<Span>>, start: u64, length: u64) -> result: unit writes(args) {
  doc "Appends one argument's span, doubling the spans' capacity when they are full.";
  let capacity = args^.inner.cap;
  if args^.inner.len >= capacity {
    let doubled = capacity +wrap capacity;
    let target = imax(doubled, 16_u64);
    let fits = target <= 1073741824_u64;
    if fits {
      if target >= args^.inner.cap {
        grow(cell: args, capacity: target);
      }
    }
  }
  if args^.inner.len < args^.inner.cap {
    let span = Span(start: start, length: length);
    place_back(window: &args^.inner, value: span);
  }
  return unit;
}

fn parse_multibulk(input: &[u8], start: u64, held: u64, args: &Box<Slots<Span>>, locked: Bool) -> parsed: Parsed reads(input), writes(args) {
  doc "Reads a RESP array of bulk strings whose leading asterisk is at start, as Redis 7.0 reads one. The count line is read as read_line reads it, and each length line of the common shape, a dollar sign and one to nine digits without a leading zero whose carriage return and following byte are held, is read in place, every other one as read_line_full reads it. The count is at most 2,147,483,647, and an array of no element or a negative count is skipped; each bulk string's line starts with a dollar sign, its length is 0 to 536,870,912, and the two bytes after its data are skipped unread. A client that must authenticate first, when locked is true, may send at most 10 elements and bulk strings of at most 16,384 bytes.";
  let header = read_line(input: input, marker: start, held: held);
  if header.state == 0_u64 {
    return Parsed(state: 0_u64, next: start);
  }
  if header.state == 3_u64 {
    return Parsed(state: 8_u64, next: start);
  }
  if header.state == 2_u64 {
    return Parsed(state: 2_u64, next: start);
  }
  let elements = header.value;
  if elements > 2147483647_i64 {
    return Parsed(state: 2_u64, next: start);
  }
  if elements > 10_i64 {
    if locked {
      return Parsed(state: 10_u64, next: start);
    }
  }
  let position = header.end +wrap 2_u64;
  if elements <= 0_i64 {
    return Parsed(state: 6_u64, next: position);
  }
  let count = cvt.wrap::<i64, u64>(elements);
  clear_args(args: args);
  for @arguments (ordinal in 0_u64..count) {
    let dollar = byte_at(input: input, index: position);
    let size = 0_i64;
    let line_end = 0_u64;
    let quick = False();
    let short = short_line(input: input, marker: position, held: held);
    let dollared = dollar == 36_u8;
    let shortened = short.state == 1_u64;
    let ready = band(dollared, shortened);
    if ready {
      set size = short.value;
      set line_end = short.end;
      set quick = True();
    } else if dollared {
      let first = position +wrap 1_u64;
      let scan = first;
      let value = 0_u64;
      loop @digits {
        if scan >= held {
          break @digits;
        }
        let byte = byte_at(input: input, index: scan);
        if byte == 13_u8 {
          let digits = scan -wrap first;
          let after = scan +wrap 1_u64;
          let some = digits >= 1_u64;
          let held_after = after < held;
          let lone = digits == 1_u64;
          let lead = byte_at(input: input, index: first);
          let unpadded = lead != 48_u8;
          let canonical = bor(lone, unpadded);
          let counted = band(some, held_after);
          let common = band(counted, canonical);
          if common {
            set size = cvt.wrap::<u64, i64>(value);
            set line_end = scan;
            set quick = True();
          }
          break @digits;
        }
        let low = byte >= 48_u8;
        let high = byte <= 57_u8;
        let digit = band(low, high);
        let taken = scan -wrap first;
        let room = taken < 9_u64;
        let take = band(digit, room);
        if take {
        } else {
          break @digits;
        }
        let offset = byte -wrap 48_u8;
        let wide = cvt::<u8, u64>(offset);
        let scaled = value *wrap 10_u64;
        set value = scaled +wrap wide;
        set scan = scan +wrap 1_u64;
      }
    }
    if quick {
    } else {
      let line = read_line_full(input: input, marker: position, held: held);
      if line.state == 0_u64 {
        return Parsed(state: 0_u64, next: start);
      }
      if line.state == 3_u64 {
        return Parsed(state: 9_u64, next: start);
      }
      if dollar != 36_u8 {
        return Parsed(state: 3_u64, next: position);
      }
      if line.state == 2_u64 {
        return Parsed(state: 4_u64, next: position);
      }
      set size = line.value;
      set line_end = line.end;
    }
    if size < 0_i64 {
      return Parsed(state: 4_u64, next: position);
    }
    if size > 536870912_i64 {
      return Parsed(state: 4_u64, next: position);
    }
    if size > 16384_i64 {
      if locked {
        return Parsed(state: 11_u64, next: position);
      }
    }
    let length = cvt.wrap::<i64, u64>(size);
    let data_start = line_end +wrap 2_u64;
    let data_end = data_start +wrap length;
    let closed = data_end +wrap 2_u64;
    if closed > held {
      return Parsed(state: 0_u64, next: start);
    }
    push_arg(args: args, start: data_start, length: length);
    set position = closed;
  }
  return Parsed(state: 1_u64, next: position);
}

fn blank(byte: u8) -> result: Bool pure {
  doc "Whether a byte is white space as C's isspace reads it in the C locale: space, tab, line feed, vertical tab, form feed or carriage return.";
  let space = byte == 32_u8;
  let low = byte >= 9_u8;
  let high = byte <= 13_u8;
  let control = band(low, high);
  let white = bor(space, control);
  return white;
}

fn hex_value(byte: u8) -> result: u8 pure {
  doc "The value of a hexadecimal digit in either case, or 16 for a byte that is not one.";
  let digit_low = byte >= 48_u8;
  let digit_high = byte <= 57_u8;
  let digit = band(digit_low, digit_high);
  if digit {
    let value = byte -wrap 48_u8;
    return value;
  }
  let lowered = ior(byte, 32_u8);
  let letter_low = lowered >= 97_u8;
  let letter_high = lowered <= 102_u8;
  let letter = band(letter_low, letter_high);
  if letter {
    let value = lowered -wrap 87_u8;
    return value;
  }
  return 16_u8;
}

fn escaped(byte: u8) -> result: u8 pure {
  doc "The byte a backslash before a byte stands for inside double quotes: n, r, t, b and a stand for line feed, carriage return, tab, backspace and bell, and any other byte for itself.";
  if byte == 110_u8 {
    return 10_u8;
  }
  if byte == 114_u8 {
    return 13_u8;
  }
  if byte == 116_u8 {
    return 9_u8;
  }
  if byte == 98_u8 {
    return 8_u8;
  }
  if byte == 97_u8 {
    return 7_u8;
  }
  return byte;
}

fn put_decoded(input: &[u8], position: u64, value: u8) -> result: unit writes(input) {
  doc "Writes one decoded byte of an inline argument into the input at a position no later than the byte it was read from.";
  if position < input^.len {
    set input^[position] = value;
  }
  return unit;
}

fn parse_inline(input: &[u8], start: u64, held: u64, args: &Box<Slots<Span>>) -> parsed: Parsed writes(input), writes(args) {
  doc "Reads an inline command as Redis 7.0 reads one. The line runs to a line feed found as strchr finds it, so that a zero byte before it leaves the line incomplete, and a carriage return before the line feed is dropped; a line incomplete with more than 65,536 bytes held is malformed. The line splits into arguments as sdssplitargs splits it: white space separates them; an argument may hold double-quoted parts, where a backslash before x and two hexadecimal digits stands for that byte, before n, r, t, b or a for line feed, carriage return, tab, backspace or bell, and before any other byte for that byte, and single-quoted parts, where only a backslash before a quote stands for the quote; a closing quote must be followed by white space or the end of the line, and a part not closed is malformed. Each argument's decoded bytes are written back into the input from where the line's earlier arguments end, so that each span names decoded bytes and no write passes the byte being read. A line of no argument is skipped.";
  let line_end = start;
  let found = False();
  loop @find {
    if line_end >= held {
      break @find;
    }
    let byte = byte_at(input: input, index: line_end);
    if byte == 10_u8 {
      set found = True();
      break @find;
    }
    if byte == 0_u8 {
      break @find;
    }
    set line_end = line_end +wrap 1_u64;
  }
  if found {
  } else {
    let pending = held -wrap start;
    if pending > 65536_u64 {
      return Parsed(state: 5_u64, next: start);
    }
    return Parsed(state: 0_u64, next: start);
  }
  let next = line_end +wrap 1_u64;
  let content_end = line_end;
  if content_end > start {
    let last_position = content_end -wrap 1_u64;
    let last = byte_at(input: input, index: last_position);
    if last == 13_u8 {
      set content_end = last_position;
    }
  }
  clear_args(args: args);
  let read = start;
  let write = start;
  loop @arguments {
    loop @blanks {
      let leading = byte_before(input: input, position: read, end: content_end);
      let skipped = blank(byte: leading);
      if skipped {
        set read = read +wrap 1_u64;
      } else {
        break @blanks;
      }
    }
    if read >= content_end {
      break @arguments;
    }
    let first = write;
    let mode = 0_u64;
    let done = False();
    loop @bytes {
      if done {
        break @bytes;
      }
      let byte = byte_before(input: input, position: read, end: content_end);
      let second_position = read +wrap 1_u64;
      let second = byte_before(input: input, position: second_position, end: content_end);
      let consumed = 1_u64;
      if mode == 1_u64 {
        let third_position = read +wrap 2_u64;
        let third = byte_before(input: input, position: third_position, end: content_end);
        let fourth_position = read +wrap 3_u64;
        let fourth = byte_before(input: input, position: fourth_position, end: content_end);
        let high = hex_value(byte: third);
        let low = hex_value(byte: fourth);
        let backslash = byte == 92_u8;
        let marked = second == 120_u8;
        let high_digit = high < 16_u8;
        let low_digit = low < 16_u8;
        let introduced = band(backslash, marked);
        let digits = band(high_digit, low_digit);
        let hexadecimal = band(introduced, digits);
        let follows = second != 0_u8;
        let escape = band(backslash, follows);
        if hexadecimal {
          let scaled = high *wrap 16_u8;
          let value = scaled +wrap low;
          put_decoded(input: input, position: write, value: value);
          set write = write +wrap 1_u64;
          set consumed = 4_u64;
        } else if escape {
          let value = escaped(byte: second);
          put_decoded(input: input, position: write, value: value);
          set write = write +wrap 1_u64;
          set consumed = 2_u64;
        } else if byte == 34_u8 {
          let spaced = blank(byte: second);
          let ended = second == 0_u8;
          let closes = bor(spaced, ended);
          if closes {
          } else {
            return Parsed(state: 7_u64, next: next);
          }
          set done = True();
        } else if byte == 0_u8 {
          return Parsed(state: 7_u64, next: next);
        } else {
          put_decoded(input: input, position: write, value: byte);
          set write = write +wrap 1_u64;
        }
      } else if mode == 2_u64 {
        let backslash = byte == 92_u8;
        let quote_next = second == 39_u8;
        let escape = band(backslash, quote_next);
        if escape {
          put_decoded(input: input, position: write, value: 39_u8);
          set write = write +wrap 1_u64;
          set consumed = 2_u64;
        } else if byte == 39_u8 {
          let spaced = blank(byte: second);
          let ended = second == 0_u8;
          let closes = bor(spaced, ended);
          if closes {
          } else {
            return Parsed(state: 7_u64, next: next);
          }
          set done = True();
        } else if byte == 0_u8 {
          return Parsed(state: 7_u64, next: next);
        } else {
          put_decoded(input: input, position: write, value: byte);
          set write = write +wrap 1_u64;
        }
      } else {
        let space = byte == 32_u8;
        let feed = byte == 10_u8;
        let carriage = byte == 13_u8;
        let tab = byte == 9_u8;
        let line_break = bor(feed, carriage);
        let gap = bor(space, tab);
        let separator = bor(line_break, gap);
        if separator {
          set done = True();
        } else if byte == 0_u8 {
          set done = True();
          set consumed = 0_u64;
        } else if byte == 34_u8 {
          set mode = 1_u64;
        } else if byte == 39_u8 {
          set mode = 2_u64;
        } else {
          put_decoded(input: input, position: write, value: byte);
          set write = write +wrap 1_u64;
        }
      }
      set read = read +wrap consumed;
    }
    let length = write -wrap first;
    push_arg(args: args, start: first, length: length);
  }
  if args^.inner.len == 0_u64 {
    return Parsed(state: 6_u64, next: next);
  }
  return Parsed(state: 1_u64, next: next);
}

fn parse_request(input: &[u8], start: u64, held: u64, args: &Box<Slots<Span>>, locked: Bool) -> parsed: Parsed writes(input), writes(args) {
  doc "Reads one request from a position of the input, of which held bytes are filled: a RESP array of bulk strings, or an inline command, told apart by its first byte as Redis tells them. A command's arguments replace what args held, one span each; an inline command's decoded arguments are written back into the input over its line. locked is true for a client that must authenticate first, whose arrays Redis limits.";
  if start >= held {
    return Parsed(state: 0_u64, next: start);
  }
  let marker = byte_at(input: input, index: start);
  if marker == 42_u8 {
    let parsed = parse_multibulk(input: input, start: start, held: held, args: args, locked: locked);
    return parsed;
  }
  let parsed = parse_inline(input: input, start: start, held: held, args: args);
  return parsed;
}

fn protocol_error(client: &Client, input: &[u8], parsed: Parsed) -> result: unit reads(input), writes(client) {
  doc "Writes the error Redis replies to a malformed request parse_request reported; for a missing dollar sign, next is the position of the byte found instead.";
  let state = parsed.state;
  if state == 2_u64 {
    reply_error(client: client, word: &text_multibulk[0_u64..44_u64]);
  } else if state == 3_u64 {
    reply_byte(client: client, value: 45_u8);
    reply_word(client: client, word: &text_dollar[0_u64..39_u64]);
    let found = byte_at(input: input, index: parsed.next);
    let shown = echoed(byte: found);
    reply_byte(client: client, value: shown);
    reply_byte(client: client, value: 39_u8);
    reply_word(client: client, word: &reply_crlf[0_u64..2_u64]);
  } else if state == 4_u64 {
    reply_error(client: client, word: &text_bulk[0_u64..39_u64]);
  } else if state == 5_u64 {
    reply_error(client: client, word: &text_inline[0_u64..42_u64]);
  } else if state == 7_u64 {
    reply_error(client: client, word: &text_unbalanced[0_u64..48_u64]);
  } else if state == 8_u64 {
    reply_error(client: client, word: &text_count_line[0_u64..46_u64]);
  } else if state == 9_u64 {
    reply_error(client: client, word: &text_length_line[0_u64..45_u64]);
  } else if state == 10_u64 {
    reply_error(client: client, word: &text_locked_count[0_u64..52_u64]);
  } else {
    reply_error(client: client, word: &text_locked_length[0_u64..47_u64]);
  }
  return unit;
}

fn input_new(capacity: u64) -> made: Box<Slots<u8>> pure contract {
  requires capacity <= 1073741824_u64;
  ensures made.inner.len == capacity;
} {
  doc "A client's input window: capacity bytes, all filled.";
  let made = box_slots_new::<u8>(capacity: capacity);
  for @fill (
    at in 0_u64..capacity,
    invariant filled: made.inner.len == at
  ) {
    place_back(window: &made.inner, value: 0_u8);
  }
  return move made;
}

fn input_grow(input: &Box<Slots<u8>>) -> result: unit writes(input) {
  doc "Doubles a full input window, filling its new bytes; one of 2^31 bytes or more stays as it is.";
  let length = input^.inner.len;
  if length >= 2147483648_u64 {
    return unit;
  }
  let doubled = length +wrap length;
  let target = imax(doubled, 16384_u64);
  if target >= input^.inner.cap {
    grow(cell: input, capacity: target);
  }
  loop @fill {
    if input^.inner.len < input^.inner.cap {
      place_back(window: &input^.inner, value: 0_u8);
    } else {
      break @fill;
    }
  }
  return unit;
}

fn keep_rest(input: &Box<Slots<u8>>, from: u64, held: u64) -> kept: u64 writes(input) {
  doc "Moves the bytes from a position up to held, an incomplete request, to the front of the input and returns how many it moved.";
  let kept = 0_u64;
  if from < held {
    set kept = held -wrap from;
  }
  for @move_bytes (offset in 0_u64..kept) {
    let source = from +wrap offset;
    if source < input^.inner.len {
      let byte = input^.inner[source];
      if offset < input^.inner.len {
        set input^.inner[offset] = byte;
      }
    }
  }
  return kept;
}

fn arg(args: &Box<Slots<Span>>, index: u64) -> span: Span reads(args) {
  doc "The span of one argument, or an empty span past the last.";
  if index < args^.inner.len {
    let span = args^.inner[index];
    return span;
  }
  return Span(start: 0_u64, length: 0_u64);
}

fn client_new(capacity: u64) -> made: Client pure contract {
  requires capacity <= 1073741824_u64;
} {
  doc "A client with no reply written, over a window of capacity bytes.";
  let bytes = box_slots_new::<u8>(capacity: capacity);
  for @fill (
    at in 0_u64..capacity,
    invariant filled: bytes.inner.len == at
  ) {
    place_back(window: &bytes.inner, value: 0_u8);
  }
  let items = box_slots_new::<Key>(capacity: 16_u64);
  let scores = box_slots_new::<f64>(capacity: 16_u64);
  let key_metadata = box_slots_new::<u64>(capacity: 16_u64);
  let keys = KeyEnv();
  let name = empty_text();
  let trusted = True();
  let unlocked = False();
  let open = False();
  let settings = settings_empty();
  return Client(bytes: move bytes, at: 0_u64, now: 0_u64, state: 0_u64, number: 0_u64, low: 0_i64, high: 0_i64, items: move items, scores: move scores, key_metadata: move key_metadata, keys: keys, random: 0_u64, id: 0_u64, name: move name, authenticated: trusted, locked: unlocked, closing: open, unix_us: 0_u64, settings: move settings);
}

fn empty_text() -> made: Bytes pure {
  doc "A string of no bytes.";
  let short = slots_new::<u8, 24>();
  return Bytes::Short(bytes: move short);
}

fn settings_empty() -> made: Settings pure {
  doc "Settings of port 0 and an empty address and file name, for a client no server configured, such as the one an append-only file's replay runs its commands as.";
  let bind = empty_text();
  let appendfilename = empty_text();
  return Settings(port: 0_u64, bind: move bind, appendfilename: move appendfilename);
}

fn settings_copy(settings: &Settings) -> made: Settings reads(settings) {
  doc "A copy of the settings, for another connection.";
  let bind = bytes_copy(bytes: &settings^.bind);
  let appendfilename = bytes_copy(bytes: &settings^.appendfilename);
  return Settings(port: settings^.port, bind: move bind, appendfilename: move appendfilename);
}

fn clear_items(client: &Client) -> result: unit writes(client) {
  doc "Drops every prepared key and score.";
  loop @strings {
    if client^.items.inner.len > 0_u64 {
      let dropped = take_back(window: &client^.items.inner);
    } else {
      break @strings;
    }
  }
  loop @numbers {
    if client^.scores.inner.len > 0_u64 {
      let dropped = take_back(window: &client^.scores.inner);
    } else {
      break @numbers;
    }
  }
  return unit;
}

fn push_item(client: &Client, item: Key) -> result: unit writes(client) {
  doc "Adds a prepared key, growing the space for them when it is full.";
  let capacity = client^.items.inner.cap;
  if client^.items.inner.len >= capacity {
    let doubled = capacity +wrap capacity;
    let target = imax(doubled, 16_u64);
    let fits = target <= 1073741824_u64;
    if fits {
      if target >= client^.items.inner.cap {
        grow(cell: &client^.items, capacity: target);
      }
    }
  }
  if client^.items.inner.len < client^.items.inner.cap {
    place_back(window: &client^.items.inner, value: move item);
  } else {
    let dropped = move item;
  }
  return unit;
}

fn push_score(client: &Client, score: f64) -> result: unit writes(client) {
  doc "Adds a prepared score, growing the space for them when it is full.";
  let capacity = client^.scores.inner.cap;
  if client^.scores.inner.len >= capacity {
    let doubled = capacity +wrap capacity;
    let target = imax(doubled, 16_u64);
    let fits = target <= 1073741824_u64;
    if fits {
      if target >= client^.scores.inner.cap {
        grow(cell: &client^.scores, capacity: target);
      }
    }
  }
  if client^.scores.inner.len < client^.scores.inner.cap {
    place_back(window: &client^.scores.inner, value: score);
  }
  return unit;
}

fn reply_room(client: &Client, needed: u64) -> result: unit writes(client) {
  doc "Grows the window, at least doubling it, until it has room for needed more bytes after at. No host allocates the 2^62 bytes the growth stops at; a host that cannot allocate less stops the program [SCOPE-3], as Redis stops when a reply exhausts memory.";
  let length = client^.bytes.inner.len;
  let wanted = client^.at +wrap needed;
  if wanted <= length {
    return unit;
  }
  let doubled = length +wrap length;
  let target = imax(doubled, wanted);
  let fits = target <= 4611686018427387904_u64;
  if fits {
    if target >= client^.bytes.inner.cap {
      grow(cell: &client^.bytes, capacity: target);
    }
    loop @fill {
      if client^.bytes.inner.len < client^.bytes.inner.cap {
        place_back(window: &client^.bytes.inner, value: 0_u8);
      } else {
        break @fill;
      }
    }
  }
  return unit;
}

fn put(client: &Client, value: u8) -> result: unit writes(client) {
  doc "Writes one byte at at into room reply_room made.";
  let position = client^.at;
  if position < client^.bytes.inner.len {
    set client^.bytes.inner[position] = value;
    set client^.at = position +wrap 1_u64;
  }
  return unit;
}

fn reply_byte(client: &Client, value: u8) -> result: unit writes(client) {
  doc "Writes one byte, growing the window when it is full.";
  reply_room(client: client, needed: 1_u64);
  put(client: client, value: value);
  return unit;
}

fn reply_word(client: &Client, word: &[u8]) -> result: unit reads(word), writes(client) {
  doc "Writes every byte of a constant word.";
  let count = word^.len;
  reply_room(client: client, needed: count);
  for @word (offset in 0_u64..count) {
    let byte = word^[offset];
    put(client: client, value: byte);
  }
  return unit;
}

fn echoed(byte: u8) -> shown: u8 pure {
  doc "A byte of the input as an error reply echoes it: carriage return and line feed become spaces, as Redis maps them, so that the reply stays one line.";
  if byte == 13_u8 {
    return 32_u8;
  }
  if byte == 10_u8 {
    return 32_u8;
  }
  return byte;
}

fn reply_echoed(client: &Client, input: &[u8], span: Span, limit: u64) -> written: u64 reads(input), writes(client) {
  doc "Writes at most limit bytes of an argument into an error reply as Redis formats one with %s, stopping before a zero byte and writing carriage return and line feed as spaces, and returns how many it wrote.";
  let length = imin(span.length, limit);
  reply_room(client: client, needed: length);
  let written = 0_u64;
  for @bytes (offset in 0_u64..length) {
    let position = span.start +wrap offset;
    let byte = byte_at(input: input, index: position);
    if byte == 0_u8 {
      break @bytes;
    }
    let shown = echoed(byte: byte);
    put(client: client, value: shown);
    set written = written +wrap 1_u64;
  }
  return written;
}

fn put_decimal(client: &Client, value: u64) -> result: unit writes(client) {
  doc "Writes a number in decimal into room reply_room made.";
  let digits = 1_u64;
  let rest = value / 10_u64;
  loop @count {
    if rest == 0_u64 {
      break @count;
    }
    set digits = digits +wrap 1_u64;
    set rest = rest / 10_u64;
  }
  let first = client^.at;
  let last = first +wrap digits;
  let remaining = value;
  for @emit (step in 0_u64..digits) {
    let back = digits -wrap step;
    let offset = back -wrap 1_u64;
    let position = first +wrap offset;
    let low = remaining % 10_u64;
    let narrow = cvt.wrap::<u64, u8>(low);
    let glyph = narrow +wrap 48_u8;
    if position < client^.bytes.inner.len {
      set client^.bytes.inner[position] = glyph;
    }
    set remaining = remaining / 10_u64;
  }
  set client^.at = last;
  return unit;
}

fn reply_decimal(client: &Client, value: u64) -> result: unit writes(client) {
  doc "Writes a number in decimal.";
  reply_room(client: client, needed: 20_u64);
  put_decimal(client: client, value: value);
  return unit;
}

fn reply_integer(client: &Client, value: i64) -> result: unit writes(client) {
  doc "Writes a RESP integer.";
  reply_room(client: client, needed: 24_u64);
  put(client: client, value: 58_u8);
  let magnitude = cvt.wrap::<i64, u64>(value);
  if value < 0_i64 {
    put(client: client, value: 45_u8);
    set magnitude = 0_u64 -wrap magnitude;
  }
  put_decimal(client: client, value: magnitude);
  put(client: client, value: 13_u8);
  put(client: client, value: 10_u8);
  return unit;
}

fn reply_array(client: &Client, count: u64) -> result: unit writes(client) {
  doc "Writes the header of a RESP array of count elements.";
  reply_room(client: client, needed: 24_u64);
  put(client: client, value: 42_u8);
  put_decimal(client: client, value: count);
  put(client: client, value: 13_u8);
  put(client: client, value: 10_u8);
  return unit;
}

fn put_at(client: &Client, position: u64, value: u8) -> result: unit writes(client) {
  doc "Writes one byte at a position inside the window, leaving at where it is.";
  if position < client^.bytes.inner.len {
    set client^.bytes.inner[position] = value;
  }
  return unit;
}

fn reply_bulk(client: &Client, stored: &Box<Slots<u8>>) -> result: unit reads(stored), writes(client) {
  doc "Writes a stored string as a RESP bulk string. One of fewer than ten bytes, whose length is one digit, is written from one position read once: the benchmark's list elements are three bytes and a range reply writes a hundred of them.";
  let length = stored^.inner.len;
  let needed = length +wrap 26_u64;
  reply_room(client: client, needed: needed);
  if length < 10_u64 {
    let start = client^.at;
    let narrow = cvt.wrap::<u64, u8>(length);
    let digit = narrow +wrap 48_u8;
    put_at(client: client, position: start, value: 36_u8);
    let second = start +wrap 1_u64;
    put_at(client: client, position: second, value: digit);
    let third = start +wrap 2_u64;
    put_at(client: client, position: third, value: 13_u8);
    let fourth = start +wrap 3_u64;
    put_at(client: client, position: fourth, value: 10_u8);
    let body = start +wrap 4_u64;
    for @short (index in 0_u64..length) {
      let byte = stored^.inner[index];
      let position = body +wrap index;
      put_at(client: client, position: position, value: byte);
    }
    let tail = body +wrap length;
    put_at(client: client, position: tail, value: 13_u8);
    let end = tail +wrap 1_u64;
    put_at(client: client, position: end, value: 10_u8);
    let after = end +wrap 1_u64;
    set client^.at = imin(after, client^.bytes.inner.len);
    return unit;
  }
  put(client: client, value: 36_u8);
  put_decimal(client: client, value: length);
  put(client: client, value: 13_u8);
  put(client: client, value: 10_u8);
  let first = client^.at;
  for @bytes (index in 0_u64..length) {
    let byte = stored^.inner[index];
    let position = first +wrap index;
    if position < client^.bytes.inner.len {
      set client^.bytes.inner[position] = byte;
    }
  }
  let last = first +wrap length;
  set client^.at = imin(last, client^.bytes.inner.len);
  put(client: client, value: 13_u8);
  put(client: client, value: 10_u8);
  return unit;
}

fn reply_text(client: &Client, text: &Bytes) -> result: unit reads(text), writes(client) {
  doc "Writes a stored string as a RESP bulk string.";
  match text^ {
    Short(bytes: short) => {
      let length = short^.len;
      let window = &short^[0_u64..length];
      reply_bulk_input(client: client, input: window, start: 0_u64, length: length);
    }
    Long(bytes: long) => {
      let length = long^.inner.len;
      let window = &long^.inner[0_u64..length];
      reply_bulk_input(client: client, input: window, start: 0_u64, length: length);
    }
  }
  return unit;
}

fn reply_bulk_input(client: &Client, input: &[u8], start: u64, length: u64) -> result: unit reads(input), writes(client) {
  doc "Writes bytes of the input as a RESP bulk string.";
  let needed = length +wrap 26_u64;
  reply_room(client: client, needed: needed);
  put(client: client, value: 36_u8);
  put_decimal(client: client, value: length);
  put(client: client, value: 13_u8);
  put(client: client, value: 10_u8);
  for @bytes (offset in 0_u64..length) {
    let position = start +wrap offset;
    let byte = byte_at(input: input, index: position);
    put(client: client, value: byte);
  }
  put(client: client, value: 13_u8);
  put(client: client, value: 10_u8);
  return unit;
}

fn reply_bulk_decimal(client: &Client, value: i64) -> result: unit writes(client) {
  doc "Writes a number as a RESP bulk string of its decimal digits, with a leading minus sign when it is negative.";
  let magnitude = cvt.wrap::<i64, u64>(value);
  let negative = value < 0_i64;
  if negative {
    set magnitude = 0_u64 -wrap magnitude;
  }
  let digits = 1_u64;
  let rest = magnitude / 10_u64;
  loop @count {
    if rest == 0_u64 {
      break @count;
    }
    set digits = digits +wrap 1_u64;
    set rest = rest / 10_u64;
  }
  let length = digits;
  if negative {
    set length = digits +wrap 1_u64;
  }
  reply_room(client: client, needed: 48_u64);
  put(client: client, value: 36_u8);
  put_decimal(client: client, value: length);
  put(client: client, value: 13_u8);
  put(client: client, value: 10_u8);
  if negative {
    put(client: client, value: 45_u8);
  }
  put_decimal(client: client, value: magnitude);
  put(client: client, value: 13_u8);
  put(client: client, value: 10_u8);
  return unit;
}

fn reply_ok(client: &Client) -> result: unit writes(client) {
  doc "Writes +OK.";
  reply_word(client: client, word: &reply_plain_ok[0_u64..5_u64]);
  return unit;
}

fn reply_nil(client: &Client) -> result: unit writes(client) {
  doc "Writes the RESP2 null bulk string.";
  reply_word(client: client, word: &reply_null[0_u64..5_u64]);
  return unit;
}

fn reply_nil_array(client: &Client) -> result: unit writes(client) {
  doc "Writes the RESP2 null array.";
  reply_word(client: client, word: &reply_null_array[0_u64..5_u64]);
  return unit;
}

fn reply_error(client: &Client, word: &[u8]) -> result: unit reads(word), writes(client) {
  doc "Writes a RESP error: a minus sign, the word, which carries its own ERR or WRONGTYPE prefix, and CR LF.";
  reply_byte(client: client, value: 45_u8);
  reply_word(client: client, word: word);
  reply_word(client: client, word: &reply_crlf[0_u64..2_u64]);
  return unit;
}

fn reply_wrong_type(client: &Client) -> result: unit writes(client) {
  doc "Writes the error Redis replies to a command on a key holding another kind of value.";
  reply_error(client: client, word: &text_wrong_type[0_u64..65_u64]);
  return unit;
}

fn reply_arity(client: &Client, input: &[u8], name: Span) -> result: unit reads(input), writes(client) {
  doc "Writes the error Redis replies to a known command given the wrong number of arguments, naming the command in lower case.";
  reply_byte(client: client, value: 45_u8);
  reply_word(client: client, word: &text_arity[0_u64..35_u64]);
  let length = name.length;
  reply_room(client: client, needed: length);
  for @name (offset in 0_u64..length) {
    let position = name.start +wrap offset;
    let byte = byte_at(input: input, index: position);
    let lowered = lower(byte: byte);
    put(client: client, value: lowered);
  }
  reply_word(client: client, word: &text_command[0_u64..11_u64]);
  return unit;
}

fn reply_arity_word(client: &Client, word: &[u8]) -> result: unit reads(word), writes(client) {
  doc "Writes the error Redis replies to a known command or subcommand given the wrong number of arguments, naming it by a constant word such as client|id.";
  reply_byte(client: client, value: 45_u8);
  reply_word(client: client, word: &text_arity[0_u64..35_u64]);
  reply_word(client: client, word: word);
  reply_word(client: client, word: &text_command[0_u64..11_u64]);
  return unit;
}

fn reply_quoted(client: &Client, input: &[u8], span: Span, limit: u64) -> written: u64 reads(input), writes(client) {
  doc "Writes an argument between single quotes as reply_echoed writes it, and returns how many of its bytes it wrote.";
  reply_byte(client: client, value: 39_u8);
  let written = reply_echoed(client: client, input: input, span: span, limit: limit);
  reply_byte(client: client, value: 39_u8);
  return written;
}

fn reply_unknown(client: &Client, input: &[u8], args: &Box<Slots<Span>>) -> result: unit reads(input), reads(args), writes(client) {
  doc "Writes the error Redis replies to a command it does not know, naming the command and its first arguments: at most 128 bytes of the name, then each argument quoted and followed by a space while the arguments written stay within 128 bytes, each as reply_echoed writes it.";
  reply_word(client: client, word: &text_unknown[0_u64..21_u64]);
  let name = arg(args: args, index: 0_u64);
  let named = reply_quoted(client: client, input: input, span: name, limit: 128_u64);
  reply_word(client: client, word: &text_beginning[0_u64..28_u64]);
  let count = args^.inner.len;
  let used = 0_u64;
  for @arguments (index in 1_u64..count) {
    let span = arg(args: args, index: index);
    let room = 128_u64 -sat used;
    if room == 0_u64 {
      break @arguments;
    }
    let shown = reply_quoted(client: client, input: input, span: span, limit: room);
    reply_byte(client: client, value: 32_u8);
    let spent = shown +wrap 3_u64;
    set used = used +wrap spent;
  }
  reply_word(client: client, word: &reply_crlf[0_u64..2_u64]);
  return unit;
}
