struct Span {
  start: u32;
  end: u32;
}

struct Numeric {
  value: f64;
  integral: Bool;
  span: Span;
}

enum Component {
  Whitespace(span: Span);
  Ident(span: Span);
  Number(number: Numeric);
  Dimension(number: Numeric, unit_name: Span);
  Delim(code: u32);
  Eof();
}

enum Holder {
  Boxed(cell: Box<u64>, stamp: u64);
  Many(values: Box<Slots<u64>>);
  Nested(inner: Component, extra: Box<u64>);
  Nothing();
}

struct Wrapped {
  label: u32;
  holder: Holder;
  tail: u8;
}

enum Outer {
  Wrap(value: Holder, mark: u8);
  Pair(first: Component, second: u64);
  Empty();
}

fn make_component(kind: u32, seed: u32) -> result: Component pure {
  let one = seed +wrap 1_u32;
  let two = seed +wrap 2_u32;
  let three = seed +wrap 3_u32;
  let four = seed +wrap 4_u32;
  let five = seed +wrap 5_u32;
  let seven = seed +wrap 7_u32;
  let no = False();
  let yes = True();
  if kind == 0_u32 {
    let s = Span(start: seed, end: one);
    return Component::Whitespace(span: s);
  }
  if kind == 1_u32 {
    let s = Span(start: seed, end: two);
    return Component::Ident(span: s);
  }
  if kind == 2_u32 {
    let s = Span(start: seed, end: three);
    let number = Numeric(value: 2.5_f64, integral: no, span: s);
    return Component::Number(number: number);
  }
  if kind == 3_u32 {
    let s = Span(start: seed, end: four);
    let u = Span(start: five, end: seven);
    let number = Numeric(value: 4.0_f64, integral: yes, span: s);
    return Component::Dimension(number: number, unit_name: u);
  }
  if kind == 4_u32 {
    return Component::Delim(code: seed);
  }
  return Component::Eof();
}

fn weigh(component: Component) -> result: u64 pure {
  match component {
    Whitespace(span: s) => {
      let end = cvt::<u32, u64>(s.end);
      return end +wrap 100_u64;
    }
    Ident(span: s) => {
      let end = cvt::<u32, u64>(s.end);
      return end +wrap 200_u64;
    }
    Number(number: n) => {
      let end = cvt::<u32, u64>(n.span.end);
      let bonus = if n.integral {
        give 1_u64;
      } else {
        give 0_u64;
      }
      let base = end +wrap 300_u64;
      return base +wrap bonus;
    }
    Dimension(number: n, unit_name: u) => {
      let end = cvt::<u32, u64>(n.span.end);
      let unit_end = cvt::<u32, u64>(u.end);
      let bonus = if n.integral {
        give 1_u64;
      } else {
        give 0_u64;
      }
      let base = end +wrap unit_end;
      let weighted = base +wrap 400_u64;
      return weighted +wrap bonus;
    }
    Delim(code: c) => {
      let code = cvt::<u32, u64>(c);
      return code +wrap 500_u64;
    }
    Eof() => {
      return 600_u64;
    }
  }
}

fn weigh_ref(component: &Component) -> result: u64 reads(component) {
  match component^ {
    Whitespace(span: s) => {
      let end = cvt::<u32, u64>(s^.end);
      return end +wrap 100_u64;
    }
    Ident(span: s) => {
      let end = cvt::<u32, u64>(s^.end);
      return end +wrap 200_u64;
    }
    Number(number: n) => {
      let end = cvt::<u32, u64>(n^.span.end);
      return end +wrap 300_u64;
    }
    Dimension(number: n, unit_name: u) => {
      let end = cvt::<u32, u64>(n^.span.end);
      let unit_end = cvt::<u32, u64>(u^.end);
      let base = end +wrap unit_end;
      return base +wrap 400_u64;
    }
    Delim(code: c) => {
      let code = cvt::<u32, u64>(c^);
      return code +wrap 500_u64;
    }
    Eof() => {
      return 600_u64;
    }
  }
}

fn relay(holder: Holder) -> result: Holder pure {
  return move holder;
}

fn make_holder(kind: u64, seed: u64) -> result: Holder pure {
  let next = seed +wrap 1_u64;
  if kind == 0_u64 {
    let cell = box_new::<u64>(value: seed);
    return Holder::Boxed(cell: move cell, stamp: next);
  }
  if kind == 1_u64 {
    let values = box_slots_new::<u64>(capacity: 2_u64);
    place_back(window: &values.inner, value: seed);
    place_back(window: &values.inner, value: next);
    return Holder::Many(values: move values);
  }
  if kind == 2_u64 {
    let extra = box_new::<u64>(value: seed);
    let inner = make_component(kind: 3_u32, seed: 9_u32);
    return Holder::Nested(inner: inner, extra: move extra);
  }
  return Holder::Nothing();
}

fn add_to(target: &u64, amount: u64) -> result: unit writes(target) {
  set target^ = target^ +wrap amount;
  return unit;
}

fn bump(holder: &Holder) -> result: unit writes(holder) {
  match holder^ {
    Boxed(cell: c, stamp: s) => {
      add_to(target: s, amount: 5_u64);
      set c^.inner = c^.inner +wrap 3_u64;
      return unit;
    }
    Many(values: v) => {
      return unit;
    }
    Nested(inner: i, extra: e) => {
      set e^.inner = e^.inner +wrap 7_u64;
      return unit;
    }
    Nothing() => {
      return unit;
    }
  }
}

fn peek(holder: &Holder) -> result: u64 reads(holder) {
  match holder^ {
    Boxed(cell: c, stamp: s) => {
      return c^.inner +wrap s^;
    }
    Many(values: v) => {
      let count = v^.inner.len;
      return count +wrap 1000_u64;
    }
    Nested(inner: i, extra: e) => {
      let weight = weigh_ref(component: i);
      return weight +wrap e^.inner;
    }
    Nothing() => {
      return 7777_u64;
    }
  }
}

fn drain(holder: Holder) -> result: u64 pure {
  match move holder {
    Boxed(cell: c, stamp: s) => {
      return c.inner +wrap s;
    }
    Many(values: v) => {
      let count = v.inner.len;
      return count +wrap 1000_u64;
    }
    Nested(inner: i, extra: e) => {
      let weight = weigh(component: i);
      return weight +wrap e.inner;
    }
    Nothing() => {
      return 7777_u64;
    }
  }
}

fn outer_weight(outer: Outer) -> result: u64 pure {
  match move outer {
    Wrap(value: h, mark: m) => {
      let drained = drain(holder: move h);
      let mark = cvt::<u8, u64>(m);
      return drained +wrap mark;
    }
    Pair(first: f, second: s) => {
      let weight = weigh(component: f);
      return weight +wrap s;
    }
    Empty() => {
      return 1_u64;
    }
  }
}

fn choose(flag: Bool, seed: u64) -> result: Holder pure {
  let chosen = if flag {
    give make_holder(kind: 0_u64, seed: seed);
  } else {
    give make_holder(kind: 2_u64, seed: seed);
  }
  return move chosen;
}

fn alternate(rounds: u64) -> result: u64 pure {
  let first = make_holder(kind: 0_u64, seed: 10_u64);
  let second = make_holder(kind: 1_u64, seed: 20_u64);
  for (round in 0_u64..rounds) {
    let held = move first;
    set first = move second;
    set second = move held;
  }
  let high = drain(holder: move first);
  let low = drain(holder: move second);
  let scaled = high *wrap 10000_u64;
  return scaled +wrap low;
}

fn weigh_all(items: &[Component]) -> result: u64 reads(items) {
  let total = 0_u64;
  let count = items^.len;
  for (index in 0_u64..count) {
    let item = items^[index];
    let weight = weigh(component: item);
    set total = total +wrap weight;
  }
  return total;
}

fn main() -> status: std::process::ExitStatus pure {
  let total = 0_u64;
  for (step in 0_u64..6_u64) {
    let kind = cvt::<u64, u32>(step);
    let component = make_component(kind: kind, seed: 10_u32);
    let copied = component;
    set component = make_component(kind: 4_u32, seed: 1_u32);
    let by_value = weigh(component: copied);
    let by_reference = weigh_ref(component: &copied);
    let bonus = if kind == 3_u32 {
      give 1_u64;
    } else {
      give 0_u64;
    }
    let expected = by_reference +wrap bonus;
    if by_value != expected {
      return std::process::exit_status(code: 1_u8);
    }
    set total = total +wrap by_value;
    let replaced = weigh(component: component);
    if replaced != 501_u64 {
      return std::process::exit_status(code: 2_u8);
    }
  }
  if total != 2178_u64 {
    return std::process::exit_status(code: 3_u8);
  }
  let sample = make_component(kind: 3_u32, seed: 2_u32);
  let items = array_filled::<Component, 3>(value: sample);
  let number = make_component(kind: 2_u32, seed: 1_u32);
  set items[1_u64] = number;
  let listed = weigh_all(items: &items[0_u64..3_u64]);
  if listed != 1136_u64 {
    return std::process::exit_status(code: 15_u8);
  }
  let boxed_component = box_new::<Component>(value: sample);
  let read_back = boxed_component.inner;
  let read_weight = weigh(component: read_back);
  if read_weight != 416_u64 {
    return std::process::exit_status(code: 16_u8);
  }
  let boxed = make_holder(kind: 0_u64, seed: 40_u64);
  bump(holder: &boxed);
  let peeked = peek(holder: &boxed);
  if peeked != 89_u64 {
    return std::process::exit_status(code: 4_u8);
  }
  let relayed = relay(holder: move boxed);
  let drained = drain(holder: move relayed);
  if drained != 89_u64 {
    return std::process::exit_status(code: 5_u8);
  }
  let nested = make_holder(kind: 2_u64, seed: 50_u64);
  bump(holder: &nested);
  let wrapped = Wrapped(label: 3_u32, holder: move nested, tail: 9_u8);
  let wrapped_weight = peek(holder: &wrapped.holder);
  if wrapped_weight != 486_u64 {
    return std::process::exit_status(code: 6_u8);
  }
  let pool = box_slots_new::<Holder>(capacity: 4_u64);
  let first_pooled = make_holder(kind: 0_u64, seed: 1_u64);
  place_back(window: &pool.inner, value: move first_pooled);
  let second_pooled = make_holder(kind: 1_u64, seed: 2_u64);
  place_back(window: &pool.inner, value: move second_pooled);
  let third_pooled = make_holder(kind: 2_u64, seed: 3_u64);
  place_back(window: &pool.inner, value: move third_pooled);
  let last = take_back(window: &pool.inner);
  let last_weight = drain(holder: move last);
  if last_weight != 433_u64 {
    return std::process::exit_status(code: 7_u8);
  }
  let inline = slots_new::<Holder, 3>();
  let first_inline = make_holder(kind: 1_u64, seed: 4_u64);
  place_back(window: &inline, value: move first_inline);
  let second_inline = make_holder(kind: 0_u64, seed: 5_u64);
  place_back(window: &inline, value: move second_inline);
  let boxed_holder = make_holder(kind: 0_u64, seed: 60_u64);
  let cell = box_new::<Holder>(value: move boxed_holder);
  let taken = move cell.inner;
  let taken_weight = drain(holder: move taken);
  if taken_weight != 121_u64 {
    return std::process::exit_status(code: 8_u8);
  }
  let kept_holder = make_holder(kind: 2_u64, seed: 70_u64);
  let kept = box_new::<Holder>(value: move kept_holder);
  let wrapped_holder = make_holder(kind: 1_u64, seed: 80_u64);
  let outer = Outer::Wrap(value: move wrapped_holder, mark: 4_u8);
  let outer_total = outer_weight(outer: move outer);
  if outer_total != 1006_u64 {
    return std::process::exit_status(code: 9_u8);
  }
  let paired = make_component(kind: 1_u32, seed: 3_u32);
  let pair = Outer::Pair(first: paired, second: 5_u64);
  let pair_total = outer_weight(outer: move pair);
  if pair_total != 210_u64 {
    return std::process::exit_status(code: 10_u8);
  }
  let kept_outer_holder = make_holder(kind: 0_u64, seed: 90_u64);
  let kept_outer = Outer::Wrap(value: move kept_outer_holder, mark: 1_u8);
  let optional_holder = make_holder(kind: 0_u64, seed: 5_u64);
  let optional = Some<Holder>(value: move optional_holder);
  let yes = True();
  let no = False();
  let picked = choose(flag: yes, seed: 11_u64);
  let picked_weight = drain(holder: move picked);
  if picked_weight != 23_u64 {
    return std::process::exit_status(code: 11_u8);
  }
  let other = choose(flag: no, seed: 12_u64);
  let other_weight = drain(holder: move other);
  if other_weight != 442_u64 {
    return std::process::exit_status(code: 12_u8);
  }
  let odd = alternate(rounds: 3_u64);
  if odd != 10020021_u64 {
    return std::process::exit_status(code: 13_u8);
  }
  let even = alternate(rounds: 4_u64);
  if even != 211002_u64 {
    return std::process::exit_status(code: 14_u8);
  }
  return std::process::exit_status(code: 0_u8);
}
